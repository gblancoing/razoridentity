@page
@model RazorIdentity.Pages.AppModel
@{
    ViewData["Title"] = "App";
}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <h1 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-slate-100 mb-2">Aplicaciones</h1>
    <p class="text-slate-600 dark:text-slate-300 mb-4 sm:mb-6 text-sm sm:text-base">Aplicaciones disponibles creadas en el mantenedor maestro. El administrador asigna el acceso a cada usuario desde Ajustes → Usuarios por app.</p>

    @if (Model.ErrorApi != null)
    {
        <div class="mb-6 rounded-xl bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700/80 p-4 text-amber-800 dark:text-amber-200 text-sm flex items-start gap-3">
            <span class="material-icons text-amber-600 dark:text-amber-400 flex-shrink-0">warning</span>
            <span>@Model.ErrorApi</span>
        </div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="mb-6 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700/80 p-4 text-red-800 dark:text-red-200 text-sm flex items-start gap-3">
            <span class="material-icons text-red-600 dark:text-red-400 flex-shrink-0">error</span>
            <span>@errorMsg</span>
        </div>
    }

    @if (!Model.Apps.Any() && Model.ErrorApi == null)
    {
        <p class="text-slate-500 dark:text-slate-400">No hay aplicaciones registradas. Cree apps desde <a asp-page="/Protegido" asp-route-tab="apps" class="text-ritweb-teal dark:text-teal-400 hover:underline">Ajustes → Apps</a> (requiere rol Super_admin).</p>
    }
    else if (Model.Apps.Any())
    {
        var tieneAppPmoEnMantenedor = Model.Apps.Any(a =>
            string.Equals(a.Nombre, "PMO", StringComparison.OrdinalIgnoreCase)
            || string.Equals(a.Nombre, "PYC", StringComparison.OrdinalIgnoreCase)
            || string.Equals(a.Nombre, "P & C", StringComparison.OrdinalIgnoreCase)
            || string.Equals(a.Nombre, "P&C", StringComparison.OrdinalIgnoreCase));
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var app in Model.Apps)
            {
                var isRitWeb = string.Equals(app.Nombre, "RitWeb", StringComparison.OrdinalIgnoreCase);
                var isMontecarlo = string.Equals(app.Nombre, "Montecarlo", StringComparison.OrdinalIgnoreCase);
                var isPmo = string.Equals(app.Nombre, "PMO", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(app.Nombre, "PYC", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(app.Nombre, "P & C", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(app.Nombre, "P&C", StringComparison.OrdinalIgnoreCase);
                var isLinked = isRitWeb || isMontecarlo || isPmo;
                var cardClass = "rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm hover:shadow-md transition-shadow" + (isLinked ? " hover:border-ritweb-teal dark:hover:border-teal-500" : "");
                if (isRitWeb)
                {
                    <div class="@cardClass">
                        <a asp-page="/RitWeb" class="block">
                            <div class="flex items-start gap-3">
                                @if (!string.IsNullOrWhiteSpace(app.ImagenApp))
                                {
                                    <img src="@app.ImagenApp" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-lg bg-slate-200 dark:bg-slate-600 flex items-center justify-center flex-shrink-0">
                                        <span class="material-icons text-slate-500 dark:text-slate-400 text-2xl">apps</span>
                                    </div>
                                }
                                <div class="min-w-0 flex-1">
                                    <h2 class="font-semibold text-slate-800 dark:text-slate-100">@app.Nombre</h2>
                                    @if (!string.IsNullOrWhiteSpace(app.DescripcionApp))
                                    {
                                        <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">@app.DescripcionApp</p>
                                    }
                                </div>
                            </div>
                        </a>
                        @if (Model.IsSuperAdmin)
                        {
                            <p class="mt-2 pt-2 border-t border-slate-200 dark:border-slate-600 text-xs text-slate-500 dark:text-slate-400">
                                <a asp-page="/RitWebProyectos" class="text-ritweb-teal dark:text-teal-400 hover:underline font-medium">Abrir RitWeb por proyecto</a> — elegir proyecto antes de entrar.
                            </p>
                        }
                    </div>
                }
                else if (isPmo)
                {
                    <div class="@cardClass">
                        <a asp-page="/PMO" class="block">
                            <div class="flex items-start gap-3">
                                @if (!string.IsNullOrWhiteSpace(app.ImagenApp))
                                {
                                    <img src="@app.ImagenApp" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-lg bg-teal-100 dark:bg-teal-900/40 flex items-center justify-center flex-shrink-0">
                                        <span class="material-icons text-teal-600 dark:text-teal-400 text-2xl">account_tree</span>
                                    </div>
                                }
                                <div class="min-w-0 flex-1">
                                    <h2 class="font-semibold text-slate-800 dark:text-slate-100">@app.Nombre</h2>
                                    @if (!string.IsNullOrWhiteSpace(app.DescripcionApp))
                                    {
                                        <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">@app.DescripcionApp</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">PMO — vectores financieros y control (proyecto desde Ajustes)</p>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
                else if (isMontecarlo)
                {
                    <div class="@cardClass">
                        <a asp-page="/Montecarlo" class="block">
                            <div class="flex items-start gap-3">
                                @if (!string.IsNullOrWhiteSpace(app.ImagenApp))
                                {
                                    <img src="@app.ImagenApp" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center flex-shrink-0">
                                        <span class="material-icons text-indigo-500 dark:text-indigo-400 text-2xl">casino</span>
                                    </div>
                                }
                                <div class="min-w-0 flex-1">
                                    <h2 class="font-semibold text-slate-800 dark:text-slate-100">@app.Nombre</h2>
                                    @if (!string.IsNullOrWhiteSpace(app.DescripcionApp))
                                    {
                                        <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">@app.DescripcionApp</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Simulación probabilística: riesgos, costos, cronograma y VaR</p>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <div class="@cardClass">
                        <div class="flex items-start gap-3">
                            @if (!string.IsNullOrWhiteSpace(app.ImagenApp))
                            {
                                <img src="@app.ImagenApp" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-lg bg-slate-200 dark:bg-slate-600 flex items-center justify-center flex-shrink-0">
                                    <span class="material-icons text-slate-500 dark:text-slate-400 text-2xl">apps</span>
                                </div>
                            }
                            <div class="min-w-0 flex-1">
                                <h2 class="font-semibold text-slate-800 dark:text-slate-100">@app.Nombre</h2>
                                @if (!string.IsNullOrWhiteSpace(app.DescripcionApp))
                                {
                                    <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">@app.DescripcionApp</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            @* Tarjeta fija: Análisis Montecarlo (API propia) *@
            <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm hover:shadow-md transition-shadow hover:border-ritweb-teal dark:hover:border-teal-500">
                <a asp-page="/Montecarlo" class="block">
                    <div class="flex items-start gap-3">
                        <div class="w-12 h-12 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center flex-shrink-0">
                            <span class="material-icons text-indigo-500 dark:text-indigo-400 text-2xl">casino</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h2 class="font-semibold text-slate-800 dark:text-slate-100">Análisis Montecarlo</h2>
                            <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">Simulación probabilística: riesgos, costos, cronograma y VaR</p>
                        </div>
                    </div>
                </a>
            </div>
            @* PMO: solo tarjeta fija si no hay entrada PMO/PYC en el mantenedor (evita duplicado) *@
            @if (!tieneAppPmoEnMantenedor)
            {
                <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm hover:shadow-md transition-shadow hover:border-ritweb-teal dark:hover:border-teal-500">
                    <a asp-page="/PMO" class="block">
                        <div class="flex items-start gap-3">
                            <div class="w-12 h-12 rounded-lg bg-teal-100 dark:bg-teal-900/40 flex items-center justify-center flex-shrink-0">
                                <span class="material-icons text-teal-600 dark:text-teal-400 text-2xl">account_tree</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <h2 class="font-semibold text-slate-800 dark:text-slate-100">PMO</h2>
                                <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 line-clamp-2">Planning &amp; Control — vectores financieros; proyecto desde Ajustes</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
