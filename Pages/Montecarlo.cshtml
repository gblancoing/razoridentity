                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-full bg-orange-500 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
                        <span class="font-semibold text-orange-800 dark:text-orange-300 text-xs">Bernoulli × Triangular</span>
                    </div>
                    <div class="font-mono text-xs bg-white dark:bg-slate-900 rounded-lg p-2 mb-2 border border-orange-200 dark:border-orange-700">
                        <div class="text-slate-500">Riesgo: p=0.5, T(0, 1, 2)</div>
