                                <th class="pb-1.5 pr-3 text-right text-amber-600 dark:text-amber-400 font-semibold">P80</th>
                                <th class="pb-1.5 pr-3 text-right text-violet-600 dark:text-violet-400 font-semibold">P90</th>
                                <th class="pb-1.5 pr-3 text-right text-slate-500 dark:text-slate-400 font-semibold">CV%</th>
                            </tr>
                        </thead>
                        <tbody id="corr-stats-body"></tbody>
                        <tfoot id="corr-stats-foot"></tfoot>
                    </table>
                </div>
            </div>

            @* Pares — scatter plots (opcional; por defecto no se generan) *@
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-sm">
