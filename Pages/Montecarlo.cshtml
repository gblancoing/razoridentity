                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[3.5rem] text-red-600 dark:text-red-400" title="Amenazas (días)">Amen.</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.25rem]" title="Distribución de duración">Dist.</th>
