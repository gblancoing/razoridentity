@section Scripts {
<script>window._MC_INIT_TAB = '@Model.ActiveTab';</script>
<script src="~/js/montecarlo.js" asp-append-version="true"></script>
<script src="~/js/taller-costos.js" asp-append-version="true"></script>
<script>
(function () {
    var _tcInited = false;
    var _banner = document.getElementById('mc-project-banner');

    // ── Riesgos: colorear select Tipo ───────────────────────────────────────
    window.tcUpdateRiskTipoColor = function(sel) {
        if (!sel) return;
        if (sel.value === 'Oportunidad') {
            sel.style.borderColor = '#10b981';
            sel.style.color       = '#065f46';
            sel.style.background  = '#d1fae5';
        } else {
            sel.style.borderColor = '#f87171';
            sel.style.color       = '#7f1d1d';
            sel.style.background  = '#fee2e2';
        }
    };
    // Aplicar colores a filas existentes al cargar
    function tcInitRiskTipoColors() {
        document.querySelectorAll('.risk-tipo-sel').forEach(function(sel) {
            tcUpdateRiskTipoColor(sel);
        });
    }
    document.addEventListener('DOMContentLoaded', tcInitRiskTipoColors);
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            if (document.getElementById('risks-body') && typeof window.mcRisksInitReadMode === 'function') {
                window.mcRisksInitReadMode();
            }
            if (document.getElementById('schedule-body') && typeof window.mcScheduleInitReadMode === 'function') {
                window.mcScheduleInitReadMode();
            }
        }, 0);
    });
    // También aplicar cuando se restauran filas desde localStorage
    var _origRestoreTab = window.restoreTabFromStorage;
    if (typeof _origRestoreTab === 'function') {
        window.restoreTabFromStorage = function(tabId) {
            var result = _origRestoreTab(tabId);
            if (tabId === 'risks') {
                setTimeout(tcInitRiskTipoColors, 0);
            }
            return result;
        };
    }

    // ── Riesgos: toggle columnas adicionales ────────────────────────────────
    window._tcRiskExtraVisible = false;
    window.tcToggleRiskExtraCols = function() {
        window._tcRiskExtraVisible = !window._tcRiskExtraVisible;
        var show = window._tcRiskExtraVisible;
        document.querySelectorAll('.tc-risk-extra').forEach(function(el) {
            el.style.display = show ? '' : 'none';
        });
        var tbl = document.querySelector('#risks-form .mc-risks-table');
        if (tbl) tbl.classList.toggle('mc-risks-with-extra', show);
        var footTail = document.getElementById('risks-tfoot-tail');
        if (footTail) footTail.colSpan = show ? 2 : 1;
        var icon = document.querySelector('#btn-toggle-risk-extra .material-icons');
        var lbl  = document.getElementById('btn-toggle-risk-extra-lbl');
        if (icon) icon.textContent = show ? 'visibility' : 'visibility_off';
        if (lbl)  lbl.textContent  = show ? 'Ocultar columnas adicionales' : 'Mostrar columnas adicionales';
    };

    // ── Riesgos: agregar fila + auto-resize ─────────────────────────────────
    window.addScheduleRow = function() {
        if (typeof window.mcScheduleAppendNewRow === 'function') {
            window.mcScheduleAppendNewRow();
            return;
        }
        addRow('schedule-body', 'ScheduleTasks', 'schedule');
    };

    window.addRiskRow = function() {
        if (typeof window.mcRisksAppendNewRow === 'function') {
            window.mcRisksAppendNewRow();
            return;
        }
        addRow('risks-body', 'Risks', 'risk');
        var body = document.getElementById('risks-body');
        if (body) {
            var lastRow = body.querySelector('.data-row:last-child');
            if (lastRow) {
                lastRow.querySelectorAll('textarea').forEach(function(ta) { tcAutoResize(ta); });
                var tipoSel = lastRow.querySelector('.risk-tipo-sel');
                if (tipoSel && typeof tcUpdateRiskTipoColor === 'function') tcUpdateRiskTipoColor(tipoSel);
            }
        }
    };

    // ── Auto-resize de textareas existentes al activar la pestaña ───────────
    var _origActivateTab = window.activateTab;
    window.activateTab = function(tabId) {
        _origActivateTab(tabId);
        if (tabId === 'risks') {
            setTimeout(function() {
                var body = document.getElementById('risks-body');
                if (body) body.querySelectorAll('textarea').forEach(function(ta) {
                    if (typeof tcAutoResize === 'function') tcAutoResize(ta);
                });
            }, 50);
        }
        if (tabId === 'schedule') {
            setTimeout(function() {
                var body = document.getElementById('schedule-body');
                if (body) body.querySelectorAll('textarea').forEach(function(ta) {
                    if (typeof tcAutoResize === 'function') tcAutoResize(ta);
                });
            }, 50);
        }
    };

    // ── Exportar tabla Riesgos a CSV ─────────────────────────────────────────
    window.exportarRisksCSV = function() {
        var rows = document.querySelectorAll('#risks-body .data-row');
        if (!rows.length) { alert('No hay riesgos para exportar.'); return; }
        var headers = ['Origen','Código','Riesgo Proyecto','Titulo Riesgo','Causas - (Debido a...)',
                       'Prob %','Imp. Mín','Imp. Probable','Imp. Máx','Distribución',
                       'VE USD','Plan de Respuesta para resguardar costos'];
        var g = function(row, suffix) {
            var el = row.querySelector('[name$=".' + suffix + '"]');
            return el ? el.value : '';
        };
        var dataRows = Array.from(rows).map(function(row, i) {
            var ve = row.querySelector('.risk-ve-val');
            return [
                g(row,'Origin'), g(row,'Code'), g(row,'Description'), g(row,'Cause'),
                g(row,'ResponsePlan'), g(row,'Probability'),
                g(row,'MinImpact'), g(row,'MostLikelyImpact'), g(row,'MaxImpact'),
                g(row,'Distribution'),
                ve ? ve.dataset.ve : '',
                g(row,'EstimationBase')
            ].map(function(v) { return '"' + String(v||'').replace(/"/g,'""') + '"'; }).join(',');
        });
        var bom = '\uFEFF';
        var csv = bom + headers.join(',') + '\n' + dataRows.join('\n');
        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href   = url; a.download = 'Riesgos_MC.csv'; a.click();
        URL.revokeObjectURL(url);
    };

    // Override tcNav para usar el sistema de tabs de MC
    window.tcNav = function (section) {
        activateTab('tc-' + section);
        TC.activeSection = section;
        var bloques = ['bloqueA','bloqueB','bloqueC','bloqueD','bloqueE','bloqueF'];
        var sbContrato = document.getElementById('sb-contrato-items');
        if (sbContrato) {
            if (bloques.includes(section)) sbContrato.classList.remove('hidden');
            else if (section === 'contratos' || section === 'proyectos' || section === 'empresas' || section === 'resumen')
                sbContrato.classList.add('hidden');
        }
        if (section === 'bloqueD') tcRenderBloqueD();
        if (section === 'bloqueE') tcRenderBloqueE();
        if (section === 'bloqueF') {
            tcRenderBloqueF();
            if (typeof tcCargarMcResultado === 'function') tcCargarMcResultado();
        }
        if (section === 'empresas' && typeof tcCargarPanelEmpresas === 'function') tcCargarPanelEmpresas();
        if (section === 'riesgos') tcCargarRevisionesSelect();
        if (section === 'montecarlo') { tcCargarRevisionesSelectMC(); tcCargarHistorial(); tcActualizarResumenMC(); }
        if (section === 'resumen') { tcPopularSelectResumen(); tcCargarResumen(); }
        if (section === 'bloqueB' && typeof tcValidarBloqueB === 'function') tcValidarBloqueB();
    };

    // ── Riesgos / Cronograma: guardar y restaurar por proyecto ──────────────────
    var _PROJ_TAB_FIELDS = {
        risks:    { body: 'risks-body',    prefix: 'Risks',         type: 'risk',     extraFields: [] },
        schedule: { body: 'schedule-body', prefix: 'ScheduleTasks', type: 'schedule', extraFields: ['ScheduleGlobalPlannedDays'] }
    };

    function tcProjTabKey(tabId) {
        var pid = (window.TC && TC.proyectoId) ? TC.proyectoId : null;
        return pid ? 'tc-ptab-' + pid.replace(/-/g,'') + '-' + tabId : null;
    }

    function tcSaveProjTab(tabId) {
        var key = tcProjTabKey(tabId);
        if (!key) return;
        var content = document.getElementById('tab-' + tabId);
        if (!content) return;
        var data = {};
        content.querySelectorAll('input[name], select[name], textarea[name]').forEach(function(el) {
            data[el.name] = el.value;
        });
        try { localStorage.setItem(key, JSON.stringify(data)); } catch(e) {}
    }

    function tcRestoreProjTab(tabId) {
        var pid  = window.TC && TC.proyectoId;
        var name = (window.TC && TC.proyecto && TC.proyecto.nombre) ? TC.proyecto.nombre : (pid || null);
        var bannerId = 'tc-' + tabId + '-proj-banner';
        var banner = document.getElementById(bannerId);
        if (banner) {
            if (name) {
                banner.innerHTML = '<span class="material-icons" style="font-size:15px">folder</span>&nbsp;Proyecto activo: <strong class="ml-1">' + name.replace(/</g,'&lt;') + '</strong>';
                banner.classList.remove('hidden');
            } else {
                banner.classList.add('hidden');
            }
        }
        if (!pid) return;

        var cfg = _PROJ_TAB_FIELDS[tabId];
        if (!cfg) return;

        try {
            var key  = tcProjTabKey(tabId);
            var json = key ? localStorage.getItem(key) : null;

            // Clear current rows
            var body = document.getElementById(cfg.body);
            if (!body) return;
            var existing = body.querySelectorAll('.data-row');
            for (var r = existing.length - 1; r >= 0; r--) existing[r].remove();

            if (!json) {
                // No saved data: show one blank row
                if (window.addRow) window.addRow(cfg.body, cfg.prefix, cfg.type);
                // Clear extra fields
                cfg.extraFields.forEach(function(f) {
                    var el = document.querySelector('[name="' + f + '"]');
                    if (el) el.value = '';
                });
                if (tabId === 'risks') {
                    setTimeout(function() {
                        if (typeof window.formatAllRisksImpacts === 'function') window.formatAllRisksImpacts();
                        if (typeof window.mcRisksInitReadMode === 'function') window.mcRisksInitReadMode();
                    }, 0);
                }
                if (tabId === 'schedule') {
                    setTimeout(function() {
                        if (typeof window.mcScheduleInitReadMode === 'function') window.mcScheduleInitReadMode();
                    }, 0);
                }
                return;
            }

            var data = JSON.parse(json);
            var maxIdx = -1;
            Object.keys(data).forEach(function(k) {
                var m = k.match(/\[(\d+)\]/);
                if (m) maxIdx = Math.max(maxIdx, parseInt(m[1]));
            });
            if (maxIdx < 0) {
                if (window.addRow) window.addRow(cfg.body, cfg.prefix, cfg.type);
                if (tabId === 'risks') {
                    setTimeout(function() {
                        if (typeof window.formatAllRisksImpacts === 'function') window.formatAllRisksImpacts();
                        if (typeof window.mcRisksInitReadMode === 'function') window.mcRisksInitReadMode();
                    }, 0);
                }
                if (tabId === 'schedule') {
                    setTimeout(function() {
                        if (typeof window.mcScheduleInitReadMode === 'function') window.mcScheduleInitReadMode();
                    }, 0);
                }
                return;
            }

            for (var i = 0; i <= maxIdx; i++) {
                if (window.addRow) window.addRow(cfg.body, cfg.prefix, cfg.type);
            }

            var content = document.getElementById('tab-' + tabId);
            if (content) {
                content.querySelectorAll('input[name], select[name], textarea[name]').forEach(function(el) {
                    if (data[el.name] !== undefined) el.value = data[el.name];
                });
            }

            if (tabId === 'risks') {
                setTimeout(function() {
                    if (typeof window.formatAllRisksImpacts === 'function') window.formatAllRisksImpacts();
                    if (typeof window.mcRisksInitReadMode === 'function') window.mcRisksInitReadMode();
                }, 0);
            }
            if (tabId === 'schedule') {
                setTimeout(function() {
                    if (typeof window.mcScheduleInitReadMode === 'function') window.mcScheduleInitReadMode();
                }, 0);
            }
        } catch(e) {}
    }

    window.tcLimpiarProjTab = function(tabId) {
        // Limpiar todas las claves de localStorage asociadas a este tab
        var key = tcProjTabKey(tabId);
        if (key) { try { localStorage.removeItem(key); } catch(e) {} }
        try { localStorage.removeItem('mc-tab-inputs-' + tabId); } catch(e) {}
        try { localStorage.removeItem('mc-tab-result-' + tabId); } catch(e) {}

        // Limpiar filas del DOM
        var cfg = _PROJ_TAB_FIELDS[tabId];
        if (!cfg) return;
        var body = document.getElementById(cfg.body);
        if (!body) return;
        var rows = body.querySelectorAll('.data-row');
        for (var r = rows.length - 1; r >= 0; r--) rows[r].remove();
        if (window.addRow) window.addRow(cfg.body, cfg.prefix, cfg.type);
        cfg.extraFields.forEach(function(f) {
            var el = document.querySelector('[name="' + f + '"]');
            if (el) el.value = '';
        });

        if (tabId === 'risks') {
            setTimeout(function() {
                if (typeof window.mcRisksInitReadMode === 'function') window.mcRisksInitReadMode();
            }, 0);
        }
        if (tabId === 'schedule') {
            setTimeout(function() {
                if (typeof window.mcScheduleInitReadMode === 'function') window.mcScheduleInitReadMode();
            }, 0);
        }

        // Esconder sección de resultados
        var sect = document.getElementById(tabId + '-result-section');
        if (sect) sect.classList.add('hidden');

        // Limpiar resultado guardado en BD (para que no reaparezca al recargar)
        if (tabId === 'risks' && typeof window.clearRisksResult === 'function') {
            window.clearRisksResult();
        }
    };

    // Hook form submits to persist data per project before sending
    (function() {
        var risksForm = document.querySelector('#risks-body') && document.querySelector('#risks-body').closest('form');
        if (risksForm) risksForm.addEventListener('submit', function() { tcSaveProjTab('risks'); }, true);
        var schedForm = document.querySelector('#schedule-body') && document.querySelector('#schedule-body').closest('form');
        if (schedForm) schedForm.addEventListener('submit', function() { tcSaveProjTab('schedule'); }, true);
    })();

    var _origActivate = window.activateTab;
    window.activateTab = function (tabId) {
        if (_origActivate) _origActivate(tabId);
        var isTc = tabId.startsWith('tc-');
        var isProjTab = (tabId === 'risks' || tabId === 'schedule');
        if (_banner) _banner.classList.toggle('hidden', isTc);
        var mcBanner = document.getElementById('mc-project-banner');
        if (mcBanner) mcBanner.classList.toggle('hidden', isTc || isProjTab || tabId === 'ia');
        if (isTc && !_tcInited) {
            _tcInited = true;
            tcInit();
        }
        if (isProjTab) {
            tcRestoreProjTab(tabId);
        }
    };

    // Inicializar TC si el tab inicial es uno de TC (montecarlo.js ya activó el tab antes de que este script corriera)
    var initTab = window._MC_INIT_TAB || 'tc-resumen';
    var mcBannerInit = document.getElementById('mc-project-banner');
    if (initTab.startsWith('tc-')) {
        if (_banner) _banner.classList.add('hidden');
        if (mcBannerInit) mcBannerInit.classList.add('hidden');
        _tcInited = true;
        tcInit();
    } else if (initTab === 'risks' || initTab === 'schedule' || initTab === 'ia') {
        if (mcBannerInit) mcBannerInit.classList.add('hidden');
        if (initTab === 'risks' || initTab === 'schedule') {
            tcRestoreProjTab(initTab);
        }
    }
})();
</script>
<script>
// Fundamento Técnico: subpestañas + descarga del PDF profesional
window.mcFundamentoTecnicoSubTab = function (which) {
    var f = document.getElementById("mc-ft-panel-fundamento");
    var fo = document.getElementById("mc-ft-panel-formulas");
    var bf = document.getElementById("mc-ft-sub-fundamento");
    var bfo = document.getElementById("mc-ft-sub-formulas");
    if (!f || !fo) return;
    var isF = which === "fundamento";
    f.classList.toggle("hidden", !isF);
    fo.classList.toggle("hidden", isF);
    var active = "mc-ft-sub px-3 sm:px-4 py-2 rounded-t-lg text-sm font-semibold border-b-2 border-amber-500 text-amber-700 dark:text-amber-300 bg-amber-50/80 dark:bg-amber-950/30";
    var idle = "mc-ft-sub px-3 sm:px-4 py-2 rounded-t-lg text-sm font-medium border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60";
    if (bf) { bf.setAttribute("aria-selected", isF); bf.className = isF ? active : idle; }
    if (bfo) { bfo.setAttribute("aria-selected", !isF); bfo.className = !isF ? active : idle; }
};
window.generarLibroFundamentos = function () {
    var a = document.createElement("a");
    a.href = "/docs/montecarlo/Libro-Fundamentos-Tecnicos-MonteCarlo-Profesional.pdf";
    a.download = "Libro-Fundamentos-Tecnicos-MonteCarlo-Profesional.pdf";
    a.rel = "noopener";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
};
</script>
