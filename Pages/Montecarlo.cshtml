            <iframe title="Libro de Fundamentos Técnicos — Sistema Monte Carlo CODELCO"
                    class="w-full flex-1 border-0 bg-white"
                    style="min-height:28rem;height:calc(100vh - 11.5rem);height:calc(100dvh - 11.5rem)"
