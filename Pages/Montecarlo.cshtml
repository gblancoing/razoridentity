                            <th class="px-0.5 py-2 w-9 align-bottom"></th>
                        </tr>
                    </thead>
                    <tbody id="schedule-body" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                        <tr class="data-row align-top">
