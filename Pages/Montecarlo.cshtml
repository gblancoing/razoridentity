@page
@model RazorIdentity.Pages.MontecarloModel
@{
    ViewData["Title"] = "Montecarlo";
    var tab = Model.ActiveTab;
}

@section Head {
<style>
    .mc-input {
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #1e293b;
        padding: 0.375rem 0.625rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
    }
    .dark .mc-input {
        border-color: #475569;
        background: #1e293b;
        color: #f1f5f9;
    }
    .mc-input:focus {
        outline: none;
        ring: 2px solid #818cf8;
        border-color: #818cf8;
    }
    .mc-json {
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        color: #334155;
        overflow-x: auto;
        white-space: pre-wrap;
        max-height: 24rem;
        overflow-y: auto;
        background: #fff;
        border-radius: 0.5rem;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
    }
    .dark .mc-json { background: #0f172a; color: #e2e8f0; border-color: #334155; }
    /* ── Sidebar ── */
    #mc-sidebar { transition: width 0.22s ease; will-change: width; overflow: hidden; }
    #mc-sidebar.mc-collapsed { width: 3.5rem !important; }
    #mc-sidebar.mc-collapsed .mc-sb-label,
    #mc-sidebar.mc-collapsed .mc-sb-group { display: none; }
    .tab-btn.mc-active { background: rgba(99,102,241,0.12); color: #4338ca; font-weight: 600; }
    .dark .tab-btn.mc-active { background: rgba(99,102,241,0.22); color: #a5b4fc; }
    #mc-sidebar.mc-collapsed .mc-sb-badge { display: none; }
    .proj-btn { display:inline-flex; align-items:center; gap:0.375rem; padding:0.375rem 0.875rem; border-radius:0.5rem; font-size:0.8125rem; font-weight:500; transition:background 0.15s,color 0.15s; cursor:pointer; }
    .proj-btn:disabled { opacity:0.45; cursor:not-allowed; }
    /* ── ARIA chat ── */
    .aria-user-bubble { background:#eef2ff; border:1px solid #c7d2fe; border-radius:1rem 1rem 0.25rem 1rem; }
    .dark .aria-user-bubble { background:#312e81; border-color:#4338ca; }
    .aria-ai-bubble { background:#fff; border:1px solid #e2e8f0; border-radius:0.25rem 1rem 1rem 1rem; }
    .dark .aria-ai-bubble { background:#1e293b; border-color:#334155; }
    .aria-md h2,.aria-md h3 { font-weight:700; margin:0.6rem 0 0.2rem; color:#1e293b; }
    .dark .aria-md h2,.dark .aria-md h3 { color:#f1f5f9; }
    .aria-md strong { font-weight:700; }
    .aria-md ul { list-style:disc; padding-left:1.25rem; margin:0.3rem 0; }
    .aria-md li { margin:0.15rem 0; }
    .aria-md p { margin:0.3rem 0; }
    .aria-md code { background:#f1f5f9; border-radius:0.25rem; padding:0.1rem 0.3rem; font-size:0.8rem; font-family:monospace; }
    .dark .aria-md code { background:#0f172a; }
    @@keyframes aria-pulse { 0%,100%{opacity:.4} 50%{opacity:1} }
    .aria-thinking span { display:inline-block; width:6px; height:6px; border-radius:50%; background:#818cf8; margin:0 2px; animation:aria-pulse 1.2s ease-in-out infinite; }
    .aria-thinking span:nth-child(2) { animation-delay:.2s; }
    .aria-thinking span:nth-child(3) { animation-delay:.4s; }
</style>
<style>
    /* ══ Taller Costos — estilos embebidos ══ */
    #tc-sidebar { transition: width 0.22s ease; will-change: width; overflow: hidden; }
    #tc-sidebar.tc-collapsed { width: 3.5rem !important; }
    #tc-sidebar.tc-collapsed .tc-sb-label,
    #tc-sidebar.tc-collapsed .tc-sb-group { display: none; }
    .step-btn { display:flex; align-items:center; gap:0.5rem; width:100%; padding:0.5rem 0.625rem;
        border-radius:0.5rem; font-size:0.8125rem; color:#475569; transition:background 0.15s,color 0.15s;
        cursor:pointer; border:none; background:none; text-align:left; }
    .step-btn:hover { background:#f1f5f9; color:#1e293b; }
    .dark .step-btn:hover { background:#1e293b; color:#f1f5f9; }
    .step-btn.tc-active { background:rgba(15,148,136,0.1); color:#0f9488; font-weight:600; }
    .dark .step-btn.tc-active { background:rgba(15,148,136,0.18); color:#2dd4bf; }
    .step-btn .step-icon { font-size:18px; flex-shrink:0; }
    .step-btn .step-badge { margin-left:auto; font-size:0.7rem; background:#e2e8f0; border-radius:9999px;
        padding:0 0.4rem; color:#64748b; font-weight:600; }
    .dark .step-btn .step-badge { background:#334155; color:#94a3b8; }
    .tc-section { display:none; }
    .tc-section.tc-visible { display:block; }
    .tc-table { width:100%; border-collapse:collapse; font-size:0.8125rem; }
    .tc-table th { background:#f8fafc; font-weight:600; color:#475569; padding:0.5rem 0.625rem;
        text-align:left; border-bottom:2px solid #e2e8f0; white-space:nowrap; }
    .dark .tc-table th { background:#1e293b; color:#94a3b8; border-color:#334155; }
    .tc-table td { padding:0.375rem 0.5rem; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .dark .tc-table td { border-color:#1e293b; }
    .tc-table tr:hover td { background:#fafbfc; }
    .dark .tc-table tr:hover td { background:#0f172a; }
    .tc-input { border-radius:0.375rem; border:1px solid #cbd5e1; background:#fff; color:#1e293b;
        padding:0.3rem 0.5rem; font-size:0.8125rem; width:100%; }
    .dark .tc-input { border-color:#475569; background:#1e293b; color:#f1f5f9; }
    .tc-input:focus { outline:none; border-color:#0d9488; box-shadow:0 0 0 2px rgba(13,148,136,0.18); }
    .tc-select { border-radius:0.375rem; border:1px solid #cbd5e1; background:#fff; color:#1e293b;
        padding:0.3rem 0.5rem; font-size:0.8125rem; }
    .dark .tc-select { border-color:#475569; background:#1e293b; color:#f1f5f9; }
    .btn-primary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 1rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer; border:none;
        background:#0f9488; color:#fff; transition:background 0.15s; }
    .btn-primary:hover { background:#0d7a70; }
    .btn-primary:disabled { opacity:0.45; cursor:not-allowed; }
    .btn-secondary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 0.875rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer;
        border:1px solid #cbd5e1; background:#fff; color:#475569; transition:background 0.15s; }
    .dark .btn-secondary { background:#1e293b; border-color:#475569; color:#94a3b8; }
    .btn-secondary:hover { background:#f1f5f9; }
    .dark .btn-secondary:hover { background:#0f172a; }
    .btn-success { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 1rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer; border:none;
        background:#16a34a; color:#fff; transition:background 0.15s; }
    .btn-success:hover { background:#15803d; }
    .btn-success:disabled { opacity:0.55; cursor:default; }
    .btn-danger { display:inline-flex; align-items:center; gap:0.25rem; padding:0.3rem 0.6rem;
        border-radius:0.375rem; font-size:0.75rem; font-weight:500; cursor:pointer; border:none;
        background:transparent; color:#ef4444; transition:background 0.15s; }
    .btn-danger:hover { background:#fef2f2; }
    .tc-card { background:#fff; border:1px solid #e2e8f0; border-radius:0.75rem; padding:1.25rem; }
    .dark .tc-card { background:#1e293b; border-color:#334155; }
    .badge-verde { background:#dcfce7; color:#15803d; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-amarillo { background:#fef9c3; color:#854d0e; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-rojo { background:#fee2e2; color:#b91c1c; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-azul { background:#dbeafe; color:#1d4ed8; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .dark .badge-verde { background:#14532d; color:#86efac; }
    .dark .badge-amarillo { background:#422006; color:#fde68a; }
    .dark .badge-rojo { background:#450a0a; color:#fca5a5; }
    .bloque-tab { padding:0.4rem 0.875rem; border-radius:0.5rem 0.5rem 0 0; font-size:0.8125rem;
        font-weight:500; cursor:pointer; border:1px solid #e2e8f0; border-bottom:none;
        background:#f8fafc; color:#64748b; transition:background 0.15s; }
    .bloque-tab.active { background:#fff; color:#0f9488; font-weight:700; border-color:#0f9488 #0f9488 #fff; }
    .dark .bloque-tab { background:#1e293b; border-color:#334155; color:#94a3b8; }
    .dark .bloque-tab.active { background:#0f172a; color:#2dd4bf; border-color:#0d9488 #0d9488 #0f172a; }
    .bloque-content { display:none; }
    .bloque-content.active { display:block; }
    .resultado-card { border-radius:0.75rem; padding:1rem 1.25rem; border:1px solid; }
    .resultado-p50 { background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
    .resultado-p80 { background:#f0fdf4; border-color:#bbf7d0; color:#15803d; }
    .resultado-p90 { background:#fff7ed; border-color:#fed7aa; color:#c2410c; }
    .dark .resultado-p50 { background:#1e3a5f; border-color:#1d4ed8; color:#93c5fd; }
    .dark .resultado-p80 { background:#14532d; border-color:#15803d; color:#86efac; }
    .dark .resultado-p90 { background:#431407; border-color:#c2410c; color:#fdba74; }
    .tc-spinner { display:inline-block; width:1.25rem; height:1.25rem; border:2px solid #e2e8f0;
        border-top-color:#0f9488; border-radius:50%; animation:tc-spin 0.7s linear infinite; }
    @@keyframes tc-spin { to { transform:rotate(360deg); } }
    .tc-table-wrap { overflow-x:auto; max-height:60vh; overflow-y:auto; }
    .tc-table thead th { position:sticky; top:0; z-index:1; }
    /* TC tabs — activo en teal */
    .tab-btn[data-tab^="tc-"].mc-active { background:rgba(15,148,136,0.12) !important; color:#0d9488 !important; font-weight:600; }
    .dark .tab-btn[data-tab^="tc-"].mc-active { background:rgba(15,148,136,0.22) !important; color:#2dd4bf !important; }
    /* TC panels fuera del área paddead */
    .tc-tab-outer { background:#f8fafc; min-height:calc(100vh - 3.5rem); }
    .dark .tc-tab-outer { background:#020617; }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
}

<div class="flex" style="min-height:calc(100vh - 3.5rem)">

@* ════════════════════════ SIDEBAR ════════════════════════ *@
<aside id="mc-sidebar" class="w-52 flex-shrink-0 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-700 flex flex-col sticky top-0" style="height:calc(100vh - 3.5rem); overflow-y:auto">

    @* Sidebar header *@
    <div class="flex items-center justify-between px-3 py-3 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
        <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center flex-shrink-0">
                <span class="material-icons text-indigo-600 dark:text-indigo-400" style="font-size:16px">casino</span>
            </div>
            <span class="mc-sb-label text-sm font-bold text-slate-800 dark:text-slate-100 truncate">Monte Carlo</span>
        </div>
        <button type="button" onclick="toggleMcSidebar()"
                class="flex-shrink-0 p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
                title="Minimizar sidebar">
            <span class="material-icons text-base" id="mc-sidebar-icon">chevron_left</span>
        </button>
    </div>

    @* Sidebar nav *@
    <nav class="flex-1 overflow-y-auto py-2 px-2 space-y-0.5">

        @* ── Dashboard ── *@
        <p class="mc-sb-group px-2 pt-1 pb-1 text-xs font-semibold text-teal-600 dark:text-teal-500 uppercase tracking-wider">Dashboard</p>

        <button type="button" data-tab="tc-resumen" onclick="tcNav('resumen')" title="Resumen Global"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-teal-500" style="font-size:18px">insights</span>
            <span class="mc-sb-label truncate font-semibold">Resumen Global</span>
        </button>

        @* ── Taller Costos (datos de entrada para MC) ── *@
        <p class="mc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-teal-600 dark:text-teal-500 uppercase tracking-wider">Taller Costos</p>

        <button type="button" data-tab="tc-proyectos" onclick="tcNav('proyectos')" title="Proyectos Taller Costos"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-teal-500" style="font-size:18px">folder_open</span>
            <span class="mc-sb-label truncate">Proyectos</span>
        </button>

        <button type="button" data-tab="tc-empresas" onclick="tcNav('empresas')" title="Empresas contratistas del proyecto"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-teal-500" style="font-size:18px">business</span>
            <span class="mc-sb-label truncate">Empresas</span>
        </button>

        <button type="button" data-tab="tc-contratos" onclick="tcNav('contratos')" title="Contratos"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-teal-500" style="font-size:18px">receipt_long</span>
            <span class="mc-sb-label truncate">Contratos</span>
            <span class="step-badge tc-sb-label mc-sb-label" id="sb-contratos-count">0</span>
        </button>
        <button type="button" data-tab="risks" onclick="activateTab('risks')" title="Riesgos del Proyecto"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-red-500" style="font-size:18px">shield</span>
            <span class="mc-sb-label truncate">Riesgos</span>
            <span id="badge-risks" class="mc-sb-badge hidden ml-auto w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
        </button>
        <button type="button" data-tab="schedule" onclick="activateTab('schedule')" title="Cronograma del Proyecto"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
            <span class="material-icons flex-shrink-0 text-blue-500" style="font-size:18px">schedule</span>
            <span class="mc-sb-label truncate">Cronograma</span>
            <span id="badge-schedule" class="mc-sb-badge hidden ml-auto w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
        </button>
        <button type="button" data-tab="corr" onclick="activateTab('corr')" title="Análisis de Correlación — Cópula Gaussiana"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-pink-50 dark:hover:bg-pink-900/20">
            <span class="material-icons flex-shrink-0 text-pink-500" style="font-size:18px">hub</span>
            <span class="mc-sb-label truncate">Correlación</span>
            <span id="badge-corr" class="mc-sb-badge hidden ml-auto w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
        </button>
        <button type="button" data-tab="formulas" onclick="activateTab('formulas')" title="Fundamento Técnico — Libro interactivo y fórmulas de referencia"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-amber-50 dark:hover:bg-amber-900/20">
            <span class="material-icons flex-shrink-0 text-amber-500" style="font-size:18px">menu_book</span>
            <span class="mc-sb-label truncate">Fundamento Técnico</span>
        </button>

        <div id="sb-contrato-items" class="hidden space-y-0.5">
            <p class="mc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Contrato Activo</p>
            <button type="button" data-tab="tc-bloqueA" onclick="tcNav('bloqueA')" title="Bloque A — Resumen"
                    class="tab-btn w-full flex items-center gap-2.5 pl-5 pr-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
                <span class="material-icons flex-shrink-0 text-teal-400" style="font-size:16px">table_chart</span>
                <span class="mc-sb-label truncate">A — Resumen</span>
            </button>
            <button type="button" data-tab="tc-bloqueB" onclick="tcNav('bloqueB')" title="Bloque B — Ítems"
                    class="tab-btn w-full flex items-center gap-2.5 pl-5 pr-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
                <span class="material-icons flex-shrink-0 text-teal-400" style="font-size:16px">list_alt</span>
                <span class="mc-sb-label truncate">B — Ítems</span>
            </button>
            <button type="button" data-tab="tc-bloqueD" onclick="tcNav('bloqueD')" title="D — Rangos"
                    class="tab-btn w-full flex items-center gap-2.5 pl-5 pr-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
                <span class="material-icons flex-shrink-0 text-teal-400" style="font-size:16px">bar_chart</span>
                <span class="mc-sb-label truncate">D — Rangos</span>
            </button>
            <button type="button" data-tab="tc-bloqueE" onclick="tcNav('bloqueE')" title="C — Factores"
                    class="tab-btn w-full flex items-center gap-2.5 pl-5 pr-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
                <span class="material-icons flex-shrink-0 text-teal-400" style="font-size:16px">tune</span>
                <span class="mc-sb-label truncate">C — Factores</span>
            </button>
            <button type="button" data-tab="tc-bloqueF" onclick="tcNav('bloqueF')" title="E — Resultado"
                    class="tab-btn w-full flex items-center gap-2.5 pl-5 pr-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-teal-50 dark:hover:bg-teal-900/20">
                <span class="material-icons flex-shrink-0 text-teal-400" style="font-size:16px">category</span>
                <span class="mc-sb-label truncate">E — Resultado</span>
            </button>
        </div>

        <div class="my-2 border-t border-slate-100 dark:border-slate-800 mx-1"></div>

        <button type="button" data-tab="ia" onclick="activateTab('ia')" title="ASISTENTE GPR — Experto Monte Carlo"
                class="tab-btn w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm transition-colors text-slate-600 dark:text-slate-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30">
            <span class="material-icons flex-shrink-0 text-indigo-500" style="font-size:18px">smart_toy</span>
            <span class="mc-sb-label truncate font-medium text-indigo-600 dark:text-indigo-400">ASISTENTE GPR</span>
            <span class="mc-sb-badge ml-auto inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 flex-shrink-0">GPR</span>
        </button>

    </nav>

    @* Sidebar footer — ayuda *@
    <div class="flex-shrink-0 border-t border-slate-200 dark:border-slate-700 p-2">
        <button type="button" onclick="toggleMcHelp()"
                class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors"
                title="¿Cómo funciona?">
            <span class="material-icons flex-shrink-0" style="font-size:18px">help_outline</span>
            <span class="mc-sb-label">¿Cómo funciona?</span>
        </button>
    </div>
</aside>

@* ════════════════════════ CONTENIDO ════════════════════════ *@
<div class="flex-1 min-w-0 overflow-x-auto">
<div class="px-5 sm:px-7 py-5">


    @* Alerta de error *@
    @if (Model.ApiError != null)
    {
        <div class="mb-5 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 p-4 text-red-800 dark:text-red-200 text-sm flex items-start gap-3">
            <span class="material-icons text-red-500 flex-shrink-0 text-base mt-0.5">error</span>
            <span>@Model.ApiError</span>
        </div>
    }

    @* ═══════════════════════ PANEL: CÓMO FUNCIONA ═══════════════════════ *@

    @* ═══════════════════════ TAB: RIESGOS ═══════════════════════ *@
    <div id="tab-risks" class="tab-content @(tab != "risks" ? "hidden" : "")">
        @* ── Selector de proyecto (proyectos del Taller de Costos) ─────────── *@
        <div class="mb-4 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-white dark:bg-slate-900 p-3 space-y-2">
            <div class="flex flex-wrap items-center gap-2">
                <span class="material-icons text-indigo-500 dark:text-indigo-400 text-base">folder_open</span>
                <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Proyecto</span>
                <select id="risks-project-select" onchange="onRisksProjectSelect()"
                        class="mc-input flex-1" style="min-width:200px;max-width:480px">
                    <option value="">— Seleccione un proyecto —</option>
                </select>
                <button type="button" onclick="refreshRisksProjectList()"
                        class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-300 dark:hover:border-indigo-600 transition-colors" title="Actualizar lista">
                    <span class="material-icons text-base">refresh</span>
                </button>
            </div>
            <div id="tc-risks-proj-banner" class="hidden flex items-center gap-1.5 text-xs text-indigo-600 dark:text-indigo-400">
                <span class="material-icons text-sm">check_circle</span>
                <span id="tc-risks-proj-banner-text"></span>
            </div>
        </div>
        <details class="mb-5 rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/20">
            <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900/20 rounded-xl transition-colors">
                <span class="material-icons text-base flex-shrink-0">shield</span>
                <span class="font-semibold text-sm">Riesgos en Costo — ¿Cómo funciona este análisis?</span>
                <span class="material-icons text-base ml-auto">expand_more</span>
            </summary>
            <div class="px-4 pb-4 pt-1 space-y-3 text-sm text-slate-700 dark:text-slate-300">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-red-200 dark:border-red-800 p-3">
                        <p class="text-xs font-bold text-red-700 dark:text-red-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">functions</span>Cómo funciona</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Cada riesgo combina dos distribuciones: <strong>Bernoulli</strong> (¿ocurre o no?) según la probabilidad ingresada, y <strong>Triangular/PERT/Normal</strong> (¿cuánto impacta?) si ocurre. En cada una de las 10.000 iteraciones el motor decide si cada riesgo se materializa y calcula el impacto total sumado de todos los eventos que ocurrieron.</p>
                    </div>
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-red-200 dark:border-red-800 p-3">
                        <p class="text-xs font-bold text-red-700 dark:text-red-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">input</span>Qué ingresar</p>
                        <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-0.5">
                            <li><strong>Causa raíz:</strong> origen del evento (p.ej. "Inflación")</li>
                            <li><strong>Evento de riesgo:</strong> qué puede ocurrir</li>
                            <li><strong>Consecuencia:</strong> efecto en el proyecto</li>
                            <li><strong>Prob. (%):</strong> frecuencia de ocurrencia (ej: 55 = 55%)</li>
                            <li><strong>Impacto mín/probable/máx:</strong> rango monetario si ocurre</li>
                            <li><strong>Distribución:</strong> forma de la curva de impacto</li>
                        </ul>
                    </div>
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-red-200 dark:border-red-800 p-3">
                        <p class="text-xs font-bold text-red-700 dark:text-red-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">analytics</span>Qué entrega</p>
                        <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-0.5">
                            <li><strong>Pérdida esperada (media):</strong> costo promedio de los riesgos</li>
                            <li><strong>P80:</strong> provisión recomendada para cubrir el 80% de escenarios</li>
                            <li><strong>P90:</strong> reserva máxima de contingencia</li>
                            <li><strong>P(≥1 riesgo):</strong> probabilidad de que al menos un riesgo ocurra</li>
                            <li><strong>Histograma + CDF:</strong> distribución completa de pérdidas</li>
                        </ul>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-3">
                        <p class="text-xs font-bold text-amber-700 dark:text-amber-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">lightbulb</span>Importancia y cuándo usarlo</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Es la base del análisis de contingencia en cualquier proyecto de inversión. Supera a la simple suma de pérdidas esperadas porque modela la <strong>simultaneidad</strong> de eventos. Un P80 calculado con Monte Carlo refleja el escenario real del 80%, no una suma conservadora de todos los riesgos. Esencial para determinar el fondo de contingencia en contratos EPC o proyectos de capital.</p>
                    </div>
                </div>
            </div>
        </details>
        <form id="risks-form">
            @Html.AntiForgeryToken()
            <div class="flex items-center gap-2 mb-2">
                <button type="button" id="btn-toggle-risk-extra"
                        onclick="tcToggleRiskExtraCols()"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-500 dark:text-slate-400 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-icons text-sm">visibility_off</span>
                    <span id="btn-toggle-risk-extra-lbl">Mostrar columnas adicionales</span>
                </button>
            </div>
            <style>
                /* Ancho completo: el pie debe tener el mismo nº de columnas lógicas que el cuerpo (ver risks-tfoot-tail). */
                #risks-form .mc-risks-table { table-layout: fixed; width: 100%; min-width: 100%; }
                #risks-form .mc-risks-table th,
                #risks-form .mc-risks-table td { overflow-wrap: break-word; word-break: break-word; }
                #risks-form .mc-risk-read-cell { overflow-wrap: anywhere; }
                #risks-form .mc-risks-table.mc-risks-with-extra th.mc-col-descr { width: 14%; }
                #risks-form .mc-risks-table.mc-risks-with-extra th.mc-col-causas { width: 12%; }
                #risks-form .mc-risks-table.mc-risks-with-extra th.mc-col-plan { width: 12%; }
                #risks-form .mc-risks-table:not(.mc-risks-with-extra) th.mc-col-descr { width: 22%; }
                #risks-form .mc-risks-table:not(.mc-risks-with-extra) th.mc-col-causas { width: 20%; }
                #risks-form .mc-risks-table:not(.mc-risks-with-extra) th.mc-col-plan { width: 20%; }
            </style>
            <div class="w-full min-w-0 overflow-x-auto mb-4 rounded-xl border border-slate-200 dark:border-slate-700">
                <table class="mc-risks-table w-full min-w-full text-sm table-fixed border-collapse">
                    <thead class="bg-slate-50 dark:bg-slate-800 text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.5rem]" title="Tipo">Tipo</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[3.25rem]" title="Origen">Orig.</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[3.5rem]" title="Código riesgo">Cód.</th>
                            <th class="mc-col-descr px-1.5 py-2 text-left align-bottom whitespace-normal leading-tight min-w-0" title="Riesgo Proyecto">Riesgo Proyecto</th>
                            <th class="mc-col-causas px-1.5 py-2 text-left align-bottom whitespace-normal leading-tight min-w-0" title="Titulo Riesgo">Titulo Riesgo</th>
                            <th class="mc-col-plan px-1.5 py-2 text-left align-bottom whitespace-normal leading-tight min-w-0" title="Causas - (Debido a...)">Causas -<br /><span class="normal-case font-medium opacity-80">(Debido a...)</span></th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[3.75rem]" title="Probabilidad (%, escala CODELCO)">
                                Prob.<br />%
                                <span class="inline-block align-middle cursor-help text-slate-400 hover:text-indigo-500 transition-colors"
                                      title="Escala CODELCO: 5=Casi Seguro (&gt;75%) | 4=Muy Probable (&gt;50-75%) | 3=Probable (&gt;30-50%) | 2=Poco Probable (&gt;10-30%) | 1=Remoto (≤10%)">
                                    <span class="material-icons" style="font-size:12px;vertical-align:middle">info</span>
                                </span>
                            </th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.25rem]" title="Impacto mínimo">Mín.</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.25rem]" title="Impacto probable">Prob.</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.25rem]" title="Impacto máximo">Máx.</th>
                            <th class="px-1 py-2 text-left align-bottom whitespace-normal leading-tight w-[4.5rem]" title="Modelo de probabilidades del impacto">Mod.</th>
                            <th class="px-1 py-2 text-right align-bottom whitespace-normal leading-tight w-[4.5rem]" title="Valor esperado (USD)">VE<br /><span class="normal-case font-medium opacity-80">USD</span></th>
                            <th class="px-1.5 py-2 text-left align-bottom whitespace-normal leading-tight min-w-0 w-[14%] tc-risk-extra" style="display:none" title="Plan de Respuesta para resguardar costos">Plan de Respuesta para resguardar costos</th>
                            <th class="px-0.5 py-2 w-9 align-bottom"></th>
                        </tr>
                    </thead>
                    <tbody id="risks-body" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                        <tr class="data-row align-top">
                            <td class="px-1 py-1.5 align-top min-w-0">
                                <select name="Risks[0].Tipo" class="mc-input risk-tipo-sel max-w-full w-full min-w-0" style="max-width:6.5rem" onchange="tcUpdateRiskTipoColor(this)">
                                    <option value="Amenaza">⚠ Amenaza</option>
                                    <option value="Oportunidad">✦ Oportunidad</option>
                                </select>
                            </td>
                            <td class="px-1 py-1.5 align-top min-w-0"><input name="Risks[0].Origin" type="text" placeholder="Origen..." class="mc-input w-full min-w-0 max-w-full box-border" /></td>
                            <td class="px-1 py-1.5 align-top min-w-0"><input name="Risks[0].Code" type="text" placeholder="Cód..." class="mc-input w-full min-w-0 max-w-full box-border font-mono text-xs" /></td>
                            <td class="px-1.5 py-1.5 align-top min-w-0"><textarea name="Risks[0].Description" placeholder="Riesgo Proyecto..." class="mc-input mc-risk-textarea w-full min-w-0 max-w-full box-border" style="min-height:2.75rem;resize:vertical;line-height:1.4" rows="2" oninput="tcAutoResize(this)"></textarea></td>
                            <td class="px-1.5 py-1.5 align-top min-w-0"><textarea name="Risks[0].Cause" placeholder="Titulo Riesgo..." class="mc-input mc-risk-textarea w-full min-w-0 max-w-full box-border" style="min-height:2.75rem;resize:vertical;line-height:1.4" rows="2" oninput="tcAutoResize(this)"></textarea></td>
                            <td class="px-1.5 py-1.5 align-top min-w-0"><textarea name="Risks[0].ResponsePlan" placeholder="Causas - (Debido a...)" class="mc-input mc-risk-textarea w-full min-w-0 max-w-full box-border" style="min-height:2.75rem;resize:vertical;line-height:1.4" rows="2" oninput="tcAutoResize(this)"></textarea></td>
                            <td class="px-1 py-1.5 align-top min-w-0">
                                <div class="flex flex-col items-center gap-0.5">
                                    <input name="Risks[0].Probability" type="number" step="1" min="0" max="100" value="50" class="mc-input text-center" style="width:65px" oninput="calcRiskVE(this)" />
                                    <span class="risk-prob-badge inline-flex items-center gap-0.5 px-1 py-px rounded font-semibold whitespace-nowrap leading-tight" style="background:#FACC15;color:#000;font-size:10px">3 Probable</span>
                                </div>
                            </td>
                            <td class="px-1 py-1.5 align-top min-w-0"><input name="Risks[0].MinImpact" type="text" inputmode="numeric" value="0" class="mc-input risk-impact-input w-full min-w-0 max-w-full box-border text-xs" oninput="calcRiskVE(this)" /></td>
                            <td class="px-1 py-1.5 align-top min-w-0"><input name="Risks[0].MostLikelyImpact" type="text" inputmode="numeric" value="0" class="mc-input risk-impact-input w-full min-w-0 max-w-full box-border text-xs" oninput="calcRiskVE(this)" /></td>
                            <td class="px-1 py-1.5 align-top min-w-0"><input name="Risks[0].MaxImpact" type="text" inputmode="numeric" value="0" class="mc-input risk-impact-input w-full min-w-0 max-w-full box-border text-xs" oninput="calcRiskVE(this)" /></td>
                            <td class="px-1 py-1.5 align-top min-w-0">
                                <select name="Risks[0].Distribution" class="mc-input w-full min-w-0 max-w-full box-border text-xs" style="max-width:5.5rem">
                                    <option value="Triangular">Triangular</option>
                                    <option value="Normal">Normal</option>
                                    <option value="PERT">PERT</option>
                                    <option value="Uniform">Uniforme</option>
                                </select>
                            </td>
                            <td class="px-1 py-1.5 text-right risk-ve-cell align-top min-w-0"><span class="risk-ve-val text-xs font-semibold text-slate-400 break-all" data-ve="0">$0</span></td>
                            <td class="px-1.5 py-1.5 tc-risk-extra align-top min-w-0" style="display:none"><textarea name="Risks[0].EstimationBase" placeholder="Plan de Respuesta para resguardar costos..." class="mc-input mc-risk-textarea w-full min-w-0 max-w-full box-border" style="min-height:2.75rem;resize:vertical;line-height:1.4" rows="2" oninput="tcAutoResize(this)"></textarea></td>
                            <td class="px-0.5 py-1.5 text-center align-top w-9">
                                <button type="button" onclick="removeRow(this,'risks-body','Risks')" class="text-slate-400 hover:text-red-500 transition-colors" title="Eliminar"><span class="material-icons text-base">delete</span></button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="border-t-2 border-slate-300 dark:border-slate-600">
                        <tr class="bg-slate-50 dark:bg-slate-800">
                            <td colspan="11" class="px-2 py-2 text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Total portafolio — Valor Esperado</td>
                            <td id="risks-ve-total" class="px-2 py-2 text-right font-bold text-sm text-slate-500 dark:text-slate-400">$0</td>
                            @* Con extras ocultas: solo columna acciones (1). Con extras: 1 extra + acciones (2). *@
                            <td id="risks-tfoot-tail" colspan="1"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="flex flex-wrap items-center gap-3 mb-3">
                <button type="button" onclick="addRiskRow()"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-icons text-base">add</span> Agregar riesgo
                </button>
                <button type="button" onclick="exportarRisksCSV()"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="material-icons text-base">download</span> Exportar CSV
                </button>
                <button id="btn-save-risks" type="button" onclick="saveRisksData()"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-300 dark:border-emerald-700 text-emerald-700 dark:text-emerald-400 text-sm font-medium hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-colors">
                    <span class="material-icons text-base">save</span> Guardar
                </button>
                <div class="flex items-center gap-2 ml-auto">
                    <label class="text-sm text-slate-600 dark:text-slate-300">Simulaciones</label>
                    <input name="RiskSimulations" type="number" min="1000" max="1000000" value="10000" class="mc-input" style="width:110px" />
                </div>
                <button id="btn-exec-risks" type="button" onclick="executeRisks()"
                        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors">
                    <span class="material-icons text-base">play_arrow</span>
                    <span id="btn-exec-risks-lbl">Ejecutar</span>
                </button>
                <button type="button" onclick="tcLimpiarProjTab('risks')"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 text-sm font-medium hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                    <span class="material-icons text-base">delete_sweep</span> Limpiar
                </button>
            </div>
            <div id="risks-ajax-error" class="hidden mb-3 flex items-center gap-2 px-3 py-2 rounded-lg bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 text-sm text-red-700 dark:text-red-300">
                <span class="material-icons text-base flex-shrink-0">error</span>
                <span id="risks-ajax-error-msg"></span>
            </div>
        </form>
        @if (tab == "risks" && Model.ResultJson != null)
        {
            <script type="application/json" id="mc-data-risks">@Html.Raw(Model.ResultJson)</script>
        }
        <div id="risks-result-section" class="@(tab == "risks" && Model.ResultJson != null ? "" : "hidden") rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 p-4 space-y-4">
            <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-medium text-sm">
                <span class="material-icons text-base">check_circle</span> Resultado — Análisis de Riesgos
                <span class="gpr-tt gpr-tt-right"><span class="material-icons gpr-tt-icon" style="color:#059669">help_outline</span><span class="gpr-tt-box">Impacto total de los riesgos en costo, simulado con Monte Carlo. En cada iteración, cada riesgo puede materializarse según su probabilidad (evento Bernoulli), y su impacto se toma de la distribución triangular (Mín/Probable/Máx). El resultado es la distribución de pérdida total combinada.</span></span>
            </div>
            <div id="mc-kpi-risks" class="space-y-2"></div>
            <div id="mc-kpi-risks-tipo" class="grid grid-cols-2 gap-3"></div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Frecuencias</span>
                        <span class="flex gap-1">
                            <input id="mc-fmin-risks" type="number" placeholder="Mín." class="mc-input" style="width:80px" />
                            <input id="mc-fmax-risks" type="number" placeholder="Máx." class="mc-input" style="width:80px" />
                            <button onclick="applyMcFilter('risks')" class="px-2 py-1 rounded bg-indigo-600 text-white text-xs hover:bg-indigo-700" title="Filtrar"><span class="material-icons" style="font-size:13px;line-height:1">filter_alt</span></button>
                            <button onclick="resetMcFilter('risks')" class="px-2 py-1 rounded border border-slate-300 dark:border-slate-600 text-slate-500 text-xs" title="Limpiar"><span class="material-icons" style="font-size:13px;line-height:1">clear</span></button>
                        </span>
                    </div>
                    <canvas id="mc-chart-risks" height="150"></canvas>
                </div>
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
                    <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wide block mb-1 flex items-center gap-1">
                        Distribución Acumulada (CDF)
                        <span class="gpr-tt gpr-tt-left"><span class="material-icons gpr-tt-icon">help_outline</span><span class="gpr-tt-box">Función de Distribución Acumulada: el eje Y indica la probabilidad de que el costo/plazo no supere el valor del eje X. Permite leer cualquier percentil directamente. Una curva más vertical indica menor incertidumbre; más inclinada, mayor variabilidad.</span></span>
                    </span>
                    <canvas id="mc-cdf-risks" height="150"></canvas>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
                    <p class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-2 uppercase tracking-wide">Tabla de Percentiles</p>
                    <div id="mc-pct-risks" class="grid grid-cols-2 gap-x-6 gap-y-0.5 text-xs"></div>
                </div>
                <div id="mc-decisions-risks" class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-3"></div>
            </div>
            <div id="risks-verification-card" class="hidden bg-white dark:bg-slate-900 rounded-xl border border-indigo-200 dark:border-indigo-800 p-4"></div>
        </div>
    </div>

    @* ═══════════════════════ TAB: COSTOS ═══════════════════════ *@
    <div id="tab-costs" class="tab-content @(tab != "costs" ? "hidden" : "")">
        <details class="mb-5 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/20">
            <summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/20 rounded-xl transition-colors">
                <span class="material-icons text-base flex-shrink-0">attach_money</span>
                <span class="font-semibold text-sm">Estimación de Costos — ¿Cómo funciona este análisis?</span>
                <span class="material-icons text-base ml-auto">expand_more</span>
            </summary>
            <div class="px-4 pb-4 pt-1 space-y-3 text-sm text-slate-700 dark:text-slate-300">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-emerald-200 dark:border-emerald-800 p-3">
                        <p class="text-xs font-bold text-emerald-700 dark:text-emerald-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">functions</span>Cómo funciona</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">En cada iteración, el motor muestrea un valor aleatorio de la distribución de cada componente de costo (Triangular, PERT, Normal o Uniforme) y los <strong>suma</strong>. La distribución del costo total emergente es no lineal: tiende a ser asimétrica hacia la derecha (cola de sobrecostos). Además, cada componente puede tener <strong>oportunidades</strong> (reducen el costo) y <strong>amenazas</strong> (lo aumentan) modeladas como eventos Bernoulli.</p>
                    </div>
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-emerald-200 dark:border-emerald-800 p-3">
                        <p class="text-xs font-bold text-emerald-700 dark:text-emerald-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">input</span>Qué ingresar</p>
                        <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-0.5">
                            <li><strong>Nombre:</strong> componente de costo (p.ej. "Obras civiles")</li>
                            <li><strong>Costo base:</strong> estimación determinística de referencia</li>
                            <li><strong>Clase de estimación:</strong> Clase 1–5 (precisión del estimado)</li>
                            <li><strong>Mín/Probable/Máx:</strong> rango de variación del costo</li>
                            <li><strong>Oportunidad:</strong> prob. y monto de reducción de costo</li>
                            <li><strong>Amenaza:</strong> prob. y monto de aumento de costo</li>
                        </ul>
                    </div>
                    <div class="rounded-lg bg-white dark:bg-slate-800 border border-emerald-200 dark:border-emerald-800 p-3">
                        <p class="text-xs font-bold text-emerald-700 dark:text-emerald-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">analytics</span>Qué entrega</p>
                        <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-0.5">
                            <li><strong>P50:</strong> presupuesto base (50% de prob. de no superar)</li>
                            <li><strong>P80:</strong> presupuesto con contingencia estándar</li>
                            <li><strong>P90:</strong> reserva de gestión / límite de directorio</li>
                            <li><strong>Coef. de variación (CV):</strong> nivel de incertidumbre total</li>
                            <li><strong>Diferencia P80–P50:</strong> monto exacto de contingencia recomendada</li>
                        </ul>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-3">
                        <p class="text-xs font-bold text-amber-700 dark:text-amber-300 mb-1 flex items-center gap-1"><span class="material-icons" style="font-size:13px">lightbulb</span>Importancia y cuándo usarlo</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">La suma de los costos más probables de cada ítem sistemáticamente <strong>subestima</strong> el costo total real del proyecto. Monte Carlo revela la distribución completa y muestra que, por ejemplo, es incorrecto sumar el valor más probable de cada componente. Fundamental para licitaciones, estudios de factibilidad y auditorías de presupuesto. La <strong>Clase de Estimación</strong> ayuda a contextualizar la incertidumbre según el avance del diseño.</p>
                    </div>
                    <div class="rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3">
                        <p class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-2 flex items-center gap-1"><span class="material-icons" style="font-size:13px">device_hub</span>Se combina con otras pestañas</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-violet-100 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300 border border-violet-200 dark:border-violet-700">
                                <span class="material-icons" style="font-size:11px">account_balance</span>CRA — Costos + Riesgos
                            </span>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-700">
                                <span class="material-icons" style="font-size:11px">shield</span>Riesgos (como base del CRA)
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">El <strong>CRA</strong> combina la distribución de esta pestaña con la de <strong>Riesgos</strong>: el costo total ya incluye tanto la incertidumbre de estimación como el impacto esperado de los eventos de riesgo. Resultado = presupuesto integral ajustado por riesgo.</p>
                    </div>
                </div>
            </div>
        </details>
