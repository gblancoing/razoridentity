@if (Model.MostrarModuloControlFisico)
{
<div id="pmo-cf-import-modal" class="hidden fixed inset-0 z-[199] flex items-center justify-center bg-black/45 p-4" aria-hidden="true">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl max-w-lg w-full p-6 border border-slate-200 dark:border-slate-600 relative" role="dialog" aria-modal="true" aria-labelledby="pmo-cf-import-title">
        <button type="button" id="pmo-cf-import-modal-close-x" class="absolute top-3 right-3 p-1 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700" title="Cerrar">
            <span class="material-icons text-[22px]">close</span>
        </button>
        <h3 id="pmo-cf-import-title" class="text-lg font-bold text-slate-800 dark:text-slate-100 pr-10 mb-1">Importar avance físico</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Reemplazo por tabla destino (solo filas de este proyecto en esa tabla).</p>
        <div class="space-y-3">
            <div>
                <label for="pmo-cf-tabla-import" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tabla destino</label>
                <select id="pmo-cf-tabla-import" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm text-slate-800 dark:text-slate-100">
                    <option value="av_fisico_real">av_fisico_real</option>
                    <option value="av_fisico_npc">av_fisico_npc</option>
                    <option value="av_fisico_poa">av_fisico_poa</option>
                    <option value="av_fisico_v0">av_fisico_v0</option>
                    <option value="av_fisico_api">av_fisico_api</option>
                </select>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Primera hoja del Excel: <span class="font-mono">id</span>, <span class="font-mono">periodo</span> o fecha, <span class="font-mono">vector</span>, <span class="font-mono">ie_parcial</span>, … (también <span class="font-mono">IeParcial</span>, <span class="font-mono">ApiAcum</span>, <span class="font-mono">id_av_vo</span>, etc.). Las tablas <span class="font-mono">av_fisico_*</span> son <strong>independientes</strong>: no se alteran las demás ni la entidad de proyectos.</p>
            <div class="flex flex-wrap items-center gap-2 pt-1">
                <button type="button" id="pmo-cf-import-modal-file-btn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium shadow-sm">
                    <span class="material-icons text-[18px]">folder_open</span> Seleccionar Excel…
                </button>
                <button type="button" id="pmo-cf-import-modal-close-btn" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700">Cancelar</button>
            </div>
            <input type="file" id="pmo-cf-file" accept=".xlsx,.xls" class="hidden" />
        </div>
    </div>
</div>
<div id="pmo-cf-modal-clave" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/40 p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl max-w-md w-full p-6 border border-slate-200 dark:border-slate-600">
        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-2">Clave de importación</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Requerida para importar avance físico.</p>
        <input type="password" id="pmo-cf-clave-input" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 mb-4 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100" placeholder="Clave" autocomplete="off" />
        <div class="flex justify-end gap-2">
            <button type="button" id="pmo-cf-clave-cancel" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-sm">Cancelar</button>
            <button type="button" id="pmo-cf-clave-ok" class="px-4 py-2 rounded-lg bg-teal-600 text-white text-sm font-medium">Continuar</button>
        </div>
    </div>
</div>
<script>
    window.__pmoCfCfg = { pageBase: '@pmoUrl' };
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<script src="~/js/pmo-control-fisico.js" asp-append-version="true"></script>
<script>
(function () {
    if (!document.getElementById('pmo-cf-proyecto-id')) return;
    if (window.pmoControlFisicoInit) {
        window.pmoControlFisicoInit(function () {
            return document.getElementById('pmo-cf-proyecto-id').value || null;
        });
    }
})();
</script>
}
