                            <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm">
                                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100 mb-2">Tendencia financiera (MM USD)</h4>
                                <div class="relative h-[min(22rem,50vh)] w-full"><canvas id="pmo-pred-chart-fin"></canvas></div>
                            </div>
                            <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm">
                                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100 mb-2">Tendencia física (%)</h4>
                                <div class="relative h-[min(22rem,50vh)] w-full"><canvas id="pmo-pred-chart-fis"></canvas></div>
                            </div>
                        </div>
                        <div id="pmo-pred-historico-host" class="w-full"></div>
                    </section>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.MostrarModuloPmo || Model.MostrarSeccionResumen)
{
<div id="vf-modal-clave" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/40 p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl max-w-md w-full p-6 border border-slate-200 dark:border-slate-600">
        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-2">Clave de importación</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Validación en servidor.</p>
        <input type="password" id="vf-clave-input" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 mb-4 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100" placeholder="Clave" autocomplete="off" />
        <div class="flex justify-end gap-2">
            <button type="button" id="vf-clave-cancel" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-sm">Cancelar</button>
            <button type="button" id="vf-clave-ok" class="px-4 py-2 rounded-lg bg-teal-600 text-white text-sm font-medium">Continuar</button>
        </div>
    </div>
</div>

<div id="vf-modal-cascada" class="hidden fixed inset-0 z-[205] flex items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[1px]" aria-hidden="true">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl max-w-6xl w-full p-5 border border-amber-200/90 dark:border-amber-700/70 relative max-h-[90vh] overflow-hidden" role="dialog" aria-modal="true" aria-labelledby="vf-cascada-title">
        <button type="button" id="vf-cascada-close-x" class="absolute top-3 right-3 p-1 rounded-lg text-slate-500 hover:bg-amber-50 dark:hover:bg-slate-700" title="Cerrar">
            <span class="material-icons text-[22px]">close</span>
        </button>
        <h3 id="vf-cascada-title" class="text-lg font-bold text-slate-800 dark:text-slate-100 pr-10 inline-flex items-center gap-2">
            <span class="material-icons text-amber-500 text-[20px]">insights</span>
            Análisis Detallado de Cascada
        </h3>
        <p id="vf-cascada-sub" class="text-xs text-teal-700 dark:text-teal-300 mt-1 font-medium"></p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mt-4 text-sm">
            <div class="rounded-lg border border-amber-200 dark:border-amber-700/70 bg-amber-50/50 dark:bg-amber-900/20 p-3"><div class="text-xs text-amber-800 dark:text-amber-200 uppercase tracking-wide">Total Base</div><div id="vf-cascada-kpi-base" class="font-semibold text-slate-800 dark:text-slate-100">—</div></div>
            <div class="rounded-lg border border-teal-200 dark:border-teal-700/70 bg-teal-50/40 dark:bg-teal-900/20 p-3"><div class="text-xs text-teal-800 dark:text-teal-200 uppercase tracking-wide">Total Real</div><div id="vf-cascada-kpi-real" class="font-semibold text-slate-800 dark:text-slate-100">—</div></div>
            <div class="rounded-lg border border-sky-200 dark:border-sky-700/70 bg-sky-50/40 dark:bg-sky-900/20 p-3"><div class="text-xs text-sky-800 dark:text-sky-200 uppercase tracking-wide">Diferencia</div><div id="vf-cascada-kpi-dif" class="font-semibold text-slate-800 dark:text-slate-100">—</div></div>
            <div class="rounded-lg border border-slate-300 dark:border-slate-600 bg-white/60 dark:bg-slate-800/40 p-3"><div class="text-xs text-slate-600 dark:text-slate-300 uppercase tracking-wide">% Desviación</div><div id="vf-cascada-kpi-pct" class="font-semibold text-slate-800 dark:text-slate-100">—</div></div>
        </div>
        <div class="mt-3 rounded-lg border border-amber-200 dark:border-amber-700/70 p-3 bg-gradient-to-r from-amber-50 to-teal-50 dark:from-amber-900/20 dark:to-teal-900/20">
            <p id="vf-cascada-conclusiones" class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">Cargando...</p>
        </div>
        <div class="mt-3 rounded-lg border border-slate-200 dark:border-slate-600 overflow-auto max-h-[42vh] shadow-inner">
            <table class="min-w-full text-xs">
                <thead class="bg-gradient-to-r from-slate-800 to-teal-800 text-white">
                    <tr>
                        <th class="p-2 text-left">Período</th><th class="p-2 text-right">Base USD</th><th class="p-2 text-right">Real USD</th><th class="p-2 text-right">Diferencia USD</th><th class="p-2 text-right">% Diferencia</th>
                    </tr>
                </thead>
                <tbody id="vf-cascada-tbody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    window.__pycFinCfg = @Html.Raw(Model.FinancierosCatalogJson);
    window.__pycFinCfg.pageBase = '@pmoUrl';
    @if (Model.MostrarSeccionResumen)
    {
        <text>window.__pycFinCfg.iniciarEnCurvaS = true;</text>
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="~/js/pyc-vectores-financieros.js" asp-append-version="true"></script>
<script>
(function () {
    if (!document.getElementById('pmo-proyecto-id')) return;
    if (window.pycVectoresFinInit) {
        window.pycVectoresFinInit(function () {
            return document.getElementById('pmo-proyecto-id').value || null;
        });
    }
})();
</script>
}

@if (Model.MostrarSeccionResumen)
{
<script>
    window.__pmoResumenCfg = { pageBase: '@pmoUrl' };
</script>
<script src="~/js/pmo-resumen-kpi.js" asp-append-version="true"></script>
<script>
(function () {
    var el = document.getElementById('pmo-resumen-proyecto-id');
