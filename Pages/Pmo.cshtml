@page "/PMO"
@model RazorIdentity.Pages.PmoModel
@{
    ViewData["Title"] = "PMO";
    ViewData["SuppressFloatingChat"] = true;
    var pmoUrl = Url.Page("/PMO");
    var pid = Model.ProyectoActivoId;
    string NavPmo(string seccion) => Url.Page("/PMO", null, new { proyectoId = pid, seccion }) ?? "/PMO";
    var navProyecto = Url.Page("/PMO", null, new { proyectoId = pid, seccion = "proyecto" }) ?? "/PMO";
    var navVectores = pid is { } pidV ? Url.Page("/PMO", null, new { proyectoId = pidV, seccion = "vectores" }) : null;
    var navControlFisico = pid is { } pidCf ? Url.Page("/PMO", null, new { proyectoId = pidCf, seccion = "control_fisico" }) : null;
    var navResumen = pid is { } pidR ? Url.Page("/PMO", null, new { proyectoId = pidR, seccion = "resumen" }) : null;
    var navGeneralSolo = Url.Page("/PMO", null, new { seccion = "general" }) ?? "/PMO";
    var esMenuResumen = Model.MostrarSeccionResumen;
    var esMenuGeneral = Model.MostrarSeccionGeneral;
    var esMenuProyecto = !esMenuGeneral && (!Model.ProyectoActivoId.HasValue || string.Equals(Model.PmoSeccion, "proyecto", StringComparison.OrdinalIgnoreCase));
    var pmoMenu = new (string Id, string Etiqueta, bool RequiereProyecto, string Grupo, string Icono, string IconoColor)[]
    {
        ("general", "General", false, "Marco", "menu_book", "text-amber-500"),
        ("proyecto", "Proyecto", false, "Marco", "folder_special", "text-teal-500"),
        ("resumen", "Resumen General", true, "Tablero", "insights", "text-teal-500"),
        ("vectores", "Vectores Financiero", true, "Tablero", "stacked_line_chart", "text-sky-500"),
        ("control_fisico", "Control Físico", true, "Tablero", "timeline", "text-emerald-500"),
        ("factorial", "Factorial", true, "Análisis", "bubble_chart", "text-indigo-500"),
        ("gestion_proyecto", "Gestión de Proyecto", true, "Análisis", "assignment", "text-blue-500"),
        ("gestion_primavera", "Gestión Primavera", true, "Análisis", "calendar_month", "text-violet-500"),
        ("info_pmo", "Info PMO", true, "Análisis", "help_outline", "text-slate-500"),
    };
}
<style>
    #pmo-sidebar { transition: width 0.22s ease; will-change: width; overflow: hidden; }
    #pmo-sidebar.pmo-collapsed { width: 3.5rem !important; }
    #pmo-sidebar.pmo-collapsed .pmo-sb-label,
    #pmo-sidebar.pmo-collapsed .pmo-sb-group,
    #pmo-sidebar.pmo-collapsed .pmo-sb-badge { display: none; }
    #pmo-sidebar .pmo-sb-item.active {
        background: linear-gradient(90deg, rgba(20,184,166,0.10), rgba(20,184,166,0.04));
        color: rgb(15 118 110);
        font-weight: 600;
        position: relative;
    }
    .dark #pmo-sidebar .pmo-sb-item.active { color: rgb(94 234 212); background: linear-gradient(90deg, rgba(20,184,166,0.18), rgba(20,184,166,0.06)); }
    #pmo-sidebar .pmo-sb-item.active::before {
        content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px;
        border-radius: 0 3px 3px 0; background: rgb(13 148 136);
    }
    #pmo-sidebar .pmo-sb-item.locked { opacity: .55; cursor: not-allowed; }
    #pmo-sidebar .pmo-sb-item.locked:hover { background: transparent !important; }
</style>
<div class="flex flex-col lg:flex-row min-h-[calc(100vh-8rem)] gap-0">
    @* Sidebar PMO — estilo claro, agrupado por sección, items con icono y estado de bloqueo. *@
    <aside id="pmo-sidebar" class="w-full lg:w-56 shrink-0 bg-white dark:bg-slate-900 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-700 flex flex-col lg:sticky lg:top-14" style="">
        @* Cabecera del sidebar: badge del módulo + título + botón colapsar (solo lg). *@
        <div class="flex items-center justify-between px-3 py-3 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
            <div class="flex items-center gap-2 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-teal-100 dark:bg-teal-900/40 flex items-center justify-center flex-shrink-0">
                    <span class="material-icons text-teal-600 dark:text-teal-400" style="font-size:18px" aria-hidden="true">space_dashboard</span>
                </div>
                <div class="min-w-0 pmo-sb-label">
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-100 leading-none truncate">PMO</p>
                    <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">Planning &amp; Control</p>
                </div>
            </div>
            <button type="button" onclick="togglePmoSidebar()"
                    class="hidden lg:inline-flex flex-shrink-0 p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
                    title="Minimizar sidebar" aria-label="Minimizar sidebar">
                <span class="material-icons text-base" id="pmo-sidebar-icon" aria-hidden="true">chevron_left</span>
            </button>
        </div>

        @* Navegación agrupada por Grupo. *@
        <nav class="flex-1 lg:overflow-y-auto py-2 px-2 space-y-0.5 text-sm">
            @{
                string ultimoGrupo = null;
            }
            @foreach (var item in pmoMenu)
            {
                if (item.Grupo != ultimoGrupo)
                {
                    ultimoGrupo = item.Grupo;
                    <p class="pmo-sb-group px-2 pt-2 pb-1 text-[10px] font-bold text-teal-600 dark:text-teal-400 uppercase tracking-[0.12em]">@item.Grupo</p>
                }
                var activo = string.Equals(Model.PmoSeccion, item.Id, StringComparison.OrdinalIgnoreCase);
                var bloqueado = item.RequiereProyecto && !Model.ProyectoActivoId.HasValue;
                if (bloqueado)
                {
                    <span class="pmo-sb-item locked w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-500 dark:text-slate-400" title="Seleccione un proyecto primero">
                        <span class="material-icons flex-shrink-0 text-slate-300 dark:text-slate-600" style="font-size:18px" aria-hidden="true">@item.Icono</span>
                        <span class="pmo-sb-label truncate flex-1">@item.Etiqueta</span>
                        <span class="pmo-sb-badge material-icons text-slate-300 dark:text-slate-600 flex-shrink-0" style="font-size:14px" aria-hidden="true">lock</span>
                    </span>
                }
                else if (activo)
                {
                    <a href="@NavPmo(item.Id)" class="pmo-sb-item active w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg" title="@item.Etiqueta">
                        <span class="material-icons flex-shrink-0 @item.IconoColor" style="font-size:18px" aria-hidden="true">@item.Icono</span>
                        <span class="pmo-sb-label truncate flex-1">@item.Etiqueta</span>
                    </a>
                }
                else
                {
                    <a href="@NavPmo(item.Id)" class="pmo-sb-item w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-teal-50 dark:hover:bg-teal-900/20 hover:text-teal-800 dark:hover:text-teal-200 transition-colors" title="@item.Etiqueta">
                        <span class="material-icons flex-shrink-0 @item.IconoColor" style="font-size:18px" aria-hidden="true">@item.Icono</span>
                        <span class="pmo-sb-label truncate flex-1">@item.Etiqueta</span>
                    </a>
                }
            }
            <div class="my-2 border-t border-slate-100 dark:border-slate-800 mx-1"></div>
            <a href="/App" class="pmo-sb-item w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Volver a Aplicaciones">
                <span class="material-icons flex-shrink-0 text-slate-500" style="font-size:18px" aria-hidden="true">apps</span>
                <span class="pmo-sb-label truncate flex-1">Aplicaciones</span>
            </a>
        </nav>

        @if (Model.ProyectoActivoId.HasValue && !string.IsNullOrWhiteSpace(Model.ProyectoActivoNombre))
        {
            <div class="pmo-sb-label flex-shrink-0 border-t border-slate-200 dark:border-slate-700 px-3 py-2.5 bg-slate-50/80 dark:bg-slate-900/40">
                <p class="text-[9px] font-bold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500">Proyecto activo</p>
                <p class="text-xs font-semibold text-teal-700 dark:text-teal-300 truncate mt-0.5" title="@Model.ProyectoActivoNombre">@Model.ProyectoActivoNombre</p>
            </div>
        }
    </aside>
    <script>
        (function () {
            window.togglePmoSidebar = function () {
                var sb = document.getElementById('pmo-sidebar');
                var ic = document.getElementById('pmo-sidebar-icon');
                if (!sb) return;
                sb.classList.toggle('pmo-collapsed');
                if (ic) ic.textContent = sb.classList.contains('pmo-collapsed') ? 'chevron_right' : 'chevron_left';
                try { localStorage.setItem('pmoSidebarCollapsed', sb.classList.contains('pmo-collapsed') ? '1' : '0'); } catch (_) {}
            };
            try {
                if (localStorage.getItem('pmoSidebarCollapsed') === '1') {
                    var sb = document.getElementById('pmo-sidebar');
                    var ic = document.getElementById('pmo-sidebar-icon');
                    if (sb) sb.classList.add('pmo-collapsed');
                    if (ic) ic.textContent = 'chevron_right';
                }
            } catch (_) {}
        })();
    </script>

    <div class="flex-1 flex flex-col min-w-0 bg-slate-50 dark:bg-slate-900/40">
        <div class="flex-1 min-w-0 p-4 sm:p-6 lg:px-8 xl:px-10 space-y-4">
            @if (Model.MostrarSeccionResumen)
            {
                <div class="sticky z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-1.5 mb-2 bg-slate-50/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200/90 dark:border-slate-700/90 top-14 md:top-16">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <div class="min-w-0 shrink border-t border-b border-slate-200/80 dark:border-slate-600/70 py-0.5">
                            <div class="flex items-center gap-1.5 min-w-0 leading-tight" title="@Model.ProyectoActivoNombre">
                                <span class="h-0 w-0 border-y-[4px] border-y-transparent border-l-[6px] border-l-amber-500 shrink-0" aria-hidden="true"></span>
                                <span class="text-sm font-semibold text-amber-900 dark:text-amber-200 truncate">@(Model.ProyectoActivoNombre ?? "Proyecto")</span>
                            </div>
                            <nav class="flex flex-wrap items-center gap-x-1 gap-y-0.5 text-xs font-medium text-slate-500 dark:text-slate-400 min-w-0 mt-0.5 leading-tight">
                                <a asp-page="/App" class="hover:text-ritweb-teal dark:hover:text-teal-400">Aplicaciones</a>
                                <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                                <a href="@navProyecto" class="hover:text-ritweb-teal dark:hover:text-teal-400">PMO</a>
                                <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                                <span class="text-slate-700 dark:text-slate-200 font-medium">Resumen General — KPI</span>
                            </nav>
                        </div>
                        <div class="flex flex-wrap items-end gap-2 flex-1 justify-end min-w-0">
                            <div>
                                <label for="pmo-res-fecha-seg" class="block text-[10px] font-semibold text-[#166f7b] dark:text-teal-400 mb-0.5">Fecha seguimiento EVM</label>
                                <input type="month" id="pmo-res-fecha-seg" class="rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[9.5rem]" />
                            </div>
                            <button type="button" id="pmo-res-refresh" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-[#166f7b] hover:bg-[#125a63] text-white text-xs font-medium shadow-sm shrink-0">
                                <span class="material-icons text-[16px]">refresh</span>
                                Actualizar vista
                            </button>
                            @if (navVectores != null)
                            {
                                <a href="@navVectores" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs font-medium hover:bg-slate-50 dark:hover:bg-slate-700 shrink-0">
                                    <span class="material-icons text-[16px]">stacked_line_chart</span>
                                    Vectores Financiero
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (Model.MostrarModuloPmo)
            {
                @* Una fila (wrap en móvil): izq. proyecto+miga; centro azul; der. roja. *@
                <div class="sticky z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-1.5 mb-2 bg-slate-50/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200/90 dark:border-slate-700/90 top-14 md:top-16">
                    <div class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-2 lg:flex-nowrap">
                    <div class="w-full sm:w-auto sm:max-w-[13rem] md:max-w-[15rem] lg:max-w-[16rem] shrink-0 min-w-0 border-t border-b border-slate-200/80 dark:border-slate-600/70 py-0.5 self-center">
                        <div class="flex items-center gap-1.5 min-w-0 leading-tight" title="@Model.ProyectoActivoNombre">
                            <span class="h-0 w-0 border-y-[4px] border-y-transparent border-l-[6px] border-l-amber-500 shrink-0" aria-hidden="true"></span>
                            <span class="text-sm font-semibold text-amber-900 dark:text-amber-200 truncate">@(Model.ProyectoActivoNombre ?? "Proyecto")</span>
                        </div>
                        <nav class="flex flex-wrap items-center gap-x-1 gap-y-0.5 text-xs font-medium text-slate-500 dark:text-slate-400 min-w-0 mt-0.5 leading-tight">
                            <a asp-page="/App" class="hover:text-ritweb-teal dark:hover:text-teal-400">Aplicaciones</a>
                            <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                            <a href="@navProyecto" class="hover:text-ritweb-teal dark:hover:text-teal-400">PMO</a>
                            <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                            <span class="text-slate-700 dark:text-slate-200 font-medium">Vectores Financiero</span>
                        </nav>
                    </div>
                    @* Filtros de fecha + importación dentro del rectángulo azul (entre miga y barra roja). *@
                    <div id="vf-filtros-wrap" class="flex-1 min-w-0 flex justify-center">
                        <div class="rounded-lg border-2 border-blue-500/75 dark:border-blue-500/90 bg-sky-50/90 dark:bg-slate-900/95 shadow-sm px-2.5 py-2 sm:px-3 w-full max-w-3xl">
                            <div class="flex flex-wrap items-end gap-x-2 gap-y-2">
                                <div>
                                    <label for="vf-sap-desc-top" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Descripción (filtro primario)</label>
                                    <select id="vf-sap-desc-top" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[16rem] hidden">
                                        <option value="">Todas</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="vf-desde" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Desde (mes)</label>
                                    <input type="month" id="vf-desde" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[9.5rem]" />
                                </div>
                                <div>
                                    <label for="vf-hasta" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Hasta (mes)</label>
                                    <input type="month" id="vf-hasta" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[9.5rem]" />
                                </div>
                                <button type="button" id="vf-clear-fechas" class="p-1.5 rounded-md border border-sky-300 dark:border-sky-600 text-sky-700 dark:text-sky-300 hover:bg-sky-100 dark:hover:bg-slate-800 shrink-0" title="Limpiar fechas">
                                    <span class="material-icons text-[18px]">cleaning_services</span>
                                </button>
                                <span id="vf-load" class="hidden inline-flex text-xs text-sky-800 dark:text-sky-200 items-center gap-1 shrink-0 pb-1.5"><span class="material-icons text-base animate-spin">progress_activity</span> Cargando…</span>
                                <div id="vf-import-wrap" class="flex flex-wrap items-center gap-2 sm:ml-auto sm:grow-0 w-full sm:w-auto">
                                    <button type="button" id="vf-import-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-amber-500 hover:bg-amber-600 text-white text-xs font-medium shadow-sm shrink-0">
                                        <span class="material-icons text-[16px]">upload_file</span>
                                        Importar tabla
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="min-w-0 w-full sm:w-auto sm:max-w-[min(100%,42rem)] lg:max-w-[50%] flex justify-end sm:justify-end shrink-0 sm:ml-auto lg:ml-0 self-center">
                        <div class="rounded-lg border-2 border-red-400/70 dark:border-red-700/80 bg-white/95 dark:bg-slate-900/95 shadow-sm px-2 py-1.5 sm:px-3 max-w-full">
                            <div class="flex flex-nowrap items-center gap-2 overflow-x-auto pb-0.5 justify-end">
                                <span class="flex items-center text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 shrink-0 px-0.5">Vectores</span>
                                @foreach (var m in PycFinancierosCatalog.ModosVectorBarraPmo)
                                {
                                    <button type="button" id="vf-mv-@m.Id" data-tabla="@m.Tabla" class="vf-mv-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-md text-xs font-medium border border-amber-400/90 bg-amber-50 text-amber-950 hover:bg-amber-100 dark:bg-amber-950/45 dark:border-amber-600 dark:text-amber-100 dark:hover:bg-amber-900/55 @(m.Id == "real_parcial" ? "ring-2 ring-amber-500 ring-offset-1 ring-offset-white dark:ring-offset-slate-900 bg-amber-100 dark:bg-amber-900/70" : "")">@m.Etiqueta</button>
                                }
                                <span class="w-px shrink-0 self-stretch min-h-[1.5rem] bg-slate-300 dark:bg-slate-600 mx-0.5" role="separator" aria-hidden="true"></span>
                                <span class="flex items-center text-[10px] font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400 shrink-0 px-0.5">Análisis</span>
                                @foreach (var m in PycFinancierosCatalog.ModosAnalisis)
                                {
                                    <button type="button" id="vf-ma-@m.Id" class="vf-ma-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-md text-xs font-medium border border-sky-500/80 bg-sky-50 text-sky-950 hover:bg-sky-100 dark:bg-sky-950/50 dark:border-sky-500 dark:text-sky-100 dark:hover:bg-sky-900/55">@m.Etiqueta</button>
                                }
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
            }
            else if (Model.MostrarModuloControlFisico)
            {
                <div class="sticky z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-1.5 mb-2 bg-slate-50/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200/90 dark:border-slate-700/90 top-14 md:top-16">
                    <div class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-2 lg:flex-nowrap">
                        <div class="w-full sm:w-auto sm:max-w-[13rem] md:max-w-[15rem] lg:max-w-[16rem] shrink-0 min-w-0 border-t border-b border-slate-200/80 dark:border-slate-600/70 py-0.5 self-center">
                            <div class="flex items-center gap-1.5 min-w-0 leading-tight" title="@Model.ProyectoActivoNombre">
                                <span class="h-0 w-0 border-y-[4px] border-y-transparent border-l-[6px] border-l-amber-500 shrink-0" aria-hidden="true"></span>
                                <span class="text-sm font-semibold text-amber-900 dark:text-amber-200 truncate">@(Model.ProyectoActivoNombre ?? "Proyecto")</span>
                            </div>
                            <nav class="flex flex-wrap items-center gap-x-1 gap-y-0.5 text-xs font-medium text-slate-500 dark:text-slate-400 min-w-0 mt-0.5 leading-tight">
                                <a asp-page="/App" class="hover:text-ritweb-teal dark:hover:text-teal-400">Aplicaciones</a>
                                <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                                <a href="@navProyecto" class="hover:text-ritweb-teal dark:hover:text-teal-400">PMO</a>
                                <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                                @if (navVectores != null)
                                {
                                    <a href="@navVectores" class="hover:text-ritweb-teal dark:hover:text-teal-400">Vectores</a>
                                    <span class="material-icons text-[14px] shrink-0 opacity-70">chevron_right</span>
                                }
                                <span class="text-slate-700 dark:text-slate-200 font-medium">Control físico — líneas base</span>
                            </nav>
                        </div>
                        <div class="flex-1 min-w-0 flex justify-center">
                            <div class="rounded-lg border-2 border-emerald-500/75 dark:border-emerald-500/90 bg-emerald-50/90 dark:bg-slate-900/95 shadow-sm px-2.5 py-2 sm:px-3 w-full max-w-3xl">
                                <div class="flex flex-wrap items-end gap-x-2 gap-y-2">
                                    <div>
                                        <label for="pmo-cf-desde" class="block text-[10px] font-semibold text-emerald-900 dark:text-emerald-300 mb-0.5">Desde</label>
                                        <input type="date" id="pmo-cf-desde" class="rounded-md border border-emerald-300 dark:border-emerald-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[10.5rem]" />
                                    </div>
                                    <div>
                                        <label for="pmo-cf-hasta" class="block text-[10px] font-semibold text-emerald-900 dark:text-emerald-300 mb-0.5">Hasta</label>
                                        <input type="date" id="pmo-cf-hasta" class="rounded-md border border-emerald-300 dark:border-emerald-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[10.5rem]" />
                                    </div>
                                    <div>
                                        <label for="pmo-cf-vector" class="block text-[10px] font-semibold text-emerald-900 dark:text-emerald-300 mb-0.5">Vector fila (opcional)</label>
