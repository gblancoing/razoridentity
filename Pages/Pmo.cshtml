                    <script>
                        (function () {
                            var wrap = document.getElementById('pmo-mdg-detail-wrap');
                            var titleEl = document.getElementById('pmo-mdg-detail-title');
                            var btns = document.querySelectorAll('.mdg-nivel-btn');
                            var panels = {
                                '1': document.getElementById('pmo-mdg-panel-1'),
                                '2': document.getElementById('pmo-mdg-panel-2'),
                                '3': document.getElementById('pmo-mdg-panel-3')
                            };
                            var titles = {
                                '1': 'N1 — KPI y controles (ejecutivo / estratégico)',
                                '2': 'N2 — KPI y controles (táctico / gestión)',
                                '3': 'N3 — KPI y controles (operativo / terreno)'
                            };
                            function clearActive() {
                                btns.forEach(function (b) {
                                    b.setAttribute('aria-selected', 'false');
                                    b.tabIndex = -1;
                                    b.classList.remove('ring-teal-500', 'dark:ring-teal-400', 'shadow-lg');
                                });
                                Object.keys(panels).forEach(function (k) {
                                    if (panels[k]) panels[k].classList.add('hidden');
                                });
                            }
                            function openNivel(n) {
                                if (!wrap || !panels[n]) return;
                                clearActive();
                                var btn = document.querySelector('.mdg-nivel-btn[data-mdg-nivel="' + n + '"]');
                                if (btn) {
                                    btn.setAttribute('aria-selected', 'true');
                                    btn.tabIndex = 0;
                                    btn.classList.add('ring-teal-500', 'dark:ring-teal-400', 'shadow-lg');
                                }
                                panels[n].classList.remove('hidden');
                                if (titleEl) titleEl.textContent = titles[n] || 'KPI y controles';
                                wrap.classList.remove('hidden');
                                wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            }
                            function closeDetail() {
                                clearActive();
                                if (wrap) wrap.classList.add('hidden');
                                var firstTab = document.getElementById('pmo-mdg-tab-1');
                                if (firstTab) firstTab.tabIndex = 0;
                            }
                            btns.forEach(function (b) {
                                b.addEventListener('click', function () {
                                    var n = b.getAttribute('data-mdg-nivel');
                                    if (wrap && !wrap.classList.contains('hidden') && b.getAttribute('aria-selected') === 'true') {
                                        closeDetail();
                                        return;
                                    }
                                    openNivel(n);
                                });
                                b.addEventListener('keydown', function (e) {
                                    if (e.key === 'Enter' || e.key === ' ') {
                                        e.preventDefault();
                                        b.click();
                                    }
                                });
                            });
                            var closeBtn = document.getElementById('pmo-mdg-detail-close');
                            if (closeBtn) closeBtn.addEventListener('click', closeDetail);
                        })();
