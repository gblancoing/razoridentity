                                    <div class="size-16 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4 text-slate-400">
                                        <span class="material-icons text-4xl">cloud_upload</span>
                                    </div>
                                    <p class="text-base font-semibold text-slate-700 dark:text-slate-300">Arrastre y suelte sus archivos aquí</p>
                                    <p class="text-xs text-slate-500 mt-1 mb-2">Formatos: JPG, PNG, PDF (Máx. 10MB por archivo). Se suben a API_Ritweb.</p>
                                </div>
                                <p id="reg-fotos-feedback" class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2 min-h-[1.5rem]">Ningún archivo seleccionado</p>
                                <div id="reg-fotos-preview" class="flex flex-wrap gap-2 justify-center mb-4 w-full max-w-xl hidden"></div>
                                <label for="reg-fotos" class="cursor-pointer inline-flex items-center gap-2 px-6 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm font-bold text-ritweb-teal hover:bg-ritweb-teal/10 transition-colors">
                                    <span class="material-icons text-lg">folder_open</span> Explorar archivos
                                </label>
                                <input type="file" id="reg-fotos" name="fotos" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,image/*" class="sr-only" />
                            </div>
                        </section>
                        <footer class="fixed bottom-0 left-0 right-0 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-4 shadow-2xl z-50">
                            <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
                                <div class="hidden sm:block text-xs text-slate-500">
                                    Complete los pasos y envíe el formulario para registrar el evento.
                                </div>
                                <div class="flex gap-4 w-full sm:w-auto">
                                    <a asp-page="/RitWeb" asp-route-tab="@(Model.EventoEditar != null ? "eventos" : "registrarevento")" class="flex-1 sm:flex-none text-center px-6 py-3 text-sm font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">Cancelar</a>
                                    <button type="submit" class="flex-1 sm:flex-none px-10 py-3 bg-ritweb-teal text-white text-sm font-bold rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-ritweb-teal/20 hover:brightness-110 active:scale-95 transition-all">
                                        <span class="material-icons text-lg">@(Model.EventoEditar != null ? "save" : "check_circle")</span> @(Model.EventoEditar != null ? "Guardar cambios" : "Finalizar registro")
                                    </button>
                                </div>
                            </div>
                        </footer>
                    </form>
                    <script>
                        (function() {
                            var detalles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TiposEventoDetalle.Where(x => x.Activo).Select(x => new { x.Id, x.Nombre, x.TipoEventoId, x.Nivel, Codigo = x.Codigo ?? "", x.TipoEventoDetallePadreId })));
                            var tipoEventoRequiereCierre = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TiposEvento?.ToDictionary(t => t.Id, t => t.RequiereCierre) ?? new Dictionary<int, bool>()));
                            var tipoSelect = document.getElementById('reg-tipoEventoId');
                            var detalleL1Select = document.getElementById('reg-tipoEventoDetalleL1');
                            var detalleHijoSelect = document.getElementById('reg-tipoEventoDetalleHijo');
                            var detalleNivel3Select = document.getElementById('reg-tipoEventoDetalleNivel3');
                            var hiddenDetalleId = document.getElementById('reg-tipoEventoDetalleId');
                            var wrapHijo = document.getElementById('reg-wrap-detalle-hijo');
                            var wrapNivel3 = document.getElementById('reg-wrap-detalle-nivel3');
                            var proyectoSelect = document.getElementById('reg-proyectoId');
                            var sectorSelect = document.getElementById('reg-sectorId');
                            var empresaSelect = document.getElementById('reg-empresaColaboradoraId');
                            var empresaStatus = document.getElementById('reg-empresa-status');
                            var profSelect = document.getElementById('reg-profesionalNotificadoSelect');
                            var profStatus = document.getElementById('reg-profesional-status');
                            var profNombreHidden = document.getElementById('reg-profesionalNotificadoNombre');
                            var profCargoHidden = document.getElementById('reg-profesionalNotificadoCargo');
                            var profNombreView = document.getElementById('reg-profesionalNotificadoNombreView');
                            var profCargoView = document.getElementById('reg-profesionalNotificadoCargoView');
                            var profesionView = document.getElementById('reg-profesion-view');
                            var currentUserProfile = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { nombre = Model.CurrentUserFullName ?? "", cargo = Model.CurrentUserCargo ?? "", email = Model.CurrentUserEmail ?? "" }));
                            var turnoUsuario = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TurnoUsuario ?? ""));
                            var fechaEventoInput = document.getElementById('reg-fechaEvento');
                            var turnoInput = document.getElementById('reg-turno');
                            function goToStep(n) {
                                var panels = document.querySelectorAll('.reg-step-panel');
                                panels.forEach(function(p) {
                                    p.classList.toggle('hidden', p.id !== 'reg-step-' + n);
                                });
                                var items = document.querySelectorAll('#reg-stepper [data-step]');
                                items.forEach(function(li) {
                                    var step = parseInt(li.getAttribute('data-step'), 10);
                                    var div = li.querySelector('.reg-stepper-item');
                                    if (div) {
                                        div.classList.toggle('step-active', step === n);
                                        div.setAttribute('aria-current', step === n ? 'step' : null);
                                    }
                                });
                                if (n === 2 && typeof usarMisDatos === 'function') {
                                    var nom = (profNombreHidden && profNombreHidden.value) ? profNombreHidden.value.trim() : '';
                                    var car = (profCargoHidden && profCargoHidden.value) ? profCargoHidden.value.trim() : '';
                                    if (!nom && !car) usarMisDatos();
                                }
                            }
                            function setDefaultFechaEvento() {
                                if (!fechaEventoInput || fechaEventoInput.value) return;
                                var d = new Date();
                                var pad = function(n) { return (n < 10 ? '0' : '') + n; };
                                fechaEventoInput.value =
                                    d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' +
                                    pad(d.getHours()) + ':' + pad(d.getMinutes());
                            }
                            function setDefaultTurno() {
                                if (turnoInput && turnoInput.value && turnoInput.value.trim() !== '') return;
                                var val = (turnoUsuario && typeof turnoUsuario === 'string' && turnoUsuario.trim() !== '') ? turnoUsuario.trim() : '—';
                                if (turnoInput) turnoInput.value = (val === '—' ? '' : val);
                                var display = document.getElementById('reg-turno-display');
                                if (display) display.textContent = val;
                            }
                            async function loadEmpresasPorProyecto() {
                                if (!empresaSelect) return;
                                var proyId = proyectoSelect && proyectoSelect.value ? parseInt(proyectoSelect.value, 10) : 0;
                                empresaSelect.innerHTML = '<option value="0">— Sin empresa —</option>';
                                empresaSelect.disabled = !proyId;
                                if (empresaStatus) empresaStatus.textContent = proyId ? 'Cargando empresas del proyecto…' : 'Seleccione un proyecto para cargar empresas.';
                                // Reset profesionales al cambiar proyecto
                                if (profSelect) { profSelect.innerHTML = '<option value=\"\">Seleccione una empresa para cargar profesionales…</option>'; profSelect.disabled = true; }
                                if (profStatus) profStatus.textContent = 'Se listan usuarios registrados bajo la empresa seleccionada.';
                                if (profNombreHidden) profNombreHidden.value = '';
                                if (profCargoHidden) profCargoHidden.value = '';
                                if (profNombreView) profNombreView.value = '';
                                if (profCargoView) profCargoView.value = '';
                                if (profesionView) profesionView.textContent = '';
                                if (!proyId) return;
                                try {
                                    var u = new URL(window.location.href);
                                    u.searchParams.set('handler', 'EmpresasPorProyecto');
                                    u.searchParams.set('proyectoId', String(proyId));
                                    u.searchParams.set('tab', 'registrarevento');
                                    var resp = await fetch(u.toString(), { headers: { 'Accept': 'application/json' } });
                                    if (!resp.ok) { if (empresaStatus) empresaStatus.textContent = 'No se pudo cargar empresas (' + resp.status + ').'; return; }
                                    var data = await resp.json();
                                    (data || []).forEach(function(e) {
                                        var opt = document.createElement('option');
                                        opt.value = e.id;
                                        opt.textContent = e.nombre;
                                        empresaSelect.appendChild(opt);
                                    });
                                    if (empresaStatus) empresaStatus.textContent = (data && data.length > 0) ? ('Empresas encontradas: ' + data.length) : 'No hay empresas para este proyecto.';
                                    empresaSelect.disabled = false;
                                    var editEmpresaId = empresaSelect.getAttribute && parseInt(empresaSelect.getAttribute('data-edit-empresa-id'), 10);
                                    if (editEmpresaId > 0 && empresaSelect.querySelector('option[value="' + editEmpresaId + '"]')) {
                                        empresaSelect.value = String(editEmpresaId);
                                        if (typeof loadProfesionalesPorEmpresa === 'function') loadProfesionalesPorEmpresa();
                                    }
                                } catch (e) {
                                    if (empresaStatus) empresaStatus.textContent = 'Error al cargar empresas. Revise que RIT_API esté ejecutándose.';
                                }
                            }

                            async function loadProfesionalesPorEmpresa() {
                                if (!profSelect || !empresaSelect) return;
                                var empId = empresaSelect.value ? parseInt(empresaSelect.value, 10) : 0;
                                profSelect.innerHTML = '<option value=\"\">— Seleccione —</option>';
                                profSelect.disabled = !empId;
                                if (profStatus) profStatus.textContent = empId ? 'Cargando profesionales…' : 'Seleccione una empresa para cargar profesionales…';
                                if (profNombreHidden) profNombreHidden.value = '';
                                if (profCargoHidden) profCargoHidden.value = '';
                                if (profNombreView) profNombreView.value = '';
                                if (profCargoView) profCargoView.value = '';
                                if (profesionView) profesionView.textContent = '';
                                if (!empId) return;
                                try {
                                    var u = new URL(window.location.href);
                                    u.searchParams.set('handler', 'ProfesionalesPorEmpresa');
                                    u.searchParams.set('empresaColaboradoraId', String(empId));
                                    u.searchParams.set('tab', 'registrarevento');
                                    var resp = await fetch(u.toString(), { headers: { 'Accept': 'application/json' } });
                                    if (!resp.ok) { if (profStatus) profStatus.textContent = 'No se pudo cargar profesionales (' + resp.status + ').'; return; }
                                    var data = await resp.json();
                                    (data || []).forEach(function(p) {
                                        var opt = document.createElement('option');
                                        opt.value = p.userId;
                                        opt.textContent = p.nombre;
                                        opt.setAttribute('data-nombre', p.nombre || '');
                                        opt.setAttribute('data-cargo', p.cargo || '');
                                        opt.setAttribute('data-profesion', p.profesion || '');
                                        profSelect.appendChild(opt);
                                    });
                                    profSelect.disabled = false;
                                    if (profStatus) profStatus.textContent = (data && data.length > 0) ? ('Profesionales encontrados: ' + data.length) : 'No hay profesionales asignados a esta empresa.';
                                } catch (e) {
                                    if (profStatus) profStatus.textContent = 'Error al cargar profesionales. Revise que RIT_API esté ejecutándose.';
                                }
                            }

                            function onProfesionalChange() {
                                if (!profSelect) return;
                                var opt = profSelect.options[profSelect.selectedIndex];
                                var nombre = opt && opt.getAttribute ? (opt.getAttribute('data-nombre') || '') : '';
                                var cargo = opt && opt.getAttribute ? (opt.getAttribute('data-cargo') || '') : '';
                                var profesion = opt && opt.getAttribute ? (opt.getAttribute('data-profesion') || '') : '';
                                if (profNombreHidden) profNombreHidden.value = nombre;
                                if (profCargoHidden) profCargoHidden.value = cargo;
                                if (profNombreView) profNombreView.value = nombre;
                                if (profCargoView) profCargoView.value = cargo;
                                if (profesionView) profesionView.textContent = profesion ? ('Profesión: ' + profesion) : '';
                            }
                            function usarMisDatos() {
                                if (!currentUserProfile) return;
                                var nombre = (currentUserProfile.nombre || '').trim() || (currentUserProfile.email || '').trim();
                                var cargo = (currentUserProfile.cargo || '').trim();
                                if (profNombreHidden) profNombreHidden.value = nombre;
                                if (profCargoHidden) profCargoHidden.value = cargo;
                                if (profNombreView) profNombreView.value = nombre;
                                if (profCargoView) profCargoView.value = cargo;
                                if (profesionView) profesionView.textContent = currentUserProfile.email ? ('Correo: ' + currentUserProfile.email) : '';
                                if (profSelect) profSelect.selectedIndex = 0;
                            }
                            function syncHiddenDetalle() {
                                var n3 = detalleNivel3Select.value ? parseInt(detalleNivel3Select.value, 10) : 0;
                                var hijoVal = detalleHijoSelect.value ? parseInt(detalleHijoSelect.value, 10) : 0;
                                var l1Val = detalleL1Select.value ? parseInt(detalleL1Select.value, 10) : 0;
                                hiddenDetalleId.value = n3 > 0 ? n3 : (hijoVal > 0 ? hijoVal : (l1Val > 0 ? l1Val : ''));
                            }
                            function toggleCamposRequiereCierre() {
                                var tipoId = tipoSelect.value ? parseInt(tipoSelect.value, 10) : 0;
                                var requiereCierre = tipoId && tipoEventoRequiereCierre && tipoEventoRequiereCierre[tipoId] === true;
                                var wrapTipoAlerta = document.getElementById('reg-wrap-tipo-alerta');
                                var wrapCriticidad = document.getElementById('reg-wrap-criticidad');
                                var wrapJerarquia = document.getElementById('reg-wrap-jerarquia');
                                if (wrapTipoAlerta) wrapTipoAlerta.classList.toggle('hidden', !requiereCierre);
                                if (wrapCriticidad) wrapCriticidad.classList.toggle('hidden', !requiereCierre);
                                if (wrapJerarquia) wrapJerarquia.classList.toggle('hidden', !requiereCierre);
                                if (!requiereCierre) {
                                    if (document.getElementById('reg-tipoAlertaId')) document.getElementById('reg-tipoAlertaId').value = '';
                                    if (document.getElementById('reg-criticidadId')) document.getElementById('reg-criticidadId').value = '';
                                    buildDetalleL1Options();
                                    if (hiddenDetalleId) hiddenDetalleId.value = '';
                                }
                            }
                            function buildDetalleL1Options() {
                                var tipoId = tipoSelect.value ? parseInt(tipoSelect.value, 10) : 0;
                                detalleL1Select.innerHTML = '<option value="">— Ninguno —</option>';
                                wrapHijo.classList.add('hidden');
                                wrapNivel3.classList.add('hidden');
                                detalleHijoSelect.innerHTML = '<option value="">— Ninguno (solo nivel 1) —</option>';
                                detalleNivel3Select.innerHTML = '<option value="">— Ninguno (solo nivel 2) —</option>';
                                syncHiddenDetalle();
                                if (!tipoId) return;
                                var filtrados = detalles.filter(function(d) { return d.TipoEventoId === tipoId && d.Nivel === 1; });
                                var grupos = {};
                                filtrados.forEach(function(d) {
                                    var key = (d.Nombre || '') + '|' + (d.Codigo || '');
                                    if (!grupos[key]) grupos[key] = { id: d.Id, nombre: d.Nombre };
                                });
                                var ordenados = Object.keys(grupos).map(function(k) { return grupos[k]; }).sort(function(a, b) { return (a.nombre || '').localeCompare(b.nombre || ''); });
                                ordenados.forEach(function(g) {
                                    var opt = document.createElement('option');
                                    opt.value = g.id;
                                    opt.textContent = g.nombre || '';
                                    detalleL1Select.appendChild(opt);
                                });
                            }
                            function getL1ParentIds() {
                                var l1Val = detalleL1Select.value ? parseInt(detalleL1Select.value, 10) : 0;
                                var tipoId = tipoSelect.value ? parseInt(tipoSelect.value, 10) : 0;
                                if (!l1Val || !tipoId) return [];
                                var l1Record = detalles.find(function(d) { return d.Id === l1Val; });
                                if (!l1Record) return [];
                                var parentKey = (l1Record.Nombre || '') + '|' + (l1Record.Codigo || '');
                                return detalles.filter(function(d) {
                                    return d.TipoEventoId === tipoId && d.Nivel === 1 && (d.Nombre || '') + '|' + (d.Codigo || '') === parentKey;
                                }).map(function(d) { return d.Id; });
                            }
                            function buildDetalleHijoOptions() {
                                var l1Val = detalleL1Select.value ? parseInt(detalleL1Select.value, 10) : 0;
                                detalleHijoSelect.innerHTML = '<option value="">— Ninguno (solo nivel 1) —</option>';
                                wrapNivel3.classList.add('hidden');
                                detalleNivel3Select.innerHTML = '<option value="">— Ninguno (solo nivel 2) —</option>';
                                syncHiddenDetalle();
                                if (!l1Val) {
                                    wrapHijo.classList.add('hidden');
                                    return;
                                }
                                var parentIds = getL1ParentIds();
                                var hijos = detalles.filter(function(d) { return d.TipoEventoDetallePadreId != null && parentIds.indexOf(d.TipoEventoDetallePadreId) >= 0; });
                                var gruposHijo = {};
                                hijos.forEach(function(d) {
                                    var key = (d.Nombre || '') + '|' + (d.Codigo || '') + '|' + d.Nivel;
                                    if (!gruposHijo[key]) gruposHijo[key] = { id: d.Id, nombre: d.Nombre, nivel: d.Nivel };
                                });
                                var ordenadosHijo = Object.keys(gruposHijo).map(function(k) { return gruposHijo[k]; }).sort(function(a, b) {
                                    if (a.nivel !== b.nivel) return a.nivel - b.nivel;
                                    return (a.nombre || '').localeCompare(b.nombre || '');
                                });
                                wrapHijo.classList.remove('hidden');
                                ordenadosHijo.forEach(function(g) {
                                    var opt = document.createElement('option');
                                    opt.value = g.id;
                                    opt.setAttribute('data-nivel', g.nivel);
                                    opt.textContent = 'Nivel ' + g.nivel + ' · ' + (g.nombre || '');
                                    detalleHijoSelect.appendChild(opt);
                                });
                                syncHiddenDetalle();
                            }
                            function buildDetalleNivel3Options() {
                                detalleNivel3Select.innerHTML = '<option value="">— Ninguno (solo nivel 2) —</option>';
                                wrapNivel3.classList.add('hidden');
                                syncHiddenDetalle();
                                var hijoVal = detalleHijoSelect.value ? parseInt(detalleHijoSelect.value, 10) : 0;
                                if (!hijoVal) return;
                                var optSelected = detalleHijoSelect.options[detalleHijoSelect.selectedIndex];
                                var nivelSelected = optSelected && optSelected.getAttribute ? parseInt(optSelected.getAttribute('data-nivel'), 10) : 0;
                                if (nivelSelected !== 2) return;
                                var l2Record = detalles.find(function(d) { return d.Id === hijoVal; });
                                if (!l2Record) return;
                                var parentIds = getL1ParentIds();
                                var l2GroupIds = detalles.filter(function(d) {
                                    return d.Nivel === 2 && parentIds.indexOf(d.TipoEventoDetallePadreId) >= 0 &&
                                        (d.Nombre || '') + '|' + (d.Codigo || '') === (l2Record.Nombre || '') + '|' + (l2Record.Codigo || '');
                                }).map(function(d) { return d.Id; });
                                var nivel3Items = detalles.filter(function(d) { return d.Nivel === 3 && l2GroupIds.indexOf(d.TipoEventoDetallePadreId) >= 0; });
                                var gruposN3 = {};
                                nivel3Items.forEach(function(d) {
                                    var key = (d.Nombre || '') + '|' + (d.Codigo || '');
                                    if (!gruposN3[key]) gruposN3[key] = { id: d.Id, nombre: d.Nombre };
                                });
                                var ordenadosN3 = Object.keys(gruposN3).map(function(k) { return gruposN3[k]; }).sort(function(a, b) { return (a.nombre || '').localeCompare(b.nombre || ''); });
                                if (ordenadosN3.length === 0) return;
                                wrapNivel3.classList.remove('hidden');
                                ordenadosN3.forEach(function(g) {
                                    var opt = document.createElement('option');
                                    opt.value = g.id;
                                    opt.textContent = g.nombre || '';
                                    detalleNivel3Select.appendChild(opt);
                                });
                                syncHiddenDetalle();
                            }
                            function onDetalleHijoChange() {
                                buildDetalleNivel3Options();
                                syncHiddenDetalle();
                            }
                            function applyEditDetalleId() {
                                var idStr = (hiddenDetalleId && hiddenDetalleId.value) ? hiddenDetalleId.value.trim() : '';
                                var id = idStr ? parseInt(idStr, 10) : 0;
                                if (!id) return;
                                var detalle = detalles.find(function(d) { return d.Id === id; });
                                if (!detalle) return;
                                var tipoId = tipoSelect.value ? parseInt(tipoSelect.value, 10) : 0;
                                if (!tipoId || detalle.TipoEventoId !== tipoId) return;
                                var detalleKey = function(d) { return (d.Nombre || '') + '|' + (d.Codigo || ''); };
                                if (detalle.Nivel === 1) {
                                    var l1Opt = null;
                                    for (var i = 0; i < detalleL1Select.options.length; i++) {
                                        var oid = parseInt(detalleL1Select.options[i].value, 10);
                                        if (!oid) continue;
                                        var od = detalles.find(function(d) { return d.Id === oid; });
                                        if (od && detalleKey(od) === detalleKey(detalle)) { l1Opt = oid; break; }
                                    }
                                    if (l1Opt) { detalleL1Select.value = String(l1Opt); buildDetalleHijoOptions(); }
                                    syncHiddenDetalle();
                                    return;
                                }
                                if (detalle.Nivel === 2) {
                                    var parentId = detalle.TipoEventoDetallePadreId;
                                    var l1Opt = null;
                                    if (parentId) {
                                        var pDet = detalles.find(function(d) { return d.Id === parentId; });
                                        if (pDet) {
                                            for (var i = 0; i < detalleL1Select.options.length; i++) {
                                                var oid = parseInt(detalleL1Select.options[i].value, 10);
                                                if (!oid) continue;
                                                var od = detalles.find(function(d) { return d.Id === oid; });
                                                if (od && detalleKey(od) === detalleKey(pDet)) { l1Opt = oid; break; }
                                            }
                                        }
                                        if (!l1Opt) l1Opt = parentId;
                                    }
                                    if (l1Opt && detalleL1Select.querySelector('option[value="' + l1Opt + '"]')) {
                                        detalleL1Select.value = String(l1Opt);
                                        buildDetalleHijoOptions();
                                        var hijoVal = id;
                                        if (!detalleHijoSelect.querySelector('option[value="' + id + '"]')) {
                                            for (var j = 0; j < detalleHijoSelect.options.length; j++) {
                                                var hid = parseInt(detalleHijoSelect.options[j].value, 10);
                                                if (!hid) continue;
                                                var hd = detalles.find(function(d) { return d.Id === hid; });
                                                if (hd && hd.Nivel === 2 && detalleKey(hd) === detalleKey(detalle)) { hijoVal = hid; break; }
                                            }
                                        }
                                        if (detalleHijoSelect.querySelector('option[value="' + hijoVal + '"]')) {
                                            detalleHijoSelect.value = String(hijoVal);
                                            buildDetalleNivel3Options();
                                        }
                                    }
                                    syncHiddenDetalle();
                                    return;
                                }
                                if (detalle.Nivel === 3) {
                                    var l2Record = detalles.find(function(d) { return d.Id === detalle.TipoEventoDetallePadreId; });
                                    if (!l2Record) return;
                                    var l1Id = l2Record.TipoEventoDetallePadreId;
                                    var l1Opt3 = null;
                                    if (l1Id) {
                                        var pDet3 = detalles.find(function(d) { return d.Id === l1Id; });
                                        if (pDet3) {
                                            for (var k = 0; k < detalleL1Select.options.length; k++) {
                                                var oid3 = parseInt(detalleL1Select.options[k].value, 10);
                                                if (!oid3) continue;
                                                var od3 = detalles.find(function(d) { return d.Id === oid3; });
                                                if (od3 && detalleKey(od3) === detalleKey(pDet3)) { l1Opt3 = oid3; break; }
                                            }
                                        }
                                        if (!l1Opt3) l1Opt3 = l1Id;
                                    }
                                    if (l1Opt3 && detalleL1Select.querySelector('option[value="' + l1Opt3 + '"]')) {
                                        detalleL1Select.value = String(l1Opt3);
                                        buildDetalleHijoOptions();
                                        var l2Val = l2Record.Id;
                                        if (!detalleHijoSelect.querySelector('option[value="' + l2Val + '"]')) {
                                            for (var m = 0; m < detalleHijoSelect.options.length; m++) {
                                                var mid = parseInt(detalleHijoSelect.options[m].value, 10);
                                                if (!mid) continue;
                                                var md = detalles.find(function(d) { return d.Id === mid; });
                                                if (md && md.Nivel === l2Record.Nivel && detalleKey(md) === detalleKey(l2Record)) { l2Val = mid; break; }
                                            }
                                        }
                                        if (detalleHijoSelect.querySelector('option[value="' + l2Val + '"]')) {
                                            detalleHijoSelect.value = String(l2Val);
                                            buildDetalleNivel3Options();
                                            var n3Val = id;
                                            if (!detalleNivel3Select.querySelector('option[value="' + id + '"]')) {
                                                for (var n = 0; n < detalleNivel3Select.options.length; n++) {
                                                    var nid = parseInt(detalleNivel3Select.options[n].value, 10);
                                                    if (!nid) continue;
                                                    var nd = detalles.find(function(d) { return d.Id === nid; });
                                                    if (nd && detalleKey(nd) === detalleKey(detalle)) { n3Val = nid; break; }
                                                }
                                            }
                                            if (detalleNivel3Select.querySelector('option[value="' + n3Val + '"]'))
                                                detalleNivel3Select.value = String(n3Val);
                                        }
                                    }
                                    syncHiddenDetalle();
                                }
                            }
                            function filterSectores() {
                                var proyId = proyectoSelect.value ? parseInt(proyectoSelect.value, 10) : 0;
                                var opts = sectorSelect.querySelectorAll('option[data-proyecto-id]');
                                opts.forEach(function(o) {
                                    var pid = parseInt(o.getAttribute('data-proyecto-id'), 10);
                                    o.style.display = proyId === 0 || pid === proyId ? '' : 'none';
                                });
                                if (sectorSelect.value && sectorSelect.querySelector('option[value="' + sectorSelect.value + '"]')?.style.display === 'none') sectorSelect.value = '';
                            }
                            tipoSelect.addEventListener('change', function() { toggleCamposRequiereCierre(); buildDetalleL1Options(); buildDetalleHijoOptions(); });
                            detalleL1Select.addEventListener('change', buildDetalleHijoOptions);
                            detalleHijoSelect.addEventListener('change', onDetalleHijoChange);
                            detalleNivel3Select.addEventListener('change', syncHiddenDetalle);
                            proyectoSelect.addEventListener('change', function() { filterSectores(); loadEmpresasPorProyecto(); });
                            if (empresaSelect) empresaSelect.addEventListener('change', loadProfesionalesPorEmpresa);
                            if (profSelect) profSelect.addEventListener('change', onProfesionalChange);
                            var usarMisDatosBtn = document.getElementById('reg-usarMisDatosBtn');
                            if (usarMisDatosBtn) usarMisDatosBtn.addEventListener('click', usarMisDatos);
                            document.querySelectorAll('#reg-stepper [data-step]').forEach(function(li) {
                                var div = li.querySelector('.reg-stepper-item');
                                if (!div) return;
                                function activate() { goToStep(parseInt(li.getAttribute('data-step'), 10)); }
                                div.addEventListener('click', activate);
                                div.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
                            });
                            var initialDetalleId = (hiddenDetalleId && hiddenDetalleId.value) ? String(hiddenDetalleId.value).trim() : '';
                            buildDetalleL1Options();
                            if (initialDetalleId) { if (hiddenDetalleId) hiddenDetalleId.value = initialDetalleId; applyEditDetalleId(); }
                            toggleCamposRequiereCierre();
                            filterSectores();
                            setDefaultFechaEvento();
                            setDefaultTurno();
                            loadEmpresasPorProyecto();
                            loadProfesionalesPorEmpresa();
                            goToStep(1);
                            (function() {
                                var fotosInput = document.getElementById('reg-fotos');
                                var fotosFeedback = document.getElementById('reg-fotos-feedback');
                                var fotosPreview = document.getElementById('reg-fotos-preview');
                                var fotosEmptyState = document.getElementById('reg-fotos-empty-state');
                                var dropzone = document.getElementById('reg-fotos-dropzone');
                                var previewUrls = [];
                                function revokePreviewUrls() {
                                    previewUrls.forEach(function(u) { try { URL.revokeObjectURL(u); } catch (e) {} });
                                    previewUrls = [];
                                }
                                function isImageFile(file) {
                                    return file.type && file.type.indexOf('image/') === 0;
                                }
                                function updateFotosFeedback() {
                                    if (!fotosFeedback || !fotosInput) return;
                                    var files = fotosInput.files;
                                    revokePreviewUrls();
                                    if (fotosPreview) {
                                        fotosPreview.innerHTML = '';
                                        fotosPreview.classList.add('hidden');
                                    }
                                    if (fotosEmptyState) fotosEmptyState.style.display = '';
                                    if (!files || files.length === 0) {
                                        fotosFeedback.textContent = 'Ningún archivo seleccionado';
                                        fotosFeedback.classList.remove('text-ritweb-teal');
                                        fotosFeedback.classList.add('text-slate-500', 'dark:text-slate-400');
                                        return;
                                    }
                                    var n = files.length;
                                    fotosFeedback.textContent = n === 1 ? '1 archivo listo' : n + ' archivos listos';
                                    fotosFeedback.classList.remove('text-slate-500', 'dark:text-slate-400');
                                    fotosFeedback.classList.add('text-ritweb-teal');
                                    if (fotosEmptyState) fotosEmptyState.style.display = 'none';
                                    if (!fotosPreview) return;
                                    fotosPreview.classList.remove('hidden');
                                    for (var i = 0; i < files.length; i++) {
                                        var file = files[i];
                                        var wrap = document.createElement('div');
                                        wrap.className = 'flex flex-col items-center flex-shrink-0';
                                        wrap.title = file.name;
                                        if (isImageFile(file)) {
                                            var url = URL.createObjectURL(file);
                                            previewUrls.push(url);
                                            var img = document.createElement('img');
                                            img.src = url;
                                            img.alt = file.name;
                                            img.className = 'size-16 sm:size-20 rounded-lg object-cover border border-slate-200 dark:border-slate-600 bg-slate-100 dark:bg-slate-700';
                                            wrap.appendChild(img);
                                        } else {
                                            var pdfBox = document.createElement('div');
                                            pdfBox.className = 'size-16 sm:size-20 rounded-lg border border-slate-200 dark:border-slate-600 bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-400';
                                            pdfBox.innerHTML = '<span class="material-icons text-2xl">picture_as_pdf</span>';
                                            wrap.appendChild(pdfBox);
                                        }
                                        var label = document.createElement('span');
                                        label.className = 'text-[10px] text-slate-500 dark:text-slate-400 mt-1 truncate max-w-[72px] sm:max-w-[80px]';
                                        label.textContent = file.name;
                                        wrap.appendChild(label);
                                        fotosPreview.appendChild(wrap);
                                    }
                                }
                                if (fotosInput) fotosInput.addEventListener('change', updateFotosFeedback);
                                if (dropzone && fotosInput) {
                                    dropzone.addEventListener('dragover', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        dropzone.classList.add('border-ritweb-teal', 'bg-ritweb-teal/10');
                                    });
                                    dropzone.addEventListener('dragleave', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        dropzone.classList.remove('border-ritweb-teal', 'bg-ritweb-teal/10');
                                    });
                                    dropzone.addEventListener('drop', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        dropzone.classList.remove('border-ritweb-teal', 'bg-ritweb-teal/10');
                                        var files = e.dataTransfer && e.dataTransfer.files;
                                        if (files && files.length > 0) {
                                            fotosInput.files = files;
                                            updateFotosFeedback();
                                        }
                                    });
                                }
                            })();
                        })();
                    </script>
                    <script>
                        (function() {
                            var btnShow = document.getElementById('reg-btn-show-map');
                            var btnHide = document.getElementById('reg-btn-hide-map');
                            var btnDetect = document.getElementById('reg-btn-detect-location');
                            var container = document.getElementById('reg-map-container');
                            var mapEl = document.getElementById('reg-map');
                            var latInput = document.getElementById('reg-latitude');
                            var lngInput = document.getElementById('reg-longitude');
                            var gpsStatus = document.getElementById('reg-gps-status');
                            if (!btnShow || !container || !mapEl || !latInput || !lngInput) return;
                            var map = null;
                            var marker = null;
                            var defaultCenter = { lat: -33.4489, lng: -70.6693 };
                            function getCenter() {
                                var lat = parseFloat(latInput.value, 10);
                                var lng = parseFloat(lngInput.value, 10);
                                if (isNaN(lat) || isNaN(lng)) return defaultCenter;
                                return { lat: lat, lng: lng };
                            }
                            function setGpsStatus(msg, isError) {
                                if (!gpsStatus) return;
                                gpsStatus.textContent = msg || '';
                                gpsStatus.classList.remove('hidden');
                                gpsStatus.classList.remove('text-ritweb-teal', 'text-amber-600', 'dark:text-amber-400');
                                if (msg) {
                                    gpsStatus.classList.add(isError ? 'text-amber-600 dark:text-amber-400' : 'text-ritweb-teal');
                                } else {
                                    gpsStatus.classList.add('hidden');
                                }
                            }
                            function applyPosition(lat, lng) {
                                latInput.value = lat.toFixed(6);
                                lngInput.value = lng.toFixed(6);
                                if (map && marker) {
                                    map.removeLayer(marker);
                                    marker = L.marker([lat, lng]).addTo(map);
                                    map.setView([lat, lng], map.getZoom());
                                } else if (map) {
                                    marker = L.marker([lat, lng]).addTo(map);
                                    map.setView([lat, lng], map.getZoom());
                                }
                            }
                            function tryGeolocation(callback) {
                                if (!navigator.geolocation) {
                                    setGpsStatus('Su navegador no soporta geolocalización. Seleccione un punto en el mapa.', true);
                                    if (callback) callback(false);
                                    return;
                                }
                                navigator.geolocation.getCurrentPosition(
                                    function(pos) {
                                        var lat = pos.coords.latitude;
                                        var lng = pos.coords.longitude;
                                        applyPosition(lat, lng);
                                        setGpsStatus('Ubicación del dispositivo detectada correctamente.', false);
                                        if (callback) callback(true);
                                    },
                                    function(err) {
                                        var msg = 'No se pudo obtener la ubicación. ';
                                        if (err.code === 1) msg += 'Permita el acceso a la ubicación en su navegador o active el GPS del dispositivo.';
                                        else if (err.code === 2) msg += 'La posición no está disponible. Compruebe que el GPS esté activado.';
                                        else msg += 'Active el GPS o seleccione un punto en el mapa.';
                                        setGpsStatus(msg + ' Puede elegir la ubicación en el mapa.', true);
                                        if (callback) callback(false);
                                    },
                                    { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
                                );
                            }
                            function initMap() {
                                if (map) return;
                                var c = getCenter();
                                map = L.map('reg-map').setView([c.lat, c.lng], 14);
                                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri' }).addTo(map);
                                if (latInput.value && lngInput.value) {
                                    marker = L.marker([c.lat, c.lng]).addTo(map);
                                }
                                map.on('click', function(e) {
                                    var ll = e.latlng;
                                    if (marker) map.removeLayer(marker);
                                    marker = L.marker([ll.lat, ll.lng]).addTo(map);
                                    latInput.value = ll.lat.toFixed(6);
                                    lngInput.value = ll.lng.toFixed(6);
                                });
                            }
                            function loadLeaflet(callback) {
                                if (window.L) { callback(); return; }
                                var link = document.createElement('link');
                                link.rel = 'stylesheet';
                                link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                                link.crossOrigin = 'anonymous';
                                document.head.appendChild(link);
                                var script = document.createElement('script');
                                script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                                script.crossOrigin = 'anonymous';
                                script.onload = callback;
                                document.head.appendChild(script);
                            }
                            if (gpsStatus) {
                                var hasExisting = (latInput.value && lngInput.value);
                                if (!hasExisting) tryGeolocation();
                            }
                            btnShow.addEventListener('click', function() {
                                container.classList.remove('hidden');
                                loadLeaflet(function() {
                                    setTimeout(function() {
                                        initMap();
                                        if (map) map.invalidateSize();
                                    }, 100);
                                });
                            });
                            if (btnDetect) btnDetect.addEventListener('click', function() { tryGeolocation(); });
                            btnHide.addEventListener('click', function() {
                                container.classList.add('hidden');
                            });
                        })();
                    </script>
