@page
@model RazorIdentity.Pages.RitWebModel
@{
    ViewData["Title"] = "RitWeb - Eventos RIT";
    var t = Model.Tab ?? "dashboard";
    var userEmail = Model.CurrentUserEmail ?? "";
    var userInitials = Model.CurrentUserInitials ?? "U";
    string NavLink(string tab, string icon, string label)
    {
        var active = t == tab;
        return active
            ? "flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-md bg-ritweb-teal text-white transition-all relative"
            : "flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-slate-100 transition-all";
    }
    string NavLinkBar(string tab) => t == tab ? "absolute right-0 top-0 bottom-0 w-1 bg-codelco-orange rounded-l-full" : "";
}
<div class="flex min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors">
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-[18] lg:hidden hidden transition-opacity" aria-hidden="true"></div>
    <aside id="sidebar" class="fixed left-0 top-14 md:top-16 lg:top-14 xl:top-16 z-20 h-[calc(100vh-3.5rem)] md:h-[calc(100vh-4rem)] lg:h-[calc(100vh-3.5rem)] xl:h-[calc(100vh-4rem)] w-72 max-w-[85vw] bg-slate-100 dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 flex flex-col transition-[transform,width] duration-300 ease-out -translate-x-full lg:translate-x-0" aria-label="Menú RitWeb">
        <div class="p-4 flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-700">
            <a asp-page="/RitWeb" asp-route-tab="dashboard" class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 bg-ritweb-teal rounded-lg flex items-center justify-center text-white font-bold text-xl flex-shrink-0">G</div>
                <div class="min-w-0 sidebar-logo-text">
                    <h1 class="font-bold text-lg leading-tight tracking-tight text-slate-800 dark:text-slate-100 truncate">GPR</h1>
                    <p class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-semibold">RitWeb · Eventos RIT</p>
                </div>
            </a>
            <button type="button" id="sidebar-toggle" class="hidden lg:block p-2 rounded-md text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-700 dark:hover:text-slate-200 transition-colors flex-shrink-0" aria-label="Minimizar o expandir menú">
                <span class="material-icons sidebar-icon-expand">chevron_left</span>
                <span class="material-icons sidebar-icon-collapse hidden">chevron_right</span>
            </button>
            <button type="button" id="sidebar-close-mobile" class="lg:hidden p-2 rounded-md text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700" aria-label="Cerrar menú">
                <span class="material-icons">close</span>
            </button>
        </div>
        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <p class="px-3 mb-2 text-xs font-semibold text-slate-400 dark:text-slate-300 uppercase tracking-wider sidebar-label">RitWeb</p>
            <a asp-page="/RitWeb" asp-route-tab="dashboard" class="@NavLink("dashboard", "dashboard", "Dashboard")">
                <span class="material-icons text-[20px] flex-shrink-0">dashboard</span>
                <span class="sidebar-text truncate">Dashboard</span>
                <div class="@NavLinkBar("dashboard")"></div>
            </a>
            <a asp-page="/RitWeb" asp-route-tab="eventos" class="@NavLink("eventos", "list_alt", "Ver Eventos")">
                <span class="material-icons text-[20px] flex-shrink-0">list_alt</span>
                <span class="sidebar-text truncate">Ver Eventos</span>
                <div class="@NavLinkBar("eventos")"></div>
            </a>
            @if (!Model.EsSoloUsuario)
            {
            <a asp-page="/RitWeb" asp-route-tab="registrarevento" class="@NavLink("registrarevento", "add_circle", "Registrar evento")">
                <span class="material-icons text-[20px] flex-shrink-0">add_circle</span>
                <span class="sidebar-text truncate">Registrar evento</span>
                <div class="@NavLinkBar("registrarevento")"></div>
            </a>
            }
            <a asp-page="/RitWeb" asp-route-tab="kanban" class="@NavLink("kanban", "view_kanban", "Kanban")">
                <span class="material-icons text-[20px] flex-shrink-0">view_kanban</span>
                <span class="sidebar-text truncate">Kanban</span>
                <div class="@NavLinkBar("kanban")"></div>
            </a>
            @if (!Model.EsSoloUsuario)
            {
            <a asp-page="/RitWeb" asp-route-tab="georeferencia" class="@NavLink("georeferencia", "place", "Georeferencia")">
                <span class="material-icons text-[20px] flex-shrink-0">map</span>
                <span class="sidebar-text truncate">Georeferencia</span>
                <div class="@NavLinkBar("georeferencia")"></div>
            </a>
            }
            @if (Model.IsSuperAdmin)
            {
            <div class="pt-4 mt-4 border-t border-slate-200 dark:border-slate-700">
                <p class="px-3 mb-2 text-xs font-semibold text-slate-400 dark:text-slate-300 uppercase tracking-wider sidebar-label">Ajustes</p>
                <a asp-page="/RitWeb" asp-route-tab="tiposevento" class="@NavLink("tiposevento", "category", "Tipo de evento")">
                    <span class="material-icons text-[20px] flex-shrink-0">category</span>
                    <span class="sidebar-text truncate">Tipo de evento</span>
                    <div class="@NavLinkBar("tiposevento")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="tiposeventodetalle" class="@NavLink("tiposeventodetalle", "list_alt", "Tipos evento detalle")">
                    <span class="material-icons text-[20px] flex-shrink-0">list_alt</span>
                    <span class="sidebar-text truncate">Tipos evento detalle</span>
                    <div class="@NavLinkBar("tiposeventodetalle")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="sectores" class="@NavLink("sectores", "apartment", "Sectores")">
                    <span class="material-icons text-[20px] flex-shrink-0">apartment</span>
                    <span class="sidebar-text truncate">Sectores</span>
                    <div class="@NavLinkBar("sectores")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="tiposdocumento" class="@NavLink("tiposdocumento", "description", "Tipos de documentos")">
                    <span class="material-icons text-[20px] flex-shrink-0">description</span>
                    <span class="sidebar-text truncate">Tipos de documentos</span>
                    <div class="@NavLinkBar("tiposdocumento")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="tiposalerta" class="@NavLink("tiposalerta", "campaign", "Tipos de alerta")">
                    <span class="material-icons text-[20px] flex-shrink-0">campaign</span>
                    <span class="sidebar-text truncate">Tipos de alerta</span>
                    <div class="@NavLinkBar("tiposalerta")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="criticidades" class="@NavLink("criticidades", "priority_high", "Criticidades")">
                    <span class="material-icons text-[20px] flex-shrink-0">priority_high</span>
                    <span class="sidebar-text truncate">Criticidades</span>
                    <div class="@NavLinkBar("criticidades")"></div>
                </a>
                <a asp-page="/RitWeb" asp-route-tab="turnos" class="@NavLink("turnos", "schedule", "Turnos")">
                    <span class="material-icons text-[20px] flex-shrink-0">schedule</span>
                    <span class="sidebar-text truncate">Turnos</span>
                    <div class="@NavLinkBar("turnos")"></div>
                </a>
            </div>
            }
        </nav>
        <div class="p-4 border-t border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-3 p-2 rounded-lg">
                <div class="w-8 h-8 rounded-full bg-slate-300 dark:bg-slate-600 flex items-center justify-center text-xs font-bold text-slate-700 dark:text-slate-200 flex-shrink-0">@userInitials</div>
                <div class="min-w-0 flex-1 sidebar-label">
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">RitWeb</p>
                    <p class="text-[10px] text-slate-500 dark:text-slate-400 truncate">@userEmail</p>
                </div>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post" class="flex-shrink-0">
                    <button type="submit" class="p-1.5 rounded text-slate-400 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-700 dark:hover:text-slate-200 transition-colors" title="Cerrar sesión">
                        <span class="material-icons text-xl">logout</span>
                    </button>
                </form>
            </div>
        </div>
    </aside>
    <main id="main-content" class="flex-1 w-full min-w-0 ml-0 lg:ml-72 p-4 sm:p-6 lg:p-8 xl:p-12 transition-[margin] duration-300 ease-out min-h-screen">
        <div class="lg:hidden flex items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-200 dark:border-slate-700">
            <button type="button" id="sidebar-open-mobile" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-600 transition-colors" aria-label="Abrir menú">
                <span class="material-icons">menu</span>
                <span class="text-sm font-medium">Menú</span>
            </button>
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200 truncate">RitWeb · Eventos RIT</span>
        </div>

        @if (Model.ErrorApi != null)
        {
            <div class="mb-6 rounded-xl bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700/80 p-4 text-amber-800 dark:text-amber-200 text-sm flex items-start gap-3">
                <span class="material-icons text-amber-600 dark:text-amber-400 flex-shrink-0">warning</span>
                <span>@Model.ErrorApi</span>
            </div>
        }

        @{
            var esAjustes = new[] { "tiposevento", "tiposeventodetalle", "sectores", "tiposdocumento", "tiposalerta", "criticidades" }.Contains(t);
        }
        @if (Model.MensajeAjustesError != null && !esAjustes)
        {
            <div class="mb-6 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700/80 p-4 text-red-800 dark:text-red-200 text-sm flex items-start gap-3">
                <span class="material-icons text-red-600 dark:text-red-400 flex-shrink-0">error</span>
                <span>@Model.MensajeAjustesError</span>
            </div>
        }
        @if (esAjustes && (Model.MensajeAjustes != null || Model.MensajeAjustesError != null))
        {
            if (Model.MensajeAjustes != null)
            {
                <div class="mb-6 rounded-xl bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700/80 p-4 text-green-800 dark:text-green-200 text-sm flex items-start gap-3">
                    <span class="material-icons text-green-600 dark:text-green-400 flex-shrink-0">check_circle</span>
                    <span>@Model.MensajeAjustes</span>
                </div>
            }
            if (Model.MensajeAjustesError != null)
            {
                <div class="mb-6 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700/80 p-4 text-red-800 dark:text-red-200 text-sm flex items-start gap-3">
                    <span class="material-icons text-red-600 dark:text-red-400 flex-shrink-0">error</span>
                    <span>@Model.MensajeAjustesError</span>
                </div>
            }
        }

        @switch (Model.Tab)
        {
            case "dashboard":
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
                        <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1">
                            Total eventos
                            <span class="gpr-tt gpr-tt-right"><span class="material-icons gpr-tt-icon">help_outline</span><span class="gpr-tt-box">Total de alertas e inspecciones registradas en el sistema RIT para este proyecto, incluyendo todos los estados (abiertos y cerrados). Refleja el volumen total de actividad de gestión de eventos.</span></span>
                        </p>
                        <p class="text-2xl font-bold text-slate-800 dark:text-slate-100 mt-1">@Model.Eventos.Count</p>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
                        <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1">
                            Abiertos
                            <span class="gpr-tt gpr-tt-right"><span class="material-icons gpr-tt-icon">help_outline</span><span class="gpr-tt-box">Eventos que requieren cierre formal y aún no tienen fecha de cierre registrada. Representan compromisos pendientes de gestión. Un número alto de abiertos puede indicar retrasos en la resolución de alertas del proyecto.</span></span>
                        </p>
                        <p class="text-2xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.Eventos.Count(e => e.RequiereCierre && !e.FechaCierre.HasValue)</p>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
                        <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1">
                            Cerrados
                            <span class="gpr-tt gpr-tt-right"><span class="material-icons gpr-tt-icon">help_outline</span><span class="gpr-tt-box">Eventos resueltos (con fecha de cierre registrada) o que no requieren cierre formal (inspecciones informativas). Indica el nivel de gestión completada. La tasa Cerrados/Total refleja la eficiencia de resolución del equipo.</span></span>
                        </p>
                        <p class="text-2xl font-bold text-ritweb-teal dark:text-teal-400 mt-1">@Model.Eventos.Count(e => e.FechaCierre.HasValue || !e.RequiereCierre)</p>
                    </div>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
                        <a asp-page="/RitWeb" asp-route-tab="registrarevento" class="text-sm font-medium text-ritweb-teal dark:text-teal-400 hover:underline">Registrar evento</a>
                        <p class="text-slate-500 dark:text-slate-400 mt-1">Alta de alerta o inspección</p>
                    </div>
                </div>
                <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex justify-between items-center">
                        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Últimos eventos</h2>
                        <a asp-page="/RitWeb" asp-route-tab="eventos" class="text-sm font-medium text-ritweb-teal dark:text-teal-400 hover:underline">Ver todos</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">TipoEventoId</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Fecha</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Eventos.Take(10))
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3">@item.TipoEventoId</td>
                                        <td class="px-4 py-3">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="px-4 py-3">@(item.FechaCierre.HasValue || !item.RequiereCierre ? "Cerrado" : "Abierto")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Eventos.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay eventos. Use <strong>Registrar evento</strong> o <strong>Ver Eventos</strong>.</p>
                    }
                </div>
                break;
            case "registrarevento":
                <div class="max-w-4xl mx-auto px-4 py-8 pb-32">
                    @if (Model.RegistroEventoIdSuccess.HasValue)
                    {
                        <div class="mb-8 p-6 rounded-xl border-2 border-ritweb-teal/30 bg-ritweb-teal/5 dark:bg-ritweb-teal/10 shadow-sm" role="alert">
                            <div class="flex items-start gap-4">
                                <span class="flex-shrink-0 flex items-center justify-center size-12 rounded-full bg-ritweb-teal text-white">
                                    <span class="material-icons text-3xl">check_circle</span>
                                </span>
                                <div class="min-w-0">
                                    <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">Registro efectuado correctamente</h3>
                                    <p class="text-slate-700 dark:text-slate-300">
                                        El evento quedó registrado bajo el ID <strong class="font-mono text-ritweb-teal">@Model.RegistroEventoIdSuccess.Value</strong>.
                                        Puede consultarlo en la sección de eventos o adjuntar documentación adicional desde la ficha del evento.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="mb-8">
                        @if (Model.EventoEditar != null)
                        {
                            <h2 class="text-3xl font-extrabold tracking-tight mb-2 text-slate-900 dark:text-slate-100">Editar evento #@Model.EventoEditar.Id</h2>
                            <p class="text-slate-500 dark:text-slate-400">Modifique los datos que necesite. La fecha del evento no se puede cambiar.</p>
                        }
                        else
                        {
                            <h2 class="text-3xl font-extrabold tracking-tight mb-2 text-slate-900 dark:text-slate-100">Registro de Evento</h2>
                            <p class="text-slate-500 dark:text-slate-400">Complete los pasos para notificar una nueva desviación o evento en faena.</p>
                        }
                    </div>
                    <nav id="reg-stepper" aria-label="Progress" class="mb-10">
                        <ol class="flex items-center justify-between w-full" role="list">
                            <li class="relative flex-1" data-step="1">
                                <div class="reg-stepper-item step-active flex flex-col items-center border-b-4 border-ritweb-teal pb-4 cursor-pointer select-none transition-colors hover:opacity-90" role="button" tabindex="0" aria-current="step">
                                    <span class="material-icons text-ritweb-teal mb-1 text-2xl">category</span>
                                    <span class="text-xs font-bold uppercase tracking-wider text-ritweb-teal">Paso 1</span>
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Categorización</span>
                                </div>
                            </li>
                            <li class="relative flex-1" data-step="2">
                                <div class="reg-stepper-item flex flex-col items-center border-b-4 border-slate-200 dark:border-slate-700 pb-4 cursor-pointer select-none transition-colors hover:opacity-90" role="button" tabindex="0">
                                    <span class="material-icons text-slate-400 mb-1 text-2xl">location_on</span>
                                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Paso 2</span>
                                    <span class="text-sm font-semibold text-slate-400">Ubicación &amp; Empresa</span>
                                </div>
                            </li>
                            <li class="relative flex-1" data-step="3">
                                <div class="reg-stepper-item flex flex-col items-center border-b-4 border-slate-200 dark:border-slate-700 pb-4 cursor-pointer select-none transition-colors hover:opacity-90" role="button" tabindex="0">
                                    <span class="material-icons text-slate-400 mb-1 text-2xl">upload_file</span>
                                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Paso 3</span>
                                    <span class="text-sm font-semibold text-slate-400">Soporte &amp; Carga</span>
                                </div>
                            </li>
                        </ol>
                    </nav>
                    <style>
                        .reg-stepper-item { border-bottom-width: 4px; border-bottom-style: solid; }
                        .reg-stepper-item { border-bottom-color: rgb(203 213 225); }
                        .dark .reg-stepper-item { border-bottom-color: rgb(51 65 85); }
                        .reg-stepper-item.step-active { border-bottom-color: #0d9488 !important; }
                        .reg-stepper-item.step-active .material-icons,
                        .reg-stepper-item.step-active .text-xs { color: #0d9488 !important; }
                        .reg-stepper-item.step-active .text-sm { color: rgb(51 65 85) !important; }
                        .dark .reg-stepper-item.step-active .text-sm { color: rgb(226 232 240) !important; }
                        .reg-stepper-item:not(.step-active) .material-icons,
                        .reg-stepper-item:not(.step-active) .text-xs,
                        .reg-stepper-item:not(.step-active) .text-sm { color: rgb(148 163 184) !important; }
                    </style>
                    <form method="post" asp-page-handler="RegistrarEvento" enctype="multipart/form-data" class="space-y-12">
                        @Html.AntiForgeryToken()
                        @if (Model.EventoEditar != null)
                        {
                            <input type="hidden" name="eventoId" value="@Model.EventoEditar.Id" />
                        }
                        <section id="reg-step-1" class="reg-step-panel bg-white dark:bg-slate-900/50 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2 mb-6 text-ritweb-teal">
                                <span class="material-icons">info</span>
                                <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">Paso 1: Categorización Inicial</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                @if (Model.IsSuperAdmin)
                                {
                                    <div class="space-y-2" id="reg-wrap-proyecto-select">
                                        <label for="reg-proyectoId" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                            <span class="material-icons text-lg text-ritweb-teal">work</span> Proyecto <span class="text-red-500">*</span>
                                        </label>
                                        <select id="reg-proyectoId" name="proyectoId" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4">
                                            <option value="">Seleccione un proyecto...</option>
                                            @foreach (var p in Model.Proyectos)
                                            {
                                                var selectedProy = Model.EventoEditar != null ? Model.EventoEditar.ProyectoId : Model.ProyectoIdContext;
                                                var selectedAttr = selectedProy == p.Id ? "selected" : null;
                                                <option value="@p.Id" selected="@selectedAttr">@(string.IsNullOrWhiteSpace(p.NumeroContrato) ? p.Nombre : $"{p.Nombre} · {p.NumeroContrato}")</option>
                                            }
                                        </select>
                                        <p class="text-[10px] text-slate-500">Como Super_admin puede registrar en cualquier proyecto.</p>
                                    </div>
                                }
                                else
                                {
                                    var proyAsignado = Model.Proyectos.FirstOrDefault(p => p.Id == Model.UserProyectoId);
                                    <div class="space-y-2" id="reg-wrap-proyecto-fijo">
                                        <label for="reg-proyectoId" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                            <span class="material-icons text-lg text-ritweb-teal">work</span> Proyecto
                                        </label>
                                        <input type="hidden" name="proyectoId" value="@(Model.UserProyectoId ?? 0)" />
                                        <select id="reg-proyectoId" disabled class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 text-slate-700 dark:text-slate-300">
                                            @if (proyAsignado != null)
                                            {
                                                <option value="@proyAsignado.Id" selected>@proyAsignado.Nombre</option>
                                            }
                                            else
                                            {
                                                <option value="">— Sin proyecto asignado —</option>
                                            }
                                        </select>
                                        @if (proyAsignado == null)
                                        {
                                            <p class="text-[10px] text-amber-600 dark:text-amber-400">No tiene proyecto asignado. Contacte al administrador.</p>
                                        }
                                        else
                                        {
                                            <p class="text-[10px] text-slate-500">El evento se registrará en su proyecto asignado.</p>
                                        }
                                    </div>
                                }
                                <div class="space-y-2">
                                    <label for="reg-tipoEventoId" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">event_note</span> Tipo de evento <span class="text-red-500">*</span>
                                    </label>
                                    <select id="reg-tipoEventoId" name="tipoEventoId" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4">
                                        <option value="">Seleccione un tipo...</option>
                                        @foreach (var t in Model.TiposEvento.Where(x => x.Activo))
                                        {
                                            var selTipo = Model.EventoEditar != null && Model.EventoEditar.TipoEventoId == t.Id;
                                            <option value="@t.Id" selected="@selTipo">@t.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="space-y-2">
                                    <label for="reg-fechaEvento" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">calendar_today</span> Fecha y hora <span class="text-red-500">*</span>
                                    </label>
                                    @{
                                        var fechaEditable = Model.EventoEditar == null;
                                        var fechaVal = Model.EventoEditar?.FechaEvento != null
                                            ? Model.EventoEditar.FechaEvento.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
                                            : "";
                                    }
                                    <input type="datetime-local" id="reg-fechaEvento" name="fechaEvento" value="@fechaVal" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4 @(!fechaEditable ? "bg-slate-100 dark:bg-slate-800/80 cursor-not-allowed" : "")" @(!fechaEditable ? "readonly" : "") />
                                    @if (!fechaEditable)
                                    {
                                        <p class="text-[10px] text-amber-600 dark:text-amber-400">La fecha del evento no se puede modificar en modo edición.</p>
                                    }
                                    else
                                    {
                                        <p class="text-[10px] text-slate-500">Se guarda en API_Ritweb como fechaEvento.</p>
                                    }
                                </div>
                                <div class="space-y-2">
                                    <label for="reg-turno" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">schedule</span> Turno asignado
                                    </label>
                                    <div class="flex items-center justify-between w-full bg-slate-100 dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 px-4 h-[42px] rounded-lg">
                                        <span id="reg-turno-display" class="text-sm font-medium text-slate-700 dark:text-slate-300">@(Model.EventoEditar != null ? (Model.EventoEditar.Turno ?? "—") : (string.IsNullOrWhiteSpace(Model.TurnoUsuario) ? "—" : Model.TurnoUsuario))</span>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-ritweb-teal/10 text-ritweb-teal uppercase">Automático</span>
                                    </div>
                                    <p class="text-[10px] text-slate-500 dark:text-slate-400">Se obtiene de la ficha del usuario (RIT_API). Si aparece "—", complete <strong>Turno</strong> en <strong>Datos personales</strong> y guarde; en RIT_API el GET <em>api/Usuarios/&#123;userId&#125;/Ficha</em> debe devolver <em>turno</em> y el PUT debe guardarlo.</p>
                                    <input type="hidden" id="reg-turno" name="turno" value="@(Model.EventoEditar != null ? (Model.EventoEditar.Turno ?? "") : (Model.TurnoUsuario ?? ""))" />
                                </div>
                                <input type="hidden" id="reg-tipoEventoDetalleId" name="tipoEventoDetalleId" value="@(Model.EventoEditar?.TipoEventoDetalleId.ToString() ?? "")" />
                                <div id="reg-wrap-tipo-alerta" class="space-y-2">
                                    <label for="reg-tipoAlertaId" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">campaign</span> Tipo de alerta
                                    </label>
                                    <select id="reg-tipoAlertaId" name="tipoAlertaId" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4">
                                        <option value="">— Seleccione —</option>
                                        @foreach (var ta in Model.TiposAlerta.Where(x => x.Activo).OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                        {
                                            var selAlerta = Model.EventoEditar?.TipoAlertaId == ta.Id;
                                            <option value="@ta.Id" selected="@selAlerta">@ta.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div id="reg-wrap-criticidad" class="space-y-2">
                                    <label for="reg-criticidadId" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">priority_high</span> Criticidad
                                    </label>
                                    <select id="reg-criticidadId" name="criticidadId" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4">
                                        <option value="">— Seleccione —</option>
                                        @foreach (var c in Model.Criticidades.Where(x => x.Activo).OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                        {
                                            var selCrit = Model.EventoEditar?.CriticidadId == c.Id;
                                            <option value="@c.Id" selected="@selCrit">@c.Nombre</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div id="reg-wrap-jerarquia" class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
                                <label class="text-sm font-semibold mb-4 block flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                    <span class="material-icons text-lg text-ritweb-teal">account_tree</span> Jerarquía de Causa Raíz
                                </label>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="space-y-1" id="reg-wrap-detalle-l1">
                                        <span class="text-[11px] font-bold text-slate-400 uppercase">Nivel 1</span>
                                        <select id="reg-tipoEventoDetalleL1" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal">
                                            <option value="">— Ninguno —</option>
                                        </select>
                                    </div>
                                    <div class="space-y-1 hidden" id="reg-wrap-detalle-hijo">
                                        <span class="text-[11px] font-bold text-slate-400 uppercase">Nivel 2</span>
                                        <select id="reg-tipoEventoDetalleHijo" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal">
                                            <option value="">— Ninguno (solo nivel 1) —</option>
                                        </select>
                                    </div>
                                    <div class="space-y-1 hidden" id="reg-wrap-detalle-nivel3">
                                        <span class="text-[11px] font-bold text-slate-400 uppercase">Nivel 3</span>
                                        <select id="reg-tipoEventoDetalleNivel3" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal">
                                            <option value="">— Ninguno (solo nivel 2) —</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section id="reg-step-2" class="reg-step-panel hidden bg-white dark:bg-slate-900/50 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2 mb-6 text-ritweb-teal">
                                <span class="material-icons">location_on</span>
                                <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">Paso 2: Ubicación &amp; Empresa</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label for="reg-sectorId" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Sector / Área</label>
                                    <select id="reg-sectorId" name="sectorId" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4">
                                        <option value="">— Ninguno —</option>
                                        @foreach (var s in Model.Sectores.Where(x => x.Activo))
                                        {
                                            var selSector = Model.EventoEditar?.SectorId == s.Id;
                                            <option value="@s.Id" data-proyecto-id="@s.ProyectoId" selected="@selSector">@s.Nombre</option>
                                        }
                                    </select>
                                    <p class="text-[10px] text-slate-500">Filtrado según proyecto seleccionado.</p>
                                </div>
                                <div class="space-y-2">
                                    <label for="reg-empresaColaboradoraId" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Contrato / Sub-Contrato</label>
                                    <select id="reg-empresaColaboradoraId" name="empresaColaboradoraId" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-ritweb-teal focus:border-ritweb-teal h-11 px-4" data-edit-empresa-id="@(Model.EventoEditar?.EmpresaColaboradoraId ?? 0)">
                                        <option value="0">— Sin empresa —</option>
                                    </select>
                                    <p id="reg-empresa-status" class="text-[10px] text-slate-500">Empresas del proyecto (RIT_API).</p>
                                </div>
                            </div>
                            <div class="mt-6 p-4 bg-ritweb-teal/5 border border-ritweb-teal/20 rounded-lg flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                                <div>
                                    <p class="text-sm font-bold text-ritweb-teal">Información de Notificador</p>
                                    <p class="text-xs text-slate-500">Complete automáticamente con su perfil profesional.</p>
                                </div>
                                <button type="button" id="reg-usarMisDatosBtn" class="bg-ritweb-teal text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2 hover:bg-ritweb-teal/90 transition-all shrink-0">
                                    <span class="material-icons text-lg">bolt</span> Usar mis datos
                                </button>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">badge</span> Nombre (auto)
                                    </label>
                                    <input type="text" id="reg-profesionalNotificadoNombreView" class="w-full bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 text-slate-700 dark:text-slate-300" readonly placeholder="Se completará al seleccionar…" value="@(Model.EventoEditar?.ProfesionalNotificadoNombre ?? "")" />
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                        <span class="material-icons text-lg text-ritweb-teal">work_outline</span> Cargo (auto)
                                    </label>
                                    <input type="text" id="reg-profesionalNotificadoCargoView" class="w-full bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 text-slate-700 dark:text-slate-300" readonly placeholder="Se completará al seleccionar…" value="@(Model.EventoEditar?.ProfesionalNotificadoCargo ?? "")" />
                                </div>
                            </div>
                            <div class="mt-4 space-y-2">
                                <label for="reg-profesionalNotificadoSelect" class="text-sm font-semibold flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                    <span class="material-icons text-lg text-ritweb-teal">person</span> Profesional notificado
                                </label>
                                <select id="reg-profesionalNotificadoSelect" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" disabled>
                                    <option value="">Seleccione una empresa para cargar profesionales…</option>
                                </select>
                                <p id="reg-profesional-status" class="text-[10px] text-slate-500">Se listan usuarios bajo la empresa seleccionada.</p>
                            </div>
                            <input type="hidden" id="reg-profesionalNotificadoNombre" name="profesionalNotificadoNombre" value="@(Model.EventoEditar?.ProfesionalNotificadoNombre ?? "")" />
                            <input type="hidden" id="reg-profesionalNotificadoCargo" name="profesionalNotificadoCargo" value="@(Model.EventoEditar?.ProfesionalNotificadoCargo ?? "")" />
                            <div class="md:col-span-2 text-xs text-slate-500 mt-2" id="reg-profesion-view"></div>
                        </section>
                        <section id="reg-step-3" class="reg-step-panel hidden bg-white dark:bg-slate-900/50 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2 mb-6 text-ritweb-teal">
                                <span class="material-icons">upload_file</span>
                                <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">Paso 3: Soporte Documental</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                                <div class="space-y-1">
                                    <label class="text-xs font-bold uppercase text-slate-500">Tipo Doc.</label>
                                    <select id="reg-tipoDocumentoRespaldoId" name="tipoDocumentoRespaldoId" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal">
                                        <option value="">— Ninguno —</option>
                                        @{
                                            var gruposTipoDoc = Model.TiposDocumentoRespaldo.Where(x => x.Activo).GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "" }).OrderBy(g => g.Key.Nombre).ToList();
                                        }
                                        @foreach (var g in gruposTipoDoc)
                                        {
                                            var selTipoDoc = Model.EventoEditar?.TipoDocumentoRespaldoId == g.First().Id;
                                            <option value="@g.First().Id" selected="@selTipoDoc">@g.Key.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs font-bold uppercase text-slate-500">Referencia</label>
                                    <input type="text" id="reg-referenciaDocumentoRespaldo" name="referenciaDocumentoRespaldo" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="Ref. Interna" value="@(Model.EventoEditar?.ReferenciaDocumentoRespaldo ?? "")" />
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs font-bold uppercase text-slate-500">N° Protocolo</label>
                                    <input type="text" id="reg-numeroDocumentoProtocolo" name="numeroDocumentoProtocolo" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="000-000" value="@(Model.EventoEditar?.NumeroDocumentoProtocolo ?? "")" />
                                </div>
                                <div class="space-y-1 md:col-span-3">
                                    <label for="reg-codigoVp" class="text-xs font-bold uppercase text-slate-500">N° Código VP</label>
                                    <input type="text" id="reg-codigoVp" name="codigoVp" class="w-full max-w-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="Ej: VP-001" value="@(Model.EventoEditar?.CodigoVp ?? "")" />
                                    <p class="text-[10px] text-slate-500 mt-0.5">Se almacena en API_Ritweb asociado al registro del evento.</p>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:col-span-3 border-t border-slate-200 dark:border-slate-700 pt-4 mt-2">
                                    <div class="space-y-1">
                                        <label for="reg-latitude" class="text-xs font-bold uppercase text-slate-500">Latitud (opcional)</label>
                                        <input type="number" id="reg-latitude" name="latitude" step="any" min="-90" max="90" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="Ej: -33.4489" value="@(Model.EventoEditar?.Latitude != null ? ((decimal)Model.EventoEditar.Latitude).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                    </div>
                                    <div class="space-y-1">
                                        <label for="reg-longitude" class="text-xs font-bold uppercase text-slate-500">Longitud (opcional)</label>
                                        <input type="number" id="reg-longitude" name="longitude" step="any" min="-180" max="180" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg h-11 px-4 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="Ej: -70.6693" value="@(Model.EventoEditar?.Longitude != null ? ((decimal)Model.EventoEditar.Longitude).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                    </div>
                                    <p class="text-[10px] text-slate-500 sm:col-span-2">Para ubicar el evento en el mapa. Se intenta detectar su ubicación automáticamente; si no está disponible, active el GPS o seleccione en el mapa.</p>
                                    <div id="reg-gps-status" class="sm:col-span-2 text-sm hidden" role="status"></div>
                                    <div class="sm:col-span-2 flex flex-col gap-2">
                                        <button type="button" id="reg-btn-show-map" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-ritweb-teal border border-ritweb-teal rounded-lg hover:bg-ritweb-teal/10 transition-colors">
                                            <span class="material-icons text-lg">map</span> Agregar ubicación geográfica (seleccionar en el mapa)
                                        </button>
                                        <div id="reg-map-container" class="hidden rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800">
                                            <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800">
                                                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Vista satelital · Haga clic en el mapa para fijar la ubicación</span>
                                                <div class="flex items-center gap-2">
                                                    <button type="button" id="reg-btn-detect-location" class="inline-flex items-center gap-1 px-2 py-1.5 text-xs font-medium text-ritweb-teal hover:bg-ritweb-teal/10 rounded-md transition-colors">
                                                        <span class="material-icons text-base">my_location</span> Detectar mi ubicación
                                                    </button>
                                                    <button type="button" id="reg-btn-hide-map" class="p-1.5 rounded-md text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-700" aria-label="Cerrar mapa"><span class="material-icons">close</span></button>
                                                </div>
                                            </div>
                                            <div id="reg-map" style="height: 320px; width: 100%;"></div>
                                        </div>
                                    </div>
                                </div>
