                            <div class="space-y-2 mb-6">
                                <label for="reg-descripcion" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Descripción</label>
                                <textarea id="reg-descripcion" name="descripcion" rows="4" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-3 focus:ring-ritweb-teal focus:border-ritweb-teal" placeholder="Detalle cualquier información relevante para el equipo...">@(Model.EventoEditar?.Descripcion ?? "")</textarea>
                            </div>
                            <label for="reg-fotos" class="text-sm font-semibold text-slate-700 dark:text-slate-300 block mb-2">Respaldo fotográfico (opcional)</label>
                            <div id="reg-fotos-dropzone" class="border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl p-8 flex flex-col items-center justify-center text-center bg-slate-50/50 dark:bg-slate-800/20 transition-colors">
