                            <span class="material-icons align-middle mr-1">info</span>
                            Hay <strong>@Model.GeoAbiertosSinUbicacion</strong> alerta(s) abierta(s) sin ubicación geográfica. Para verlas en el mapa, edite cada evento en <a asp-page="/RitWeb" asp-route-tab="eventos" class="font-medium underline">Ver eventos</a> y agregue latitud/longitud (o use «Seleccionar en el mapa» al registrar/editar).
                        </div>
                    }
                    <div id="geo-map" class="w-full bg-slate-100 dark:bg-slate-900" style="height: min(70vh, 560px);"></div>
                    <script type="application/json" id="geo-eventos-json">@Html.Raw(Model.GeoEventosJson)</script>
                </div>
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
                <style>.geo-marker-alerta { background: none !important; border: none !important; }</style>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
                <script>
                    (function() {
                        var jsonEl = document.getElementById('geo-eventos-json');
                        var eventosAbiertos = jsonEl && jsonEl.textContent ? JSON.parse(jsonEl.textContent) : [];
                        var mapEl = document.getElementById('geo-map');
                        var statusEl = document.getElementById('geo-status');
                        if (!mapEl) return;
                        var defaultCenter = [-33.4489, -70.6693];
                        var map = L.map('geo-map').setView(defaultCenter, 10);
                        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri' }).addTo(map);
                        var bounds = L.latLngBounds();
                        var iconoAlertaRojo = L.divIcon({
                            className: 'geo-marker-alerta',
                            html: '<div style="width:0;height:0;border-left:10px solid transparent;border-right:10px solid transparent;border-bottom:24px solid #dc2626; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); margin-top:-24px;"></div>',
                            iconSize: [20, 24],
                            iconAnchor: [10, 24]
                        });
                        var eventoPdfUrl = "@(Url.Page("/EventoPdf"))";
                        eventosAbiertos.forEach(function(ev) {
                            var popup = '<strong>#' + ev.Id + ' · ' + (ev.TipoNombre || 'Alerta') + '</strong><br/><small>' + (ev.FechaCreacion ? new Date(ev.FechaCreacion).toLocaleDateString('es-CL') : '') + '</small><br/><a href="' + eventoPdfUrl + '?id=' + ev.Id + '" target="_blank" class="text-ritweb-teal text-sm">Ver evento</a>';
                            var m = L.marker([ev.Lat, ev.Lng], { icon: iconoAlertaRojo }).addTo(map).bindPopup(popup);
                            bounds.extend([ev.Lat, ev.Lng]);
                        });
                        if (navigator.geolocation) {
                            navigator.geolocation.getCurrentPosition(
                                function(pos) {
                                    var lat = pos.coords.latitude;
                                    var lng = pos.coords.longitude;
                                    L.marker([lat, lng]).addTo(map).bindPopup('<strong>Su ubicación</strong>').openPopup();
                                    bounds.extend([lat, lng]);
                                    if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
                                    else map.setView([lat, lng], 12);
                                    if (statusEl) statusEl.textContent = 'Ubicación detectada';
                                },
                                function() {
                                    if (statusEl) statusEl.textContent = 'Centrado en Santiago. Active el GPS para centrar en su ubicación.';
                                    if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
                                },
                                { enableHighAccuracy: true, timeout: 10000 }
                            );
                        } else {
                            if (statusEl) statusEl.textContent = 'Geolocalización no disponible en este navegador.';
                            if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
                        }
                        if (eventosAbiertos.length > 0 && statusEl) {
                            var t = statusEl.textContent || '';
                            statusEl.textContent = t + (t ? ' · ' : '') + eventosAbiertos.length + ' alerta(s) abierta(s) en el mapa';
                        }
                    })();
                </script>
                break;
            case "eventos":
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    @if (Model.RegistroEventoIdSuccess.HasValue)
                    {
                        <div class="mx-4 mt-4 p-4 rounded-xl border-2 border-ritweb-teal/30 bg-ritweb-teal/5 dark:bg-ritweb-teal/10 flex items-start gap-3" role="alert">
                            <span class="material-icons text-ritweb-teal text-2xl flex-shrink-0">check_circle</span>
                            <div>
                                <p class="font-bold text-slate-800 dark:text-slate-100">Registro efectuado correctamente.</p>
                                <p class="text-sm text-slate-700 dark:text-slate-300">El evento quedó registrado bajo el ID <strong class="font-mono text-ritweb-teal">@Model.RegistroEventoIdSuccess.Value</strong>.</p>
                            </div>
                        </div>
                    }
                    @if (Model.MensajeAjustes != null || Model.MensajeAjustesError != null)
                    {
                        <div class="mx-4 mt-4 space-y-2">
                            @if (Model.MensajeAjustes != null)
                            {
                                <p class="p-3 rounded-lg bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-200 text-sm">@Model.MensajeAjustes</p>
                            }
                            @if (Model.MensajeAjustesError != null)
                            {
                                <p class="p-3 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 text-sm">@Model.MensajeAjustesError</p>
                            }
                        </div>
                    }
                    @if (Model.EventoEditar != null)
                    {
                        var ev = Model.EventoEditar;
                        <div class="mx-4 mt-4 p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                            <div class="flex items-center justify-between gap-4 mb-3">
                                <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Detalle del evento #@ev.Id</h3>
                                <a asp-page="/RitWeb" asp-route-tab="eventos" asp-route-tipoEventoId="@Model.TipoEventoIdFilter" class="text-sm font-medium text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">Cerrar detalle</a>
                            </div>
                            <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@ev.FechaCreacion.ToString("dd/MM/yyyy HH:mm") · Tipo @ev.TipoEventoId · Proyecto @ev.ProyectoId · @(ev.FechaCierre.HasValue || !ev.RequiereCierre ? "Cerrado" : "Abierto")</p>
                            @if (!string.IsNullOrWhiteSpace(ev.Descripcion))
                            {
                                <p class="text-sm text-slate-700 dark:text-slate-300">@ev.Descripcion</p>
                            }
                            <div class="mt-3 flex flex-wrap gap-2">
                                <a asp-page="/EventoPdf" asp-route-id="@ev.Id" target="_blank" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-ritweb-teal/10 text-ritweb-teal text-sm font-medium hover:bg-ritweb-teal/20">
                                    <span class="material-icons text-sm">picture_as_pdf</span> Ver PDF
                                </a>
                            </div>
                        </div>
                    }
                    @if (Model.ErrorApi != null)
                    {
                        <div class="mx-4 mt-4 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800">
                            <p class="text-sm font-medium text-amber-800 dark:text-amber-200">@Model.ErrorApi</p>
                            <p class="text-xs text-amber-700 dark:text-amber-300 mt-1">Verifique que API_Ritweb esté en ejecución y que la URL en <strong>appsettings</strong> (ApiRitweb:BaseUrl) sea la misma donde se registraron los eventos.</p>
                        </div>
                    }
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700">
                        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Ver Eventos</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Alertas e inspecciones registradas (datos desde API_Ritweb).</p>
                    </div>
                    @{
                        var tiposEventoActivos = Model.TiposEvento?.Where(x => x.Activo).OrderBy(x => x.Id).ToList() ?? new List<RazorIdentity.Models.ApiRitweb.TipoEventoDto>();
                        var todosActivo = !Model.TipoEventoIdFilter.HasValue;
                    }
                    <div class="px-4 pt-3 pb-1 flex flex-wrap gap-1 border-b border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/30">
                        <a asp-page="/RitWeb" asp-route-tab="eventos" asp-route-editEventoId="@Model.EditEventoId" class="px-4 py-2.5 rounded-t-lg text-sm font-bold transition-colors @(todosActivo ? "bg-white dark:bg-slate-800 text-ritweb-teal border border-b-0 border-slate-200 dark:border-slate-600 shadow-sm -mb-px" : "text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-white/50 dark:hover:bg-slate-700/50")">
                            Todos (@(Model.Eventos?.Count ?? 0))
                        </a>
                        @foreach (var tipoEvento in tiposEventoActivos)
                        {
                            var esActivo = Model.TipoEventoIdFilter == tipoEvento.Id;
                            var countTipo = Model.Eventos?.Count(e => e.TipoEventoId == tipoEvento.Id) ?? 0;
                            <a asp-page="/RitWeb" asp-route-tab="eventos" asp-route-tipoEventoId="@tipoEvento.Id" asp-route-editEventoId="@Model.EditEventoId" class="px-4 py-2.5 rounded-t-lg text-sm font-bold transition-colors @(esActivo ? "bg-white dark:bg-slate-800 text-ritweb-teal border border-b-0 border-slate-200 dark:border-slate-600 shadow-sm -mb-px" : "text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-white/50 dark:hover:bg-slate-700/50")">
                                @tipoEvento.Nombre (@countTipo)
                            </a>
                        }
                    </div>
                    <div class="rounded-xl rounded-t-none border border-t-0 border-slate-200 dark:border-ritweb-teal/20 bg-white dark:bg-slate-900/50 overflow-hidden shadow-xl">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse font-variant-numeric-tabular" style="font-variant-numeric: tabular-nums; letter-spacing: -0.01em; min-width: 1200px;">
                                <thead>
                                    <tr class="bg-slate-100 dark:bg-ritweb-teal/10 border-b border-slate-200 dark:border-ritweb-teal/20">
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Id</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Registrado por</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Tipo evento</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Disciplina</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Fecha evento</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Turno</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Causa desviación</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Tipo alerta</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Criticidad</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Sector</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Empresa</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Prof. notificado</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60" title="Solo para eventos que requieren cierre y siguen abiertos">Días atraso</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60">Estado</th>
                                        <th class="px-4 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-ritweb-teal/60 text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200 dark:divide-ritweb-teal/10">
                                    @{
                                        var tiposEventoDict = Model.TiposEvento?.ToDictionary(t => t.Id, t => t.Nombre) ?? new Dictionary<int, string>();
                                        var detalleDict = Model.TiposEventoDetalle?.ToDictionary(d => d.Id, d => d.Nombre) ?? new Dictionary<int, string>();
                                        var tiposAlertaDict = Model.TiposAlerta?.ToDictionary(a => a.Id, a => a.Nombre) ?? new Dictionary<int, string>();
                                        var criticidadesDict = Model.Criticidades?.ToDictionary(c => c.Id, c => c.Nombre) ?? new Dictionary<int, string>();
                                        var sectoresDict = Model.Sectores?.ToDictionary(s => s.Id, s => s.Nombre) ?? new Dictionary<int, string>();
                                    }
                                    @foreach (var item in Model.FilteredEventos)
                                    {
                                        var usuarioNombre = Model.EventoUsuarioNombres?.GetValueOrDefault(item.UserId ?? "") ?? item.UsuarioNombre ?? (string.IsNullOrWhiteSpace(item.UserId) ? "—" : item.UserId);
                                        var tipoNombre = tiposEventoDict.GetValueOrDefault(item.TipoEventoId) ?? item.TipoEventoId.ToString();
                                        var disciplinaNombre = Model.EventoUsuarioDisciplinaNombres?.GetValueOrDefault(item.UserId ?? "") ?? "—";
                                        var fechaEv = item.FechaEvento ?? item.FechaCreacion;
                                        var turno = !string.IsNullOrWhiteSpace(item.Turno) ? item.Turno : (Model.EventoUsuarioTurno?.GetValueOrDefault(item.UserId ?? "") ?? "—");
                                        if (turno == "") turno = "—";
                                        var causaNombre = item.TipoEventoDetalleId.HasValue ? (detalleDict.GetValueOrDefault(item.TipoEventoDetalleId.Value) ?? item.TipoEventoDetalleId.ToString()) : "—";
                                        var alertaNombre = item.TipoAlertaId.HasValue ? (tiposAlertaDict.GetValueOrDefault(item.TipoAlertaId.Value) ?? item.TipoAlertaId.ToString()) : "—";
                                        var criticidadNombre = item.CriticidadId.HasValue ? (criticidadesDict.GetValueOrDefault(item.CriticidadId.Value) ?? item.CriticidadId.ToString()) : "—";
                                        var sectorNombre = item.SectorId.HasValue ? (sectoresDict.GetValueOrDefault(item.SectorId.Value) ?? item.SectorId.ToString()) : "—";
                                        var empresaKey = $"{item.ProyectoId}_{item.EmpresaColaboradoraId}";
                                        var empresaNombre = (Model.EventoEmpresaNombres?.GetValueOrDefault(empresaKey) ?? item.EmpresaColaboradoraNombre) ?? (item.EmpresaColaboradoraId > 0 ? item.EmpresaColaboradoraId.ToString() : "—");
                                        var profNombre = string.IsNullOrWhiteSpace(item.ProfesionalNotificadoNombre) ? "—" : item.ProfesionalNotificadoNombre;
                                        var profCargo = string.IsNullOrWhiteSpace(item.ProfesionalNotificadoCargo) ? "" : item.ProfesionalNotificadoCargo;
                                        var cerrado = item.FechaCierre.HasValue || !item.RequiereCierre;
                                        var rowBg = cerrado ? "bg-slate-50/50 dark:bg-slate-800/30 hover:bg-slate-100 dark:hover:bg-slate-700/50" : "bg-amber-500/5 hover:bg-amber-500/10 dark:bg-ritweb-teal/5 dark:hover:bg-ritweb-teal/10";
                                        <tr class="@rowBg transition-colors group">
                                            <td class="px-4 py-2.5 text-xs font-bold tabular-nums">@item.Id</td>
                                            <td class="px-4 py-2.5 text-xs font-medium truncate max-w-[140px]" title="@usuarioNombre">@usuarioNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[100px]" title="@tipoNombre">@tipoNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[120px]" title="@disciplinaNombre">@disciplinaNombre</td>
                                            <td class="px-4 py-2.5 text-xs text-slate-500 dark:text-ritweb-teal/60 tabular-nums">@fechaEv.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="px-4 py-2.5 text-xs">@turno</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[120px]" title="@causaNombre">@causaNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[90px]">@alertaNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[80px]">@criticidadNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[90px]" title="@sectorNombre">@sectorNombre</td>
                                            <td class="px-4 py-2.5 text-xs truncate max-w-[120px]" title="@empresaNombre">@empresaNombre</td>
                                            <td class="px-4 py-2.5">
                                                @if (profNombre != "—")
                                                {
                                                    <div class="flex items-center gap-2">
                                                        <div class="size-7 rounded-full bg-ritweb-teal/20 flex items-center justify-center border border-ritweb-teal/30 flex-shrink-0">
                                                            <span class="material-icons text-[14px] text-ritweb-teal">person</span>
                                                        </div>
                                                        <div class="flex flex-col min-w-0">
                                                            <span class="text-xs font-bold leading-tight truncate">@profNombre</span>
                                                            @if (!string.IsNullOrEmpty(profCargo))
                                                            {
                                                                <span class="text-[10px] text-slate-500 dark:text-ritweb-teal/50 uppercase leading-none truncate">@profCargo</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-slate-400">—</span>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5 text-xs tabular-nums">
                                                @if (item.RequiereCierre && !cerrado)
                                                {
                                                    var diasAtraso = (int)(DateTime.UtcNow - item.FechaCreacion).TotalDays;
                                                    <span class="font-bold @(diasAtraso > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-500 dark:text-slate-400")" title="Días desde la creación (evento abierto que requiere cierre)">@diasAtraso</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">—</span>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5">
                                                @if (cerrado)
                                                {
                                                    <span class="flex items-center gap-1.5 text-xs font-bold text-slate-400" title="@(!item.RequiereCierre ? "Este tipo de evento no tiene proceso de cierre (ej. Inspecciones)." : null)">
                                                        <span class="size-1.5 rounded-full bg-slate-400"></span> Cerrado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="flex items-center gap-1.5 text-xs font-bold text-amber-600 dark:text-ritweb-teal">
                                                        <span class="size-1.5 rounded-full bg-amber-500 dark:bg-ritweb-teal animate-pulse"></span> Abierto
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5 text-right">
                                                <div class="inline-flex gap-1 opacity-60 group-hover:opacity-100 transition-opacity">
                                                    <a asp-page="/RitWeb" asp-route-tab="registrarevento" asp-route-editEventoId="@item.Id" class="size-8 flex items-center justify-center rounded-lg bg-slate-200 dark:bg-ritweb-teal/20 text-slate-700 dark:text-ritweb-teal hover:bg-ritweb-teal hover:text-white transition-colors" title="Editar">
                                                        <span class="material-icons text-[18px]">edit</span>
                                                    </a>
                                                    <a asp-page="/EventoPdf" asp-route-id="@item.Id" target="_blank" class="size-8 flex items-center justify-center rounded-lg bg-slate-200 dark:bg-ritweb-teal/20 text-slate-700 dark:text-ritweb-teal hover:bg-ritweb-teal hover:text-white transition-colors" title="Ver PDF">
                                                        <span class="material-icons text-[18px]">visibility</span>
                                                    </a>
                                                    <form method="post" asp-page-handler="EliminarEvento" class="inline" onsubmit="return confirm('¿Eliminar el evento @item.Id?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="size-8 flex items-center justify-center rounded-lg bg-slate-200 dark:bg-ritweb-teal/20 text-slate-700 dark:text-ritweb-teal hover:bg-rose-500 hover:text-white transition-colors border-0 cursor-pointer" title="Eliminar">
                                                            <span class="material-icons text-[18px]">delete</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="bg-slate-100 dark:bg-ritweb-teal/5 border-t border-slate-200 dark:border-ritweb-teal/20 px-4 py-2.5 flex items-center justify-between">
                            <div class="text-[11px] font-bold text-slate-500 dark:text-ritweb-teal/60 uppercase">
                                Mostrando @Model.FilteredEventos.Count de @(Model.Eventos?.Count ?? 0) eventos
                            </div>
                        </div>
                    </div>
                    @if (!Model.FilteredEventos.Any())
                    {
                        <div class="p-6 space-y-2">
                            <p class="text-slate-600 dark:text-slate-400 text-sm">No hay eventos en la lista. Use <strong>Registrar evento</strong> para crear una alerta o inspección.</p>
                            <p class="text-xs text-slate-500 dark:text-slate-500">Los eventos se obtienen desde <strong>API_Ritweb</strong> (GET api/Eventos). Si ya registró eventos y no aparecen aquí, compruebe que la aplicación API_Ritweb esté ejecutándose y que la URL configurada en <strong>appsettings</strong> → <strong>ApiRitweb:BaseUrl</strong> sea la correcta.</p>
                        </div>
                    }
                </div>
                break;
            case "tiposevento":
                var tipoEventoEdit = Model.EditTipoEventoId.HasValue ? Model.TiposEvento.FirstOrDefault(x => x.Id == Model.EditTipoEventoId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-start justify-between gap-4">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-ritweb-teal/10 dark:bg-ritweb-teal/20 text-ritweb-teal">
                                    <span class="material-icons text-xl">category</span>
                                </span>
                                <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-100">Tipo de evento</h2>
                            </div>
                            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 max-w-2xl">Crear, editar y activar/desactivar sin borrar. Asocie a una o más disciplinas (o todas). Ej.: Alerta, Inspección.</p>
                        </div>
                        @if (tipoEventoEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-tipoevento').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-ritweb-teal focus:ring-offset-2 dark:focus:ring-offset-slate-800 transition-colors text-sm font-medium shadow-sm">
                                <span class="material-icons text-lg">add</span>
                                <span>Crear tipo de evento</span>
                            </button>
                        }
                    </div>
                    <div id="form-tipoevento" class="@(tipoEventoEdit != null ? "" : "hidden") border-b border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50">
                        <div class="px-5 py-5">
                            <p class="text-xs font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">@(tipoEventoEdit == null ? "Nuevo tipo de evento" : "Editar tipo de evento")</p>
                            <form method="post" asp-page-handler="@(tipoEventoEdit == null ? "CreateTipoEvento" : "EditTipoEvento")" class="space-y-5">
                                @if (tipoEventoEdit != null)
                                {
                                    <input type="hidden" name="id" value="@tipoEventoEdit.Id" />
                                }
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Nombre <span class="text-red-500">*</span></label>
                                        <input type="text" name="nombre" value="@(tipoEventoEdit?.Nombre)" required maxlength="200" placeholder="Ej. Alerta" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2.5 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-ritweb-teal/40 focus:border-ritweb-teal" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Disciplinas</label>
                                        <select name="disciplinaIds" multiple class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2.5 text-sm min-h-[88px] focus:outline-none focus:ring-2 focus:ring-ritweb-teal/40 focus:border-ritweb-teal">
                                            @foreach (var d in Model.Disciplinas)
                                            {
                                                <option value="@d.Id" selected="@(tipoEventoEdit?.DisciplinaIds?.Contains(d.Id) == true)">@d.Nombre</option>
                                            }
                                        </select>
                                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Ctrl+clic para varias. Sin selección = todas.</p>
                                    </div>
                                    <div class="flex flex-wrap items-end gap-4 lg:col-span-2">
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="requiereCierre" value="true" checked="@(tipoEventoEdit?.RequiereCierre ?? false)" class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-ritweb-teal focus:ring-ritweb-teal/40" />
                                            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Requiere cierre</span>
                                        </label>
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="requiereDocumentoRespaldo" value="true" checked="@(tipoEventoEdit?.RequiereDocumentoRespaldo ?? false)" class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-ritweb-teal focus:ring-ritweb-teal/40" />
                                            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Requiere documento</span>
                                        </label>
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="activo" value="true" checked="@(tipoEventoEdit?.Activo ?? true)" class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-ritweb-teal focus:ring-ritweb-teal/40" />
                                            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Activo</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-2 pt-1">
                                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-ritweb-teal focus:ring-offset-2 dark:focus:ring-offset-slate-800 text-sm font-medium shadow-sm transition-colors">
                                        <span class="material-icons text-lg">save</span>
                                        @(tipoEventoEdit == null ? "Crear" : "Guardar")
                                    </button>
                                    @if (tipoEventoEdit != null)
                                    {
                                        <a asp-page="/RitWeb" asp-route-tab="tiposevento" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium transition-colors">Cancelar</a>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs">Id</th>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs">Nombre</th>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs">Disciplinas</th>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs">Requiere cierre</th>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs">Estado</th>
                                    <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-xs w-40">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TiposEvento)
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50/80 dark:hover:bg-slate-700/30 transition-colors">
                                        <td class="px-4 py-3 text-slate-500 dark:text-slate-400">@item.Id</td>
                                        <td class="px-4 py-3 font-medium text-slate-800 dark:text-slate-100">@item.Nombre</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">@(item.DisciplinaIds == null || !item.DisciplinaIds.Any() ? "Todas" : string.Join(", ", item.DisciplinaIds))</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">@(item.RequiereCierre ? "Sí" : "No")</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(item.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(item.Activo ? "Activo" : "Inactivo")</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="flex flex-wrap gap-1.5">
                                                <form method="post" asp-page-handler="ToggleActivoTipoEvento" class="inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="activo" value="@(!item.Activo)" />
                                                    <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md text-xs font-medium @(item.Activo ? "bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/50" : "bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/50") transition-colors" title="@(item.Activo ? "Desactivar" : "Activar")">@(item.Activo ? "Desactivar" : "Activar")</button>
                                                </form>
                                                <a asp-page="/RitWeb" asp-route-tab="tiposevento" asp-route-editTipoEventoId="@item.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-slate-100 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-500 text-xs font-medium transition-colors">Editar</a>
                                                <form method="post" asp-page-handler="DeleteTipoEvento" class="inline" onsubmit="return confirm('¿Eliminar este tipo de evento?');">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900/50 text-xs font-medium transition-colors">Eliminar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.TiposEvento.Any())
                    {
                        <div class="px-5 py-12 text-center">
                            <span class="material-icons text-4xl text-slate-300 dark:text-slate-600 mb-3 block">category</span>
                            <p class="text-slate-500 dark:text-slate-400 text-sm">No hay tipos de evento.</p>
                            <p class="text-slate-400 dark:text-slate-500 text-xs mt-1">Use <strong>Crear tipo de evento</strong> para agregar (Alerta, Inspección, etc.).</p>
                        </div>
                    }
                </div>
                break;
            case "tiposeventodetalle":
                var detalleEdit = Model.EditTipoEventoDetalleId.HasValue ? Model.TiposEventoDetalle.FirstOrDefault(x => x.Id == Model.EditTipoEventoDetalleId.Value) : null;
                var posiblesPadres = Model.TiposEventoDetalle
                    .Where(x => x.Nivel < 3)
                    .GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "", x.Nivel })
                    .Select(g => g.OrderBy(x => x.Id).First())
                    .OrderBy(x => x.Nivel).ThenBy(x => x.Nombre)
                    .ToList();
                <div class="space-y-8 w-full min-w-0">
                    <!-- Page Header (estilo ejemplo) -->
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 text-ritweb-teal font-bold uppercase tracking-widest text-xs">
                                <span class="material-icons text-sm">account_tree</span>
                                Gestor de jerarquía
                            </div>
                            <h2 class="text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-slate-100">Tipos de evento detalle</h2>
                            <p class="text-slate-500 dark:text-slate-400 max-w-2xl text-sm">
                                Gestione la jerarquía en tres niveles y la lógica de combinaciones. Configure cómo los tipos de evento se relacionan con disciplinas y sub-tipos.
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-3">
                            <a asp-page="/RitWeb" asp-route-handler="ExportTiposEventoDetalle" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border-2 border-ritweb-teal text-ritweb-teal font-bold hover:bg-ritweb-teal/10 transition-all" title="Descargar tabla como CSV (Excel)">
                                <span class="material-icons">download</span>
                                Exportar a Excel
                            </a>
                        @if (detalleEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-tipoeventodetalle').classList.toggle('hidden')" class="flex items-center gap-2 px-6 py-3 bg-ritweb-teal text-white font-bold rounded-xl hover:opacity-90 transition-all shadow-lg shadow-ritweb-teal/20">
                                <span class="material-icons">add_circle</span>
                                Crear detalle
                            </button>
                        }
                        </div>
                    </div>

                    <!-- Form card: Configurar Nuevo Detalle -->
                    <section id="form-tipoeventodetalle" class="@(detalleEdit != null ? "" : "hidden") bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-600 overflow-hidden shadow-sm">
                        <div class="p-6 border-b border-slate-200 dark:border-slate-600 flex flex-wrap items-center justify-between gap-4 bg-slate-50 dark:bg-slate-800/80">
                            <h3 class="text-lg font-bold flex items-center gap-2 text-slate-800 dark:text-slate-100">
                                <span class="material-icons text-ritweb-teal">edit_note</span>
                                Configurar nuevo detalle
                            </h3>
                            <div id="detalle-badge" class="flex items-center gap-2 px-3 py-1.5 bg-ritweb-teal/20 text-ritweb-teal text-xs font-bold rounded-full">
                                <span class="material-icons text-sm">rebase_edit</span>
                                <span id="detalle-badge-n">0</span> combinaciones se crearán
                            </div>
                        </div>
                        <div class="p-6 md:p-8">
                            @if (detalleEdit == null)
                            {
                                <form method="post" asp-page-handler="CreateTipoEventoDetalle" id="form-nuevo-detalle">
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                                        <div class="space-y-2">
                                            <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Nombre <span class="text-red-500">*</span></label>
                                            <input type="text" name="nombre" required maxlength="200" placeholder="Ej. Taller avanzado" class="w-full bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-ritweb-teal focus:border-ritweb-teal" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Código</label>
                                            <input type="text" name="codigo" maxlength="50" placeholder="Ej. B1, EVT-001" class="w-full bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-ritweb-teal focus:border-ritweb-teal" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Padre (opcional)</label>
                                            <select name="tipoEventoDetallePadreId" id="detalle-padre-select" class="w-full bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-ritweb-teal focus:border-ritweb-teal">
                                                <option value="">Ninguno (nivel 1)</option>
                                                @foreach (var p in posiblesPadres)
                                                {
                                                    <option value="@p.Id">Nivel @p.Nivel · @p.Nombre</option>
                                                }
                                            </select>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">Si elige un padre, los hijos heredan tipos de evento y disciplinas del padre (no es necesario seleccionarlos).</p>
                                        </div>
                                        <div id="detalle-combinations" class="lg:col-span-3 space-y-4">
                                            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase">Solo para nivel 1 (sin padre):</p>
                                            <div class="space-y-2 lg:col-span-1">
                                            <div class="flex justify-between items-center">
                                                <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Tipos de evento</label>
                                                <button type="button" onclick="ritwebCheckAll('cb-tipos', true)" class="text-[10px] font-bold text-ritweb-teal uppercase hover:underline">Todos</button>
                                            </div>
                                            <div class="h-32 overflow-y-auto p-3 space-y-2 bg-slate-50 dark:bg-slate-700/30 border border-slate-200 dark:border-slate-600 rounded-lg" id="cb-tipos">
                                                @foreach (var te in Model.TiposEvento)
                                                {
                                                    <label class="flex items-center gap-2 text-sm cursor-pointer">
                                                        <input type="checkbox" name="tipoEventoIds" value="@te.Id" class="rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                                        @te.Nombre
                                                    </label>
                                                }
                                            </div>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">Ninguno seleccionado = todos.</p>
                                        </div>
                                        <div class="space-y-2 lg:col-span-2">
                                            <div class="flex justify-between items-center">
                                                <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Disciplinas</label>
                                                <button type="button" onclick="ritwebCheckAll('cb-disciplinas', true)" class="text-[10px] font-bold text-ritweb-teal uppercase hover:underline">Todas</button>
                                            </div>
                                            <div class="h-32 overflow-y-auto p-3 grid grid-cols-2 gap-2 bg-slate-50 dark:bg-slate-700/30 border border-slate-200 dark:border-slate-600 rounded-lg" id="cb-disciplinas">
                                                @foreach (var d in Model.Disciplinas)
                                                {
                                                    <label class="flex items-center gap-2 text-sm cursor-pointer">
                                                        <input type="checkbox" name="disciplinaIds" value="@d.Id" class="rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                                        @d.Nombre
                                                    </label>
                                                }
                                            </div>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">Ninguna seleccionada = todas.</p>
                                        </div>
                                        </div>
                                        <div id="detalle-hereda-padre" class="hidden lg:col-span-3 p-4 rounded-lg bg-ritweb-teal/10 dark:bg-ritweb-teal/20 border border-ritweb-teal/30 text-sm text-slate-700 dark:text-slate-200">
                                            <span class="font-bold text-ritweb-teal">Heredan del padre:</span> Los tipos de evento y disciplinas se tomarán del padre seleccionado. Se creará una combinación por cada una que tenga el padre (no es necesario seleccionar nada abajo).
                                        </div>
                                    </div>
                                    <div class="p-6 bg-slate-50 dark:bg-slate-800/50 flex flex-wrap justify-end gap-3 border-t border-slate-200 dark:border-slate-600 mt-6 -mx-6 md:-mx-8 px-6 md:px-8">
                                        <label class="inline-flex items-center gap-2 cursor-pointer mr-auto">
                                            <input type="checkbox" name="activo" value="true" checked class="w-4 h-4 rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                            <span class="text-sm font-bold text-slate-700 dark:text-slate-300">Activo</span>
                                        </label>
                                        <a asp-page="/RitWeb" asp-route-tab="tiposeventodetalle" class="px-6 py-2 text-sm font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Cancelar</a>
                                        <button type="submit" class="px-8 py-2 text-sm font-bold bg-ritweb-teal text-white rounded-lg hover:opacity-90 transition-opacity">Guardar configuración</button>
                                    </div>
                                </form>
                                <script>
                                (function() {
                                    function countChecked(containerId) {
                                        var c = document.getElementById(containerId);
                                        if (!c) return 0;
                                        return c.querySelectorAll('input[type="checkbox"]:checked').length;
                                    }
                                    function totalCheckboxes(containerId) {
                                        var c = document.getElementById(containerId);
                                        if (!c) return 0;
                                        return c.querySelectorAll('input[type="checkbox"]').length;
                                    }
                                    function updateBadge() {
                                        var nTipos = countChecked('cb-tipos');
                                        var nDisc = countChecked('cb-disciplinas');
                                        var tTipos = totalCheckboxes('cb-tipos');
                                        var tDisc = totalCheckboxes('cb-disciplinas');
                                        var a = nTipos === 0 ? tTipos : nTipos;
                                        var b = nDisc === 0 ? tDisc : nDisc;
                                        var n = a * b;
                                        var badge = document.getElementById('detalle-badge');
                                        var badgeN = document.getElementById('detalle-badge-n');
                                        if (badge && badgeN) {
                                            badgeN.textContent = n;
                                            badge.classList.toggle('hidden', n === 0);
                                        }
                                    }
                                    window.ritwebCheckAll = function(containerId, checked) {
                                        var c = document.getElementById(containerId);
                                        if (!c) return;
                                        c.querySelectorAll('input[type="checkbox"]').forEach(function(cb) { cb.checked = checked; });
                                        updateBadge();
                                    };
                                    document.querySelectorAll('#cb-tipos input, #cb-disciplinas input').forEach(function(el) {
                                        el.addEventListener('change', updateBadge);
                                    });
                                    function togglePorPadre() {
                                        var sel = document.getElementById('detalle-padre-select');
                                        var comb = document.getElementById('detalle-combinations');
                                        var hereda = document.getElementById('detalle-hereda-padre');
                                        var badge = document.getElementById('detalle-badge');
                                        var badgeN = document.getElementById('detalle-badge-n');
                                        if (sel && comb && hereda && badge && badgeN) {
                                            var conPadre = sel.value && sel.value !== '';
                                            if (conPadre) {
                                                comb.classList.add('hidden');
                                                hereda.classList.remove('hidden');
                                                badgeN.textContent = 'según padre';
                                                badge.classList.remove('hidden');
                                            } else {
                                                comb.classList.remove('hidden');
                                                hereda.classList.add('hidden');
                                                updateBadge();
                                            }
                                        }
                                    }
                                    var selPadre = document.getElementById('detalle-padre-select');
                                    if (selPadre) selPadre.addEventListener('change', togglePorPadre);
                                    updateBadge();
                                    togglePorPadre();
                                })();
                                </script>
                            }
                            else
                            {
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">Editar detalle</p>
                                <form method="post" asp-page-handler="EditTipoEventoDetalle" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
                                    <input type="hidden" name="id" value="@detalleEdit.Id" />
                                    <div>
                                        <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">Nombre <span class="text-red-500">*</span></label>
                                        <input type="text" name="nombre" value="@detalleEdit.Nombre" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2.5 text-sm focus:ring-2 focus:ring-ritweb-teal/40 focus:border-ritweb-teal" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">Código</label>
                                        <input type="text" name="codigo" value="@(detalleEdit.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2.5 text-sm focus:ring-2 focus:ring-ritweb-teal/40 focus:border-ritweb-teal" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">Nivel</label>
                                        <div class="flex justify-center">
                                            <div class="size-8 rounded-full flex items-center justify-center text-xs font-bold border-2
                                                @(detalleEdit.Nivel == 1 ? "bg-ritweb-teal/20 text-ritweb-teal border-ritweb-teal/30" : detalleEdit.Nivel == 2 ? "bg-blue-500/20 text-blue-500 border-blue-500/30" : "bg-amber-500/20 text-amber-500 border-amber-500/30")">@($"L{detalleEdit.Nivel}")</div>
                                        </div>
                                    </div>
                                    <div class="flex items-center">
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="activo" value="true" checked="@detalleEdit.Activo" class="w-4 h-4 rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                            <span class="text-sm font-bold text-slate-700 dark:text-slate-300">Activo</span>
                                        </label>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="submit" class="px-6 py-2 text-sm font-bold bg-ritweb-teal text-white rounded-lg">Guardar</button>
                                        <a asp-page="/RitWeb" asp-route-tab="tiposeventodetalle" class="px-6 py-2 text-sm font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">Cancelar</a>
                                    </div>
                                </form>
                            }
                        </div>
                    </section>

                    <!-- Data Table (estilo ejemplo) -->
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-600 shadow-sm overflow-hidden min-w-0">
                        <div id="bulk-actions-detalle" class="hidden px-4 py-2 bg-ritweb-teal/10 dark:bg-ritweb-teal/20 border-b border-slate-200 dark:border-slate-600 flex flex-wrap items-center gap-3">
                            <span class="text-sm font-bold text-slate-700 dark:text-slate-200"><span id="bulk-count">0</span> seleccionado(s)</span>
                            <button type="button" id="bulk-delete-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-red-500/20 text-red-600 dark:text-red-400 hover:bg-red-500/30 transition-colors">
                                <span class="material-icons text-lg">delete</span> Eliminar
                            </button>
                            <button type="button" id="bulk-deactivate-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-amber-500/20 text-amber-600 dark:text-amber-400 hover:bg-amber-500/30 transition-colors">
                                <span class="material-icons text-lg">toggle_off</span> Desactivar
                            </button>
                            <button type="button" id="bulk-activate-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/30 transition-colors">
                                <span class="material-icons text-lg">toggle_on</span> Activar
                            </button>
                            <button type="button" id="bulk-clear-btn" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 text-sm font-medium">Cancelar selección</button>
                        </div>
                        <div class="overflow-x-auto min-w-0">
                            <table class="w-full min-w-0 table-fixed text-left border-collapse" id="tabla-tipos-eventodetalle">
                                <colgroup>
                                    <col class="w-[4%]" />
                                    <col class="w-[6%]" />
                                    <col class="w-[15%]" />
                                    <col class="w-[14%]" />
                                    <col class="w-[14%]" />
                                    <col class="w-[5%]" />
                                    <col class="w-[8%]" />
                                    <col class="w-[10%]" />
                                    <col class="w-[9%]" />
                                    <col class="w-[15%]" />
                                </colgroup>
                                <thead>
                                    <tr class="bg-slate-50 dark:bg-slate-700/50 text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider">
                                        <th class="px-2 py-3 sm:px-3 sm:py-4 w-10">
                                            <label class="flex items-center justify-center cursor-pointer" title="Seleccionar todos">
                                                <input type="checkbox" id="detalle-select-all" class="rounded text-ritweb-teal focus:ring-ritweb-teal w-4 h-4" />
                                            </label>
                                        </th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Id</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Nombre</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Tipo evento</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Disciplina</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4 text-center">Nivel</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Código</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Padre</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4">Estado</th>
                                        <th class="px-3 py-3 sm:px-4 sm:py-4 text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200 dark:divide-slate-600">
                                    @{
                                        var gruposDetalle = Model.TiposEventoDetalle
                                            .GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "", x.Activo, x.Nivel })
                                            .ToList();
                                        string GetGroupKey(IEnumerable<RazorIdentity.Models.ApiRitweb.TipoEventoDetalleDto> grp)
                                        {
                                            var f = grp.First();
                                            return $"{f.Nombre}\t{f.Codigo ?? ""}\t{f.Activo}\t{f.Nivel}";
                                        }
                                        string GetParentGroupKey(IEnumerable<RazorIdentity.Models.ApiRitweb.TipoEventoDetalleDto> grp)
                                        {
                                            var f = grp.First();
                                            if (!f.TipoEventoDetallePadreId.HasValue) return null;
                                            var r = Model.TiposEventoDetalle.FirstOrDefault(x => x.Id == f.TipoEventoDetallePadreId.Value);
                                            return r == null ? null : $"{r.Nombre}\t{r.Codigo ?? ""}\t{r.Activo}\t{r.Nivel}";
                                        }
                                        var keyToGroup = gruposDetalle.ToDictionary(g => GetGroupKey(g));
                                        var orderedKeys = new List<string>();
                                        void AddKeys(string parentKey)
                                        {
                                            var children = gruposDetalle.Where(g => GetParentGroupKey(g) == parentKey).OrderBy(g => g.First().Nombre).ToList();
                                            foreach (var g in children)
                                            {
                                                var k = GetGroupKey(g);
                                                orderedKeys.Add(k);
                                                AddKeys(k);
                                            }
                                        }
                                        AddKeys(null);
                                        var added = new HashSet<string>(orderedKeys);
                                        foreach (var g in gruposDetalle.OrderBy(g => g.First().Nombre))
                                        {
                                            var k = GetGroupKey(g);
                                            if (added.Contains(k)) continue;
                                            orderedKeys.Add(k);
                                            AddKeys(k);
                                        }
                                    }
                                    @foreach (var key in orderedKeys)
                                    {
                                        var grupo = keyToGroup[key];
                                        var items = grupo.ToList();
                                        var primero = items[0];
                                        var padre = primero.TipoEventoDetallePadreId.HasValue ? Model.TiposEventoDetalle.FirstOrDefault(x => x.Id == primero.TipoEventoDetallePadreId.Value) : null;
                                        var tipoIds = items.Select(x => x.TipoEventoId).Distinct().ToList();
                                        var discIds = items.Select(x => x.DisciplinaId).Distinct().ToList();
                                        var tipoNombres = string.Join(", ", tipoIds.Select(tid => Model.TiposEvento.FirstOrDefault(t => t.Id == tid)?.Nombre ?? tid.ToString()));
                                        var discNombres = string.Join(", ", discIds.Select(did => Model.Disciplinas.FirstOrDefault(d => d.Id == did)?.Nombre ?? did.ToString()));
                                        var ids = items.Select(x => x.Id).ToList();
                                        var nivelClases = primero.Nivel == 1 ? "bg-ritweb-teal/20 text-ritweb-teal border-ritweb-teal/30" : primero.Nivel == 2 ? "bg-blue-500/20 text-blue-500 border-blue-500/30" : "bg-amber-500/20 text-amber-500 border-amber-500/30";
                                        var nombreCellClasses = primero.Nivel == 1 ? "font-bold text-slate-800 dark:text-slate-100 break-words" : primero.Nivel == 2 ? "text-sm font-bold text-slate-800 dark:text-slate-100 break-words pl-6" : "text-xs font-semibold text-slate-800 dark:text-slate-100 break-words pl-10";
                                        var idsJson = string.Join(",", ids);
                                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors" data-group-ids="@idsJson">
                                            <td class="px-2 py-3 sm:px-3 sm:py-4 w-10">
                                                <label class="flex items-center justify-center cursor-pointer">
                                                    <input type="checkbox" class="detalle-row-cb rounded text-ritweb-teal focus:ring-ritweb-teal w-4 h-4" data-group-ids="@idsJson" />
                                                </label>
                                            </td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 text-xs font-mono text-slate-400 break-all">@(items.Count == 1 ? "#" + primero.Id : "#" + ids.Min() + "–#" + ids.Max())</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 @nombreCellClasses">@primero.Nombre</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 text-sm text-slate-600 dark:text-slate-300 break-words">@(primero.Nivel == 1 ? tipoNombres : "—")</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 text-sm text-slate-600 dark:text-slate-300 break-words">@(primero.Nivel == 1 ? discNombres : "—")</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4">
                                                <div class="flex justify-center">
                                                    <div class="size-7 rounded-full flex items-center justify-center text-xs font-bold border-2 @nivelClases shrink-0">@($"L{primero.Nivel}")</div>
                                                </div>
                                            </td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 font-mono text-sm text-ritweb-teal break-all">@(primero.Codigo ?? "—")</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 text-sm text-slate-400 break-words">@(padre != null ? padre.Nombre : "—")</td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4">
                                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-bold shrink-0 @(primero.Activo ? "bg-emerald-500/10 text-emerald-500 dark:bg-emerald-400/20 dark:text-emerald-400" : "bg-slate-500/10 text-slate-500 dark:bg-slate-400/20 dark:text-slate-400")">
                                                    <span class="size-1.5 rounded-full @(primero.Activo ? "bg-emerald-500" : "bg-slate-500")"></span>
                                                    @(primero.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td class="px-3 py-3 sm:px-4 sm:py-4 text-right">
                                                <div class="flex justify-end gap-1.5 flex-wrap min-w-0">
                                                    <a asp-page="/RitWeb" asp-route-tab="tiposeventodetalle" asp-route-editTipoEventoDetalleId="@primero.Id" class="p-1.5 shrink-0 text-slate-400 hover:text-ritweb-teal hover:bg-ritweb-teal/10 rounded transition-all" title="Editar (primer ítem del grupo)">
                                                        <span class="material-icons text-lg">edit</span>
                                                    </a>
                                                    <form method="post" asp-page-handler="ToggleActivoTipoEventoDetalleMultiple" class="inline shrink-0" title="@(primero.Activo ? "Desactivar todos" : "Activar todos")">
                                                        @foreach (var id in ids) { <input type="hidden" name="ids" value="@id" /> }
                                                        <input type="hidden" name="activo" value="@(!primero.Activo)" />
                                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-ritweb-teal hover:bg-ritweb-teal/10 rounded transition-all"><span class="material-icons text-lg">@(primero.Activo ? "toggle_on" : "toggle_off")</span></button>
                                                    </form>
                                                    <form method="post" asp-page-handler="DeleteTipoEventoDetalleMultiple" class="inline shrink-0" onsubmit="return confirm('¿Eliminar los @ids.Count detalle(s) de este grupo?');">
                                                        @foreach (var id in ids) { <input type="hidden" name="ids" value="@id" /> }
                                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-red-500 hover:bg-red-500/10 rounded transition-all" title="Eliminar grupo">
                                                            <span class="material-icons text-lg">delete</span>
                                                        </button>
                                                    </form>
                                                    @if (items.Count > 1)
                                                    {
                                                        <span class="text-[10px] text-slate-400 self-center shrink-0" title="@items.Count combinaciones">@items.Count</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <script>
                        (function() {
                            var table = document.getElementById('tabla-tipos-eventodetalle');
                            if (!table) return;
                            var bar = document.getElementById('bulk-actions-detalle');
                            var countEl = document.getElementById('bulk-count');
                            var selectAll = document.getElementById('detalle-select-all');
                            var rowCbs = table.querySelectorAll('.detalle-row-cb');

                            function getSelectedIds() {
                                var ids = [];
                                rowCbs.forEach(function(cb) {
                                    if (cb.checked && cb.dataset.groupIds) {
                                        cb.dataset.groupIds.split(',').forEach(function(id) { ids.push(parseInt(id, 10)); });
                                    }
                                });
                                return ids.filter(function(id) { return !isNaN(id); });
                            }
                            function updateBulkBar() {
                                var ids = getSelectedIds();
                                var n = ids.length;
                                if (countEl) countEl.textContent = n;
                                if (bar) bar.classList.toggle('hidden', n === 0);
                                if (selectAll) selectAll.checked = n > 0 && rowCbs.length > 0 && Array.from(rowCbs).every(function(cb) { return cb.checked; });
                            }
                            rowCbs.forEach(function(cb) { cb.addEventListener('change', updateBulkBar); });
                            if (selectAll) selectAll.addEventListener('change', function() { rowCbs.forEach(function(cb) { cb.checked = selectAll.checked; }); updateBulkBar(); });
                            if (document.getElementById('bulk-clear-btn')) document.getElementById('bulk-clear-btn').addEventListener('click', function() {
                                rowCbs.forEach(function(cb) { cb.checked = false; });
                                if (selectAll) selectAll.checked = false;
                                updateBulkBar();
                            });

                            function submitBulk(handler, body) {
                                var ids = getSelectedIds();
                                if (ids.length === 0) { alert('Seleccione al menos un registro.'); return; }
                                var form = document.createElement('form');
                                form.method = 'post';
                                form.action = window.location.pathname + '?tab=tiposeventodetalle&handler=' + handler;
                                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                                if (token) { var clone = token.cloneNode(true); form.appendChild(clone); }
                                ids.forEach(function(id) {
                                    var inp = document.createElement('input');
                                    inp.type = 'hidden'; inp.name = 'ids'; inp.value = id;
                                    form.appendChild(inp);
                                });
                                if (body) { for (var k in body) { var i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = body[k]; form.appendChild(i); } }
                                document.body.appendChild(form);
                                form.submit();
                            }
                            var deleteBtn = document.getElementById('bulk-delete-btn');
                            if (deleteBtn) deleteBtn.addEventListener('click', function() {
                                var ids = getSelectedIds();
                                if (ids.length === 0) { alert('Seleccione al menos un registro.'); return; }
                                if (!confirm('¿Eliminar ' + ids.length + ' registro(s) seleccionado(s)?')) return;
                                submitBulk('DeleteTipoEventoDetalleMultiple');
                            });
                            var deactBtn = document.getElementById('bulk-deactivate-btn');
                            if (deactBtn) deactBtn.addEventListener('click', function() {
                                if (!confirm('¿Desactivar los registros seleccionados?')) return;
                                submitBulk('ToggleActivoTipoEventoDetalleMultiple', { activo: 'false' });
                            });
                            var actBtn = document.getElementById('bulk-activate-btn');
                            if (actBtn) actBtn.addEventListener('click', function() {
                                if (!confirm('¿Activar los registros seleccionados?')) return;
                                submitBulk('ToggleActivoTipoEventoDetalleMultiple', { activo: 'true' });
                            });
                        })();
                        </script>
                        @if (!Model.TiposEventoDetalle.Any())
                        {
                            <div class="p-12 text-center">
                                <span class="material-icons text-5xl text-slate-300 dark:text-slate-600 mb-4 block">account_tree</span>
                                <p class="text-slate-500 dark:text-slate-400 font-medium">No hay tipos de evento detalle</p>
                                <p class="text-slate-400 dark:text-slate-500 text-sm mt-1">Cree primero un <strong>Tipo de evento</strong> y luego agregue detalles; puede elegir varios tipos y disciplinas (o todos) para crear muchas combinaciones a la vez.</p>
                            </div>
                        }
                        else
                        {
                            var totalGrupos = Model.TiposEventoDetalle.GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "", x.Activo, x.Nivel }).Count();
                            <div class="p-4 border-t border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-800/50 flex items-center justify-between">
                                <p class="text-xs text-slate-500">Mostrando <span class="font-bold">@totalGrupos</span> grupo(s) · <span class="font-bold">@Model.TiposEventoDetalle.Count</span> registro(s) en total</p>
                            </div>
                        }
                    </div>
                </div>
                break;
            case "sectores":
                var sectorEdit = Model.EditSectorId.HasValue ? Model.Sectores.FirstOrDefault(x => x.Id == Model.EditSectorId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Sectores</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">Sectores del proyecto. Crear, editar y eliminar (On/Off). Muro, Túnel, Campamento, Oficinas, etc.</p>
                        </div>
                        @if (sectorEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-sectores').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 transition-colors text-sm font-medium">
                                <span class="material-icons text-lg">add</span> Crear sector
                            </button>
                        }
                    </div>
                    <div id="form-sectores" class="@(sectorEdit != null ? "" : "hidden") px-4 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/30">
                        <form method="post" asp-page-handler="@(sectorEdit == null ? "CreateSector" : "EditSector")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
                            @if (sectorEdit != null)
                            {
                                <input type="hidden" name="id" value="@sectorEdit.Id" />
                            }
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre *</label>
                                <input type="text" name="nombre" value="@(sectorEdit?.Nombre)" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" placeholder="Ej. Muro" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Proyecto *</label>
                                <select name="proyectoId" required class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm">
                                    @if (!Model.Proyectos.Any())
                                    {
                                        <option value="">— Configure proyectos en Ajustes (RIT) —</option>
                                    }
                                    @foreach (var p in Model.Proyectos)
                                    {
                                        <option value="@p.Id" selected="@(sectorEdit?.ProyectoId == p.Id)">@(string.IsNullOrWhiteSpace(p.NumeroContrato) ? p.Nombre : $"{p.Nombre} · {p.NumeroContrato}")</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Código</label>
                                <input type="text" name="codigo" value="@(sectorEdit?.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Descripción</label>
                                <input type="text" name="descripcion" value="@(sectorEdit?.Descripcion)" maxlength="500" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div class="flex items-end">
                                <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                    <input type="checkbox" name="activo" value="true" checked="@(sectorEdit?.Activo ?? true)" class="rounded border-slate-300 dark:border-slate-600" />
                                    Activo
                                </label>
                            </div>
                            <div class="flex items-end gap-2">
                                <button type="submit" class="px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 text-sm font-medium">@(sectorEdit == null ? "Crear" : "Guardar")</button>
                                @if (sectorEdit != null)
                                {
                                    <a asp-page="/RitWeb" asp-route-tab="sectores" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium">Cancelar</a>
                                }
                            </div>
                        </form>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nombre</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">ProyectoId</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Código</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Activo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Sectores)
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3 font-medium">@item.Nombre</td>
                                        <td class="px-4 py-3">@item.ProyectoId</td>
                                        <td class="px-4 py-3">@(item.Codigo ?? "—")</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(item.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(item.Activo ? "Sí" : "No")</span>
                                        </td>
                                        <td class="px-4 py-3 flex flex-wrap gap-2">
                                            <form method="post" asp-page-handler="ToggleActivoSector" class="inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(!item.Activo)" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded @(item.Activo ? "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300" : "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300") text-xs font-medium">@(item.Activo ? "Desactivar" : "Activar")</button>
                                            </form>
                                            <a asp-page="/RitWeb" asp-route-tab="sectores" asp-route-editSectorId="@item.Id" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 text-xs font-medium">Editar</a>
                                            <form method="post" asp-page-handler="DeleteSector" class="inline" onsubmit="return confirm('¿Eliminar este sector?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 text-xs font-medium">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Sectores.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay sectores. Configure proyectos en Ajustes (RIT) y luego cree sectores aquí.</p>
                    }
                </div>
                break;
            case "tiposdocumento":
                var docEdit = Model.EditTipoDocumentoId.HasValue ? Model.TiposDocumentoRespaldo.FirstOrDefault(x => x.Id == Model.EditTipoDocumentoId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Tipos de documentos</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">Crear, editar y eliminar (On/Off). Asociar a una disciplina opcional y a un número de protocolo. Norma, Plano, Protocolo, etc.</p>
                        </div>
                        @if (docEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-tiposdocumento').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 transition-colors text-sm font-medium">
                                <span class="material-icons text-lg">add</span> Crear tipo de documento
                            </button>
                        }
                    </div>
                    <div id="form-tiposdocumento" class="@(docEdit != null ? "" : "hidden") px-4 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/30">
                        <form method="post" asp-page-handler="@(docEdit == null ? "CreateTipoDocumento" : "EditTipoDocumento")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
                            @if (docEdit != null)
                            {
                                <input type="hidden" name="id" value="@docEdit.Id" />
                            }
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre *</label>
                                <input type="text" name="nombre" value="@(docEdit?.Nombre)" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" placeholder="Ej. Norma" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Código</label>
                                <input type="text" name="codigo" value="@(docEdit?.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            @if (docEdit != null)
                            {
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Disciplina (0 = ninguna)</label>
                                    <select name="disciplinaId" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm">
                                        <option value="0" selected="@(docEdit.DisciplinaId == 0)">— Ninguna —</option>
                                        @foreach (var d in Model.Disciplinas)
                                        {
                                            <option value="@d.Id" selected="@(docEdit.DisciplinaId == d.Id)">@d.Nombre</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="sm:col-span-2">
                                    <div class="flex justify-between items-center mb-1">
                                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Disciplinas</label>
                                        <button type="button" onclick="docCheckAll('cb-doc-disciplinas', true)" class="text-xs font-bold text-ritweb-teal uppercase hover:underline">Todas</button>
                                    </div>
                                    <div class="h-32 overflow-y-auto p-3 grid grid-cols-2 gap-2 bg-slate-50 dark:bg-slate-700/30 border border-slate-200 dark:border-slate-600 rounded-lg" id="cb-doc-disciplinas">
                                        <label class="flex items-center gap-2 text-sm cursor-pointer">
                                            <input type="checkbox" name="disciplinaIds" value="0" class="rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                            Ninguna
                                        </label>
                                        @foreach (var d in Model.Disciplinas)
                                        {
                                            <label class="flex items-center gap-2 text-sm cursor-pointer">
                                                <input type="checkbox" name="disciplinaIds" value="@d.Id" class="rounded text-ritweb-teal focus:ring-ritweb-teal" />
                                                @d.Nombre
                                            </label>
                                        }
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Ninguna seleccionada = se crea uno por cada disciplina disponible.</p>
                                </div>
                            }
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Descripción</label>
                                <input type="text" name="descripcion" value="@(docEdit?.Descripcion)" maxlength="500" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nº Protocolo</label>
                                <input type="text" name="numeroProtocolo" value="@(docEdit?.NumeroProtocolo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div class="flex flex-wrap items-end gap-4">
                                <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                    <input type="checkbox" name="activo" value="true" checked="@(docEdit?.Activo ?? true)" class="rounded border-slate-300 dark:border-slate-600" />
                                    Activo
                                </label>
                                <button type="submit" class="px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 text-sm font-medium">@(docEdit == null ? "Crear" : "Guardar")</button>
                                @if (docEdit != null)
                                {
                                    <a asp-page="/RitWeb" asp-route-tab="tiposdocumento" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium">Cancelar</a>
                                }
                            </div>
                        </form>
                        @if (docEdit == null)
                        {
                            <script>
                                window.docCheckAll = function(containerId, checked) {
                                    var c = document.getElementById(containerId);
                                    if (!c) return;
                                    c.querySelectorAll('input[type="checkbox"]').forEach(function(cb) { cb.checked = checked; });
                                };
                            </script>
                        }
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nombre</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Código</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Disciplina</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nº Protocolo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Activo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var gruposDoc = Model.TiposDocumentoRespaldo
                                        .GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "", x.Activo })
                                        .ToList();
                                }
                                @foreach (var grupo in gruposDoc)
                                {
                                    var itemsDoc = grupo.ToList();
                                    var primeroDoc = itemsDoc[0];
                                    var idsDoc = itemsDoc.Select(x => x.Id).ToList();
                                    var discNombresDoc = string.Join(", ", itemsDoc.Select(x => x.DisciplinaId == 0 ? "Ninguna" : (Model.Disciplinas.FirstOrDefault(d => d.Id == x.DisciplinaId)?.Nombre ?? x.DisciplinaId.ToString())));
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3 text-slate-500">@(itemsDoc.Count == 1 ? "#" + primeroDoc.Id : "#" + idsDoc.Min() + "–#" + idsDoc.Max())</td>
                                        <td class="px-4 py-3 font-medium">@primeroDoc.Nombre</td>
                                        <td class="px-4 py-3">@(primeroDoc.Codigo ?? "—")</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">@discNombresDoc</td>
                                        <td class="px-4 py-3">@(primeroDoc.NumeroProtocolo ?? "—")</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(primeroDoc.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(primeroDoc.Activo ? "Sí" : "No")</span>
                                        </td>
                                        <td class="px-4 py-3 flex flex-wrap gap-2">
                                            <form method="post" asp-page-handler="ToggleActivoTipoDocumentoMultiple" class="inline">
                                                @foreach (var id in idsDoc) { <input type="hidden" name="ids" value="@id" /> }
                                                <input type="hidden" name="activo" value="@(!primeroDoc.Activo)" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded @(primeroDoc.Activo ? "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300" : "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300") text-xs font-medium">@(primeroDoc.Activo ? "Desactivar" : "Activar")</button>
                                            </form>
                                            <a asp-page="/RitWeb" asp-route-tab="tiposdocumento" asp-route-editTipoDocumentoId="@primeroDoc.Id" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 text-xs font-medium">Editar</a>
                                            <form method="post" asp-page-handler="DeleteTipoDocumentoMultiple" class="inline" onsubmit="return confirm('¿Eliminar los @idsDoc.Count tipo(s) de documento de este grupo?');">
                                                @foreach (var id in idsDoc) { <input type="hidden" name="ids" value="@id" /> }
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 text-xs font-medium">Eliminar</button>
                                            </form>
                                            @if (itemsDoc.Count > 1)
                                            {
                                                <span class="text-[10px] text-slate-400 self-center" title="@itemsDoc.Count registros">@itemsDoc.Count</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.TiposDocumentoRespaldo.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay tipos de documento respaldo. Use <strong>Crear tipo de documento</strong> para agregar.</p>
                    }
                    else
                    {
                        var totalGruposDoc = Model.TiposDocumentoRespaldo.GroupBy(x => new { x.Nombre, Codigo = x.Codigo ?? "", x.Activo }).Count();
                        <div class="p-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-xs text-slate-500">
                            Mostrando <span class="font-bold">@totalGruposDoc</span> grupo(s) · <span class="font-bold">@Model.TiposDocumentoRespaldo.Count</span> registro(s) en total
                        </div>
                    }
                </div>
                break;
            case "tiposalerta":
                var taEdit = Model.EditTipoAlertaId.HasValue ? Model.TiposAlerta.FirstOrDefault(x => x.Id == Model.EditTipoAlertaId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Tipos de alerta</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">CRUD de tipos de alerta (Temprana, Inmediata, Preventiva, etc.).</p>
                        </div>
                        @if (taEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-tiposalerta').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 transition-colors text-sm font-medium">
                                <span class="material-icons text-lg">add</span> Crear tipo de alerta
                            </button>
                        }
                    </div>
                    <div id="form-tiposalerta" class="@(taEdit != null ? "" : "hidden") px-4 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/30">
                        <form method="post" asp-page-handler="@(taEdit == null ? "CreateTipoAlerta" : "EditTipoAlerta")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                            @if (taEdit != null)
                            {
                                <input type="hidden" name="id" value="@taEdit.Id" />
                            }
                            <div class="lg:col-span-2">
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre *</label>
                                <input type="text" name="nombre" value="@(taEdit?.Nombre)" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" placeholder="Ej. Temprana" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Código</label>
                                <input type="text" name="codigo" value="@(taEdit?.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Orden</label>
                                <input type="number" name="orden" value="@(taEdit?.Orden ?? 0)" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div class="flex items-end gap-3">
                                <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300">
                                    <input type="checkbox" name="activo" value="true" class="rounded text-ritweb-teal focus:ring-ritweb-teal" @(taEdit == null || taEdit.Activo ? "checked" : "") />
                                    Activo
                                </label>
                                <input type="hidden" name="activo" value="false" />
                            </div>
                            <div class="lg:col-span-5 flex gap-3">
                                <button type="submit" class="px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 text-sm font-medium">@(taEdit == null ? "Crear" : "Guardar")</button>
                                <a asp-page="/RitWeb" asp-route-tab="tiposalerta" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium">Cancelar</a>
                            </div>
                        </form>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nombre</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Código</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Orden</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Activo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TiposAlerta.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3 font-medium">@item.Nombre</td>
                                        <td class="px-4 py-3">@(item.Codigo ?? "—")</td>
                                        <td class="px-4 py-3">@item.Orden</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(item.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(item.Activo ? "Sí" : "No")</span>
                                        </td>
                                        <td class="px-4 py-3 flex flex-wrap gap-2">
                                            <form method="post" asp-page-handler="ToggleActivoTipoAlerta" class="inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(!item.Activo)" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded @(item.Activo ? "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300" : "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300") text-xs font-medium">@(item.Activo ? "Desactivar" : "Activar")</button>
                                            </form>
                                            <a asp-page="/RitWeb" asp-route-tab="tiposalerta" asp-route-editTipoAlertaId="@item.Id" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 text-xs font-medium">Editar</a>
                                            <form method="post" asp-page-handler="DeleteTipoAlerta" class="inline" onsubmit="return confirm('¿Eliminar este tipo de alerta?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 text-xs font-medium">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.TiposAlerta.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay tipos de alerta. Use <strong>Crear tipo de alerta</strong> para agregar.</p>
                    }
                </div>
                break;
            case "criticidades":
                var critEdit = Model.EditCriticidadId.HasValue ? Model.Criticidades.FirstOrDefault(x => x.Id == Model.EditCriticidadId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Criticidades</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">CRUD de criticidad (Alta, Media, Baja, etc.).</p>
                        </div>
                        @if (critEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-criticidades').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 transition-colors text-sm font-medium">
                                <span class="material-icons text-lg">add</span> Crear criticidad
                            </button>
                        }
                    </div>
                    <div id="form-criticidades" class="@(critEdit != null ? "" : "hidden") px-4 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/30">
                        <form method="post" asp-page-handler="@(critEdit == null ? "CreateCriticidad" : "EditCriticidad")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                            @if (critEdit != null)
                            {
                                <input type="hidden" name="id" value="@critEdit.Id" />
                            }
                            <div class="lg:col-span-2">
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre *</label>
                                <input type="text" name="nombre" value="@(critEdit?.Nombre)" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" placeholder="Ej. Alta" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Código</label>
                                <input type="text" name="codigo" value="@(critEdit?.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Orden</label>
                                <input type="number" name="orden" value="@(critEdit?.Orden ?? 0)" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div class="flex items-end gap-3">
                                <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300">
                                    <input type="checkbox" name="activo" value="true" class="rounded text-ritweb-teal focus:ring-ritweb-teal" @(critEdit == null || critEdit.Activo ? "checked" : "") />
                                    Activo
                                </label>
                                <input type="hidden" name="activo" value="false" />
                            </div>
                            <div class="lg:col-span-5 flex gap-3">
                                <button type="submit" class="px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 text-sm font-medium">@(critEdit == null ? "Crear" : "Guardar")</button>
                                <a asp-page="/RitWeb" asp-route-tab="criticidades" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium">Cancelar</a>
                            </div>
                        </form>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nombre</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Código</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Orden</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Activo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Criticidades.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3 font-medium">@item.Nombre</td>
                                        <td class="px-4 py-3">@(item.Codigo ?? "—")</td>
                                        <td class="px-4 py-3">@item.Orden</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(item.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(item.Activo ? "Sí" : "No")</span>
                                        </td>
                                        <td class="px-4 py-3 flex flex-wrap gap-2">
                                            <form method="post" asp-page-handler="ToggleActivoCriticidad" class="inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(!item.Activo)" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded @(item.Activo ? "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300" : "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300") text-xs font-medium">@(item.Activo ? "Desactivar" : "Activar")</button>
                                            </form>
                                            <a asp-page="/RitWeb" asp-route-tab="criticidades" asp-route-editCriticidadId="@item.Id" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 text-xs font-medium">Editar</a>
                                            <form method="post" asp-page-handler="DeleteCriticidad" class="inline" onsubmit="return confirm('¿Eliminar esta criticidad?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 text-xs font-medium">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Criticidades.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay criticidades. Use <strong>Crear criticidad</strong> para agregar.</p>
                    }
                </div>
                break;
            case "turnos":
                var turnoEdit = Model.EditTurnoId.HasValue ? Model.Turnos.FirstOrDefault(x => x.Id == Model.EditTurnoId.Value) : null;
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Turnos</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">Catálogo de turnos (Mañana, Tarde, Noche). El turno del usuario se obtiene desde la ficha del perfil (RIT_API).</p>
                        </div>
                        @if (turnoEdit == null)
                        {
                            <button type="button" onclick="document.getElementById('form-turnos').classList.toggle('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 transition-colors text-sm font-medium">
                                <span class="material-icons text-lg">add</span> Crear turno
                            </button>
                        }
                    </div>
                    <div id="form-turnos" class="@(turnoEdit != null ? "" : "hidden") px-4 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/30">
                        <form method="post" asp-page-handler="@(turnoEdit == null ? "CreateTurno" : "EditTurno")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                            @if (turnoEdit != null)
                            {
                                <input type="hidden" name="id" value="@turnoEdit.Id" />
                            }
                            <div class="lg:col-span-2">
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre *</label>
                                <input type="text" name="nombre" value="@(turnoEdit?.Nombre)" required maxlength="200" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" placeholder="Ej. Mañana" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Código</label>
                                <input type="text" name="codigo" value="@(turnoEdit?.Codigo)" maxlength="50" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Orden</label>
                                <input type="number" name="orden" value="@(turnoEdit?.Orden ?? 0)" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-3 py-2 text-sm" />
                            </div>
                            <div class="flex items-end gap-3">
                                <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300">
                                    <input type="checkbox" name="activo" value="true" class="rounded text-ritweb-teal focus:ring-ritweb-teal" @(turnoEdit == null || turnoEdit.Activo ? "checked" : "") />
                                    Activo
                                </label>
                                <input type="hidden" name="activo" value="false" />
                            </div>
                            <div class="lg:col-span-5 flex gap-3">
                                <button type="submit" class="px-4 py-2 rounded-lg bg-ritweb-teal text-white hover:bg-teal-600 text-sm font-medium">@(turnoEdit == null ? "Crear" : "Guardar")</button>
                                <a asp-page="/RitWeb" asp-route-tab="turnos" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-sm font-medium">Cancelar</a>
                            </div>
                        </form>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Nombre</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Código</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Orden</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Activo</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Turnos.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3 font-medium">@item.Nombre</td>
                                        <td class="px-4 py-3">@(item.Codigo ?? "—")</td>
                                        <td class="px-4 py-3">@item.Orden</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium @(item.Activo ? "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300" : "bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-400")">@(item.Activo ? "Sí" : "No")</span>
                                        </td>
                                        <td class="px-4 py-3 flex flex-wrap gap-2">
                                            <form method="post" asp-page-handler="ToggleActivoTurno" class="inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(!item.Activo)" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded @(item.Activo ? "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300" : "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300") text-xs font-medium">@(item.Activo ? "Desactivar" : "Activar")</button>
                                            </form>
                                            <a asp-page="/RitWeb" asp-route-tab="turnos" asp-route-editTurnoId="@item.Id" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 text-xs font-medium">Editar</a>
                                            <form method="post" asp-page-handler="DeleteTurno" class="inline" onsubmit="return confirm('¿Eliminar este turno?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 text-xs font-medium">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Turnos.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay turnos. Use <strong>Crear turno</strong> para agregar (ej. Mañana, Tarde, Noche). El turno asignado a cada usuario se gestiona en la ficha del perfil (RIT_API).</p>
                    }
                </div>
                break;
            default:
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-700">
                        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Eventos</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Alertas e inspecciones registradas. Crear y cerrar eventos desde la API_Ritweb.</p>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-700/50">
                                <tr>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Id</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">TipoEventoId</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">ProyectoId</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Fecha</th>
                                    <th class="text-left px-4 py-3 font-medium text-slate-700 dark:text-slate-200">Cerrado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Eventos)
                                {
                                    <tr class="border-t border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                        <td class="px-4 py-3">@item.Id</td>
                                        <td class="px-4 py-3">@item.TipoEventoId</td>
                                        <td class="px-4 py-3">@item.ProyectoId</td>
                                        <td class="px-4 py-3">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="px-4 py-3">@(item.FechaCierre.HasValue ? "Sí" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Eventos.Any())
                    {
                        <p class="p-4 text-slate-500 dark:text-slate-400 text-sm">No hay eventos. Cree eventos desde la API o integre el formulario de alta en esta página.</p>
                    }
                </div>
                break;
        }
    </main>
</div>
<style>
    #sidebar.sidebar-collapsed nav a { justify-content: center; padding-left: 0; padding-right: 0; }
    #sidebar.sidebar-collapsed .px-4 { padding-left: 0.5rem; padding-right: 0.5rem; }
</style>
<script>
(function () {
    var STORAGE_KEY = 'ritweb-sidebar-collapsed';
    var sidebar = document.getElementById('sidebar');
    var main = document.getElementById('main-content');
    var overlay = document.getElementById('sidebar-overlay');
    var toggle = document.getElementById('sidebar-toggle');
    var openMobile = document.getElementById('sidebar-open-mobile');
    var closeMobile = document.getElementById('sidebar-close-mobile');
    var iconExpand = document.querySelector('.sidebar-icon-expand');
    var iconCollapse = document.querySelector('.sidebar-icon-collapse');
    var labels = sidebar ? sidebar.querySelectorAll('.sidebar-label') : [];
    var texts = sidebar ? sidebar.querySelectorAll('.sidebar-text') : [];
    var logoTexts = sidebar ? sidebar.querySelectorAll('.sidebar-logo-text') : [];

    function isCollapsed() { return localStorage.getItem(STORAGE_KEY) === '1'; }
    function isMobile() { return window.innerWidth < 1024; }
    function closeMobileSidebar() {
        if (!sidebar || !overlay) return;
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        overlay.classList.add('hidden');
    }
    function openMobileSidebar() {
        if (!sidebar || !overlay) return;
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        overlay.classList.remove('hidden');
    }
    if (openMobile) openMobile.addEventListener('click', openMobileSidebar);
    if (closeMobile) closeMobile.addEventListener('click', closeMobileSidebar);
    if (overlay) overlay.addEventListener('click', closeMobileSidebar);
    window.addEventListener('resize', function () { if (!isMobile()) closeMobileSidebar(); });

    function applyState(collapsed) {
        if (isMobile()) return;
        if (collapsed) {
            sidebar.classList.add('sidebar-collapsed', 'w-20');
            sidebar.classList.remove('w-72');
            main.classList.remove('lg:ml-72');
            main.style.marginLeft = '5rem';
            if (iconExpand) iconExpand.classList.add('hidden');
            if (iconCollapse) iconCollapse.classList.remove('hidden');
            labels.forEach(function (el) { el.classList.add('hidden'); });
            texts.forEach(function (el) { el.classList.add('hidden'); });
            logoTexts.forEach(function (el) { el.classList.add('hidden'); });
        } else {
            sidebar.classList.remove('sidebar-collapsed', 'w-20');
            sidebar.classList.add('w-72');
            main.classList.add('lg:ml-72');
            main.style.marginLeft = '';
            if (iconExpand) iconExpand.classList.remove('hidden');
            if (iconCollapse) iconCollapse.classList.add('hidden');
            labels.forEach(function (el) { el.classList.remove('hidden'); });
            texts.forEach(function (el) { el.classList.remove('hidden'); });
            logoTexts.forEach(function (el) { el.classList.remove('hidden'); });
        }
    }
    if (toggle && sidebar && main) {
        if (!isMobile()) applyState(isCollapsed());
        toggle.addEventListener('click', function () {
            if (isMobile()) return;
            var collapsed = !isCollapsed();
            localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
            applyState(collapsed);
        });
    }
})();
</script>
