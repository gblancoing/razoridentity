@page
@model RazorIdentity.Pages.RitWebProyectosModel
@{
    ViewData["Title"] = "RitWeb por proyecto";
}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <nav class="flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400 mb-6">
        <a asp-page="/App" class="hover:text-ritweb-teal dark:hover:text-teal-400">Aplicaciones</a>
        <span class="material-icons text-[16px]">chevron_right</span>
        <span class="text-slate-800 dark:text-slate-200">RitWeb por proyecto</span>
    </nav>
    <h1 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-slate-100 mb-2">RitWeb por proyecto</h1>
    <p class="text-slate-600 dark:text-slate-300 mb-6 text-sm">Seleccione el proyecto para abrir RitWeb. Como Super_admin puede acceder al Rit de cualquier proyecto.</p>

    @if (Model.ErrorApi != null)
    {
        <div class="mb-6 rounded-xl bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700/80 p-4 text-amber-800 dark:text-amber-200 text-sm flex items-start gap-3">
            <span class="material-icons text-amber-600 dark:text-amber-400 flex-shrink-0">warning</span>
            <span>@Model.ErrorApi</span>
        </div>
    }

    @if (!Model.Proyectos.Any() && Model.ErrorApi == null)
    {
        <p class="text-slate-500 dark:text-slate-400">No hay proyectos. Cree proyectos desde <a asp-page="/Protegido" asp-route-tab="proyectos" class="text-ritweb-teal dark:text-teal-400 hover:underline">Ajustes → Proyectos</a>.</p>
    }
    else if (Model.Proyectos.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var p in Model.Proyectos)
            {
                <a asp-page="/RitWeb" asp-route-proyectoId="@p.Id" class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 shadow-sm hover:shadow-md hover:border-ritweb-teal dark:hover:border-teal-500 transition-all block">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-lg bg-ritweb-teal/10 dark:bg-ritweb-teal/20 flex items-center justify-center flex-shrink-0">
                            <span class="material-icons text-ritweb-teal text-2xl">work</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h2 class="font-semibold text-slate-800 dark:text-slate-100">@(string.IsNullOrWhiteSpace(p.NumeroContrato) ? p.Nombre : $"{p.Nombre} · {p.NumeroContrato}")</h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Abrir RitWeb para este proyecto</p>
                        </div>
                        <span class="material-icons text-slate-400">arrow_forward</span>
                    </div>
                </a>
            }
        </div>
    }
</div>
