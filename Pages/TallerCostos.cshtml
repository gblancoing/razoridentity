@page
@model RazorIdentity.Pages.TallerCostosModel
@{
    ViewData["Title"] = "Taller Rango de Costos";
}

@section Head {
<style>
    /* ── Layout ── */
    #tc-sidebar { transition: width 0.22s ease; will-change: width; overflow: hidden; }
    #tc-sidebar.tc-collapsed { width: 3.5rem !important; }
    #tc-sidebar.tc-collapsed .tc-sb-label,
    #tc-sidebar.tc-collapsed .tc-sb-group { display: none; }

    /* ── Step buttons ── */
    .step-btn { display:flex; align-items:center; gap:0.5rem; width:100%; padding:0.5rem 0.625rem;
        border-radius:0.5rem; font-size:0.8125rem; color:#475569; transition:background 0.15s,color 0.15s;
        cursor:pointer; border:none; background:none; text-align:left; }
    .step-btn:hover { background:#f1f5f9; color:#1e293b; }
    .dark .step-btn:hover { background:#1e293b; color:#f1f5f9; }
    .step-btn.tc-active { background:rgba(15,148,136,0.1); color:#0f9488; font-weight:600; }
    .dark .step-btn.tc-active { background:rgba(15,148,136,0.18); color:#2dd4bf; }
    .step-btn .step-icon { font-size:18px; flex-shrink:0; }
    .step-btn .step-badge { margin-left:auto; font-size:0.7rem; background:#e2e8f0; border-radius:9999px;
        padding:0 0.4rem; color:#64748b; font-weight:600; }
    .dark .step-btn .step-badge { background:#334155; color:#94a3b8; }

    /* ── Sections ── */
    .tc-section { display:none; }
    .tc-section.tc-visible { display:block; }

    /* ── Tables ── */
    .tc-table { width:100%; border-collapse:collapse; font-size:0.8125rem; }
    .tc-table th { background:#f8fafc; font-weight:600; color:#475569; padding:0.5rem 0.625rem;
        text-align:left; border-bottom:2px solid #e2e8f0; white-space:nowrap; }
    .dark .tc-table th { background:#1e293b; color:#94a3b8; border-color:#334155; }
    .tc-table td { padding:0.375rem 0.5rem; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .dark .tc-table td { border-color:#1e293b; }
    .tc-table tr:hover td { background:#fafbfc; }
    .dark .tc-table tr:hover td { background:#0f172a; }

    /* ── Inputs ── */
    .tc-input { border-radius:0.375rem; border:1px solid #cbd5e1; background:#fff; color:#1e293b;
        padding:0.3rem 0.5rem; font-size:0.8125rem; width:100%; }
    .dark .tc-input { border-color:#475569; background:#1e293b; color:#f1f5f9; }
    .tc-input:focus { outline:none; border-color:#0d9488; box-shadow:0 0 0 2px rgba(13,148,136,0.18); }
    .tc-select { border-radius:0.375rem; border:1px solid #cbd5e1; background:#fff; color:#1e293b;
        padding:0.3rem 0.5rem; font-size:0.8125rem; }
    .dark .tc-select { border-color:#475569; background:#1e293b; color:#f1f5f9; }

    /* ── Buttons ── */
    .btn-primary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 1rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer; border:none;
        background:#0f9488; color:#fff; transition:background 0.15s; }
    .btn-primary:hover { background:#0d7a70; }
    .btn-primary:disabled { opacity:0.45; cursor:not-allowed; }
    .btn-secondary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 0.875rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer;
        border:1px solid #cbd5e1; background:#fff; color:#475569; transition:background 0.15s; }
    .dark .btn-secondary { background:#1e293b; border-color:#475569; color:#94a3b8; }
    .btn-secondary:hover { background:#f1f5f9; }
    .dark .btn-secondary:hover { background:#0f172a; }
    .btn-success { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4rem 1rem;
        border-radius:0.5rem; font-size:0.8125rem; font-weight:500; cursor:pointer; border:none;
        background:#16a34a; color:#fff; transition:background 0.15s; }
    .btn-success:hover { background:#15803d; }
    .btn-success:disabled { opacity:0.55; cursor:default; }
    .btn-danger { display:inline-flex; align-items:center; gap:0.25rem; padding:0.3rem 0.6rem;
        border-radius:0.375rem; font-size:0.75rem; font-weight:500; cursor:pointer; border:none;
        background:transparent; color:#ef4444; transition:background 0.15s; }
    .btn-danger:hover { background:#fef2f2; }

    /* ── Cards ── */
    .tc-card { background:#fff; border:1px solid #e2e8f0; border-radius:0.75rem; padding:1.25rem; }
    .dark .tc-card { background:#1e293b; border-color:#334155; }

    /* ── Badges ── */
    .badge-verde { background:#dcfce7; color:#15803d; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-amarillo { background:#fef9c3; color:#854d0e; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-rojo { background:#fee2e2; color:#b91c1c; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .badge-azul { background:#dbeafe; color:#1d4ed8; border-radius:9999px; padding:0.1rem 0.5rem; font-size:0.7rem; font-weight:600; }
    .dark .badge-verde { background:#14532d; color:#86efac; }
    .dark .badge-amarillo { background:#422006; color:#fde68a; }
    .dark .badge-rojo { background:#450a0a; color:#fca5a5; }

    /* ── Bloque tabs ── */
    .bloque-tab { padding:0.4rem 0.875rem; border-radius:0.5rem 0.5rem 0 0; font-size:0.8125rem;
        font-weight:500; cursor:pointer; border:1px solid #e2e8f0; border-bottom:none;
        background:#f8fafc; color:#64748b; transition:background 0.15s; }
    .bloque-tab.active { background:#fff; color:#0f9488; font-weight:700; border-color:#0f9488 #0f9488 #fff; }
    .dark .bloque-tab { background:#1e293b; border-color:#334155; color:#94a3b8; }
    .dark .bloque-tab.active { background:#0f172a; color:#2dd4bf; border-color:#0d9488 #0d9488 #0f172a; }
    .bloque-content { display:none; }
    .bloque-content.active { display:block; }

    /* ── Resultado MC ── */
    .resultado-card { border-radius:0.75rem; padding:1rem 1.25rem; border:1px solid; }
    .resultado-p50 { background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
    .resultado-p80 { background:#f0fdf4; border-color:#bbf7d0; color:#15803d; }
    .resultado-p90 { background:#fff7ed; border-color:#fed7aa; color:#c2410c; }
    .dark .resultado-p50 { background:#1e3a5f; border-color:#1d4ed8; color:#93c5fd; }
    .dark .resultado-p80 { background:#14532d; border-color:#15803d; color:#86efac; }
    .dark .resultado-p90 { background:#431407; border-color:#c2410c; color:#fdba74; }

    /* ── Spinner ── */
    .tc-spinner { display:inline-block; width:1.25rem; height:1.25rem; border:2px solid #e2e8f0;
        border-top-color:#0f9488; border-radius:50%; animation:tc-spin 0.7s linear infinite; }
    @@keyframes tc-spin { to { transform:rotate(360deg); } }

    /* ── Sticky table header ── */
    .tc-table-wrap { overflow-x:auto; max-height:60vh; overflow-y:auto; }
    .tc-table thead th { position:sticky; top:0; z-index:1; }
</style>
}

<div class="flex" style="min-height:calc(100vh - 3.5rem)">

@* ══════════════════════════ SIDEBAR ══════════════════════════════════ *@
<aside id="tc-sidebar" class="w-56 flex-shrink-0 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-700 flex flex-col sticky top-0" style="height:calc(100vh - 3.5rem); overflow-y:auto">

    <div class="flex items-center justify-between px-3 py-3 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
        <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 rounded-lg bg-teal-100 dark:bg-teal-900/40 flex items-center justify-center flex-shrink-0">
                <span class="material-icons text-teal-600 dark:text-teal-400" style="font-size:16px">analytics</span>
            </div>
            <span class="tc-sb-label text-sm font-bold text-slate-800 dark:text-slate-100 truncate">Taller Costos</span>
        </div>
        <button type="button" onclick="tcToggleSidebar()"
                class="flex-shrink-0 p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 transition-colors"
                title="Minimizar sidebar">
            <span class="material-icons text-base" id="tc-sidebar-icon">chevron_left</span>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-2 px-2 space-y-0.5">

        <p class="tc-sb-group px-2 pt-1 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Dashboard</p>

        <button type="button" class="step-btn" data-section="resumen" onclick="tcNav('resumen')">
            <span class="material-icons step-icon">insights</span>
            <span class="tc-sb-label">Resumen Global</span>
        </button>

        <p class="tc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Proyecto</p>

        <button type="button" class="step-btn" data-section="proyectos" onclick="tcNav('proyectos')">
            <span class="material-icons step-icon">folder_open</span>
            <span class="tc-sb-label">Mis Proyectos</span>
        </button>
        <button type="button" class="step-btn" data-section="proyecto" onclick="tcNav('proyecto')">
            <span class="material-icons step-icon">edit_note</span>
            <span class="tc-sb-label">Datos Proyecto</span>
        </button>
        <button type="button" class="step-btn" data-section="empresas" onclick="tcNav('empresas')">
            <span class="material-icons step-icon">business</span>
            <span class="tc-sb-label">Empresas</span>
        </button>
        <button type="button" class="step-btn" data-section="contratos" onclick="tcNav('contratos')">
            <span class="material-icons step-icon">receipt_long</span>
            <span class="tc-sb-label">Contratos</span>
            <span class="step-badge tc-sb-label" id="sb-contratos-count">0</span>
        </button>

        <div id="sb-contrato-items" class="hidden">
            <p class="tc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Contrato Activo</p>
            <button type="button" class="step-btn pl-5" data-section="bloqueA" onclick="tcNav('bloqueA')">
                <span class="material-icons step-icon text-sm" style="font-size:16px">table_chart</span>
                <span class="tc-sb-label">A — Resumen</span>
            </button>
            <button type="button" class="step-btn pl-5" data-section="bloqueB" onclick="tcNav('bloqueB')">
                <span class="material-icons step-icon text-sm" style="font-size:16px">list_alt</span>
                <span class="tc-sb-label">B — Ítems</span>
            </button>
            <button type="button" class="step-btn pl-5" data-section="bloqueD" onclick="tcNav('bloqueD')">
                <span class="material-icons step-icon text-sm" style="font-size:16px">bar_chart</span>
                <span class="tc-sb-label">D — V. de Costo</span>
            </button>
            <button type="button" class="step-btn pl-5" data-section="bloqueE" onclick="tcNav('bloqueE')">
                <span class="material-icons step-icon text-sm" style="font-size:16px">tune</span>
                <span class="tc-sb-label">E — Factores</span>
            </button>
            <button type="button" class="step-btn pl-5" data-section="bloqueF" onclick="tcNav('bloqueF')">
                <span class="material-icons step-icon text-sm" style="font-size:16px">category</span>
                <span class="tc-sb-label">F — Clasificación</span>
            </button>
        </div>

        <p class="tc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Análisis</p>

        <button type="button" class="step-btn" data-section="riesgos" onclick="tcNav('riesgos')">
            <span class="material-icons step-icon">warning_amber</span>
            <span class="tc-sb-label">Riesgos y Oportunidades</span>
        </button>
        <button type="button" class="step-btn" data-section="montecarlo" onclick="tcNav('montecarlo')">
            <span class="material-icons step-icon">casino</span>
            <span class="tc-sb-label">Análisis Monte Carlo</span>
        </button>

        <p class="tc-sb-group px-2 pt-2 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Referencia</p>

        <button type="button" class="step-btn" data-section="glosario" onclick="tcNav('glosario')">
            <span class="material-icons step-icon" style="color:#f59e0b">functions</span>
            <span class="tc-sb-label">Glosario de Fórmulas</span>
        </button>

    </nav>
</aside>

@* ══════════════════════════ MAIN ══════════════════════════════════════ *@
<main class="flex-1 min-w-0 overflow-y-auto bg-slate-50 dark:bg-slate-950">

    @* ─── PROYECTOS ──────────────────────────────────────────────────── *@
    <section id="tc-s-proyectos" class="tc-section p-6">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Taller de Rango de Costos</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Sistema de análisis probabilístico — CODELCO Vicepresidencia Proyectos</p>
            </div>
            <button class="btn-primary" onclick="tcAbrirModalProyecto()">
                <span class="material-icons text-base">add</span> Nuevo Proyecto
            </button>
        </div>
        <div id="tc-proyectos-lista" class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
            <div class="text-center py-10 text-slate-400 col-span-3">
                <div class="tc-spinner mx-auto mb-3"></div>
                <p class="text-sm">Cargando proyectos...</p>
            </div>
        </div>
    </section>

    @* ─── DATOS PROYECTO ─────────────────────────────────────────────── *@
    <section id="tc-s-proyecto" class="tc-section p-6 max-w-2xl">
        <div class="flex items-center gap-3 mb-5">
            <button class="btn-secondary" onclick="tcNav('proyectos')">
                <span class="material-icons text-base">arrow_back</span>
            </button>
            <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Datos del Proyecto</h2>
        </div>
        <div class="tc-card space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Nombre del Proyecto *</label>
                    <input id="proy-nombre" type="text" class="tc-input" placeholder="Ej: PROYECTO TOVE 4" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Código *</label>
                    <input id="proy-codigo" type="text" class="tc-input" placeholder="Ej: A22M451" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Fecha del Ejercicio *</label>
                    <input id="proy-fecha" type="date" class="tc-input" />
                </div>
                <div class="col-span-2">
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Organización</label>
                    <input id="proy-org" type="text" class="tc-input" placeholder="CODELCO - VICEPRESIDENCIA PROYECTOS" />
                </div>
            </div>
            <div class="flex gap-2 pt-2">
                <button class="btn-primary" onclick="tcGuardarProyecto()">
                    <span class="material-icons text-base">save</span> Guardar
                </button>
                <button class="btn-secondary" onclick="tcNav('contratos')">
                    Siguiente: Contratos <span class="material-icons text-base">arrow_forward</span>
                </button>
            </div>
        </div>
    </section>

    @* ─── RESUMEN GLOBAL ──────────────────────────────────────────────── *@
    <section id="tc-s-resumen" class="tc-section p-6">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.25rem;gap:1rem;flex-wrap:wrap;">
            <div>
                <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center gap-1">
                    Resumen Global del Proyecto
                    <span class="gpr-tt gpr-tt-right"><span class="material-icons gpr-tt-icon">help_outline</span><span class="gpr-tt-box">Vista consolidada de todos los contratos del proyecto: CAPEX total, EAT determinístico, resultado Monte Carlo (P50/P80/P90) y semáforo de cumplimiento presupuestario. Verde: EAT ≤ CAPEX; Ámbar: EAT entre 100-115% del CAPEX; Rojo: EAT &gt; 115% del CAPEX.</span></span>
                </h2>
                <p id="tc-resumen-subtitle" class="text-xs text-slate-500 dark:text-slate-400"></p>
            </div>
            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                <div class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5">
                    <span class="material-icons text-teal-500 flex-shrink-0" style="font-size:18px">folder_open</span>
                    <select id="tc-resumen-sel-proy"
                            class="tc-select border-0 bg-transparent p-0 text-sm font-medium text-slate-700 dark:text-slate-200 focus:outline-none min-w-[14rem]"
                            onchange="tcCambiarProyectoResumen(this.value)">
                        <option value="">— Selecciona un proyecto —</option>
                    </select>
                </div>
                <button class="btn-secondary" onclick="tcCargarResumen()" title="Actualizar" style="display:inline-flex;align-items:center;gap:0.375rem;">
                    <span class="material-icons text-base">refresh</span>
                </button>
                <button onclick="tcAbrirPdfResumen()" title="Generar Reporte PDF"
                        style="display:inline-flex;align-items:center;gap:0.375rem;padding:0.4rem 0.875rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:500;cursor:pointer;border:1px solid #cbd5e1;background:#fff;color:#475569;">
                    <span class="material-icons" style="font-size:1rem;">picture_as_pdf</span> Reporte PDF
                </button>
                <button onclick="tcAbrirPdfEjecutivoCod()" title="Informe ejecutivo CODELCO (compacto, para comité)"
                        style="display:inline-flex;align-items:center;gap:0.375rem;padding:0.4rem 0.875rem;border-radius:0.5rem;font-size:0.8125rem;font-weight:600;cursor:pointer;border:1px solid #e87722;background:linear-gradient(180deg,#fff8f0,#fff);color:#9a3412;">
                    <span class="material-icons" style="font-size:1rem;color:#e87722;">description</span> Informe ejecutivo CODELCO
                </button>
            </div>
        </div>
        <div id="tc-resumen-content">
            <div class="tc-card border-dashed border-slate-200 dark:border-slate-700 text-center py-16">
                <span class="material-icons text-5xl text-slate-200 dark:text-slate-700 mb-3 block">insights</span>
                <p class="text-sm font-semibold text-slate-400 dark:text-slate-500 mb-1">Sin datos todavía</p>
                <p class="text-xs text-slate-400 dark:text-slate-600">Selecciona un proyecto en el selector de arriba.</p>
            </div>
        </div>
    </section>

    @* ─── EMPRESAS CONTRATISTAS ───────────────────────────────────────── *@
    <section id="tc-s-empresas" class="tc-section p-6">
        <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
                <button class="btn-secondary" onclick="tcNav('proyecto')">
                    <span class="material-icons text-base">arrow_back</span>
                </button>
                <div>
                    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Empresas contratistas</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gestionadas por proyecto. Cada contrato se asocia a una empresa.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button class="btn-secondary flex items-center gap-1" type="button" onclick="tcCargarPanelEmpresas()" title="Actualizar">
                    <span class="material-icons text-base">refresh</span>
                </button>
                <button class="btn-primary" type="button" onclick="tcAbrirModalEmpresaNueva()">
                    <span class="material-icons text-base">add</span> Nueva empresa
                </button>
            </div>
        </div>
        <p id="tc-empresas-aviso" class="text-sm text-amber-700 dark:text-amber-400 mb-3 hidden"></p>
        <div id="tc-empresas-lista" class="space-y-2"></div>
    </section>

    @* ─── CONTRATOS ───────────────────────────────────────────────────── *@
    <section id="tc-s-contratos" class="tc-section p-6">
        @* Header *@
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
                <button class="btn-secondary" onclick="tcNav('proyecto')">
                    <span class="material-icons text-base">arrow_back</span>
                </button>
                <div>
                    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Contratos del Proyecto</h2>
                    <p id="tc-proyecto-header" class="text-xs text-slate-500 dark:text-slate-400"></p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button class="btn-secondary" type="button" onclick="tcNav('empresas')" title="Empresas">
                    <span class="material-icons text-base">business</span> Empresas
                </button>
                <button class="btn-primary" onclick="tcAbrirModalContrato()">
                <span class="material-icons text-base">add</span> Nuevo Contrato
            </button>
            </div>
        </div>
        @* KPI resumen — poblado por JS *@
        <div id="tc-contratos-kpi" class="hidden grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4"></div>
        @* Barra de búsqueda *@
        <div id="tc-contratos-toolbar" class="hidden flex items-center gap-2 mb-3">
            <div class="relative flex-1 max-w-xs">
                <span class="material-icons absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" style="font-size:16px">search</span>
                <input id="tc-contratos-search" type="text" placeholder="Buscar por código o nombre…"
                       oninput="tcFiltrarContratos()"
                       class="w-full pl-8 pr-3 py-1.5 text-sm rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-teal-400" />
            </div>
