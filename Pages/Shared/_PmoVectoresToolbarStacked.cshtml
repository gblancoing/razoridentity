@* Barra de filtros + modos vector/análisis para incrustar en Resumen (mismos id que Vectores Financiero). *@
@{
    var toolbarModo = ViewData["PmoVfToolbarModo"] as string;
    var resumenSoloCurvaS = string.Equals(toolbarModo, "ResumenCurvaS", StringComparison.OrdinalIgnoreCase);
}
<div class="space-y-4 w-full max-w-6xl mx-auto @(resumenSoloCurvaS ? "hidden" : "")" @(resumenSoloCurvaS ? "aria-hidden=\"true\"" : "")>
    <div id="vf-filtros-wrap" class="flex justify-center w-full @(resumenSoloCurvaS ? "hidden" : "")">
        <div class="rounded-xl border-2 border-blue-500/75 dark:border-blue-500/90 bg-sky-50/90 dark:bg-slate-900/95 shadow-sm px-2.5 py-2 sm:px-3 w-full max-w-3xl">
            <div class="flex flex-wrap items-end gap-x-2 gap-y-2">
                <div>
                    <label for="vf-sap-desc-top" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Descripción (filtro primario)</label>
                    <select id="vf-sap-desc-top" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[16rem] hidden">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div>
                    <label for="vf-desde" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Desde (mes)</label>
                    <input type="month" id="vf-desde" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[9.5rem]" />
                </div>
                <div>
                    <label for="vf-hasta" class="block text-[10px] font-semibold text-sky-800 dark:text-sky-300 mb-0.5">Hasta (mes)</label>
                    <input type="month" id="vf-hasta" class="rounded-md border border-sky-300 dark:border-sky-600 bg-white dark:bg-slate-900 px-2 py-1.5 text-xs w-[9.5rem]" />
                </div>
                <button type="button" id="vf-clear-fechas" class="p-1.5 rounded-md border border-sky-300 dark:border-sky-600 text-sky-700 dark:text-sky-300 hover:bg-sky-100 dark:hover:bg-slate-800 shrink-0" title="Limpiar fechas">
                    <span class="material-icons text-[18px]">cleaning_services</span>
                </button>
                <span id="vf-load" class="hidden inline-flex text-xs text-sky-800 dark:text-sky-200 items-center gap-1 shrink-0 pb-1.5"><span class="material-icons text-base animate-spin">progress_activity</span> Cargando…</span>
                <div id="vf-import-wrap" class="flex flex-wrap items-center gap-2 sm:ml-auto sm:grow-0 w-full sm:w-auto">
                    <button type="button" id="vf-import-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-amber-500 hover:bg-amber-600 text-white text-xs font-medium shadow-sm shrink-0">
                        <span class="material-icons text-[16px]">upload_file</span>
                        Importar tabla
                    </button>
                </div>
            </div>
        </div>
    </div>
    @if (!resumenSoloCurvaS)
    {
    <div class="flex justify-center w-full overflow-x-auto pb-0.5">
        <div class="rounded-xl border-2 border-red-400/70 dark:border-red-700/80 bg-white/95 dark:bg-slate-900/95 shadow-sm px-2 py-1.5 sm:px-3 max-w-full">
            <div class="flex flex-nowrap items-center gap-2 overflow-x-auto pb-0.5 justify-center sm:justify-end min-w-0">
                <span class="flex items-center text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 shrink-0 px-0.5">Vectores</span>
                @foreach (var m in PycFinancierosCatalog.ModosVectorBarraPmo)
                {
                    <button type="button" id="vf-mv-@m.Id" data-tabla="@m.Tabla" class="vf-mv-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-md text-xs font-medium border border-amber-400/90 bg-amber-50 text-amber-950 hover:bg-amber-100 dark:bg-amber-950/45 dark:border-amber-600 dark:text-amber-100 dark:hover:bg-amber-900/55 @(m.Id == "real_parcial" ? "ring-2 ring-amber-500 ring-offset-1 ring-offset-white dark:ring-offset-slate-900 bg-amber-100 dark:bg-amber-900/70" : "")">@m.Etiqueta</button>
                }
                <span class="w-px shrink-0 self-stretch min-h-[1.5rem] bg-slate-300 dark:bg-slate-600 mx-0.5" role="separator" aria-hidden="true"></span>
                <span class="flex items-center text-[10px] font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400 shrink-0 px-0.5">Análisis</span>
                @foreach (var m in PycFinancierosCatalog.ModosAnalisis)
                {
                    <button type="button" id="vf-ma-@m.Id" class="vf-ma-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-md text-xs font-medium border border-sky-500/80 bg-sky-50 text-sky-950 hover:bg-sky-100 dark:bg-sky-950/50 dark:border-sky-500 dark:text-sky-100 dark:hover:bg-sky-900/55">@m.Etiqueta</button>
                }
            </div>
        </div>
    </div>
    }
    @if (resumenSoloCurvaS)
    {
        @* Ancla para activar modo reporte1 sin barra visible (wireUi + click programático). *@
        <button type="button" id="vf-ma-reporte1" tabindex="-1" class="vf-ma-btn fixed w-px h-px p-0 m-0 overflow-hidden opacity-0 pointer-events-none" aria-hidden="true" data-tabla="reporte1">Curva S</button>
    }
</div>
