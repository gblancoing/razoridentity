<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GPR</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorIdentity.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }</style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        "codelco-orange": "#FF671B",
                        "off-white": "#F3F4F6",
                        "ritweb-teal": "#0D9488",
                    },
                    fontFamily: { "sans": ["Inter", "sans-serif"] },
                },
            },
        }
    </script>
    <script>
        (function () {
            try {
                // Por defecto tema claro: solo activar oscuro si el usuario lo eligió explícitamente
                if (localStorage.getItem('ritweb-dark') === '1') document.documentElement.classList.add('dark');
            } catch (e) {}
        })();
    </script>
    @await RenderSectionAsync("Head", required: false)
    <style>
        /* ── Sistema de tooltips GPR ─────────────────────────────────────── */
        .gpr-tt { position: relative; display: inline-flex; align-items: center; cursor: help; }
        .gpr-tt .gpr-tt-icon {
            font-size: 13px !important; color: #94a3b8; margin-left: 3px;
            vertical-align: middle; flex-shrink: 0; transition: color 0.15s;
        }
        .gpr-tt:hover .gpr-tt-icon { color: #0d9488; }
        .gpr-tt .gpr-tt-box {
            visibility: hidden; opacity: 0;
            background: #1e293b; color: #f8fafc;
            font-size: 0.72rem; line-height: 1.55; font-weight: 400;
            padding: 0.5rem 0.75rem; border-radius: 0.5rem;
            width: 230px; max-width: 90vw;
            position: absolute; z-index: 9999;
            bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
            box-shadow: 0 4px 16px rgba(0,0,0,0.28);
            transition: opacity 0.15s; pointer-events: none;
            white-space: normal; text-align: left;
        }
        .gpr-tt .gpr-tt-box::after {
            content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
            border: 5px solid transparent; border-top-color: #1e293b;
        }
        .gpr-tt:hover .gpr-tt-box { visibility: visible; opacity: 1; }
        /* Variante alineada a la derecha (tooltip cerca del borde izquierdo) */
        .gpr-tt.gpr-tt-right .gpr-tt-box { left: 0; transform: none; }
        .gpr-tt.gpr-tt-right .gpr-tt-box::after { left: 12px; transform: none; }
        /* Variante alineada a la izquierda (tooltip cerca del borde derecho) */
        .gpr-tt.gpr-tt-left .gpr-tt-box { left: auto; right: 0; transform: none; }
        .gpr-tt.gpr-tt-left .gpr-tt-box::after { left: auto; right: 12px; transform: none; }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-white dark:bg-slate-900 antialiased transition-colors">
    <header class="sticky top-0 z-50 w-full">
        <nav id="main-nav" class="relative bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200 dark:border-slate-700 shadow-sm transition-colors duration-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center lg:h-14 xl:h-16">
                    <div class="flex justify-between items-center h-14 md:h-16 lg:h-14 xl:h-16 w-full lg:w-auto">
