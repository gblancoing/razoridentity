                    <button type="button" class="chat-widget-suggested-btn rounded-lg border border-ritweb-teal/40 bg-ritweb-teal/5 hover:bg-ritweb-teal/15 dark:bg-ritweb-teal/10 dark:hover:bg-ritweb-teal/20 text-slate-700 dark:text-slate-200 text-xs px-2.5 py-1.5 transition-colors text-left max-w-full" data-prompt="¿Cuántas alertas se cerraron este mes?" data-specialist="analytics">¿Cuántas alertas se cerraron este mes?</button>
                    <button type="button" class="chat-widget-suggested-btn rounded-lg border border-ritweb-teal/40 bg-ritweb-teal/5 hover:bg-ritweb-teal/15 dark:bg-ritweb-teal/10 dark:hover:bg-ritweb-teal/20 text-slate-700 dark:text-slate-200 text-xs px-2.5 py-1.5 transition-colors text-left max-w-full" data-prompt="¿Cuántas alertas hay abiertas actualmente?" data-specialist="analytics">¿Cuántas alertas hay abiertas?</button>
                    <button type="button" class="chat-widget-suggested-btn rounded-lg border border-ritweb-teal/40 bg-ritweb-teal/5 hover:bg-ritweb-teal/15 dark:bg-ritweb-teal/10 dark:hover:bg-ritweb-teal/20 text-slate-700 dark:text-slate-200 text-xs px-2.5 py-1.5 transition-colors text-left max-w-full" data-prompt="Dame un resumen de eventos por sector" data-specialist="analytics">Resumen de eventos por sector</button>
                    <button type="button" class="chat-widget-suggested-btn rounded-lg border border-ritweb-teal/40 bg-ritweb-teal/5 hover:bg-ritweb-teal/15 dark:bg-ritweb-teal/10 dark:hover:bg-ritweb-teal/20 text-slate-700 dark:text-slate-200 text-xs px-2.5 py-1.5 transition-colors text-left max-w-full" data-prompt="Tendencias de alertas por criticidad" data-specialist="analytics">Tendencias por criticidad</button>
                    <button type="button" class="chat-widget-suggested-btn rounded-lg border border-ritweb-teal/40 bg-ritweb-teal/5 hover:bg-ritweb-teal/15 dark:bg-ritweb-teal/10 dark:hover:bg-ritweb-teal/20 text-slate-700 dark:text-slate-200 text-xs px-2.5 py-1.5 transition-colors text-left max-w-full" data-prompt="¿Cuántos eventos tipo Alerta se registraron este año?" data-specialist="analytics">Alertas registradas este año</button>
