@page "/suscripciones/{Id:guid}"
@inject PaymentGatewayAdminClient Client
@inject Payments.App.Services.PaymentsAuthStateService AuthState

<PageTitle>Detalle de suscripción - Payments.App</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar la suscripción" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else if (_isLoading)
{
    <section class="panel-card">
        <LoadingPanel Message="Cargando suscripción…" />
    </section>
}
else if (_subscription is null)
{
    <section class="not-found-card">
        <p class="eyebrow">Suscripciones</p>
        <h1>No encontramos esta suscripción</h1>
        <p>Verifica el identificador o vuelve al listado.</p>
        <a class="primary-link" href="/suscripciones">Volver a suscripciones</a>
    </section>
}
else
{
    <PageHeader Eyebrow="Suscripción"
                Title="@(_subscription.PlanName ?? "Plan recurrente")"
                Description="@($"Cliente {_subscription.CustomerId} · {_subscription.ExternalReference}")">
        <Actions>
            @if (AuthState.IsOperator)
            {
                @if (_subscription.Status == "active")
                {
                    <button class="btn btn-ghost" type="button" @onclick="OpenPause">
                        <span class="material-symbols-outlined">pause</span>
                        Pausar
                    </button>
                }
                @if (_subscription.Status == "paused")
                {
                    <button class="btn btn-primary" type="button" @onclick="OpenResume">
                        <span class="material-symbols-outlined">play_arrow</span>
                        Reanudar
                    </button>
                }
                @if (_subscription.Status != "cancelled")
                {
                    <button class="btn btn-danger" type="button" @onclick="OpenCancel">
                        <span class="material-symbols-outlined">cancel</span>
                        Cancelar suscripción
                    </button>
                }
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <section class="panel-card">
            <p class="text-sm">@_actionMessage</p>
        </section>
    }

    <section class="detail-grid">
        <article class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Resumen</p>
                    <h2>Datos del plan</h2>
                </div>
                <StatusBadge Status="@_subscription.Status" Label="@StatusLabel(_subscription.Status)" />
            </div>
            <dl class="detail-list">
                <div><dt>Monto</dt><dd>@_subscription.Amount.ToString("C0", Cl) @_subscription.Currency</dd></div>
                <div><dt>Proveedor</dt><dd>@_subscription.Provider</dd></div>
                <div><dt>Frecuencia</dt><dd>@IntervalLabel(_subscription.BillingInterval)</dd></div>
                <div><dt>Próximo cobro</dt><dd>@(_subscription.NextChargeAt?.ToLocalTime().ToString("dd MMM yyyy", Cl) ?? "—")</dd></div>
                <div><dt>Creada</dt><dd>@_subscription.CreatedAt.ToLocalTime().ToString("dd MMM yyyy", Cl)</dd></div>
                @if (_subscription.CancelledAt.HasValue)
                {
                    <div><dt>Cancelada</dt><dd>@_subscription.CancelledAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm", Cl)</dd></div>
                }
                <div><dt>Token de cliente</dt><dd>@(_subscription.CustomerTokenId?.ToString() ?? "Sin token enrolado")</dd></div>
            </dl>
        </article>

        <article class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Historial</p>
                    <h2>Intentos de cobro</h2>
                </div>
            </div>
            @if (_subscription.Attempts.Count == 0)
            {
                <EmptyState Title="Sin intentos" Description="Aún no hay intentos de cobro registrados." />
            }
            else
            {
                <div class="event-timeline">
                    @foreach (var attempt in _subscription.Attempts)
                    {
                        <div class="event-item">
                            <div class="event-dot"></div>
                            <div>
                                <p class="row-title">
                                    <StatusBadge Status="@attempt.Status" />
                                </p>
                                <p class="row-subtitle">@attempt.AttemptedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm", Cl)</p>
                                @if (!string.IsNullOrWhiteSpace(attempt.ErrorMessage))
                                {
                                    <p class="row-subtitle text-danger">@attempt.ErrorMessage</p>
                                }
                                @if (attempt.IntentId.HasValue)
                                {
                                    <a class="primary-link" href="@($"/transacciones/{attempt.IntentId}")">Ver transacción</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <ConfirmDialog @bind-IsOpen="_dialogOpen"
                   Title="@DialogTitle"
                   Message="@DialogMessage"
                   ConfirmText="Confirmar"
                   Danger="@(_pendingAction == "cancel")"
                   IsBusy="_isWorking"
                   OnConfirm="SubmitActionAsync" />
}

@code {
    private static readonly CultureInfo Cl = CultureInfo.GetCultureInfo("es-CL");

    [Parameter] public Guid Id { get; set; }

    private AdminSubscriptionDetailDto? _subscription;
    private bool _isLoading = true;
    private bool _dialogOpen;
    private bool _isWorking;
    private string _pendingAction = string.Empty;
    private string? _actionMessage;
    private string? _error;

    private string DialogTitle => _pendingAction switch
    {
        "cancel" => "Cancelar suscripción",
        "pause" => "Pausar suscripción",
        _ => "Reanudar suscripción"
    };

    private string DialogMessage => _pendingAction switch
    {
        "cancel" => "La cancelación es definitiva: la suscripción no podrá reactivarse.",
        "pause" => "No se generarán nuevos cobros mientras esté pausada.",
        _ => "La suscripción volverá a generar cobros según su frecuencia."
    };

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _subscription = await Client.GetSubscriptionAsync(Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCancel() => OpenDialog("cancel");

    private void OpenPause() => OpenDialog("pause");

    private void OpenResume() => OpenDialog("resume");

    private void OpenDialog(string action)
    {
        _pendingAction = action;
        _dialogOpen = true;
    }

    private async Task SubmitActionAsync()
    {
        _isWorking = true;

        try
        {
            switch (_pendingAction)
            {
                case "cancel":
                    await Client.CancelSubscriptionAsync(Id);
                    _actionMessage = "Suscripción cancelada.";
                    break;
                case "pause":
                    await Client.PauseSubscriptionAsync(Id);
                    _actionMessage = "Suscripción pausada.";
                    break;
                default:
                    await Client.ResumeSubscriptionAsync(Id);
                    _actionMessage = "Suscripción reanudada.";
                    break;
            }

            _dialogOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"No se pudo completar la acción: {ex.Message}";
        }
        finally
        {
            _isWorking = false;
        }
    }

    private static string IntervalLabel(string interval) => interval.ToLowerInvariant() switch
    {
        "monthly" => "Mensual",
        "weekly" => "Semanal",
        "yearly" => "Anual",
        _ => interval
    };

    private static string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "active" => "Activa",
        "paused" => "Pausada",
        "past_due" => "Con deuda",
        "cancelled" => "Cancelada",
        "expired" => "Expirada",
        _ => status
    };
}
