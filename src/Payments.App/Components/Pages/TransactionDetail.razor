@page "/transacciones/{Id:guid}"
@inject PaymentGatewayAdminClient Client
@inject Payments.App.Services.PaymentsAuthStateService AuthState

<PageTitle>Detalle de transacción - Payments.App</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar la transacción" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else if (_isLoading)
{
    <section class="panel-card">
        <LoadingPanel Message="Cargando detalle del pago…" />
    </section>
}
else if (_intent is null)
{
    <section class="not-found-card">
        <p class="eyebrow">Transacciones</p>
        <h1>No encontramos esta transacción</h1>
        <p>Verifica el identificador o vuelve al listado.</p>
        <a class="primary-link" href="/transacciones">Volver a transacciones</a>
    </section>
}
else
{
    <PageHeader Eyebrow="Detalle de transacción"
                Title="@_intent.ExternalReference"
                Description="@HeaderDescription">
        <Actions>
            @if (AuthState.IsOperator)
            {
                <button class="btn btn-primary" type="button" disabled="@_isNotifying" @onclick="NotifyCoreAsync">
                    <span class="material-symbols-outlined">sync</span>
                    @(_isNotifying ? "Notificando…" : "Reintentar notificación a Core")
                </button>
                @if (_intent.ReviewStatus == "flagged")
                {
                    <button class="btn btn-ghost" type="button" @onclick="OpenResolve">
                        <span class="material-symbols-outlined">task_alt</span>
                        Marcar como resuelta
                    </button>
                }
                else
                {
                    <button class="btn btn-danger" type="button" @onclick="OpenFlag">
                        <span class="material-symbols-outlined">flag</span>
                        Marcar para revisión
                    </button>
                }
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <section class="panel-card">
            <p class="text-sm">@_actionMessage</p>
        </section>
    }

    <section class="detail-grid">
        <article class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Resumen</p>
                    <h2>Datos del pago</h2>
                </div>
                <StatusBadge Status="@_intent.Status" Label="@StatusLabel(_intent.Status)" />
            </div>
            <dl class="detail-list">
                <div><dt>Monto</dt><dd>@_intent.Amount.ToString("C0", Cl) @_intent.Currency</dd></div>
                <div><dt>Proveedor</dt><dd>@_intent.Provider</dd></div>
                <div><dt>Token del proveedor</dt><dd>@(_intent.ProviderToken ?? "—")</dd></div>
                <div><dt>Código de autorización</dt><dd>@(_intent.AuthorizationCode ?? "—")</dd></div>
                <div><dt>Creado</dt><dd>@_intent.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss", Cl)</dd></div>
                <div><dt>Actualizado</dt><dd>@_intent.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss", Cl)</dd></div>
                @if (!string.IsNullOrWhiteSpace(_intent.ReviewStatus))
                {
                    <div><dt>Revisión</dt><dd>@(_intent.ReviewStatus == "flagged" ? "Marcada para revisión" : "Resuelta")</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(_intent.ReviewNote))
                {
                    <div><dt>Nota de revisión</dt><dd>@_intent.ReviewNote</dd></div>
                }
            </dl>
            <div class="mt-4">
                <JsonViewer Title="Respuesta cruda del proveedor" Json="@_intent.RawResponse" />
            </div>
        </article>

        <article class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Core</p>
                    <h2>Notificación a ComunaClic</h2>
                </div>
            </div>
            <dl class="detail-list">
                <div>
                    <dt>Última notificación</dt>
                    <dd>@(_intent.CoreNotifiedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss", Cl) ?? "Sin registro")</dd>
                </div>
                <div><dt>Reintentos manuales</dt><dd>@_intent.CoreNotifyAttempts</dd></div>
            </dl>
            <p class="row-subtitle mt-4">
                El reintento reenvía el estado actual del pago al webhook interno del Core y queda
                registrado como evento core.notify.retry en el timeline.
            </p>
        </article>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Timeline</p>
                <h2>Eventos del proveedor</h2>
            </div>
        </div>
        @if (_intent.Events.Count == 0)
        {
            <EmptyState Title="Sin eventos" Description="Este intent aún no registra eventos del proveedor." />
        }
        else
        {
            <div class="event-timeline">
                @foreach (var evt in _intent.Events)
                {
                    <div class="event-item">
                        <div class="event-dot"></div>
                        <div>
                            <p class="row-title">@evt.EventType</p>
                            <p class="row-subtitle">@evt.ReceivedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss", Cl) · @evt.ProviderEventId</p>
                            <JsonViewer Title="Payload" Json="@evt.Payload" />
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <ConfirmDialog @bind-IsOpen="_reviewOpen"
                   Title="@ReviewTitle"
                   Message="@ReviewMessage"
                   ConfirmText="Confirmar"
                   Danger="@(_reviewStatus == "flagged")"
                   IsBusy="_isReviewing"
                   OnConfirm="SubmitReviewAsync">
        <div class="filter-field mt-4">
            <label>Nota (opcional)</label>
            <textarea class="filter-input" @bind="_reviewNote"></textarea>
        </div>
    </ConfirmDialog>
}

@code {
    private static readonly CultureInfo Cl = CultureInfo.GetCultureInfo("es-CL");

    [Parameter] public Guid Id { get; set; }

    private AdminPaymentIntentDetailDto? _intent;
    private bool _isLoading = true;
    private bool _isNotifying;
    private bool _reviewOpen;
    private bool _isReviewing;
    private string _reviewStatus = "flagged";
    private string _reviewNote = string.Empty;
    private string? _actionMessage;
    private string? _error;

    private string HeaderDescription => _intent is null
        ? string.Empty
        : $"Pago vía {_intent.Provider} creado el {_intent.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm", Cl)}.";

    private string ReviewTitle => _reviewStatus == "flagged" ? "Marcar para revisión" : "Marcar como resuelta";

    private string ReviewMessage => _reviewStatus == "flagged"
        ? "La transacción quedará destacada en conciliación hasta que alguien la resuelva."
        : "La transacción dejará de aparecer como pendiente de revisión.";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _intent = await Client.GetTransactionDetailAsync(Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task NotifyCoreAsync()
    {
        _isNotifying = true;
        _actionMessage = null;

        try
        {
            await Client.NotifyCoreAsync(Id);
            _actionMessage = "Notificación reenviada al Core. El reintento quedó registrado en el timeline.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"No se pudo reenviar la notificación: {ex.Message}";
        }
        finally
        {
            _isNotifying = false;
        }
    }

    private void OpenFlag() => OpenReview("flagged");

    private void OpenResolve() => OpenReview("resolved");

    private void OpenReview(string status)
    {
        _reviewStatus = status;
        _reviewNote = _intent?.ReviewNote ?? string.Empty;
        _reviewOpen = true;
    }

    private async Task SubmitReviewAsync()
    {
        _isReviewing = true;

        try
        {
            await Client.ReviewAsync(Id, _reviewStatus, string.IsNullOrWhiteSpace(_reviewNote) ? null : _reviewNote);
            _reviewOpen = false;
            _actionMessage = _reviewStatus == "flagged"
                ? "La transacción quedó marcada para revisión."
                : "La transacción quedó marcada como resuelta.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"No se pudo actualizar la revisión: {ex.Message}";
        }
        finally
        {
            _isReviewing = false;
        }
    }

    private static string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "captured" or "approved" => "Capturado",
        "pending" => "Pendiente",
        "failed" or "rejected" => "Fallido",
        "canceled" or "cancelled" => "Cancelado",
        "expired" => "Expirado",
        _ => status
    };
}
