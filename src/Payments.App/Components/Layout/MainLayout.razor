@inherits LayoutComponentBase
@inject Payments.App.Services.PaymentsAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

@if (!AuthState.IsInitialized)
{
    <div class="admin-shell">
        <main class="content-shell">
            <article class="page-body">
                <section class="not-found-card">
                    <p class="eyebrow">Payments.App</p>
                    <h1>Cargando sesión segura</h1>
                    <p>Estamos verificando tu acceso al dashboard de pagos.</p>
                </section>
            </article>
        </main>
    </div>
}
else if (!AuthState.IsAuthenticated || !AuthState.IsViewer)
{
    <div class="admin-shell">
        <main class="content-shell">
            <article class="page-body">
                <section class="not-found-card">
                    <p class="eyebrow">Payments.App</p>
                    <h1>Acceso restringido</h1>
                    <p>Necesitas el rol <strong>payments.viewer</strong> o superior para acceder a este panel.</p>
                </section>
            </article>
        </main>
    </div>
}
else
{
    <AdminShell BrandInitials="CC"
                BrandTitle="Payments.App"
                BrandSubtitle="Pagos y suscripciones"
                TopbarLabel="ComunaClic"
                TopbarTitle="Monitoreo de pagos y suscripciones"
                FooterLabel="@(AuthState.IsPaymentsAdmin ? "Acceso" : "Estado")"
                FooterValue="@(AuthState.IsPaymentsAdmin ? "Admin autorizado" : "Sin permisos admin")"
                UserDisplay="@(AuthState.Tokens?.DisplayName ?? AuthState.Tokens?.Email ?? "Operador Payments")"
                NavItems="_navItems"
                OnLogout="Logout">
        <Body>
            @Body
        </Body>
    </AdminShell>
}

@code {
    private static readonly IReadOnlyList<AdminNavItem> _navItems = new[]
    {
        new AdminNavItem("/", "dashboard", "Dashboard", MatchAll: true),
        new AdminNavItem("/transacciones", "receipt_long", "Transacciones"),
        new AdminNavItem("/suscripciones", "sync", "Suscripciones")
    };

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthState.InitializeAsync();
        EnsureAuthenticated();
    }

    private void HandleAuthChange()
    {
        EnsureAuthenticated();
        InvokeAsync(StateHasChanged);
    }

    private void EnsureAuthenticated()
    {
        if (!AuthState.IsInitialized) return;
        if (AuthState.IsAuthenticated && AuthState.IsViewer) return;

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
    }

    private async Task Logout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
    }
}
