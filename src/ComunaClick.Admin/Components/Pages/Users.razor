@page "/usuarios"
@inject ComunaClick.Admin.Services.AdminAclManagementClient Client

<PageTitle>Usuarios - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Acceso"
            Title="Usuarios administrativos"
            Description="Activa, desactiva y resetea contraseñas de cuentas que operan sobre ACL." />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar usuarios" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">Usuarios</p><h2>Listado</h2></div></div>
        @if (_isLoading)
        {
            <LoadingPanel Message="Cargando usuarios…" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState Title="Sin usuarios" Description="No hay usuarios administrativos registrados." />
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="row-card">
                    <div>
                        <p class="row-title">@(item.DisplayName ?? item.Email)</p>
                        <p class="row-subtitle">@item.Email · @string.Join(", ", item.Roles)</p>
                    </div>
                    <div style="display:flex;align-items:center;gap:0.75rem">
                        <StatusBadge Status="@(item.IsActive ? "active" : "inactive")"
                                     Label="@(item.IsActive ? "Activo" : "Inactivo")" />
                        <button class="btn btn-ghost" type="button" @onclick="() => ToggleAsync(item)">
                            @(item.IsActive ? "Desactivar" : "Activar")
                        </button>
                        <button class="btn btn-ghost" type="button" @onclick="() => ShowReset(item.Id)">
                            Resetear clave
                        </button>
                    </div>
                </div>

                @if (_resetUserId == item.Id)
                {
                    <div class="panel-card" style="margin:0.5rem 0 1rem">
                        <label class="kpi-label">Nueva contraseña</label>
                        <input class="filter-input" type="password" @bind="_newPassword" />
                        <div style="display:flex;gap:0.75rem;margin-top:1rem">
                            <button class="btn btn-primary" type="button" @onclick="() => ResetAsync(item.Id)">Guardar</button>
                            <button class="btn btn-ghost" type="button" @onclick="CancelReset">Cancelar</button>
                        </div>
                    </div>
                }
            }
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <section class="panel-card">
        <p class="text-sm">@_statusMessage</p>
    </section>
}

@code {
    private IReadOnlyList<ComunaClick.Admin.Models.AdminUserDto> _items = Array.Empty<ComunaClick.Admin.Models.AdminUserDto>();
    private bool _isLoading = true;
    private string? _error;
    private string? _statusMessage;
    private Guid? _resetUserId;
    private string _newPassword = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _items = await Client.GetUsersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleAsync(ComunaClick.Admin.Models.AdminUserDto item)
    {
        await Client.ToggleUserActiveAsync(item.Id, !item.IsActive);
        _statusMessage = item.IsActive ? "Usuario desactivado." : "Usuario activado.";
        await LoadAsync();
    }

    private void ShowReset(Guid id)
    {
        _resetUserId = id;
        _newPassword = string.Empty;
    }

    private void CancelReset()
    {
        _resetUserId = null;
        _newPassword = string.Empty;
    }

    private async Task ResetAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 8)
        {
            _statusMessage = "La nueva contraseña debe tener al menos 8 caracteres.";
            return;
        }
        await Client.ResetPasswordAsync(id, _newPassword);
        _statusMessage = "Contraseña restablecida correctamente.";
        CancelReset();
    }
}
