@page "/configuracion"
@inject IConfiguration Configuration

<PageTitle>Configuración - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Sistema"
            Title="Configuración operativa"
            Description="Vista rápida de endpoints y dependencias principales del panel admin." />

<section class="detail-grid">
    <article class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">ACL</p><h2>Autenticación</h2></div></div>
        <p class="row-subtitle">@Configuration["Acl:BaseUrl"]</p>
    </article>
    <article class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">API</p><h2>Backoffice</h2></div></div>
        <p class="row-subtitle">@Configuration["AdminApi:BaseUrl"]</p>
    </article>
    <article class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">Payments</p><h2>Panel de pagos</h2></div></div>
        <p class="row-subtitle">@Configuration["AdminApi:PaymentsAppUrl"]</p>
    </article>
</section>
