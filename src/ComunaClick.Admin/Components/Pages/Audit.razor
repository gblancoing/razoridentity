@page "/auditoria"
@inject ComunaClick.Admin.Services.AdminApiClient Client

<PageTitle>Auditoría - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Trazabilidad"
            Title="Actividad reciente"
            Description="Cambios sobre tenants, partners, órdenes y otros recursos. Expande un evento para ver los valores anteriores y nuevos." />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar auditoría" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">Auditoría</p><h2>Timeline</h2></div></div>
        @if (_items is null)
        {
            <LoadingPanel Message="Cargando eventos…" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState Title="Sin eventos" Description="Aún no hay actividad registrada." />
        }
        else
        {
            <div class="event-timeline">
                @foreach (var item in _items)
                {
                    <div class="event-item">
                        <div class="event-dot"></div>
                        <div>
                            <p class="row-title">@item.Description</p>
                            <p class="row-subtitle">
                                <StatusBadge Status="@ActionKind(item.Action)" Label="@item.Action" />
                                &nbsp;@item.EntityType · @item.EntityId
                            </p>
                            <p class="row-subtitle">@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                            @if (!string.IsNullOrWhiteSpace(item.PreviousValues) && item.PreviousValues != "null")
                            {
                                <JsonViewer Title="Valores anteriores" Json="@item.PreviousValues" />
                            }
                            @if (!string.IsNullOrWhiteSpace(item.NewValues) && item.NewValues != "null")
                            {
                                <JsonViewer Title="Valores nuevos" Json="@item.NewValues" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private List<ComunaClick.Admin.Models.AdminAuditEventDto>? _items;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _items = await Client.GetAuditAsync() ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string ActionKind(string action) => action?.ToLowerInvariant() switch
    {
        "create" or "created" => "active",
        "delete" or "deleted" => "failed",
        "update" or "updated" or "patch" => "pending",
        _ => "neutral"
    };
}
