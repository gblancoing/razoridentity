@page "/partners"
@inject ComunaClick.Admin.Services.AdminApiClient Client

<PageTitle>Partners - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Vitrina pública"
            Title="Partners y visibilidad"
            Description="Revisa datos visibles, contacto, publicación y comisiones de cada negocio registrado." />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar partners" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else
{
    <!-- Comisiones Marketplace -->
    <section class="panel-card" style="margin-bottom:1.5rem">
        <div class="panel-head">
            <div><p class="eyebrow">Marketplace</p><h2>Comisiones ComunaClic</h2></div>
        </div>
        <p class="page-description" style="margin-bottom:1rem">
            Configura el porcentaje de comisión que ComunaClic cobra sobre cada venta procesada por Mercado Pago.
            La comisión de MP (~3.19%) se suma aparte y la paga el vendedor directamente a MP.
        </p>
        <div style="display:flex;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
            <div class="filter-field">
                <label>% Comisión ComunaClic (todos los vendedores)</label>
                <input class="filter-input" type="number" step="0.01" min="0" max="30" style="width:140px" @bind="_globalFeePercent" />
            </div>
            <div class="filter-field">
                <label>Tarifa fija ($)</label>
                <input class="filter-input" type="number" step="1" min="0" style="width:120px" @bind="_globalFixedFee" />
            </div>
            <button class="btn btn-primary" type="button" disabled="@_feesBusy" @onclick="ApplyGlobalFeeAsync">
                @(_feesBusy ? "Aplicando…" : "Aplicar a todos")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_feesMessage))
        {
            <p class="text-sm" style="color:@(_feesOk ? "var(--color-primary)" : "var(--status-error-fg)")">@_feesMessage</p>
        }
        @if (_fees is not null && _fees.Count > 0)
        {
            <div class="table-scroll" style="margin-top:0.75rem">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vendedor</th>
                            <th style="text-align:right">% Comisión</th>
                            <th style="text-align:right">Tarifa fija</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fee in _fees)
                        {
                            <tr>
                                <td class="cell-title">@fee.SellerName</td>
                                <td style="text-align:right">
                                    @if (_editingFeeId == fee.SellerId)
                                    {
                                        <input class="filter-input" type="number" step="0.01" min="0" max="30"
                                               style="width:90px;text-align:right" @bind="_editFeePercent" />
                                    }
                                    else { <span>@fee.PercentageFee.ToString("N2")%</span> }
                                </td>
                                <td style="text-align:right">
                                    @if (_editingFeeId == fee.SellerId)
                                    {
                                        <input class="filter-input" type="number" step="1" min="0"
                                               style="width:90px;text-align:right" @bind="_editFixedFee" />
                                    }
                                    else { <span>$@fee.FixedFeeAmount.ToString("N0")</span> }
                                </td>
                                <td style="text-align:right">
                                    @if (_editingFeeId == fee.SellerId)
                                    {
                                        <button class="btn btn-primary" type="button" @onclick="() => SaveSellerFeeAsync(fee.SellerId)">Guardar</button>
                                        <button class="btn btn-ghost" type="button" @onclick="CancelFeeEdit" style="margin-left:8px">Cancelar</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-ghost" type="button" @onclick="() => BeginFeeEdit(fee)">Editar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Partners / visibilidad -->
    <section class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">Partners</p><h2>Moderación</h2></div></div>
        @if (_items is null)
        {
            <LoadingPanel Message="Cargando partners…" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState Title="Sin partners" Description="No hay negocios registrados." />
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="row-card">
                    <div>
                        <p class="row-title">@item.Name</p>
                        <p class="row-subtitle">@item.CategoryName / @item.SubcategoryName</p>
                    </div>
                    <div style="display:flex;align-items:center;gap:0.75rem">
                        <StatusBadge Status="@(item.IsVisible ? "active" : "inactive")"
                                     Label="@(item.IsVisible ? "Publicado" : "Oculto")" />
                        <button class="btn btn-ghost" type="button" @onclick="() => BeginEdit(item)">Editar</button>
                    </div>
                </div>

                @if (_editingId == item.Id)
                {
                    <div class="panel-card" style="margin:0.5rem 0 1rem">
                        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1rem">
                            <div class="filter-field"><label>Nombre</label><input class="filter-input" @bind="_name" /></div>
                            <div class="filter-field"><label>Dirección</label><input class="filter-input" @bind="_address" /></div>
                            <div class="filter-field"><label>Teléfono</label><input class="filter-input" @bind="_phone" /></div>
                            <div class="filter-field"><label>Email</label><input class="filter-input" @bind="_email" /></div>
                        </div>
                        <label class="kpi-label">Publicado</label>
                        <input type="checkbox" @bind="_isVisible" />
                        <div style="display:flex;gap:0.75rem;margin-top:1rem">
                            <button class="btn btn-primary" type="button" @onclick="() => SaveAsync(item.Id)">Guardar</button>
                            <button class="btn btn-ghost" type="button" @onclick="Cancel">Cancelar</button>
                        </div>
                    </div>
                }
            }
        }
    </section>
}

@code {
    private List<ComunaClick.Admin.Models.AdminPartnerListItemDto>? _items;
    private string? _error;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string? _address;
    private string? _phone;
    private string? _email;
    private bool _isVisible;

    private List<ComunaClick.Admin.Models.AdminSellerFeeItemDto>? _fees;
    private decimal _globalFeePercent = 2.61m;
    private decimal _globalFixedFee = 0m;
    private bool _feesBusy;
    private string? _feesMessage;
    private bool _feesOk;

    private Guid? _editingFeeId;
    private decimal _editFeePercent;
    private decimal _editFixedFee;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var partnersTask = Client.GetPartnersAsync();
            var feesTask = Client.GetSellerFeesAsync();
            await Task.WhenAll(partnersTask, feesTask);
            _items = partnersTask.Result ?? new();
            _fees = feesTask.Result ?? new();
            if (_fees.Count > 0) { _globalFeePercent = _fees[0].PercentageFee; _globalFixedFee = _fees[0].FixedFeeAmount; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ApplyGlobalFeeAsync()
    {
        _feesBusy = true; _feesMessage = null;
        try
        {
            await Client.UpdateGlobalFeeAsync(_globalFeePercent, _globalFixedFee);
            if (_fees is not null)
                _fees = _fees.Select(f => f with { PercentageFee = _globalFeePercent, FixedFeeAmount = _globalFixedFee }).ToList();
            _feesMessage = $"Comisión actualizada a {_globalFeePercent:N2}% para todos los vendedores activos.";
            _feesOk = true;
        }
        catch { _feesMessage = "Error al actualizar las comisiones. Intentá de nuevo."; _feesOk = false; }
        finally { _feesBusy = false; }
    }

    private void BeginFeeEdit(ComunaClick.Admin.Models.AdminSellerFeeItemDto fee)
    {
        _editingFeeId = fee.SellerId; _editFeePercent = fee.PercentageFee; _editFixedFee = fee.FixedFeeAmount;
    }

    private void CancelFeeEdit() => _editingFeeId = null;

    private async Task SaveSellerFeeAsync(Guid sellerId)
    {
        try
        {
            await Client.UpdateSellerFeeAsync(sellerId, _editFeePercent, _editFixedFee);
            if (_fees is not null)
            {
                var idx = _fees.FindIndex(f => f.SellerId == sellerId);
                if (idx >= 0) _fees[idx] = _fees[idx] with { PercentageFee = _editFeePercent, FixedFeeAmount = _editFixedFee };
            }
            _feesMessage = $"Comisión del vendedor actualizada a {_editFeePercent:N2}%."; _feesOk = true;
        }
        catch { _feesMessage = "Error al actualizar la comisión del vendedor."; _feesOk = false; }
        finally { _editingFeeId = null; }
    }

    private void BeginEdit(ComunaClick.Admin.Models.AdminPartnerListItemDto item)
    {
        _editingId = item.Id; _name = item.Name; _address = item.Address;
        _phone = item.Phone; _email = item.Email; _isVisible = item.IsVisible;
    }

    private void Cancel() => _editingId = null;

    private async Task SaveAsync(Guid id)
    {
        var updated = await Client.UpdatePartnerAsync(id, new { name = _name, address = _address, phone = _phone, email = _email, isVisible = _isVisible });
        if (updated is not null && _items is not null)
        {
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0) _items[index] = updated;
        }
        Cancel();
    }
}
