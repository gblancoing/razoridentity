@page "/"
@inject ComunaClick.Admin.Services.AdminApiClient ApiClient
@inject ComunaClick.Admin.Services.AdminAclManagementClient AclClient

<PageTitle>Dashboard - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Panel central"
            Title="Resumen general de la plataforma"
            Description="Supervisa usuarios, tenants, partners, catálogo, órdenes y el estado editorial del sitio." />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar el resumen" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else if (_isLoading)
{
    <section class="panel-card">
        <LoadingPanel Message="Cargando resumen de la plataforma…" />
    </section>
}
else if (_dashboard is not null)
{
    <div class="kpi-grid">
        <KpiCard Label="Usuarios" Icon="group" Value="@_userCount.ToString("N0")"
                 Footnote="Cuentas administrativas y operativas." />
        <KpiCard Label="Partners" Icon="storefront" Value="@_dashboard.PartnerCount.ToString("N0")"
                 Footnote="@($"{_dashboard.VisiblePartnerCount} publicados actualmente.")" />
        <KpiCard Label="Tenants" Icon="apartment" Value="@_dashboard.TenantCount.ToString("N0")"
                 Footnote="Espacios comunales activos en la plataforma." />
        <KpiCard Label="Catálogo" Icon="category" Value="@_dashboard.CategoryCount.ToString("N0")"
                 Footnote="Categorías activas disponibles al público." />
    </div>

    <div class="dashboard-grid">
        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Operación</p>
                    <h2>Actividad reciente</h2>
                </div>
            </div>
            <div class="kpi-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                <KpiCard Label="Órdenes" Value="@_dashboard.OrderCount.ToString("N0")" />
                <KpiCard Label="Reservas" Value="@_dashboard.BookingCount.ToString("N0")" />
                <KpiCard Label="Leads" Value="@_dashboard.LeadCount.ToString("N0")" />
                <KpiCard Label="Publicados" Value="@_dashboard.VisiblePartnerCount.ToString("N0")" />
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Partners</p>
                    <h2>Últimos cambios</h2>
                </div>
            </div>
            @if (_dashboard.RecentPartners.Count == 0)
            {
                <EmptyState Title="Sin movimientos recientes" Description="Aún no hay cambios de partners para mostrar." />
            }
            else
            {
                <div class="table-list">
                    @foreach (var item in _dashboard.RecentPartners)
                    {
                        <div class="row-card">
                            <div>
                                <p class="row-title">@item.Name</p>
                                <p class="row-subtitle">Tipo @item.Type</p>
                            </div>
                            <div class="row-right">
                                <StatusBadge Status="@(item.IsVisible ? "Publicado" : "No publicado")"
                                             Kind="@(item.IsVisible ? "success" : "muted")" />
                                <p class="row-subtitle mt-4">@item.UpdatedAt.ToLocalTime().ToString("dd/MM HH:mm")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private ComunaClick.Admin.Models.AdminDashboardDto? _dashboard;
    private int _userCount;
    private bool _isLoading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var dashboardTask = ApiClient.GetDashboardAsync();
            var usersTask = AclClient.GetUsersAsync();
            await Task.WhenAll(dashboardTask, usersTask);
            _dashboard = dashboardTask.Result;
            _userCount = usersTask.Result.Count;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
