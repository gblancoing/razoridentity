@page "/login"
@layout ComunaClick.Admin.Components.Layout.EmptyLayout
@inject ComunaClick.Admin.Services.PaymentsAclAuthClient AuthClient
@inject ComunaClick.Admin.Services.PaymentsAuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Ingresar a ComunaClick.Admin</PageTitle>

<div class="min-h-screen flex items-center justify-center px-6 py-12" style="background:linear-gradient(180deg,#fffdf7 0%,#f4fbf6 100%);">
    <div class="panel-card" style="width:min(100%, 460px);">
        <div class="panel-head">
            <div>
                <p class="eyebrow">ComunaClick.Admin</p>
                <h2>Ingreso de superadministrador</h2>
            </div>
        </div>

        <p class="page-description">Usa una cuenta `platform_admin` o `tenant_admin` para gestionar usuarios, tenants, partners, contenido público y auditoría.</p>

        <form class="space-y-4 mt-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <label>
                <span class="kpi-label">Correo</span>
                <input class="filter-input" type="email" @bind="_email" autocomplete="username" />
            </label>

            <label>
                <span class="kpi-label">Contraseña</span>
                <input class="filter-input" type="password" @bind="_password" autocomplete="current-password" />
            </label>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="text-sm" style="color:#b42318;">@_error</p>
            }

            <button class="primary-link" style="border:none; cursor:pointer;" type="submit" disabled="@_submitting">
                @(_submitting ? "Ingresando..." : "Entrar al panel")
            </button>
        </form>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _submitting;
    private string? _returnUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _returnUrl = ReadReturnUrl();
        await AuthState.InitializeAsync();
        if (AuthState.IsAuthenticated && AuthState.IsPaymentsAdmin)
        {
            Navigation.NavigateTo(_returnUrl ?? "/", true);
        }
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        try
        {
            var recaptchaToken = await ExecuteRecaptchaAsync();
            var tokens = await AuthClient.LoginAsync(_email, _password, recaptchaToken);
            await AuthState.SetTokensAsync(tokens);

            if (!AuthState.IsPaymentsAdmin)
            {
                _error = "Tu cuenta no tiene permisos administrativos para ComunaClick.Admin.";
                await AuthState.ClearAsync();
                return;
            }

            Navigation.NavigateTo(_returnUrl ?? "/", true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<string?> ExecuteRecaptchaAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("comunaclicAdmin.executeRecaptcha", "login");
        }
        catch
        {
            return null;
        }
    }

    private string? ReadReturnUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), "returnUrl", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            if (!string.IsNullOrWhiteSpace(value) && value.StartsWith('/'))
            {
                return value;
            }
        }

        return null;
    }
}
