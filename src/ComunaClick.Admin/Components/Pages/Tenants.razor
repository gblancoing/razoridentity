@page "/tenants"
@inject ComunaClick.Admin.Services.AdminApiClient Client

<PageTitle>Tenants - ComunaClick.Admin</PageTitle>

<PageHeader Eyebrow="Organización"
            Title="Tenants y comunas"
            Description="Administra el nombre, estado y timezone de los tenants del ecosistema." />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel-card">
        <ErrorPanel Title="No pudimos cargar tenants" Message="@_error" OnRetry="LoadAsync" />
    </section>
}
else
{
    <section class="panel-card">
        <div class="panel-head"><div><p class="eyebrow">Tenants</p><h2>Gestión</h2></div></div>
        @if (_isLoading)
        {
            <LoadingPanel Message="Cargando tenants…" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState Title="Sin tenants" Description="No hay tenants registrados en el ecosistema." />
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="row-card">
                    <div>
                        <p class="row-title">@item.Name</p>
                        <p class="row-subtitle">@item.ComunaName · @item.Timezone · @item.PartnerCount partners</p>
                    </div>
                    <button class="btn btn-ghost" type="button" @onclick="() => BeginEdit(item)">Editar</button>
                </div>

                @if (_editingId == item.Id)
                {
                    <div class="panel-card" style="margin:0.5rem 0 1rem">
                        <label class="kpi-label">Nombre</label>
                        <input class="filter-input" @bind="_name" />
                        <label class="kpi-label">Timezone</label>
                        <input class="filter-input" @bind="_timezone" />
                        <label class="kpi-label">Activo</label>
                        <input type="checkbox" @bind="_isActive" />
                        <div style="display:flex;gap:0.75rem;margin-top:1rem">
                            <button class="btn btn-primary" type="button" @onclick="() => SaveAsync(item.Id)">Guardar</button>
                            <button class="btn btn-ghost" type="button" @onclick="Cancel">Cancelar</button>
                        </div>
                    </div>
                }
            }
        }
    </section>
}

@code {
    private List<ComunaClick.Admin.Models.AdminTenantListItemDto> _items = new();
    private bool _isLoading = true;
    private string? _error;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string _timezone = "America/Santiago";
    private bool _isActive;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _items = await Client.GetTenantsAsync() ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BeginEdit(ComunaClick.Admin.Models.AdminTenantListItemDto item)
    {
        _editingId = item.Id;
        _name = item.Name;
        _timezone = item.Timezone;
        _isActive = item.IsActive;
    }

    private void Cancel() => _editingId = null;

    private async Task SaveAsync(Guid id)
    {
        var updated = await Client.UpdateTenantAsync(id, new { name = _name, isActive = _isActive, timezone = _timezone });
        if (updated is not null)
        {
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0) _items[index] = updated;
        }
        Cancel();
    }
}
