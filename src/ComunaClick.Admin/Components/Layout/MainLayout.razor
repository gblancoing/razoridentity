@inherits LayoutComponentBase
@inject ComunaClick.Admin.Services.PaymentsAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!AuthState.IsInitialized)
{
    <MudLayout>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh">
                <MudStack AlignItems="AlignItems.Center" Spacing="4">
                    <MudProgressCircular Color="Color.Success" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Validando acceso administrativo…</MudText>
                </MudStack>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else if (!AuthState.IsAuthenticated || !AuthState.IsPaymentsAdmin)
{
    <MudLayout>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Style="font-size:3rem" />
                    <MudText Typo="Typo.h5">Acceso restringido</MudText>
                    <MudText Color="Color.Secondary">Redirigiendo al login…</MudText>
                </MudStack>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0" Color="Color.Surface" Style="border-bottom:1px solid #e8e5dc; background:rgba(255,255,255,0.85); backdrop-filter:blur(18px);">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.overline" Style="color:#61897c; letter-spacing:0.12em;">ComunaClic</MudText>
                <MudText Typo="Typo.subtitle1" Style="font-family:'Manrope',sans-serif; font-weight:800; color:#111816;">Panel central de operación</MudText>
            </MudStack>
            <MudSpacer />
            <MudChip T="string" Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                @(AuthState.Tokens?.DisplayName ?? AuthState.Tokens?.Email ?? "Administrador")
            </MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Cerrar sesión" OnClick="Logout" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
                   Style="border-right:1px solid #e8e5dc; background:rgba(255,255,255,0.9); backdrop-filter:blur(18px);">
            <MudDrawerHeader Style="padding:24px 20px 16px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Style="background:linear-gradient(135deg,#22c55e,#2d9e4f); color:white; font-family:'Manrope',sans-serif; font-weight:800; border-radius:18px;">CA</MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="font-family:'Manrope',sans-serif; font-weight:800;">ComunaClick.Admin</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleLabel</MudText>
                    </MudStack>
                </MudStack>
            </MudDrawerHeader>

            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.Group">Usuarios</MudNavLink>
                <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Apartment">Tenants</MudNavLink>
                <MudNavLink Href="/partners" Icon="@Icons.Material.Filled.Storefront">Partners</MudNavLink>
                <MudNavLink Href="/categorias" Icon="@Icons.Material.Filled.Inventory2">Categorías</MudNavLink>
                <MudNavLink Href="/delivery-providers" Icon="@Icons.Material.Filled.LocalShipping">Delivery</MudNavLink>
                <MudNavLink Href="/contenido" Icon="@Icons.Material.Filled.EditNote">Contenido</MudNavLink>
                <MudNavLink Href="/pagos" Icon="@Icons.Material.Filled.Payments">Pagos</MudNavLink>
                <MudNavLink Href="/auditoria" Icon="@Icons.Material.Filled.History">Auditoría</MudNavLink>
                <MudNavLink Href="/configuracion" Icon="@Icons.Material.Filled.Settings">Configuración</MudNavLink>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#22c55e",
            PrimaryContrastText = "#ffffff",
            Secondary = "#61897c",
            Success = "#2d9e4f",
            Background = "#fffdf7",
            Surface = "#ffffff",
            AppbarBackground = "#00000000",
            DrawerBackground = "#00000000",
            TextPrimary = "#111816",
            TextSecondary = "#61897c",
        }
    };

    private string RoleLabel =>
        AuthState.Tokens?.Roles.Contains("platform_admin", StringComparer.OrdinalIgnoreCase) == true
            ? "Platform admin"
            : "Tenant admin";

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.InitializeAsync();
        EnsureAuthenticated();
    }

    private void HandleAuthChange()
    {
        EnsureAuthenticated();
        InvokeAsync(StateHasChanged);
    }

    private void EnsureAuthenticated()
    {
        if (!AuthState.IsInitialized) return;
        if (AuthState.IsAuthenticated && AuthState.IsPaymentsAdmin) return;

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
    }

    private async Task Logout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
    }
}
