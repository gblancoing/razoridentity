@inherits LayoutComponentBase
@inject ComunaClick.Admin.Services.PaymentsAuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

@if (!AuthState.IsInitialized)
{
    <div class="admin-shell">
        <main class="content-shell">
            <article class="page-body">
                <section class="not-found-card">
                    <p class="eyebrow">ComunaClick.Admin</p>
                    <h1>Validando acceso administrativo</h1>
                    <p>Estamos verificando tu sesión en el panel central.</p>
                </section>
            </article>
        </main>
    </div>
}
else if (!AuthState.IsAuthenticated || !AuthState.IsPaymentsAdmin)
{
    <div class="admin-shell">
        <main class="content-shell">
            <article class="page-body">
                <section class="not-found-card">
                    <p class="eyebrow">ComunaClick.Admin</p>
                    <h1>Acceso restringido</h1>
                    <p>Redirigiendo al login…</p>
                </section>
            </article>
        </main>
    </div>
}
else
{
    <AdminShell BrandInitials="CA"
                BrandTitle="ComunaClick.Admin"
                BrandSubtitle="Panel central"
                TopbarLabel="ComunaClic"
                TopbarTitle="Panel central de operación"
                FooterLabel="Acceso"
                FooterValue="@RoleLabel"
                UserDisplay="@(AuthState.Tokens?.DisplayName ?? AuthState.Tokens?.Email ?? "Administrador")"
                NavItems="_navItems"
                OnLogout="Logout">
        <Body>
            @Body
        </Body>
    </AdminShell>
}

@code {
    private static readonly IReadOnlyList<AdminNavItem> _navItems = new[]
    {
        new AdminNavItem("/", "dashboard", "Dashboard", MatchAll: true),
        new AdminNavItem("/ordenes", "receipt_long", "Órdenes"),
        new AdminNavItem("/liquidaciones", "account_balance_wallet", "Liquidaciones"),
        new AdminNavItem("/couriers", "directions_bike", "Couriers"),
        new AdminNavItem("/marketplace", "storefront", "Marketplace"),
        new AdminNavItem("/payouts", "payments", "Payouts"),
        new AdminNavItem("/partners", "handshake", "Partners"),
        new AdminNavItem("/usuarios", "group", "Usuarios"),
        new AdminNavItem("/tenants", "apartment", "Tenants"),
        new AdminNavItem("/categorias", "category", "Categorías"),
        new AdminNavItem("/delivery-providers", "local_shipping", "Delivery"),
        new AdminNavItem("/contenido", "edit_note", "Contenido"),
        new AdminNavItem("/auditoria", "history", "Auditoría"),
        new AdminNavItem("/configuracion", "settings", "Configuración")
    };

    private string RoleLabel =>
        AuthState.Tokens?.Roles.Contains("platform_admin", StringComparer.OrdinalIgnoreCase) == true
            ? "Platform admin"
            : "Tenant admin";

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthState.InitializeAsync();
        EnsureAuthenticated();
    }

    private void HandleAuthChange()
    {
        EnsureAuthenticated();
        InvokeAsync(StateHasChanged);
    }

    private void EnsureAuthenticated()
    {
        if (!AuthState.IsInitialized) return;
        if (AuthState.IsAuthenticated && AuthState.IsPaymentsAdmin) return;

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
    }

    private async Task Logout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
    }
}
