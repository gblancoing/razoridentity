@page "/buscar"

@layout BuyerLayout

@inject LocaleService L

@inject BuyerApiClient BuyerApi

@inject NavigationManager Navigation

@inject UserMapLocationService MapLocation

@implements IDisposable



<PageTitle>@L.T("search.page.title")</PageTitle>



<div class="flex flex-col gap-6 pb-12">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

        <div>

            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">@L.T("search.page.eyebrow")</p>

            <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-[#111816] sm:text-3xl">

                @if (string.IsNullOrWhiteSpace(_query))

                {

                    @L.T("search.page.titleEmpty")

                }

                else

                {

                    @string.Format(L.T("search.page.titleQuery"), _query)

                }

            </h1>

            @if (!string.IsNullOrWhiteSpace(_contextLine))

            {

                <p class="mt-2 text-sm text-[#61897c]">@_contextLine</p>

            }

            else

            {

                <p class="mt-2 text-sm text-[#61897c]">@L.T("search.page.subtitle")</p>

            }

        </div>



        @if (!_loading && string.IsNullOrWhiteSpace(_error) && HasAnyResults)

        {

            <div class="inline-flex rounded-xl border border-gray-200 bg-white p-1 shadow-sm" role="tablist" aria-label="@L.T("search.page.viewToggleAria")">

                <button type="button"

                        class="@GetViewToggleClass(false)"

                        role="tab"

                        aria-selected="@(_viewMode == SearchViewMode.List)"

                        @onclick="() => SetViewModeAsync(SearchViewMode.List)">

                    <span class="material-symbols-outlined text-[18px]">view_list</span>

                    @L.T("search.page.viewList")

                </button>

                <button type="button"

                        class="@GetViewToggleClass(true)"

                        role="tab"

                        aria-selected="@(_viewMode == SearchViewMode.Map)"

                        @onclick="() => SetViewModeAsync(SearchViewMode.Map)">

                    <span class="material-symbols-outlined text-[18px]">map</span>

                    @L.T("search.page.viewMap")

                </button>

            </div>

        }

    </div>



    @if (_loading)

    {

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

            <p class="text-sm font-semibold text-[#2c2f30]">@L.T("home.market.searching")</p>

        </div>

    }

    else if (!string.IsNullOrWhiteSpace(_error))

    {

        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm font-semibold text-rose-800">@_error</div>

    }

    else if (!HasAnyResults)

    {

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

            <p class="text-sm font-semibold text-[#2c2f30]">

                @L.T("home.market.noMatches")

                @if (!string.IsNullOrWhiteSpace(_query))

                {

                    <span class="text-primary">"@_query"</span>

                }

            </p>

            <a href="/" class="mt-4 inline-flex text-sm font-bold text-primary hover:underline">@L.T("search.page.backHome")</a>

        </div>

    }

    else if (_viewMode == SearchViewMode.Map)

    {

        @if (_usedGeoFallback)

        {

            <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">

                @L.T("home.search.fallbackNoGeo")

            </p>

        }



        <SearchResultsMap AllItems="@AllCatalogItems" Geo="_geo" DeviceLocation="_deviceLocation" />

    }

    else

    {

        @if (_usedGeoFallback)

        {

            <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">

                @L.T("home.search.fallbackNoGeo")

            </p>

        }



        <div class="space-y-8">

            @RenderCatalogSection(L.T("home.search.products"), "products", _products)

            @RenderCatalogSection(L.T("home.featured.title"), "partners", _partners)

            @RenderCatalogSection(L.T("home.services.title"), "services", _services)

            @RenderCatalogSection(L.T("home.search.professionals"), "professionals", _professionals)

        </div>

    }

</div>



@code {

    private enum SearchViewMode

    {

        List,

        Map

    }



    private readonly List<SearchResultItem> _products = new();

    private readonly List<SearchResultItem> _partners = new();

    private readonly List<SearchResultItem> _services = new();

    private readonly List<SearchResultItem> _professionals = new();



    private string? _query;

    private string? _typeFilter;

    private GeoFilter? _geo;

    private UserMapLocationResult _deviceLocation;

    private string? _contextLine;

    private string? _error;

    private bool _loading = true;

    private bool _usedGeoFallback;

    private SearchViewMode _viewMode = SearchViewMode.List;



    private bool HasAnyResults

        => _products.Count > 0 || _partners.Count > 0 || _services.Count > 0 || _professionals.Count > 0;



    private IReadOnlyList<SearchResultItem> AllCatalogItems

        => _products.Concat(_partners).Concat(_services).Concat(_professionals).ToList();



    protected override async Task OnInitializedAsync()

    {

        Navigation.LocationChanged += OnLocationChanged;

        await LoadAsync();

    }



    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)

    {

        await LoadAsync();

        await InvokeAsync(StateHasChanged);

    }



    private async Task LoadAsync()

    {

        _loading = true;

        _error = null;

        _usedGeoFallback = false;

        _products.Clear();

        _partners.Clear();

        _services.Clear();

        _professionals.Clear();



        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        _query = SearchQueryHelper.ParseQueryFromUri(uri)?.Trim();

        _typeFilter = SearchQueryHelper.ParseTypeFromUri(uri)?.Trim().ToLowerInvariant();

        var urlGeo = SearchQueryHelper.ParseGeoFromUri(uri);

        _deviceLocation = await MapLocation.GetCurrentAsync();

        _geo = UserMapLocationService.ToGeoFilter(_deviceLocation, urlGeo?.RadiusKm) ?? urlGeo;

        _viewMode = ParseViewMode(SearchQueryHelper.ParseViewFromUri(uri));

        _contextLine = BuildContextLine();



        if (string.IsNullOrWhiteSpace(_query))

        {

            _loading = false;

            return;

        }



        try

        {

            await FetchCatalogAsync();

            if (_geo is not null && !HasAnyResults)

            {

                _usedGeoFallback = true;

                _geo = null;

                _contextLine = BuildContextLine();

                await FetchCatalogAsync();

            }

        }

        catch (HttpRequestException ex)

        {

            _error = string.Format(L.T("search.page.errorStatus"), (int?)ex.StatusCode ?? 0);

        }

        catch (Exception)

        {

            _error = L.T("home.search.errorGeneric");

        }

        finally

        {

            _loading = false;

        }

    }



    private async Task FetchCatalogAsync()

    {

        _products.Clear();

        _partners.Clear();

        _services.Clear();

        _professionals.Clear();



        var tasks = new List<Task>();

        Task<IReadOnlyList<SearchResultItem>?>? productsTask = null;

        Task<IReadOnlyList<SearchResultItem>?>? partnersTask = null;

        Task<IReadOnlyList<SearchResultItem>?>? servicesTask = null;

        Task<IReadOnlyList<SearchResultItem>?>? professionalsTask = null;



        if (ShouldShowType("products"))

        {

            productsTask = BuyerApi.SearchAsync(_query, "products", SearchQueryHelper.FullPageLimit, _geo);

            tasks.Add(productsTask);

        }



        if (ShouldShowType("partners"))

        {

            partnersTask = BuyerApi.SearchAsync(_query, "partners", SearchQueryHelper.FullPageLimit, _geo);

            tasks.Add(partnersTask);

        }



        if (ShouldShowType("services"))

        {

            servicesTask = BuyerApi.SearchAsync(_query, "services", SearchQueryHelper.FullPageLimit, _geo);

            tasks.Add(servicesTask);

        }



        if (ShouldShowType("professionals"))

        {

            professionalsTask = BuyerApi.SearchAsync(_query, "professionals", SearchQueryHelper.FullPageLimit, _geo);

            tasks.Add(professionalsTask);

        }



        if (tasks.Count == 0)

        {

            return;

        }



        await Task.WhenAll(tasks);



        if (productsTask is not null)

        {

            AddTyped(_products, await productsTask, "product");

        }



        if (partnersTask is not null)

        {

            AddTyped(_partners, await partnersTask, "partner");

        }



        if (servicesTask is not null)

        {

            AddTyped(_services, await servicesTask, "service");

        }



        if (professionalsTask is not null)

        {

            AddTyped(_professionals, await professionalsTask, "professional");

        }

    }



    private bool ShouldShowType(string type)

        => string.IsNullOrWhiteSpace(_typeFilter) || _typeFilter == type;



    private static void AddTyped(List<SearchResultItem> target, IReadOnlyList<SearchResultItem>? source, string expectedType)

    {

        if (source is null)

        {

            return;

        }



        target.AddRange(source.Where(x => string.Equals(x.Type, expectedType, StringComparison.OrdinalIgnoreCase)));

    }



    private string? BuildContextLine()

    {

        if (_geo?.HasCoordinates != true)

        {

            return null;

        }



        var radius = (int)Math.Round(_geo.RadiusKm ?? 30);

        return string.Format(L.T("search.page.contextGeo"), radius);

    }



    private static SearchViewMode ParseViewMode(string? view)

        => string.Equals(view, "map", StringComparison.OrdinalIgnoreCase)

            ? SearchViewMode.Map

            : SearchViewMode.List;



    private async Task SetViewModeAsync(SearchViewMode mode)

    {

        if (_viewMode == mode)

        {

            return;

        }



        _viewMode = mode;

        var viewParam = mode == SearchViewMode.Map ? "map" : null;

        var url = SearchQueryHelper.BuildBuscarUrl(_query, _typeFilter, _geo, viewParam);

        Navigation.NavigateTo(url, replace: true);

        await InvokeAsync(StateHasChanged);

    }



    private string GetViewToggleClass(bool isMap)

    {

        var active = isMap ? _viewMode == SearchViewMode.Map : _viewMode == SearchViewMode.List;

        return active

            ? "inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-xs font-bold text-white shadow-sm"

            : "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-[#61897c] hover:bg-gray-50";

    }



    private RenderFragment RenderCatalogSection(string title, string typeKey, IReadOnlyList<SearchResultItem> items) => builder =>

    {

        if (!ShouldShowType(typeKey) || items.Count == 0)

        {

            return;

        }



        var seq = 0;

        builder.OpenElement(seq++, "section");

        builder.AddAttribute(seq++, "class", "rounded-2xl border border-gray-200/80 bg-white p-5 shadow-sm sm:p-6");



        builder.OpenElement(seq++, "h2");

        builder.AddAttribute(seq++, "class", "mb-4 text-xs font-black uppercase tracking-[0.14em] text-[#4d4f50]");

        builder.AddContent(seq++, title);

        builder.CloseElement();



        builder.OpenComponent<SearchResultsGrid>(seq++);

        builder.AddAttribute(seq++, "Items", items);

        builder.CloseComponent();



        builder.CloseElement();

    };



    public void Dispose()

    {

        Navigation.LocationChanged -= OnLocationChanged;

    }

}


