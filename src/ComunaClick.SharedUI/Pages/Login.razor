@page "/login"
@using Microsoft.Extensions.Logging
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Auth.Interfaces.IAuthClient AuthClient
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject Microsoft.Extensions.Options.IOptions<ComunaClick.Shared.Http.ApiOptions> ApiOptions
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@L.T("login.title")</PageTitle>

<div class="relative flex min-h-screen flex-col lg:flex-row">
    @if (_isSubmitting)
    {
        <div class="fixed inset-0 z-[70] flex items-center justify-center bg-white/75 px-6 backdrop-blur-sm dark:bg-background-dark/75">
            <BrandedLoading
                Compact="true"
                Title="Ingresando a ComunaClic"
                Message="Estamos validando tu acceso." />
        </div>
    }

    <!-- Left Side: Image (Visible on Desktop) -->
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center" data-alt="Fotografía editorial de barrio y comercio local" style="@($"background-image: url('{LoginHeroImageUrl}');")">
        </div>
        <div class="absolute inset-0 bg-black/40 flex flex-col justify-end p-12">
            <h1 class="text-white text-5xl font-bold mb-4">@L.T("login.hero.title")</h1>
            <p class="text-white/90 text-xl max-w-md">@L.T("login.hero.subtitle")</p>
            <p class="text-white/70 text-xs mt-6 uppercase tracking-[0.18em]">Imagen editorial dinámica</p>
        </div>
    </div>
    <!-- Right Side: Login Form -->
    <div class="flex-1 flex flex-col">
        <!-- Top App Bar -->
        <div class="flex items-center bg-transparent p-4 pb-2 justify-between lg:px-8 gap-4">
            <img src="_content/ComunaClick.SharedUI/logo.png" alt="ComunaClic" class="h-14 w-auto" />
            <LanguageToggle />
            <div class="hidden sm:flex items-center gap-2">
                <a class="bg-primary/10 hover:bg-primary/20 text-[#111816] dark:text-primary px-4 py-2 rounded-lg text-sm font-bold leading-normal transition-colors" href="/register?intent=buyer">
                    Cuenta personal
                </a>
                <a class="bg-[#111816] hover:bg-[#1d2d29] text-white px-4 py-2 rounded-lg text-sm font-bold leading-normal transition-colors" href="/register?intent=partner">
                    Registrar negocio
                </a>
            </div>
        </div>
        <div class="flex-1 flex items-center justify-center p-6 lg:p-12">
            <div class="w-full max-w-[480px]">
                <div class="mb-8">
                    <h2 class="text-[#111816] dark:text-white text-3xl font-bold leading-tight tracking-[-0.015em]">@L.T("login.form.title")</h2>
                    <p class="text-[#61897c] mt-2">@L.T("login.form.subtitle")</p>
                </div>
                <!-- Form -->
                <form class="space-y-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                    <div class="flex flex-col gap-1">
                        <label class="text-[#111816] dark:text-white text-base font-medium leading-normal pb-1">@L.T("login.email.label")
                            <input class="form-input flex w-full min-w-0 resize-none overflow-hidden rounded-2xl text-[#111816] dark:bg-background-dark dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary border border-[#dbe6e2] dark:border-[#2d4a41] bg-[#F0FDF4] h-14 placeholder:text-[#61897c] p-[15px] text-base font-normal leading-normal" placeholder="@L.T("login.email.placeholder")" type="email" @bind="Email" />
                        </label>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-[#111816] dark:text-white text-base font-medium leading-normal pb-1">@L.T("login.password.label")
                            <div class="flex w-full items-stretch rounded-lg group">
                                <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-2xl rounded-r-none border-r-0 text-[#111816] dark:bg-background-dark dark:text-white focus:outline-0 focus:ring-0 border border-[#dbe6e2] dark:border-[#2d4a41] bg-[#F0FDF4] h-14 placeholder:text-[#61897c] p-[15px] text-base font-normal leading-normal" placeholder="@L.T("login.password.placeholder")" type="password" @bind="Password" />
                                <div class="text-[#61897c] flex border border-[#dbe6e2] dark:border-[#2d4a41] bg-[#F0FDF4] dark:bg-background-dark items-center justify-center pr-[15px] rounded-r-2xl border-l-0">
                                    <span class="material-symbols-outlined cursor-pointer">visibility</span>
                                </div>
                            </div>
                        </label>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input class="form-checkbox w-5 h-5 rounded border-[#dbe6e2] text-primary focus:ring-primary" type="checkbox" />
                            <span class="text-[#111816] dark:text-white/80 text-sm">@L.T("login.stay")</span>
                        </label>
                        <a class="text-sm font-semibold text-primary hover:underline" href="mailto:soporte@comunaclic.cl?subject=Recuperar%20contraseña%20ComunaClic">@L.T("login.forgot")</a>
                    </div>
                    <button class="w-full bg-primary hover:opacity-90 text-[#10221c] h-14 rounded-xl font-bold text-lg transition-all shadow-lg shadow-primary/20" type="submit" disabled="@_isSubmitting">
                        @L.T("login.submit")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <p class="text-sm text-red-500">@_errorMessage</p>
                    }
                    <div class="relative flex py-5 items-center">
                        <div class="flex-grow border-t border-[#dbe6e2] dark:border-[#2d4a41]"></div>
                        <span class="flex-shrink mx-4 text-[#61897c] text-sm uppercase">@L.T("login.orContinue")</span>
                        <div class="flex-grow border-t border-[#dbe6e2] dark:border-[#2d4a41]"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <button class="flex items-center justify-center gap-2 h-14 border border-[#dbe6e2] dark:border-[#2d4a41] rounded-xl bg-white dark:bg-background-dark hover:bg-gray-50 transition-colors disabled:opacity-60"
                                type="button"
                                disabled="@_isSubmitting"
                                @onclick="HandleGoogleSignInAsync">
                            <span class="material-symbols-outlined text-red-500">google</span>
                            <span class="text-[#111816] dark:text-white font-medium">Google</span>
                        </button>
                        <button class="flex items-center justify-center gap-2 h-14 border border-[#dbe6e2] dark:border-[#2d4a41] rounded-xl bg-white dark:bg-background-dark hover:bg-gray-50 transition-colors" type="button">
                            <span class="material-symbols-outlined text-blue-600">social_leaderboard</span>
                            <span class="text-[#111816] dark:text-white font-medium">Facebook</span>
                        </button>
                    </div>
                </form>
                <div class="mt-8 text-center text-[#61897c] space-y-3">
                    <p>
                        @L.T("login.signup.text")
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <a class="text-primary font-bold hover:underline" href="/register?intent=buyer">Crear cuenta personal</a>
                        <a class="text-primary font-bold hover:underline" href="/register?intent=partner">Registrar mi negocio</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer (Optional) -->
        <div class="p-8 text-center text-xs text-[#61897c]">
            @L.T("login.footer")
        </div>
    </div>
</div>

@code {
    private string Email = string.Empty;
    private string Password = string.Empty;
    private bool _isSubmitting;
    private string? _errorMessage;
    private bool _checkedAuth;
    private string? _returnUrl;
    private string LoginHeroImageUrl { get; set; } = BuildLoginHeroImageUrl();

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        _returnUrl = ReadReturnUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;
        try
        {
            if (await TryHandleGoogleCallbackAsync())
            {
                return;
            }

            await AuthState.InitializeAsync();
            if (AuthState.IsAuthenticated)
            {
                var destination = ResolvePostLoginTarget(AuthState.IsPersonalAccount, _returnUrl);
                Logger.LogInformation("Already authenticated on login page. Redirecting to {Destination}", destination);
                Navigation.NavigateTo(destination, true);
            }
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during prerender; will retry on next render.
            _checkedAuth = false;
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private static string BuildLoginHeroImageUrl()
    {
        // Stable daily rotation so the login art feels fresh without flickering on each render.
        var seed = DateTime.UtcNow.ToString("yyyyMMdd");
        return $"https://picsum.photos/seed/comunaclic-login-{seed}/1400/1800";
    }

    private string? ReadReturnUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), "returnUrl", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            if (string.IsNullOrWhiteSpace(value) || !value.StartsWith('/'))
            {
                return null;
            }

            return value;
        }

        return null;
    }

    private static string ResolvePostLoginTarget(bool isPersonalAccount, string? returnUrl)
    {
        if (isPersonalAccount && !string.IsNullOrWhiteSpace(returnUrl) && !returnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
        {
            return returnUrl;
        }

        return isPersonalAccount ? "/buyer" : "/my-businesses";
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            Logger.LogInformation("Login submit started for {Email}", Email);
            var recaptchaToken = await ExecuteRecaptchaAsync();
            var options = ApiOptions.Value;
            var tokens = await AuthClient.LoginAsync(new ComunaClick.Shared.Auth.LoginRequest(
                Email,
                Password,
                options.DefaultTenantId,
                null,
                recaptchaToken));
            await AuthState.SetTokensAsync(tokens);
            var isPersonalAccount = !tokens.PartnerId.HasValue || tokens.PartnerId == Guid.Empty;
            var destination = ResolvePostLoginTarget(isPersonalAccount, _returnUrl);
            Logger.LogInformation("Login successful for {Email}. Redirecting to {Destination}", Email, destination);
            Navigation.NavigateTo(destination);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed for {Email}", Email);
            _errorMessage = ex.Message;
        }
        finally
        {
            Logger.LogInformation("Login submit finished for {Email}", Email);
            _isSubmitting = false;
        }
    }

    private async Task<string?> ExecuteRecaptchaAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("comunaclic.executeRecaptcha", "login");
        }
        catch
        {
            return null;
        }
    }

    private async Task HandleGoogleSignInAsync()
    {
        _errorMessage = null;

        try
        {
            var callbackUrl = Navigation.ToAbsoluteUri(Navigation.Uri).GetLeftPart(UriPartial.Path) + Navigation.ToAbsoluteUri(Navigation.Uri).Query;
            await JSRuntime.InvokeVoidAsync("comunaclic.beginGoogleSignIn", callbackUrl);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Google sign-in start failed");
            _errorMessage = "No pudimos iniciar sesión con Google en este momento.";
        }
    }

    private async Task<bool> TryHandleGoogleCallbackAsync()
    {
        var idToken = await JSRuntime.InvokeAsync<string>("comunaclic.consumeGoogleIdTokenFromHash");
        if (string.IsNullOrWhiteSpace(idToken))
        {
            return false;
        }

        _isSubmitting = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var tokens = await AuthClient.LoginExternalAsync(new ComunaClick.Shared.Auth.ExternalLoginRequest(
                ComunaClick.Shared.Auth.ExternalProvider.Google,
                idToken,
                TenantId: null,
                PartnerId: null));
            await AuthState.SetTokensAsync(tokens);
            var isPersonalAccount = !tokens.PartnerId.HasValue || tokens.PartnerId == Guid.Empty;
            var destination = isPersonalAccount ? "/buyer" : "/my-businesses";
            Navigation.NavigateTo(destination, true);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Google sign-in callback failed");
            _errorMessage = "No se pudo completar el inicio con Google.";
            return false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
