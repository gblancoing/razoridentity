@page "/profesionales/especialidad/{Slug}"
@layout BuyerLayout
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject NavigationManager Navigation
@using ComunaClick.SharedUI.Services
@using ComunaClick.SharedUI.Data

<PageTitle>@( _hub is null ? "Especialidad" : _hub.Title) · Profesionales — ComunaClic</PageTitle>

<main class="max-w-7xl mx-auto px-4 py-6 sm:py-10 space-y-8">
    @if (_isLoading)
    {
        <BrandedLoading Title="Cargando especialidad" Message="Buscando perfiles profesionales vinculados a esta temática." />
    }
    else if (_hub is null)
    {
        <div class="rounded-3xl border border-amber-200/80 bg-amber-50/90 px-5 py-4 text-sm text-amber-950">
            No encontramos esta especialidad. <a href="/professionals" class="font-bold text-[#3b6700] underline">Volver a especialidades</a>
        </div>
    }
    else
    {
        @* Banner *@
        <section class="overflow-hidden rounded-[2rem] bg-white shadow-[0_10px_30px_-10px_rgba(0,0,0,0.06)]">
            @if (!string.IsNullOrWhiteSpace(_bannerImage))
            {
                <div class="relative h-56 min-h-[14rem] w-full sm:h-72 sm:min-h-[16rem] md:h-80">
                    <img src="@_bannerImage"
                         alt=""
                         class="absolute inset-0 h-full w-full object-cover"
                         loading="eager" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#1a1c1b]/90 via-[#1a1c1b]/40 to-[#1a1c1b]/20"></div>
                    <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 md:p-10">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/80 sm:text-[11px]">Profesionales</p>
                        <h1 class="mt-2 text-2xl font-black leading-tight tracking-[-0.04em] text-white sm:text-3xl md:text-4xl">@_hub.Title</h1>
                        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/90">Perfiles publicados y contactables. Podés afinar con la búsqueda o abrir el detalle de cada persona.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="px-6 py-10 sm:px-10 sm:py-12 bg-gradient-to-br from-[#0f2410] via-[#3b6700] to-[#a7f255]/90">
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/70">Profesionales</p>
                    <h1 class="mt-2 text-2xl font-black leading-tight tracking-[-0.04em] text-white sm:text-3xl">@_hub.Title</h1>
                    <p class="mt-3 max-w-2xl text-sm text-white/90">Perfiles publicados y contactables en ComunaClic.</p>
                </div>
            }

            <div class="border-t border-[#e3e6e8] bg-white/95 px-5 py-4 sm:px-8">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
                    <div class="min-w-0 flex-1">
                        <label for="pro-spec-q" class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">Buscar en esta especialidad</label>
                        <input id="pro-spec-q"
                               class="mt-1.5 w-full h-11 rounded-2xl border border-[#dadddf] px-4 text-sm"
                               @bind="_searchQuery"
                               @bind:event="oninput"
                               placeholder="Nombre, especialidad, palabra clave…" />
                    </div>
                    <p class="shrink-0 text-xs text-[#7b8081] sm:text-right">
                        @(_rows.Count) perfil@(_rows.Count == 1 ? "" : "es")
                    </p>
                </div>
            </div>
        </section>

        @* Controles de vista *@
        <div class="flex items-center gap-2">
            <button @onclick='() => _viewMode = "list"'
                    class="@(_viewMode == "list" ? "bg-[#3b6700] text-[#d9ffad]" : "bg-white text-[#595c5d] border border-[#dadddf]") inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-bold transition">
                <span class="material-symbols-outlined text-base">view_list</span> Lista
            </button>
            <button @onclick='() => _viewMode = "map"'
                    class="@(_viewMode == "map" ? "bg-[#3b6700] text-[#d9ffad]" : "bg-white text-[#595c5d] border border-[#dadddf]") inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-bold transition">
                <span class="material-symbols-outlined text-base">map</span> Mapa
            </button>
        </div>

        @* Mapa *@
        @if (_viewMode == "map")
        {
            @if (_searchItems.Count > 0)
            {
                <SearchResultsMap AllItems="@_searchItems" />
            }
            else
            {
                <div class="rounded-3xl border border-dashed border-[#dadddf] bg-[#faf8f3] px-5 py-8 text-center">
                    <p class="text-sm font-medium text-[#2c2f30]">No hay coordenadas disponibles para mostrar el mapa.</p>
                </div>
            }
        }

        @* Listado *@
        @if (_viewMode == "list")
        {
        <section class="space-y-4" aria-label="Listado de profesionales">
            @if (_errorMessage is not null)
            {
                <StatusBanner Message="@_errorMessage" Level="warning" />
            }

            @if (_rows.Count == 0 && _errorMessage is null)
            {
                <div class="rounded-3xl border border-dashed border-[#dadddf] bg-[#faf8f3] px-5 py-8 text-center">
                    <p class="text-sm font-medium text-[#2c2f30]">Todavía no hay perfiles que coincidan con este criterio.</p>
                    <p class="mt-2 text-sm text-[#7b8081]">Probá otra búsqueda o volvé más tarde. Los resultados se basan en el nombre y en la oferta de la plataforma.</p>
                </div>
            }
            else
            {
                <ul class="space-y-3">
                    @foreach (var row in FilteredRows)
                    {
                        <li>
                            <a href="@row.Href"
                               class="group flex flex-col gap-4 rounded-3xl border border-[#e8eaec] bg-white p-4 shadow-[0_4px_24px_-12px_rgba(0,0,0,0.08)] transition hover:border-[#a7f255]/60 hover:shadow-[0_8px_32px_-12px_rgba(59,103,0,0.12)] sm:flex-row sm:items-stretch sm:gap-5 sm:p-5">
                                <div class="flex shrink-0 items-center justify-center sm:items-stretch">
                                    @if (!string.IsNullOrWhiteSpace(row.PhotoUrl))
                                    {
                                        <img src="@row.PhotoUrl" alt="@row.Name"
                                             class="h-16 w-16 rounded-2xl object-cover sm:h-20 sm:w-20" />
                                    }
                                    else
                                    {
                                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#3b6700]/10 text-lg font-black tracking-tight text-[#2c4a16] sm:h-20 sm:w-20 sm:text-xl"
                                             aria-hidden="true">@row.Initials</div>
                                    }
                                </div>
                                <div class="min-w-0 flex-1 text-left">
                                    <p class="text-lg font-black tracking-[-0.02em] text-[#2c2f30] group-hover:text-[#3b6700]">@row.Name</p>
                                    @if (!string.IsNullOrWhiteSpace(row.Subtitle))
                                    {
                                        <p class="mt-1 text-sm font-medium text-[#3b6700]">@row.Subtitle</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.Excerpt))
                                    {
                                        <p class="mt-2 max-h-[2.75rem] overflow-hidden text-sm leading-relaxed text-[#595c5d] sm:max-h-[3.25rem]">@row.Excerpt</p>
                                    }
                                </div>
                                <div class="flex shrink-0 items-center sm:flex-col sm:items-end sm:justify-center sm:pl-2">
                                    <span class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-4 py-2.5 text-xs font-bold text-[#d9ffad] sm:min-w-[8.5rem]">Ver perfil</span>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
        }

        <p class="text-center text-sm">
            <a href="/professionals" class="font-bold text-[#3b6700] hover:underline">← Todas las especialidades</a>
        </p>
    }
</main>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private DiscoveryHubItem? _hub;
    private string? _bannerImage;
    private List<ProRow> _rows = new();
    private List<SearchResultItem> _searchItems = new();
    private string _searchQuery = string.Empty;
    private string? _errorMessage;
    private bool _isLoading = true;
    private string? _codeFromQuery;
    private string? _qFromQuery;
    private string? _fetchKey;
    private string _viewMode = "list";

    private IEnumerable<ProRow> FilteredRows
    {
        get
        {
            var t = _searchQuery.Trim();
            if (string.IsNullOrEmpty(t))
            {
                return _rows;
            }
            return _rows.Where(r =>
                (r.Name?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Subtitle?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Excerpt?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _hub = DiscoveryHubCatalog.FindProfessionalBySlug(Slug);
        _rows = new();
        _searchItems = new();
        _bannerImage = _hub is null
            ? null
            : CategoryVisualService.ResolveHubItemImage(_hub, isProfessional: true);

        _codeFromQuery = ReadQuery("code");
        _qFromQuery = ReadQuery("q");

        if (_hub is null)
        {
            _isLoading = false;
            return;
        }

        var effectiveCode = _codeFromQuery?.Trim() ?? _hub.CategoryCode;
        var effectiveQ = _qFromQuery?.Trim() ?? _hub.SearchQuery ?? _hub.Title;
        var newFetchKey = $"{Slug}\u001f{effectiveCode ?? ""}\u001f{effectiveQ}";
        if (string.Equals(_fetchKey, newFetchKey, StringComparison.Ordinal))
        {
            _isLoading = false;
            return;
        }
        _fetchKey = newFetchKey;

        try
        {
            if (!string.IsNullOrWhiteSpace(effectiveCode))
            {
                var d = await BuyerApi.GetCategoryDiscoveryAsync(effectiveCode);
                if (d?.Professionals is { Count: > 0 })
                {
                    _rows = d.Professionals.Select(ProRow.FromCategory).ToList();
                }
            }

            if (!string.IsNullOrWhiteSpace(effectiveQ))
            {
                var searchHits = await BuyerApi.SearchProfessionalsAsync(
                    query: effectiveQ,
                    verified: null,
                    limit: 100);
                if (searchHits is { Count: > 0 })
                {
                    var profHits = searchHits
                        .Where(x => string.Equals(x.Type, "professional", StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    _searchItems = profHits;
                    if (_rows.Count == 0)
                    {
                        _rows = profHits.Select(ProRow.FromSearch).ToList();
                    }
                }
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "No se pudo cargar la información. Reintentá en unos minutos.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string? ReadQuery(string key)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 0 || !string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }
        return null;
    }

    private sealed class ProRow
    {
        public string Name { get; init; } = "";
        public string? Subtitle { get; init; }
        public string? Excerpt { get; init; }
        public string Href { get; init; } = "";
        public string? PhotoUrl { get; init; }
        public string Initials => ToInitials(Name);

        public static ProRow FromCategory(CategoryProfessionalItem p) => new()
        {
            Name = p.Name?.Trim() ?? "Profesional",
            Subtitle = p.Specialty?.Trim(),
            Excerpt = Snippet(p.Bio, 200),
            Href = $"/buyer/detail/professional/{p.Id}",
            PhotoUrl = p.ProfilePhotoUrl
        };

        public static ProRow FromSearch(SearchResultItem s) => new()
        {
            Name = s.Name?.Trim() ?? "Profesional",
            Subtitle = s.Category?.Trim(),
            Excerpt = null,
            Href = !string.IsNullOrWhiteSpace(s.CtaHref) ? s.CtaHref! : $"/buyer/detail/professional/{s.Id}",
            PhotoUrl = s.LogoUrl
        };

        private static string? Snippet(string? text, int max)
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return null;
            }
            var t = text.Trim();
            return t.Length <= max ? t : t[.. max].TrimEnd() + "…";
        }

        private static string ToInitials(string? name)
        {
            if (string.IsNullOrWhiteSpace(name))
            {
                return "??";
            }
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length >= 2)
            {
                return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
            }
            return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
        }
    }
}
