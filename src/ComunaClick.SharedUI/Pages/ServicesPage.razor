@page "/services"
@layout BuyerLayout
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject NavigationManager Navigation

<PageTitle>Servicios - ComunaClic</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-3xl font-bold">Servicios listos para reservar</h1>
        <p class="text-sm text-[#61897c]">Solo mostramos servicios activos de negocios visibles y elegibles.</p>
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        @if (_loading)
        {
            <BrandedLoading Title="Cargando servicios" Message="Estamos preparando las opciones disponibles para reservar." Compact="true" />
        }
        else if (_items.Count == 0)
        {
            <StatusBanner Message="No encontramos servicios elegibles por ahora." Level="warning" />
        }
        else
        {
            <div class="space-y-3">
                @foreach (var item in _items)
                {
                    <div class="flex items-center justify-between gap-4 border-b border-gray-100 dark:border-gray-800 pb-3 last:border-b-0">
                        <div>
                            <p class="font-semibold">@item.Name</p>
                            <p class="text-xs text-[#61897c]">@item.Category</p>
                        </div>
                        <div class="flex items-center gap-3">
                            @if (item.Price.HasValue)
                            {
                                <span class="font-semibold">@($"{item.Price.Value:N0}")</span>
                            }
                            <a href="@(item.CtaHref ?? $"/buyer/detail/service/{item.Id}")" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-xs">@(item.CtaLabel ?? "Reservar")</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var results = await BuyerApi.SearchAsync(null, "services", 24, ReadGeoFromQuery());
        if (results is not null)
        {
            _items.AddRange(results);
        }
        _loading = false;
    }

    private ComunaClick.Shared.Api.Buyer.GeoFilter? ReadGeoFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        return ReadGeo(uri.Query);
    }

    private static ComunaClick.Shared.Api.Buyer.GeoFilter? ReadGeo(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        query = query.TrimStart('?');
        Guid? Read(string key)
        {
            foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = pair.Split('=', 2);
                if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase)) continue;
                return parts.Length > 1 && Guid.TryParse(Uri.UnescapeDataString(parts[1]), out var parsed) ? parsed : null;
            }
            return null;
        }
        var countryId = Read("countryId");
        var regionId = Read("regionId");
        var comunaId = Read("comunaId");
        return countryId.HasValue || regionId.HasValue || comunaId.HasValue ? new ComunaClick.Shared.Api.Buyer.GeoFilter(countryId, regionId, comunaId) : null;
    }
}
