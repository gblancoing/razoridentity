@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Auth.Interfaces.IAuthClient AuthClient
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Crear cuenta - ComunaClic</PageTitle>

<div class="min-h-screen bg-[#f7fbf9] dark:bg-background-dark">
    <header class="sticky top-0 z-50 w-full bg-white dark:bg-background-dark border-b border-[#dbe6e2] dark:border-white/10">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a class="material-symbols-outlined text-[#111816] dark:text-white cursor-pointer" href="/login">arrow_back</a>
                <img src="_content/ComunaClick.SharedUI/logo.png" alt="ComunaClic" class="h-14 w-auto" />
            </div>
            <div class="flex items-center gap-4">
                <LanguageToggle />
                <a class="text-sm font-semibold text-primary hover:underline" href="/login">Ya tengo cuenta</a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <aside class="lg:col-span-5 space-y-6">
                <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6">
                    <p class="text-xs uppercase tracking-[0.2em] text-primary font-bold">@HeroEyebrow</p>
                    <h1 class="mt-3 text-3xl font-bold text-[#111816] dark:text-white">@HeroTitle</h1>
                    <p class="mt-3 text-sm text-[#61897c]">
                        @HeroDescription
                    </p>
                </div>

                <div class="rounded-2xl border border-[#dbe6e2] dark:border-white/10 bg-white dark:bg-[#1a2e28] p-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <a href="/register?intent=buyer"
                           class="@GetIntentCardClass("buyer")">
                            <span class="material-symbols-outlined text-primary">event_available</span>
                            <div>
                                <p class="font-bold text-[#111816] dark:text-white">Cuenta personal</p>
                                <p class="text-sm text-[#61897c]">Para reservar horas, comprar y seguir negocios.</p>
                            </div>
                        </a>
                        <a href="/register?intent=partner"
                           class="@GetIntentCardClass("partner")">
                            <span class="material-symbols-outlined text-primary">storefront</span>
                            <div>
                                <p class="font-bold text-[#111816] dark:text-white">Soy partner</p>
                                <p class="text-sm text-[#61897c]">Para crear negocio, catálogo y publicar.</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="rounded-2xl border border-[#dbe6e2] dark:border-white/10 bg-white dark:bg-[#1a2e28] p-6 space-y-4">
                    <h2 class="text-lg font-bold text-[#111816] dark:text-white">Qué pasará después</h2>
                    <div class="space-y-3 text-sm text-[#111816] dark:text-gray-200">
                        <div class="flex gap-3">
                            <span class="material-symbols-outlined text-primary">person_add</span>
                            <span>Se crea tu cuenta con correo y contraseña.</span>
                        </div>
                        @if (IsPartnerIntent)
                        {
                            <div class="flex gap-3">
                                <span class="material-symbols-outlined text-primary">storefront</span>
                                <span>Sigues al paso donde crearás tu primer negocio.</span>
                            </div>
                            <div class="flex gap-3">
                                <span class="material-symbols-outlined text-primary">checklist</span>
                                <span>Luego completas catálogo y publicación según el tipo de partner.</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex gap-3">
                                <span class="material-symbols-outlined text-primary">travel_explore</span>
                                <span>Entras a tu vista buyer para buscar negocios, servicios y profesionales.</span>
                            </div>
                            <div class="flex gap-3">
                                <span class="material-symbols-outlined text-primary">bookmark_added</span>
                                <span>Podrás reservar, comprar o retomar tu búsqueda cuando quieras.</span>
                            </div>
                        }
                    </div>
                </div>

                @if (IsPartnerIntent)
                {
                    <div class="rounded-2xl border border-yellow-200 bg-yellow-50 p-5 text-sm text-yellow-800">
                        No estás publicando todavía.
                        En esta pantalla solo se crea la cuenta de acceso para continuar con la activación.
                    </div>
                }
                else
                {
                    <div class="rounded-2xl border border-sky-200 bg-sky-50 p-5 text-sm text-sky-800">
                        Esta cuenta es para uso personal.
                        Después de crearla entrarás directo a la experiencia buyer para buscar y reservar.
                    </div>
                }
            </aside>

            <section class="lg:col-span-7 rounded-2xl border border-[#dbe6e2] dark:border-white/10 bg-white dark:bg-[#1a2e28] p-6 lg:p-8">
                <div class="mb-6">
                    <p class="text-xs uppercase tracking-[0.2em] text-primary font-bold">Cuenta</p>
                    <h2 class="mt-2 text-2xl font-bold text-[#111816] dark:text-white">@FormTitle</h2>
                    <p class="mt-2 text-sm text-[#61897c]">@FormDescription</p>
                </div>

                @if (_loadingSession)
                {
                    <BrandedLoading Title="Cargando sesion" Message="Estamos verificando si ya tienes acceso activo." />
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                        <DataAnnotationsValidator />
                        <div class="space-y-5">
                            @if (!string.IsNullOrWhiteSpace(_statusMessage))
                            {
                                <StatusBanner Level="@_statusLevel" Message="@_statusMessage" />
                            }

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                    <label class="text-sm font-semibold text-[#111816] dark:text-white">Nombre</label>
                                    <input class="mt-1 w-full rounded-lg border border-[#dbe6e2] dark:border-white/10 dark:bg-[#10221c] dark:text-white px-4 h-12"
                                           @bind="_model.Name" />
                                    <ValidationMessage For="@(() => _model.Name)" class="text-xs text-red-500" />
                                </div>

                                <div class="md:col-span-2">
                                    <label class="text-sm font-semibold text-[#111816] dark:text-white">Correo</label>
                                    <input type="email"
                                           class="mt-1 w-full rounded-lg border border-[#dbe6e2] dark:border-white/10 dark:bg-[#10221c] dark:text-white px-4 h-12"
                                           @bind="_model.Email" />
                                    <ValidationMessage For="@(() => _model.Email)" class="text-xs text-red-500" />
                                </div>

                                <div>
                                    <label class="text-sm font-semibold text-[#111816] dark:text-white">Contraseña</label>
                                    <input type="password"
                                           class="mt-1 w-full rounded-lg border border-[#dbe6e2] dark:border-white/10 dark:bg-[#10221c] dark:text-white px-4 h-12"
                                           @bind="_model.Password" />
                                    <ValidationMessage For="@(() => _model.Password)" class="text-xs text-red-500" />
                                </div>

                                <div>
                                    <label class="text-sm font-semibold text-[#111816] dark:text-white">Confirmar contraseña</label>
                                    <input type="password"
                                           class="mt-1 w-full rounded-lg border border-[#dbe6e2] dark:border-white/10 dark:bg-[#10221c] dark:text-white px-4 h-12"
                                           @bind="_model.ConfirmPassword" />
                                    <ValidationMessage For="@(() => _model.ConfirmPassword)" class="text-xs text-red-500" />
                                </div>
                            </div>

                            <label class="flex items-start gap-3 rounded-xl border border-[#dbe6e2] dark:border-white/10 p-4">
                                <input type="checkbox" class="mt-1" @bind="_model.AcceptFlow" />
                                <span class="text-sm text-[#111816] dark:text-gray-200">
                                    @AcceptLabel
                                </span>
                            </label>

                            <div class="flex flex-col sm:flex-row gap-3 sm:justify-between sm:items-center">
                                <a href="/login" class="text-sm font-semibold text-[#61897c] hover:text-primary">Prefiero iniciar sesión</a>
                                <button type="submit"
                                        class="bg-primary text-[#111816] px-6 py-3 rounded-lg font-bold text-sm disabled:opacity-60"
                                        disabled="@_isSubmitting">
                                    @(_isSubmitting ? "Creando cuenta..." : SubmitLabel)
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </section>
        </div>
    </main>
</div>

@code {
    private readonly RegisterAccountModel _model = new();
    private bool _loadingSession = true;
    private bool _isSubmitting;
    private bool _checkedAuth;
    private string? _statusMessage;
    private string _statusLevel = "info";
    private string _intent = "buyer";

    private bool IsPartnerIntent => string.Equals(_intent, "partner", StringComparison.OrdinalIgnoreCase);
    private string HeroEyebrow => IsPartnerIntent ? "Pre-onboarding partner" : "Cuenta personal";
    private string HeroTitle => IsPartnerIntent ? "Crea tu cuenta y sigue con tu negocio" : "Crea tu cuenta para reservar y explorar";
    private string HeroDescription => IsPartnerIntent
        ? "Este paso crea tu acceso personal a ComunaClic. Apenas termine, te llevaremos al formulario para crear tu negocio."
        : "Este paso crea tu acceso personal a ComunaClic para buscar negocios, reservar servicios y seguir tus próximas compras.";
    private string FormTitle => IsPartnerIntent ? "Regístrate gratis" : "Crea tu cuenta personal";
    private string FormDescription => IsPartnerIntent
        ? "Usa un correo real. Después podrás entrar con él y seguir con la creación del negocio."
        : "Usa un correo real. Después podrás entrar con él y usar la experiencia buyer de ComunaClic.";
    private string AcceptLabel => IsPartnerIntent
        ? "Entiendo que después de crear mi cuenta continuaré con el registro del negocio."
        : "Entiendo que esta cuenta será mi acceso personal para buscar, reservar o comprar en ComunaClic.";
    private string SubmitLabel => IsPartnerIntent ? "Crear cuenta y continuar con mi negocio" : "Crear cuenta personal";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        _intent = ReadIntent();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;
        try
        {
            await AuthState.InitializeAsync();
            if (AuthState.IsAuthenticated)
            {
                Navigation.NavigateTo(IsPartnerIntent ? "/register/business" : "/buyer", true);
                return;
            }

            _loadingSession = false;
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            _checkedAuth = false;
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private async Task HandleSubmitAsync()
    {
        if (!_model.AcceptFlow)
        {
            _statusLevel = "warning";
            _statusMessage = IsPartnerIntent
                ? "Debes confirmar que continuarás con el registro del negocio en el siguiente paso."
                : "Debes confirmar que crearás tu cuenta personal para continuar.";
            return;
        }

        if (!string.Equals(_model.Password, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _statusLevel = "error";
            _statusMessage = "Las contraseñas no coinciden.";
            return;
        }

        _isSubmitting = true;
        _statusMessage = null;

        try
        {
            var tokens = await AuthClient.RegisterAsync(new ComunaClick.Shared.Auth.RegisterRequest(
                _model.Name.Trim(),
                _model.Email.Trim(),
                _model.Password));

            await AuthState.SetTokensAsync(tokens);
            Navigation.NavigateTo(IsPartnerIntent ? "/register/business" : "/buyer", true);
        }
        catch (Exception ex)
        {
            _statusLevel = "error";
            _statusMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string ReadIntent()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return "buyer";
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), "intent", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            return string.Equals(value, "partner", StringComparison.OrdinalIgnoreCase) ? "partner" : "buyer";
        }

        return "buyer";
    }

    private string GetIntentCardClass(string intent)
    {
        var isActive = string.Equals(_intent, intent, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "flex items-start gap-3 rounded-xl border border-primary bg-primary/5 p-4"
            : "flex items-start gap-3 rounded-xl border border-[#dbe6e2] dark:border-white/10 p-4 hover:border-primary/40 transition-colors";
    }

    private sealed class RegisterAccountModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Ingresa un correo valido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma tu contraseña.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public bool AcceptFlow { get; set; }
    }
}
