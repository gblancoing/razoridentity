@page "/partner/agenda"
@layout ComunaClick.SharedUI.Layouts.PartnerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable
@using PartnerBooking = ComunaClick.Shared.Api.Partner.Booking

<PageTitle>@L.T("partner.agenda.title")</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">@L.T("partner.agenda.heading")</h1>
            <p class="text-sm text-[#61897c]">@L.T("partner.agenda.subtitle")</p>
        </div>
        <a href="/partner/quickstart" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm">Crear primer servicio</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h2 class="font-semibold mb-4">@L.T("partner.agenda.calendar")</h2>
            <div class="h-56 border border-dashed border-gray-300 dark:border-gray-700 rounded-lg flex items-center justify-center text-sm text-[#61897c]">
                @L.T("partner.agenda.placeholder")
            </div>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h2 class="font-semibold mb-4">@L.T("partner.agenda.today")</h2>
            <div class="space-y-3 text-sm">
                @if (_isLoading)
                {
                    <div class="text-[#61897c]">@L.T("ui.loading")</div>
                }
                else if (_bookings.Count == 0)
                {
                    <div class="text-[#61897c] space-y-3">
                        <div>@_statusMessage</div>
                        <a href="/partner/quickstart" class="inline-flex bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm">Cargar primer servicio</a>
                    </div>
                }
                else
                {
                    @foreach (var booking in _bookings)
                    {
                        <div class="flex justify-between">
                            <span>@booking.StartAt.ToLocalTime().ToString("HH:mm")</span>
                            <span>@booking.Status</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<PartnerBooking> _bookings = new();
    private string _statusMessage = "—";
    private bool _isLoading;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            _isLoading = false;
            return;
        }

        var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
        if (bookings is not null)
        {
            _bookings.AddRange(bookings);
        }
        _statusMessage = _bookings.Count == 0 ? L.T("partner.status.noBookings") : string.Empty;
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
