@page "/partner/agenda"
@layout PartnerLayout
@using System.Net
@using System.Globalization
@using ComunaClick.SharedUI.Services.Partner
@using DayBookingStats = ComunaClick.SharedUI.Components.Partner.PartnerAgendaCalendar.DayBookingStats
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable
@using PartnerBooking = ComunaClick.Shared.Api.Partner.Booking

<PageTitle>@L.T("partner.agenda.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">@L.T("partner.agenda.badge")</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.agenda.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.agenda.subtitle")</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @foreach (var filter in AgendaFilters)
            {
                <button type="button" class="@GetFilterClass(filter.Key)" @onclick="() => ApplyFilter(filter.Key)">
                    @filter.Label
                </button>
            }
            <a href="/partner/catalog" class="inline-flex items-center gap-2 rounded-2xl border border-[#3b6700]/30 bg-white px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#eff8e0]">
                <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                @L.T("partner.agenda.catalogLink")
            </a>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <article class="rounded-2xl border border-[#e3e6e8] bg-white p-5 shadow-sm">
            <p class="text-[10px] font-bold uppercase tracking-wide text-[#7b8081]">@L.T("partner.agenda.stat.month")</p>
            <p class="mt-2 text-3xl font-black text-[#2c2f30]">@MonthBookingCount</p>
        </article>
        <article class="rounded-2xl border border-[#76BC21]/30 bg-[#f5fbf0] p-5">
            <p class="text-[10px] font-bold uppercase tracking-wide text-[#325800]">@L.T("partner.agenda.legend.pending")</p>
            <p class="mt-2 text-3xl font-black text-[#325800]">@MonthPendingCount</p>
        </article>
        <article class="rounded-2xl border border-[#3b82f6]/30 bg-[#f0f6ff] p-5">
            <p class="text-[10px] font-bold uppercase tracking-wide text-[#1e4a8a]">@L.T("partner.agenda.legend.completed")</p>
            <p class="mt-2 text-3xl font-black text-[#1e4a8a]">@MonthCompletedCount</p>
        </article>
        <article class="rounded-2xl border border-[#ef4444]/30 bg-[#fff5f5] p-5">
            <p class="text-[10px] font-bold uppercase tracking-wide text-[#8f2200]">@L.T("partner.agenda.legend.missed")</p>
            <p class="mt-2 text-3xl font-black text-[#8f2200]">@MonthMissedCount</p>
        </article>
    </div>

    <PartnerAgendaCalendar Month="@_calendarMonth"
                           SelectedDate="@_selectedDate"
                           StatsByDay="@_statsByDay"
                           MonthChanged="OnMonthChangedAsync"
                           SelectedDateChanged="OnSelectedDateChangedAsync" />

    <PartnerAgendaKanban PendingBookings="@KanbanPending"
                         CompletedBookings="@KanbanCompleted"
                         MissedBookings="@KanbanMissed"
                         ServiceNames="@_serviceNames"
                         SelectedDayLabel="@SelectedDayLabel"
                         EmptyMessage="@KanbanEmptyMessage"
                         IsLoading="@_isLoading"
                         UpdatingBookingId="@_updatingBookingId"
                         SelectedBookingId="@_selectedBooking?.Id"
                         OnSelectBooking="SelectBookingAsync" />

    @if (_selectedBooking is not null)
    {
        <section class="rounded-[2rem] border-2 border-[#3b6700]/25 bg-white p-6 md:p-8 shadow-[0_12px_40px_-24px_rgba(0,0,0,0.12)] space-y-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@L.T("partner.agenda.detail.badge")</p>
                    <h2 class="mt-1 text-xl font-black text-[#2c2f30]">@GetServiceName(_selectedBooking.ServiceId)</h2>
                    <p class="mt-1 text-sm text-[#595c5d]">@_selectedBooking.StartAt.ToLocalTime().ToString("dddd dd MMM yyyy · HH:mm", EsCulture) – @_selectedBooking.EndAt.ToLocalTime().ToString("HH:mm")</p>
                </div>
                <span class="@GetBookingStatusClass(_selectedBooking.Status)">@MapBookingStatus(_selectedBooking.Status)</span>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                <div class="rounded-xl bg-[#f5f6f7] p-3">
                    <p class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.detail.duration")</p>
                    <p class="mt-1 font-bold">@FormatDuration(_selectedBooking)</p>
                </div>
                <div class="rounded-xl bg-[#f5f6f7] p-3">
                    <p class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.detail.amount")</p>
                    <p class="mt-1 font-bold text-[#3b6700]">@FormatMoney(_selectedBooking.Amount, _selectedBooking.Currency)</p>
                </div>
                <div class="rounded-xl bg-[#f5f6f7] p-3 md:col-span-2">
                    <p class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.detail.hint")</p>
                    <p class="mt-1 text-xs text-[#595c5d]">@GetOperationalHint(_selectedBooking)</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedBooking.InternalNote) || !string.IsNullOrWhiteSpace(_selectedBooking.OutcomeReason))
            {
                <div class="rounded-xl bg-[#fafaf8] border border-[#e8eaec] px-4 py-3 text-sm text-[#595c5d]">
                    @if (!string.IsNullOrWhiteSpace(_selectedBooking.InternalNote))
                    {
                        <p><span class="font-bold text-[#2c2f30]">@L.T("partner.agenda.detail.note"):</span> @_selectedBooking.InternalNote</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedBooking.OutcomeReason))
                    {
                        <p class="mt-1"><span class="font-bold text-[#2c2f30]">@L.T("partner.agenda.detail.reason"):</span> @_selectedBooking.OutcomeReason</p>
                    }
                </div>
            }

            <div class="flex flex-wrap gap-2">
                @if (PartnerAgendaBookingCategories.IsPending(_selectedBooking.Status))
                {
                    <button type="button" class="inline-flex items-center rounded-xl bg-[#76BC21] px-4 py-2 text-xs font-bold text-white" disabled="@(_updatingBookingId == _selectedBooking.Id)" @onclick='() => SetBookingStatusAsync(_selectedBooking.Id, "confirmed")'>
                        @L.T("partner.agenda.action.confirm")
                    </button>
                    <button type="button" class="inline-flex items-center rounded-xl bg-[#3b82f6] px-4 py-2 text-xs font-bold text-white" disabled="@(_updatingBookingId == _selectedBooking.Id)" @onclick='() => SetBookingStatusAsync(_selectedBooking.Id, "completed")'>
                        @L.T("partner.agenda.action.complete")
                    </button>
                }
                <button type="button" class="inline-flex items-center rounded-xl border border-[#ef4444]/40 bg-[#fff5f5] px-4 py-2 text-xs font-bold text-[#8f2200]" disabled="@(_updatingBookingId == _selectedBooking.Id)" @onclick='() => MarkBookingOutcome(_selectedBooking, "no_show")'>
                    @L.T("partner.agenda.action.noshow")
                </button>
                <button type="button" class="inline-flex items-center rounded-xl border border-[#dadddf] px-4 py-2 text-xs font-bold text-[#2c2f30]" @onclick="() => ToggleBookingWorkflow(_selectedBooking)">
                    @(_editingBookingIds.Contains(_selectedBooking.Id) ? L.T("partner.agenda.action.hideEdit") : L.T("partner.agenda.action.edit"))
                </button>
                <button type="button" class="inline-flex items-center rounded-xl border border-[#dadddf] px-4 py-2 text-xs font-bold text-[#595c5d]" @onclick="ClearSelection">
                    @L.T("partner.agenda.action.close")
                </button>
            </div>

            @if (_editingBookingIds.Contains(_selectedBooking.Id))
            {
                var draft = GetBookingDraft(_selectedBooking);
                <div class="rounded-2xl border border-[#dadddf] bg-[#fafaf8] p-4 space-y-3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.field.status")</label>
                            <select class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2 text-sm" @bind="draft.Status">
                                <option value="pending">@L.T("partner.agenda.status.pending")</option>
                                <option value="payment_pending">@L.T("partner.agenda.status.payment_pending")</option>
                                <option value="confirmed">@L.T("partner.agenda.status.confirmed")</option>
                                <option value="completed">@L.T("partner.agenda.status.completed")</option>
                                <option value="no_show">@L.T("partner.agenda.status.noshow")</option>
                                <option value="cancelled">@L.T("partner.agenda.status.cancelled")</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.field.start")</label>
                            <input class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2 text-sm" @bind="draft.StartAtLocal" />
                        </div>
                        <div>
                            <label class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.field.end")</label>
                            <input class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2 text-sm" @bind="draft.EndAtLocal" />
                        </div>
                        <div>
                            <label class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.field.reason")</label>
                            <input class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2 text-sm" @bind="draft.OutcomeReason" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="text-[10px] font-bold uppercase text-[#7b8081]">@L.T("partner.agenda.field.note")</label>
                            <textarea rows="3" class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2 text-sm" @bind="draft.InternalNote"></textarea>
                        </div>
                    </div>
                    <button type="button" class="inline-flex items-center rounded-xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad]" @onclick='() => SaveBookingWorkflowAsync(_selectedBooking.Id)' disabled="@(_savingBookingWorkflowId == _selectedBooking.Id)">
                        @(_savingBookingWorkflowId == _selectedBooking.Id ? L.T("partner.agenda.saving") : L.T("partner.agenda.save"))
                    </button>
                </div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <StatusBanner Message="@_actionMessage" Level="@_actionLevel" />
    }
</div>

@code {
    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-CL");

    private readonly List<PartnerBooking> _bookings = new();
    private readonly Dictionary<Guid, string> _serviceNames = new();
    private readonly Dictionary<DateTime, DayBookingStats> _statsByDay = new();
    private readonly HashSet<Guid> _editingBookingIds = new();
    private readonly Dictionary<Guid, BookingWorkflowDraft> _bookingDrafts = new();

    private DateTime _calendarMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _selectedDate = DateTime.Today;
    private PartnerBooking? _selectedBooking;
    private string _selectedFilter = "all";
    private bool _isLoading;
    private Guid? _updatingBookingId;
    private Guid? _savingBookingWorkflowId;
    private string? _actionMessage;
    private string _actionLevel = "info";

    private IReadOnlyList<FilterOption> AgendaFilters => new[]
    {
        new FilterOption("all", L.T("partner.agenda.filter.all")),
        new FilterOption("today", L.T("partner.agenda.filter.today")),
        new FilterOption("pending", L.T("partner.agenda.filter.pending")),
        new FilterOption("completed", L.T("partner.agenda.filter.completed"))
    };

    private IEnumerable<PartnerBooking> ScopeBookings
    {
        get
        {
            IEnumerable<PartnerBooking> query = _bookings;
            if (_selectedDate.HasValue)
            {
                var day = _selectedDate.Value.Date;
                query = query.Where(b => b.StartAt.ToLocalTime().Date == day);
            }
            else
            {
                query = query.Where(b =>
                    b.StartAt.ToLocalTime().Year == _calendarMonth.Year
                    && b.StartAt.ToLocalTime().Month == _calendarMonth.Month);
            }

            return query.Where(MatchesFilter).OrderBy(x => x.StartAt);
        }
    }

    private List<PartnerBooking> KanbanPending => ScopeBookings.Where(b => PartnerAgendaBookingCategories.GetColumn(b.Status) == AgendaBookingColumn.Pending).ToList();
    private List<PartnerBooking> KanbanCompleted => ScopeBookings.Where(b => PartnerAgendaBookingCategories.GetColumn(b.Status) == AgendaBookingColumn.Completed).ToList();
    private List<PartnerBooking> KanbanMissed => ScopeBookings.Where(b => PartnerAgendaBookingCategories.GetColumn(b.Status) == AgendaBookingColumn.Missed).ToList();

    private IEnumerable<PartnerBooking> MonthBookings => _bookings.Where(b =>
        b.StartAt.ToLocalTime().Year == _calendarMonth.Year && b.StartAt.ToLocalTime().Month == _calendarMonth.Month);

    private int MonthBookingCount => MonthBookings.Count();
    private int MonthPendingCount => MonthBookings.Count(b => PartnerAgendaBookingCategories.IsPending(b.Status));
    private int MonthCompletedCount => MonthBookings.Count(b => PartnerAgendaBookingCategories.IsCompleted(b.Status));
    private int MonthMissedCount => MonthBookings.Count(b => PartnerAgendaBookingCategories.IsMissed(b.Status));

    private string? SelectedDayLabel => _selectedDate.HasValue
        ? string.Format(L.T("partner.agenda.kanban.dayLabel"), _selectedDate.Value.ToString("dddd dd MMM", EsCulture))
        : string.Format(L.T("partner.agenda.kanban.monthLabel"), _calendarMonth.ToString("MMMM yyyy", EsCulture));

    private string KanbanEmptyMessage => _selectedDate.HasValue
        ? L.T("partner.agenda.kanban.emptyDay")
        : L.T("partner.agenda.kanban.emptyMonth");

    protected override void OnInitialized() => L.OnChange += HandleChange;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            _actionMessage = L.T("partner.status.loginRequired");
            _actionLevel = "error";
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _actionMessage = L.T("partner.status.noPartner");
            _actionLevel = "error";
            _isLoading = false;
            return;
        }

        try
        {
            var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
            if (bookings is not null)
            {
                _bookings.AddRange(bookings);
            }

            var services = await PartnerApi.GetPartnerServicesAsync(partnerId.Value);
            if (services is not null)
            {
                foreach (var s in services)
                {
                    if (!string.IsNullOrWhiteSpace(s.Name))
                    {
                        _serviceNames[s.Id] = s.Name!;
                    }
                }
            }

            RebuildStatsByDay();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _actionMessage = L.T("partner.agenda.error.forbidden");
            _actionLevel = "error";
        }
        catch (HttpRequestException)
        {
            _actionMessage = L.T("partner.agenda.error.load");
            _actionLevel = "error";
        }

        _isLoading = false;
    }

    private void RebuildStatsByDay()
    {
        _statsByDay.Clear();
        foreach (var group in _bookings.GroupBy(b => b.StartAt.ToLocalTime().Date))
        {
            var (p, c, m) = PartnerAgendaBookingCategories.CountByColumn(group);
            _statsByDay[group.Key] = new DayBookingStats(p, c, m);
        }
    }

    private Task OnMonthChangedAsync(DateTime month)
    {
        _calendarMonth = new DateTime(month.Year, month.Month, 1);
        _selectedDate = null;
        _selectedBooking = null;
        return Task.CompletedTask;
    }

    private Task OnSelectedDateChangedAsync(DateTime? date)
    {
        _selectedDate = date?.Date;
        _selectedBooking = null;
        return Task.CompletedTask;
    }

    private void ApplyFilter(string key)
    {
        _selectedFilter = key;
        _selectedBooking = null;
    }

    private Task SelectBookingAsync(PartnerBooking booking)
    {
        _selectedBooking = booking;
        return Task.CompletedTask;
    }

    private void ClearSelection() => _selectedBooking = null;

    private async Task SetBookingStatusAsync(Guid bookingId, string status)
    {
        _updatingBookingId = bookingId;
        try
        {
            var updated = await PartnerApi.UpdateBookingStatusAsync(bookingId, new ComunaClick.Shared.Api.Partner.BookingStatusUpdateRequest(status));
            if (updated is not null)
            {
                ReplaceBooking(updated);
                if (_selectedBooking?.Id == bookingId)
                {
                    _selectedBooking = updated;
                }
                _actionMessage = L.T("partner.agenda.saved");
                _actionLevel = "success";
            }
        }
        catch (HttpRequestException)
        {
            _actionMessage = L.T("partner.agenda.error.update");
            _actionLevel = "error";
        }
        finally
        {
            _updatingBookingId = null;
        }
    }

    private void MarkBookingOutcome(PartnerBooking booking, string status)
    {
        if (!_editingBookingIds.Contains(booking.Id))
        {
            _editingBookingIds.Add(booking.Id);
            _bookingDrafts[booking.Id] = BookingWorkflowDraft.FromBooking(booking);
        }
        GetBookingDraft(booking).Status = status;
        _ = SaveBookingWorkflowAsync(booking.Id);
    }

    private void ToggleBookingWorkflow(PartnerBooking booking)
    {
        if (_editingBookingIds.Contains(booking.Id))
        {
            _editingBookingIds.Remove(booking.Id);
            return;
        }
        _editingBookingIds.Add(booking.Id);
        _bookingDrafts[booking.Id] = BookingWorkflowDraft.FromBooking(booking);
    }

    private BookingWorkflowDraft GetBookingDraft(PartnerBooking booking)
    {
        if (!_bookingDrafts.TryGetValue(booking.Id, out var draft))
        {
            draft = BookingWorkflowDraft.FromBooking(booking);
            _bookingDrafts[booking.Id] = draft;
        }
        return draft;
    }

    private async Task SaveBookingWorkflowAsync(Guid bookingId)
    {
        if (!_bookingDrafts.TryGetValue(bookingId, out var draft))
        {
            return;
        }

        if (!TryParseLocalDate(draft.StartAtLocal, out var startAt, out var err) ||
            !TryParseLocalDate(draft.EndAtLocal, out var endAt, out err))
        {
            _actionMessage = err;
            _actionLevel = "error";
            return;
        }

        if ((draft.Status is "cancelled" or "no_show") && string.IsNullOrWhiteSpace(draft.OutcomeReason))
        {
            _actionMessage = L.T("partner.agenda.error.reasonRequired");
            _actionLevel = "error";
            return;
        }

        _savingBookingWorkflowId = bookingId;
        try
        {
            var updated = await PartnerApi.UpdateBookingWorkflowAsync(bookingId, new ComunaClick.Shared.Api.Partner.BookingWorkflowUpdateRequest(
                draft.Status, startAt, endAt, draft.InternalNote, draft.OutcomeReason));
            if (updated is not null)
            {
                ReplaceBooking(updated);
                _editingBookingIds.Remove(bookingId);
                _bookingDrafts.Remove(bookingId);
                if (_selectedBooking?.Id == bookingId)
                {
                    _selectedBooking = updated;
                }
                _actionMessage = L.T("partner.agenda.saved");
                _actionLevel = "success";
            }
        }
        catch (HttpRequestException)
        {
            _actionMessage = L.T("partner.agenda.error.update");
            _actionLevel = "error";
        }
        finally
        {
            _savingBookingWorkflowId = null;
        }
    }

    private void ReplaceBooking(PartnerBooking updated)
    {
        var index = _bookings.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            _bookings[index] = updated;
        }
        else
        {
            _bookings.Add(updated);
        }
        RebuildStatsByDay();
    }

    private bool MatchesFilter(PartnerBooking booking) => _selectedFilter switch
    {
        "today" => booking.StartAt.ToLocalTime().Date == DateTime.Today,
        "pending" => PartnerAgendaBookingCategories.IsPending(booking.Status),
        "completed" => PartnerAgendaBookingCategories.IsCompleted(booking.Status),
        _ => true
    };

    private string GetServiceName(Guid serviceId)
        => _serviceNames.TryGetValue(serviceId, out var n) ? n : L.T("partner.agenda.service.unknown");

    private string GetFilterClass(string key) => key == _selectedFilter
        ? "inline-flex items-center rounded-full bg-[#2c2f30] text-white px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]"
        : "inline-flex items-center rounded-full bg-white border border-[#dadddf] text-[#595c5d] px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]";

    private static bool TryParseLocalDate(string? raw, out DateTimeOffset parsed, out string error)
    {
        parsed = default;
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(raw) || !DateTime.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var local))
        {
            error = "Formato de fecha inválido.";
            return false;
        }
        parsed = new DateTimeOffset(local);
        return true;
    }

    private static string MapBookingStatus(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "confirmed" => "Confirmada",
        "pending" => "Pendiente",
        "payment_pending" => "Pago pendiente",
        "no_show" => "No asistió",
        "cancelled" or "canceled" => "Cancelada",
        "completed" => "Completada",
        _ => status ?? "—"
    };

    private static string GetBookingStatusClass(string? status) => PartnerAgendaBookingCategories.GetColumn(status) switch
    {
        AgendaBookingColumn.Completed => "inline-flex rounded-full bg-[#dbeafe] px-3 py-1 text-[10px] font-bold uppercase text-[#1e4a8a]",
        AgendaBookingColumn.Missed => "inline-flex rounded-full bg-[#fee2e2] px-3 py-1 text-[10px] font-bold uppercase text-[#8f2200]",
        _ => "inline-flex rounded-full bg-[#dcfce7] px-3 py-1 text-[10px] font-bold uppercase text-[#325800]"
    };

    private static string GetOperationalHint(PartnerBooking booking) => booking.Status?.Trim().ToLowerInvariant() switch
    {
        "completed" => "Atención cerrada correctamente.",
        "no_show" => "Cliente no asistió. Registrá motivo si aplica.",
        "cancelled" or "canceled" => "Cita cancelada; el bloque quedó liberado.",
        _ => "Cita por atender. Confirmá o completá según corresponda."
    };

    private static string FormatDuration(PartnerBooking booking)
    {
        var d = booking.EndAt - booking.StartAt;
        return d.TotalMinutes <= 0 ? "—" : $"{Math.Round(d.TotalMinutes)} min";
    }

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleChange;

    private sealed record FilterOption(string Key, string Label);

    private sealed class BookingWorkflowDraft
    {
        public string? Status { get; set; }
        public string? StartAtLocal { get; set; }
        public string? EndAtLocal { get; set; }
        public string? InternalNote { get; set; }
        public string? OutcomeReason { get; set; }

        public static BookingWorkflowDraft FromBooking(PartnerBooking b) => new()
        {
            Status = b.Status?.Trim().ToLowerInvariant(),
            StartAtLocal = b.StartAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
            EndAtLocal = b.EndAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
            InternalNote = b.InternalNote,
            OutcomeReason = b.OutcomeReason
        };
    }
}
