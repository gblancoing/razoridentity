@page "/partner/agenda"
@layout PartnerLayout
@using System.Net
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable
@using PartnerBooking = ComunaClick.Shared.Api.Partner.Booking

<PageTitle>@L.T("partner.agenda.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">Agenda editorial</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.agenda.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.agenda.subtitle")</p>
        </div>
        <a href="/partner/quickstart" class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]">
            <span class="material-symbols-outlined text-[20px]">calendar_add_on</span>
            Crear primer servicio
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">RESERVAS</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_bookings.Count</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Reservas visibles en la agenda actual.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">PRÓXIMA HORA</p>
            <h2 class="text-3xl font-black tracking-[-0.04em] text-[#2c2f30]">@NextBookingLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Primera reserva disponible en el listado actual.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">ESTADO</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@StatusLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@_statusMessage</p>
        </article>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <section class="xl:col-span-2 bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
            <div class="flex items-center justify-between gap-4 mb-8">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">Calendario</p>
                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.agenda.calendar")</h2>
                </div>
            </div>
            <div class="bg-white rounded-3xl min-h-[320px] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] p-6">
                <div class="grid grid-cols-7 gap-2 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-[#7b8081] mb-4">
                    <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
                </div>
                <div class="grid grid-cols-7 gap-2">
                    @foreach (var day in CalendarDays)
                    {
                        <div class="@GetCalendarDayClass(day)">
                            <span class="text-sm font-bold">@day.ToString("dd")</span>
                            @if (HasBookingOnDay(day))
                            {
                                <span class="mt-2 inline-flex h-2 w-2 rounded-full bg-[#76BC21]"></span>
                            }
                        </div>
                    }
                </div>
                <p class="mt-6 text-xs text-[#595c5d]">Los días marcados muestran reservas registradas en tu agenda actual.</p>
            </div>
        </section>

        <section class="bg-white rounded-[2rem] p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <div class="flex items-center justify-between gap-4 mb-8">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">Hoy</p>
                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.agenda.today")</h2>
                </div>
            </div>

            <div class="space-y-4">
                @if (_isLoading)
                {
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos revisando tu agenda de hoy." Compact="true" />
                }
                else if (_bookings.Count == 0)
                {
                    <div class="space-y-4 text-center py-6">
                        <div class="w-14 h-14 rounded-full bg-[#eff1f2] text-[#325800] flex items-center justify-center mx-auto">
                            <span class="material-symbols-outlined">event_busy</span>
                        </div>
                        <p class="text-sm text-[#595c5d]">@_statusMessage</p>
                        <a href="/partner/quickstart" class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            Cargar primer servicio
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var booking in _bookings)
                    {
                        <article class="rounded-2xl bg-[#f5f6f7] px-4 py-4 flex items-center justify-between gap-4">
                            <div>
                                <p class="text-sm font-bold text-[#2c2f30]">@booking.StartAt.ToLocalTime().ToString("dd MMM")</p>
                                <span class="@GetBookingStatusClass(booking.Status)">@MapBookingStatus(booking.Status)</span>
                            </div>
                            <p class="text-lg font-black tracking-[-0.03em] text-[#3b6700]">@booking.StartAt.ToLocalTime().ToString("HH:mm")</p>
                        </article>
                    }
                }
            </div>
        </section>
    </div>
</div>

@code {
    private readonly List<PartnerBooking> _bookings = new();
    private string _statusMessage = "—";
    private bool _isLoading;

    private string NextBookingLabel => _bookings.Count == 0 ? "--:--" : _bookings.OrderBy(x => x.StartAt).First().StartAt.ToLocalTime().ToString("HH:mm");
    private string StatusLabel => _bookings.Count == 0 ? "Sin agenda" : "Con movimiento";
    private IEnumerable<DateTime> CalendarDays
    {
        get
        {
            var today = DateTime.Today;
            var start = today.AddDays(-((7 + ((int)today.DayOfWeek - 1)) % 7));
            return Enumerable.Range(0, 35).Select(offset => start.AddDays(offset));
        }
    }

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            _isLoading = false;
            return;
        }

        try
        {
            var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
            if (bookings is not null)
            {
                _bookings.AddRange(bookings.OrderBy(x => x.StartAt));
            }
            _statusMessage = _bookings.Count == 0 ? L.T("partner.status.noBookings") : "Tu agenda ya muestra actividad para revisar.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver la agenda de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.status.noBookings");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo cargar la agenda ({(int?)ex.StatusCode ?? 0}).";
        }
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool HasBookingOnDay(DateTime day)
        => _bookings.Any(booking => booking.StartAt.ToLocalTime().Date == day.Date);

    private static string GetCalendarDayClass(DateTime day)
    {
        var isToday = day.Date == DateTime.Today;
        return isToday
            ? "min-h-16 rounded-2xl bg-[#a7f255]/30 text-[#325800] flex flex-col items-center justify-center"
            : "min-h-16 rounded-2xl bg-[#f5f6f7] text-[#2c2f30] flex flex-col items-center justify-center";
    }

    private static string MapBookingStatus(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "confirmed" => "Confirmada",
            "pending" => "Pendiente",
            "cancelled" or "canceled" => "Cancelada",
            "completed" => "Completada",
            _ => string.IsNullOrWhiteSpace(status) ? "Sin estado" : status
        };

    private static string GetBookingStatusClass(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "confirmed" => "inline-flex mt-1 rounded-full bg-[#a7f255]/25 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#325800]",
            "pending" => "inline-flex mt-1 rounded-full bg-[#fcf661]/40 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#605d00]",
            "cancelled" or "canceled" => "inline-flex mt-1 rounded-full bg-[#f95630]/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#b02500]",
            "completed" => "inline-flex mt-1 rounded-full bg-[#eff1f2] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#595c5d]",
            _ => "inline-flex mt-1 rounded-full bg-[#eff1f2] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#595c5d]"
        };

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
