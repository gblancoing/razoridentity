@page "/partner/payouts"
@layout PartnerLayout
@using System.Net
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable

<PageTitle>@L.T("partner.payouts.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">Payouts editoriales</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.payouts.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.payouts.subtitle")</p>
        </div>
        <button class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]">
            <span class="material-symbols-outlined text-[20px]">payments</span>
            @L.T("partner.payouts.primaryAction")
        </button>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">PAYOUTS</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_items.Count</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Registros de liquidación disponibles para consulta.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">NETO TOTAL</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@NetTotalLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Monto neto acumulado de los registros cargados.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">ESTADO</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@StatusLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@_statusMessage</p>
        </article>
    </div>

    <section class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">@L.T("partner.payouts.table.count")</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.payouts.table.title")</h2>
            </div>
        </div>

        <div class="space-y-4">
            @if (_isLoading)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando tus pagos y liquidaciones." Compact="true" />
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center">
                    <p class="text-sm text-[#595c5d]">@_statusMessage</p>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                            <div class="space-y-2">
                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@item.BatchId</p>
                                <p class="text-sm text-[#595c5d]">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="text-left md:text-right">
                                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">Neto</p>
                                <p class="text-2xl font-black tracking-[-0.04em] text-[#3b6700]">@($"{item.NetAmount:N0}")</p>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

@code {
    private readonly List<PayoutItem> _items = new();
    private string _statusMessage = "—";
    private bool _isLoading;

    private string NetTotalLabel => _items.Count == 0 ? "$0" : $"${_items.Sum(x => x.NetAmount):N0}";
    private string StatusLabel => _items.Count == 0 ? "Sin pagos" : "Con liquidaciones";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            _isLoading = false;
            return;
        }

        try
        {
            var payouts = await PartnerApi.GetPartnerPayoutsAsync(partnerId.Value);
            if (payouts is not null)
            {
                _items.AddRange(payouts);
            }
            _statusMessage = _items.Count == 0 ? L.T("partner.status.noPayouts") : "Tus liquidaciones están disponibles para revisión.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver payouts de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.status.noPayouts");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudieron cargar los payouts ({(int?)ex.StatusCode ?? 0}).";
        }
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
