@page "/partner/payouts"
@layout PartnerLayout
@using System.Net
@using System.Text
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable

<PageTitle>@L.T("partner.payouts.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">Caja y liquidaciones</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.payouts.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.payouts.subtitle")</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @foreach (var filter in PayoutFilters)
            {
                <button type="button"
                        class="@GetFilterClass(filter.Key)"
                        @onclick="() => _selectedFilter = filter.Key">
                    @filter.Label
                </button>
            }
            <input class="rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]" placeholder="Desde (YYYY-MM-DD)" @bind="_fromDate" />
            <input class="rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]" placeholder="Hasta (YYYY-MM-DD)" @bind="_toDate" />
            <select class="rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]" @bind="_batchStatusFilter">
                <option value="">Todos los estados</option>
                <option value="open">Abierto</option>
                <option value="processing">Procesando</option>
                <option value="paid">Pagado</option>
            </select>
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] px-4 py-2 text-xs font-bold text-[#2c2f30]"
                    @onclick="LoadPayoutsAsync">
                Aplicar filtros
            </button>
            <button type="button"
                    class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]"
                    @onclick="BuildCsvExport">
                <span class="material-symbols-outlined text-[20px]">payments</span>
                Exportar CSV
            </button>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">LIQUIDACIONES</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@FilteredPayouts.Count</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Registros visibles en la vista financiera actual.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">NETO ACUMULADO</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@NetTotalLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Suma neta de las liquidaciones visibles.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">COMISIÓN MEDIA</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@AverageFeeLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@_statusMessage</p>
        </article>
    </div>

    <section class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">Resumen</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.payouts.table.title")</h2>
            </div>
            <span class="inline-flex items-center rounded-full bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#595c5d]">@StatusLabel</span>
        </div>

        <div class="space-y-4">
            @if (_isLoading)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando tus liquidaciones y descuentos." Compact="true" />
                </div>
            }
            else if (FilteredPayouts.Count == 0)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-[#eff1f2] text-[#325800] flex items-center justify-center mx-auto">
                        <span class="material-symbols-outlined text-3xl">account_balance_wallet</span>
                    </div>
                    <p class="text-lg font-bold text-[#2c2f30]">No hay liquidaciones en esta vista</p>
                    <p class="text-sm text-[#595c5d]">@EmptyStateMessage</p>
                </div>
            }
            else
            {
                @foreach (var item in FilteredPayouts)
                {
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
                            <div class="space-y-3">
                                <div class="flex flex-wrap items-center gap-3">
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">Liquidación @item.BatchId.ToString()[..8]</p>
                                    <span class="@GetPayoutIndicatorClass(item)">@GetPayoutIndicatorLabel(item)</span>
                                    <span class="inline-flex rounded-full bg-[#eff1f2] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#595c5d]">
                                        @FormatBatchStatus(item.BatchStatus)
                                    </span>
                                </div>
                                <p class="text-sm text-[#595c5d]">Creada el @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm"). Esta señal es derivada desde montos reales disponibles en el API.</p>
                            </div>
                            <div class="text-left lg:text-right">
                                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">Neto</p>
                                <p class="text-2xl font-black tracking-[-0.04em] text-[#3b6700]">@FormatMoney(item.NetAmount, item.Currency)</p>
                            </div>
                        </div>

                        <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs text-[#595c5d]">
                            <div class="rounded-2xl bg-[#f5f6f7] px-4 py-3">
                                <p class="font-bold uppercase tracking-[0.12em] text-[#7b8081]">Bruto</p>
                                <p class="mt-2 text-sm font-bold text-[#2c2f30]">@FormatMoney(item.GrossAmount, item.Currency)</p>
                            </div>
                            <div class="rounded-2xl bg-[#f5f6f7] px-4 py-3">
                                <p class="font-bold uppercase tracking-[0.12em] text-[#7b8081]">Comisión</p>
                                <p class="mt-2 text-sm font-bold text-[#2c2f30]">@FormatMoney(item.CommissionAmount, item.Currency)</p>
                            </div>
                            <div class="rounded-2xl bg-[#f5f6f7] px-4 py-3">
                                <p class="font-bold uppercase tracking-[0.12em] text-[#7b8081]">Suscripción</p>
                                <p class="mt-2 text-sm font-bold text-[#2c2f30]">@FormatMoney(item.SubscriptionDeduction, item.Currency)</p>
                            </div>
                            <div class="rounded-2xl bg-[#f5f6f7] px-4 py-3">
                                <p class="font-bold uppercase tracking-[0.12em] text-[#7b8081]">Descuento total</p>
                                <p class="mt-2 text-sm font-bold text-[#2c2f30]">@GetDeductionRate(item)</p>
                            </div>
                        </div>

                        <p class="mt-4 text-xs text-[#595c5d]">@GetOperationalHint(item)</p>
                    </article>
                }
            }
        </div>
    </section>
    @if (!string.IsNullOrWhiteSpace(_csvExport))
    {
        <section class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-3">
            <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-bold text-[#2c2f30]">CSV generado</p>
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]"
                        @onclick="BuildCsvExport">
                    Regenerar
                </button>
            </div>
            <textarea rows="8" readonly class="w-full rounded-2xl border border-[#dadddf] px-3 py-2 text-xs text-[#2c2f30]">@_csvExport</textarea>
        </section>
    }
</div>

@code {
    private readonly List<PayoutItem> _items = new();
    private string _statusMessage = "—";
    private bool _isLoading;
    private string _selectedFilter = "all";
    private string? _fromDate;
    private string? _toDate;
    private string? _batchStatusFilter;
    private string? _csvExport;

    private IReadOnlyList<FilterOption> PayoutFilters { get; } =
    [
        new("all", "Todo"),
        new("recent", "Recientes"),
        new("high_deduction", "Descuento alto")
    ];

    private List<PayoutItem> FilteredPayouts => _items
        .Where(MatchesFilter)
        .OrderByDescending(x => x.CreatedAt)
        .ToList();

    private string NetTotalLabel
        => FilteredPayouts.Count == 0
            ? "$0"
            : FormatMoney(FilteredPayouts.Sum(x => x.NetAmount), FilteredPayouts.First().Currency);

    private string AverageFeeLabel
    {
        get
        {
            var gross = FilteredPayouts.Sum(x => x.GrossAmount);
            if (FilteredPayouts.Count == 0 || gross <= 0)
            {
                return "Sin base";
            }

            var fees = FilteredPayouts.Sum(x => x.CommissionAmount + x.SubscriptionDeduction);
            return $"{(fees / gross) * 100:N1}%";
        }
    }

    private string StatusLabel => _items.Count == 0 ? "Sin movimientos" : "Con historial";

    private string EmptyStateMessage => _selectedFilter switch
    {
        "recent" => "No hay liquidaciones recientes en la ventana actual.",
        "high_deduction" => "No aparecen liquidaciones con descuentos proporcionalmente altos.",
        _ => _statusMessage
    };

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPayoutsAsync();
    }

    private async Task LoadPayoutsAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            _isLoading = false;
            return;
        }

        try
        {
            DateTimeOffset? from = null;
            DateTimeOffset? to = null;
            if (DateOnly.TryParse(_fromDate, out var fromDate))
            {
                from = new DateTimeOffset(fromDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);
            }

            if (DateOnly.TryParse(_toDate, out var toDate))
            {
                to = new DateTimeOffset(toDate.ToDateTime(TimeOnly.MaxValue), TimeSpan.Zero);
            }

            _items.Clear();
            var payouts = await PartnerApi.GetPartnerPayoutsAsync(partnerId.Value, from, to, _batchStatusFilter);
            if (payouts is not null)
            {
                _items.AddRange(payouts);
            }

            _statusMessage = _items.Count == 0
                ? "Todavía no hay liquidaciones registradas para este partner."
                : "Tus liquidaciones ya muestran neto, descuentos y una señal operativa rápida.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver liquidaciones de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.status.noPayouts");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudieron cargar los payouts ({(int?)ex.StatusCode ?? 0}).";
        }

        _isLoading = false;
        BuildCsvExport();
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool MatchesFilter(PayoutItem item) => _selectedFilter switch
    {
        "recent" => item.CreatedAt >= DateTimeOffset.Now.AddDays(-14),
        "high_deduction" => HasHighDeduction(item),
        _ => true
    };

    private string GetFilterClass(string key)
        => key == _selectedFilter
            ? "inline-flex items-center rounded-full bg-[#2c2f30] text-white px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]"
            : "inline-flex items-center rounded-full bg-white text-[#595c5d] px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]";

    private static bool HasHighDeduction(PayoutItem item)
    {
        if (item.GrossAmount <= 0)
        {
            return false;
        }

        return (item.CommissionAmount + item.SubscriptionDeduction) / item.GrossAmount >= 0.25;
    }

    private static string GetPayoutIndicatorLabel(PayoutItem item)
    {
        if (item.NetAmount <= 0)
        {
            return "Revisar";
        }

        if (HasHighDeduction(item))
        {
            return "Descuento alto";
        }

        if (item.CommissionAmount <= 0 && item.SubscriptionDeduction <= 0)
        {
            return "Neto limpio";
        }

        return "Liquidación sana";
    }

    private static string GetPayoutIndicatorClass(PayoutItem item)
    {
        if (item.NetAmount <= 0)
        {
            return "inline-flex rounded-full bg-[#f95630]/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#b02500]";
        }

        if (HasHighDeduction(item))
        {
            return "inline-flex rounded-full bg-[#fff2d1] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#946200]";
        }

        return "inline-flex rounded-full bg-[#a7f255]/25 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#325800]";
    }

    private static string GetDeductionRate(PayoutItem item)
    {
        if (item.GrossAmount <= 0)
        {
            return "Sin base";
        }

        var rate = (item.CommissionAmount + item.SubscriptionDeduction) / item.GrossAmount;
        return $"{rate * 100:N1}%";
    }

    private static string GetOperationalHint(PayoutItem item)
    {
        if (item.NetAmount <= 0)
        {
            return "El neto quedó en cero o negativo. Conviene revisar descuentos, comisión aplicada y origen del batch.";
        }

        if (HasHighDeduction(item))
        {
            return "Esta liquidación concentra descuentos altos respecto del bruto. Úsala como señal para revisión financiera.";
        }

        if (item.CommissionAmount <= 0 && item.SubscriptionDeduction <= 0)
        {
            return "No aparecen descuentos en este registro. Útil para contrastar contra otras liquidaciones.";
        }

        return "La relación entre bruto, descuentos y neto se ve consistente para revisión operativa rápida.";
    }

    private static string FormatBatchStatus(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "open" => "Abierto",
            "processing" => "Procesando",
            "paid" => "Pagado",
            _ => string.IsNullOrWhiteSpace(status) ? "Sin estado" : status
        };

    private void BuildCsvExport()
    {
        var csv = new StringBuilder();
        csv.AppendLine("batch_id,batch_status,created_at,gross,commission,subscription,net,currency");
        foreach (var item in FilteredPayouts)
        {
            csv.AppendLine(string.Join(",",
                item.BatchId,
                EscapeCsv(item.BatchStatus),
                item.CreatedAt.UtcDateTime.ToString("O"),
                item.GrossAmount,
                item.CommissionAmount,
                item.SubscriptionDeduction,
                item.NetAmount,
                EscapeCsv(item.Currency)));
        }

        _csvExport = csv.ToString();
    }

    private static string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        if (!value.Contains(',') && !value.Contains('"') && !value.Contains('\n'))
        {
            return value;
        }

        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";

    private sealed record FilterOption(string Key, string Label);

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
