        {
            var bookable = _services.Where(IsServiceBookable).ToList();
            return bookable.Count == 0 ? "—" : $"{Math.Round(bookable.Average(x => x.DurationMinutes))} min";
        }
    }

    private bool HasActiveCatalogOffer =>
        _products.Any(x => x.IsActive) || _services.Any(x => x.IsActive) || _professionals.Any(x => x.IsActive);
    private int CurrentCount => IsProductPartner ? _products.Count : IsServicePartner ? _services.Count : _professionals.Count;
    private string HeadingTitle => IsProductPartner ? "Catalogo de productos" : IsServicePartner ? "Catalogo de servicios" : "Equipo profesional";
    private string HeadingSubtitle => IsProductPartner
        ? "Gestiona tu vitrina comercial, ajusta precios y activa o desactiva tu oferta."
        : IsServicePartner
            ? "Organiza los servicios que publicas, sus precios y su disponibilidad operativa."
            : "Mantén actualizados los perfiles que representan tu negocio ante nuevos clientes.";
    private string CreateCtaLabel => IsProductPartner ? "Crear producto" : IsServicePartner ? "Crear servicio" : "Registrar profesional";
    private string CreateSecondaryLabel => IsProductPartner ? "Agregar producto" : IsServicePartner ? "Agregar servicio" : "Agregar profesional";
    private string CountLabel => IsProductPartner ? "PRODUCTOS" : IsServicePartner ? "SERVICIOS" : "PROFESIONALES";
    private string CountHint => IsProductPartner
        ? "Items visibles en tu oferta comercial."
        : IsServicePartner
            ? "Servicios listos para recibir reservas."
            : "Perfiles activos que representan tu negocio.";
    private string MetricLabel => IsProductPartner ? "PRECIO MEDIO" : IsServicePartner ? "DURACION MEDIA" : "VERIFICADOS";
    private string MetricValue => IsProductPartner
        ? (_products.Count == 0 ? "$0" : Money(_products.Average(x => x.Price)))
        : IsServicePartner
            ? (_services.Count == 0 ? "0 min" : $"{Math.Round(_services.Average(x => x.DurationMinutes))} min")
            : _professionals.Count(x => x.IsVerified).ToString();
    private string MetricHint => IsProductPartner
        ? "Referencia rapida del valor promedio de tus productos."
        : IsServicePartner
            ? "Tiempo promedio que comprometes por servicio."
            : "Perfiles validados para reforzar confianza."
    ;
    private string StatusLabel => CurrentCount == 0 ? "Sin carga" : "Operacion activa";
    private string SectionTitle => IsProductPartner ? "Gestiona tus productos" : IsServicePartner ? "Gestiona tus servicios" : "Gestiona tus profesionales";
    private string LoadingMessage => IsProductPartner ? "Estamos cargando tu catalogo de productos." : IsServicePartner ? "Estamos cargando tu catalogo de servicios." : "Estamos cargando tu equipo profesional.";
    private string EmptyIcon => IsProductPartner ? "inventory_2" : IsServicePartner ? "menu_book" : "badge";
    private string EmptyTitle => IsProductPartner ? "Tu catalogo de productos esta vacio" : IsServicePartner ? "Todavia no tienes servicios cargados" : "Todavia no tienes profesionales registrados";
    private string InputClass => "mt-1 w-full rounded-2xl border border-[#dadddf] bg-white px-4 h-12 text-sm text-[#2c2f30]";
    private string TextAreaClass => "mt-1 w-full rounded-2xl border border-[#dadddf] bg-white px-4 py-3 text-sm text-[#2c2f30] min-h-[110px]";
    private string PrimaryButtonClass => "inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] px-4 py-2.5 text-sm font-bold text-[#d9ffad] disabled:opacity-60";
    private string SecondaryButtonClass => "inline-flex items-center gap-2 rounded-2xl bg-[#eff1f2] px-4 py-2.5 text-sm font-bold text-[#2c2f30] disabled:opacity-60";
    private string GhostButtonClass => "inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] px-4 py-2.5 text-sm font-bold text-[#2c2f30]";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = "Necesitas iniciar sesion para gestionar tu oferta.";
            _isLoading = false;
            return;
        }

        var partnerId = await PartnerApiServiceHelper.ResolvePartnerIdAsync(AuthState, PartnerApi, CancellationToken.None);
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = "No encontramos un negocio activo en tu sesion. Entra desde Mis negocios o crea uno.";
            _isLoading = false;
            return;
        }

        await LoadAsync(partnerId.Value);
        _isLoading = false;
    }

    private async Task LoadAsync(Guid partnerId)
    {
        try
        {
            _partner = await PartnerApi.GetPartnerAsync(partnerId);
            _products.Clear();
            _services.Clear();
            _professionals.Clear();
            _staff.Clear();

            if (IsProductPartner)
            {
                var products = await PartnerApi.GetPartnerProductsAsync(partnerId);
                if (products is not null)
                {
                    _products.AddRange(products);
                }

                await LoadStoreCategoriesAsync(partnerId);
                await LoadCommerceSubcategoriesAsync();
                ApplyDefaultCreateProductDiscovery();
                await ApplyDefaultCreateProductGeoAsync();

                _statusMessage = _products.Count == 0
                    ? L.T("partner.catalog.a.emptyHint")
                    : L.T("partner.catalog.a.countHint");

                if (OffersHybridServices)
                {
                    var services = await PartnerApi.GetPartnerServicesAsync(partnerId);
                    if (services is not null)
                    {
                        _services.AddRange(services);
                    }

                    await ReloadStaffAsync(partnerId);
                    await LoadServiceCategorySuggestionsAsync();
                    ApplyDefaultCreateServiceCategory();
                    ApplyDefaultCreateServiceGeo();
                }

                await LoadOrdersAsync(partnerId);
            }
            else if (IsServicePartner)
            {
                var services = await PartnerApi.GetPartnerServicesAsync(partnerId);
                if (services is not null)
                {
                    _services.AddRange(services);
                }

                await ReloadStaffAsync(partnerId);

                await LoadServiceCategorySuggestionsAsync();
                ApplyDefaultCreateServiceCategory();
                ApplyDefaultCreateServiceGeo();
                _createService.IsBookableMode = false;

                _statusMessage = _services.Count == 0
                    ? L.T("partner.catalog.b.emptyHint")
                    : $"{_services.Count} aviso(s) · {BookableServiceCount} reservable(s).";
            }
            else
            {
                var professionals = await PartnerApi.GetPartnerProfessionalsAsync(partnerId);
                if (professionals is not null)
                {
                    _professionals.AddRange(professionals);
                }

                _statusMessage = _professionals.Count == 0
                    ? "Registra tu primer profesional para activar la oferta del negocio."
                    : "Tus perfiles profesionales ya se pueden actualizar y pausar desde aqui.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver el catalogo de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = "Todavia no encontramos informacion publicada para este negocio.";
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo cargar el catalogo ({(int?)ex.StatusCode ?? 0}).";
        }
    }

    private void ToggleCreatePanel() => _showCreatePanel = !_showCreatePanel;

    private void ApplyDefaultCreateServiceGeo()
    {
        if (_createService.ComunaId is Guid existing && existing != Guid.Empty)
        {
            return;
        }

        if (TryApplyPartnerGeo(
                out var countryId,
                out var regionId,
                out var comunaId,
                out var latitude,
                out var longitude))
        {
            _createService.CountryId = countryId;
            _createService.RegionId = regionId;
            _createService.ComunaId = comunaId;
            _createService.Latitude = latitude;
            _createService.Longitude = longitude;
            return;
        }

        var sample = _services.FirstOrDefault(x => x.ComunaId is Guid c && c != Guid.Empty);
        if (sample is not null)
        {
            _createService.CountryId = sample.CountryId;
            _createService.RegionId = sample.RegionId;
            _createService.ComunaId = sample.ComunaId;
            _createService.Latitude = sample.Latitude;
            _createService.Longitude = sample.Longitude;
            return;
        }

        if (_partner?.Latitude is double partnerLat && _partner.Longitude is double partnerLng)
        {
            _createService.Latitude = partnerLat;
            _createService.Longitude = partnerLng;
        }
    }

    private async Task LoadServiceCategorySuggestionsAsync()
    {
        _serviceCategorySuggestions.Clear();
        try
        {
            var items = await BuyerApi.GetServiceCategoriesAsync();
            if (items is not null)
            {
                foreach (var item in items)
                {
                    if (!string.IsNullOrWhiteSpace(item.Name))
                    {
                        _serviceCategorySuggestions.Add(item.Name.Trim());
                    }
                }
            }
        }
        catch
        {
        }

        var company = PartnerCompanyCategoryLabel;
        if (!string.IsNullOrWhiteSpace(company) && !_serviceCategorySuggestions.Contains(company, StringComparer.OrdinalIgnoreCase))
        {
            _serviceCategorySuggestions.Insert(0, company);
        }
    }

    private string? PartnerCompanyCategoryLabel
    {
        get
        {
            if (_partner is null)
            {
                return null;
            }

            if (!string.IsNullOrWhiteSpace(_partner.SubcategoryName) && !string.IsNullOrWhiteSpace(_partner.CategoryName))
            {
                return $"{_partner.CategoryName} · {_partner.SubcategoryName}";
            }

            return _partner.SubcategoryName ?? _partner.CategoryName;
        }
    }

    private void ApplyDefaultCreateServiceCategory()
    {
        if (string.IsNullOrWhiteSpace(_createService.Category))
        {
            _createService.Category = PartnerCompanyCategoryLabel ?? string.Empty;
        }
    }

    private async Task CreateProductAsync()
    {
        if (_partner is null)
        {
            return;
        }

        if (_createDiscoverySubcategoryIds.Count == 0)
        {
            _statusMessage = L.T("partner.catalog.a.marketplaceCategory.required");
            return;
        }

        var geoError = await PrepareProductGeoForSaveAsync(_createProduct, _createProductGeoPicker);
        if (geoError is not null)
        {
            _statusMessage = L.T(geoError);
            return;
        }

        _isCreating = true;
        try
        {
            var (createLat, createLng) = await ResolveProductCoordinatesAsync(_createProduct, _createProductGeoPicker);
            var sectionLabel = CreateProductSectionLabel;
            var created = await PartnerApi.CreateProductAsync(new ComunaClick.Shared.Api.Partner.ProductCreateRequest(
                _partner.Id,
                _createProduct.Name.Trim(),
                NullIfWhiteSpace(_createProduct.Description),
                sectionLabel,
                _createProduct.PartnerCatalogCategoryId,
                null,
                _createProduct.Price,
                _createProduct.CostPrice > 0 ? _createProduct.CostPrice : null,
                "CLP",
                true,
                _createProduct.StockQuantity,
                null,
                _createProduct.CountryId,
                _createProduct.RegionId,
                _createProduct.ComunaId,
                createLat,
                createLng,
                _createDiscoverySubcategoryIds.Count > 0 ? _createDiscoverySubcategoryIds.ToList() : null));
            if (created is not null)
            {
                if (_createPendingProductImages.Count > 0)
                {
                    var uploads = _createPendingProductImages
                        .Select(p => new ComunaClick.Shared.Api.Partner.ProductImageUploadFile(
                            new MemoryStream(p.Bytes),
                            p.FileName,
                            p.ContentType))
                        .ToList();
                    var images = await PartnerApi.UploadProductImagesAsync(created.Id, uploads);
                    if (images is { Count: > 0 })
                    {
                        created = created with
                        {
                            Images = images,
                            ImageUrls = images.Select(x => x.Url).ToList(),
                            ImageUrl = images[0].Url
                        };
                    }
                }

                _products.Add(created);
                _statusMessage = L.T("partner.catalog.a.create.product");
                _createProduct.Name = string.Empty;
                _createProduct.Description = null;
                _createProduct.Price = 0;
                _createProduct.CostPrice = 0;
                _createProduct.StockQuantity = 0;
                _createProduct.PartnerCatalogCategoryId = null;
                _createPendingProductImages = Array.Empty<ProductImageUpload.PendingProductImageFile>();
                _createDiscoverySubcategoryIds.Clear();
                ApplyDefaultCreateProductDiscovery();
                await ApplyDefaultCreateProductGeoAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo crear el producto ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task CreateServiceAsync()
    {
        if (_partner is null)
        {
            return;
        }

        if (!ValidateBookableStaff(_createService, out var staffErrorKey))
        {
            _statusMessage = L.T(staffErrorKey!);
            return;
        }

        var geoError = await PrepareServiceGeoForSaveAsync(_createService, _createServiceGeoPicker);
        if (geoError is not null)
        {
            _statusMessage = L.T(geoError);
            return;
        }

        _isCreating = true;
        try
        {
            var price = _createService.IsBookableMode ? _createService.Price : 0;
            var duration = _createService.IsBookableMode ? _createService.DurationMinutes : 30;
            var (createLat, createLng) = await ResolveServiceCoordinatesAsync(_createService, _createServiceGeoPicker);
            ApplyResolvedCoordinates(_createService, (createLat, createLng));
            if (createLat is not double createLatToSave || createLng is not double createLngToSave)
            {
                _statusMessage = L.T("partner.catalog.b.geo.pinRequired");
                return;
            }

            var created = await PartnerApi.CreateServiceAsync(new ComunaClick.Shared.Api.Partner.ServiceCreateRequest(
                _partner.Id,
                _createService.Name.Trim(),
                NullIfWhiteSpace(_createService.Description),
                NullIfWhiteSpace(_createService.Category),
                price,
                "CLP",
                duration,
                true,
                null,
                null,
                _createService.CountryId,
                _createService.RegionId,
                _createService.ComunaId,
                createLatToSave,
                createLngToSave,
                _createService.SelectedStaffIds()));
            if (created is not null)
            {
                var geoCreated = await PartnerApi.UpdateServiceGeoAsync(
                    created.Id,
                    _createService.CountryId,
                    _createService.RegionId,
                    _createService.ComunaId,
                    createLatToSave,
                    createLngToSave);
                if (geoCreated is null)
                {
                    _statusMessage = L.T("partner.catalog.form.saveFailed");
                    return;
                }

                created = await PartnerApi.GetServiceAsync(created.Id) ?? geoCreated;
                created = MergeServiceGeoIntoResponse(created, createLatToSave, createLngToSave, _createService);
                if (_createPendingImages.Count > 0)
                {
                    var uploads = _createPendingImages
                        .Select(p => new ComunaClick.Shared.Api.Partner.ServiceImageUploadFile(
                            new MemoryStream(p.Bytes),
                            p.FileName,
                            p.ContentType))
                        .ToList();
                    var images = await PartnerApi.UploadServiceImagesAsync(created.Id, uploads);
                    if (images is { Count: > 0 })
                    {
                        created = created with { Images = images, ImageUrls = images.Select(x => x.Url).ToList(), ImageUrl = images[0].Url };
                    }
                }

                _services.Add(created);
                _statusMessage = "Aviso publicado. Usá «Vista previa» para ver la ficha.";
                _createService.Name = string.Empty;
                _createService.Description = null;
                _createService.Price = 0;
                _createService.DurationMinutes = 60;
                _createService.CountryId = null;
                _createService.RegionId = null;
                _createService.ComunaId = null;
                _createService.Latitude = null;
                _createService.Longitude = null;
                _createService.IsBookableMode = false;
                _createService.ClearStaff();
                _createPendingImages = Array.Empty<ServiceImageUpload.PendingServiceImageFile>();
                ApplyDefaultCreateServiceCategory();
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo crear el servicio ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _isCreating = false;
        }
    }

