    private IReadOnlyList<PartnerServiceImage> _editServiceImages = EmptyServiceImages;
    private IReadOnlyList<ServiceImageUpload.PendingServiceImageFile> _createPendingImages = Array.Empty<ServiceImageUpload.PendingServiceImageFile>();
    private static readonly IReadOnlyList<PartnerProductImage> EmptyProductImages = Array.Empty<PartnerProductImage>();
    private IReadOnlyList<PartnerProductImage> _editProductImages = EmptyProductImages;
