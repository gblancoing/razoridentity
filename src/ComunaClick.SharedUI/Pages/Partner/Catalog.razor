    private async Task ApplyDefaultCreateProductGeoAsync()
    {
        if (_createProduct.ComunaId is not Guid existing || existing == Guid.Empty)
        {
            if (TryApplyPartnerGeo(
                    out var countryId,
                    out var regionId,
                    out var comunaId,
                    out var latitude,
                    out var longitude))
            {
                _createProduct.CountryId = countryId;
                _createProduct.RegionId = regionId;
                _createProduct.ComunaId = comunaId;
                _createProduct.Latitude = latitude;
                _createProduct.Longitude = longitude;
            }
            else
            {
                var sample = _products.FirstOrDefault(x => x.ComunaId is Guid c && c != Guid.Empty);
                if (sample is not null)
                {
                    _createProduct.CountryId = sample.CountryId;
                    _createProduct.RegionId = sample.RegionId;
                    _createProduct.ComunaId = sample.ComunaId;
                    _createProduct.Latitude = sample.Latitude;
                    _createProduct.Longitude = sample.Longitude;
                }
                else if (_partner?.Latitude is double partnerLat && _partner.Longitude is double partnerLng)
                {
                    _createProduct.Latitude = partnerLat;
                    _createProduct.Longitude = partnerLng;
                }
            }
        }

        await NormalizeEditorGeoCascadeAsync(_createProduct);
    }

    private async Task NormalizeEditorGeoCascadeAsync(ProductEditor editor)
    {
        if (editor.ComunaId is not Guid comunaId || comunaId == Guid.Empty)
        {
            return;
        }

        var countries = await BuyerApi.GetCountriesAsync() ?? Array.Empty<ComunaClick.Shared.Api.Buyer.PublicCountryItem>();
        foreach (var country in countries)
        {
            var regions = await BuyerApi.GetRegionsAsync(country.Id) ?? Array.Empty<ComunaClick.Shared.Api.Buyer.PublicRegionItem>();
            foreach (var region in regions)
            {
                var comunas = await BuyerApi.GetComunasAsync(region.Id) ?? Array.Empty<ComunaClick.Shared.Api.Buyer.PublicComunaItem>();
                var match = comunas.FirstOrDefault(x => x.Id == comunaId);
                if (match is null)
                {
                    continue;
                }

                editor.CountryId = country.Id;
                editor.RegionId = region.Id;
                editor.ComunaId = comunaId;
                if (editor.Latitude is not double || editor.Longitude is not double)
                {
                    if (match.Latitude is double clat && match.Longitude is double clng)
                    {
                        editor.Latitude = clat;
                        editor.Longitude = clng;
                    }
                }

                return;
            }
        }
    }

    private bool TryApplyPartnerGeo(
        out Guid? countryId,
        out Guid? regionId,
        out Guid? comunaId,
        out double? latitude,
        out double? longitude)
    {
        countryId = null;
        regionId = null;
        comunaId = null;
        latitude = null;
        longitude = null;

        if (_partner?.ComunaId is not Guid partnerComuna || partnerComuna == Guid.Empty)
        {
            return false;
        }

        countryId = _partner.CountryId;
        regionId = _partner.RegionId;
        comunaId = partnerComuna;
        if (_partner.Latitude is double lat && _partner.Longitude is double lng)
        {
            latitude = lat;
            longitude = lng;
        }

        return true;
    }

    private async Task<string?> PrepareProductGeoForSaveAsync(ProductEditor editor, ServiceGeoPicker? picker)
    {
        if (editor.ComunaId is not Guid comunaId || comunaId == Guid.Empty)
        {
            return "partner.catalog.b.geo.required";
        }

        ApplyResolvedProductCoordinates(editor, await ResolveProductCoordinatesAsync(editor, picker));

        if (!ValidateCatalogGeo(editor.ComunaId, editor.Latitude, editor.Longitude, out var localeKey))
        {
            return localeKey;
        }

        return null;
    }

    private async Task<(double? Latitude, double? Longitude)> ResolveProductCoordinatesAsync(
        ProductEditor editor,
        ServiceGeoPicker? picker)
    {
        if (picker is not null)
        {
            await picker.SyncCoordinatesFromMapAsync();
            await picker.PublishCoordinatesAsync();
            var (pickerLat, pickerLng) = picker.GetCoordinatesForSave();
            if (pickerLat is double lat && pickerLng is double lng)
            {
                return (lat, lng);
            }
        }

        if (ReferenceEquals(editor, _productEditor)
            && _editProductGeoLatitude is double editLat
            && _editProductGeoLongitude is double editLng)
        {
            return (editLat, editLng);
        }

        if (ReferenceEquals(editor, _createProduct)
            && _createProductGeoLatitude is double createLat
            && _createProductGeoLongitude is double createLng)
        {
            return (createLat, createLng);
        }

        if (editor.Latitude is double editorLat && editor.Longitude is double editorLng)
        {
            return (editorLat, editorLng);
        }

        var mapElementId = ReferenceEquals(editor, _productEditor) && _editingProductId is Guid editId
            ? EditProductMapElementId(editId)
            : ReferenceEquals(editor, _createProduct)
                ? CreateProductMapElementId
                : null;

        if (mapElementId is not null)
        {
            return await TryReadGeoFromMapElementAsync(mapElementId);
        }

        return (editor.Latitude, editor.Longitude);
    }

    private void ApplyResolvedProductCoordinates(ProductEditor editor, (double? Latitude, double? Longitude) coords)
    {
        if (coords.Latitude is not double lat || coords.Longitude is not double lng)
        {
            return;
        }

        editor.Latitude = lat;
        editor.Longitude = lng;

        if (ReferenceEquals(editor, _productEditor))
        {
            _editProductGeoLatitude = lat;
            _editProductGeoLongitude = lng;
        }
        else if (ReferenceEquals(editor, _createProduct))
        {
            _createProductGeoLatitude = lat;
            _createProductGeoLongitude = lng;
        }
    }

