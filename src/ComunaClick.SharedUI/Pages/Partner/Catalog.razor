                            <div class="text-left md:text-right text-sm text-[#595c5d]">
                                <p>@(string.IsNullOrWhiteSpace(item.Email) ? "Sin email publico" : item.Email)</p>
                                <p>@(string.IsNullOrWhiteSpace(item.Phone) ? "Sin telefono publico" : item.Phone)</p>
