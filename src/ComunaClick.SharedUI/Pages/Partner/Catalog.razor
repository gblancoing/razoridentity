    private void ReplaceProduct(PartnerProduct updated)
    {
        var index = _products.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            _products[index] = updated;
        }
    }

    private void ReplaceService(PartnerService updated)
    {
        var index = _services.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            _services[index] = updated;
        }
    }

    private void ReplaceProfessional(PartnerProfessional updated)
    {
        var index = _professionals.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            _professionals[index] = updated;
        }
    }

    private bool IsBusy(Guid itemId) => _busyItemId == itemId;
    private static string BadgeText(bool isActive) => isActive ? "Activo" : "Pausado";
    private static string ToggleLabel(bool isActive) => isActive ? "Desactivar" : "Activar";
    private static string ToggleIcon(bool isActive) => isActive ? "pause_circle" : "play_circle";
    private static string BadgeClass(bool isActive)
        => isActive
            ? "inline-flex items-center rounded-full bg-[#a7f255]/25 px-3 py-1 text-[11px] font-bold text-[#325800]"
            : "inline-flex items-center rounded-full bg-[#eff1f2] px-3 py-1 text-[11px] font-bold text-[#595c5d]";

    private static string Money(double value) => $"${value:N0}";
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private sealed class ProductEditor
    {
        [Required] public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Category { get; set; }
        [Range(0.01, 999999999)] public double Price { get; set; }
    }

    private sealed class ServiceEditor
    {
        [Required] public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Category { get; set; }
        [Range(0.01, 999999999)] public double Price { get; set; }
        [Range(15, 1440)] public int DurationMinutes { get; set; } = 30;
    }

    private sealed class ProfessionalEditor : IValidatableObject
    {
        [Required] public string Name { get; set; } = string.Empty;
        [Required] public string Specialty { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Bio { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(Email) && string.IsNullOrWhiteSpace(Phone))
            {
                yield return new ValidationResult("Debes ingresar email o telefono.", new[] { nameof(Email), nameof(Phone) });
            }
        }
    }
}
