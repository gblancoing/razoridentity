    private async Task SaveProfessionalAsync()
    {
        if (_editingProfessionalId is null)
        {
            return;
        }

        _busyItemId = _editingProfessionalId;
        try
        {
            var current = _professionals.FirstOrDefault(x => x.Id == _editingProfessionalId.Value);
            var updated = await PartnerApi.UpdateProfessionalAsync(_editingProfessionalId.Value, new ComunaClick.Shared.Api.Partner.ProfessionalUpdateRequest(
                Clean(_professionalEditor.Name),
                Clean(_professionalEditor.Email),
                Clean(_professionalEditor.Phone),
                Clean(_professionalEditor.Specialty),
