@page "/partner/catalog"
@layout PartnerLayout
@using System.Net
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@implements IDisposable
@using PartnerProduct = ComunaClick.Shared.Api.Partner.Product

<PageTitle>@L.T("partner.catalog.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">Catálogo editorial</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.catalog.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.catalog.subtitle")</p>
        </div>
        <a href="/partner/quickstart" class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            Crear primer producto
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">PRODUCTOS</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_items.Count</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Ítems visibles en tu catálogo de gestión.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">PRECIO MEDIO</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@AveragePriceLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Referencia rápida del valor promedio de tus productos.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">ESTADO</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@StatusLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@_statusMessage</p>
        </article>
    </div>

    <section class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">@L.T("partner.catalog.table.count")</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.catalog.table.title")</h2>
            </div>
            <a href="/partner/quickstart" class="text-sm font-bold text-[#3b6700] hover:underline">Agregar producto</a>
        </div>

        <div class="space-y-4">
            @if (_isLoading)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando tu catalogo de productos." Compact="true" />
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-[#a7f255]/20 text-[#325800] flex items-center justify-center mx-auto">
                        <span class="material-symbols-outlined text-3xl">inventory_2</span>
                    </div>
                    <p class="text-lg font-bold text-[#2c2f30]">Tu catálogo está vacío</p>
                    <p class="text-sm text-[#595c5d] max-w-xl mx-auto">@_statusMessage</p>
                    <a href="/partner/quickstart" class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        Cargar primer producto
                    </a>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                            <div class="space-y-2">
                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@item.Name</p>
                                <p class="text-sm text-[#595c5d]">@(string.IsNullOrWhiteSpace(item.Description) ? "Sin descripción comercial todavía." : item.Description)</p>
                            </div>
                            <div class="text-left md:text-right">
                                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">Precio</p>
                                <p class="text-2xl font-black tracking-[-0.04em] text-[#3b6700]">@($"{item.Price:N0}")</p>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

@code {
    private readonly List<PartnerProduct> _items = new();
    private string _statusMessage = "—";
    private bool _isLoading;

    private string AveragePriceLabel => _items.Count == 0 ? "$0" : $"${_items.Average(x => x.Price):N0}";
    private string StatusLabel => _items.Count == 0 ? "Sin carga" : "Catálogo activo";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            _isLoading = false;
            return;
        }

        try
        {
            var products = await PartnerApi.GetPartnerProductsAsync(partnerId.Value);
            if (products is not null)
            {
                _items.AddRange(products);
            }
            _statusMessage = _items.Count == 0 ? L.T("partner.status.noProducts") : "Tu catálogo está cargado y listo para seguir creciendo.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver el catalogo de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.status.noProducts");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo cargar el catalogo ({(int?)ex.StatusCode ?? 0}).";
        }
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
