    private static PartnerService MergeServiceGeoIntoResponse(
        PartnerService service,
        double latitude,
        double longitude,
        ServiceEditor editor)
        => service with
        {
            Latitude = latitude,
            Longitude = longitude,
            CountryId = editor.CountryId ?? service.CountryId,
            RegionId = editor.RegionId ?? service.RegionId,
            ComunaId = editor.ComunaId ?? service.ComunaId
        };

    private async Task<string?> PrepareServiceGeoForSaveAsync(ServiceEditor editor, ServiceGeoPicker? picker)
    {
        if (editor.ComunaId is not Guid comunaId || comunaId == Guid.Empty)
        {
            return "partner.catalog.b.geo.required";
        }

        ApplyResolvedCoordinates(editor, await ResolveServiceCoordinatesAsync(editor, picker));

        if (!ValidateServiceGeo(editor, out var localeKey))
        {
            return localeKey;
        }

        return null;
    }

    private async Task<(double? Latitude, double? Longitude)> ResolveServiceCoordinatesAsync(
        ServiceEditor editor,
        ServiceGeoPicker? picker)
    {
        if (picker is not null)
        {
            await picker.SyncCoordinatesFromMapAsync();
            await picker.PublishCoordinatesAsync();
            var (pickerLat, pickerLng) = picker.GetCoordinatesForSave();
            if (pickerLat is double lat && pickerLng is double lng)
            {
                return (lat, lng);
            }
        }

        if (ReferenceEquals(editor, _serviceEditor)
            && _editServiceGeoLatitude is double editLat
            && _editServiceGeoLongitude is double editLng)
        {
            return (editLat, editLng);
        }

        if (ReferenceEquals(editor, _createService)
            && _createServiceGeoLatitude is double createLat
            && _createServiceGeoLongitude is double createLng)
        {
            return (createLat, createLng);
        }

        if (editor.Latitude is double editorLat && editor.Longitude is double editorLng)
        {
            return (editorLat, editorLng);
        }

        var mapElementId = ReferenceEquals(editor, _serviceEditor) && _editingServiceId is Guid editId
            ? EditServiceMapElementId(editId)
            : ReferenceEquals(editor, _createService)
                ? CreateServiceMapElementId
                : null;

        if (mapElementId is not null)
        {
            return await TryReadGeoFromMapElementAsync(mapElementId);
        }

        return (editor.Latitude, editor.Longitude);
    }

    private void ApplyResolvedCoordinates(ServiceEditor editor, (double? Latitude, double? Longitude) coords)
    {
        if (coords.Latitude is not double lat || coords.Longitude is not double lng)
        {
            return;
        }

        editor.Latitude = lat;
        editor.Longitude = lng;

        if (ReferenceEquals(editor, _serviceEditor))
        {
            _editServiceGeoLatitude = lat;
            _editServiceGeoLongitude = lng;
        }
        else if (ReferenceEquals(editor, _createService))
        {
            _createServiceGeoLatitude = lat;
            _createServiceGeoLongitude = lng;
        }
    }

    private static string EditServiceMapElementId(Guid serviceId) => $"service-geo-map-edit-{serviceId}";

    private const string CreateServiceMapElementId = "service-geo-map-create";

    private async Task<(double? Latitude, double? Longitude)> TryReadGeoFromMapElementAsync(string mapElementId)
    {
        try
        {
            var coords = await JS.InvokeAsync<MapMarkerCoordsDto?>(
                "comunaclic.getProfileAddressMarkerCoords",
                mapElementId);
            if (coords is null)
            {
                return (null, null);
            }

            return (coords.Latitude, coords.Longitude);
        }
        catch (JSException)
        {
            return (null, null);
        }
    }

    private sealed record MapMarkerCoordsDto(
        [property: System.Text.Json.Serialization.JsonPropertyName("latitude")] double Latitude,
        [property: System.Text.Json.Serialization.JsonPropertyName("longitude")] double Longitude);

