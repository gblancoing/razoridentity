    private static bool ValidateServiceGeo(ServiceEditor editor, out string? localeKey)
        => ValidateCatalogGeo(editor.ComunaId, editor.Latitude, editor.Longitude, out localeKey);

    private static bool ValidateCatalogGeo(Guid? comunaId, double? latitude, double? longitude, out string? localeKey)
    {
        if (comunaId is not Guid cid || cid == Guid.Empty)
        {
            localeKey = "partner.catalog.b.geo.required";
            return false;
        }

        if (latitude is not double lat
            || longitude is not double lng
            || lat is < -90 or > 90
            || lng is < -180 or > 180)
        {
            localeKey = "partner.catalog.b.geo.pinRequired";
            return false;
        }

        localeKey = null;
        return true;
    }

    private async Task LoadCommerceSubcategoriesAsync()
    {
        _commerceSubcategories.Clear();
        _commerceCategoryGroups.Clear();
        try
        {
            var categories = await BuyerApi.GetCatalogCategoriesAsync("commerce");
            if (categories is null)
            {
                return;
            }

            foreach (var category in categories)
            {
                var subs = await BuyerApi.GetProductSubcategoriesAsync(category.Id);
                if (subs is null || subs.Count == 0)
                {
                    continue;
                }

                var orderedSubs = subs
                    .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                _commerceCategoryGroups.Add(new ProductMarketplaceCategoryPicker.CommerceCategoryGroup(
                    category.Id,
                    category.Name,
                    orderedSubs));

                foreach (var sub in orderedSubs)
                {
                    if (!_commerceSubcategories.Any(x => x.Id == sub.Id))
                    {
                        _commerceSubcategories.Add(sub);
                    }
                }
            }

            _commerceCategoryGroups.Sort((a, b) =>
                string.Compare(a.CategoryName, b.CategoryName, StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
        }
    }

