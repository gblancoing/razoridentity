    private async Task DeleteServiceAsync(PartnerService item)
    {
        if (!await JsConfirmAsync(L.T("partner.catalog.b.deleteConfirm")))
        {
            return;
        }

        _busyItemId = item.Id;
        try
        {
            await PartnerApi.DeleteServiceAsync(item.Id);
            _services.RemoveAll(x => x.Id == item.Id);
            if (_editingServiceId == item.Id)
            {
                CancelEdit();
            }

            _statusMessage = L.T("partner.catalog.b.deleted");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            _statusMessage = L.T("partner.catalog.b.deleteBlocked");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo eliminar ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _busyItemId = null;
        }
    }

