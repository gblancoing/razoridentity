@page "/partner/catalog"
@layout PartnerLayout
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ApiMediaUrl MediaUrl
@using ComunaClick.SharedUI.Services.Partner
@implements IDisposable
@using PartnerProduct = ComunaClick.Shared.Api.Partner.Product
@using PartnerService = ComunaClick.Shared.Api.Partner.Service
@using PartnerProfessional = ComunaClick.Shared.Api.Partner.Professional
@using PartnerServiceImage = ComunaClick.Shared.Api.Partner.ServiceImageInfo
@using PartnerProductImage = ComunaClick.Shared.Api.Partner.ProductImageInfo
@using PartnerStoreCategory = ComunaClick.Shared.Api.Partner.PartnerCatalogCategoryInfo

<PageTitle>@L.T("partner.catalog.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">@(IsServicePartner ? L.T("partner.catalog.b.badge") : IsProductPartner ? L.T("partner.catalog.a.badge") : "Catálogo editorial")</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@(IsServicePartner ? L.T("partner.catalog.b.heading") : IsProductPartner ? L.T("partner.catalog.a.heading") : HeadingTitle)</h1>
            <p class="mt-2 text-sm text-[#595c5d] max-w-2xl">@(IsServicePartner ? L.T("partner.catalog.b.subtitle") : IsProductPartner ? L.T("partner.catalog.a.subtitle") : HeadingSubtitle)</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <button type="button"
                    class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]"
                    @onclick="ToggleCreatePanel">
                <span class="material-symbols-outlined text-[20px]">@(_showCreatePanel ? "close" : "add_circle")</span>
                @(_showCreatePanel ? L.T("partner.catalog.create.hide") : (IsServicePartner ? L.T("partner.catalog.b.create.toggle") : IsProductPartner ? L.T("partner.catalog.a.create.toggle") : L.T("partner.catalog.create.toggle")))
            </button>
            @if (_partner is not null)
            {
                <PartnerPublicPreviewLink Href="@($"/buyer/detail/partner/{_partner.Id}")" Label="@L.T("partner.catalog.preview.company")" />
            }
        </div>
    </header>

    @if (IsProductPartner)
    {
        <div class="flex flex-wrap gap-2">
            <button type="button"
                    class="@(_commerceTab == "products" ? "rounded-2xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad]" : "rounded-2xl border border-[#dadddf] bg-white px-5 py-2.5 text-sm font-bold text-[#2c2f30]")"
                    @onclick='() => SetCommerceTab("products")'>
                @L.T("partner.catalog.a.tab.products")
            </button>
            @if (OffersHybridServices)
            {
                <button type="button"
                        class="@(_commerceTab == "services" ? "rounded-2xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad]" : "rounded-2xl border border-[#dadddf] bg-white px-5 py-2.5 text-sm font-bold text-[#2c2f30]")"
                        @onclick='() => SetCommerceTab("services")'>
                    @L.T("partner.catalog.a.tab.services")
                </button>
            }
            <button type="button"
                    class="@(_commerceTab == "sales" ? "rounded-2xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad]" : "rounded-2xl border border-[#dadddf] bg-white px-5 py-2.5 text-sm font-bold text-[#2c2f30]")"
                    @onclick='() => SetCommerceTab("sales")'>
                @L.T("partner.catalog.a.tab.sales")
            </button>
        </div>
    }

    @if (IsProductPartner && _commerceTab == "products")
    {
        <div class="rounded-2xl border border-[#dbe6e2] bg-white p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <p class="text-sm font-bold text-[#2c2f30]">@(OffersHybridServices ? L.T("partner.catalog.a.hybrid.activeTitle") : L.T("partner.catalog.a.hybrid.enable"))</p>
                <p class="mt-1 text-xs text-[#595c5d]">@(OffersHybridServices ? L.T("partner.catalog.a.hybrid.activeHint") : L.T("partner.catalog.a.hybrid.hint"))</p>
            </div>
            <button type="button"
                    class="@(OffersHybridServices ? "rounded-2xl bg-[#eff1f2] px-5 py-2.5 text-sm font-bold text-[#2c2f30]" : "rounded-2xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad]")"
                    disabled="@_isUpdatingHybrid"
                    @onclick="ToggleOffersServicesAsync">
                @(OffersHybridServices ? L.T("partner.catalog.a.hybrid.disable") : L.T("partner.catalog.a.hybrid.enableAction"))
            </button>
        </div>
    }

    @if (_partner is { IsVisible: false } && HasActiveCatalogOffer)
    {
        <div class="space-y-3">
            <StatusBanner Level="warning" Message="@L.T("partner.catalog.publish.required")" />
            <p class="text-sm text-[#595c5d]">@L.T("partner.catalog.publish.explain")</p>
            <a href="/partner/settings#publicacion"
               class="inline-flex items-center gap-2 rounded-2xl border border-[#3b6700]/40 bg-[#eff8e0] px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#e8f5d6]">
                <span class="material-symbols-outlined text-[18px]">publish</span>
                @L.T("partner.catalog.publish.goSettings")
            </a>
        </div>
    }

    @if (_showCreatePanel && _partner is not null)
    {
        <section class="rounded-3xl border border-[#3b6700]/30 bg-white p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-6">
            <div>
                <h2 class="text-xl font-black text-[#2c2f30]">@L.T("partner.catalog.create.title")</h2>
                <p class="mt-1 text-sm text-[#61897c]">@L.T("partner.catalog.create.subtitle")</p>
            </div>

            @if (ShowProductCatalog)
            {
                @if (_partner is not null)
                {
                    <PartnerCatalogCategoriesPanel PartnerId="@_partner.Id" CategoriesChanged="OnStoreCategoriesChanged" />
                }
                <EditForm Model="_createProduct" OnValidSubmit="CreateProductAsync">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.quickstart.service.name.label")"
                                               Tooltip="@L.T("partner.quickstart.service.name.tooltip")"
                                               Help="@L.T("partner.quickstart.service.name.help")">
                                    <input class="@InputClass" @bind="_createProduct.Name" />
                                    <ValidationMessage For="@(() => _createProduct.Name)" class="text-xs text-red-500" />
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.quickstart.service.description.label")"
                                               Help="@L.T("partner.quickstart.service.description.help")">
                                    <textarea class="@TextAreaClass" @bind="_createProduct.Description" rows="3"></textarea>
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <ProductMarketplaceCategoryPicker Groups="_commerceCategoryGroups"
                                                                  SelectedIds="_createDiscoverySubcategoryIds"
                                                                  SelectedIdsChanged="OnCreateDiscoveryIdsChanged"
                                                                  CompanyCategoryHint="@PartnerCompanyCategoryLabel"
                                                                  InputClass="@InputClass" />
                            </div>
                            <div class="md:col-span-2">
                                <ProductOfferGeoSection>
                                    <ServiceGeoPicker @key="@CreateProductMapElementId"
                                                      @ref="_createProductGeoPicker"
                                                      MapElementId="@CreateProductMapElementId"
                                                      Active="@(_showCreatePanel && _editingProductId is null)"
                                                      @bind-CountryId="_createProduct.CountryId"
                                                      @bind-RegionId="_createProduct.RegionId"
                                                      @bind-ComunaId="_createProduct.ComunaId"
                                                      Latitude="_createProduct.Latitude"
                                                      LatitudeChanged="OnCreateProductLatitudeChanged"
                                                      Longitude="_createProduct.Longitude"
                                                      LongitudeChanged="OnCreateProductLongitudeChanged" />
                                </ProductOfferGeoSection>
                            </div>
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.catalog.a.storeSection")"
                                               Tooltip="@L.T("partner.catalog.a.storeSection.tooltip")"
                                               Help="@L.T("partner.catalog.a.storeSection.help")">
                                <select class="@InputClass" value="@(_createProduct.PartnerCatalogCategoryId?.ToString() ?? "")" @onchange="OnCreateProductSectionChanged">
                                    <option value="">@L.T("partner.catalog.a.storeSection.placeholder")</option>
                                    @foreach (var cat in _storeCategories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                </FormFieldHelp>
                            </div>
                            <div>
                                <FormFieldHelp Label="@L.T("partner.catalog.a.salePrice")" Help="@L.T("partner.catalog.a.salePrice.help")">
                                    <input type="number" step="1" min="0" class="@InputClass" @bind="_createProduct.Price" />
                                </FormFieldHelp>
                            </div>
                            <div>
                                <FormFieldHelp Label="@L.T("partner.catalog.a.costPrice")" Help="@L.T("partner.catalog.a.costPrice.help")">
                                    <input type="number" step="1" min="0" class="@InputClass" @bind="_createProduct.CostPrice" />
                                </FormFieldHelp>
                            </div>
                            <div>
                                <FormFieldHelp Label="@L.T("partner.catalog.a.initialStock")"
                                               Help="@L.T("partner.catalog.a.initialStock.help")">
                                    <input type="number" min="0" class="@InputClass" @bind="_createProduct.StockQuantity" />
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <ProductImageUpload ProductId="@null"
                                                    Images="@EmptyProductImages"
                                                    PendingFiles="@_createPendingProductImages"
                                                    PendingFilesChanged="OnCreatePendingProductImagesChanged" />
                            </div>
                            <div class="md:col-span-2">
                                <button type="submit" class="@PrimaryButtonClass" disabled="@_isCreating">
                                    @(_isCreating ? L.T("partner.quickstart.service.submitting") : L.T("partner.catalog.a.create.product"))
                                </button>
                            </div>
                        </div>
                        <PartnerOfferPreviewCard IsProduct="true"
                                                 Name="@_createProduct.Name"
                                                 Description="@_createProduct.Description"
                                                 Category="@CreateProductSectionLabel"
                                                 Price="@_createProduct.Price"
                                                 ImageUrl="@PreviewImageForCreateProduct()"
                                                 CompanyName="@_partner!.Name" />
                    </div>
                </EditForm>
            }
            else if (ShowServiceCatalog)
            {
                <EditForm Model="_createService" OnValidSubmit="CreateServiceAsync" OnInvalidSubmit="OnCreateServiceInvalid">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.quickstart.service.name.label")"
                                               Tooltip="@L.T("partner.quickstart.service.name.tooltip")"
                                               Help="@L.T("partner.quickstart.service.name.help")">
                                    <input class="@InputClass" @bind="_createService.Name" placeholder="Ej. Supervisión de obra" />
                                    <ValidationMessage For="@(() => _createService.Name)" class="text-xs text-red-500" />
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.quickstart.service.description.label")"
                                               Help="@L.T("partner.quickstart.service.description.help")">
                                    <textarea class="@TextAreaClass" @bind="_createService.Description" rows="3"></textarea>
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <FormFieldHelp Label="@L.T("partner.quickstart.service.category.label")"
                                               Tooltip="@L.T("partner.quickstart.service.category.tooltip")"
                                               Help="@L.T("partner.quickstart.service.category.help")">
                                    <input class="@InputClass" list="catalog-service-categories" @bind="_createService.Category"
                                           placeholder="@L.T("partner.quickstart.service.category.placeholder")" />
                                    <datalist id="catalog-service-categories">
                                        @foreach (var s in _serviceCategorySuggestions)
                                        {
                                            <option value="@s"></option>
                                        }
                                    </datalist>
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2 space-y-3 rounded-2xl border border-[#dbe6e2] bg-[#f8faf9] p-4">
                                <p class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">Tipo de aviso</p>
                                <label class="flex gap-3 cursor-pointer">
                                    <input type="radio" name="create-pricing-mode" checked="@(_createService.IsBookableMode == false)" @onchange="() => SetCreatePricingMode(false)" />
                                    <span>
                                        <span class="text-sm font-bold text-[#2c2f30]">@L.T("partner.catalog.b.mode.listing")</span>
                                        <span class="block text-xs text-[#595c5d]">@L.T("partner.catalog.b.mode.listingHelp")</span>
                                    </span>
                                </label>
                                <label class="flex gap-3 cursor-pointer">
                                    <input type="radio" name="create-pricing-mode" checked="@_createService.IsBookableMode" @onchange="() => SetCreatePricingMode(true)" />
                                    <span>
                                        <span class="text-sm font-bold text-[#2c2f30]">@L.T("partner.catalog.b.mode.bookable")</span>
                                        <span class="block text-xs text-[#595c5d]">@L.T("partner.catalog.b.mode.bookableHelp")</span>
                                    </span>
                                </label>
                            </div>
                            @if (_createService.IsBookableMode)
                            {
                                <div>
                                    <FormFieldHelp Label="@L.T("partner.quickstart.service.duration.label")"
                                                   Tooltip="@L.T("partner.quickstart.service.duration.tooltip")"
                                                   Help="@L.T("partner.quickstart.service.duration.help")">
                                        <input type="number" step="5" min="15" class="@InputClass" @bind="_createService.DurationMinutes" />
                                    </FormFieldHelp>
                                </div>
                                <div>
                                    <FormFieldHelp Label="@L.T("partner.quickstart.service.price.label")" Help="@L.T("partner.quickstart.service.price.help")">
                                        <input type="number" step="1" min="1" class="@InputClass" @bind="_createService.Price" />
                                    </FormFieldHelp>
                                </div>
                                <div class="md:col-span-2 rounded-2xl border border-[#dbe6e2] bg-[#f8faf8] p-4">
                                    <p class="text-sm font-semibold text-[#2c2f30]">@L.T("partner.catalog.b.staff.title") <span class="text-red-600">*</span></p>
                                    <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.catalog.b.staff.help")</p>
                                    @if (_staff.Count == 0)
                                    {
                                        <p class="mt-3 text-xs font-medium text-amber-800">
                                            @L.T("partner.catalog.b.staff.empty")
                                            <a href="/partner/settings#equipo" class="ml-1 font-bold text-[#3b6700] underline">@L.T("partner.catalog.b.staff.emptyLink")</a>
                                        </p>
                                    }
                                    else
                                    {
                                        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                                            <p class="text-xs font-bold text-[#3b6700]">@string.Format(L.T("partner.catalog.b.staff.selected"), _createService.StaffCount)</p>
                                            @if (_staff.Count > 1)
                                            {
                                                <button type="button" class="text-xs font-bold text-[#3b6700] underline" @onclick="() => _createService.SelectAllStaff(_staff)">
                                                    @L.T("partner.catalog.b.staff.selectAll")
                                                </button>
                                            }
                                        </div>
                                        <div class="mt-3 flex flex-wrap gap-3">
                                            @foreach (var staff in _staff)
                                            {
                                                <label class="inline-flex items-center gap-2 rounded-xl border border-[#dadddf] bg-white px-3 py-2 text-sm">
                                                    <input type="checkbox" checked="@_createService.IsStaffSelected(staff.Id)" @onchange="e => _createService.ToggleStaff(staff.Id, e.Value is true)" />
                                                    <span class="font-semibold">@staff.Name</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            <div class="md:col-span-2 rounded-2xl border border-[#dbe6e2] bg-[#f8faf8] p-4 space-y-3">
                                <FormFieldHelp Label="@L.T("partner.catalog.b.serviceGeo.title")" Help="@L.T("partner.catalog.b.serviceGeo.help")">
                                    <ServiceGeoPicker @key="@("service-geo-map-create")"
                                                      @ref="_createServiceGeoPicker"
                                                      MapElementId="service-geo-map-create"
                                                      Active="@_showCreatePanel"
                                                      @bind-CountryId="_createService.CountryId"
                                                      @bind-RegionId="_createService.RegionId"
                                                      @bind-ComunaId="_createService.ComunaId"
                                                      Latitude="_createService.Latitude"
                                                      LatitudeChanged="OnCreateServiceLatitudeChanged"
                                                      Longitude="_createService.Longitude"
                                                      LongitudeChanged="OnCreateServiceLongitudeChanged" />
                                </FormFieldHelp>
                            </div>
                            <div class="md:col-span-2">
                                <ServiceImageUpload ServiceId="@null"
                                                    Images="@EmptyServiceImages"
                                                    PendingFiles="@_createPendingImages"
                                                    PendingFilesChanged="OnCreatePendingImagesChanged" />
                            </div>
                            <div class="md:col-span-2">
                                <button type="submit" class="@PrimaryButtonClass" disabled="@_isCreating">
                                    @(_isCreating ? L.T("partner.quickstart.service.submitting") : L.T("partner.catalog.b.create.service"))
                                </button>
                            </div>
                        </div>
                        <PartnerOfferPreviewCard Name="@_createService.Name"
                                                 Description="@_createService.Description"
                                                 Category="@_createService.Category"
                                                 Price="@(_createService.IsBookableMode ? _createService.Price : 0)"
                                                 DurationMinutes="@(_createService.IsBookableMode ? _createService.DurationMinutes : 0)"
                                                 ImageUrl="@PreviewImageForCreateService()"
                                                 CompanyName="@_partner.Name" />
                    </div>
                </EditForm>
            }
        </section>
    }

    @if (ShowSalesTab)
    {
        <section class="space-y-6">
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">@L.T("partner.catalog.a.sales.badge")</p>
                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.catalog.a.sales.heading")</h2>
                    <p class="mt-1 text-sm text-[#595c5d]">@L.T("partner.catalog.a.sales.subtitle")</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    @foreach (var period in SalesPeriodFilters)
                    {
                        <button type="button" class="@GetSalesChipClass(_salesPeriod, period.Key)" @onclick="() => _salesPeriod = period.Key">@period.Label</button>
                    }
                </div>
            </div>

            <div class="flex flex-wrap gap-2">
                @foreach (var filter in SalesStatusFilters)
                {
                    <button type="button" class="@GetSalesChipClass(_salesStatusFilter, filter.Key)" @onclick="() => _salesStatusFilter = filter.Key">@filter.Label</button>
                }
                @foreach (var group in SalesGroupFilters)
                {
                    <button type="button" class="@GetSalesChipClass(_salesGroupBy, group.Key)" @onclick="() => _salesGroupBy = group.Key">@group.Label</button>
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
                <article class="bg-white p-6 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.catalog.a.sales.metric.gross")</p>
                    <p class="text-2xl font-black text-[#2c2f30]">@Money(SalesSummary.Gross)</p>
                </article>
                <article class="bg-white p-6 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.catalog.a.sales.metric.margin")</p>
                    <p class="text-2xl font-black text-[#3b6700]">@Money(SalesSummary.Margin)</p>
                </article>
                <article class="bg-white p-6 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.catalog.a.sales.metric.commission")</p>
                    <p class="text-2xl font-black text-[#8a5b00]">@Money(SalesSummary.Commission)</p>
                </article>
                <article class="bg-white p-6 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.catalog.a.sales.metric.net")</p>
                    <p class="text-2xl font-black text-[#2c2f30]">@Money(SalesSummary.Net)</p>
                </article>
            </div>

            <div class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
                    <p class="text-sm font-bold text-[#2c2f30]">@L.T("partner.catalog.a.sales.tableTitle")</p>
                    <a href="/partner/orders" class="text-sm font-bold text-[#3b6700] hover:underline">@L.T("partner.catalog.a.sales.manageOrders")</a>
                </div>
                @if (_isLoadingSales)
                {
                    <div class="bg-white rounded-3xl p-8">
                        <BrandedLoading Title="@(L.T("ui.loading"))" Message="@L.T("partner.catalog.a.sales.loading")" Compact="true" />
                    </div>
                }
                else if (SalesRows.Count == 0)
                {
                    <div class="bg-white rounded-3xl p-8 text-center space-y-2">
                        <p class="text-lg font-bold text-[#2c2f30]">@L.T("partner.catalog.a.sales.empty")</p>
                        <p class="text-sm text-[#595c5d]">@L.T("partner.catalog.a.sales.emptyHint")</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-3xl bg-white shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <table class="min-w-full text-sm">
                            <thead class="text-left text-[10px] uppercase tracking-[0.14em] text-[#7b8081] border-b border-[#e3e6e8]">
                                <tr>
                                    <th class="px-5 py-4">@(_salesGroupBy == "category" ? L.T("partner.catalog.a.sales.col.category") : L.T("partner.catalog.a.sales.col.product"))</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.units")</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.gross")</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.cost")</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.margin")</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.commission")</th>
                                    <th class="px-5 py-4">@L.T("partner.catalog.a.sales.col.net")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in SalesRows)
                                {
                                    <tr class="border-b border-[#f0f2f3] last:border-0">
                                        <td class="px-5 py-4 font-bold text-[#2c2f30]">@row.Label</td>
                                        <td class="px-5 py-4 text-[#595c5d]">@row.Units</td>
                                        <td class="px-5 py-4">@Money(row.Gross)</td>
                                        <td class="px-5 py-4 text-[#595c5d]">@Money(row.Cost)</td>
                                        <td class="px-5 py-4 font-semibold text-[#3b6700]">@Money(row.Margin)</td>
                                        <td class="px-5 py-4 text-[#8a5b00]">@Money(row.Commission)</td>
                                        <td class="px-5 py-4 font-bold">@Money(row.Net)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="mt-4 text-xs text-[#7b8081]">@L.T("partner.catalog.a.sales.footnote")</p>
                }
            </div>
        </section>
    }
    else
    {
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@(IsServicePartner ? L.T("partner.catalog.b.count") : IsProductPartner ? L.T("partner.catalog.a.count") : CountLabel)</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@CurrentCount</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@(IsServicePartner ? L.T("partner.catalog.b.countHint") : IsProductPartner ? L.T("partner.catalog.a.countHint") : CountHint)</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@(IsServicePartner ? L.T("partner.catalog.b.bookable") : IsProductPartner ? L.T("partner.catalog.a.outOfStock") : MetricLabel)</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@(IsServicePartner ? BookableServiceCount : IsProductPartner ? OutOfStockProductCount : MetricValue)</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@(IsServicePartner ? L.T("partner.catalog.b.bookableHint") : IsProductPartner ? L.T("partner.catalog.a.outOfStockHint") : MetricHint)</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@(IsServicePartner ? L.T("partner.catalog.b.duration") : IsProductPartner ? L.T("partner.catalog.a.avgPrice") : "ESTADO")</p>
            <h2 class="@(IsServicePartner ? "text-4xl" : "text-2xl") font-black tracking-[-0.05em] text-[#2c2f30]">@(IsServicePartner ? ServiceDurationMetric : IsProductPartner ? ( _products.Count == 0 ? "$0" : Money(_products.Average(x => x.Price))) : StatusLabel)</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@(IsServicePartner ? L.T("partner.catalog.b.durationHint") : IsProductPartner ? L.T("partner.catalog.a.avgPriceHint") : _statusMessage)</p>
        </article>
    </div>

    <section class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">GESTION OPERATIVA</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@(IsServicePartner ? L.T("partner.catalog.b.section") : SectionTitle)</h2>
                @if (!string.IsNullOrWhiteSpace(_statusMessage) && _statusMessage != "—" && (_statusMessage.Contains("No se pudo", StringComparison.OrdinalIgnoreCase) || _statusMessage.Contains("permisos", StringComparison.OrdinalIgnoreCase) || _statusMessage.Contains("encontr", StringComparison.OrdinalIgnoreCase)))
                {
                    <p class="mt-1 text-sm font-semibold text-[#b91c1c]">@_statusMessage</p>
                }
                else if (IsServicePartner && !string.IsNullOrWhiteSpace(_statusMessage) && _statusMessage != "—")
                {
                    <p class="mt-1 text-sm text-[#595c5d]">@_statusMessage</p>
                }
            </div>
            @if (!IsServicePartner)
            {
                <a href="/partner/quickstart" class="text-sm font-bold text-[#3b6700] hover:underline">@CreateSecondaryLabel</a>
            }
            else
            {
                <button type="button" class="text-sm font-bold text-[#3b6700] hover:underline" @onclick="ToggleCreatePanel">@L.T("partner.catalog.b.create.toggle")</button>
            }
        </div>

        <div class="space-y-4">
            @if (_isLoading)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="@LoadingMessage" Compact="true" />
                </div>
            }
            else if (CurrentCount == 0)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-[#a7f255]/20 text-[#325800] flex items-center justify-center mx-auto">
                        <span class="material-symbols-outlined text-3xl">@EmptyIcon</span>
                    </div>
                    <p class="text-lg font-bold text-[#2c2f30]">@(IsServicePartner ? L.T("partner.catalog.b.empty") : EmptyTitle)</p>
                    <p class="text-sm text-[#595c5d] max-w-xl mx-auto">@(IsServicePartner ? L.T("partner.catalog.b.emptyHint") : _statusMessage)</p>
                    @if (IsServicePartner)
                    {
                        <button type="button" class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm" @onclick="ToggleCreatePanel">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            @L.T("partner.catalog.b.create.toggle")
                        </button>
                    }
                    else
                    {
                        <a href="/partner/quickstart" class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            @CreateCtaLabel
                        </a>
                    }
                </div>
            }
            else if (ShowProductCatalog)
            {
                @foreach (var item in _products)
                {
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-5">
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                            <div class="flex items-start gap-4">
                                <div class="w-24 h-24 rounded-2xl overflow-hidden bg-[#eff1f2] border border-[#e3e6e8] shrink-0">
                                    @{
                                        var productThumb = CatalogThumbUrl(item);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(productThumb))
                                    {
                                        <img src="@productThumb" alt="@item.Name" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center text-[#7b8081]">
                                            <span class="material-symbols-outlined text-3xl">image</span>
                                        </div>
                                    }
                                </div>
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@item.Name</p>
                                    <span class="@BadgeClass(item.IsActive)">@BadgeText(item.IsActive)</span>
                                    @{
                                        var onHand = item.StockQuantity ?? item.Inventory?.Quantity ?? 0;
                                        var available = item.AvailableQuantity ?? onHand;
                                        var reserved = item.ReservedQuantity ?? Math.Max(0, onHand - available);
                                    }
                                    <span class="inline-flex items-center rounded-full bg-[#eff1f2] px-3 py-1 text-[11px] font-bold text-[#2c2f30]">Stock: @onHand</span>
                                    @if (reserved > 0)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-[#fff4d6] px-3 py-1 text-[11px] font-bold text-[#8a5b00]">@available disponible · @reserved reservado</span>
                                    }
                                    else if (!item.InStock.GetValueOrDefault(available > 0))
                                    {
                                        <span class="inline-flex items-center rounded-full bg-[#fecaca] px-3 py-1 text-[11px] font-bold text-[#b42318]">Sin stock disponible</span>
                                    }
                                </div>
                                <p class="text-sm text-[#595c5d]">@(string.IsNullOrWhiteSpace(item.Description) ? "Sin descripcion comercial todavia." : item.Description)</p>
                                <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#7b8081]">@(string.IsNullOrWhiteSpace(item.Category) ? "Categoria pendiente" : item.Category)</p>
                            </div>
                            </div>
                            <div class="text-left md:text-right">
                                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("partner.catalog.a.salePrice")</p>
                                <p class="text-2xl font-black tracking-[-0.04em] text-[#3b6700]">@Money(item.Price)</p>
                                @if (item.CostPrice is > 0)
                                {
                                    <p class="mt-1 text-xs font-semibold text-[#7b8081]">@L.T("partner.catalog.a.margin"): @FormatMargin(item)</p>
                                }
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3">
                            <PartnerPublicPreviewLink Href="@($"/buyer/detail/product/{item.Id}")" Label="@L.T("partner.catalog.preview.item")" />
                            <button class="@PrimaryButtonClass" @onclick="() => BeginEditProductAsync(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                @L.T("partner.catalog.edit")
                            </button>
                            <button class="@SecondaryButtonClass" @onclick="() => ToggleProductActiveAsync(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">@ToggleIcon(item.IsActive)</span>
                                @ToggleLabel(item.IsActive)
                            </button>
                            <button type="button" class="@GhostButtonClass text-red-700 border-red-200" @onclick="() => DeleteProductAsync(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                @L.T("partner.catalog.a.delete")
                            </button>
                        </div>

                        @if (_editingProductId == item.Id)
                        {
                            <EditForm Model="_productEditor" OnValidSubmit="SaveProductAsync">
                                <DataAnnotationsValidator />
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-[#f5f6f7] rounded-3xl p-5">
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-semibold text-[#2c2f30]">Nombre</label>
                                        <input class="@InputClass" @bind="_productEditor.Name" />
                                        <ValidationMessage For="@(() => _productEditor.Name)" class="text-xs text-red-500" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-semibold text-[#2c2f30]">Descripcion</label>
                                        <textarea class="@TextAreaClass" @bind="_productEditor.Description"></textarea>
                                    </div>
                                    <div class="md:col-span-2">
                                        <ProductMarketplaceCategoryPicker Groups="_commerceCategoryGroups"
                                                                          SelectedIds="_editDiscoverySubcategoryIds"
                                                                          SelectedIdsChanged="OnEditDiscoveryIdsChanged"
                                                                          CompanyCategoryHint="@PartnerCompanyCategoryLabel"
                                                                          InputClass="@InputClass" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <ProductOfferGeoSection>
                                            <ServiceGeoPicker @key="@EditProductMapElementId(item.Id)"
                                                              @ref="_editProductGeoPicker"
                                                              MapElementId="@EditProductMapElementId(item.Id)"
                                                              Active="@(_editingProductId == item.Id)"
                                                              @bind-CountryId="_productEditor.CountryId"
                                                              @bind-RegionId="_productEditor.RegionId"
                                                              @bind-ComunaId="_productEditor.ComunaId"
                                                              Latitude="_productEditor.Latitude"
                                                              LatitudeChanged="OnProductEditorLatitudeChanged"
                                                              Longitude="_productEditor.Longitude"
                                                              LongitudeChanged="OnProductEditorLongitudeChanged" />
                                        </ProductOfferGeoSection>
                                    </div>
                                    <div class="md:col-span-2">
                                        <FormFieldHelp Label="@L.T("partner.catalog.a.storeSection")"
                                                       Tooltip="@L.T("partner.catalog.a.storeSection.tooltip")"
                                                       Help="@L.T("partner.catalog.a.storeSection.help")">
                                            <select class="@InputClass" value="@(_productEditor.PartnerCatalogCategoryId?.ToString() ?? "")" @onchange="OnEditProductSectionChanged">
                                                <option value="">@L.T("partner.catalog.a.storeSection.placeholder")</option>
                                                @foreach (var cat in _storeCategories)
                                                {
                                                    <option value="@cat.Id">@cat.Name</option>
                                                }
                                            </select>
                                        </FormFieldHelp>
                                    </div>
                                    <div>
                                        <label class="text-sm font-semibold text-[#2c2f30]">Stock</label>
                                        <input type="number" step="1" min="0" class="@InputClass" @bind="_productEditor.StockQuantity" />
                                        <ValidationMessage For="@(() => _productEditor.StockQuantity)" class="text-xs text-red-500" />
                                    </div>
                                    <div>
                                        <label class="text-sm font-semibold text-[#2c2f30]">@L.T("partner.catalog.a.salePrice")</label>
                                        <input type="number" step="1" min="0" class="@InputClass" @bind="_productEditor.Price" />
                                        <ValidationMessage For="@(() => _productEditor.Price)" class="text-xs text-red-500" />
                                    </div>
                                    <div>
                                        <label class="text-sm font-semibold text-[#2c2f30]">@L.T("partner.catalog.a.costPrice")</label>
                                        <input type="number" step="1" min="0" class="@InputClass" @bind="_productEditor.CostPrice" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <ProductImageUpload ProductId="@item.Id"
                                                            Images="@_editProductImages"
                                                            ImagesChanged="OnEditProductImagesChanged" />
                                    </div>
                                    <div class="md:col-span-2 flex flex-wrap gap-3">
                                        <button type="submit" class="@PrimaryButtonClass" disabled="@IsBusy(item.Id)">
                                            <span class="material-symbols-outlined text-[18px]">save</span>
                                            Guardar cambios
                                        </button>
                                        <button type="button" class="@GhostButtonClass" @onclick="CancelEdit">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            </EditForm>
                        }
                    </article>
                }
            }
            else if (ShowServiceCatalog)
            {
                @foreach (var item in _services)
                {
                    var bookable = IsServiceBookable(item);
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-5">
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                            <div class="flex items-start gap-4 min-w-0">
                                @{
                                    var serviceThumb = CatalogThumbUrl(item);
                                }
                                <div class="w-20 h-20 rounded-2xl overflow-hidden bg-[#eff1f2] border border-[#e3e6e8] shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(serviceThumb))
                                    {
                                        <img src="@serviceThumb" alt="" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center text-[#7b8081]">
                                            <span class="material-symbols-outlined text-3xl">image</span>
                                        </div>
                                    }
                                </div>
                                <div class="space-y-2 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@item.Name</p>
                                    <span class="@BadgeClass(item.IsActive)">@ServiceActiveBadge(item.IsActive)</span>
                                    <span class="@(bookable ? "inline-flex items-center rounded-full bg-[#e8f5d6] px-3 py-1 text-[11px] font-bold text-[#325800]" : "inline-flex items-center rounded-full bg-[#eff1f2] px-3 py-1 text-[11px] font-bold text-[#595c5d]")">
                                        @(bookable ? L.T("partner.catalog.b.badge.bookable") : L.T("partner.catalog.b.badge.listing"))
                                    </span>
                                    @if (bookable)
                                    {
                                        var staffN = item.ProfessionalIds?.Count ?? 0;
                                        <span class="@(staffN > 0 ? "inline-flex items-center rounded-full bg-[#eff8e0] px-3 py-1 text-[11px] font-bold text-[#3b6700]" : "inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-900")">
                                            @(staffN > 0 ? string.Format(L.T("partner.catalog.b.staff.assigned"), staffN) : L.T("partner.catalog.b.staff.missing"))
                                        </span>
                                    }
                                </div>
                                <p class="text-sm text-[#595c5d]">@(string.IsNullOrWhiteSpace(item.Description) ? "Sin descripcion comercial todavia." : item.Description)</p>
                                <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#7b8081]">@(string.IsNullOrWhiteSpace(item.Category) ? L.T("partner.quickstart.service.category.placeholder") : item.Category)</p>
                                </div>
                            </div>
                            <div class="text-left md:text-right shrink-0">
                                @if (bookable)
                                {
                                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("partner.catalog.b.withPrice")</p>
                                    <p class="text-2xl font-black tracking-[-0.04em] text-[#3b6700]">@Money(item.Price)</p>
                                    <p class="mt-1 text-xs text-[#595c5d]">@item.DurationMinutes min</p>
                                }
                                else
                                {
                                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("partner.catalog.b.noPrice")</p>
                                    <p class="text-lg font-black text-[#595c5d]">—</p>
                                }
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3">
                            <PartnerPublicPreviewLink Href="@($"/buyer/detail/service/{item.Id}")" Label="@L.T("partner.catalog.preview.item")" />
                            <button class="@PrimaryButtonClass" @onclick="() => BeginEditService(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                @L.T("partner.catalog.edit")
                            </button>
                            <button class="@SecondaryButtonClass" @onclick="() => ToggleServiceActiveAsync(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">@ToggleIcon(item.IsActive)</span>
                                @ToggleLabel(item.IsActive)
                            </button>
                            <button type="button" class="@GhostButtonClass text-red-700 border-red-200" @onclick="() => DeleteServiceAsync(item)" disabled="@IsBusy(item.Id)">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                @L.T("partner.catalog.b.delete")
                            </button>
                        </div>

                        @if (_editingServiceId == item.Id)
                        {
                            <EditForm Model="_serviceEditor" OnValidSubmit="SaveServiceAsync" OnInvalidSubmit="OnServiceEditInvalid">
                                <DataAnnotationsValidator />
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-[#f5f6f7] rounded-3xl p-5">
                                        <div class="md:col-span-2">
                                            <FormFieldHelp Label="@L.T("partner.quickstart.service.name.label")" Help="@L.T("partner.quickstart.service.name.help")">
                                                <input class="@InputClass" @bind="_serviceEditor.Name" />
                                                <ValidationMessage For="@(() => _serviceEditor.Name)" class="text-xs text-red-500" />
                                            </FormFieldHelp>
                                        </div>
                                        <div class="md:col-span-2">
                                            <FormFieldHelp Label="@L.T("partner.quickstart.service.description.label")" Help="@L.T("partner.quickstart.service.description.help")">
                                                <textarea class="@TextAreaClass" @bind="_serviceEditor.Description"></textarea>
                                            </FormFieldHelp>
                                        </div>
                                        <div class="md:col-span-2">
                                            <FormFieldHelp Label="@L.T("partner.quickstart.service.category.label")"
                                                           Tooltip="@L.T("partner.quickstart.service.category.tooltip")"
                                                           Help="@L.T("partner.quickstart.service.category.help")">
                                                <input class="@InputClass" list="catalog-service-categories-edit" @bind="_serviceEditor.Category" />
                                                <datalist id="catalog-service-categories-edit">
                                                    @foreach (var s in _serviceCategorySuggestions)
                                                    {
                                                        <option value="@s"></option>
                                                    }
                                                </datalist>
                                            </FormFieldHelp>
                                        </div>
                                        <div class="md:col-span-2 space-y-3 rounded-2xl border border-[#dbe6e2] bg-white p-4">
                                            <p class="text-xs text-[#7b8081]">@L.T("partner.catalog.b.priceChangeWarning")</p>
                                            <label class="flex gap-3 cursor-pointer">
                                                <input type="radio" name="edit-pricing-mode-@item.Id" checked="@(_serviceEditor.IsBookableMode == false)" @onchange="() => SetEditPricingMode(false)" />
                                                <span class="text-sm font-bold">@L.T("partner.catalog.b.mode.listing")</span>
                                            </label>
                                            <label class="flex gap-3 cursor-pointer">
                                                <input type="radio" name="edit-pricing-mode-@item.Id" checked="@_serviceEditor.IsBookableMode" @onchange="() => SetEditPricingMode(true)" />
                                                <span class="text-sm font-bold">@L.T("partner.catalog.b.mode.bookable")</span>
                                            </label>
                                        </div>
                                        @if (_serviceEditor.IsBookableMode)
                                        {
                                            <div>
                                                <FormFieldHelp Label="@L.T("partner.quickstart.service.duration.label")" Help="@L.T("partner.quickstart.service.duration.help")">
                                                    <input type="number" step="5" min="15" class="@InputClass" @bind="_serviceEditor.DurationMinutes" />
                                                    <ValidationMessage For="@(() => _serviceEditor.DurationMinutes)" class="text-xs text-red-500" />
                                                </FormFieldHelp>
                                            </div>
                                            <div>
                                                <FormFieldHelp Label="@L.T("partner.quickstart.service.price.label")" Help="@L.T("partner.quickstart.service.price.help")">
                                                    <input type="number" step="1" min="1" class="@InputClass" @bind="_serviceEditor.Price" />
                                                    <ValidationMessage For="@(() => _serviceEditor.Price)" class="text-xs text-red-500" />
                                                </FormFieldHelp>
                                            </div>
                                            <div class="md:col-span-2 rounded-2xl border border-[#dbe6e2] bg-[#f8faf8] p-4">
                                                <p class="text-sm font-semibold">@L.T("partner.catalog.b.staff.title") <span class="text-red-600">*</span></p>
                                                <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.catalog.b.staff.help")</p>
                                                @if (_staff.Count == 0)
                                                {
                                                    <p class="mt-3 text-xs font-medium text-amber-800">
                                                        @L.T("partner.catalog.b.staff.empty")
                                                        <a href="/partner/settings#equipo" class="ml-1 font-bold text-[#3b6700] underline">@L.T("partner.catalog.b.staff.emptyLink")</a>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                                                        <p class="text-xs font-bold text-[#3b6700]">@string.Format(L.T("partner.catalog.b.staff.selected"), _serviceEditor.StaffCount)</p>
                                                        @if (_staff.Count > 1)
