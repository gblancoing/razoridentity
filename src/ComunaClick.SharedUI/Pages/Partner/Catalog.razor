    private bool IsProductPartner => string.Equals(_partner?.Type, "A", StringComparison.OrdinalIgnoreCase);
    private bool IsServicePartner => string.Equals(_partner?.Type, "B", StringComparison.OrdinalIgnoreCase);
    private bool OffersHybridServices => _partner?.OffersServices == true;
    private bool ShowProductCatalog => IsProductPartner && _commerceTab == "products";
    private bool ShowServiceCatalog => IsServicePartner || (IsProductPartner && OffersHybridServices && _commerceTab == "services");
    private bool ShowSalesTab => IsProductPartner && _commerceTab == "sales";

    private IReadOnlyList<FilterChip> SalesStatusFilters { get; } =
    [
        new("paid", "Pagadas"),
        new("pending", "Pendientes"),
        new("all", "Todas")
    ];

    private IReadOnlyList<FilterChip> SalesGroupFilters { get; } =
    [
        new("category", "Por categoría"),
        new("product", "Por producto")
    ];

    private IReadOnlyList<FilterChip> SalesPeriodFilters { get; } =
    [
        new("7d", "7 días"),
        new("30d", "30 días"),
        new("90d", "90 días"),
        new("all", "Todo")
    ];

    private SalesTotals SalesSummary => ComputeSalesTotals();
    private List<SalesRow> SalesRows => BuildSalesRows();
    private int OutOfStockProductCount => _products.Count(x =>
    {
        if (!x.IsActive)
        {
            return false;
        }

        var available = x.AvailableQuantity ?? x.Inventory?.Quantity ?? 0;
        return available <= 0;
    });
    private int BookableServiceCount => _services.Count(IsServiceBookable);
