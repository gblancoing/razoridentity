        }

        _busyItemId = item.Id;
        try
        {
            await PartnerApi.DeleteProductAsync(item.Id);
            _products.RemoveAll(x => x.Id == item.Id);
            _statusMessage = L.T("partner.catalog.a.delete");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo eliminar ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _busyItemId = null;
        }
    }

