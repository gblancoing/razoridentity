    private IEnumerable<ComunaClick.Shared.Api.Partner.Order> FilteredSalesOrders()
    {
        var from = _salesPeriod switch
        {
            "7d" => DateTimeOffset.UtcNow.AddDays(-7),
            "30d" => DateTimeOffset.UtcNow.AddDays(-30),
            "90d" => DateTimeOffset.UtcNow.AddDays(-90),
            _ => (DateTimeOffset?)null
        };

        IEnumerable<ComunaClick.Shared.Api.Partner.Order> query = _orders;
        if (from.HasValue)
        {
            query = query.Where(x => x.CreatedAt >= from.Value);
        }

        return query.Where(order =>
        {
            var status = order.Status?.Trim().ToLowerInvariant() ?? string.Empty;
            return _salesStatusFilter switch
            {
                "paid" => status == "paid",
                "pending" => status is "payment_pending" or "processing",
                _ => true
            };
        });
    }

    private List<SalesRow> BuildSalesRows()
    {
        var productMap = _products.ToDictionary(x => x.Id);
        var buckets = new Dictionary<string, SalesRow>(StringComparer.OrdinalIgnoreCase);

        foreach (var order in FilteredSalesOrders())
        {
            if (order.Items is null || order.Items.Count == 0)
            {
                continue;
            }

            var orderGross = (decimal)(order.GrossAmount > 0 ? order.GrossAmount : order.TotalAmount);
            var orderFee = (decimal)order.PlatformFeeAmount;
            var orderNet = order.NetAmount > 0 ? (decimal)order.NetAmount : decimal.Max(0m, orderGross - orderFee);
            var itemsTotal = order.Items.Sum(x => (decimal)x.TotalPrice);
            if (itemsTotal <= 0)
            {
                itemsTotal = orderGross;
            }

            foreach (var item in order.Items)
            {
                if (!productMap.TryGetValue(item.ProductId, out var product))
                {
                    continue;
                }

                var share = itemsTotal > 0 ? (decimal)item.TotalPrice / itemsTotal : 1m / order.Items.Count;
                var lineGross = (decimal)item.TotalPrice;
                var unitCost = (decimal)(product.CostPrice ?? 0);
                var lineCost = unitCost * item.Quantity;
                var lineCommission = orderFee * share;
                var lineNet = orderNet * share;
                var key = _salesGroupBy == "category"
                    ? product.Category ?? "Sin categoría"
                    : product.Id.ToString();
                var label = _salesGroupBy == "category"
                    ? product.Category ?? "Sin categoría"
                    : product.Name ?? "Producto";

                if (!buckets.TryGetValue(key, out var row))
                {
                    row = new SalesRow(label);
                    buckets[key] = row;
                }

                buckets[key] = row with
                {
                    Units = row.Units + item.Quantity,
                    Gross = row.Gross + lineGross,
                    Cost = row.Cost + lineCost,
                    Commission = row.Commission + lineCommission,
                    Net = row.Net + lineNet
                };
            }
        }

        return buckets.Values
            .OrderByDescending(x => x.Gross)
            .ToList();
    }

    private SalesTotals ComputeSalesTotals()
    {
        var rows = BuildSalesRows();
        return new SalesTotals(
            rows.Sum(x => x.Gross),
            rows.Sum(x => x.Cost),
            rows.Sum(x => x.Commission),
            rows.Sum(x => x.Net));
    }

