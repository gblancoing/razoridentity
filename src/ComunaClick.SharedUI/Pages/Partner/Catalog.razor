        public double? Longitude { get; set; }
        public bool IsBookableMode { get; set; }
        [Range(0, 999999999)] public double Price { get; set; }
        public int DurationMinutes { get; set; } = 60;

        public int StaffCount => _staffIds.Count;

        public bool IsStaffSelected(Guid id) => _staffIds.Contains(id);

        public void SelectAllStaff(IEnumerable<PartnerProfessional> staff)
        {
            foreach (var member in staff)
            {
                _staffIds.Add(member.Id);
            }
        }

        public void ToggleStaff(Guid id, bool selected)
        {
            if (selected)
            {
                _staffIds.Add(id);
            }
            else
            {
                _staffIds.Remove(id);
            }
        }

        public void SetStaffIds(IReadOnlyList<Guid>? ids)
        {
            _staffIds.Clear();
            if (ids is null)
            {
                return;
            }

            foreach (var id in ids)
            {
                _staffIds.Add(id);
            }
        }

        public void ClearStaff() => _staffIds.Clear();

        public IReadOnlyList<Guid>? SelectedStaffIds()
            => _staffIds.Count == 0 ? null : _staffIds.ToList();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!IsBookableMode)
            {
                yield break;
            }

            if (DurationMinutes is < 15 or > 1440)
            {
                yield return new ValidationResult(
                    "Los servicios reservables requieren una duración entre 15 y 1440 minutos.",
                    [nameof(DurationMinutes)]);
            }

            if (Price < 1)
            {
                yield return new ValidationResult(
                    "Ingresá un precio mayor a cero para servicios reservables.",
                    [nameof(Price)]);
            }
        }
    }

