    private async Task ToggleOffersServicesAsync()
    {
        if (_partner is null)
        {
            return;
        }

        _isUpdatingHybrid = true;
        try
        {
            var next = !OffersHybridServices;
            var updated = await PartnerApi.UpdatePartnerAsync(_partner.Id, new ComunaClick.Shared.Api.Partner.PartnerUpdateRequest(
                null, null, null, null, null, null, null, null, null, null, next));
            if (updated is not null)
            {
                _partner = updated;
                if (next)
                {
                    _commerceTab = "services";
                    await LoadAsync(_partner.Id);
                }
                else
                {
                    _services.Clear();
                    _staff.Clear();
                    _commerceTab = "products";
                }
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo actualizar la configuración ({(int?)ex.StatusCode ?? 0}).";
        }
        catch
        {
            _statusMessage = "No se pudo actualizar la configuración.";
        }
        finally
        {
            _isUpdatingHybrid = false;
        }
    }

    private async Task DeleteProductAsync(PartnerProduct item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L.T("partner.catalog.a.deleteConfirm")))
        {
