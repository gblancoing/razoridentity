    private static string FormatApiErrorMessage(HttpRequestException ex, string fallback)
    {
        if (string.IsNullOrWhiteSpace(ex.Message))
        {
            return fallback;
        }

        const string marker = "\"message\":\"";
        var start = ex.Message.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (start >= 0)
        {
            start += marker.Length;
            var end = ex.Message.IndexOf('"', start);
            if (end > start)
            {
                return ex.Message[start..end];
            }
        }

        return ex.StatusCode.HasValue
            ? $"{fallback} ({(int)ex.StatusCode.Value})"
            : fallback;
    }

    private sealed class ServiceEditor : IValidatableObject
    {
