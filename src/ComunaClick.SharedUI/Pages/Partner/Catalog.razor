    private async Task SaveProductAsync()
    {
        if (_editingProductId is null)
        {
            return;
        }

        if (_editDiscoverySubcategoryIds.Count == 0)
        {
            _statusMessage = L.T("partner.catalog.a.marketplaceCategory.required");
            return;
        }

        var geoError = await PrepareProductGeoForSaveAsync(_productEditor, _editProductGeoPicker);
        if (geoError is not null)
        {
            _statusMessage = L.T(geoError);
            return;
        }

        _busyItemId = _editingProductId;
        try
        {
            var (saveLat, saveLng) = await ResolveProductCoordinatesAsync(_productEditor, _editProductGeoPicker);
            var updated = await PartnerApi.UpdateProductAsync(_editingProductId.Value, new ComunaClick.Shared.Api.Partner.ProductUpdateRequest(
                Clean(_productEditor.Name),
                Clean(_productEditor.Description),
                ResolveProductSectionLabel(_productEditor.PartnerCatalogCategoryId),
                _productEditor.PartnerCatalogCategoryId,
                null,
                _productEditor.Price,
                _productEditor.CostPrice > 0 ? _productEditor.CostPrice : null,
                "CLP",
                null,
                null,
                _productEditor.CountryId,
                _productEditor.RegionId,
                _productEditor.ComunaId,
                saveLat,
                saveLng,
                _editDiscoverySubcategoryIds.ToList()));
            if (updated is not null)
            {
                var inventory = await PartnerApi.UpdateProductInventoryAsync(_editingProductId.Value, new ComunaClick.Shared.Api.Partner.ProductInventoryUpdateRequest(_productEditor.StockQuantity));
                if (_editProductImages.Count > 0)
                {
                    updated = updated with
                    {
                        Images = _editProductImages,
                        ImageUrls = _editProductImages.Select(x => x.Url).ToList(),
                        ImageUrl = _editProductImages[0].Url
                    };
                }

                updated = updated with { Inventory = inventory };
                ReplaceProduct(updated);
                _statusMessage = L.T("partner.catalog.a.create.product");
            }
            CancelEdit();
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo actualizar el producto ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _busyItemId = null;
        }
    }

    private async Task SaveServiceAsync()
    {
        if (_editingServiceId is null)
        {
            return;
        }

        ClearEditFormMessage();

        if (!ValidateBookableStaff(_serviceEditor, out var staffErrorKey))
        {
            SetEditFormMessage(L.T(staffErrorKey!));
            await InvokeAsync(StateHasChanged);
            return;
        }

        var geoError = await PrepareServiceGeoForSaveAsync(_serviceEditor, _editServiceGeoPicker);
        if (geoError is not null)
        {
            SetEditFormMessage(L.T(geoError));
            await InvokeAsync(StateHasChanged);
            return;
        }

        var (saveLat, saveLng) = await ResolveServiceCoordinatesAsync(_serviceEditor, _editServiceGeoPicker);
        ApplyResolvedCoordinates(_serviceEditor, (saveLat, saveLng));
        if (saveLat is not double latToSave || saveLng is not double lngToSave)
        {
            SetEditFormMessage(L.T("partner.catalog.b.geo.pinRequired"));
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_serviceEditor.ComunaId is not Guid comunaId || comunaId == Guid.Empty)
        {
            SetEditFormMessage(L.T("partner.catalog.b.geo.required"));
            await InvokeAsync(StateHasChanged);
            return;
        }

        var serviceId = _editingServiceId.Value;
        _busyItemId = serviceId;
        try
        {
            var price = _serviceEditor.IsBookableMode ? _serviceEditor.Price : 0;
            var duration = _serviceEditor.IsBookableMode ? _serviceEditor.DurationMinutes : 30;

            var updated = await PartnerApi.UpdateServiceAsync(serviceId, new ComunaClick.Shared.Api.Partner.ServiceUpdateRequest(
                Clean(_serviceEditor.Name),
                Clean(_serviceEditor.Description),
                Clean(_serviceEditor.Category),
                price,
                "CLP",
                duration,
                null,
                null,
                null,
                null,
                null,
                null,
                null,
                null,
                _serviceEditor.SelectedStaffIds()));
            if (updated is null)
            {
                SetEditFormMessage(L.T("partner.catalog.form.saveFailed"));
                return;
            }

            var geoUpdated = await PartnerApi.UpdateServiceGeoAsync(
                serviceId,
                _serviceEditor.CountryId,
                _serviceEditor.RegionId,
                _serviceEditor.ComunaId,
                latToSave,
                lngToSave);
            if (geoUpdated is null)
            {
                SetEditFormMessage(L.T("partner.catalog.form.saveFailed"));
                return;
            }

            updated = await PartnerApi.GetServiceAsync(serviceId) ?? geoUpdated;
            updated = MergeServiceGeoIntoResponse(updated, latToSave, lngToSave, _serviceEditor);

            if (_editServiceImages.Count > 0)
            {
                updated = updated with
                {
                    Images = _editServiceImages,
                    ImageUrls = _editServiceImages.Select(x => x.Url).ToList(),
                    ImageUrl = _editServiceImages[0].Url
                };
            }

            ReplaceService(updated);
            _editServiceGeoLatitude = latToSave;
            _editServiceGeoLongitude = lngToSave;
            _statusMessage = L.T("partner.catalog.form.saveSuccess");
            CancelEdit();
        }
        catch (HttpRequestException ex)
        {
            SetEditFormMessage(FormatApiErrorMessage(ex, L.T("partner.catalog.form.saveFailed")));
        }
        finally
        {
            _busyItemId = null;
        }
    }

