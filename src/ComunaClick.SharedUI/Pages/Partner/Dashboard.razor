@page "/partner"
@layout PartnerLayout
@using System.Net
@using ComunaClick.Shared.Auth
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L.T("partner.dashboard.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">@L.T("partner.dashboard.hub.title")</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.dashboard.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.dashboard.hub.subtitle")</p>
            @if (!string.IsNullOrWhiteSpace(_userLabel))
            {
                <p class="mt-3 text-sm text-[#3b6700] font-semibold">@L.T("partner.dashboard.sessionActive") @_userLabel</p>
            }
        </div>

        <a href="@PrimaryActionHref"
           class="group inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)] hover:shadow-[0_22px_36px_-18px_rgba(59,103,0,0.9)] transition-all">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            @PrimaryActionLabel
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(_welcomeMessage))
    {
        <section class="rounded-2xl border border-[#a7f255]/60 bg-[#a7f255]/15 p-5">
            <p class="text-sm font-semibold text-[#325800]">@_welcomeMessage</p>
        </section>
    }

    @if (_loadFailed)
    {
        <StatusBanner Level="warning" Message="@_statusMessage" />
    }

    @if (_activeBusiness is not null)
    {
        <section class="rounded-3xl bg-white p-6 md:p-8 border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#7b8081]">@L.T("partner.dashboard.business.badge")</p>
                    <h2 class="mt-2 text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@_activeBusiness.Name</h2>
                    <p class="mt-1 text-sm text-[#595c5d]">@CompanySubtitle</p>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#f0fdf4] px-4 py-2 text-xs font-bold text-[#14532d]">
                    <span class="material-symbols-outlined text-[18px]">@CompanyTypeIcon</span>
                    @CompanyTypeLabel
                </span>
            </div>

            <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.catalog")</p>
                    <p class="mt-2 text-3xl font-black text-[#2c2f30]">@_catalogCount</p>
                </article>
                <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.visibility")</p>
                    <p class="mt-2 text-lg font-black text-[#2c2f30]">@VisibilityLabel</p>
                </article>
                <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.category")</p>
                    <p class="mt-2 text-sm font-bold text-[#2c2f30]">@CategoryLabel</p>
                </article>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
                <a href="@PublicPreviewHref" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-2.5 text-sm font-bold hover:border-[#3b6700]/40">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    @(_activeBusiness.IsVisible ? L.T("buyer.profile.company.panel.viewPublic") : L.T("buyer.profile.company.panel.previewDraft"))
                </a>
                <a href="@AccountRoutes.PartnerSettings"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-2.5 text-sm font-bold hover:border-[#3b6700]/40">
                    <span class="material-symbols-outlined text-[18px]">apartment</span>
                    @L.T("partner.nav.settings")
                </a>
                @if (_activation is not null && _activation.IsVisible)
                {
                    <button class="inline-flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 text-red-700 px-5 py-2.5 text-sm font-bold"
                            @onclick="() => ToggleVisibilityAsync(false)"
                            disabled="@_isUpdatingVisibility">
                        <span class="material-symbols-outlined text-[18px]">visibility_off</span>
                        @L.T("partner.dashboard.action.unpublish")
                    </button>
                }
                @if (_businesses.Count > 1)
                {
                    <a href="/my-businesses"
                       class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-2.5 text-sm font-bold hover:border-[#3b6700]/40">
                        <span class="material-symbols-outlined text-[18px]">store</span>
                        @L.T("partner.userMenu.businesses")
                    </a>
                }
            </div>
        </section>
    }

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/partner/catalog" class="flex items-center gap-3 rounded-2xl border border-[#e3e6e8] bg-white p-4 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[24px] text-[#3b6700]">inventory_2</span>
            <span>
                <span class="block text-sm font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.catalog.title")</span>
                <span class="block text-xs text-[#595c5d]">@L.T("partner.dashboard.hub.catalog.desc")</span>
            </span>
        </a>
        <a href="/partner/agenda" class="flex items-center gap-3 rounded-2xl border border-[#e3e6e8] bg-white p-4 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[24px] text-[#3b6700]">calendar_month</span>
            <span>
                <span class="block text-sm font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.agenda.title")</span>
                <span class="block text-xs text-[#595c5d]">@L.T("partner.dashboard.hub.agenda.desc")</span>
            </span>
        </a>
        <a href="@PublicPreviewHref" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-2xl border border-[#e3e6e8] bg-white p-4 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[24px] text-[#3b6700]">storefront</span>
            <span>
                <span class="block text-sm font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.company.title")</span>
                <span class="block text-xs text-[#595c5d]">@L.T("partner.dashboard.hub.company.desc")</span>
            </span>
        </a>
    </section>

    @* Checklist de activación: solo durante el onboarding. Una vez publicado y al 100%
       deja de ocupar espacio (Despublicar queda en la tarjeta del negocio). *@
    @if (_activation is not null && !(_activation.IsVisible && _activation.CompletionPercent >= 100))
    {
        <section class="rounded-3xl bg-white p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] border border-[#e3e6e8]">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-6">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">@L.T("partner.dashboard.activation.badge")</p>
                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@_activation.StatusLabel</h2>
                    <p class="mt-2 text-sm text-[#595c5d]">@_activation.NextStep</p>
                </div>
                <div class="rounded-2xl bg-[#f5f6f7] px-6 py-5 border border-[#e3e6e8] min-w-[180px]">
                    <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">@L.T("partner.dashboard.activation.checklist")</p>
                    <p class="mt-2 text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_activation.CompletionPercent%</p>
                    <p class="text-xs text-[#595c5d] mt-1">@L.T("partner.dashboard.activation.completed")</p>
                </div>
            </div>

            <div class="w-full h-3 rounded-full bg-[#e6e8ea] overflow-hidden mb-6">
                <div class="h-3 rounded-full bg-[#3b6700]" style="width:@($"{_activation.CompletionPercent}%")"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var item in _activation.Checklist ?? Array.Empty<ComunaClick.Shared.Api.Partner.PartnerChecklistItem>())
                {
                    <article class="rounded-2xl border border-[#e3e6e8] bg-[#fbfcfc] p-4">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined @(item.IsComplete ? "text-[#3b6700]" : "text-[#b58c00]")">
                                @(item.IsComplete ? "check_circle" : "pending")
                            </span>
                            <div>
                                <p class="font-bold text-[#2c2f30]">@item.Label</p>
                                @if (!item.IsComplete && !string.IsNullOrWhiteSpace(item.Hint))
                                {
                                    <p class="text-sm text-[#595c5d] mt-1">@item.Hint</p>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                @if (_activation.IsVisible)
                {
                    <button class="inline-flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 text-red-700 px-5 py-3 font-bold text-sm"
                            @onclick="() => ToggleVisibilityAsync(false)"
                            disabled="@_isUpdatingVisibility">
                        <span class="material-symbols-outlined text-[18px]">visibility_off</span>
                        @L.T("partner.dashboard.action.unpublish")
                    </button>
                }
                else if (_activation.CanPublish)
                {
                    <button class="inline-flex items-center gap-2 rounded-2xl border border-[#3b6700] bg-[#f3f9eb] text-[#3b6700] px-5 py-3 font-bold text-sm"
                            @onclick="() => ToggleVisibilityAsync(true)"
                            disabled="@_isUpdatingVisibility">
                        <span class="material-symbols-outlined text-[18px]">publish</span>
                        @L.T("partner.dashboard.action.publish")
                    </button>
                }
                else
                {
                    <a href="/register/business"
                       class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                        <span class="material-symbols-outlined text-[18px]">edit_square</span>
                        @L.T("partner.dashboard.action.completeBusiness")
                    </a>
                }

                <a href="/partner/catalog"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                    @L.T("partner.dashboard.action.reviewCatalog")
                </a>

                <a href="@PublicPreviewHref"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                    <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                    @L.T("partner.dashboard.action.viewPublic")
                </a>
            </div>
        </section>
    }

    @* El editor de datos públicos vive en Ajuste de empresa (link en la tarjeta del negocio). *@

    <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <article class="bg-white p-5 rounded-2xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.dashboard.kpi.sales")</p>
                    <h3 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@_ordersTotal</h3>
                    <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.dashboard.kpi.salesHint")</p>
                </article>

                <article class="bg-white p-5 rounded-2xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.dashboard.kpi.bookings")</p>
                    <h3 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@_bookingsCount</h3>
                    <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.dashboard.kpi.bookingsHint")</p>
                </article>

                <article class="bg-white p-5 rounded-2xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-2">@L.T("partner.dashboard.kpi.leads")</p>
                    <h3 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@_leadsCount</h3>
                    <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.dashboard.kpi.leadsHint")</p>
                </article>
            </div>

            <a href="/partner/catalog"
               class="mt-4 flex items-center justify-between gap-3 rounded-2xl border border-[#e3e6e8] bg-white p-4 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors">
                <span class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[22px] text-[#3b6700]">query_stats</span>
                    <span class="text-sm font-bold text-[#2c2f30]">@L.T("partner.dashboard.section.sales")</span>
                </span>
                <span class="material-symbols-outlined text-[20px] text-[#7b8081]">arrow_right_alt</span>
            </a>
        </div>

        <div class="col-span-12 xl:col-span-4 space-y-6">
            <section class="bg-white p-6 rounded-2xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                <div class="flex justify-between items-center mb-4">
                    <h4 class="text-base font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.dashboard.section.bookings")</h4>
                    <a class="text-[#3b6700] text-xs font-bold hover:underline" href="/partner/agenda">@L.T("partner.dashboard.bookings.viewAll")</a>
                </div>

                <div class="space-y-4">
                    @if (_upcomingBookings.Count == 0)
                    {
                        <div class="rounded-2xl border border-dashed border-[#dadddf] bg-[#f7f8f8] p-5 text-center">
                            <p class="text-sm font-bold text-[#2c2f30]">@L.T("partner.dashboard.bookings.empty")</p>
                            <p class="mt-1 text-xs text-[#595c5d]">@L.T("partner.dashboard.bookings.emptyHint")</p>
                        </div>
                    }
                    @foreach (var slot in _upcomingBookings)
                    {
                        <div class="group flex items-center gap-4 p-4 rounded-2xl hover:bg-[#f5f6f7] transition-all border border-transparent hover:border-[#e3e6e8]">
                            <div class="w-12 h-12 rounded-xl bg-[#a7f255]/20 text-[#325800] flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined">@slot.Icon</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-bold text-[#2c2f30]">@slot.Title</p>
                                <p class="text-xs text-[#595c5d]">@slot.Subtitle</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-black tracking-[-0.03em] text-[#3b6700]">@slot.Time</p>
                                <p class="text-[10px] text-[#7b8081] uppercase font-bold tracking-[0.12em]">@slot.DayLabel</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 p-4 bg-[#a7f255]/20 rounded-2xl border-l-4 border-[#3b6700]">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-[#3b6700]">lightbulb</span>
                        <div>
                            <p class="text-xs font-bold text-[#325800]">@L.T("partner.dashboard.tip.title")</p>
                            <p class="text-[11px] text-[#325800]/85 leading-relaxed mt-1">
                                @L.T("partner.dashboard.tip.body")
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            @* Con un solo negocio, la tarjeta principal ya muestra esta información. *@
            @if (_businesses.Count > 1)
            {
                <section class="bg-[#eff1f2] p-6 rounded-3xl border border-[#dadddf]">
                    <div class="flex items-center justify-between gap-3 mb-6">
                        <div>
                            <h4 class="text-xs font-bold tracking-[0.15em] text-[#7b8081] uppercase">@L.T("partner.dashboard.businesses.title")</h4>
                            <p class="mt-2 text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.dashboard.businesses.subtitle")</p>
                        </div>
                        <a class="text-sm font-bold text-[#3b6700] hover:underline" href="/my-businesses">@L.T("partner.dashboard.businesses.manage")</a>
                    </div>

                    <div class="space-y-3">
                        @foreach (var business in _businesses)
                        {
                            <article class="rounded-2xl bg-white border border-[#e3e6e8] p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="font-bold text-[#2c2f30]">@business.Name</p>
                                        <p class="text-xs text-[#595c5d]">@string.Format(L.T("partner.dashboard.businesses.type"), business.Type)</p>
                                    </div>
                                    @if (business.Id == AuthState.PartnerId)
                                    {
                                        <span class="text-[11px] px-2 py-1 rounded-full bg-[#a7f255]/20 text-[#3b6700] font-semibold">@L.T("partner.dashboard.businesses.active")</span>
                                    }
                                </div>
                                <p class="mt-2 text-sm text-[#595c5d]">@(business.Email ?? business.Phone ?? business.Address ?? L.T("partner.dashboard.businesses.noContact"))</p>
                                <p class="mt-1 text-xs text-[#7b8081]">@(business.Activation?.StatusLabel ?? (business.IsVisible ? L.T("partner.dashboard.businesses.published") : L.T("partner.dashboard.businesses.pending")))</p>
                                <div class="mt-3 flex items-center gap-2 text-xs font-bold @(HasExactLocation(business) ? "text-[#3b6700]" : "text-[#7b8081]")">
                                    <span class="material-symbols-outlined text-[16px]">@(HasExactLocation(business) ? "my_location" : "location_on")</span>
                                    @(HasExactLocation(business) ? L.T("partner.dashboard.businesses.exactLocation") : L.T("partner.dashboard.businesses.comunaLocation"))
                                </div>
                                <a class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-[#3b6700] hover:underline" href="@($"/buyer/detail/partner/{business.Id}")">
                                    @L.T("partner.dashboard.action.viewPublic")
                                    <span class="material-symbols-outlined text-[16px]">arrow_right_alt</span>
                                </a>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="bg-[#eff1f2] p-6 rounded-3xl border border-[#dadddf]">
                <h4 class="text-xs font-bold tracking-[0.15em] text-[#7b8081] uppercase mb-6">@L.T("partner.dashboard.quickActions.title")</h4>
                <div class="grid grid-cols-2 gap-3">
                    <a href="/partner/quickstart" class="flex flex-col items-center justify-center p-4 bg-white rounded-2xl hover:shadow-md transition-shadow border border-[#e3e6e8]">
                        <span class="material-symbols-outlined text-[#3b6700] mb-2">person_add</span>
                        <span class="text-[11px] font-bold text-[#2c2f30]">@L.T("partner.dashboard.quickActions.newOffer")</span>
                    </a>
                    <a href="/my-businesses" class="flex flex-col items-center justify-center p-4 bg-white rounded-2xl hover:shadow-md transition-shadow border border-[#e3e6e8]">
                        <span class="material-symbols-outlined text-[#3b6700] mb-2">history</span>
                        <span class="text-[11px] font-bold text-[#2c2f30]">@L.T("partner.dashboard.businesses.title")</span>
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private string _statusMessage = string.Empty;
    private bool _loadFailed;
    private string _ordersTotal = "$0";
    private int _bookingsCount;
    private int _leadsCount;
    private int _catalogCount;
    private string? _welcomeMessage;
    private string? _userLabel;
    private ComunaClick.Shared.Api.Partner.PartnerActivationStatus? _activation;
    private readonly List<ComunaClick.Shared.Api.Partner.PartnerDto> _businesses = new();
    private bool _isUpdatingVisibility;
    private IReadOnlyList<ComunaClick.Shared.Api.Partner.Booking> _bookings = [];
    private List<BookingCard> _upcomingBookings = new();

    private string PrimaryActionHref => _activation is null
        ? "/partner/quickstart"
        : _activation.IsVisible
            ? "/partner/catalog"
            : _activation.CanPublish
                ? "#publish"
                : "/register/business";

    private string PrimaryActionLabel => _activation?.IsVisible == true
        ? L.T("partner.dashboard.primary.manageCatalog")
        : _activation?.CanPublish == true
            ? L.T("partner.dashboard.primary.publish")
            : _activation?.PartnerType switch
        {
            "B" => L.T("partner.dashboard.primary.firstService"),
            "C" => L.T("partner.dashboard.primary.firstProfessional"),
            _ => L.T("partner.dashboard.primary.firstProduct")
        };

    private string PublicPreviewHref => AuthState.PartnerId is Guid partnerId && partnerId != Guid.Empty
        ? $"/buyer/detail/partner/{partnerId}"
        : "/categorias";

    private ComunaClick.Shared.Api.Partner.PartnerDto? _activeBusiness => GetEditableBusiness();

    private bool IsCommerce => string.Equals(_activeBusiness?.Type, "A", StringComparison.OrdinalIgnoreCase);
    private bool IsService => string.Equals(_activeBusiness?.Type, "B", StringComparison.OrdinalIgnoreCase);

    private string CompanyTypeIcon => IsCommerce ? "storefront" : IsService ? "home_repair_service" : "store";

    private string CompanyTypeLabel => IsCommerce
        ? L.T("buyer.profile.company.type.commerce")
        : IsService
            ? L.T("buyer.profile.company.type.service")
            : L.T("buyer.profile.company.type.generic");

    private string CompanySubtitle => IsCommerce
        ? L.T("buyer.profile.company.subtitle.commerce")
        : IsService
            ? L.T("buyer.profile.company.subtitle.service")
            : L.T("buyer.profile.company.subtitle.generic");

    private string VisibilityLabel => (_activation?.IsVisible ?? _activeBusiness?.IsVisible) == true
        ? L.T("buyer.profile.company.visible")
        : L.T("buyer.profile.company.hidden");

    private string CategoryLabel => _activeBusiness?.SubcategoryName
        ?? _activeBusiness?.CategoryName
        ?? "—";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        SetDefaultStatusMessage();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _welcomeMessage = GetQueryParameter(uri.Query, "welcome");
        _userLabel = AuthState.DisplayName
            ?? AuthState.Email
            ?? (AuthState.Tokens is not null ? JwtHelper.GetStringClaim(AuthState.Tokens.AccessToken, "name") : null)
            ?? (AuthState.Tokens is not null ? JwtHelper.GetStringClaim(AuthState.Tokens.AccessToken, "email") : null);

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            return;
        }

        try
        {
            var orders = await PartnerApi.GetPartnerOrdersAsync(partnerId.Value);
            var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
            _activation = await PartnerApi.GetActivationStatusAsync(partnerId.Value);
            _businesses.Clear();

            var businesses = await PartnerApi.ListMyPartnersAsync();
            if (businesses is not null)
            {
                _businesses.AddRange(businesses);
            }

            _bookings = bookings ?? [];
            _upcomingBookings = BuildUpcomingBookings();
            _bookingsCount = _bookings.Count;
            _ordersTotal = orders is null ? "$0"
                : $"${orders.Where(x => string.Equals(x.Status, "paid", StringComparison.OrdinalIgnoreCase)).Sum(x => x.TotalAmount):N0}";
            await LoadBusinessMetricsAsync(partnerId.Value);
            SetDefaultStatusMessage();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = L.T("partner.dashboard.status.forbidden");
            _loadFailed = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.dashboard.status.notFound");
            _loadFailed = true;
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = string.Format(L.T("partner.dashboard.status.loadFailed"), (int?)ex.StatusCode ?? 0);
            _loadFailed = true;
        }
    }

    private async Task LoadBusinessMetricsAsync(Guid partnerId)
    {
        _catalogCount = 0;
        _leadsCount = 0;

        var business = _businesses.FirstOrDefault(x => x.Id == partnerId) ?? _businesses.FirstOrDefault();
        if (business is null)
        {
            return;
        }

        try
        {
            if (string.Equals(business.Type, "A", StringComparison.OrdinalIgnoreCase))
            {
                var products = await PartnerApi.GetPartnerProductsAsync(partnerId);
                _catalogCount = products?.Count ?? 0;
            }
            else if (string.Equals(business.Type, "B", StringComparison.OrdinalIgnoreCase))
            {
                var services = await PartnerApi.GetPartnerServicesAsync(partnerId);
                _catalogCount = services?.Count ?? 0;

                try
                {
                    var leads = await PartnerApi.GetPartnerLeadsAsync(partnerId);
                    _leadsCount = leads?.Count ?? 0;
                }
                catch (HttpRequestException)
                {
                    _leadsCount = 0;
                }
            }
        }
        catch (HttpRequestException)
        {
            _catalogCount = 0;
        }
    }

    private async Task ToggleVisibilityAsync(bool isVisible)
    {
        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            return;
        }

        _isUpdatingVisibility = true;
        _statusMessage = isVisible
            ? L.T("partner.dashboard.status.publishing")
            : L.T("partner.dashboard.status.unpublishing");

        try
        {
            var updated = await PartnerApi.UpdateVisibilityAsync(partnerId.Value, isVisible);
            _activation = updated?.Activation ?? _activation;

            if (updated is not null)
            {
                var index = _businesses.FindIndex(x => x.Id == updated.Id);
                if (index >= 0)
                {
                    _businesses[index] = updated;
                }
            }

            _statusMessage = isVisible
                ? L.T("partner.dashboard.status.published")
                : L.T("partner.dashboard.status.unpublished");

            if (AuthState.PartnerId is Guid pid)
            {
                await LoadBusinessMetricsAsync(pid);
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = string.Format(L.T("partner.dashboard.status.visibilityFailed"), (int?)ex.StatusCode ?? 0);
        }
        finally
        {
            _isUpdatingVisibility = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleChange()
    {
        _upcomingBookings = BuildUpcomingBookings();
        InvokeAsync(StateHasChanged);
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var trimmed = query.TrimStart('?');
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(pieces[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return pieces.Length > 1 ? Uri.UnescapeDataString(pieces[1]) : string.Empty;
        }

        return null;
    }

    private static bool HasExactLocation(ComunaClick.Shared.Api.Partner.PartnerDto business)
        => business.Latitude is not null && business.Longitude is not null;

    // El negocio activo de la sesión (la edición del perfil vive en Ajuste de empresa).
    private ComunaClick.Shared.Api.Partner.PartnerDto? GetEditableBusiness()
    {
        if (AuthState.PartnerId is { } partnerId && partnerId != Guid.Empty)
        {
            var selected = _businesses.FirstOrDefault(x => x.Id == partnerId);
            if (selected is not null)
            {
                return selected;
            }
        }

        return _businesses.FirstOrDefault();
    }

    private void SetDefaultStatusMessage()
        => _statusMessage = L.T("partner.dashboard.status.salesEmpty");

    private List<BookingCard> BuildUpcomingBookings()
    {
        var now = DateTimeOffset.Now;
        return _bookings
            .Where(x => x.StartAt >= now.AddHours(-1))
            .Where(x => !string.Equals(x.Status, "cancelled", StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.StartAt)
            .Take(3)
            .Select(x => new BookingCard(
                "calendar_today",
                BookingStatusLabel(x.Status),
                $"${x.Amount:N0} {x.Currency}".TrimEnd(),
                x.StartAt.ToLocalTime().ToString("HH:mm"),
                BookingDayLabel(x.StartAt.ToLocalTime())))
            .ToList();
    }

    private string BookingStatusLabel(string? status)
    {
        var normalized = status?.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return L.T("partner.dashboard.bookings.item.title");
        }

        var key = $"partner.agenda.status.{normalized}";
        var label = L.T(key);
        return string.Equals(label, key, StringComparison.Ordinal)
            ? L.T("partner.dashboard.bookings.item.title")
            : label;
    }

    private string BookingDayLabel(DateTimeOffset startLocal)
    {
        var today = DateTime.Now.Date;
        if (startLocal.Date == today)
        {
            return L.T("partner.dashboard.bookings.day.today");
        }

        return startLocal.Date == today.AddDays(1)
            ? L.T("partner.dashboard.bookings.day.tomorrow")
            : startLocal.ToString("dd MMM");
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private sealed record BookingCard(string Icon, string Title, string Subtitle, string Time, string DayLabel);
}
