@page "/partner"
@layout PartnerLayout
@using System.Net
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L.T("partner.dashboard.title")</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">@L.T("partner.dashboard.heading")</h1>
            <p class="text-sm text-[#61897c]">@L.T("partner.dashboard.subtitle")</p>
        </div>
        <a href="@PrimaryActionHref" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm">@PrimaryActionLabel</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_welcomeMessage))
    {
        <div class="rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm text-[#111816] dark:text-white">@_welcomeMessage</div>
    }

    @if (_activation is not null)
    {
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-5 space-y-4">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                <div>
                    <p class="text-xs uppercase tracking-wider text-[#61897c]">Activación Etapa 1</p>
                    <h2 class="text-xl font-bold">@_activation.StatusLabel</h2>
                    <p class="text-sm text-[#61897c] mt-1">@_activation.NextStep</p>
                </div>
                <div class="text-right">
                    <p class="text-3xl font-bold">@_activation.CompletionPercent%</p>
                    <p class="text-xs text-[#61897c]">Checklist completado</p>
                </div>
            </div>
            <div class="w-full h-3 rounded-full bg-gray-100 dark:bg-[#10221c] overflow-hidden">
                <div class="h-3 bg-primary" style="width:@($"{_activation.CompletionPercent}%")"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                @foreach (var item in _activation.Checklist ?? Array.Empty<ComunaClick.Shared.Api.Partner.PartnerChecklistItem>())
                {
                    <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined @(item.IsComplete ? "text-emerald-500" : "text-amber-500")">@(item.IsComplete ? "check_circle" : "pending")</span>
                            <div>
                                <p class="font-semibold">@item.Label</p>
                                @if (!item.IsComplete && !string.IsNullOrWhiteSpace(item.Hint))
                                {
                                    <p class="text-xs text-[#61897c] mt-1">@item.Hint</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-5">
            <p class="text-xs uppercase tracking-wider text-[#61897c]">@L.T("partner.dashboard.kpi.sales")</p>
            <p class="text-2xl font-bold mt-2">@(_ordersTotal)</p>
            <p class="text-xs text-[#61897c] mt-1">@L.T("partner.dashboard.kpi.salesHint")</p>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-5">
            <p class="text-xs uppercase tracking-wider text-[#61897c]">@L.T("partner.dashboard.kpi.bookings")</p>
            <p class="text-2xl font-bold mt-2">@(_bookingsCount)</p>
            <p class="text-xs text-[#61897c] mt-1">@L.T("partner.dashboard.kpi.bookingsHint")</p>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-5">
            <p class="text-xs uppercase tracking-wider text-[#61897c]">@L.T("partner.dashboard.kpi.leads")</p>
            <p class="text-2xl font-bold mt-2">@(_leadsCount)</p>
            <p class="text-xs text-[#61897c] mt-1">@L.T("partner.dashboard.kpi.leadsHint")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h2 class="text-lg font-bold mb-4">@L.T("partner.dashboard.section.sales")</h2>
            <div class="h-48 border border-dashed border-gray-300 dark:border-gray-700 rounded-lg flex items-center justify-center text-sm text-[#61897c]">
                @_statusMessage
            </div>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h2 class="text-lg font-bold mb-4">@L.T("partner.dashboard.section.bookings")</h2>
            <div class="space-y-3">
                <div class="flex items-center justify-between text-sm">
                    <span>@L.T("partner.dashboard.nextBooking")</span>
                    <span class="font-semibold">12:30</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span>@L.T("partner.dashboard.nextBooking2")</span>
                    <span class="font-semibold">15:00</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span>@L.T("partner.dashboard.nextBooking3")</span>
                    <span class="font-semibold">18:10</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _statusMessage = "—";
    private string _ordersTotal = "$0";
    private int _bookingsCount;
    private int _leadsCount;
    private string? _welcomeMessage;
    private ComunaClick.Shared.Api.Partner.PartnerActivationStatus? _activation;

    private string PrimaryActionHref => _activation?.PartnerType switch
    {
        "B" => "/partner/quickstart",
        "C" => "/partner/quickstart",
        _ => "/partner/quickstart"
    };

    private string PrimaryActionLabel => _activation?.CanPublish == true
        ? "Seguir gestionando oferta"
        : _activation?.PartnerType switch
        {
            "B" => "Crear primer servicio",
            "C" => "Registrar primer profesional",
            _ => "Crear primer producto"
        };

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _welcomeMessage = GetQueryParameter(uri.Query, "welcome");

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            return;
        }

        try
        {
            var orders = await PartnerApi.GetPartnerOrdersAsync(partnerId.Value);
            var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
            _activation = await PartnerApi.GetActivationStatusAsync(partnerId.Value);

            _bookingsCount = bookings?.Count ?? 0;
            _ordersTotal = orders is null ? "$0" : $"${orders.Sum(x => x.TotalAmount):N0}";
            _leadsCount = 0;
            _statusMessage = L.T("partner.dashboard.section.placeholder");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver el dashboard de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = "Aun no hay datos suficientes para mostrar el dashboard.";
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo cargar el dashboard ({(int?)ex.StatusCode ?? 0}).";
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var trimmed = query.TrimStart('?');
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(pieces[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return pieces.Length > 1 ? Uri.UnescapeDataString(pieces[1]) : string.Empty;
        }

        return null;
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
