@page "/partner"
@layout PartnerLayout
@using System.Net
@using ComunaClick.Shared.Auth
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L.T("partner.dashboard.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">@L.T("partner.dashboard.hub.title")</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.dashboard.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.dashboard.hub.subtitle")</p>
            @if (!string.IsNullOrWhiteSpace(_userLabel))
            {
                <p class="mt-3 text-sm text-[#3b6700] font-semibold">Sesión activa: @_userLabel</p>
            }
        </div>

        <a href="@PrimaryActionHref"
           class="group inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)] hover:shadow-[0_22px_36px_-18px_rgba(59,103,0,0.9)] transition-all">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            @PrimaryActionLabel
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(_welcomeMessage))
    {
        <section class="rounded-2xl border border-[#a7f255]/60 bg-[#a7f255]/15 p-5">
            <p class="text-sm font-semibold text-[#325800]">@_welcomeMessage</p>
        </section>
    }

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/partner/catalog" class="rounded-3xl border border-[#e3e6e8] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[32px] text-[#3b6700]">inventory_2</span>
            <h2 class="mt-4 text-lg font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.catalog.title")</h2>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.dashboard.hub.catalog.desc")</p>
        </a>
        <a href="/partner/agenda" class="rounded-3xl border border-[#e3e6e8] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[32px] text-[#3b6700]">calendar_month</span>
            <h2 class="mt-4 text-lg font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.agenda.title")</h2>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.dashboard.hub.agenda.desc")</p>
        </a>
        <a href="@PublicPreviewHref" target="_blank" rel="noopener noreferrer" class="rounded-3xl border border-[#e3e6e8] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-[#3b6700]/40 transition-colors group">
            <span class="material-symbols-outlined text-[32px] text-[#3b6700]">storefront</span>
            <h2 class="mt-4 text-lg font-black text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("partner.dashboard.hub.company.title")</h2>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.dashboard.hub.company.desc")</p>
        </a>
    </section>

    @if (_activation is not null)
    {
        <section class="rounded-3xl bg-white p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] border border-[#e3e6e8]">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-6">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">Activación etapa 1</p>
                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@_activation.StatusLabel</h2>
                    <p class="mt-2 text-sm text-[#595c5d]">@_activation.NextStep</p>
                </div>
                <div class="rounded-2xl bg-[#f5f6f7] px-6 py-5 border border-[#e3e6e8] min-w-[180px]">
                    <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">Checklist</p>
                    <p class="mt-2 text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_activation.CompletionPercent%</p>
                    <p class="text-xs text-[#595c5d] mt-1">Completado</p>
                </div>
            </div>

            <div class="w-full h-3 rounded-full bg-[#e6e8ea] overflow-hidden mb-6">
                <div class="h-3 rounded-full bg-[#3b6700]" style="width:@($"{_activation.CompletionPercent}%")"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var item in _activation.Checklist ?? Array.Empty<ComunaClick.Shared.Api.Partner.PartnerChecklistItem>())
                {
                    <article class="rounded-2xl border border-[#e3e6e8] bg-[#fbfcfc] p-4">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined @(item.IsComplete ? "text-[#3b6700]" : "text-[#b58c00]")">
                                @(item.IsComplete ? "check_circle" : "pending")
                            </span>
                            <div>
                                <p class="font-bold text-[#2c2f30]">@item.Label</p>
                                @if (!item.IsComplete && !string.IsNullOrWhiteSpace(item.Hint))
                                {
                                    <p class="text-sm text-[#595c5d] mt-1">@item.Hint</p>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                @if (_activation.IsVisible)
                {
                    <button class="inline-flex items-center gap-2 rounded-2xl border border-red-200 bg-red-50 text-red-700 px-5 py-3 font-bold text-sm"
                            @onclick="() => ToggleVisibilityAsync(false)"
                            disabled="@_isUpdatingVisibility">
                        <span class="material-symbols-outlined text-[18px]">visibility_off</span>
                        Despublicar negocio
                    </button>
                }
                else if (_activation.CanPublish)
                {
                    <button class="inline-flex items-center gap-2 rounded-2xl border border-[#3b6700] bg-[#f3f9eb] text-[#3b6700] px-5 py-3 font-bold text-sm"
                            @onclick="() => ToggleVisibilityAsync(true)"
                            disabled="@_isUpdatingVisibility">
                        <span class="material-symbols-outlined text-[18px]">publish</span>
                        Publicar negocio
                    </button>
                }
                else
                {
                    <a href="/register/business"
                       class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                        <span class="material-symbols-outlined text-[18px]">edit_square</span>
                        Completar negocio
                    </a>
                }

                <a href="/partner/catalog"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                    Revisar catálogo
                </a>

                <a href="@PublicPreviewHref"
                   class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm">
                    <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                    Ver en público
                </a>
            </div>
        </section>
    }

    @if (_businesses.Count > 0)
    {
        <section class="rounded-3xl bg-white p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] border border-[#e3e6e8] space-y-6">
            <div>
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">Perfil del negocio</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Editar datos públicos</h2>
                <p class="mt-2 text-sm text-[#595c5d]">Actualiza el nombre, dirección y canales de contacto que ve buyer.</p>
            </div>

            @if (_businesses.Count > 1)
            {
                <div>
                    <label class="text-xs font-bold text-[#2c2f30]">Negocio a editar</label>
                    <select class="mt-2 w-full md:max-w-xl h-11 rounded-2xl border border-[#dadddf] px-3 text-sm"
                            value="@(_editingBusinessId?.ToString())"
                            @onchange="HandleBusinessSelectionChanged">
                        @foreach (var business in _businesses)
                        {
                            <option value="@business.Id">@business.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="text-xs font-bold text-[#2c2f30]">Nombre del negocio</label>
                    <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm"
                           @bind="_profileEditor.Name" />
                </div>
                <div>
                    <label class="text-xs font-bold text-[#2c2f30]">Dirección</label>
                    <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm"
                           @bind="_profileEditor.Address" />
                </div>
                <div>
                    <label class="text-xs font-bold text-[#2c2f30]">Teléfono</label>
                    <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm"
                           @bind="_profileEditor.Phone" />
                </div>
                <div>
                    <label class="text-xs font-bold text-[#2c2f30]">Correo de contacto</label>
                    <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm"
                           @bind="_profileEditor.Email" />
                </div>
            </div>

            <div class="flex flex-wrap gap-3">
                <button class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm disabled:opacity-60"
                        @onclick="SaveBusinessProfileAsync"
                        disabled="@_isSavingProfile">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    @(_isSavingProfile ? "Guardando..." : "Guardar cambios")
                </button>
                <button class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white text-[#2c2f30] px-5 py-3 font-bold text-sm"
                        @onclick="ResetBusinessProfileEditor"
                        disabled="@_isSavingProfile">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    Restaurar
                </button>
            </div>
        </section>
    }

    <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            <article class="bg-white p-8 rounded-3xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@L.T("partner.dashboard.kpi.sales")</p>
                <h3 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_ordersTotal</h3>
                <div class="mt-2 flex items-center gap-2 text-xs text-[#595c5d]">
                    <span class="material-symbols-outlined text-[15px]">calendar_month</span>
                    @L.T("partner.dashboard.kpi.salesHint")
                </div>
            </article>

            <article class="bg-white p-8 rounded-3xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@L.T("partner.dashboard.kpi.bookings")</p>
                <h3 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_bookingsCount</h3>
                <div class="mt-2 flex items-center gap-2 text-xs text-[#595c5d]">
                    <span class="material-symbols-outlined text-[15px]">check_circle</span>
                    @L.T("partner.dashboard.kpi.bookingsHint")
                </div>
            </article>

            <article class="bg-white p-8 rounded-3xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">@L.T("partner.dashboard.kpi.leads")</p>
                <h3 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@_leadsCount</h3>
                <div class="mt-2 flex items-center gap-2 text-xs text-[#595c5d]">
                    <span class="material-symbols-outlined text-[15px]">bolt</span>
                    @L.T("partner.dashboard.kpi.leadsHint")
                </div>
            </article>

            <section class="col-span-1 md:col-span-3 bg-white rounded-3xl p-8 border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] min-h-[400px] flex flex-col">
                <div class="flex justify-between items-center mb-10">
                    <h4 class="text-xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.dashboard.section.sales")</h4>
                    <div class="flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-[#a7f255]/70"></span>
                        <span class="w-3 h-3 rounded-full bg-[#a7f255]/30"></span>
                    </div>
                </div>

                <div class="flex-1 border-2 border-dashed border-[#dadddf] rounded-3xl flex flex-col items-center justify-center bg-[#f7f8f8] px-6 text-center">
                    <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mb-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.08)]">
                        <span class="material-symbols-outlined text-[#3b6700] text-3xl">query_stats</span>
                    </div>
                    <p class="text-[#2c2f30] font-bold text-lg mb-2">Datos comerciales en preparación</p>
                    <p class="text-sm text-[#595c5d] max-w-md">@_statusMessage</p>
                    <a class="mt-4 text-[#3b6700] font-bold hover:underline inline-flex items-center gap-1" href="@PrimaryActionHref">
                        Acceder ahora
                        <span class="material-symbols-outlined text-[18px]">arrow_right_alt</span>
                    </a>
                </div>
            </section>
        </div>

        <div class="col-span-12 xl:col-span-4 space-y-6">
            <section class="bg-white p-8 rounded-3xl border border-[#e3e6e8] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                <div class="flex justify-between items-center mb-8">
                    <h4 class="text-xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.dashboard.section.bookings")</h4>
                    <a class="text-[#3b6700] text-xs font-bold hover:underline" href="/partner/agenda">Ver todo</a>
                </div>

                <div class="space-y-4">
                    @foreach (var slot in _upcomingBookings)
                    {
                        <div class="group flex items-center gap-4 p-4 rounded-2xl hover:bg-[#f5f6f7] transition-all border border-transparent hover:border-[#e3e6e8]">
                            <div class="w-12 h-12 rounded-xl bg-[#a7f255]/20 text-[#325800] flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined">@slot.Icon</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-bold text-[#2c2f30]">@slot.Title</p>
                                <p class="text-xs text-[#595c5d]">@slot.Subtitle</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-black tracking-[-0.03em] text-[#3b6700]">@slot.Time</p>
                                <p class="text-[10px] text-[#7b8081] uppercase font-bold tracking-[0.12em]">@slot.DayLabel</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-8 p-4 bg-[#a7f255]/20 rounded-2xl border-l-4 border-[#3b6700]">
                    <div class="flex gap-3">
                        <span class="material-symbols-outlined text-[#3b6700]">lightbulb</span>
                        <div>
                            <p class="text-xs font-bold text-[#325800]">Tip Editorial</p>
                            <p class="text-[11px] text-[#325800]/85 leading-relaxed mt-1">
                                Aumenta tus reservas destacando horarios con menor demanda y productos de entrada.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            @if (_businesses.Count > 0)
            {
                <section class="bg-[#eff1f2] p-6 rounded-3xl border border-[#dadddf]">
                    <div class="flex items-center justify-between gap-3 mb-6">
                        <div>
                            <h4 class="text-xs font-bold tracking-[0.15em] text-[#7b8081] uppercase">Mis negocios</h4>
                            <p class="mt-2 text-lg font-black tracking-[-0.03em] text-[#2c2f30]">Todos los negocios registrados</p>
                        </div>
                        <a class="text-sm font-bold text-[#3b6700] hover:underline" href="/my-businesses">Administrar</a>
                    </div>

                    <div class="space-y-3">
                        @foreach (var business in _businesses)
                        {
                            <article class="rounded-2xl bg-white border border-[#e3e6e8] p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="font-bold text-[#2c2f30]">@business.Name</p>
                                        <p class="text-xs text-[#595c5d]">Tipo @business.Type</p>
                                    </div>
                                    @if (business.Id == AuthState.PartnerId)
                                    {
                                        <span class="text-[11px] px-2 py-1 rounded-full bg-[#a7f255]/20 text-[#3b6700] font-semibold">Activo</span>
                                    }
                                </div>
                                <p class="mt-2 text-sm text-[#595c5d]">@(business.Email ?? business.Phone ?? business.Address ?? "Sin contacto")</p>
                                <p class="mt-1 text-xs text-[#7b8081]">@(business.Activation?.StatusLabel ?? (business.IsVisible ? "Publicado" : "Pendiente"))</p>
                                <div class="mt-3 flex items-center gap-2 text-xs font-bold @(HasExactLocation(business) ? "text-[#3b6700]" : "text-[#7b8081]")">
                                    <span class="material-symbols-outlined text-[16px]">@(HasExactLocation(business) ? "my_location" : "location_on")</span>
                                    @(HasExactLocation(business) ? "Ubicación exacta configurada" : "Usando referencia por comuna")
                                </div>
                                <a class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-[#3b6700] hover:underline" href="@($"/buyer/detail/partner/{business.Id}")">
                                    Ver en público
                                    <span class="material-symbols-outlined text-[16px]">arrow_right_alt</span>
                                </a>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="bg-[#eff1f2] p-6 rounded-3xl border border-[#dadddf]">
                <h4 class="text-xs font-bold tracking-[0.15em] text-[#7b8081] uppercase mb-6">Acciones rápidas</h4>
                <div class="grid grid-cols-2 gap-3">
                    <a href="/partner/quickstart" class="flex flex-col items-center justify-center p-4 bg-white rounded-2xl hover:shadow-md transition-shadow border border-[#e3e6e8]">
                        <span class="material-symbols-outlined text-[#3b6700] mb-2">person_add</span>
                        <span class="text-[11px] font-bold text-[#2c2f30]">Nueva oferta</span>
                    </a>
                    <a href="/my-businesses" class="flex flex-col items-center justify-center p-4 bg-white rounded-2xl hover:shadow-md transition-shadow border border-[#e3e6e8]">
                        <span class="material-symbols-outlined text-[#3b6700] mb-2">history</span>
                        <span class="text-[11px] font-bold text-[#2c2f30]">Mis negocios</span>
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private string _statusMessage = "Aún no hay suficientes eventos para mostrar una curva de ventas diaria.";
    private string _ordersTotal = "$0";
    private int _bookingsCount;
    private int _leadsCount;
    private string? _welcomeMessage;
    private string? _userLabel;
    private ComunaClick.Shared.Api.Partner.PartnerActivationStatus? _activation;
    private readonly List<ComunaClick.Shared.Api.Partner.PartnerDto> _businesses = new();
    private bool _isUpdatingVisibility;
    private bool _isSavingProfile;
    private Guid? _editingBusinessId;
    private readonly BusinessProfileEditor _profileEditor = new();
    private readonly List<BookingCard> _upcomingBookings =
    [
        new("calendar_today", "Corte de cabello", "Juan R.", "12:30", "Hoy"),
        new("self_improvement", "Yoga básico", "Camila P.", "15:00", "Hoy"),
        new("spa", "Masaje relajante", "Pablo M.", "18:10", "Hoy")
    ];

    private string PrimaryActionHref => _activation is null
        ? "/partner/quickstart"
        : _activation.IsVisible
            ? "/partner/catalog"
            : _activation.CanPublish
                ? "#publish"
                : "/register/business";

    private string PrimaryActionLabel => _activation?.IsVisible == true
        ? "Gestionar catálogo"
        : _activation?.CanPublish == true
            ? "Publicar negocio"
            : _activation?.PartnerType switch
        {
            "B" => "Crear primer servicio",
            "C" => "Registrar primer profesional",
            _ => "Crear primer producto"
        };

    private string PublicPreviewHref => AuthState.PartnerId is Guid partnerId && partnerId != Guid.Empty
        ? $"/buyer/detail/partner/{partnerId}"
        : "/categorias";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _welcomeMessage = GetQueryParameter(uri.Query, "welcome");
        _userLabel = AuthState.DisplayName
            ?? AuthState.Email
            ?? (AuthState.Tokens is not null ? JwtHelper.GetStringClaim(AuthState.Tokens.AccessToken, "name") : null)
            ?? (AuthState.Tokens is not null ? JwtHelper.GetStringClaim(AuthState.Tokens.AccessToken, "email") : null);

        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            _statusMessage = L.T("partner.status.noPartner");
            return;
        }

        try
        {
            var orders = await PartnerApi.GetPartnerOrdersAsync(partnerId.Value);
            var bookings = await PartnerApi.GetPartnerBookingsAsync(partnerId.Value);
            _activation = await PartnerApi.GetActivationStatusAsync(partnerId.Value);
            _businesses.Clear();

            var businesses = await PartnerApi.ListMyPartnersAsync();
            if (businesses is not null)
            {
                _businesses.AddRange(businesses);
                ResetBusinessProfileEditor();
            }

            _bookingsCount = bookings?.Count ?? 0;
            _ordersTotal = orders is null ? "$0" : $"${orders.Sum(x => x.TotalAmount):N0}";
            _leadsCount = 0;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver el dashboard de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = "Aún no hay datos suficientes para mostrar el dashboard.";
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo cargar el dashboard ({(int?)ex.StatusCode ?? 0}).";
        }
    }

    private async Task ToggleVisibilityAsync(bool isVisible)
    {
        var partnerId = AuthState.PartnerId;
        if (partnerId is null || partnerId == Guid.Empty)
        {
            return;
        }

        _isUpdatingVisibility = true;
        _statusMessage = isVisible ? "Publicando negocio..." : "Despublicando negocio...";

        try
        {
            var updated = await PartnerApi.UpdateVisibilityAsync(partnerId.Value, isVisible);
            _activation = updated?.Activation ?? _activation;

            if (updated is not null)
            {
                var index = _businesses.FindIndex(x => x.Id == updated.Id);
                if (index >= 0)
                {
                    _businesses[index] = updated;
                }
            }

            _statusMessage = isVisible
                ? "Tu negocio ya está publicado y visible para buyer."
                : "Tu negocio quedó en borrador y ya no es visible públicamente.";
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo actualizar la publicación ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _isUpdatingVisibility = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var trimmed = query.TrimStart('?');
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(pieces[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return pieces.Length > 1 ? Uri.UnescapeDataString(pieces[1]) : string.Empty;
        }

        return null;
    }

    private static bool HasExactLocation(ComunaClick.Shared.Api.Partner.PartnerDto business)
        => business.Latitude is not null && business.Longitude is not null;

    private void HandleBusinessSelectionChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var businessId))
        {
            _editingBusinessId = businessId;
            PopulateEditor(GetEditableBusiness());
        }
    }

    private void ResetBusinessProfileEditor()
    {
        var preferredId = AuthState.PartnerId;
        _editingBusinessId = preferredId.HasValue && preferredId.Value != Guid.Empty
            ? preferredId.Value
            : _businesses.FirstOrDefault()?.Id;

        PopulateEditor(GetEditableBusiness());
    }

    private ComunaClick.Shared.Api.Partner.PartnerDto? GetEditableBusiness()
    {
        if (_editingBusinessId.HasValue)
        {
            var selected = _businesses.FirstOrDefault(x => x.Id == _editingBusinessId.Value);
            if (selected is not null)
            {
                return selected;
            }
        }

        return _businesses.FirstOrDefault();
    }

    private void PopulateEditor(ComunaClick.Shared.Api.Partner.PartnerDto? business)
    {
        if (business is null)
        {
            _profileEditor.Name = string.Empty;
            _profileEditor.Address = string.Empty;
            _profileEditor.Phone = string.Empty;
            _profileEditor.Email = string.Empty;
            return;
        }

        _profileEditor.Name = business.Name ?? string.Empty;
        _profileEditor.Address = business.Address ?? string.Empty;
        _profileEditor.Phone = business.Phone ?? string.Empty;
        _profileEditor.Email = business.Email ?? string.Empty;
    }

    private async Task SaveBusinessProfileAsync()
    {
        var business = GetEditableBusiness();
        if (business is null)
        {
            _statusMessage = "No hay negocio seleccionado para actualizar.";
            return;
        }

        var normalizedName = (_profileEditor.Name ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalizedName))
        {
            _statusMessage = "El nombre del negocio es obligatorio.";
            return;
        }

        _isSavingProfile = true;
        _statusMessage = "Guardando datos del negocio...";
        try
        {
            var updated = await PartnerApi.UpdatePartnerAsync(business.Id, new ComunaClick.Shared.Api.Partner.PartnerUpdateRequest(
                business.Type,
                normalizedName,
                business.Rut,
                NormalizeOptional(_profileEditor.Address),
                NormalizeOptional(_profileEditor.Phone),
                NormalizeOptional(_profileEditor.Email),
                business.SubcategoryId,
                business.Latitude,
                business.Longitude,
                business.IsVisible));

            if (updated is not null)
            {
                var index = _businesses.FindIndex(x => x.Id == updated.Id);
                if (index >= 0)
                {
                    _businesses[index] = updated;
                }

                if (_activation is not null && AuthState.PartnerId == updated.Id)
                {
                    _activation = updated.Activation ?? _activation;
                }

                PopulateEditor(updated);
            }

            _statusMessage = "Datos de negocio actualizados correctamente.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            _statusMessage = "Ya existe otro negocio con ese nombre en tu tenant.";
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo actualizar el negocio ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private static string NormalizeOptional(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private sealed record BookingCard(string Icon, string Title, string Subtitle, string Time, string DayLabel);

    private sealed class BusinessProfileEditor
    {
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
