@page "/partner/messages"
@layout PartnerLayout
@inject LocaleService L
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>@L.T("inbox.pageTitle.partner")</PageTitle>

@if (!_ready)
{
    <BrandedLoading Title="@L.T("ui.loading")" Message="@L.T("inbox.loadingSession")" />
}
else if (!AuthState.IsAuthenticated)
{
    <section class="rounded-[2rem] bg-white p-8">
        <h1 class="text-2xl font-black text-[#2c2f30]">@L.T("inbox.loginRequired")</h1>
        <a href="@LoginHref" class="mt-4 inline-flex rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("nav.login")</a>
    </section>
}
else
{
    <div class="h-[calc(100vh-8rem)] min-h-[560px]">
        <Mailbox Mode="partner" />
    </div>
}

@code {
    private bool _ready;
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString(Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthState.InitializeAsync();
            _ready = true;
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
        }
    }
}
