@page "/partner/notifications"
@layout PartnerLayout
@using System.Net
@using System.Text.Json
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject ComunaClick.SharedUI.Services.Partner.PartnerNotificationsBadgeService NotificationsBadge
@implements IDisposable

<PageTitle>@L.T("partner.notifications.title")</PageTitle>

<div class="space-y-8">
    <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#7b8081] mb-3">Centro operativo</p>
            <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("partner.notifications.heading")</h1>
            <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.notifications.subtitle")</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @foreach (var filter in NotificationFilters)
            {
                <button type="button"
                        class="@GetFilterClass(filter.Key)"
                        @onclick="() => _selectedFilter = filter.Key">
                    @filter.Label
                </button>
            }
            <label class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-bold text-[#595c5d]">
                <input type="checkbox" checked="@_includeArchived" @onchange="OnIncludeArchivedChanged" />
                Ver archivadas
            </label>
            <button type="button" class="inline-flex items-center gap-2 bg-gradient-to-br from-[#3b6700] to-[#335900] text-[#d9ffad] px-6 py-3 rounded-2xl font-bold text-sm shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)]">
                <span class="material-symbols-outlined text-[20px]">notifications_active</span>
                @L.T("partner.notifications.primaryAction")
            </button>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">BANDEJA</p>
            <h2 class="text-4xl font-black tracking-[-0.05em] text-[#2c2f30]">@FilteredNotifications.Count</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Alertas visibles en la vista actual.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">ACCIONABLES</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@ActionableCountLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">Pedidos, reservas o leads que probablemente requieren reacción.</p>
        </article>
        <article class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081] mb-4">ÚLTIMO TIPO</p>
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@LastTypeLabel</h2>
            <p class="mt-2 text-xs text-[#595c5d]">@_statusMessage</p>
        </article>
    </div>

    <section class="bg-[#eff1f2] rounded-[2rem] p-6 md:p-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081] mb-2">Bandeja</p>
                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Notificaciones recientes</h2>
            </div>
            <span class="inline-flex items-center rounded-full bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#595c5d]">@StatusLabel</span>
        </div>

        <div class="space-y-4">
            @if (_isLoading)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando tu bandeja operativa." Compact="true" />
                </div>
            }
            else if (FilteredNotifications.Count == 0)
            {
                <div class="bg-white rounded-3xl p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-[#eff1f2] text-[#325800] flex items-center justify-center mx-auto">
                        <span class="material-symbols-outlined text-3xl">notifications_off</span>
                    </div>
                    <p class="text-lg font-bold text-[#2c2f30]">No hay notificaciones en esta vista</p>
                    <p class="text-sm text-[#595c5d]">@EmptyStateMessage</p>
                </div>
            }
            else
            {
                @foreach (var note in FilteredNotifications)
                {
                    <article class="bg-white rounded-3xl p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <div class="flex items-start gap-4">
                            <div class="@GetIconContainerClass(note)">
                                <span class="material-symbols-outlined">@GetIconName(note)</span>
                            </div>
                            <div class="space-y-3 flex-1">
                                <div class="flex flex-wrap items-center gap-3">
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@FormatType(note.Type)</p>
                                    <span class="@GetTypeBadgeClass(note)">@GetTypeBadgeLabel(note)</span>
                                    <span class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@FormatRelative(note.CreatedAt)</span>
                                </div>
                                <p class="text-sm text-[#595c5d]">@FormatPayload(note.Payload)</p>
                                <div class="rounded-2xl bg-[#f5f6f7] px-4 py-3">
                                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">Acción sugerida</p>
                                    <p class="mt-2 text-sm text-[#2c2f30]">@GetActionHint(note)</p>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    @if (!note.ReadAt.HasValue)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]"
                                                @onclick='() => MarkReadAsync(note.Id)'
                                                disabled="@(_updatingNotificationId == note.Id)">
                                            Marcar leída
                                        </button>
                                    }
                                    @if (!note.ArchivedAt.HasValue)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]"
                                                @onclick='() => ArchiveAsync(note.Id)'
                                                disabled="@(_updatingNotificationId == note.Id)">
                                            Archivar
                                        </button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(GetResourceHref(note)))
                                    {
                                        <a class="inline-flex items-center rounded-xl border border-[#dadddf] px-3 py-2 text-xs font-bold text-[#2c2f30]"
                                           href="@GetResourceHref(note)">
                                            Ir al recurso
                                        </a>
                                    }
                                    @if (_updatingNotificationId == note.Id)
                                    {
                                        <span class="text-xs font-bold text-[#7b8081]">Actualizando...</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

@code {
    private readonly List<ComunaClick.Shared.Api.Partner.Notification> _items = new();
    private string _statusMessage = "Sin notificaciones.";
    private bool _isLoading;
    private string _selectedFilter = "all";
    private bool _includeArchived;
    private Guid? _updatingNotificationId;

    private IReadOnlyList<FilterOption> NotificationFilters { get; } =
    [
        new("all", "Todo"),
        new("actionable", "Acción"),
        new("finance", "Finanzas"),
        new("system", "Sistema")
    ];

    private List<ComunaClick.Shared.Api.Partner.Notification> FilteredNotifications => _items
        .Where(MatchesFilter)
        .OrderByDescending(x => x.CreatedAt)
        .ToList();

    private int ActionableCount => _items.Count(IsActionable);
    private string ActionableCountLabel => ActionableCount == 0 ? "Sin foco" : $"{ActionableCount} activas";
    private string LastTypeLabel => _items.Count == 0 ? "Sin actividad" : FormatType(_items.OrderByDescending(x => x.CreatedAt).First().Type);
    private string StatusLabel => _items.Count == 0 ? "Vacío" : "Con señales";

    private string EmptyStateMessage => _selectedFilter switch
    {
        "actionable" => "No se detectan alertas de operación inmediata.",
        "finance" => "No hay eventos financieros recientes en la bandeja.",
        "system" => "No aparecen avisos de sistema o recordatorios generales.",
        _ => _statusMessage
    };

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        if (!AuthState.IsAuthenticated || AuthState.PartnerId is null)
        {
            _statusMessage = L.T("partner.status.loginRequired");
            _isLoading = false;
            return;
        }

        try
        {
            var notes = await PartnerApi.GetPartnerNotificationsAsync(AuthState.PartnerId.Value, _includeArchived);
            if (notes is not null)
            {
                _items.AddRange(notes);
            }

            _statusMessage = _items.Count == 0
                ? "Todavía no hay alertas o hitos operativos en esta bandeja."
                : "La bandeja quedó agrupada para separar acción inmediata, finanzas y sistema.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _statusMessage = "No tienes permisos para ver las notificaciones de este partner.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _statusMessage = L.T("partner.status.noNotifications");
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudieron cargar las notificaciones ({(int?)ex.StatusCode ?? 0}).";
        }

        _isLoading = false;
    }

    private async Task OnIncludeArchivedChanged(ChangeEventArgs args)
    {
        _includeArchived = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await ReloadNotificationsAsync();
    }

    private async Task ReloadNotificationsAsync()
    {
        if (!AuthState.IsAuthenticated || AuthState.PartnerId is null)
        {
            return;
        }

        _isLoading = true;
        _items.Clear();
        try
        {
            var notes = await PartnerApi.GetPartnerNotificationsAsync(AuthState.PartnerId.Value, _includeArchived);
            if (notes is not null)
            {
                _items.AddRange(notes);
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudieron recargar notificaciones ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task MarkReadAsync(Guid id)
    {
        _updatingNotificationId = id;
        try
        {
            var updated = await PartnerApi.MarkNotificationReadAsync(id);
            if (updated is null)
            {
                return;
            }

            ReplaceNotification(updated);
            await RefreshBadgeAsync();
        }
        finally
        {
            _updatingNotificationId = null;
        }
    }

    private async Task ArchiveAsync(Guid id)
    {
        _updatingNotificationId = id;
        try
        {
            var updated = await PartnerApi.ArchiveNotificationAsync(id);
            if (updated is null)
            {
                return;
            }

            ReplaceNotification(updated);
            if (!_includeArchived)
            {
                _items.RemoveAll(x => x.Id == id);
            }

            await RefreshBadgeAsync();
        }
        finally
        {
            _updatingNotificationId = null;
        }
    }

    private async Task RefreshBadgeAsync()
    {
        if (AuthState.PartnerId is { } partnerId && partnerId != Guid.Empty)
        {
            await NotificationsBadge.RefreshAsync(partnerId, force: true);
        }
    }

    private void ReplaceNotification(ComunaClick.Shared.Api.Partner.Notification updated)
    {
        var index = _items.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            _items[index] = updated;
            return;
        }

        _items.Add(updated);
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool MatchesFilter(ComunaClick.Shared.Api.Partner.Notification note) => _selectedFilter switch
    {
        "actionable" => IsActionable(note),
        "finance" => IsFinance(note),
        "system" => !IsActionable(note) && !IsFinance(note),
        _ => true
    };

    private string GetFilterClass(string key)
        => key == _selectedFilter
            ? "inline-flex items-center rounded-full bg-[#2c2f30] text-white px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]"
            : "inline-flex items-center rounded-full bg-white text-[#595c5d] px-4 py-2 text-xs font-bold uppercase tracking-[0.12em]";

    private static bool IsActionable(ComunaClick.Shared.Api.Partner.Notification note)
    {
        var type = note.Type?.Trim().ToLowerInvariant() ?? string.Empty;
        return type.Contains("order", StringComparison.Ordinal)
            || type.Contains("booking", StringComparison.Ordinal)
            || type.Contains("lead", StringComparison.Ordinal)
            || type.Contains("stock", StringComparison.Ordinal);
    }

    private static bool IsFinance(ComunaClick.Shared.Api.Partner.Notification note)
    {
        var type = note.Type?.Trim().ToLowerInvariant() ?? string.Empty;
        return type.Contains("payment", StringComparison.Ordinal)
            || type.Contains("payout", StringComparison.Ordinal)
            || type.Contains("refund", StringComparison.Ordinal);
    }

    private string FormatType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Notificación";
        }

        return type.Trim().ToLowerInvariant() switch
        {
            "stock_out" => L.T("partner.notifications.stockOut"),
            "stock_low" => L.T("partner.notifications.stockLow"),
            "order_notification" => L.T("partner.notifications.orderNew"),
            _ => type.Replace("_", " ", StringComparison.Ordinal).Trim()
        };
    }

    private static string FormatPayload(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return "Sin detalle adicional.";
        }

        try
        {
            using var document = JsonDocument.Parse(payload);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return payload;
            }

            var root = document.RootElement;
            if (root.TryGetProperty("message", out var messageElement))
            {
                return messageElement.GetString() ?? payload;
            }

            if (root.TryGetProperty("TotalAmount", out var amountElement))
            {
                var amount = amountElement.GetDouble();
                var currency = root.TryGetProperty("Currency", out var currencyElement)
                    ? currencyElement.GetString() ?? "CLP"
                    : "CLP";
                var detail = root.TryGetProperty("detail", out var detailElement)
                    ? detailElement.GetString()
                    : null;
                var formatted = amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-CL"));
                if (string.Equals(detail, "notifications_disabled", StringComparison.OrdinalIgnoreCase))
                {
                    return $"Nuevo pedido por {currency} {formatted}. Las alertas por correo/WhatsApp están desactivadas; gestiona el pedido aquí.";
                }

                return $"Nuevo pedido por {currency} {formatted}.";
            }
        }
        catch (JsonException)
        {
            return payload;
        }

        return payload;
    }

    private static string GetIconName(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (IsFinance(note))
        {
            return "payments";
        }

        if (IsActionable(note))
        {
            var type = note.Type?.Trim().ToLowerInvariant() ?? string.Empty;
            return type.Contains("stock", StringComparison.Ordinal) ? "inventory_2" : "bolt";
        }

        return "notifications";
    }

    private static string GetIconContainerClass(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (IsFinance(note))
        {
            return "w-12 h-12 rounded-2xl bg-[#d8f0ff] text-[#0f5c8a] flex items-center justify-center flex-shrink-0";
        }

        if (IsActionable(note))
        {
            return "w-12 h-12 rounded-2xl bg-[#a7f255]/20 text-[#325800] flex items-center justify-center flex-shrink-0";
        }

        return "w-12 h-12 rounded-2xl bg-[#eff1f2] text-[#595c5d] flex items-center justify-center flex-shrink-0";
    }

    private static string GetTypeBadgeLabel(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (DateTimeOffset.Now - note.CreatedAt < TimeSpan.FromHours(24))
        {
            return "Reciente";
        }

        if (IsFinance(note))
        {
            return "Finanzas";
        }

        if (IsActionable(note))
        {
            return "Operación";
        }

        return "Sistema";
    }

    private static string GetTypeBadgeClass(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (DateTimeOffset.Now - note.CreatedAt < TimeSpan.FromHours(24))
        {
            return "inline-flex rounded-full bg-[#fff2d1] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#946200]";
        }

        if (IsFinance(note))
        {
            return "inline-flex rounded-full bg-[#d8f0ff] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#0f5c8a]";
        }

        if (IsActionable(note))
        {
            return "inline-flex rounded-full bg-[#a7f255]/25 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#325800]";
        }

        return "inline-flex rounded-full bg-[#eff1f2] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#595c5d]";
    }

    private static string GetActionHint(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (IsFinance(note))
        {
            return "Contrasta este evento con payouts, cobros o conciliación antes de cerrar la revisión financiera.";
        }

        if (IsActionable(note))
        {
            var type = note.Type?.Trim().ToLowerInvariant() ?? string.Empty;
            if (type.Contains("stock", StringComparison.Ordinal))
            {
                return "Actualiza el stock del producto en Catálogo para volver a venderlo.";
            }

            if (type.Contains("order", StringComparison.Ordinal))
            {
                return "Confirmá el pago si ya recibiste el dinero, o cancelá el pedido si no se concretará.";
            }

            return "Prioriza esta alerta en la operación diaria: puede impactar atención al cliente o cumplimiento.";
        }

        return "Úsala como referencia de contexto. No parece requerir acción inmediata.";
    }

    private string GetResourceHref(ComunaClick.Shared.Api.Partner.Notification note)
    {
        if (!note.ReferenceId.HasValue)
        {
            return string.Empty;
        }

        var type = note.Type?.Trim().ToLowerInvariant() ?? string.Empty;
        if (type.Contains("booking", StringComparison.Ordinal))
        {
            return "/partner/agenda";
        }

        if (type.Contains("lead", StringComparison.Ordinal))
        {
            return "/partner/leads";
        }

        if (type.Contains("stock", StringComparison.Ordinal))
        {
            return "/partner/catalog";
        }

        if (type.Contains("order", StringComparison.Ordinal))
        {
            return $"/partner/orders?orderId={note.ReferenceId.Value}";
        }

        if (type.Contains("payout", StringComparison.Ordinal) || type.Contains("payment", StringComparison.Ordinal))
        {
            return "/partner/payouts";
        }

        return "/partner/notifications";
    }

    private static string FormatRelative(DateTimeOffset date)
    {
        var elapsed = DateTimeOffset.Now - date;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "Hace instantes";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalMinutes)} min";
        }

        if (elapsed < TimeSpan.FromDays(1))
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalHours)} h";
        }

        return $"Hace {Math.Max(1, (int)elapsed.TotalDays)} d";
    }

    private sealed record FilterOption(string Key, string Label);

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
