@page "/partner/mercadopago"
@layout PartnerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Mercado Pago - ComunaClic</PageTitle>

<div class="space-y-6">

    <!-- Header -->
    <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#fff159] flex items-center justify-center shadow-[0_8px_20px_-8px_rgba(0,0,0,0.15)]">
                <span class="material-symbols-outlined text-[#2c2f30] text-[22px]">point_of_sale</span>
            </div>
            <div>
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">Marketplace</p>
                <h1 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Mercado Pago</h1>
            </div>
        </div>
        <div class="flex flex-wrap gap-3">
            <button class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad] shadow-[0_8px_20px_-8px_rgba(59,103,0,0.5)] hover:bg-[#335900] transition-colors disabled:opacity-50"
                    @onclick="ConnectAsync" disabled="@_busy">
                <span class="material-symbols-outlined text-[17px]">link</span>
                Conectar cuenta
            </button>
            <button class="inline-flex items-center gap-2 rounded-2xl border border-[#e3e6e8] bg-white px-5 py-2.5 text-sm font-bold text-[#595c5d] hover:bg-[#f5f6f7] transition-colors disabled:opacity-50"
                    @onclick="DisconnectAsync"
                    disabled="@(_busy || _status is null || _status.ConnectionStatus != "connected")">
                <span class="material-symbols-outlined text-[17px]">link_off</span>
                Desconectar
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <StatusBanner Message="@_message" Level="@_messageLevel" />
    }

    @if (_loading)
    {
        <BrandedLoading Title="Mercado Pago" Message="Consultando configuración del marketplace…" />
    }
    else if (_status is not null)
    {
        <!-- Estado de conexión -->
        <div class="grid grid-cols-1 gap-5">

            <!-- Tarjeta estado de conexión -->
            <section class="rounded-3xl border border-[#e3e6e8] bg-white shadow-[0_8px_24px_-12px_rgba(0,0,0,0.06)] overflow-hidden">
                <!-- Banner estado -->
                <div class="@(IsConnected ? "bg-gradient-to-r from-[#e8f5d0] to-[#f0fae3]" : "bg-[#fef3f2]") px-8 py-5 flex items-center justify-between gap-4 border-b border-[#e3e6e8]">
                    <div class="flex items-center gap-3">
                        <span class="flex h-3 w-3 relative">
                            @if (IsConnected)
                            {
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3b6700] opacity-40"></span>
                                <span class="relative inline-flex rounded-full h-3 w-3 bg-[#3b6700]"></span>
                            }
                            else
                            {
                                <span class="relative inline-flex rounded-full h-3 w-3 bg-[#e53935]"></span>
                            }
                        </span>
                        <span class="text-sm font-bold @(IsConnected ? "text-[#3b6700]" : "text-[#c62828]")">
                            @(IsConnected ? "Cuenta conectada" : "Sin conexión")
                        </span>
                    </div>
                    <span class="text-xs text-[#7b8081]">@_status.SellerName</span>
                </div>

                <!-- Info grid -->
                <div class="p-8 grid grid-cols-2 md:grid-cols-4 gap-6">
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">MP User ID</p>
                        <p class="mt-1.5 text-base font-black text-[#2c2f30]">@(_status.MpUserId ?? "—")</p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">Conectado</p>
                        <p class="mt-1.5 text-sm font-semibold text-[#2c2f30]">@FormatDateShort(_status.ConnectedAt)</p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">Token expira</p>
                        <p class="mt-1.5 text-sm font-semibold @(IsTokenNearExpiry ? "text-[#e65100]" : "text-[#2c2f30]")">
                            @FormatDateShort(_status.TokenExpiresAt)
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.15em] font-bold text-[#7b8081]">Seller ID</p>
                        <p class="mt-1.5 text-xs font-mono text-[#595c5d] truncate" title="@_status.SellerId">
                            @ShortId(_status.SellerId)…
                        </p>
                    </div>
                </div>

                <!-- Permisos colapsables -->
                @if (!string.IsNullOrWhiteSpace(_status.Scope))
                {
                    <div class="px-8 pb-6">
                        <button class="text-xs font-bold text-[#7b8081] flex items-center gap-1 hover:text-[#3b6700] transition-colors"
                                @onclick="() => _scopeExpanded = !_scopeExpanded">
                            <span class="material-symbols-outlined text-[15px]">@(_scopeExpanded ? "expand_less" : "expand_more")</span>
                            @(_scopeExpanded ? "Ocultar permisos" : "Ver permisos OAuth")
                        </button>
                        @if (_scopeExpanded)
                        {
                            <div class="mt-3 flex flex-wrap gap-1.5">
                                @foreach (var scope in _status.Scope.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="inline-flex items-center rounded-lg bg-[#f0f2f3] px-2.5 py-1 text-[10px] font-mono text-[#595c5d]">@scope</span>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

        </div>

        <!-- Tabla de pagos -->
        <section class="rounded-3xl border border-[#e3e6e8] bg-white shadow-[0_8px_24px_-12px_rgba(0,0,0,0.06)]">
            <div class="flex items-center justify-between gap-4 px-8 py-5 border-b border-[#e3e6e8]">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">Historial</p>
                    <h2 class="mt-0.5 text-lg font-black tracking-[-0.02em] text-[#2c2f30]">Últimos pagos</h2>
                </div>
                <button class="inline-flex items-center gap-2 rounded-2xl border border-[#e3e6e8] bg-white px-4 py-2 text-xs font-bold text-[#595c5d] hover:bg-[#f5f6f7] transition-colors"
                        @onclick="LoadAsync" disabled="@_busy">
                    <span class="material-symbols-outlined text-[16px] @(_busy ? "animate-spin" : "")">refresh</span>
                    Actualizar
                </button>
            </div>

            @if (_payments.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-16 text-center px-8">
                    <div class="w-14 h-14 rounded-2xl bg-[#f5f6f7] flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-[28px] text-[#b0b5b7]">receipt_long</span>
                    </div>
                    <p class="text-sm font-bold text-[#2c2f30]">Sin pagos registrados</p>
                    <p class="mt-1 text-xs text-[#7b8081]">Los cobros aparecerán aquí una vez que se realice la primera venta.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="text-left text-[#7b8081] text-[11px] uppercase tracking-[0.1em]">
                                <th class="px-8 py-3 font-bold">Fecha</th>
                                <th class="px-4 py-3 font-bold">Orden</th>
                                <th class="px-4 py-3 font-bold text-right">
                                    <span class="inline-flex items-center gap-1 cursor-help" title="@L.T("partner.mp.col.gross.tooltip")">Bruto<span class="material-symbols-outlined text-[13px] normal-case">info</span></span>
                                </th>
                                <th class="px-4 py-3 font-bold text-right">
                                    <span class="inline-flex items-center gap-1 cursor-help" title="@L.T("partner.mp.col.mpFee.tooltip")">Comisión MP<span class="material-symbols-outlined text-[13px] normal-case">info</span></span>
                                </th>
                                <th class="px-4 py-3 font-bold text-right">
                                    <span class="inline-flex items-center gap-1 cursor-help" title="@L.T("partner.mp.col.platformFee.tooltip")">Comisión ComunaClic<span class="material-symbols-outlined text-[13px] normal-case">info</span></span>
                                </th>
                                <th class="px-4 py-3 font-bold text-right">
                                    <span class="inline-flex items-center gap-1 cursor-help" title="@L.T("partner.mp.col.net.tooltip")">Neto<span class="material-symbols-outlined text-[13px] normal-case">info</span></span>
                                </th>
                                <th class="px-4 py-3 font-bold">Estado</th>
                                <th class="px-4 py-3 font-bold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#f0f2f3]">
                            @foreach (var payment in _payments)
                            {
                                <tr class="hover:bg-[#fafbfb] transition-colors">
                                    <td class="px-8 py-4 text-[#595c5d] text-xs">@payment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="px-4 py-4 font-mono text-xs text-[#7b8081]">@ShortId(payment.OrderId)</td>
                                    <td class="px-4 py-4 text-right font-semibold text-[#2c2f30]">@FormatMoney(payment.GrossAmount)</td>
                                    <td class="px-4 py-4 text-right text-[#595c5d] font-semibold">
                                        @(payment.MercadoPagoFeeAmount.HasValue ? $"-{FormatMoney(payment.MercadoPagoFeeAmount.Value)}" : "—")
                                    </td>
                                    <td class="px-4 py-4 text-right text-[#e65100] font-semibold">-@FormatMoney(payment.PlatformFeeAmount)</td>
                                    <td class="px-4 py-4 text-right font-black text-[#3b6700]">@FormatMoney(payment.NetAmount)</td>
                                    <td class="px-4 py-4">
                                        <span class="@StatusBadgeClass(payment.Status) inline-flex items-center rounded-xl px-2.5 py-1 text-[11px] font-bold">
                                            @payment.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-4">
                                        <div class="flex gap-2">
                                            <a class="inline-flex items-center gap-1 rounded-xl border border-[#e3e6e8] px-3 py-1.5 text-xs font-bold text-[#2c2f30] hover:bg-[#f5f6f7] transition-colors"
                                               href="@($"/partner/mercadopago/payments/{payment.PaymentId}")">
                                                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                                Ver
                                            </a>
                                            <button class="inline-flex items-center gap-1 rounded-xl border border-[#e3e6e8] px-3 py-1.5 text-xs font-bold text-[#2c2f30] hover:bg-[#f5f6f7] transition-colors"
                                                    @onclick="() => RetrySyncAsync(payment.PaymentId)">
                                                <span class="material-symbols-outlined text-[14px]">sync</span>
                                                Sync
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="px-8 pb-4 pt-3 text-xs text-[#7b8081]">
                    <span class="material-symbols-outlined align-middle text-[14px]">info</span>
                    @L.T("partner.mp.table.legend")
                </p>
            }
        </section>
    }
</div>

@code {
    private SellerMercadoPagoStatus? _status;
    private readonly List<MarketplacePaymentDetail> _payments = new();
    private bool _loading = true;
    private bool _busy;
    private bool _scopeExpanded;
    private string? _message;
    private string _messageLevel = "info";

    private bool IsConnected => _status?.ConnectionStatus == "connected";
    private bool IsTokenNearExpiry => _status?.TokenExpiresAt.HasValue == true
        && _status.TokenExpiresAt!.Value < DateTimeOffset.UtcNow.AddDays(14);

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private void HandleAuthChange()
    {
        if (CurrentSellerId != Guid.Empty && _status is null && !_loading)
        {
            InvokeAsync(LoadAsync);
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
    }

    private Guid CurrentSellerId => AuthState.PartnerId ?? Guid.Empty;

    private async Task LoadAsync()
    {
        if (CurrentSellerId == Guid.Empty)
        {
            _loading = false;
            StateHasChanged();
            return;
        }

        _loading = true;
        _status = await PartnerApi.GetMercadoPagoStatusAsync(CurrentSellerId);
        _payments.Clear();
        var payments = await PartnerApi.GetMarketplacePaymentsAsync(CurrentSellerId);
        if (payments is not null) _payments.AddRange(payments);

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConnectAsync()
    {
        _busy = true;
        try
        {
            var start = await PartnerApi.StartMercadoPagoOAuthAsync(CurrentSellerId);
            if (!string.IsNullOrWhiteSpace(start?.AuthorizationUrl))
                Navigation.NavigateTo(start.AuthorizationUrl, true);
        }
        finally { _busy = false; }
    }

    private async Task DisconnectAsync()
    {
        _busy = true;
        try
        {
            await PartnerApi.DisconnectMercadoPagoAsync(CurrentSellerId);
            _message = "Cuenta Mercado Pago desconectada.";
            _messageLevel = "success";
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RetrySyncAsync(Guid paymentId)
    {
        _busy = true;
        try
        {
            await PartnerApi.RetryMarketplacePaymentSyncAsync(paymentId);
            _message = "Sincronización enviada.";
            _messageLevel = "success";
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private static string StatusBadgeClass(string? status) => status switch
    {
        "approved" => "bg-[#e8f5d0] text-[#3b6700]",
        "pending"  => "bg-[#fff8e1] text-[#e65100]",
        "rejected" => "bg-[#fef3f2] text-[#c62828]",
        _          => "bg-[#f0f2f3] text-[#595c5d]"
    };

    private static string FormatMoney(double amount) => $"$ {amount:N0}";
    private static string ShortId(Guid id) => id == Guid.Empty ? "—" : id.ToString("N")[..8];
    private static string FormatDateShort(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToLocalTime().ToString("dd MMM yyyy") : "—";
}
