    private static string GetActionHint(ComunaClick.Shared.Api.Partner.Lead lead)
        => NormalizeStatus(lead.Status) switch
        {
            "new" => "Responder el primer contacto y confirmar necesidad, horario o presupuesto.",
            "pending" => "Retomar conversación y moverlo a seguimiento con siguiente fecha clara.",
            "contacted" or "in_follow_up" or "follow_up" => "Mantener cadencia comercial hasta cerrar o descartar.",
            "won" or "closed" => "Lead ganado. Úsalo como referencia de oferta/comunicación efectiva.",
            "lost" => "Lead perdido. Revisa el motivo para ajustar precio, timing o propuesta.",
            _ => "Revisar el origen del lead y definir próximo paso manual."
        };

    private static string GetHealthHint(ComunaClick.Shared.Api.Partner.Lead lead)
    {
        var age = DateTimeOffset.Now - lead.UpdatedAt;
        if (IsClosedLead(lead))
        {
            return "Sin riesgo inmediato: ya no requiere atención operativa.";
        }

        if (age > TimeSpan.FromHours(48))
        {
            return "Lleva más de 48 horas sin movimiento. Riesgo alto de enfriamiento.";
        }

        if (age > TimeSpan.FromHours(24))
        {
            return "Conviene reactivar este lead durante el día para no perder conversión.";
        }

        return "Movimiento reciente. Mantén el seguimiento hasta definir resultado.";
    }

    private static string? NormalizeStatus(string? status)
    {
        var normalized = status?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "follow_up" => "in_follow_up",
            "closed" => "won",
            _ => normalized
        };
    }

    private static string FormatRelative(DateTimeOffset date)
    {
        var elapsed = DateTimeOffset.Now - date;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "Hace instantes";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalMinutes)} min";
        }

        if (elapsed < TimeSpan.FromDays(1))
        {
            return $"Hace {Math.Max(1, (int)elapsed.TotalHours)} h";
        }

        return $"Hace {Math.Max(1, (int)elapsed.TotalDays)} d";
    }

