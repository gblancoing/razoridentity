@page "/my-businesses"
@using System.ComponentModel.DataAnnotations
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.SharedUI.Services.ApiSessionService ApiSession
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject ComunaClick.Shared.Auth.Interfaces.IAuthClient AuthClient
@using System.Net
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<MyBusinesses> Logger
@implements IDisposable

<PageTitle>@L.T("myBusinesses.title") - ComunaClic</PageTitle>

<div class="min-h-screen bg-background-light dark:bg-background-dark text-[#111816] dark:text-white">
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col gap-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold">@L.T("myBusinesses.title")</h1>
                <p class="text-sm text-[#61897c]">@L.T("myBusinesses.subtitle")</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a href="/" class="border border-[#3b6700] text-[#3b6700] px-4 py-2 rounded-lg font-semibold text-sm">@L.T("myBusinesses.backHome")</a>
                <button type="button"
                        class="border border-[#dadddf] text-[#2c2f30] px-4 py-2 rounded-lg font-semibold text-sm"
                        @onclick="HandleLogoutAsync">
                    @L.T("myBusinesses.logout")
                </button>
                <a href="/register/business" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm">@L.T("myBusinesses.create")</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
        }

        @if (_isLoading)
        {
            <BrandedLoading Title="@L.T("myBusinesses.loading.title")" Message="@L.T("myBusinesses.loading.message")" />
        }
        else if (_items.Count == 0)
        {
            <div class="bg-white dark:bg-[#1a2e28] rounded-xl border border-gray-200 dark:border-gray-800 p-8 space-y-4">
                <h2 class="text-xl font-bold">@L.T("myBusinesses.empty.title")</h2>
                <p class="text-sm text-[#61897c]">@L.T("myBusinesses.empty.desc")</p>
                <div>
                    <a href="/register/business" class="inline-flex bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm">@L.T("myBusinesses.empty.cta")</a>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                @foreach (var item in _items)
                {
                    <div class="bg-white dark:bg-[#1a2e28] rounded-xl border border-gray-200 dark:border-gray-800 p-6 space-y-4 @PartnerCardBorderClass(item)">
                        <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0 flex-1 space-y-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="@PartnerTypeBadgeClass(item)">
                                        <span class="material-symbols-outlined text-[18px]">@PartnerTypeIcon(item)</span>
                                        @PartnerTypeLabel(item)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(PartnerCategoryLine(item)))
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-[#f5f6f7] px-3 py-1 text-[11px] font-semibold text-[#2c2f30] ring-1 ring-[#e8e5dc]">
                                            <span class="material-symbols-outlined text-[16px] text-[#61897c]">category</span>
                                            @PartnerCategoryLine(item)
                                        </span>
                                    }
                                    <span class="@VisibilityBadgeClass(item)">@VisibilityLabel(item)</span>
                                </div>
                                <h2 class="text-xl font-bold text-[#2c2f30] dark:text-white">@item.Name</h2>
                            </div>
                            <div class="flex shrink-0 flex-col items-end gap-2">
                                <span class="@ActivationBadgeClass(item)">@(item.Activation?.StatusLabel ?? "Sin estado")</span>
                                <span class="@LocationBadgeClass(item)">@LocationLabel(item)</span>
                            </div>
                        </div>

                        <div class="text-sm text-[#61897c] space-y-1">
                            <div>@(item.Address ?? L.T("myBusinesses.noAddress"))</div>
                            <div>@(item.Email ?? item.Phone ?? L.T("myBusinesses.noContact"))</div>
                            @if (item.Latitude is not null && item.Longitude is not null)
                            {
                                <div>Coordenadas: @item.Latitude.Value.ToString("N6"), @item.Longitude.Value.ToString("N6")</div>
                            }
                            @if (item.Activation is not null)
                            {
                                <div>@L.T("myBusinesses.completeness"): @item.Activation.CompletionPercent%</div>
                                <div>@item.Activation.NextStep</div>
                            }
                        </div>

                        <div class="flex flex-wrap gap-3">
                            <button class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm" @onclick="() => EnterPartnerAsync(item)" disabled="@_isSwitching">@L.T("myBusinesses.enter")</button>
                            <button class="border border-[#3b6700] text-[#3b6700] px-4 py-2 rounded-lg font-semibold text-sm"
                                    @onclick="() => BeginEditPartner(item)"
                                    disabled="@(_isSwitching || _isSavingPartner)">
                                @L.T("myBusinesses.edit")
                            </button>
                            <a href="@PublicPreviewHref(item)" class="border border-[#3b6700] text-[#3b6700] px-4 py-2 rounded-lg font-semibold text-sm">@L.T("myBusinesses.viewPublic")</a>
                            @if (item.IsVisible)
                            {
                                <button class="border border-red-200 text-red-700 px-4 py-2 rounded-lg font-semibold text-sm"
                                        @onclick="() => ToggleVisibilityAsync(item, false)"
                                        disabled="@_isTogglingVisibility">
                                    @L.T("myBusinesses.unpublish")
                                </button>
                            }
                            else if (item.Activation?.CanPublish == true)
                            {
                                <button class="border border-[#3b6700] text-[#3b6700] px-4 py-2 rounded-lg font-semibold text-sm"
                                        @onclick="() => ToggleVisibilityAsync(item, true)"
                                        disabled="@_isTogglingVisibility">
                                    @L.T("myBusinesses.publish")
                                </button>
                            }
                            else
                            {
                                <a href="/register/business" class="border border-gray-300 dark:border-gray-700 px-4 py-2 rounded-lg font-semibold text-sm">@L.T("myBusinesses.complete")</a>
                            }
                            <button class="border border-[#dadddf] text-[#2c2f30] px-4 py-2 rounded-lg font-semibold text-sm"
                                    @onclick="() => UpdateLocationAsync(item)"
                                    disabled="@(_isUpdatingLocation || _isSwitching)">
                                @L.T("myBusinesses.updateLocation")
                            </button>
                            <a href="/register/business" class="border border-gray-300 dark:border-gray-700 px-4 py-2 rounded-lg font-semibold text-sm">@L.T("myBusinesses.create")</a>
                        </div>

                        @if (_editingPartnerId == item.Id)
                        {
                            <EditForm Model="_partnerEditor" OnValidSubmit="SavePartnerAsync">
                                <DataAnnotationsValidator />
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 rounded-xl bg-[#f6faf8] border border-[#dfeee6] p-5">
                                    <div>
                                        <label class="text-sm font-semibold text-[#2c2f30]">Nombre del negocio</label>
                                        <input class="@InputClass" @bind="_partnerEditor.Name" />
                                        <ValidationMessage For="@(() => _partnerEditor.Name)" class="text-xs text-red-500" />
                                    </div>
                                    <div>
                                        <label class="text-sm font-semibold text-[#2c2f30]">Teléfono</label>
                                        <input class="@InputClass" @bind="_partnerEditor.Phone" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-semibold text-[#2c2f30]">Dirección</label>
                                        <input class="@InputClass" @bind="_partnerEditor.Address" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="text-sm font-semibold text-[#2c2f30]">Email público</label>
                                        <input class="@InputClass" @bind="_partnerEditor.Email" />
                                    </div>
                                    <div class="md:col-span-2 flex flex-wrap gap-3">
                                        <button type="submit"
                                                class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-sm"
                                                disabled="@_isSavingPartner">
                                            Guardar cambios
                                        </button>
                                        <button type="button"
                                                class="border border-[#dadddf] text-[#2c2f30] px-4 py-2 rounded-lg font-semibold text-sm"
                                                @onclick="CancelEditPartner">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            </EditForm>
                        }
                    </div>
                }
            </div>
        }
    </main>
</div>

@code {
    private readonly List<ComunaClick.Shared.Api.Partner.PartnerDto> _items = new();
    private bool _isLoading = true;
    private bool _isSwitching;
    private bool _isTogglingVisibility;
    private bool _isUpdatingLocation;
    private bool _isSavingPartner;
    private string? _statusMessage;
    private string _statusLevel = "info";
    private bool _checkedAuth;
    private Guid? _editingPartnerId;
    private readonly PartnerEditor _partnerEditor = new();
    private string InputClass => "mt-1 w-full rounded-xl border border-[#dadddf] bg-white px-4 h-11 text-sm text-[#2c2f30]";

    protected override Task OnInitializedAsync()
    {
        L.OnChange += HandleLocaleChange;
        return Task.CompletedTask;
    }

    private void HandleLocaleChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.OnChange -= HandleLocaleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;
        try
        {
            if (!await ApiSession.EnsureReadyAsync())
            {
                Logger.LogInformation("No authenticated session found on /my-businesses. Redirecting to /login");
                Navigation.NavigateTo("/login", true);
                return;
            }

            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // JS interop is not available during prerender; retry once the browser is ready.
            _checkedAuth = false;
        }
    }

    private async Task LoadAsync(bool isRetry = false)
    {
        _isLoading = true;
        _items.Clear();
        try
        {
            if (await TryEnterSessionPartnerAsync())
            {
                return;
            }

            var partners = await PartnerApi.ListMyPartnersAsync();
            if (partners is not null)
            {
                _items.AddRange(partners);
            }

            if (_items.Count == 1)
            {
                await EnterPartnerAsync(_items[0], auto: true);
                return;
            }

            _statusMessage = _items.Count == 0 ? L.T("myBusinesses.empty.desc") : null;
            _statusLevel = _items.Count == 0 ? "warning" : "info";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized && !isRetry)
        {
            if (await ApiSession.TryRefreshAsync())
            {
                await LoadAsync(isRetry: true);
                return;
            }

            _statusMessage = L.T("myBusinesses.error.session");
            _statusLevel = "error";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            _statusMessage = L.T("myBusinesses.error.session");
            _statusLevel = "error";
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusLevel = "error";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<bool> TryEnterSessionPartnerAsync()
    {
        if (AuthState.PartnerId is not Guid partnerId || partnerId == Guid.Empty)
        {
            return false;
        }

        try
        {
            var partner = await PartnerApi.GetPartnerAsync(partnerId);
            if (partner is null)
            {
                return false;
            }

            await EnterPartnerAsync(partner, auto: true);
            return true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            return false;
        }
    }

    private async Task EnterPartnerAsync(ComunaClick.Shared.Api.Partner.PartnerDto partner, bool auto = false)
    {
        if (AuthState.Tokens is null)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        _isSwitching = true;
        _statusMessage = auto ? "Entrando automáticamente a tu negocio..." : "Activando sesión del negocio...";
        _statusLevel = "info";
        try
        {
            if (!await AuthState.SwitchScopeAsync(partner.TenantId, partner.Id))
            {
                throw new InvalidOperationException("No se pudo activar la sesión del negocio. Vuelve a iniciar sesión.");
            }
            Navigation.NavigateTo("/partner", true);
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusLevel = "error";
        }
        finally
        {
            _isSwitching = false;
        }
    }

    private void BeginEditPartner(ComunaClick.Shared.Api.Partner.PartnerDto partner)
    {
        _editingPartnerId = partner.Id;
        _partnerEditor.Name = partner.Name ?? string.Empty;
        _partnerEditor.Address = partner.Address;
        _partnerEditor.Phone = partner.Phone;
        _partnerEditor.Email = partner.Email;
    }

    private void CancelEditPartner()
    {
        _editingPartnerId = null;
    }

    private async Task SavePartnerAsync()
    {
        if (_editingPartnerId is null)
        {
            return;
        }

        var current = _items.FirstOrDefault(x => x.Id == _editingPartnerId.Value);
        if (current is null)
        {
            return;
        }

        _isSavingPartner = true;
        _statusLevel = "info";
        _statusMessage = $"Guardando cambios en {current.Name}...";

        try
        {
            var updated = await PartnerApi.UpdatePartnerAsync(
                current.Id,
                new ComunaClick.Shared.Api.Partner.PartnerUpdateRequest(
                    current.Type,
                    Clean(_partnerEditor.Name),
                    current.Rut,
                    Clean(_partnerEditor.Address),
                    Clean(_partnerEditor.Phone),
                    Clean(_partnerEditor.Email),
                    current.SubcategoryId,
                    current.Latitude,
                    current.Longitude,
                    current.IsVisible,
                    null));

            if (updated is not null)
            {
                var index = _items.FindIndex(x => x.Id == current.Id);
                if (index >= 0)
                {
                    _items[index] = updated;
                }
            }

            _statusLevel = "success";
            _statusMessage = "Datos del negocio actualizados correctamente.";
            _editingPartnerId = null;
        }
        catch (Exception ex)
        {
            _statusLevel = "error";
            _statusMessage = ex.Message;
        }
        finally
        {
            _isSavingPartner = false;
        }
    }

    private async Task ToggleVisibilityAsync(ComunaClick.Shared.Api.Partner.PartnerDto partner, bool isVisible)
    {
        _isTogglingVisibility = true;
        _statusLevel = "info";
        _statusMessage = isVisible
            ? $"Publicando {partner.Name}..."
            : $"Despublicando {partner.Name}...";

        try
        {
            var updated = await PartnerApi.UpdateVisibilityAsync(partner.Id, isVisible);
            if (updated is not null)
            {
                var index = _items.FindIndex(x => x.Id == partner.Id);
                if (index >= 0)
                {
                    _items[index] = updated;
                }
            }

            _statusLevel = "success";
            _statusMessage = isVisible
                ? "Negocio publicado correctamente."
                : "Negocio despublicado correctamente.";
        }
        catch (Exception ex)
        {
            _statusLevel = "error";
            _statusMessage = ex.Message;
        }
        finally
        {
            _isTogglingVisibility = false;
        }
    }

    private async Task UpdateLocationAsync(ComunaClick.Shared.Api.Partner.PartnerDto partner)
    {
        _isUpdatingLocation = true;
        _statusLevel = "info";
        _statusMessage = $"Obteniendo tu ubicación para actualizar {partner.Name}...";

        try
        {
            var position = await JSRuntime.InvokeAsync<BrowserLocation>("comunaclic.getCurrentPosition");
            var updated = await PartnerApi.UpdatePartnerAsync(
                partner.Id,
                new ComunaClick.Shared.Api.Partner.PartnerUpdateRequest(
                    partner.Type,
                    partner.Name,
                    partner.Rut,
                    partner.Address,
                    partner.Phone,
                    partner.Email,
                    partner.SubcategoryId,
                    position.Latitude,
                    position.Longitude,
                    partner.IsVisible,
                    null));

            if (updated is not null)
            {
                var index = _items.FindIndex(x => x.Id == partner.Id);
                if (index >= 0)
                {
                    _items[index] = updated;
                }
            }

            _statusLevel = "success";
            _statusMessage = "Ubicación actualizada correctamente. Si abres una categoría en buyer, este negocio podrá aparecer con su coordenada exacta.";
        }
        catch (JSException)
        {
            _statusLevel = "warning";
            _statusMessage = "No pudimos leer tu ubicación. Revisa permisos de geolocalización del navegador e inténtalo otra vez.";
        }
        catch (InvalidOperationException)
        {
            _statusLevel = "warning";
            _statusMessage = "La ubicación todavía no está disponible durante prerender. Inténtalo cuando la página termine de cargar.";
        }
        catch (Exception ex)
        {
            _statusLevel = "error";
            _statusMessage = ex.Message;
        }
        finally
        {
            _isUpdatingLocation = false;
        }
    }

    private async Task HandleLogoutAsync()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/", true);
    }

    private static string? Clean(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string PartnerTypeLabel(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => (item.Type ?? string.Empty).ToUpperInvariant() switch
        {
            "A" => L.T("myBusinesses.partnerType.commerce"),
            "B" => L.T("myBusinesses.partnerType.serviceCompany"),
            "C" => L.T("myBusinesses.partnerType.professional"),
            _ => L.T("myBusinesses.partnerType.unknown")
        };

    private static string PartnerTypeIcon(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => (item.Type ?? string.Empty).ToUpperInvariant() switch
        {
            "A" => "storefront",
            "B" => "domain",
            "C" => "engineering",
            _ => "store"
        };

    private static string PartnerTypeBadgeClass(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => (item.Type ?? string.Empty).ToUpperInvariant() switch
        {
            "A" => "inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-950 ring-2 ring-amber-200",
            "B" => "inline-flex items-center gap-1.5 rounded-full bg-[#e8f5d6] px-3 py-1.5 text-xs font-bold text-[#2d4d00] ring-2 ring-[#b8d88a]",
            "C" => "inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1.5 text-xs font-bold text-sky-950 ring-2 ring-sky-200",
            _ => "inline-flex items-center gap-1.5 rounded-full bg-[#f5f6f7] px-3 py-1.5 text-xs font-bold text-[#2c2f30] ring-1 ring-[#dadddf]"
        };

    private static string PartnerCardBorderClass(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => (item.Type ?? string.Empty).ToUpperInvariant() switch
        {
            "A" => "border-l-4 border-l-amber-400",
            "B" => "border-l-4 border-l-[#76BC21]",
            "C" => "border-l-4 border-l-sky-400",
            _ => string.Empty
        };

    private static string? PartnerCategoryLine(ComunaClick.Shared.Api.Partner.PartnerDto item)
    {
        var parts = new[] { item.SubcategoryName, item.CategoryName }
            .Where(static s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private string VisibilityLabel(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => item.IsVisible ? L.T("myBusinesses.visibility.published") : L.T("myBusinesses.visibility.draft");

    private static string VisibilityBadgeClass(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => item.IsVisible
            ? "inline-flex rounded-full bg-[#eff7e5] px-2.5 py-1 text-[11px] font-semibold text-[#3b6700]"
            : "inline-flex rounded-full bg-[#f5f6f7] px-2.5 py-1 text-[11px] font-semibold text-[#595c5d]";

    private static string ActivationBadgeClass(ComunaClick.Shared.Api.Partner.PartnerDto item)
    {
        var isReady = item.Activation?.CanPublish == true;
        if (item.IsVisible)
        {
            return "text-xs px-3 py-1 rounded-full bg-[#a7f255]/20 text-[#3b6700] font-semibold";
        }

        return isReady
            ? "text-xs px-3 py-1 rounded-full bg-sky-100 text-sky-700 font-semibold"
            : "text-xs px-3 py-1 rounded-full bg-primary/10 text-primary font-semibold";
    }

    private static string PublicPreviewHref(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => $"/buyer/detail/partner/{item.Id}";

    private string LocationLabel(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => item.Latitude is not null && item.Longitude is not null
            ? L.T("myBusinesses.location.exact")
            : L.T("myBusinesses.location.comuna");

    private static string LocationBadgeClass(ComunaClick.Shared.Api.Partner.PartnerDto item)
        => item.Latitude is not null && item.Longitude is not null
            ? "text-[11px] px-2 py-1 rounded-full bg-[#eff7e5] text-[#3b6700] font-semibold"
            : "text-[11px] px-2 py-1 rounded-full bg-[#f5f6f7] text-[#595c5d] font-semibold";

    private sealed record BrowserLocation(
        double Latitude,
        double Longitude,
        double Accuracy
    );

    private sealed class PartnerEditor
    {
        [Required(ErrorMessage = "El nombre del negocio es obligatorio.")]
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
    }
}
