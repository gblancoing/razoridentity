@page "/precios"
@inject ComunaClick.SharedUI.Services.LocaleService L
@implements IDisposable

<PageTitle>@L.T("pricing.pageTitle")</PageTitle>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 lg:py-14">

    <!-- Hero -->
    <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-primary-dim mb-2">@L.T("pricing.hero.eyebrow")</p>
        <h1 class="text-3xl sm:text-4xl font-black font-headline tracking-tight text-[#111816] dark:text-white mb-3">@L.T("pricing.hero.title")</h1>
        <p class="text-[#61897c] text-sm sm:text-base">@L.T("pricing.hero.subtitle")</p>
    </div>

    <!-- Plan cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">

        <!-- Comercio -->
        <div class="flex flex-col rounded-3xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#10221c] p-6 shadow-sm">
            <div class="relative h-28 rounded-2xl overflow-hidden mb-4 bg-gradient-to-br from-amber-50 to-orange-100 flex items-center justify-center" aria-hidden="true">
                <span class="material-symbols-outlined absolute top-3 right-4 text-3xl text-orange-300">shopping_bag</span>
                <span class="material-symbols-outlined text-6xl text-orange-500">storefront</span>
            </div>
            <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-primary text-[22px]">storefront</span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-[#61897c]">@L.T("pricing.commerce.badge")</span>
            </div>
            <h2 class="text-xl font-black font-headline text-[#111816] dark:text-white mb-1">@L.T("pricing.commerce.title")</h2>
            <p class="text-sm text-[#61897c] mb-4">@L.T("pricing.commerce.desc")</p>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-primary-container text-on-primary-container text-xs font-bold px-3 py-1 mb-4">
                <span class="material-symbols-outlined text-[16px]">redeem</span>@L.T("pricing.commerce.trial")
            </span>

            <p class="text-xs text-[#61897c]">@L.T("pricing.commerce.priceLabel")</p>
            <p class="text-2xl font-black font-headline text-[#111816] dark:text-white mb-4">@L.T("pricing.commerce.price")</p>

            <div class="rounded-2xl bg-[#f6f1e8] dark:bg-black/20 p-4 mb-5">
                <p class="text-xs font-bold text-[#111816] dark:text-white mb-2">@L.T("pricing.commerce.feesTitle")</p>
                <ul class="space-y-1.5 text-xs text-[#61897c]">
                    <li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-primary">credit_card</span>@L.T("pricing.commerce.fee1")</li>
                    <li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-primary">storefront</span>@L.T("pricing.commerce.fee2")</li>
                </ul>
            </div>

            <a href="/register?role=commerce" class="mt-auto inline-flex items-center justify-center gap-2 w-full rounded-full bg-primary text-white font-bold px-4 py-3 text-sm shadow-sm hover:brightness-110 transition-all">
                @L.T("pricing.commerce.cta")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>

        <!-- Servicio -->
        <div class="flex flex-col rounded-3xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#10221c] p-6 shadow-sm">
            <div class="relative h-28 rounded-2xl overflow-hidden mb-4 bg-gradient-to-br from-sky-50 to-blue-100 flex items-center justify-center" aria-hidden="true">
                <span class="material-symbols-outlined absolute top-3 right-4 text-3xl text-blue-300">event_available</span>
                <span class="material-symbols-outlined text-6xl text-blue-500">design_services</span>
            </div>
            <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-primary text-[22px]">event_available</span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-[#61897c]">@L.T("pricing.service.badge")</span>
            </div>
            <h2 class="text-xl font-black font-headline text-[#111816] dark:text-white mb-1">@L.T("pricing.service.title")</h2>
            <p class="text-sm text-[#61897c] mb-4">@L.T("pricing.service.desc")</p>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-primary-container text-on-primary-container text-xs font-bold px-3 py-1 mb-4">
                <span class="material-symbols-outlined text-[16px]">redeem</span>@L.T("pricing.service.trial")
            </span>

            <p class="text-xs text-[#61897c]">@L.T("pricing.service.priceLabel")</p>
            <p class="text-2xl font-black font-headline text-[#111816] dark:text-white mb-4">@L.T("pricing.service.price")</p>

            <div class="rounded-2xl bg-[#f6f1e8] dark:bg-black/20 p-4 mb-5">
                <p class="text-xs font-bold text-[#111816] dark:text-white mb-2">@L.T("pricing.service.feesTitle")</p>
                <ul class="space-y-1.5 text-xs text-[#61897c]">
                    <li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-primary">credit_card</span>@L.T("pricing.service.fee1")</li>
                    <li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-primary">storefront</span>@L.T("pricing.service.fee2")</li>
                </ul>
            </div>

            <a href="/register?role=commerce" class="mt-auto inline-flex items-center justify-center gap-2 w-full rounded-full bg-primary text-white font-bold px-4 py-3 text-sm shadow-sm hover:brightness-110 transition-all">
                @L.T("pricing.service.cta")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>

        <!-- Profesional -->
        <div class="flex flex-col rounded-3xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#10221c] p-6 shadow-sm">
            <div class="relative h-28 rounded-2xl overflow-hidden mb-4 bg-gradient-to-br from-violet-50 to-purple-100 flex items-center justify-center" aria-hidden="true">
                <span class="material-symbols-outlined absolute top-3 right-4 text-3xl text-violet-300">work</span>
                <span class="material-symbols-outlined text-6xl text-violet-500">badge</span>
            </div>
            <div class="flex items-center gap-2 mb-3">
                <span class="material-symbols-outlined text-primary text-[22px]">badge</span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-[#61897c]">@L.T("pricing.professional.badge")</span>
            </div>
            <h2 class="text-xl font-black font-headline text-[#111816] dark:text-white mb-1">@L.T("pricing.professional.title")</h2>
            <p class="text-sm text-[#61897c] mb-4">@L.T("pricing.professional.desc")</p>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-primary-container text-on-primary-container text-xs font-bold px-3 py-1 mb-4">
                <span class="material-symbols-outlined text-[16px]">redeem</span>@L.T("pricing.professional.trial")
            </span>

            <p class="text-xs text-[#61897c]">@L.T("pricing.professional.priceLabel")</p>
            <p class="text-2xl font-black font-headline text-[#111816] dark:text-white mb-4">@L.T("pricing.professional.price")</p>

            <div class="rounded-2xl bg-[#f6f1e8] dark:bg-black/20 p-4 mb-5">
                <p class="text-xs font-bold text-[#111816] dark:text-white mb-2">@L.T("pricing.professional.noteTitle")</p>
                <p class="flex items-start gap-2 text-xs text-[#61897c]">
                    <span class="material-symbols-outlined text-[16px] text-primary">forum</span>@L.T("pricing.professional.note")
                </p>
            </div>

            <a href="/register?role=professional" class="mt-auto inline-flex items-center justify-center gap-2 w-full rounded-full bg-primary text-white font-bold px-4 py-3 text-sm shadow-sm hover:brightness-110 transition-all">
                @L.T("pricing.professional.cta")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    </div>

    <!-- Shared benefits -->
    <div class="rounded-3xl bg-gradient-to-br from-primary to-primary-dim text-white p-8 sm:p-10 mb-8">
        <h2 class="text-2xl sm:text-3xl font-black font-headline tracking-tight mb-2">@L.T("pricing.benefits.title")</h2>
        <p class="text-emerald-50 text-sm sm:text-base mb-6 max-w-xl">@L.T("pricing.benefits.subtitle")</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                <span class="material-symbols-outlined text-emerald-200 text-3xl mb-2 block">event_available</span>
                <p class="font-bold mb-1">@L.T("pricing.benefits.item1.title")</p>
                <p class="text-xs text-emerald-50">@L.T("pricing.benefits.item1.desc")</p>
            </div>
            <div>
                <span class="material-symbols-outlined text-emerald-200 text-3xl mb-2 block">inventory_2</span>
                <p class="font-bold mb-1">@L.T("pricing.benefits.item2.title")</p>
                <p class="text-xs text-emerald-50">@L.T("pricing.benefits.item2.desc")</p>
            </div>
            <div>
                <span class="material-symbols-outlined text-emerald-200 text-3xl mb-2 block">forum</span>
                <p class="font-bold mb-1">@L.T("pricing.benefits.item3.title")</p>
                <p class="text-xs text-emerald-50">@L.T("pricing.benefits.item3.desc")</p>
            </div>
        </div>
    </div>

    <!-- Footnote + help -->
    <div class="text-center">
        <p class="text-xs text-[#7a8c84] max-w-2xl mx-auto mb-4">@L.T("pricing.note")</p>
        <a href="/help" class="text-sm font-bold text-primary hover:text-primary-dim transition-colors">@L.T("pricing.cta.help")</a>
    </div>
</main>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
