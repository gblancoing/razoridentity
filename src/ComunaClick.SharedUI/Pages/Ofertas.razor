@page "/ofertas"
@inject ComunaClick.SharedUI.Services.LocaleService L
@implements IDisposable

<PageTitle>@L.T("page.offers.title")</PageTitle>

<main class="mx-auto max-w-6xl px-4 py-8 sm:px-5 sm:py-10">
    <div class="overflow-hidden rounded-[2rem] border border-[#dadddf] bg-white shadow-[0_10px_40px_-20px_rgba(0,0,0,0.08)]">
        <div class="border-b border-[#e8ebed] bg-gradient-to-br from-[#f7faf5] via-white to-[#f0f4f1] px-6 py-8 sm:px-10 sm:py-10">
            <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#3b6700]">@L.T("page.offers.eyebrow")</p>
            <h1 class="mt-2 text-3xl font-black tracking-[-0.04em] text-[#2c2f30] sm:text-4xl">@L.T("page.offers.heading")</h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#595c5d] sm:text-base">@L.T("page.offers.subtitle")</p>
        </div>

        <div class="px-6 py-8 sm:px-10 sm:py-10">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-6">
                <article class="flex flex-col rounded-2xl border border-[#e4e6e8] bg-[#fafcfb] p-6 transition-shadow hover:shadow-md">
                    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-2xl bg-[#e8f5d9] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[24px]">local_offer</span>
                    </div>
                    <h2 class="text-lg font-bold text-[#2c2f30]">@L.T("page.offers.card1.title")</h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-[#595c5d]">@L.T("page.offers.card1.body")</p>
                </article>
                <article class="flex flex-col rounded-2xl border border-[#e4e6e8] bg-[#fafcfb] p-6 transition-shadow hover:shadow-md">
                    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-2xl bg-[#e8f5d9] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[24px]">tune</span>
                    </div>
                    <h2 class="text-lg font-bold text-[#2c2f30]">@L.T("page.offers.card2.title")</h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-[#595c5d]">@L.T("page.offers.card2.body")</p>
                </article>
                <article class="flex flex-col rounded-2xl border border-[#e4e6e8] bg-[#fafcfb] p-6 transition-shadow hover:shadow-md">
                    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-2xl bg-[#e8f5d9] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[24px]">map</span>
                    </div>
                    <h2 class="text-lg font-bold text-[#2c2f30]">@L.T("page.offers.card3.title")</h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-[#595c5d]">@L.T("page.offers.card3.body")</p>
                </article>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center">
                <a href="/categorias"
                   class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-6 py-3.5 text-sm font-bold text-[#d9ffad] shadow-sm transition hover:brightness-105 sm:min-w-[200px]">
                    @L.T("page.common.cta.explore")
                </a>
                <a href="/top-rated"
                   class="inline-flex items-center justify-center rounded-2xl border-2 border-[#c5cdc0] bg-white px-6 py-3.5 text-sm font-bold text-[#2c2f30] transition hover:border-[#3b6700] hover:text-[#3b6700]">
                    @L.T("page.offers.ctaTopRated")
                </a>
                <a href="/"
                   class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] bg-white px-6 py-3.5 text-sm font-semibold text-[#2c2f30] transition hover:bg-gray-50 sm:ml-0">
                    @L.T("page.common.backHome")
                </a>
            </div>
        </div>
    </div>
</main>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    private void HandleChange() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
