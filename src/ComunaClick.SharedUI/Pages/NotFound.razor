@page "/not-found"
@inject ComunaClick.SharedUI.Services.LocaleService L
@implements IDisposable

<PublicNav />

<main class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-white dark:bg-background-dark border border-gray-200 dark:border-gray-800 rounded-2xl p-10 text-center">
        <h1 class="text-3xl font-bold mb-2">@L.T("notfound.title")</h1>
        <p class="text-sm text-[#61897c]">@L.T("notfound.message")</p>
        <a class="inline-flex mt-6 bg-primary text-[#111816] px-6 py-3 rounded-lg font-bold text-sm" href="/">
            @L.T("page.common.backHome")
        </a>
    </div>
</main>

<PublicFooter />

@code {
    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
