@page "/categorias/{CategorySlug}"
@inject NavigationManager Navigation
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.LocaleService L
@using ComunaClick.SharedUI.Services
@implements IDisposable

<PageTitle>@(_detail?.Category.Name ?? "Categoría") - ComunaClic</PageTitle>

<main class="w-full min-w-0 max-w-full">
    @if (_isLoading)
    {
        <div class="max-w-7xl mx-auto px-4 py-10">
            <BrandedLoading Title="Cargando categoría" Message="Estamos reuniendo negocios, servicios y profesiones para esta categoría." />
        </div>
    }
    else if (_detail is null)
    {
        <div class="max-w-7xl mx-auto px-4 py-10">
            <StatusBanner Message="@_statusMessage" Level="warning" />
        </div>
    }
    else
    {
        @* Bandera a todo el ancho; margen superior del hero moderado. *@
        <div class="pt-6 sm:pt-8">
        <section class="w-full overflow-hidden bg-white shadow-[0_8px_32px_-16px_rgba(0,0,0,0.12)] sm:shadow-[0_12px_40px_-20px_rgba(0,0,0,0.14)]">
            @if (!string.IsNullOrWhiteSpace(CategoryImage))
            {
                <div class="h-64 w-full bg-cover bg-center sm:h-72 min-[900px]:h-80" style="@($"background-image:linear-gradient(0deg, rgba(0,0,0,0.45), rgba(0,0,0,0.05)), url('{CategoryImage}')")">
                    <div class="flex h-full w-full min-h-0 items-end p-6 sm:p-8 md:p-10">
                        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6">
                            <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-white/80 mb-3">Categoría seleccionada</p>
                            <h1 class="text-3xl sm:text-4xl font-black tracking-[-0.04em] text-white">@_detail.Category.Name</h1>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="w-full bg-gradient-to-br from-[#a7f255] via-[#eff1f2] to-white p-6 sm:p-8 md:p-10">
                    <div class="max-w-7xl mx-auto px-0 sm:px-2">
                        <p class="text-[10px] uppercase tracking-[0.22em] font-bold text-[#3b6700] mb-3">Categoría seleccionada</p>
                        <h1 class="text-3xl sm:text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@_detail.Category.Name</h1>
                    </div>
                </div>
            }
        </section>
        </div>

        @* Sin padding-top: si no hay fila visible (p. ej. no inmuebles), no se abre un “canal” blanco antes del mapa a ancho completo. *@
        <div class="max-w-7xl mx-auto space-y-8 px-4 pb-8 pt-0 sm:px-6 sm:pb-10 sm:pt-0">
        @if (IsInmueblesCategory() && _detail.Subcategories is { Count: > 0 } inmueblesSubs)
        {
            <div class="pt-6 sm:pt-7">
            <InmueblesSubcategoryExplorer Subcategories="inmueblesSubs"
                                          SelectedCode="_selectedSubcategoryCode"
                                          CategorySlug="@CategorySlug"
                                          CategoryCode="@_detail.Category.Code"
                                          OnSubcodePicked="OnInmueblesSubcodePickedAsync" />
            </div>
        }

        @if (InmueblesSplitView)
        {
            <div class="grid grid-cols-1 gap-6 pt-6 sm:pt-7 xl:grid-cols-2 items-start">
                <div class="order-2 xl:order-1 space-y-4 min-h-0 max-h-[min(85vh,52rem)] overflow-y-auto pr-1" id="inmuebles-lista-mapa">
                    <h2 class="text-xl font-black tracking-[-0.02em] text-[#2c2f30]">Negocios con este criterio</h2>
                    <p class="text-sm text-[#595c5d]">Misma búsqueda que el mapa, orden alfabético. Requiere ubicación para el mapa (arriba a la derecha en pantallas anchas).</p>
                    @if (FilteredBusinesses.Count > 0)
                    {
                        <div class="flex flex-col gap-3">
                            @foreach (var business in FilteredBusinesses)
                            {
                                <a href="@BuildInmueblesPartnerDetailHref(business.Id)"
                                   class="group flex min-w-0 overflow-hidden rounded-2xl border border-[#e4e0d9] bg-white shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#a7f255]/70 hover:shadow-md">
                                    <div class="relative w-[7.5rem] shrink-0 self-stretch min-h-[6.5rem] bg-[#e8e6e1] sm:w-36">
                                        <div class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-105" style="@BuildBusinessStyle(business)" aria-hidden="true"></div>
                                    </div>
                                    <div class="flex min-w-0 flex-1 flex-col justify-center gap-1 p-3.5 sm:p-4">
                                        <h3 class="text-base font-bold leading-snug tracking-[-0.02em] text-[#0d47a1] group-hover:underline">@business.Name</h3>
                                        <p class="text-sm leading-relaxed text-[#5c5f60]">@(business.Address ?? business.Phone ?? business.Email ?? "Contacto no publicado.")</p>
                                        <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-[#7b8081]">
                                            <span class="inline-flex rounded-md border border-[#dadddf] bg-[#faf8f3] px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-[#4a4d4e]">@PartnerTypeLabel(business.Type)</span>
                                            @if (!string.IsNullOrWhiteSpace(business.SubcategoryName) || !string.IsNullOrWhiteSpace(business.CategoryName))
                                            {
                                                <span class="text-[#495051]">@string.Join(" · ", new[] { business.SubcategoryName, business.CategoryName }.Where(s => !string.IsNullOrWhiteSpace(s)))</span>
                                            }
                                        </div>
                                        <span class="mt-1 text-xs font-bold text-[#3b6700]">Ver negocio <span class="material-symbols-outlined align-middle text-[16px]">chevron_right</span></span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <StatusBanner Message="Todavía no hay negocios publicados con este tipo de inmueble y operación." Level="warning" />
                    }
                </div>
                <div class="order-1 xl:order-2 min-w-0 sticky top-4">
                    <CategoryNearbyMap CategoryCode="@_detail.Category.Code"
                                        SubcategoryCode="_selectedSubcategoryCode"
                                        SubcategoryFilterLabel="@SelectedInmueblesSubName"
                                        MapOnly="true" />
                </div>
            </div>
        }

        <div id="category-results" class="h-0 overflow-hidden" aria-hidden="true"></div>
        </div>

        @* Mapa a ancho de viewport (sin max-w-7xl); el componente reparte 1/3 + 2/3. *@
        @if (!InmueblesSplitView)
        {
            <div class="w-full min-w-0 max-w-full px-3 pt-0 pb-8 sm:px-4 sm:pt-0 md:px-6 lg:px-8 xl:px-10 2xl:px-12">
                <CategoryNearbyMap CategoryCode="@_detail.Category.Code" />
            </div>
        }
    }
</main>

@code {
    [Parameter] public string CategorySlug { get; set; } = string.Empty;

    private ComunaClick.Shared.Api.Buyer.CategoryDiscoveryResponse? _detail;
    private bool _isLoading = true;
    private string _statusMessage = "No encontramos la categoría solicitada.";
    private string? _selectedSubcategoryCode;

    private string? CategoryImage => _detail is null ? null : CategoryVisualService.ResolveImage(_detail.Category.Code, _detail.Category.Name);

    /// <summary>Negocios del subtipo (vista inmuebles + mapa); el listado general bajo la categoría va por el mapa.</summary>
    private List<ComunaClick.Shared.Api.Buyer.CategoryBusinessItem> FilteredBusinesses => (_detail?.Businesses ?? Array.Empty<ComunaClick.Shared.Api.Buyer.CategoryBusinessItem>())
        .Where(x => InmueblesSubcategoryMatches(x))
        .OrderBy(x => x.Name)
        .ToList();

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        var categoryCode = ReadQueryValue("code") ?? CategorySlug;
        var subcode = ReadQueryValue("subcode");
        if (string.IsNullOrWhiteSpace(categoryCode))
        {
            _statusMessage = "La categoría indicada no es válida.";
            _isLoading = false;
            _detail = null;
            return;
        }

        var sameCategory = _detail is not null
            && string.Equals(_detail.Category.Code, categoryCode, StringComparison.OrdinalIgnoreCase);

        if (!sameCategory)
        {
            _isLoading = true;
            _detail = null;
            _selectedSubcategoryCode = null;
            try
            {
                _detail = await BuyerApi.GetCategoryDiscoveryAsync(categoryCode);
                if (_detail is null)
                {
                    _statusMessage = "No encontramos la categoría solicitada.";
                }
            }
            catch (HttpRequestException ex)
            {
                _statusMessage = $"No se pudo cargar la categoría ({(int?)ex.StatusCode ?? 0}).";
            }
            finally
            {
                _isLoading = false;
            }
        }

        if (_detail is not null)
        {
            if (!string.IsNullOrEmpty(subcode)
                && _detail.Subcategories?.Any(s => string.Equals(s.Code, subcode, StringComparison.Ordinal)) == true)
            {
                _selectedSubcategoryCode = subcode;
            }
            else
            {
                _selectedSubcategoryCode = null;
            }
        }
    }

    private bool IsInmueblesCategory()
        => _detail is not null
            && string.Equals(_detail.Category.Code, "inmuebles", StringComparison.OrdinalIgnoreCase);

    /// <summary>Lista a la izquierda + mapa filtrado a la derecha (pantallas anchas), estilo búsqueda con mapa.</summary>
    private bool InmueblesSplitView
        => IsInmueblesCategory() && !string.IsNullOrEmpty(_selectedSubcategoryCode);

    private string? SelectedInmueblesSubName
        => _detail?.Subcategories?.FirstOrDefault(s => s.Code == _selectedSubcategoryCode)?.Name;

    private bool InmueblesSubcategoryMatches(ComunaClick.Shared.Api.Buyer.CategoryBusinessItem business)
    {
        if (!IsInmueblesCategory() || string.IsNullOrEmpty(_selectedSubcategoryCode))
        {
            return true;
        }
        var sub = _detail?.Subcategories?.FirstOrDefault(s => s.Code == _selectedSubcategoryCode);
        if (sub is null)
        {
            return true;
        }
        return string.Equals(business.SubcategoryName, sub.Name, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnInmueblesSubcodePickedAsync(string? code)
    {
        if (_detail is null)
        {
            return Task.CompletedTask;
        }
        var cat = Uri.EscapeDataString(_detail.Category.Code);
        var path = $"/categorias/{CategorySlug}?code={cat}";
        if (!string.IsNullOrEmpty(code))
        {
            path += $"&subcode={Uri.EscapeDataString(code)}";
        }
        Navigation.NavigateTo(path, forceLoad: false);
        return Task.CompletedTask;
    }

    private string? ReadQueryValue(string key)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }

        return null;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private const string InmueblesListSectionAnchor = "inmuebles-lista-mapa";

    private string BuildInmueblesPartnerDetailHref(Guid partnerId)
    {
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var u))
        {
            return $"/buyer/detail/partner/{partnerId}";
        }
        var path = u.PathAndQuery;
        if (!path.Contains('#', StringComparison.Ordinal))
        {
            path = path + "#" + InmueblesListSectionAnchor;
        }
        return $"/buyer/detail/partner/{partnerId}?return={Uri.EscapeDataString(path)}";
    }

    private static string BuildBusinessStyle(ComunaClick.Shared.Api.Buyer.CategoryBusinessItem business)
    {
        var image = CategoryVisualService.ResolveImage(business.CategoryName, business.SubcategoryName ?? business.CategoryName);
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.12)), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(167,242,85,0.45) 0%, rgba(239,241,242,0.95) 55%, rgba(255,255,255,1) 100%);";
    }

    private static string PartnerTypeLabel(string? type)
        => type switch
        {
            "A" => "Comercio",
            "B" => "Servicios",
            "C" => "Profesionales / consulta",
            _ => "Negocio"
        };

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
