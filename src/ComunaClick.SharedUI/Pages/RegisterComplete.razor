@page "/register/complete/{Step}"
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable
@using Microsoft.JSInterop
@using ComunaClick.SharedUI.Services

<PageTitle>@L.T("register.wizard.complete.pageTitle")</PageTitle>

<div class="min-h-screen bg-[#f3f5f4] dark:bg-background-dark">
    <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
        @if (_loading)
        {
            <BrandedLoading Title="@L.T("registerAccount.loadingTitle")" Message="@L.T("registerAccount.loadingMessage")" />
        }
        else if (!AuthState.IsAuthenticated)
        {
            <StatusBanner Level="warning" Message="@L.T("buyer.profile.loginRequired")" />
            <a href="/login" class="mt-4 inline-block text-sm font-semibold text-[#3b6700]">@L.T("registerAccount.preferLogin")</a>
        }
        else if (string.Equals(Step, "buyer", StringComparison.OrdinalIgnoreCase))
        {
            <RegistrationWizardProgress Flow="@RegistrationFlow.RoleNatural" CurrentStep="2" TotalSteps="3" />

            <div class="mt-6 rounded-[1.75rem] border border-[#dbe6e2] bg-white p-6 shadow-sm dark:border-white/10 dark:bg-[#1a2e28] sm:p-8">
                <h1 class="text-2xl font-black tracking-[-0.03em] text-[#111816] dark:text-white">@L.T("register.wizard.buyer.title")</h1>
                <p class="mt-3 text-sm leading-relaxed text-[#61897c]">@L.T("register.wizard.buyer.desc")</p>
                <button type="button"
                        class="mt-6 inline-flex w-full items-center justify-center rounded-2xl bg-[#3b6700] px-6 py-3.5 text-sm font-bold text-[#d9ffad] transition hover:brightness-105 sm:w-auto"
                        @onclick="ContinueToProfile">
                    @L.T("register.wizard.buyer.cta")
                </button>
            </div>
        }
        else
        {
            <StatusBanner Level="info" Message="@L.T("notfound.message")" />
            <a href="/register" class="mt-4 inline-block text-sm font-semibold text-[#3b6700]">Volver al registro</a>
        }
    </main>
</div>

@code {
    [Parameter]
    public string Step { get; set; } = "buyer";

    private bool _loading = true;
    private string? _returnUrl;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        _returnUrl = ReadReturnUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthState.InitializeAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task ContinueToProfile()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.setAccountRole", RegistrationFlow.RoleNatural);
        }
        catch (InvalidOperationException)
        {
        }

        var destination = string.IsNullOrWhiteSpace(_returnUrl)
            ? "/account/profile?wizard=1"
            : $"/account/profile?wizard=1&returnUrl={Uri.EscapeDataString(_returnUrl)}";
        Navigation.NavigateTo(destination, true);
    }

    private string? ReadReturnUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(q))
        {
            return null;
        }

        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), "returnUrl", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            return !string.IsNullOrWhiteSpace(value) && value.StartsWith('/') ? value : null;
        }

        return null;
    }

    private void HandleChange() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleChange;
}
