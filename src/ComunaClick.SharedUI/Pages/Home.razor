@page "/"
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@using ComunaClick.SharedUI.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

<PageTitle>@L.T("home.title")</PageTitle>

<PublicNav />
<div class="relative overflow-hidden bg-[linear-gradient(180deg,#f6fbf8_0%,#eef6f1_46%,#ffffff_100%)]">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[32rem] bg-[radial-gradient(circle_at_top_left,rgba(167,242,85,0.24),transparent_46%),radial-gradient(circle_at_top_right,rgba(34,197,94,0.18),transparent_34%)]"></div>

    <section class="max-w-7xl mx-auto px-4 pt-6 pb-8 relative">
        <div class="grid grid-cols-1 xl:grid-cols-[1.35fr_0.8fr] gap-6 items-stretch">
            <div class="rounded-[2rem] overflow-hidden bg-cover bg-center bg-no-repeat shadow-[0_30px_90px_-42px_rgba(0,0,0,0.38)] ring-1 ring-black/5"
                 data-alt="Fotografía de feria y vida de barrio con negocios locales"
                 style="@HeroStyle">
                <div class="min-h-[38rem] bg-[linear-gradient(135deg,rgba(7,14,12,0.76)_0%,rgba(12,31,25,0.52)_45%,rgba(14,49,34,0.28)_100%)] p-7 sm:p-10 lg:p-12 flex flex-col justify-between gap-10">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/12 px-4 py-2 text-[11px] font-black uppercase tracking-[0.2em] text-white/92 backdrop-blur">
                            Compra y reserva local
                        </span>
                        <span class="inline-flex items-center rounded-full border border-white/14 bg-black/18 px-4 py-2 text-xs font-semibold text-white/80 backdrop-blur">
                            Encuentra ofertas, agenda servicios y vende en tu comuna
                        </span>
                    </div>

                    <div class="max-w-3xl space-y-5">
                        <h1 class="text-white text-4xl sm:text-5xl xl:text-6xl font-black leading-[0.95] tracking-[-0.055em] drop-shadow-[0_12px_28px_rgba(0,0,0,0.32)]">
                            @(_siteContent?.Home.Title ?? L.T("home.hero.title"))
                        </h1>
                        <p class="max-w-2xl text-white/90 text-base sm:text-lg leading-8 font-medium drop-shadow-[0_8px_18px_rgba(0,0,0,0.3)]">
                            @(_siteContent?.Home.Subtitle ?? L.T("home.hero.subtitle"))
                        </p>
                    </div>

                    <div class="space-y-5">
                        <label class="block w-full max-w-[760px]">
                            <div class="flex w-full items-stretch rounded-[1.6rem] border border-white/40 bg-white/92 p-2 shadow-[0_18px_44px_-24px_rgba(0,0,0,0.55)] backdrop-blur">
                                <div class="text-[#61897c] flex items-center justify-center pl-4 pr-3">
                                    <span class="material-symbols-outlined text-[1.35rem]">search</span>
                                </div>
                                <input @bind="_searchQuery"
                                       @bind:event="oninput"
                                       @onkeydown="HandleSearchKeyDown"
                                       class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden bg-transparent text-[#111816] focus:outline-0 focus:ring-0 h-14 placeholder:text-[#61897c] px-1 text-base font-medium leading-normal"
                                       placeholder="@L.T("home.search.placeholder")" />
                                <button @onclick="ExecuteSearchAsync"
                                        class="flex min-w-[128px] cursor-pointer items-center justify-center overflow-hidden rounded-[1.2rem] h-14 px-6 bg-[#111816] text-white font-bold text-base shadow-[0_16px_28px_-18px_rgba(0,0,0,0.8)] transition-transform active:scale-95">
                                    <span>@L.T("home.search.button")</span>
                                </button>
                            </div>
                        </label>

                        <div class="flex flex-wrap items-center gap-3">
                            <a href="@(_siteContent?.Home.PrimaryCtaHref ?? "/buyer")"
                               class="rounded-full bg-[#a7f255] px-6 py-3 text-sm font-black uppercase tracking-[0.12em] text-[#111816] shadow-[0_18px_28px_-20px_rgba(167,242,85,0.9)]">
                                @(_siteContent?.Home.PrimaryCtaLabel ?? "Comprar y reservar")
                            </a>
                            <a href="@(_siteContent?.Home.SecondaryCtaHref ?? "/register?intent=partner")"
                               class="rounded-full border border-white/50 bg-white/10 px-6 py-3 text-sm font-bold text-white backdrop-blur-sm">
                                @(_siteContent?.Home.SecondaryCtaLabel ?? "Publicar para vender")
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6">
                <article class="rounded-[2rem] border border-[#d8e6de] bg-white/95 p-6 shadow-[0_18px_50px_-34px_rgba(0,0,0,0.28)] backdrop-blur">
                    <p class="text-[10px] uppercase tracking-[0.2em] font-black text-[#7b8081]">Tu comuna hoy</p>
                    <h2 class="mt-3 text-2xl font-black tracking-[-0.04em] text-[#111816]">Todo lo que necesitas para comprar, reservar o captar clientes desde una sola portada.</h2>
                    <p class="mt-3 text-sm leading-7 text-[#595c5d]">
                        Entra directo a categorías con oferta disponible, servicios reservables y vitrinas listas para convertir visitas en ventas.
                    </p>

                    <div class="mt-6 grid grid-cols-3 gap-3">
                        <div class="rounded-[1.35rem] bg-[#f5f8f6] p-4">
                            <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081]">Categorías</p>
                            <p class="mt-3 text-3xl font-black tracking-[-0.05em] text-[#2c2f30]">@(_allCategories.Count == 0 ? "--" : _allCategories.Count.ToString())</p>
                            <p class="mt-2 text-xs text-[#595c5d]">familias activas</p>
                        </div>
                        <div class="rounded-[1.35rem] bg-[#f5f8f6] p-4">
                            <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081]">Partners</p>
                            <p class="mt-3 text-3xl font-black tracking-[-0.05em] text-[#2c2f30]">@(_featuredBusinesses.Count == 0 ? "--" : _featuredBusinesses.Count.ToString())</p>
                            <p class="mt-2 text-xs text-[#595c5d]">en portada hoy</p>
                        </div>
                        <div class="rounded-[1.35rem] bg-[#f5f8f6] p-4">
                            <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081]">Servicios</p>
                            <p class="mt-3 text-3xl font-black tracking-[-0.05em] text-[#2c2f30]">@(_featuredServices.Count == 0 ? "--" : _featuredServices.Count.ToString())</p>
                            <p class="mt-2 text-xs text-[#595c5d]">listos para reservar</p>
                        </div>
                    </div>
                </article>

                <article class="rounded-[2rem] bg-[#111816] p-6 text-white shadow-[0_24px_50px_-36px_rgba(0,0,0,0.65)]">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-white/55">Cómo funciona</p>
                            <h3 class="mt-3 text-xl font-black tracking-[-0.03em]">Empieza buscando y termina comprando o reservando sin fricción.</h3>
                        </div>
                        <span class="material-symbols-outlined text-[#a7f255] text-4xl">sell</span>
                    </div>
                    <div class="mt-6 space-y-3 text-sm text-white/80">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-[#a7f255]">category</span>
                            <p>Entra por categoría y ve primero la oferta con más probabilidad de compra.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-[#a7f255]">storefront</span>
                            <p>Abre vitrinas con llamados a la acción listos para vender más rápido.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-[#a7f255]">event_available</span>
                            <p>Reserva servicios o sigue tu compra desde la misma experiencia.</p>
                        </div>
                    </div>
                </article>

                @if (_searchLoading)
                {
                    <div class="rounded-[2rem] bg-white/95 p-6 shadow-[0_18px_44px_-28px_rgba(0,0,0,0.24)] backdrop-blur">
                        <BrandedLoading Title="Buscando coincidencias" Message="Estamos cruzando categorías, partners, servicios y profesionales." Compact="true" />
                    </div>
                }
                else if (_searchHasRun)
                {
                    <div class="rounded-[2rem] bg-white/95 p-6 shadow-[0_18px_44px_-28px_rgba(0,0,0,0.24)] backdrop-blur">
                        @if (!string.IsNullOrWhiteSpace(_searchError))
                        {
                            <p class="text-sm font-semibold text-[#b02500]">@_searchError</p>
                        }
                        else if (!HasSearchResults)
                        {
                            <p class="text-sm font-semibold text-[#2c2f30]">No encontramos coincidencias para "@_searchQuery".</p>
                        }
                        else
                        {
                            <div class="space-y-5 text-[#2c2f30]">
                                @if (_categorySearchResults.Count > 0)
                                {
                                    <div>
                                        <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081] mb-2">Categorías encontradas</p>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var category in _categorySearchResults)
                                            {
                                                <a href="@GetCategoryHref(category)" class="inline-flex items-center rounded-full bg-[#eff7eb] px-3 py-2 text-xs font-bold text-[#325800]">
                                                    @CategoryVisualService.ResolveDisplayName(category.Code, category.Name)
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (_partnerSearchResults.Count > 0)
                                {
                                    <div>
                                        <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081] mb-2">Negocios</p>
                                        <div class="grid grid-cols-1 gap-2">
                                            @foreach (var item in _partnerSearchResults)
                                            {
                                                <a href="@GetSearchResultHref(item)" class="rounded-2xl border border-[#e1ece5] px-4 py-3 text-sm font-semibold hover:bg-[#f3faf5]">
                                                    @item.Name
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (_serviceSearchResults.Count > 0)
                                {
                                    <div>
                                        <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081] mb-2">Servicios</p>
                                        <div class="grid grid-cols-1 gap-2">
                                            @foreach (var item in _serviceSearchResults)
                                            {
                                                <a href="@GetSearchResultHref(item)" class="rounded-2xl border border-[#e1ece5] px-4 py-3 text-sm font-semibold hover:bg-[#f3faf5]">
                                                    @item.Name
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (_professionalSearchResults.Count > 0)
                                {
                                    <div>
                                        <p class="text-[10px] uppercase tracking-[0.16em] font-black text-[#7b8081] mb-2">Profesionales</p>
                                        <div class="grid grid-cols-1 gap-2">
                                            @foreach (var item in _professionalSearchResults)
                                            {
                                                <a href="@GetSearchResultHref(item)" class="rounded-2xl border border-[#e1ece5] px-4 py-3 text-sm font-semibold hover:bg-[#f3faf5]">
                                                    @item.Name
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 pb-6 relative">
        <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr_0.95fr] gap-4">
            <article class="rounded-[1.75rem] border border-[#dae6de] bg-white px-6 py-5 shadow-[0_16px_44px_-32px_rgba(0,0,0,0.22)]">
                <p class="text-[10px] uppercase tracking-[0.18em] font-black text-[#7b8081]">Compra local</p>
                <h3 class="mt-3 text-2xl font-black tracking-[-0.04em] text-[#111816]">ComunaClic junta descubrimiento, intención y conversión en una sola portada.</h3>
                <p class="mt-3 text-sm leading-7 text-[#595c5d]">La home está pensada para llevar al usuario desde la exploración hasta la compra o reserva con menos pasos y más claridad.</p>
            </article>
            <article class="rounded-[1.75rem] bg-[#eff7eb] px-6 py-5 border border-[#d4e7c9]">
                <p class="text-[10px] uppercase tracking-[0.18em] font-black text-[#5b6a4b]">Para ti</p>
                <h3 class="mt-3 text-xl font-black tracking-[-0.03em] text-[#24401d]">Compara mejor y decide más rápido.</h3>
                <p class="mt-3 text-sm leading-7 text-[#46613d]">Menos ruido, más oferta visible, más rutas directas a compra y reserva.</p>
            </article>
            <article class="rounded-[1.75rem] bg-[#111816] px-6 py-5 text-white shadow-[0_20px_40px_-30px_rgba(0,0,0,0.75)]">
                <p class="text-[10px] uppercase tracking-[0.18em] font-black text-white/55">Para negocios</p>
                <h3 class="mt-3 text-xl font-black tracking-[-0.03em] text-white">Más visibilidad, más clics útiles y más oportunidades de venta.</h3>
                <a href="/register?intent=partner" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-[#a7f255]">
                    <span>Quiero vender aquí</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </article>
        </div>
    </section>

    <main class="max-w-7xl mx-auto px-4 pb-14">
        <div class="grid grid-cols-1 xl:grid-cols-[1fr_22rem] gap-8 items-start">
            <div class="space-y-12">
                <section class="rounded-[2rem] border border-[#dae6de] bg-white p-6 md:p-8 shadow-[0_18px_50px_-34px_rgba(0,0,0,0.18)]">
                    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-[#7b8081] mb-2">Entradas de compra</p>
                            <h2 class="text-[#111816] text-3xl font-black tracking-[-0.04em]">@L.T("home.categories.title")</h2>
                            <p class="mt-2 text-sm text-[#595c5d]">Estas son las categorías con oferta activa para comprar, reservar o descubrir negocios ahora mismo.</p>
                        </div>
                        <a class="text-primary font-bold text-sm" href="/categorias">@L.T("home.categories.viewAll")</a>
                    </div>
                    @if (_categoriesLoading)
                    {
                        <BrandedLoading Title="Cargando categorías" Message="Estamos preparando las categorías principales para ti." Compact="true" />
                    }
                    else if (_categories.Count == 0)
                    {
                        <StatusBanner Message="@_categoriesStatusMessage" Level="warning" />
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                            @foreach (var category in _categories)
                            {
                                var image = GetCategoryImage(category);
                                <a href="@GetCategoryHref(category)"
                                   class="group relative min-h-[16.5rem] overflow-hidden rounded-[1.75rem] bg-cover bg-center p-5 flex items-end transition-transform duration-200 hover:translate-y-[-3px]"
                                   style="@BuildCategoryStyle(image)">
                                    <div class="absolute inset-x-0 top-0 p-4 flex justify-between items-start">
                                        <span class="rounded-full bg-white/18 px-3 py-2 text-[10px] font-black uppercase tracking-[0.16em] text-white backdrop-blur-sm">
                                            Comprar aquí
                                        </span>
                                        <span class="material-symbols-outlined text-white/90">north_east</span>
                                    </div>
                                    <div class="relative z-10">
                                        <p class="text-[10px] uppercase tracking-[0.16em] font-black text-white/80 mb-2">Explorar y convertir</p>
                                        <p class="text-white text-2xl font-black leading-tight tracking-[-0.03em]">@CategoryVisualService.ResolveDisplayName(category.Code, category.Name)</p>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </section>

                <section class="space-y-6">
                    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 px-1">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-[#7b8081] mb-2">Negocios para comprar</p>
                            <h2 class="text-[#111816] text-3xl font-black tracking-[-0.04em]">@L.T("home.featured.title")</h2>
                            <p class="mt-2 text-sm text-[#595c5d]">Vitrinas destacadas para empujar descubrimiento, confianza y acción comercial.</p>
                        </div>
                        <a class="text-primary font-bold text-sm" href="/buyer/home">Explorar más</a>
                    </div>
                    @if (_featuredLoading)
                    {
                        <BrandedLoading Title="Cargando negocios destacados" Message="Estamos seleccionando vitrinas visibles para esta portada." Compact="true" />
                    }
                    else if (_featuredBusinesses.Count == 0)
                    {
                        <StatusBanner Message="@_featuredStatusMessage" Level="warning" />
                    }
                    else
                    {
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            @foreach (var business in _featuredBusinesses)
                            {
                                <a href="@(business.CtaHref ?? "#")"
                                   class="group overflow-hidden rounded-[2rem] border border-[#dae6de] bg-white shadow-[0_18px_50px_-34px_rgba(0,0,0,0.2)] hover:translate-y-[-3px] hover:shadow-[0_24px_60px_-36px_rgba(0,0,0,0.26)] transition-all duration-200">
                                    <div class="relative h-60 bg-cover bg-center" style="@BuildFeaturedStyle(business)">
                                        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(17,24,22,0.08)_0%,rgba(17,24,22,0.62)_100%)]"></div>
                                        <div class="absolute left-5 right-5 bottom-5 flex items-end justify-between gap-4">
                                            <div>
                                                <p class="text-[10px] uppercase tracking-[0.16em] font-black text-white/70 mb-2">Listo para vender</p>
                                                <h3 class="text-white text-2xl font-black tracking-[-0.03em] leading-tight">@business.Name</h3>
                                            </div>
                                            <span class="shrink-0 inline-flex items-center rounded-full bg-white/18 px-3 py-2 text-[10px] font-black uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                                                @FeaturedTypeLabel(business.Category, business.CtaLabel)
                                            </span>
                                        </div>
                                    </div>
                                    <div class="p-5">
                                        <p class="text-sm leading-7 text-[#595c5d]">
                                            Entra a esta vitrina local para ver productos, contacto y próximos pasos de compra.
                                        </p>
                                        <div class="mt-4 flex items-center justify-between gap-4 text-xs font-medium">
                                            <span class="inline-flex items-center gap-2 rounded-full bg-[#f4f8f5] px-3 py-2 text-[#4f5c57]">
                                                <span class="material-symbols-outlined text-sm">storefront</span>
                                                Comprar en vitrina
                                            </span>
                                            <span class="inline-flex items-center gap-2 text-primary font-bold">
                                                <span>@(business.CtaLabel ?? "Ver detalle")</span>
                                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </section>

                <section class="space-y-6">
                    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 px-1">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-[#7b8081] mb-2">Servicios para reservar</p>
                            <h2 class="text-[#111816] text-3xl font-black tracking-[-0.04em]">Servicios destacados</h2>
                            <p class="mt-2 text-sm text-[#595c5d]">Servicios priorizados para que la reserva ocurra rápido y con buena información.</p>
                        </div>
                        <a class="text-primary font-bold text-sm" href="/buyer/home">Ver servicios</a>
                    </div>
                    @if (_featuredServicesLoading)
                    {
                        <BrandedLoading Title="Cargando servicios destacados" Message="Estamos preparando servicios activos para mostrar en portada." Compact="true" />
                    }
                    else if (_featuredServices.Count == 0)
                    {
                        <StatusBanner Message="@_featuredServicesStatusMessage" Level="warning" />
                    }
                    else
                    {
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            @foreach (var service in _featuredServices)
                            {
                                <a href="@GetSearchResultHref(service)"
                                   class="group rounded-[2rem] overflow-hidden border border-[#dae6de] bg-white shadow-[0_18px_50px_-34px_rgba(0,0,0,0.2)] hover:translate-y-[-3px] hover:shadow-[0_24px_60px_-36px_rgba(0,0,0,0.26)] transition-all duration-200">
                                    <div class="relative h-56 bg-cover bg-center" style="@BuildFeaturedStyle(service)">
                                        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(17,24,22,0.05)_0%,rgba(17,24,22,0.58)_100%)]"></div>
                                        <div class="absolute left-5 right-5 bottom-5">
                                            <p class="text-[10px] uppercase tracking-[0.16em] font-black text-white/70 mb-2">Reserva disponible</p>
                                            <div class="flex items-end justify-between gap-4">
                                                <h3 class="text-white text-2xl font-black tracking-[-0.03em] leading-tight">@service.Name</h3>
                                                <span class="inline-flex items-center rounded-full bg-white/18 px-3 py-2 text-[10px] font-black uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                                                    @FeaturedTypeLabel(service.Category, "Servicio")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-5">
                                        <p class="text-sm leading-7 text-[#595c5d]">
                                            Reserva este servicio desde una ficha más clara, comercial y pensada para convertir rápido.
                                        </p>
                                        <div class="mt-4 flex items-center justify-between gap-4 text-xs font-medium">
                                            <span class="inline-flex items-center gap-2 rounded-full bg-[#f4f8f5] px-3 py-2 text-[#4f5c57]">
                                                <span class="material-symbols-outlined text-sm">schedule</span>
                                                Reservar ahora
                                            </span>
                                            <span class="inline-flex items-center gap-2 text-primary font-bold">
                                                <span>@(service.CtaLabel ?? "Reservar")</span>
                                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </section>
            </div>

            <aside class="space-y-6 xl:sticky xl:top-24">
                <div class="rounded-[2rem] border border-[#dae6de] bg-white p-6 shadow-[0_18px_44px_-32px_rgba(0,0,0,0.18)]">
                    <div class="flex items-center justify-between gap-4 mb-5">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-[#7b8081]">Confianza</p>
                            <h3 class="mt-2 text-2xl font-black tracking-[-0.03em] text-[#111816]">@L.T("home.news.title")</h3>
                        </div>
                        <span class="material-symbols-outlined text-primary text-3xl">newspaper</span>
                    </div>
                    @if (_newsCards.Count == 0)
                    {
                        <p class="text-sm text-gray-500">No hay noticias para mostrar ahora.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var news in _newsCards)
                            {
                                <a href="@news.Href" target="_blank" rel="noopener noreferrer" class="group block rounded-[1.35rem] border border-[#e6eee9] p-4 hover:bg-[#f7fbf8] transition-colors">
                                    <span class="@news.TagCss">@news.Tag</span>
                                    <h4 class="mt-2 text-sm font-bold leading-7 text-[#2c2f30] group-hover:text-primary">@news.Title</h4>
                                    <p class="text-xs text-gray-500 mt-2">@news.TimeLabel</p>
                                </a>
                            }
                        </div>
                        <a href="@NewsMoreHref" target="_blank" rel="noopener noreferrer" class="block w-full mt-5 py-3 border border-[#dbe6e2] rounded-2xl text-sm font-bold text-center">
                            @L.T("home.news.button")
                        </a>
                    }
                </div>

                <div class="rounded-[2rem] bg-[#111816] p-6 text-white shadow-[0_22px_50px_-34px_rgba(0,0,0,0.62)]">
                    <div class="flex items-center justify-between gap-4 mb-5">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] font-black text-white/55">Urgencia local</p>
                            <h3 class="mt-2 text-2xl font-black tracking-[-0.03em] text-white">@L.T("home.events.title")</h3>
                        </div>
                        <span class="material-symbols-outlined text-[#a7f255] text-3xl">event</span>
                    </div>
                    @if (_eventCards.Count == 0)
                    {
                        <p class="text-sm text-white/70">No hay eventos próximos por ahora.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var eventCard in _eventCards)
                            {
                                <div class="flex gap-4 items-center rounded-[1.35rem] border border-white/10 bg-white/5 p-4">
                                    <div class="flex flex-col items-center justify-center bg-[#a7f255] text-[#10221c] rounded-[1rem] w-14 h-14 shrink-0">
                                        <span class="text-[10px] uppercase font-black">@eventCard.MonthLabel</span>
                                        <span class="text-lg font-black leading-none">@eventCard.DayLabel</span>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-bold leading-6">@eventCard.Title</h4>
                                        <p class="text-xs text-white/70 mt-1">@eventCard.TimeLabel</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </main>
</div>
<PublicFooter />

@code {
    private readonly List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> _categories = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> _allCategories = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _featuredBusinesses = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _featuredServices = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> _categorySearchResults = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _partnerSearchResults = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _serviceSearchResults = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _professionalSearchResults = new();
    private readonly List<HomeNewsCard> _newsCards = new();
    private readonly List<HomeEventCard> _eventCards = new();
    private bool _categoriesLoading = true;
    private bool _featuredLoading = true;
    private bool _featuredServicesLoading = true;
    private bool _searchLoading;
    private bool _searchHasRun;
    private string _categoriesStatusMessage = "No encontramos categorías activas por ahora.";
    private string _featuredStatusMessage = "No encontramos negocios destacados por ahora.";
    private string _featuredServicesStatusMessage = "No encontramos servicios destacados por ahora.";
    private string? _searchError;
    private string _searchQuery = string.Empty;
    private ComunaClick.Shared.Api.Buyer.PublicSiteContentResponse? _siteContent;
    private string HomeHeroImageUrl { get; set; } = BuildHomeHeroImageUrl();
    private const string NewsMoreHref = "https://news.google.com/topics/CAAqJggKIiBDQkFTRWdvSUwyMHZNRFZxYUdjU0FtVnVLQUFQAQ?hl=es-419&gl=CL&ceid=CL%3Aes-419";
    private string HeroStyle => $"background-image: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.2)), url('{HomeHeroImageUrl}');";
    private bool HasSearchResults
        => _categorySearchResults.Count > 0
        || _partnerSearchResults.Count > 0
        || _serviceSearchResults.Count > 0
        || _professionalSearchResults.Count > 0;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        RebuildSidebarCards();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _siteContent = await BuyerApi.GetSiteContentAsync();
        }
        catch
        {
            _siteContent = null;
        }

        try
        {
            var items = await BuyerApi.GetProductCategoriesAsync();
            if (items is not null)
            {
                var distinctCategories = items
                    .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                    .GroupBy(x => NormalizeCategoryName(x.Name))
                    .Select(g => g
                        .OrderByDescending(HasCategoryImage)
                        .ThenBy(x => x.Name)
                        .First())
                    .ToList();

                _allCategories.AddRange(distinctCategories);
                _categories.AddRange(distinctCategories.Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _categoriesStatusMessage = $"No se pudieron cargar las categorías ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _categoriesLoading = false;
        }

        try
        {
            var items = await BuyerApi.SearchAsync(null, "partners", 4);
            if (items is not null)
            {
                _featuredBusinesses.AddRange(items
                    .Where(x => string.Equals(x.Type, "partner", StringComparison.OrdinalIgnoreCase))
                    .Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _featuredStatusMessage = $"No se pudieron cargar los negocios destacados ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _featuredLoading = false;
        }

        try
        {
            var items = await BuyerApi.SearchAsync(null, "services", 4);
            if (items is not null)
            {
                _featuredServices.AddRange(items
                    .Where(x => string.Equals(x.Type, "service", StringComparison.OrdinalIgnoreCase))
                    .Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _featuredServicesStatusMessage = $"No se pudieron cargar los servicios destacados ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _featuredServicesLoading = false;
        }
    }

    private string GetCategoryHref(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
    {
        var code = category.Code?.Trim();
        var name = string.IsNullOrWhiteSpace(category.Name) ? "categoria" : category.Name.Trim();
        var slugSeed = string.IsNullOrWhiteSpace(code) ? name : code;
        var slug = CategoryVisualService.ToSlug(slugSeed, name);

        return string.IsNullOrWhiteSpace(code)
            ? $"/categorias/{slug}"
            : $"/categorias/{slug}?code={Uri.EscapeDataString(code)}";
    }

    private static string? GetCategoryImage(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
        => !string.IsNullOrWhiteSpace(category.ImageUrl)
            ? category.ImageUrl
            : CategoryVisualService.ResolveImage(category.Code, category.Name);

    private static bool HasCategoryImage(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
        => !string.IsNullOrWhiteSpace(GetCategoryImage(category));

    private async Task ExecuteSearchAsync()
    {
        _searchHasRun = true;
        _searchError = null;
        _categorySearchResults.Clear();
        _partnerSearchResults.Clear();
        _serviceSearchResults.Clear();
        _professionalSearchResults.Clear();

        var query = _searchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        _searchLoading = true;
        try
        {
            var normalizedQuery = NormalizeCategoryName(query);
            _categorySearchResults.AddRange(
                _allCategories
                    .Where(x =>
                        NormalizeCategoryName(x.Name).Contains(normalizedQuery, StringComparison.Ordinal)
                        || NormalizeCategoryName(x.Code).Contains(normalizedQuery, StringComparison.Ordinal))
                    .Take(8));

            var partnersTask = BuyerApi.SearchAsync(query, "partners", 8);
            var servicesTask = BuyerApi.SearchAsync(query, "services", 8);
            var professionalsTask = BuyerApi.SearchAsync(query, "professionals", 8);

            await Task.WhenAll(partnersTask, servicesTask, professionalsTask);

            _partnerSearchResults.AddRange((await partnersTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
                .Where(x => string.Equals(x.Type, "partner", StringComparison.OrdinalIgnoreCase)));
            _serviceSearchResults.AddRange((await servicesTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
                .Where(x => string.Equals(x.Type, "service", StringComparison.OrdinalIgnoreCase)));
            _professionalSearchResults.AddRange((await professionalsTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
                .Where(x => string.Equals(x.Type, "professional", StringComparison.OrdinalIgnoreCase)));
        }
        catch (HttpRequestException ex)
        {
            _searchError = $"No se pudo completar la búsqueda ({(int?)ex.StatusCode ?? 0}).";
        }
        catch
        {
            _searchError = "No se pudo completar la búsqueda en este momento.";
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.Ordinal))
        {
            await ExecuteSearchAsync();
        }
    }

    private static string GetSearchResultHref(ComunaClick.Shared.Api.Buyer.SearchResultItem item)
    {
        var kind = item.Type?.Trim().ToLowerInvariant();
        return kind switch
        {
            "partner" => $"/buyer/detail/partner/{item.Id}",
            "service" => $"/buyer/detail/service/{item.Id}",
            "professional" => $"/buyer/detail/professional/{item.Id}",
            "product" => $"/buyer/detail/product/{item.Id}",
            _ => !string.IsNullOrWhiteSpace(item.CtaHref) ? item.CtaHref! : "#"
        };
    }

    private static string BuildCategoryStyle(string? image)
    {
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(45,158,79,0.95) 0%, rgba(34,197,94,0.8) 55%, rgba(220,252,231,0.65) 100%);";
    }

    private static string BuildFeaturedStyle(ComunaClick.Shared.Api.Buyer.SearchResultItem item)
    {
        var image = CategoryVisualService.ResolveImage(item.Category, item.Category);
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.05) 100%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(220,252,231,0.9) 0%, rgba(250,244,234,0.95) 55%, rgba(255,255,255,1) 100%);";
    }

    private static string FeaturedTypeLabel(string? category, string? ctaLabel)
        => !string.IsNullOrWhiteSpace(category)
            ? CategoryVisualService.ResolveDisplayName(category, category).ToUpperInvariant()
            : ctaLabel ?? "Negocio local";

    private static string NormalizeCategoryName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim()
            .ToLowerInvariant()
            .Replace("á", "a", StringComparison.Ordinal)
            .Replace("é", "e", StringComparison.Ordinal)
            .Replace("í", "i", StringComparison.Ordinal)
            .Replace("ó", "o", StringComparison.Ordinal)
            .Replace("ú", "u", StringComparison.Ordinal)
            .Replace("ñ", "n", StringComparison.Ordinal);
    }

    private static string BuildHomeHeroImageUrl()
    {
        // Stable daily rotation so home feels fresh without flickering on each render.
        var seed = DateTime.UtcNow.ToString("yyyyMMdd");
        return $"https://picsum.photos/seed/comunaclic-home-{seed}/1800/1000";
    }

    private void HandleChange()
    {
        RebuildSidebarCards();
        InvokeAsync(StateHasChanged);
    }

    private void RebuildSidebarCards()
    {
        _newsCards.Clear();
        _eventCards.Clear();

        _newsCards.AddRange(BuildNewsCards());
        _eventCards.AddRange(BuildEventCards());
    }

    private IReadOnlyList<HomeNewsCard> BuildNewsCards()
    {
        var firstTag = SafeLocale("home.news1.tag", "Infraestructura");
        var secondTag = SafeLocale("home.news2.tag", "Negocios");
        var thirdTag = SafeLocale("home.news3.tag", "Comunidad");

        return new[]
        {
            new HomeNewsCard(
                firstTag,
                SafeLocale("home.news1.title", "La renovación de la Calle Principal comienza el próximo martes"),
                SafeLocale("home.news1.time", "hace 2 horas"),
                "https://news.google.com/topics/CAAqIAgKIh9DQkFTRVFvSUwyMHZNRGx1YkMxbkVnSmhiaWdBUAE?hl=es-419&gl=CL&ceid=CL:es-419",
                "inline-flex rounded-full bg-emerald-100 px-3 py-1 text-[10px] text-emerald-700 font-bold mb-2 uppercase tracking-wider"),
            new HomeNewsCard(
                secondTag,
                SafeLocale("home.news2.title", "Nuevo mercado orgánico abre en el Distrito Norte"),
                SafeLocale("home.news2.time", "ayer"),
                "https://news.google.com/topics/CAAqJggKIiBDQkFTRWdvSUwyMHZNREk0ZHpBU0FtVnVLQUFQAQ?hl=es-419&gl=CL&ceid=CL:es-419",
                "inline-flex rounded-full bg-amber-100 px-3 py-1 text-[10px] text-amber-700 font-bold mb-2 uppercase tracking-wider"),
            new HomeNewsCard(
                thirdTag,
                SafeLocale("home.news3.title", "Reunión de seguridad vecinal: la seguridad primero"),
                SafeLocale("home.news3.time", "hace 2 días"),
                "https://news.google.com/topics/CAAqJggKIiBDQkFTRWdvSUwyMHZNRFkxTjJ3U0FtVnVLQUFQAQ?hl=es-419&gl=CL&ceid=CL:es-419",
                "inline-flex rounded-full bg-sky-100 px-3 py-1 text-[10px] text-sky-700 font-bold mb-2 uppercase tracking-wider")
        };
    }

    private IReadOnlyList<HomeEventCard> BuildEventCards()
    {
        return new[]
        {
            new HomeEventCard(
                SafeLocale("home.event1.title", "Feria de agricultores de fin de semana"),
                SafeLocale("home.event1.time", "08:00 - Plaza Central"),
                "Oct",
                "12"),
            new HomeEventCard(
                SafeLocale("home.event2.title", "Taller de tecnología para personas mayores"),
                SafeLocale("home.event2.time", "16:00 - Biblioteca Pública"),
                "Oct",
                "15"),
            new HomeEventCard(
                SafeLocale("home.event3.title", "Exhibición de artistas locales"),
                SafeLocale("home.event3.time", "18:30 - Centro de Artes"),
                "Oct",
                "20")
        };
    }

    private string SafeLocale(string key, string fallback)
    {
        var value = L.T(key);
        return string.IsNullOrWhiteSpace(value) || string.Equals(value, key, StringComparison.Ordinal)
            ? fallback
            : value;
    }

    private sealed record HomeNewsCard(
        string Tag,
        string Title,
        string TimeLabel,
        string Href,
        string TagCss
    );

    private sealed record HomeEventCard(
        string Title,
        string TimeLabel,
        string MonthLabel,
        string DayLabel
    );

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
