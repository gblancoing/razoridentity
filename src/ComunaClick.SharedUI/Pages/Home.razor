<!-- MAIN CONTENT -->
<div class="w-full max-w-full min-w-0 overflow-x-clip bg-gradient-to-b from-slate-50 via-[#f0f4f3] to-slate-50">

    <!-- Search results panel (conditional) -->
    <div id="home-search-results" class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 scroll-mt-24">
        @if (_searchLoading)
        {
            <div class="rounded-2xl bg-white border border-gray-200/80 p-5 shadow-sm mb-4 animate-pulse">
                <p class="text-sm font-semibold text-[#2c2f30]">@L.T("home.market.searching")</p>
            </div>
        }
        else if (_searchHasRun)
        {
            <div class="rounded-2xl bg-white border border-gray-200/80 p-5 sm:p-6 shadow-sm mb-8">
                @if (!string.IsNullOrWhiteSpace(_searchError))
                {
                    <p class="text-sm font-semibold text-[#b02500]">@_searchError</p>
                }
                else if (!HasSearchResults)
                {
                    <p class="text-sm font-semibold text-[#2c2f30]">@L.T("home.market.noMatches") <span class="text-primary">"@_searchQuery"</span></p>
                }
                else
                {
                    <div class="space-y-5">
                        @if (_categorySearchResults.Count > 0)
                        {
                            <div>
                                <p class="text-xs uppercase tracking-[0.14em] font-black text-[#4d4f50] mb-2">@L.T("home.categories.title")</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var category in _categorySearchResults)
                                    {
                                        <a href="@GetCategoryHref(category)" class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-[#2d9e4f] hover:bg-emerald-200 transition-colors">
                                            @CategoryVisualService.ResolveDisplayName(category.Code, category.Name)
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        <SearchResultsSection Title="@L.T("home.search.products")"
                                              Items="_productSearchResults"
                                              ShowViewAll="_hasMoreProducts"
                                              ViewAllHref="@BuildSearchSectionUrl("products")"
