        => SearchQueryHelper.BuildBuscarUrl(_searchQuery, geo: _lastSearchGeo);

    private string BuildSearchSectionUrl(string type)
        => SearchQueryHelper.BuildBuscarUrl(_searchQuery, type, _lastSearchGeo);

