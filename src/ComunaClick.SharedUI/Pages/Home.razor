@page "/"
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@using ComunaClick.SharedUI.Services
@implements IDisposable

<PageTitle>@L.T("home.title")</PageTitle>

<PublicNav />
<!-- Hero Section -->
<div class="max-w-7xl mx-auto px-4 py-6">
    <div class="@@container">
        <div class="flex min-h-[400px] flex-col gap-6 bg-cover bg-center bg-no-repeat rounded-xl items-center justify-center p-8" data-alt="Modern neighborhood with local shops and people" style='background-image: linear-gradient(rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuA8qTjofVsHUTaIz6zpfMJR8x0zqDwyCR1X3wsEf3aJUtL0KpwNDxIXUoJJ0ofkLSUq_mbwkUWZ7kasDeZR05uz73_0zfGryx08sJiBfHwYhRGyVoZvMf1w0ekRMJLAEIaMjVlvgMj9rELmo_MOuEODV_zRpQXS6hVEn2weUS6ZhVCm5mn3fnq1MlsQ9VEIqXDl7NLLw-_Fyty1tKoHskoKZrpD4BsNCq6KcQi5RumDDY6TPybhQsAdcvRzdhW3rDaL9A_NepT1jV0");'>
            <div class="flex flex-col gap-2 text-center max-w-2xl">
                <h1 class="text-white text-4xl font-black leading-tight tracking-[-0.033em] @@[480px]:text-6xl">
                    @L.T("home.hero.title")
                </h1>
                <h2 class="text-white/90 text-lg font-normal">
                    @L.T("home.hero.subtitle")
                </h2>
            </div>
            <label class="flex flex-col min-w-40 h-14 w-full max-w-[600px] @@[480px]:h-16 mt-4">
                <div class="flex w-full flex-1 items-stretch rounded-lg h-full shadow-xl">
                    <div class="text-[#61897c] flex border border-white bg-white items-center justify-center pl-[20px] rounded-l-lg border-r-0">
                        <span class="material-symbols-outlined">search</span>
                    </div>
                    <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111816] focus:outline-0 focus:ring-0 border border-white bg-white focus:border-white h-full placeholder:text-[#61897c] px-[15px] rounded-r-none border-r-0 pr-2 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal" placeholder="@L.T("home.search.placeholder")" />
                    <div class="flex items-center justify-center rounded-r-lg border-l-0 border border-white bg-white pr-[10px]">
                        <button class="flex min-w-[100px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-6 @@[480px]:h-12 bg-primary text-[#111816] font-bold text-base transition-transform active:scale-95">
                            <span>@L.T("home.search.button")</span>
                        </button>
                    </div>
                </div>
            </label>
        </div>
    </div>
</div>
<!-- Main Content Layout -->
<main class="max-w-7xl mx-auto px-4 pb-12">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Left: Main Content -->
        <div class="flex-1">
            <!-- Categories Grid -->
            <section>
                <div class="flex items-center justify-between px-2 mb-4">
                    <h2 class="text-[#111816] dark:text-white text-2xl font-bold">@L.T("home.categories.title")</h2>
                    <a class="text-primary font-bold text-sm" href="/categorias">@L.T("home.categories.viewAll")</a>
                </div>
                @if (_categoriesLoading)
                {
                    <BrandedLoading Title="Cargando categorías" Message="Estamos preparando las categorías principales para ti." Compact="true" />
                }
                else if (_categories.Count == 0)
                {
                    <StatusBanner Message="@_categoriesStatusMessage" Level="warning" />
                }
                else
                {
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @foreach (var category in _categories)
                        {
                            var image = CategoryVisualService.ResolveImage(category.Code, category.Name);
                            <a href="@GetCategoryHref(category)"
                               class="group cursor-pointer bg-cover bg-center flex flex-col gap-3 rounded-xl justify-end p-4 aspect-square transition-transform hover:scale-[1.02]"
                               style="@BuildCategoryStyle(image)">
                                <p class="text-white text-lg font-bold leading-tight">@category.Name</p>
                            </a>
                        }
                    </div>
                }
            </section>
            <!-- Featured Businesses Grid -->
            <section class="mt-12">
                <div class="flex items-center justify-between px-2 mb-6">
                    <h2 class="text-[#111816] dark:text-white text-2xl font-bold">@L.T("home.featured.title")</h2>
                    <a class="text-primary font-bold text-sm" href="/buyer/home">Explorar más</a>
                </div>
                @if (_featuredLoading)
                {
                    <BrandedLoading Title="Cargando negocios destacados" Message="Estamos seleccionando vitrinas visibles para esta portada." Compact="true" />
                }
                else if (_featuredBusinesses.Count == 0)
                {
                    <StatusBanner Message="@_featuredStatusMessage" Level="warning" />
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        @foreach (var business in _featuredBusinesses)
                        {
                            <a href="@(business.CtaHref ?? "#")"
                               class="bg-white dark:bg-background-dark border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                                <div class="h-48 bg-cover bg-center" style="@BuildFeaturedStyle(business)"></div>
                                <div class="p-4">
                                    <div class="flex justify-between items-start mb-2 gap-4">
                                        <h3 class="text-lg font-bold text-[#111816]">@business.Name</h3>
                                        <span class="shrink-0 flex items-center text-xs font-bold bg-primary/20 text-primary-dark px-2 py-1 rounded-full">
                                            @FeaturedTypeLabel(business.Category, business.CtaLabel)
                                        </span>
                                    </div>
                                    <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
                                        Descubre este negocio local publicado en ComunaClic y entra a su vitrina para ver más detalles.
                                    </p>
                                    <div class="flex items-center justify-between gap-4 text-xs font-medium text-gray-500">
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">storefront</span>
                                            Negocio visible
                                        </span>
                                        <span class="flex items-center gap-1 text-primary">
                                            <span>@(business.CtaLabel ?? "Ver detalle")</span>
                                            <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </section>
        </div>
        <!-- Right Sidebar -->
        <aside class="w-full lg:w-80 flex flex-col gap-8">
            <!-- Local News -->
            <div class="bg-white dark:bg-background-dark border border-gray-200 dark:border-gray-800 rounded-xl p-6">
                <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">newspaper</span>
                    @L.T("home.news.title")
                </h3>
                <div class="flex flex-col gap-4">
                    <div class="group cursor-pointer border-b border-gray-100 dark:border-gray-800 pb-3 last:border-0">
                        <p class="text-xs text-primary font-bold mb-1 uppercase tracking-wider">@L.T("home.news1.tag")</p>
                        <h4 class="text-sm font-semibold leading-snug group-hover:text-primary">@L.T("home.news1.title")</h4>
                        <p class="text-xs text-gray-500 mt-1">@L.T("home.news1.time")</p>
                    </div>
                    <div class="group cursor-pointer border-b border-gray-100 dark:border-gray-800 pb-3 last:border-0">
                        <p class="text-xs text-primary font-bold mb-1 uppercase tracking-wider">@L.T("home.news2.tag")</p>
                        <h4 class="text-sm font-semibold leading-snug group-hover:text-primary">@L.T("home.news2.title")</h4>
                        <p class="text-xs text-gray-500 mt-1">@L.T("home.news2.time")</p>
                    </div>
                    <div class="group cursor-pointer last:border-0">
                        <p class="text-xs text-primary font-bold mb-1 uppercase tracking-wider">@L.T("home.news3.tag")</p>
                        <h4 class="text-sm font-semibold leading-snug group-hover:text-primary">@L.T("home.news3.title")</h4>
                        <p class="text-xs text-gray-500 mt-1">@L.T("home.news3.time")</p>
                    </div>
                </div>
                <button class="w-full mt-4 py-2 border border-gray-200 dark:border-gray-800 rounded-lg text-sm font-bold">@L.T("home.news.button")</button>
            </div>
            <!-- Upcoming Events -->
            <div class="bg-white dark:bg-background-dark border border-gray-200 dark:border-gray-800 rounded-xl p-6">
                <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">event</span>
                    @L.T("home.events.title")
                </h3>
                <div class="flex flex-col gap-4">
                    <div class="flex gap-3 items-center">
                        <div class="flex flex-col items-center justify-center bg-primary/10 rounded-lg w-12 h-12 shrink-0">
                            <span class="text-[10px] uppercase font-bold text-primary">Oct</span>
                            <span class="text-lg font-black leading-none">12</span>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold">@L.T("home.event1.title")</h4>
                            <p class="text-xs text-gray-500">@L.T("home.event1.time")</p>
                        </div>
                    </div>
                    <div class="flex gap-3 items-center">
                        <div class="flex flex-col items-center justify-center bg-primary/10 rounded-lg w-12 h-12 shrink-0">
                            <span class="text-[10px] uppercase font-bold text-primary">Oct</span>
                            <span class="text-lg font-black leading-none">15</span>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold">@L.T("home.event2.title")</h4>
                            <p class="text-xs text-gray-500">@L.T("home.event2.time")</p>
                        </div>
                    </div>
                    <div class="flex gap-3 items-center">
                        <div class="flex flex-col items-center justify-center bg-primary/10 rounded-lg w-12 h-12 shrink-0">
                            <span class="text-[10px] uppercase font-bold text-primary">Oct</span>
                            <span class="text-lg font-black leading-none">20</span>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold">@L.T("home.event3.title")</h4>
                            <p class="text-xs text-gray-500">@L.T("home.event3.time")</p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</main>
<PublicFooter />

@code {
    private readonly List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> _categories = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.SearchResultItem> _featuredBusinesses = new();
    private bool _categoriesLoading = true;
    private bool _featuredLoading = true;
    private string _categoriesStatusMessage = "No encontramos categorías activas por ahora.";
    private string _featuredStatusMessage = "No encontramos negocios destacados por ahora.";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await BuyerApi.GetProductCategoriesAsync();
            if (items is not null)
            {
                _categories.AddRange(items
                    .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                    .GroupBy(x => NormalizeCategoryName(x.Name))
                    .Select(g => g
                        .OrderByDescending(x => !string.IsNullOrWhiteSpace(CategoryVisualService.ResolveImage(x.Code, x.Name)))
                        .ThenBy(x => x.Name)
                        .First())
                    .Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _categoriesStatusMessage = $"No se pudieron cargar las categorías ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _categoriesLoading = false;
        }

        try
        {
            var items = await BuyerApi.SearchAsync(null, "partners", 4);
            if (items is not null)
            {
                _featuredBusinesses.AddRange(items
                    .Where(x => string.Equals(x.Type, "partner", StringComparison.OrdinalIgnoreCase))
                    .Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _featuredStatusMessage = $"No se pudieron cargar los negocios destacados ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _featuredLoading = false;
        }
    }

    private string GetCategoryHref(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
        => $"/categorias/{CategoryVisualService.ToSlug(category.Code, category.Name)}?code={Uri.EscapeDataString(category.Code)}";

    private static string BuildCategoryStyle(string? image)
    {
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(59,103,0,0.95) 0%, rgba(118,188,33,0.8) 55%, rgba(167,242,85,0.55) 100%);";
    }

    private static string BuildFeaturedStyle(ComunaClick.Shared.Api.Buyer.SearchResultItem item)
    {
        var image = CategoryVisualService.ResolveImage(item.Category, item.Category);
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.05) 100%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(167,242,85,0.45) 0%, rgba(239,241,242,0.95) 55%, rgba(255,255,255,1) 100%);";
    }

    private static string FeaturedTypeLabel(string? category, string? ctaLabel)
        => !string.IsNullOrWhiteSpace(category) ? category! : ctaLabel ?? "Negocio local";

    private static string NormalizeCategoryName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim()
            .ToLowerInvariant()
            .Replace("á", "a", StringComparison.Ordinal)
            .Replace("é", "e", StringComparison.Ordinal)
            .Replace("í", "i", StringComparison.Ordinal)
            .Replace("ó", "o", StringComparison.Ordinal)
            .Replace("ú", "u", StringComparison.Ordinal)
            .Replace("ñ", "n", StringComparison.Ordinal);
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
