    private static string BuildCategoryStyle(string? image)
    {
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(45,158,79,0.95) 0%, rgba(34,197,94,0.8) 55%, rgba(220,252,231,0.65) 100%);";
    }

    private static string BuildFeaturedImageOnlyStyle(ComunaClick.Shared.Api.Buyer.SearchResultItem item)
    {
        var image = CategoryVisualService.ResolveImage(item.Category, item.Category);
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(220,252,231,0.95) 0%, rgba(250,244,234,0.98) 55%, rgba(255,255,255,1) 100%);";
    }

    private static string? FormatPriceLine(ComunaClick.Shared.Api.Buyer.SearchResultItem item)
    {
        if (item.Price is null)
        {
            return null;
        }

        var cur = (item.Currency ?? string.Empty).Trim().ToUpperInvariant();
        var n = item.Price.Value;
        return cur switch
        {
            "CLP" or "CL$" => $"$ {n:N0}",
            "USD" or "US$" or "USD $" => $"US$ {n:N2}",
            _ => string.IsNullOrWhiteSpace(item.Currency)
                ? $"$ {n:N0}"
                : $"{item.Currency} {n:N0}"
        };
    }

    private static string NormalizeCategoryName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim()
            .ToLowerInvariant()
            .Replace("á", "a", StringComparison.Ordinal)
            .Replace("é", "e", StringComparison.Ordinal)
            .Replace("í", "i", StringComparison.Ordinal)
            .Replace("ó", "o", StringComparison.Ordinal)
            .Replace("ú", "u", StringComparison.Ordinal)
            .Replace("ñ", "n", StringComparison.Ordinal);
    }

