    private string SafeLocale(string key, string fallback)
    {
        var value = L.T(key);
        return string.IsNullOrWhiteSpace(value) || string.Equals(value, key, StringComparison.Ordinal)
            ? fallback
            : value;
    }

    private static void PinInmueblesFirst(List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> categories)
    {
        var i = categories.FindIndex(c => string.Equals(c.Code, "inmuebles", StringComparison.OrdinalIgnoreCase));
        if (i > 0)
        {
            var item = categories[i];
            categories.RemoveAt(i);
            categories.Insert(0, item);
        }
    }

