                    .ToList();

                PinInmueblesFirst(distinctCategories);

                _allCategories.AddRange(distinctCategories);
                _categories.AddRange(distinctCategories.Take(4));
            }
        }
        catch (HttpRequestException ex)
        {
            _categoriesStatusMessage = $"No se pudieron cargar las categorías ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _categoriesLoading = false;
        }

        try
        {
            var items = await BuyerApi.SearchAsync(null, "partners", 8);
            if (items is not null)
            {
                _featuredBusinesses.AddRange(items
                    .Where(x => string.Equals(x.Type, "partner", StringComparison.OrdinalIgnoreCase))
                    .Take(8));
            }
        }
        catch (HttpRequestException ex)
        {
            _featuredStatusMessage = $"No se pudieron cargar los negocios destacados ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _featuredLoading = false;
        }

        try
        {
            var items = await BuyerApi.SearchAsync(null, "services", 8);
            if (items is not null)
            {
                _featuredServices.AddRange(items
                    .Where(x => string.Equals(x.Type, "service", StringComparison.OrdinalIgnoreCase))
                    .Take(8));
            }
        }
        catch (HttpRequestException ex)
        {
            _featuredServicesStatusMessage = $"No se pudieron cargar los servicios destacados ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _featuredServicesLoading = false;
        }

        if (!string.IsNullOrWhiteSpace(QFromUrl))
        {
            _searchQuery = QFromUrl.Trim();
            await ExecuteSearchAsync();
        }

        _ = StartHeroSlideRotationAsync();
    }

    private void InitializeHeroSlides()
    {
        if (HeroSlideUrls.Length == 0)
        {
            return;
        }

        _heroSlideIndex = 0;
        _heroVisibleLayer = 0;
        _heroLayer0Style = BuildHeroBackgroundStyle(HeroSlideUrls[0]);
        _heroLayer1Style = HeroSlideUrls.Length > 1
            ? BuildHeroBackgroundStyle(HeroSlideUrls[1])
            : _heroLayer0Style;
    }

    private static string BuildHeroBackgroundStyle(string url)
        => $"background-image: url('{url}');";

    private string GetHeroSlideLayerClass(int layer)
        => layer == _heroVisibleLayer ? "cc-hero-slide--visible" : string.Empty;

    private async Task StartHeroSlideRotationAsync()
    {
        if (HeroSlideUrls.Length <= 1)
        {
            return;
        }

        _heroSlideCts?.Cancel();
        _heroSlideCts?.Dispose();
        _heroSlideCts = new CancellationTokenSource();
        var token = _heroSlideCts.Token;

        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(token))
            {
                AdvanceHeroSlide();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Page left or disposed.
        }
    }

    private void AdvanceHeroSlide()
    {
        if (HeroSlideUrls.Length <= 1)
        {
            return;
        }

        _heroSlideIndex = (_heroSlideIndex + 1) % HeroSlideUrls.Length;
        var nextUrl = HeroSlideUrls[_heroSlideIndex];

        if (_heroVisibleLayer == 0)
        {
            _heroLayer1Style = BuildHeroBackgroundStyle(nextUrl);
            _heroVisibleLayer = 1;
        }
        else
        {
            _heroLayer0Style = BuildHeroBackgroundStyle(nextUrl);
            _heroVisibleLayer = 0;
        }
    }

    private string GetCategoryHref(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
    {
        var code = category.Code?.Trim();
        var name = string.IsNullOrWhiteSpace(category.Name) ? "categoria" : category.Name.Trim();
        var slugSeed = string.IsNullOrWhiteSpace(code) ? name : code;
        var slug = CategoryVisualService.ToSlug(slugSeed, name);

        return string.IsNullOrWhiteSpace(code)
            ? $"/categorias/{slug}"
            : $"/categorias/{slug}?code={Uri.EscapeDataString(code)}";
    }

    private async Task OnSearchSubmitAsync()
    {
        await ExecuteSearchAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        var query = _searchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _searchHasRun = true;
            _searchError = null;
            _heroSearchMessage = L.T("home.search.emptyQuery");
            await InvokeAsync(StateHasChanged);
            return;
        }

        _searchHasRun = true;
        _searchError = null;
        _heroSearchMessage = null;
        _categorySearchResults.Clear();
        _productSearchResults.Clear();
        _partnerSearchResults.Clear();
        _serviceSearchResults.Clear();
        _professionalSearchResults.Clear();

        _searchLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var ctx = _searchGeoContext ?? _searchLocationBar?.GetContext();
            if (ctx?.Mode == HomeSearchLocationBar.NearbyMode && _searchLocationBar is not null)
            {
                var located = await _searchLocationBar.EnsureLocationForSearchAsync();
                if (!located)
                {
                    _heroSearchMessage = L.T("home.search.location.requiredBeforeSearch");
                    return;
                }

                _searchGeoContext = _searchLocationBar.GetContext();
            }

            var normalizedQuery = NormalizeCategoryName(query);
            _categorySearchResults.AddRange(
                _allCategories
                    .Where(x =>
                        NormalizeCategoryName(x.Name).Contains(normalizedQuery, StringComparison.Ordinal)
                        || (!string.IsNullOrWhiteSpace(x.Code) && NormalizeCategoryName(x.Code).Contains(normalizedQuery, StringComparison.Ordinal)))
                    .DistinctBy(x => CategoryVisualService.ResolveDisplayName(x.Code, x.Name), StringComparer.OrdinalIgnoreCase)
                    .Take(8));

            var geo = BuildSearchGeoFilter();
            _lastSearchGeo = geo;
            await RunCatalogSearchAsync(query, geo);
            UpdateSearchHasMoreFlags();

            if (geo is not null && !HasCatalogSearchResults())
            {
                await RunCatalogSearchAsync(query, geo: null);
                _lastSearchGeo = null;
                UpdateSearchHasMoreFlags();
                if (HasCatalogSearchResults())
                {
                    _heroSearchMessage = L.T("home.search.fallbackNoGeo");
                }
            }

            _heroSearchMessage ??= BuildHeroSearchSummary(query);
        }
        catch (HttpRequestException ex)
        {
            _searchError = $"No se pudo completar la búsqueda ({(int?)ex.StatusCode ?? 0}).";
            _heroSearchMessage = null;
        }
        catch (Exception ex)
        {
            _searchError = L.T("home.search.errorGeneric");
            _heroSearchMessage = null;
            System.Diagnostics.Debug.WriteLine($"Home search failed: {ex}");
        }
        finally
        {
            _searchLoading = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToSearchResultsAsync();
        }
    }

    private bool HasCatalogSearchResults()
        => _productSearchResults.Count > 0
        || _partnerSearchResults.Count > 0
        || _serviceSearchResults.Count > 0
        || _professionalSearchResults.Count > 0;

    private async Task RunCatalogSearchAsync(string query, ComunaClick.Shared.Api.Buyer.GeoFilter? geo)
    {
        if (geo is null)
        {
            _productSearchResults.Clear();
            _partnerSearchResults.Clear();
            _serviceSearchResults.Clear();
            _professionalSearchResults.Clear();
        }

        var fetchLimit = SearchQueryHelper.HomeFetchLimit;
        var productsTask = BuyerApi.SearchAsync(query, "products", fetchLimit, geo);
        var partnersTask = BuyerApi.SearchAsync(query, "partners", fetchLimit, geo);
        var servicesTask = BuyerApi.SearchAsync(query, "services", fetchLimit, geo);
        var professionalsTask = BuyerApi.SearchAsync(query, "professionals", fetchLimit, geo);

        await Task.WhenAll(productsTask, partnersTask, servicesTask, professionalsTask);

        if (geo is null)
        {
            _productSearchResults.Clear();
            _partnerSearchResults.Clear();
            _serviceSearchResults.Clear();
            _professionalSearchResults.Clear();
        }

        _productSearchResults.AddRange((await productsTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
            .Where(x => string.Equals(x.Type, "product", StringComparison.OrdinalIgnoreCase)));
        _partnerSearchResults.AddRange((await partnersTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
            .Where(x => string.Equals(x.Type, "partner", StringComparison.OrdinalIgnoreCase)));
        _serviceSearchResults.AddRange((await servicesTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
            .Where(x => string.Equals(x.Type, "service", StringComparison.OrdinalIgnoreCase)));
        _professionalSearchResults.AddRange((await professionalsTask ?? Array.Empty<ComunaClick.Shared.Api.Buyer.SearchResultItem>())
            .Where(x => string.Equals(x.Type, "professional", StringComparison.OrdinalIgnoreCase)));
    }

    private string? BuildHeroSearchSummary(string query)
    {
        if (!string.IsNullOrWhiteSpace(_searchError))
        {
            return null;
        }

        var total = _categorySearchResults.Count
            + _productSearchResults.Count
            + _partnerSearchResults.Count
            + _serviceSearchResults.Count
            + _professionalSearchResults.Count;

        if (total == 0)
        {
            return string.Format(L.T("home.search.summaryNone"), query);
        }

        return string.Format(L.T("home.search.summaryFound"), total, query);
    }

    private async Task ScrollToSearchResultsAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.scrollToElement", "home-search-results");
        }
        catch
        {
            // Ignore scroll failures (prerender / SSR).
        }
    }

    private Task HandleSearchGeoChanged(HomeSearchLocationBar.HomeSearchGeoContext context)
    {
        _searchGeoContext = context;
        return Task.CompletedTask;
    }

    private ComunaClick.Shared.Api.Buyer.GeoFilter? BuildSearchGeoFilter()
    {
        var ctx = _searchGeoContext ?? _searchLocationBar?.GetContext();
        if (ctx?.HasCoordinates != true || ctx.Latitude is null || ctx.Longitude is null)
        {
            return null;
        }

        return new ComunaClick.Shared.Api.Buyer.GeoFilter(
            Latitude: ctx.Latitude,
            Longitude: ctx.Longitude,
            RadiusKm: ctx.RadiusKm);
    }

    private void UpdateSearchHasMoreFlags()
    {
        _hasMoreProducts = _productSearchResults.Count > SearchQueryHelper.HomePreviewCount;
        _hasMorePartners = _partnerSearchResults.Count > SearchQueryHelper.HomePreviewCount;
        _hasMoreServices = _serviceSearchResults.Count > SearchQueryHelper.HomePreviewCount;
        _hasMoreProfessionals = _professionalSearchResults.Count > SearchQueryHelper.HomePreviewCount;
    }

