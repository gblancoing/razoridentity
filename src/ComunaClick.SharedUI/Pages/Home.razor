@page "/"
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject IJSRuntime JSRuntime
@using ComunaClick.SharedUI.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

<PageTitle>@L.T("home.title")</PageTitle>

@* Marquee global: evita que el CSS aislado del RCL rompa la animación (keyframes + nombre deben coincidir en el documento). *@
<style>
    @@keyframes cc-home-brand-marquee {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }

    .cc-ticker-rtl {
        animation: cc-home-brand-marquee 38s linear infinite;
        will-change: transform;
    }

    @@media (prefers-reduced-motion: reduce) {
        .cc-ticker-rtl {
            animation: none;
        }
    }

    .cc-ticker-rtl:hover {
        animation-play-state: paused;
    }
</style>

<!-- MEGA HERO -->
<section class="cc-hero-bg relative min-h-[600px] sm:min-h-[700px] flex flex-col overflow-hidden">
    <!-- Hero photos: crossfade every 10s (marketplace, food, retail) -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="cc-hero-slide bg-cover bg-center @GetHeroSlideLayerClass(0)" style="@_heroLayer0Style"></div>
        <div class="cc-hero-slide bg-cover bg-center @GetHeroSlideLayerClass(1)" style="@_heroLayer1Style"></div>
    </div>
    <!-- Left-to-right overlay: dark on left (text), transparent on right (photo) -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#043d2a]/95 via-[#065f46]/75 to-[#0f766e]/20 pointer-events-none"></div>
    <!-- Top-to-bottom overlay for depth -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-transparent to-black/50 pointer-events-none"></div>
    <!-- Dot-grid texture -->
    <div class="cc-dot-grid absolute inset-0 opacity-5 pointer-events-none"></div>
    <!-- Bottom scene-transition fade -->
    <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none"></div>

    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-4 sm:px-6 pt-16 pb-28 sm:pt-20 sm:pb-32 text-center max-w-5xl mx-auto w-full gap-6 sm:gap-8">

        <!-- Floating trust badge -->
        <div class="cc-badge-float inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-md px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.14em] text-white/95">
            <span class="cc-pulse-dot w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
            @L.T("home.hero.badge")
        </div>

        <!-- Headline -->
        <h1 class="text-white text-[2.4rem] sm:text-5xl md:text-[3.6rem] lg:text-[4.2rem] font-extrabold font-headline leading-[1.06] tracking-[-0.04em] text-balance drop-shadow-lg max-w-4xl">
            @(_siteContent?.Home.Title ?? L.T("home.hero.title"))
        </h1>

        <p class="text-white/75 text-base sm:text-xl md:text-2xl font-medium max-w-2xl mx-auto leading-relaxed text-balance">
            @(_siteContent?.Home.Subtitle ?? L.T("home.hero.subtitle"))
        </p>

        <!-- Mega search bar -->
        <div class="w-full max-w-3xl mx-auto">
            <form class="cc-search-ring flex w-full items-stretch rounded-2xl h-[58px] sm:h-16 overflow-hidden bg-white shadow-[0_24px_64px_-12px_rgba(0,0,0,0.65)] ring-2 ring-white/15 transition-all duration-300"
                  @onsubmit="OnSearchSubmitAsync"
                  @onsubmit:preventDefault="true">
                <div class="flex items-center justify-center pl-4 sm:pl-5 bg-white shrink-0">
                    <span class="material-symbols-outlined text-primary text-[26px]">search</span>
                </div>
                <input @bind="_searchQuery"
                       @bind:event="oninput"
                       name="q"
                       class="flex-1 min-w-0 border-0 bg-white text-[#111816] placeholder:text-gray-400 px-3 sm:px-4 text-base sm:text-lg focus:ring-0 focus:outline-none font-medium"
                       placeholder="@L.T("home.search.placeholder")" />
                <button type="submit"
                        disabled="@_searchLoading"
                        class="shrink-0 px-6 sm:px-10 bg-primary text-white font-headline font-extrabold text-sm sm:text-[15px] hover:brightness-110 active:scale-[0.97] transition-all duration-150 disabled:opacity-60">
                    @L.T("home.search.button")
                </button>
            </form>

            <!-- Quick pills below search -->
            <div class="flex flex-wrap gap-2 mt-4 justify-center">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/12 border border-white/20 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-white/90 hover:bg-white/22 transition-colors cursor-default select-none">
                    <span class="material-symbols-outlined text-emerald-300 text-[14px]">storefront</span>@L.T("home.market.promo1")
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/12 border border-white/20 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-white/90 hover:bg-white/22 transition-colors cursor-default select-none">
                    <span class="material-symbols-outlined text-yellow-300 text-[14px]">bolt</span>@L.T("home.market.promo2")
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/12 border border-white/20 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-white/90 hover:bg-white/22 transition-colors cursor-default select-none">
                    <span class="material-symbols-outlined text-sky-300 text-[14px]">verified</span>@L.T("home.market.promo3")
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/12 border border-white/20 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-white/90 hover:bg-white/22 transition-colors cursor-default select-none">
                    <span class="material-symbols-outlined text-rose-300 text-[14px]">local_offer</span>@L.T("home.market.promo4")
                </span>
            </div>

            <HomeSearchLocationBar @ref="_searchLocationBar" OnGeoChanged="HandleSearchGeoChanged" />

            @if (_searchLoading || _searchHasRun || !string.IsNullOrWhiteSpace(_heroSearchMessage))
            {
                <div class="mt-3 rounded-xl border border-white/25 bg-black/35 backdrop-blur-md px-4 py-3 text-left text-sm"
                     role="status"
                     aria-live="polite">
                    @if (_searchLoading)
                    {
                        <p class="font-semibold text-white/95 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                            @L.T("home.market.searching")
                        </p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_searchError))
                    {
                        <p class="font-semibold text-rose-200">@_searchError</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_heroSearchMessage))
                    {
                        <p class="font-semibold text-white/95">@_heroSearchMessage</p>
                    }
                </div>
            }
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 mt-2">
            @if (_siteContent is not null)
            {
                <a href="@_siteContent.Home.PrimaryCtaHref"
                   class="rounded-full bg-white text-primary px-8 sm:px-10 py-3 sm:py-3.5 text-sm font-extrabold shadow-lg hover:shadow-2xl hover:scale-105 active:scale-[0.99] transition-all duration-200">
                    @_siteContent.Home.PrimaryCtaLabel
                </a>
                <a href="@_siteContent.Home.SecondaryCtaHref"
                   class="rounded-full border-2 border-white/50 bg-transparent px-8 sm:px-10 py-3 sm:py-3.5 text-sm font-bold text-white hover:bg-white/15 active:scale-[0.99] transition-all duration-200">
                    @_siteContent.Home.SecondaryCtaLabel
                </a>
            }
            else
            {
                <a href="/categorias"
                   class="rounded-full bg-white text-primary px-8 sm:px-10 py-3 sm:py-3.5 text-sm font-extrabold shadow-lg hover:shadow-2xl hover:scale-105 active:scale-[0.99] transition-all duration-200">
                    @L.T("home.hero.ctaPrimary")
                </a>
                <a href="/register?role=commerce"
                   class="rounded-full border-2 border-white/50 bg-transparent px-8 sm:px-10 py-3 sm:py-3.5 text-sm font-bold text-white hover:bg-white/15 active:scale-[0.99] transition-all duration-200">
                    @L.T("nav.registerShort")
                </a>
            }
        </div>
    </div>
</section>

