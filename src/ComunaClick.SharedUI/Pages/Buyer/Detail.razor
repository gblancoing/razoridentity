@page "/buyer/detail"
@page "/buyer/detail/{Type}/{Id:guid}"
@layout BuyerLayout
@using BuyerModels = ComunaClick.Shared.Api.Buyer
@using ComunaClick.SharedUI.Services
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_partnerPageTitle)</PageTitle>

<div class="max-w-7xl mx-auto space-y-8 px-4 sm:px-6">
    @if (_isLoading)
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando el detalle seleccionado." Compact="true" />
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-3">
            <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">No pudimos cargar este detalle</p>
            <p class="text-sm text-[#595c5d]">@_errorMessage</p>
            <a href="/categorias" class="inline-flex items-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">Ver categorías</a>
        </section>
    }
    else if (IsPartnerStore && _partnerProfile is not null)
    {
        var store = _partnerProfile.Partner;
        var productCount = _partnerProfile.Products?.Count ?? 0;
        var serviceCount = _partnerProfile.Services?.Count ?? 0;
        <div class="space-y-8 rounded-3xl bg-[#f7f5f0] p-4 pb-10 sm:p-6 sm:pb-10">
            <section class="relative overflow-hidden rounded-3xl min-h-[min(44vh,16rem)] shadow-[0_24px_60px_-20px_rgba(0,0,0,0.45)] sm:min-h-[280px] md:min-h-[340px]">
                <div class="absolute inset-0 bg-[#1a1c1b]"></div>
                <div class="absolute inset-0 bg-cover bg-center" style="@StorefrontBannerStyle"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c0a] via-[#0a0c0a]/75 to-[#0a0c0a]/25"></div>
                <div class="relative z-10 flex min-h-[min(44vh,16rem)] flex-col justify-end p-6 sm:min-h-[280px] sm:p-8 md:min-h-[340px] md:p-10">
                    <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-white/75">@PartnerTypeEyebrow(store.Type)</p>
                    <h1 class="mt-2 text-3xl font-black leading-tight tracking-[-0.04em] text-white sm:text-4xl md:text-5xl">@store.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(store.OfferLabel))
                    {
                        <p class="mt-3 max-w-2xl text-sm font-medium text-white/90">@store.OfferLabel</p>
                    }
                    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-white/90">
                        @if (productCount > 0 || serviceCount > 0)
                        {
                            <span class="font-semibold">@productCount producto(s) · @serviceCount servicio(s)</span>
                        }
                        else
                        {
                            <span>Catálogo en preparación</span>
                        }
                    </div>
                    <div class="mt-4 flex flex-wrap gap-2">
                        @if (!string.IsNullOrWhiteSpace(store.CategoryName))
                        {
                            <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@store.CategoryName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(store.SubcategoryName))
                        {
                            <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@store.SubcategoryName</span>
                        }
                    </div>
                    <p class="mt-3 max-w-2xl text-xs leading-relaxed text-white/70">Navegá por categoría abajo, compará precios y comprá o reservá con la misma experiencia en todo el portal.</p>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <a href="#tienda-comercio" class="inline-flex items-center justify-center rounded-2xl bg-[#a7f255] px-5 py-2.5 text-sm font-bold text-[#1a2e0b] shadow-md hover:brightness-105">Ver tienda</a>
                        <a href="@PartnerExploreBackHref" class="inline-flex items-center justify-center rounded-2xl border border-white/40 bg-white/10 px-5 py-2.5 text-sm font-bold text-white hover:bg-white/20">Volver a explorar</a>
                    </div>
                </div>
            </section>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border border-[#e5e0d8] bg-white px-4 py-4 text-sm text-[#2c2f30] shadow-[0_8px_24px_-16px_rgba(0,0,0,0.12)] sm:px-6 sm:py-5">
                @if (!string.IsNullOrWhiteSpace(store.Address))
                {
                    <span class="inline-flex max-w-full items-start gap-3 break-words">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-[#e8f3dc] text-[#3b6700]">
                            <span class="material-symbols-outlined text-[20px]">location_on</span>
                        </span>
                        <span class="pt-0.5 font-medium">@store.Address</span>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(store.Phone))
                {
                    <a href="@($"tel:{store.Phone}")" class="inline-flex items-center gap-3 font-semibold text-[#2c2f30] hover:text-[#3b6700]">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-[#e8f3dc] text-[#3b6700]">
                            <span class="material-symbols-outlined text-[20px]">call</span>
                        </span>
                        @store.Phone
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(store.Email))
                {
                    <a href="@($"mailto:{store.Email}")" class="inline-flex min-w-0 max-w-full items-center gap-3 font-semibold text-[#2c2f30] hover:text-[#3b6700]">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-[#e8f3dc] text-[#3b6700]">
                            <span class="material-symbols-outlined text-[20px]">mail</span>
                        </span>
                        <span class="truncate">@store.Email</span>
                    </a>
                }
            </div>

            <section id="tienda-comercio" class="scroll-mt-24 space-y-6 rounded-3xl border border-[#ebe7df] bg-white p-5 shadow-[0_12px_40px_-24px_rgba(0,0,0,0.1)] sm:p-8">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Catálogo</p>
                    <h2 class="mt-1 text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Productos y servicios</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-[#595c5d]">Elegí una categoría para filtrar o recorre todo el listado. Cada tarjeta lleva al detalle para comprar o reservar.</p>
                </div>

                @if (PartnerCategoryKeys.Count > 0)
                {
                    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Categorías">
                        <button type="button" class="@PartnerFilterChipClass(_partnerCategoryFilter is null)" @onclick="() => SetPartnerCategoryFilter(null)">Todo</button>
                        @foreach (var cat in PartnerCategoryKeys)
                        {
                            <button type="button" class="@PartnerFilterChipClass(_partnerCategoryFilter == cat)" @onclick="() => SetPartnerCategoryFilter(cat)">@cat</button>
                        }
                    </div>
                }

                @if (FilteredStoreProducts.Count > 0)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Productos</h3>
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                            @foreach (var product in FilteredStoreProducts)
                            {
                                <a href="/buyer/detail/product/@product.Id" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#e3e0d8] bg-white shadow-[0_6px_32px_-18px_rgba(0,0,0,0.12)] transition hover:-translate-y-1 hover:border-[#a7f255]/70 hover:shadow-xl">
                                    <div class="relative h-44 bg-cover bg-center" style="@ProductCardBackground(product)">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0"></div>
                                        <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#325800]">@StoreCategoryLabel(product.Category)</span>
                                    </div>
                                    <div class="flex flex-1 flex-col p-5">
                                        <p class="text-base font-bold leading-snug text-[#2c2f30] group-hover:text-[#3b6700]">@product.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-[#595c5d]">@product.Description</p>
                                        }
                                        else
                                        {
                                            <p class="mt-2 min-h-[3.75rem] text-sm italic text-[#a8acad]">Sin descripción breve aún.</p>
                                        }
                                        <p class="mt-4 border-t border-[#f0ede6] pt-3 text-lg font-black text-[#3b6700]">@FormatMoney(product.Price, product.Currency)</p>
                                        <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[#3b6700]">Comprar <span class="material-symbols-outlined text-sm">chevron_right</span></span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (FilteredStoreServices.Count > 0)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Servicios</h3>
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                            @foreach (var service in FilteredStoreServices)
                            {
                                <a href="/buyer/detail/service/@service.Id" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#e3e0d8] bg-white shadow-[0_6px_32px_-18px_rgba(0,0,0,0.12)] transition hover:-translate-y-1 hover:border-[#a7f255]/70 hover:shadow-xl">
                                    <div class="relative h-40 bg-cover bg-center" style="@ServiceCardBackground(service)">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>
                                        <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#325800]">@StoreCategoryLabel(service.Category)</span>
                                    </div>
                                    <div class="flex flex-1 flex-col p-5">
                                        <p class="text-base font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@service.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-[#595c5d]">@service.Description</p>
                                        }
                                        else
                                        {
                                            <p class="mt-2 min-h-[3.75rem] text-sm italic text-[#a8acad]">Sin descripción breve aún.</p>
                                        }
                                        <p class="mt-2 text-xs font-bold uppercase tracking-wide text-[#7b8081]">@service.DurationMinutes min</p>
                                        <p class="mt-3 border-t border-[#f0ede6] pt-3 text-lg font-black text-[#3b6700]">@FormatMoney(service.Price, service.Currency)</p>
                                        <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[#3b6700]">Reservar <span class="material-symbols-outlined text-sm">chevron_right</span></span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (store.Type == "C" && _partnerProfile.Professionals is { Count: > 0 } team)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Equipo</h3>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            @foreach (var professional in team)
                            {
                                <a href="/buyer/detail/professional/@professional.Id" class="flex flex-col gap-2 rounded-3xl border border-[#e8eaec] bg-[#f9faf8] p-5 transition hover:border-[#a7f255]">
                                    <p class="text-lg font-bold text-[#2c2f30]">@professional.Name</p>
                                    <p class="text-sm font-semibold text-[#3b6700]">@professional.Specialty</p>
                                    @if (!string.IsNullOrWhiteSpace(professional.Bio))
                                    {
                                        <p class="max-h-10 overflow-hidden text-sm text-[#595c5d]">@professional.Bio</p>
                                    }
                                    <span class="text-xs font-bold text-[#3b6700]">Ver perfil →</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (FilteredStoreProducts.Count == 0 && FilteredStoreServices.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-[#dadddf] bg-[#faf8f3] px-5 py-8 text-center">
                        <p class="text-sm font-medium text-[#2c2f30]">Aún no hay productos o servicios publicados con este criterio.</p>
                        <p class="mt-1 text-sm text-[#7b8081]">Si elegiste una categoría, probá con &quot;Todo&quot; o volvé más tarde.</p>
                    </div>
                }
            </section>
        </div>
    }
    else if (IsProductDetail)
    {
        var p = _productDetail!;
        <div class="space-y-8 pb-10">
            <section class="overflow-hidden rounded-3xl border border-[#e3e6e8] bg-white shadow-[0_20px_50px_-28px_rgba(0,0,0,0.12)]">
                <div class="grid gap-0 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
                    <div class="relative min-h-[min(40vh,18rem)] bg-[#1a1c1b] sm:min-h-[22rem]">
                        <div class="absolute inset-0 bg-cover bg-center" style="@HeroImageStyle"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c0a]/95 via-[#0a0c0a]/45 to-[#0a0c0a]/20"></div>
                        <div class="relative flex h-full min-h-[min(40vh,18rem)] flex-col justify-end p-6 sm:min-h-[22rem] sm:p-8">
                            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/80">@_eyebrow</p>
                            <h1 class="mt-2 text-3xl font-black leading-tight tracking-[-0.04em] text-white sm:text-4xl">@p.Name</h1>
                            <p class="mt-4 text-3xl font-black tracking-[-0.03em] text-[#a7f255] sm:text-4xl">@FormatMoney(p.Price, p.Currency)</p>
                            <div class="mt-4 flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(p.Category))
                                {
                                    <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@p.Category</span>
                                }
                                <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@(p.IsActive ? "Disponible" : "No disponible")</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center gap-5 bg-gradient-to-b from-[#fbfcfa] to-white p-6 sm:p-8 lg:p-10">
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Comprar en ComunaClic</p>
                            <p class="mt-2 text-sm leading-6 text-[#595c5d]">@_subtitle</p>
                        </div>
                        <div class="space-y-3">
                            <a href="@_primaryCtaHref" class="block w-full rounded-2xl bg-[#3b6700] px-5 py-3.5 text-center text-sm font-bold text-[#d9ffad] shadow-md hover:brightness-105">@_primaryCtaLabel</a>
                            @if (!string.IsNullOrWhiteSpace(_secondaryCtaLabel) && !string.IsNullOrWhiteSpace(_secondaryCtaHref))
                            {
                                <a href="@_secondaryCtaHref" class="block w-full rounded-2xl border-2 border-[#dadddf] bg-white px-5 py-3.5 text-center text-sm font-bold text-[#2c2f30] hover:border-[#3b6700]/40">@_secondaryCtaLabel</a>
                            }
                        </div>
                        <p class="text-xs leading-relaxed text-[#7b8081]">Pagos y entregas se coordinan según las condiciones del comercio. Si necesitás más detalle, abrí la ficha del negocio.</p>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(300px,1fr)]">
                <article class="rounded-[2rem] border border-[#e8eaec] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] sm:p-8">
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Sobre este producto</p>
                    @{
                        var productDescBlocks = DescriptionParagraphs(p.Description);
                    }
                    @if (productDescBlocks.Count > 0)
                    {
                        <div class="mt-4 space-y-4 text-base leading-7 text-[#2c2f30] [text-wrap:pretty]">
                            @foreach (var block in productDescBlocks)
                            {
                                <p class="whitespace-pre-line">@block</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-4 rounded-2xl border border-dashed border-[#dadddf] bg-[#f9faf8] px-4 py-3 text-sm leading-6 text-[#595c5d]">El comercio aún no publicó una descripción ampliada. Podés ver más información en la página del negocio o al coordinar la compra.</p>
                    }
                    <p class="mt-6 text-sm text-[#7b8081]">@string.Join(" · ", new[] { p.Category, FormatMoney(p.Price, p.Currency) }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                </article>
                <aside class="space-y-6">
                    <article class="rounded-[2rem] border border-[#e8eaec] bg-white p-6 sm:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Detalles</p>
                        <div class="mt-4 space-y-3">
                            @foreach (var fact in _detailFacts)
                            {
                                <div class="flex items-baseline justify-between gap-3 border-b border-[#f0f1f2] py-2 last:border-0">
                                    <span class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">@fact.Label</span>
                                    <span class="text-right text-sm font-semibold text-[#2c2f30]">@fact.Value</span>
                                </div>
                            }
                        </div>
                    </article>
                    <article class="rounded-[2rem] bg-[#eff1f2] p-6 sm:p-8">
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Estado</p>
                        <p class="mt-3 text-sm text-[#595c5d]">@_statusMessage</p>
                        <p class="mt-4 text-base font-bold text-[#2c2f30]">@_ctaSubtitle</p>
                    </article>
                </aside>
            </div>
        </div>
    }
    else if (IsServiceDetail)
    {
        var s = _serviceDetail!;
        <div class="space-y-8 pb-10">
            <section class="overflow-hidden rounded-3xl border border-[#e3e6e8] bg-white shadow-[0_20px_50px_-28px_rgba(0,0,0,0.12)]">
                <div class="grid gap-0 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
                    <div class="relative min-h-[min(40vh,18rem)] bg-[#1a1c1b] sm:min-h-[22rem]">
                        <div class="absolute inset-0 bg-cover bg-center" style="@HeroImageStyle"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a12]/95 via-[#0a0a12]/45 to-[#0a0a12]/20"></div>
                        <div class="relative flex h-full min-h-[min(40vh,18rem)] flex-col justify-end p-6 sm:min-h-[22rem] sm:p-8">
                            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/80">@_eyebrow</p>
                            <h1 class="mt-2 text-3xl font-black leading-tight tracking-[-0.04em] text-white sm:text-4xl">@s.Name</h1>
                            <p class="mt-2 text-sm font-medium text-white/90">@s.DurationMinutes min · @FormatMoney(s.Price, s.Currency)</p>
                            <div class="mt-4 flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(s.Category))
                                {
                                    <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@s.Category</span>
                                }
                                <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@(s.IsActive ? "Agenda disponible" : "Pausada")</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center gap-5 bg-gradient-to-b from-[#f8f9fc] to-white p-6 sm:p-8 lg:p-10">
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Reservar en ComunaClic</p>
                            <p class="mt-2 text-sm leading-6 text-[#595c5d]">@_subtitle</p>
                        </div>
                        <div class="space-y-3">
                            <a href="@_primaryCtaHref" class="block w-full rounded-2xl bg-[#3b6700] px-5 py-3.5 text-center text-sm font-bold text-[#d9ffad] shadow-md hover:brightness-105">@_primaryCtaLabel</a>
                            @if (!string.IsNullOrWhiteSpace(_secondaryCtaLabel) && !string.IsNullOrWhiteSpace(_secondaryCtaHref))
                            {
                                <a href="@_secondaryCtaHref" class="block w-full rounded-2xl border-2 border-[#dadddf] bg-white px-5 py-3.5 text-center text-sm font-bold text-[#2c2f30] hover:border-[#3b6700]/40">@_secondaryCtaLabel</a>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(300px,1fr)]">
                <article class="rounded-[2rem] border border-[#e8eaec] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] sm:p-8">
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Sobre este servicio</p>
                    @{
                        var serviceDescBlocks = DescriptionParagraphs(s.Description);
                    }
                    @if (serviceDescBlocks.Count > 0)
                    {
                        <div class="mt-4 space-y-4 text-base leading-7 text-[#2c2f30] [text-wrap:pretty]">
                            @foreach (var block in serviceDescBlocks)
                            {
                                <p class="whitespace-pre-line">@block</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-4 rounded-2xl border border-dashed border-[#dadddf] bg-[#f7f8fb] px-4 py-3 text-sm leading-6 text-[#595c5d]">El comercio aún no publicó una descripción ampliada. Revisá la página del negocio o reservá para coordinar detalles.</p>
                    }
                    <p class="mt-6 text-sm text-[#7b8081]">@string.Join(" · ", new[] { s.Category, $"{s.DurationMinutes} min", FormatMoney(s.Price, s.Currency) }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                </article>
                <aside class="space-y-6">
                    <article class="rounded-[2rem] border border-[#e8eaec] bg-white p-6 sm:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
