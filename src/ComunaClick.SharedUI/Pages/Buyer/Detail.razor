    private async Task LoadProductAsync(Guid id)
    {
        var product = await BuyerApi.GetProductAsync(id);
        if (product is null)
        {
            _errorMessage = "Producto no encontrado.";
            return;
        }

        _eyebrow = "Producto";
        _title = product.Name ?? _title;
        _partnerPageTitle = $"{_title} · ComunaClic";
        _subtitle = "Producto disponible para compra directa dentro del portal.";
        _detailLine1 = product.Description ?? "Sin descripción disponible.";
        _detailLine2 = string.Join(" · ", new[]
        {
            product.Category,
            FormatMoney(product.Price, product.Currency)
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var onHand = product.StockQuantity ?? 0;
        var available = product.AvailableQuantity ?? onHand;
        var reserved = Math.Max(0, onHand - available);
        _statusMessage = reserved > 0
            ? "Hay unidades reservadas en pedidos pendientes de pago. Si cancelas esos pedidos en tu panel, el stock vuelve a estar disponible."
            : "Oferta lista para compra.";
        _ctaSubtitle = reserved > 0
            ? $"Disponible para venta: {available} de {onHand} en bodega."
            : "Continúa al checkout o revisa el negocio que publica este producto.";
        _primaryCtaLabel = product.InStock ? "Comprar ahora" : L.T("public.product.outOfStock");
        _primaryCtaHref = product.InStock ? $"/buyer/checkout?productId={id}" : "#";
        _secondaryCtaLabel = product.PartnerId != Guid.Empty ? "Ver negocio" : null;
        _secondaryCtaHref = product.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{product.PartnerId}" : null;
        _consultHref = product.PartnerId != Guid.Empty
            ? ContactMessageHref(
                $"/account/messages?partnerId={product.PartnerId}&productId={id}&subject={Uri.EscapeDataString($"Consulta: {product.Name}")}")
            : null;
        _heroImageUrl = PublicOfferVisuals.ResolveImage(product.ImageUrl, product.Category, product.Name, product.ImageUrls);
        _heroLabel = "Producto destacado";
        _heroTitle = product.Category ?? "Disponible para compra";
        AddBadge(product.Category);
        AddBadge(FormatMoney(product.Price, product.Currency));
        AddFact("Categoría", product.Category ?? "Sin categoría informada");
        AddFact("Precio", FormatMoney(product.Price, product.Currency));
        AddFact("Estado", product.InStock ? L.T("public.product.inStock") : L.T("public.product.outOfStock"));
        AddFact("Publicado", product.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy"));
        _productDetail = product;
        _showAddToCart = product.InStock && product.TenantId != Guid.Empty;
    }

    private async Task AddToCartAsync()
    {
        if (_productDetail is null || !_showAddToCart)
        {
            return;
        }

        _addingToCart = true;
        _cartStatusMessage = null;
        _cartAdded = false;
        try
        {
            var item = JsonSerializer.Serialize(new
            {
                tenantId = _productDetail.TenantId.ToString(),
                partnerId = _productDetail.PartnerId.ToString(),
                partnerName = _productDetail.PartnerName ?? _title,
                currency = _productDetail.Currency ?? "CLP",
                productId = _productDetail.Id.ToString(),
                name = _productDetail.Name ?? _title,
                quantity = 1,
                unitPrice = _productDetail.Price,
                maxAvailable = _productDetail.AvailableQuantity ?? _productDetail.StockQuantity ?? 99
            });
            var result = await JSRuntime.InvokeAsync<string>("comunaclic.addGuestCartItem", item);
            switch (result)
            {
                case "ok":
                    _cartStatusMessage = L.T("buyer.cart.added");
                    _cartAdded = true;
                    break;
                case "ok_new_group":
                    // El carrito ahora agrupa por negocio: se crea un pedido por cada uno.
                    _cartStatusMessage = L.T("buyer.cart.addedNewGroup");
                    _cartAdded = true;
                    break;
                default:
                    _cartStatusMessage = L.T("buyer.checkout.missingProduct");
                    break;
            }

            if (_cartAdded)
            {
                // Actualiza también el badge del carrito en el header.
                await Cart.RefreshAsync(JSRuntime);
                _cartItemCount = Cart.Count;
            }
        }
        finally
        {
            _addingToCart = false;
        }
    }

