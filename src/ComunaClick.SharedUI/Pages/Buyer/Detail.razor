</div>

@code {
    [Parameter] public string? Type { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isLoading;
    private string? _errorMessage;
    private string _partnerPageTitle = "ComunaClic";
    private string? _partnerCategoryFilter;
    private string _eyebrow = "Detalle";
    private string _title = "Detalle";
    private string _subtitle = string.Empty;
    private string _detailLine1 = string.Empty;
    private string _detailLine2 = string.Empty;
    private string _statusMessage = "Selecciona un elemento para ver detalle.";
    private string _ctaSubtitle = "Revisa esta oferta y continúa la acción que corresponde.";
    private string _primaryCtaLabel = "Ver detalle";
    private string _primaryCtaHref = "/categorias";
    private string? _secondaryCtaLabel;
    private string? _secondaryCtaHref;
    private bool _isFavorite;
    private Guid? _favoriteId;
    private string? _favoriteMessage;
    private string _heroImageUrl = "_content/ComunaClick.SharedUI/logo.png";
    private string _heroLabel = "ComunaClic";
    private string _heroTitle = "Explora la oferta publicada";
    private readonly List<string> _badges = new();
    private readonly List<DetailFact> _detailFacts = new();
    private BuyerModels.PartnerProfileResponse? _partnerProfile;
    private BuyerModels.Product? _productDetail;
    private BuyerModels.Service? _serviceDetail;

    private string HeroImageStyle => $"background-image: url('{_heroImageUrl}')";
    private bool CanShowFavoriteAction => ResolveFavoriteType() is not null && Id.HasValue;

    private string StorefrontBannerStyle => HeroImageStyle;

    private bool IsPartnerStore
        => string.Equals(Type, "partner", StringComparison.OrdinalIgnoreCase) && _partnerProfile is not null;

    /// <summary>Vuelve a la categoría desde la que se abrió el comercio (<c>?return=</c>), si vino; si no, a partir del código de categoría del perfil; último recurso <c>/categorias</c>.</summary>
    private string PartnerExploreBackHref => BuildPartnerExploreBackHref();

    private string BuildPartnerExploreBackHref()
    {
        var fromQuery = GetSanitizedPartnerReturnFromQuery();
        if (!string.IsNullOrEmpty(fromQuery))
        {
            return fromQuery;
        }

        if (_partnerProfile?.Partner is { } p && !string.IsNullOrWhiteSpace(p.CategoryCode))
        {
            var code = p.CategoryCode.Trim();
            var slug = CategoryVisualService.ToSlug(code, p.CategoryName);
            return $"/categorias/{slug}?code={Uri.EscapeDataString(code)}#categoria-mapa-cercano";
        }

        return "/categorias";
    }

    private string? GetSanitizedPartnerReturnFromQuery()
    {
        var raw = ReadFirstQueryValue(Navigation.Uri, "return")
            ?? ReadFirstQueryValue(Navigation.Uri, "returnUrl");
        return SanitizePartnerExploreReturnPath(raw);
    }

    private static string? ReadFirstQueryValue(string uriString, string key)
    {
        if (!Uri.TryCreate(uriString, UriKind.Absolute, out var u))
        {
            return null;
        }
        var query = u.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 0)
            {
                continue;
            }
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }
        return null;
    }

    /// <summary>Solo URLs relativas al catálogo (misma app); evita redirecciones abiertas.</summary>
    private static string? SanitizePartnerExploreReturnPath(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }
        var t = raw.Trim();
        if (t.Length > 2048)
        {
            return null;
        }
        if (t.Contains("..", StringComparison.Ordinal)
            || t.Contains("://", StringComparison.Ordinal)
            || t.StartsWith("//", StringComparison.Ordinal))
        {
            return null;
        }
        if (t[0] != '/')
        {
            return null;
        }
        if (t.Equals("/categorias", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias/", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias?", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias#", StringComparison.OrdinalIgnoreCase))
        {
            return t;
        }
        return null;
    }

    private bool IsProductDetail
        => string.Equals(Type, "product", StringComparison.OrdinalIgnoreCase) && _productDetail is not null;

    private bool IsServiceDetail
        => string.Equals(Type, "service", StringComparison.OrdinalIgnoreCase) && _serviceDetail is not null;

    private IReadOnlyList<string> PartnerCategoryKeys
    {
        get
        {
            if (_partnerProfile is null)
            {
                return Array.Empty<string>();
            }
            var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var p in _partnerProfile.Products ?? Array.Empty<BuyerModels.PartnerProfileProduct>())
            {
                set.Add(StoreCategoryLabel(p.Category));
            }
            foreach (var s in _partnerProfile.Services ?? Array.Empty<BuyerModels.PartnerProfileService>())
            {
                set.Add(StoreCategoryLabel(s.Category));
            }
            return set.OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private IReadOnlyList<BuyerModels.PartnerProfileProduct> FilteredStoreProducts
    {
        get
        {
            var list = _partnerProfile?.Products ?? Array.Empty<BuyerModels.PartnerProfileProduct>();
            if (_partnerCategoryFilter is null)
            {
                return list.ToList();
            }
            return list
                .Where(p => string.Equals(StoreCategoryLabel(p.Category), _partnerCategoryFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private IReadOnlyList<BuyerModels.PartnerProfileService> FilteredStoreServices
    {
        get
        {
            var list = _partnerProfile?.Services ?? Array.Empty<BuyerModels.PartnerProfileService>();
            if (_partnerCategoryFilter is null)
            {
                return list.ToList();
            }
            return list
                .Where(s => string.Equals(StoreCategoryLabel(s.Category), _partnerCategoryFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void SetPartnerCategoryFilter(string? category) => _partnerCategoryFilter = category;

    private static string PartnerFilterChipClass(bool active)
        => active
            ? "inline-flex items-center rounded-full bg-[#3b6700] px-3.5 py-1.5 text-xs font-bold text-[#d9ffad] shadow-sm transition"
            : "inline-flex items-center rounded-full border border-[#dadddf] bg-white px-3.5 py-1.5 text-xs font-bold text-[#2c2f30] transition hover:border-[#3b6700]/40";

    private static string StoreCategoryLabel(string? category)
        => string.IsNullOrWhiteSpace(category) ? "General" : category.Trim();

    private static string PartnerTypeEyebrow(string? t)
        => t?.Trim().ToUpperInvariant() switch
        {
            "B" => "Negocio de servicios",
            "C" => "Profesionales y consultoría",
            _ => "Comercio local"
        };

    private static string ProductCardBackground(BuyerModels.PartnerProfileProduct p)
    {
        var url = ResolveHeroImage(p.Category, p.Name) ?? "";
        return string.IsNullOrEmpty(url)
            ? "background: linear-gradient(135deg, #e8f5e0 0%, #f5f6f7 100%);"
            : $"background-image: linear-gradient(0deg, rgba(0,0,0,0.2), rgba(0,0,0,0.05)), url('{url}');";
    }

    private static string ServiceCardBackground(BuyerModels.PartnerProfileService s)
    {
        var url = ResolveHeroImage(s.Category, s.Name) ?? "";
        return string.IsNullOrEmpty(url)
            ? "background: linear-gradient(135deg, #e3edf5 0%, #f5f6f7 100%);"
            : $"background-image: linear-gradient(0deg, rgba(0,0,0,0.2), rgba(0,0,0,0.05)), url('{url}');";
    }

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        Navigation.LocationChanged += OnDetailLocationChanged;
    }

    private void OnDetailLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await AuthState.InitializeAsync();
        }
        catch (InvalidOperationException)
        {
            // JS interop may not be available during prerender; fall back to current in-memory state.
        }

        _partnerProfile = null;
        _productDetail = null;
        _serviceDetail = null;
        _partnerCategoryFilter = null;
        _badges.Clear();
        _detailFacts.Clear();
        _errorMessage = null;
        _partnerPageTitle = L.T("buyer.detail.title");

        _title = L.T("buyer.detail.heading");
        _subtitle = L.T("buyer.detail.subtitle");
        _detailLine1 = L.T("buyer.detail.info1");
        _detailLine2 = L.T("buyer.detail.info2");
        _statusMessage = "Selecciona un elemento para ver detalle.";
        _ctaSubtitle = "Revisa esta oferta y continúa la acción que corresponde.";
        _primaryCtaLabel = "Ver detalle";
        _primaryCtaHref = "/categorias";
        _secondaryCtaLabel = null;
        _secondaryCtaHref = null;
        _isFavorite = false;
        _favoriteId = null;
        _favoriteMessage = null;
        _eyebrow = "Detalle";
        _heroImageUrl = "_content/ComunaClick.SharedUI/logo.png";
        _heroLabel = "ComunaClic";
        _heroTitle = "Explora la oferta publicada";

        if (Id is null || string.IsNullOrWhiteSpace(Type))
        {
            return;
        }

        _isLoading = true;
        try
        {
            switch (Type.Trim().ToLowerInvariant())
            {
                case "product":
                    await LoadProductAsync(Id.Value);
                    break;
                case "service":
                    await LoadServiceAsync(Id.Value);
                    break;
                case "partner":
                    await LoadPartnerAsync(Id.Value);
                    break;
                case "professional":
                    await LoadProfessionalAsync(Id.Value);
                    break;
                default:
                    _errorMessage = "Tipo no soportado.";
                    break;
            }
        }
        catch
        {
            _errorMessage = "Error al cargar el detalle seleccionado.";
        }
        finally
        {
            _isLoading = false;
        }

        await RefreshFavoriteStateAsync();
    }

    private async Task LoadProductAsync(Guid id)
    {
        var product = await BuyerApi.GetProductAsync(id);
        if (product is null)
        {
            _errorMessage = "Producto no encontrado.";
            return;
        }

        _eyebrow = "Producto";
        _title = product.Name ?? _title;
        _partnerPageTitle = $"{_title} · ComunaClic";
        _subtitle = "Producto disponible para compra directa dentro del portal.";
        _detailLine1 = product.Description ?? "Sin descripción disponible.";
        _detailLine2 = string.Join(" · ", new[]
        {
            product.Category,
            FormatMoney(product.Price, product.Currency)
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        _statusMessage = "Oferta lista para compra.";
        _ctaSubtitle = "Continúa al checkout o revisa el negocio que publica este producto.";
        _primaryCtaLabel = AuthState.IsPersonalAccount ? "Comprar ahora" : "Inicia sesión para comprar";
        _primaryCtaHref = RequirePersonalBuyerSession($"/buyer/checkout?productId={id}");
        _secondaryCtaLabel = product.PartnerId != Guid.Empty ? "Ver negocio" : null;
        _secondaryCtaHref = product.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{product.PartnerId}" : null;
        _heroImageUrl = ResolveHeroImage(product.Category, product.Name);
        _heroLabel = "Producto destacado";
        _heroTitle = product.Category ?? "Disponible para compra";
        AddBadge(product.Category);
        AddBadge(FormatMoney(product.Price, product.Currency));
        AddFact("Categoría", product.Category ?? "Sin categoría informada");
        AddFact("Precio", FormatMoney(product.Price, product.Currency));
        AddFact("Estado", product.IsActive ? "Disponible" : "No disponible");
        AddFact("Publicado", product.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy"));
        _productDetail = product;
    }

    private async Task LoadServiceAsync(Guid id)
    {
        var service = await BuyerApi.GetServiceAsync(id);
        if (service is null)
        {
            _errorMessage = "Servicio no encontrado.";
            return;
        }

        _eyebrow = "Servicio";
        _title = service.Name ?? _title;
        _partnerPageTitle = $"{_title} · ComunaClic";
        _subtitle = "Servicio disponible para reservar directamente en el portal.";
        _detailLine1 = service.Description ?? "Sin descripción disponible.";
        _detailLine2 = string.Join(" · ", new[]
        {
            service.Category,
            $"{service.DurationMinutes} min",
