@page "/buyer/detail"
@page "/buyer/detail/{Type}/{Id:guid}"
@layout BuyerLayout
@using System.Net
@using System.Text.Json
@using BuyerModels = ComunaClick.Shared.Api.Buyer
@using ComunaClick.Common
@using ComunaClick.SharedUI.Services
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@inject ApiMediaUrl MediaUrl
@inject IJSRuntime JSRuntime
@inject CartState Cart
@implements IDisposable

<PageTitle>@(_partnerPageTitle)</PageTitle>

<div class="@PageShellClass">
    @if (_isLoading)
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando el detalle seleccionado." Compact="true" />
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-3">
            <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">No pudimos cargar este detalle</p>
            <p class="text-sm text-[#595c5d]">@_errorMessage</p>
            <a href="/categorias" class="inline-flex items-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">Ver categorías</a>
        </section>
    }
    else if (IsPartnerStore && _partnerProfile is not null && IsServiceCompanyStore)
    {
        <PartnerServiceStorefront Profile="_partnerProfile"
                                 ExploreBackHref="@PartnerExploreBackHref"
                                 ConsultHref="@PartnerConsultHref" />
    }
    else if (IsPartnerStore && _partnerProfile is not null)
    {
        var store = _partnerProfile.Partner;
        var productCount = _partnerProfile.Products?.Count ?? 0;
        var serviceCount = _partnerProfile.Services?.Count ?? 0;
        <div class="space-y-8 rounded-3xl bg-[#f7f5f0] p-4 pb-10 sm:p-6 sm:pb-10">
            <section class="group relative overflow-hidden rounded-3xl min-h-[500px] sm:min-h-[560px] shadow-[0_24px_60px_-20px_rgba(0,0,0,0.25)]">
                <div class="pointer-events-none absolute inset-0">
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="@StorefrontBannerStyle"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                </div>

                <!-- Top bar -->
                <div class="relative z-10 flex items-center justify-between p-6 sm:p-8">
                    <a href="@PartnerExploreBackHref" class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-semibold text-white backdrop-blur hover:bg-white/20 transition-colors">
                        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                        Volver a explorar
                    </a>
                    <div class="flex items-center gap-2">
                        <SharePublicLink RelativePath="@($"/buyer/detail/partner/{store.Id}")"
                                         Title="@store.Name"
                                         OpenAbove="false"
                                         ButtonClass="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 p-2.5 text-white backdrop-blur hover:bg-white/20 transition-colors" />
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-white backdrop-blur">
                            <span class="material-symbols-outlined text-[#a7f255] text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                            Verificado
                        </span>
                    </div>
                </div>

                <!-- Bottom hero content -->
                <div class="relative z-10 flex flex-col justify-end p-6 sm:p-10 pt-0 min-h-[400px]">
                    <!-- Logo + Name -->
                    <div class="flex flex-wrap items-end gap-5 mb-6">
                        <div class="rounded-2xl border border-white/20 bg-white/10 p-3 backdrop-blur shadow-xl shrink-0">
                            <PartnerBrandMark LogoUrl="@store.LogoUrl" PartnerName="@store.Name" Size="xl" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                <span class="rounded-full bg-[#3b6700] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#d9ffad]">@PartnerTypeEyebrow(store.Type)</span>
                            </div>
                            <h1 class="text-4xl font-black leading-[1.05] tracking-[-0.04em] text-white sm:text-5xl lg:text-[56px]">@store.Name</h1>
                            @if (!string.IsNullOrWhiteSpace(store.OfferLabel))
                            {
                                <p class="mt-2 text-base font-medium text-white/80">@store.OfferLabel</p>
                            }
                            <div class="mt-3 flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(store.CategoryName))
                                {
                                    <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white ring-1 ring-white/20 backdrop-blur">@store.CategoryName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(store.SubcategoryName))
                                {
                                    <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white ring-1 ring-white/20 backdrop-blur">@store.SubcategoryName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Stats + CTAs row -->
                    <div class="flex flex-col gap-5 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex flex-wrap gap-3">
                            <div class="rounded-xl border border-white/15 bg-white/10 px-5 py-2.5 text-center backdrop-blur">
                                <p class="text-xl font-black text-white">@productCount</p>
                                <p class="text-[10px] font-bold uppercase tracking-wide text-white/60">Productos</p>
                            </div>
                            <div class="rounded-xl border border-white/15 bg-white/10 px-5 py-2.5 text-center backdrop-blur">
                                <p class="text-xl font-black text-white">@serviceCount</p>
                                <p class="text-[10px] font-bold uppercase tracking-wide text-white/60">Servicios</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-3">
                            <a href="#tienda-comercio" class="inline-flex items-center gap-2 rounded-full bg-[#a7f255] px-7 py-3.5 text-sm font-bold text-[#1a2e0b] shadow-xl shadow-[#a7f255]/20 hover:brightness-105 active:scale-95 transition-all">
                                <span class="material-symbols-outlined text-[18px]">storefront</span>
                                Ver tienda
                            </a>
                            @if (!string.IsNullOrWhiteSpace(PartnerConsultHref))
                            {
                                <a href="@PartnerConsultHref" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-7 py-3.5 text-sm font-bold text-white backdrop-blur hover:bg-white/20 active:scale-95 transition-all">
                                    <span class="material-symbols-outlined text-[18px]">chat_bubble</span>
                                    @L.T("inbox.cta.consult")
                                </a>
                            }
                            @if (AuthState.IsPersonalAccount)
                            {
                                <button type="button" @onclick="HandlePartnerFollowToggled" disabled="@_partnerFollowBusy"
                                        class="inline-flex items-center gap-2 rounded-full border px-6 py-3.5 text-sm font-bold text-white backdrop-blur transition-all disabled:opacity-60 active:scale-95"
                                        style="@(_isFollowingPartner ? "border-color:rgba(167,242,85,0.7);background:rgba(167,242,85,0.15)" : "border-color:rgba(255,255,255,0.25);background:rgba(255,255,255,0.1)")">
                                    <span class="material-symbols-outlined text-[18px]">@(_isFollowingPartner ? "how_to_reg" : "person_add")</span>
                                    @(_isFollowingPartner ? "Siguiendo" : "Seguir")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <PartnerContactSummary Address="@store.Address"
                                   Phone="@store.Phone"
                                   Email="@store.Email" />

            @if (ProfileWebLinksHelper.HasAny(PartnerStoreWebLinks))
            {
                <ProfileWebLinksDisplay Links="@PartnerStoreWebLinks" />
            }

            <section id="tienda-comercio" class="scroll-mt-24 space-y-6 rounded-3xl border border-[#ebe7df] bg-white p-5 shadow-[0_12px_40px_-24px_rgba(0,0,0,0.1)] sm:p-8">
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">Catálogo</p>
                    <h2 class="mt-1 text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Productos y servicios</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-[#595c5d]">Elegí una categoría para filtrar o recorre todo el listado. Cada tarjeta lleva al detalle para comprar o reservar.</p>
                </div>

                @if (PartnerCategoryKeys.Count > 0)
                {
                    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Categorías">
                        <button type="button" class="@PartnerFilterChipClass(_partnerCategoryFilter is null)" @onclick="() => SetPartnerCategoryFilter(null)">Todo</button>
                        @foreach (var cat in PartnerCategoryKeys)
                        {
                            <button type="button" class="@PartnerFilterChipClass(_partnerCategoryFilter == cat)" @onclick="() => SetPartnerCategoryFilter(cat)">@cat</button>
                        }
                    </div>
                }

                @if (FilteredStoreProducts.Count > 0)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Productos</h3>
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                            @foreach (var product in FilteredStoreProducts)
                            {
                                <a href="/buyer/detail/product/@product.Id" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#e3e0d8] bg-white shadow-[0_6px_32px_-18px_rgba(0,0,0,0.12)] transition hover:-translate-y-1 hover:border-[#a7f255]/70 hover:shadow-xl">
                                    <div class="relative h-44 bg-cover bg-center" style="@ProductCardBackground(product)">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0"></div>
                                        <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#325800]">@StoreCategoryLabel(product.Category)</span>
                                    </div>
                                    <div class="flex flex-1 flex-col p-5">
                                        <p class="text-base font-bold leading-snug text-[#2c2f30] group-hover:text-[#3b6700]">@product.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-[#595c5d]">@product.Description</p>
                                        }
                                        else
                                        {
                                            <p class="mt-2 min-h-[3.75rem] text-sm italic text-[#a8acad]">Sin descripción breve aún.</p>
                                        }
                                        <p class="mt-4 border-t border-[#f0ede6] pt-3 text-lg font-black text-[#3b6700]">@FormatMoney(product.Price, product.Currency)</p>
                                        <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[#3b6700]">Comprar <span class="material-symbols-outlined text-sm">chevron_right</span></span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (FilteredStoreServices.Count > 0)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Servicios</h3>
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                            @foreach (var service in FilteredStoreServices)
                            {
                                <a href="/buyer/detail/service/@service.Id" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#e3e0d8] bg-white shadow-[0_6px_32px_-18px_rgba(0,0,0,0.12)] transition hover:-translate-y-1 hover:border-[#a7f255]/70 hover:shadow-xl">
                                    <div class="relative h-40 bg-cover bg-center" style="@ServiceCardBackground(service)">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>
                                        <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#325800]">@StoreCategoryLabel(service.Category)</span>
                                    </div>
                                    <div class="flex flex-1 flex-col p-5">
                                        <p class="text-base font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@service.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-[#595c5d]">@service.Description</p>
                                        }
                                        else
                                        {
                                            <p class="mt-2 min-h-[3.75rem] text-sm italic text-[#a8acad]">Sin descripción breve aún.</p>
                                        }
                                        <p class="mt-2 text-xs font-bold uppercase tracking-wide text-[#7b8081]">@service.DurationMinutes min</p>
                                        <p class="mt-3 border-t border-[#f0ede6] pt-3 text-lg font-black text-[#3b6700]">@FormatMoney(service.Price, service.Currency)</p>
                                        <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[#3b6700]">Reservar <span class="material-symbols-outlined text-sm">chevron_right</span></span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (store.Type == "C" && _partnerProfile.Professionals is { Count: > 0 } team)
                {
                    <div class="space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-[#3b6700]">Equipo</h3>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            @foreach (var professional in team)
                            {
                                <a href="/buyer/detail/professional/@professional.Id" class="flex flex-col gap-2 rounded-3xl border border-[#e8eaec] bg-[#f9faf8] p-5 transition hover:border-[#a7f255]">
                                    <p class="text-lg font-bold text-[#2c2f30]">@professional.Name</p>
                                    <p class="text-sm font-semibold text-[#3b6700]">@professional.Specialty</p>
                                    @if (!string.IsNullOrWhiteSpace(professional.Bio))
                                    {
                                        <p class="max-h-10 overflow-hidden text-sm text-[#595c5d]">@professional.Bio</p>
                                    }
                                    <span class="text-xs font-bold text-[#3b6700]">Ver perfil →</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (FilteredStoreProducts.Count == 0 && FilteredStoreServices.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-[#dadddf] bg-[#faf8f3] px-5 py-8 text-center">
                        <p class="text-sm font-medium text-[#2c2f30]">Aún no hay productos o servicios publicados con este criterio.</p>
                        <p class="mt-1 text-sm text-[#7b8081]">Si elegiste una categoría, probá con &quot;Todo&quot; o volvé más tarde.</p>
                    </div>
                }
            </section>
        </div>
    }
    else if (IsProductDetail && _productDetail is not null)
    {
        <ProductOfferingDetail Product="_productDetail"
                               PartnerLogoUrl="@_productDetail.PartnerLogoUrl"
                               PartnerName="@_productDetail.PartnerName"
                               PrimaryCtaHref="@_primaryCtaHref"
                               PrimaryCtaLabel="@_primaryCtaLabel"
                               ConsultHref="@_consultHref"
                               SecondaryCtaHref="@_secondaryCtaHref"
                               SecondaryCtaLabel="@_secondaryCtaLabel"
                               PartnerHref="@( _productDetail.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{_productDetail.PartnerId}" : null)"
                               ShareRelativePath="@($"/buyer/detail/product/{_productDetail.Id}")"
                               ShareTitle="@_productDetail.Name"
                               Facts="@ProductOfferingFacts"
                               ShowAddToCart="_showAddToCart"
                               AddToCartBusy="_addingToCart"
                               CartStatusMessage="@_cartStatusMessage"
                               CartAdded="_cartAdded"
                               CartItemCount="_cartItemCount"
                               OnAddToCart="AddToCartAsync" />
    }
    else if (IsProfessionalDetail && _professionalDetail is not null)
    {
        <ProfessionalPublicProfile Professional="_professionalDetail"
                                   ConsultHref="@_primaryCtaHref"
                                   SharePath="@_shareRelativePath"
                                   IsOwner="@(!string.IsNullOrWhiteSpace(AuthState.Email) && string.Equals(AuthState.Email, _professionalDetail.Email, StringComparison.OrdinalIgnoreCase))"
                                   IsFollowing="@_isFollowingProfessional"
                                   OnFollowToggled="@HandleFollowToggled"
                                   OwnerFollows="@_ownerFollows" />
    }
    else if (IsServiceDetail && _serviceDetail is not null)
    {
        <ServiceOfferingDetail Service="_serviceDetail"
                               PartnerLogoUrl="@_serviceDetail.PartnerLogoUrl"
                               PartnerName="@_serviceDetail.PartnerName"
                               PrimaryCtaHref="@_primaryCtaHref"
                               PrimaryCtaLabel="@_primaryCtaLabel"
                               ConsultHref="@_consultHref"
                               SecondaryCtaHref="@_secondaryCtaHref"
                               SecondaryCtaLabel="@_secondaryCtaLabel"
                               PartnerHref="@($"/buyer/detail/partner/{_serviceDetail.PartnerId}")"
                               ShareRelativePath="@($"/buyer/detail/service/{_serviceDetail.Id}")"
                               ShareTitle="@_serviceDetail.Name"
                               StatusMessage="@_statusMessage"
                               CtaSubtitle="@_ctaSubtitle"
                               Facts="@ServiceOfferingFacts" />
    }
    else
    {
        <section class="rounded-[2rem] bg-gradient-to-br from-[#f5f6f7] via-white to-[#eff1f2] border border-[#dadddf] px-6 py-8 sm:px-8 sm:py-10">
            <div class="flex flex-col gap-8 lg:flex-row lg:items-stretch lg:justify-between">
                <div class="space-y-3 min-w-0">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@_eyebrow</p>
                        @if (!string.IsNullOrWhiteSpace(_shareRelativePath))
                        {
                            <SharePublicLink RelativePath="@_shareRelativePath"
                                             Title="@_title"
                                             Text="@_subtitle" />
                        }
                    </div>
                    <h1 class="text-3xl sm:text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@_title</h1>
                    <p class="max-w-3xl text-sm text-[#595c5d]">@_subtitle</p>
                    <div class="flex flex-wrap gap-3 pt-2">
                        @foreach (var badge in _badges)
                        {
                            <span class="inline-flex items-center rounded-full bg-white px-4 py-2 text-xs font-bold text-[#325800] border border-[#dadddf]">@badge</span>
                        }
                    </div>
                </div>
                <div class="grid w-full max-w-xl gap-4 md:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)]">
                    <div class="relative min-h-[220px] overflow-hidden rounded-[1.75rem] border border-white bg-[#dadddf] shadow-[0_18px_40px_-28px_rgba(0,0,0,0.4)]">
                        <div class="absolute inset-0 bg-cover bg-center" style="@HeroImageStyle"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-6">
                            <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-white/80">@_heroLabel</p>
                            <p class="mt-2 text-xl font-black tracking-[-0.04em] text-white">@_heroTitle</p>
                        </div>
                    </div>
                    <div class="rounded-[1.75rem] bg-white p-6 shadow-[0_18px_40px_-28px_rgba(0,0,0,0.4)]">
                        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">Acción sugerida</p>
                        <h2 class="mt-3 text-xl font-black tracking-[-0.03em] text-[#2c2f30]">@_primaryCtaLabel</h2>
                        <p class="mt-2 text-sm text-[#595c5d]">@_ctaSubtitle</p>
                        <div class="mt-5 space-y-3">
                            <a href="@_primaryCtaHref" class="block w-full rounded-2xl bg-[#3b6700] px-5 py-3 text-center text-sm font-bold text-[#d9ffad]">@_primaryCtaLabel</a>
                            @if (_showAddToCart)
                            {
                                <button type="button"
                                        class="flex w-full items-center justify-center gap-2 rounded-2xl bg-[#d9ffad] px-5 py-3 text-center text-sm font-bold text-[#3b6700] disabled:opacity-60"
                                        disabled="@_addingToCart"
                                        @onclick="AddToCartAsync">
                                    <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                                    @(_addingToCart ? "..." : L.T("buyer.cart.add"))
                                </button>
                                @if (!string.IsNullOrWhiteSpace(_cartStatusMessage))
                                {
                                    <p class="text-xs text-[#61897c]">@_cartStatusMessage</p>
                                }
                                @if (_cartAdded)
                                {
                                    <a href="/buyer/cart" class="block w-full rounded-2xl border border-[#3b6700] px-5 py-3 text-center text-sm font-bold text-[#3b6700]">
                                        @(_cartItemCount > 0 ? string.Format(L.T("buyer.cart.viewWithCount"), _cartItemCount) : L.T("buyer.cart.view"))
                                    </a>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(_secondaryCtaLabel))
                            {
                                <a href="@_secondaryCtaHref" class="block w-full rounded-2xl border border-[#dadddf] px-5 py-3 text-center text-sm font-bold text-[#2c2f30]">@_secondaryCtaLabel</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(300px,1fr)]">
            <section class="space-y-6">
                <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">Resumen</p>
                    <div class="space-y-4">
                        <p class="text-base leading-7 text-[#2c2f30]">@_detailLine1</p>
                        <p class="text-sm leading-7 text-[#595c5d]">@_detailLine2</p>
                    </div>
                    @if (ProfileWebLinksHelper.HasAny(_displayWebLinks))
                    {
                        <ProfileWebLinksDisplay Links="@_displayWebLinks" RootClass="mt-6 border-0 bg-transparent p-0" />
                    }
                    @if (_detailFacts.Count > 0)
                    {
                        <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
                            @foreach (var fact in _detailFacts)
                            {
                                <div class="rounded-3xl bg-[#f5f6f7] px-5 py-4">
                                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@fact.Label</p>
                                    <p class="mt-2 text-sm font-black tracking-[-0.03em] text-[#2c2f30]">@fact.Value</p>
                                </div>
                            }
                        </div>
                    }
                </article>
            </section>

            <aside class="space-y-6">
                <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-4">Estado actual</p>
                    <div class="space-y-3 text-sm text-[#595c5d]">
                        <p>@_statusMessage</p>
                    </div>
                </article>
                <article class="rounded-[2rem] bg-[#eff1f2] p-8">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-4">Siguiente paso</p>
