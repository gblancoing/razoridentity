        _secondaryCtaHref = service.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{service.PartnerId}" : null;
        _heroImageUrl = ResolveHeroImage(service.Category, service.Name);
        _heroLabel = "Servicio agendable";
        _heroTitle = service.Category ?? "Disponible para reserva";
        AddBadge(service.Category);
        AddBadge($"{service.DurationMinutes} min");
        AddFact("Categoría", service.Category ?? "Sin categoría informada");
        AddFact("Duración", $"{service.DurationMinutes} minutos");
        AddFact("Tarifa", FormatMoney(service.Price, service.Currency));
        AddFact("Estado", service.IsActive ? "Agenda disponible" : "Agenda pausada");
        _serviceDetail = service;
    }

    private async Task LoadPartnerAsync(Guid id)
    {
        _partnerProfile = await BuyerApi.GetPartnerProfileAsync(id);
        if (_partnerProfile is null)
        {
            _errorMessage = AuthState.IsAuthenticated
                ? "Negocio no encontrado o no tenés permiso para ver esta ficha. Si aún no publicaste, usá «Vista previa» desde tu perfil Empresa."
                : "Negocio no encontrado o no está publicado en el portal.";
            return;
        }

        var partner = _partnerProfile.Partner;
        var featuredService = _partnerProfile.Services?.FirstOrDefault();
        var featuredProfessional = _partnerProfile.Professionals?.FirstOrDefault();
        var featuredProduct = _partnerProfile.Products?.FirstOrDefault();
        _eyebrow = "Negocio";
        _title = partner.Name ?? _title;
        _partnerPageTitle = $"{_title} · ComunaClic";
        _subtitle = "Explorá el catálogo, elegí por categoría y comprá o reservá con confianza.";
        _detailLine1 = string.IsNullOrWhiteSpace(partner.Address)
            ? "Este negocio ya está activo en el portal y preparado para conversión."
            : partner.Address!;
        _detailLine2 = string.Join(" · ", new[]
        {
            partner.CategoryName,
            partner.SubcategoryName,
            partner.OfferLabel
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        _statusMessage = "Perfil público disponible para consulta y conversión.";
        _ctaSubtitle = partner.Type switch
        {
            "B" => "Explora los servicios activos y reserva la mejor alternativa.",
            "C" => "Revisa el perfil profesional y toma contacto desde el portal.",
            _ => "Explora los productos activos y continúa la compra."
        };
        _primaryCtaLabel = partner.Type switch
        {
            "B" => "Ver servicios",
            "C" => "Ver profesionales",
            _ => "Ver productos"
        };
        _primaryCtaHref = partner.Type switch
        {
            "B" when featuredService is not null => $"/buyer/detail/service/{featuredService.Id}",
            "C" when featuredProfessional is not null => $"/buyer/detail/professional/{featuredProfessional.Id}",
            _ when featuredProduct is not null => $"/buyer/detail/product/{featuredProduct.Id}",
            "B" => "/services",
            "C" => "/professionals",
            _ => "/products"
        };
        _secondaryCtaLabel = "Explorar categorías";
        _secondaryCtaHref = "/categorias";
        _heroImageUrl = ResolveHeroImage(partner.CategoryName, partner.SubcategoryName ?? partner.Name);
        _heroLabel = partner.Type switch
        {
            "B" => "Negocio de servicios",
            "C" => "Perfil profesional",
            _ => "Negocio local"
        };
        _heroTitle = partner.SubcategoryName ?? partner.CategoryName ?? partner.OfferLabel ?? "Oferta publicada";
        AddBadge(partner.CategoryName);
        AddBadge(partner.SubcategoryName);
        AddBadge(partner.OfferLabel);
        AddFact("Estado público", "Publicado");
        AddFact("Tipo de oferta", partner.OfferLabel ?? "No informado");
        AddFact("Categoría", partner.CategoryName ?? "Sin categoría informada");
        AddFact("Subcategoría", partner.SubcategoryName ?? "Sin subcategoría informada");
    }

    private async Task LoadProfessionalAsync(Guid id)
    {
        var professional = await BuyerApi.GetProfessionalAsync(id);
        if (professional is null)
        {
            _errorMessage = "Profesional no encontrado.";
            return;
        }

        _eyebrow = "Profesional";
        _title = professional.Name ?? _title;
        _partnerPageTitle = $"{_title} · ComunaClic";
        _subtitle = "Perfil profesional visible para contacto y generación de leads.";
        _detailLine1 = professional.Specialty ?? "Sin especialidad informada.";
        _detailLine2 = professional.Bio ?? "Sin biografía disponible.";
        _statusMessage = "Profesional listo para contacto.";
        _ctaSubtitle = "Genera un lead o revisa más profesionales similares.";
        _primaryCtaLabel = AuthState.IsPersonalAccount ? "Contactar" : "Inicia sesión para contactar";
        _primaryCtaHref = RequirePersonalBuyerSession($"/buyer/contact?professionalId={id}");
        _secondaryCtaLabel = "Ver más profesionales";
        _secondaryCtaHref = "/professionals";
        _heroImageUrl = ResolveHeroImage(professional.Specialty, professional.Name);
        _heroLabel = professional.IsVerified ? "Profesional verificado" : "Profesional disponible";
        _heroTitle = professional.Specialty ?? "Disponible para contacto";
        AddBadge(professional.Specialty);
        AddBadge(professional.IsVerified ? "Verificado" : null);
        AddFact("Especialidad", professional.Specialty ?? "Sin especialidad informada");
        AddFact("Verificación", professional.IsVerified ? "Perfil verificado" : "Pendiente de verificación");
        AddFact("Estado", professional.IsActive ? "Disponible" : "No disponible");
        if (!string.IsNullOrWhiteSpace(professional.Email))
        {
            AddFact("Email", professional.Email);
        }

        if (!string.IsNullOrWhiteSpace(professional.Phone))
        {
            AddFact("Teléfono", professional.Phone);
        }
    }

    private void AddBadge(string? badge)
    {
        if (!string.IsNullOrWhiteSpace(badge))
        {
            _badges.Add(badge);
        }
    }

    private void AddFact(string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            _detailFacts.Add(new DetailFact(label, value));
        }
    }

    private static IReadOnlyList<string> DescriptionParagraphs(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Array.Empty<string>();
        }
        var t = text.Trim();
        var parts = t.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return new[] { t };
        }
        var list = new List<string>(parts.Length);
        foreach (var p in parts)
        {
            var s = p.Trim();
            if (s.Length > 0)
            {
                list.Add(s);
            }
        }
        return list.Count > 0 ? list : new[] { t };
    }

    private static string ResolveHeroImage(string? codeOrCategory, string? name)
        => CategoryVisualService.ResolveImage(codeOrCategory, name)
            ?? "_content/ComunaClick.SharedUI/logo.png";

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";

    private string RequirePersonalBuyerSession(string targetPath)
        => AuthState.IsPersonalAccount
            ? targetPath
            : $"/login?returnUrl={Uri.EscapeDataString(targetPath)}";

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private string? ResolveFavoriteType()
    {
        if (!Id.HasValue || string.IsNullOrWhiteSpace(Type))
        {
            return null;
        }

        return Type.Trim().ToLowerInvariant() switch
        {
            "partner" => "partner",
            "product" => "product",
            "service" => "service",
            "professional" => "professional",
            _ => null
        };
    }

    private async Task RefreshFavoriteStateAsync()
    {
        var favoriteType = ResolveFavoriteType();
        if (!Id.HasValue || favoriteType is null || !AuthState.IsPersonalAccount)
        {
            _isFavorite = false;
            _favoriteId = null;
            return;
        }

        try
        {
            var favorites = await BuyerApi.GetFavoritesAsync(favoriteType);
            var item = favorites?.FirstOrDefault(x => x.TargetId == Id.Value);
            _isFavorite = item is not null;
            _favoriteId = item?.Id;
        }
        catch
        {
            _isFavorite = false;
            _favoriteId = null;
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (!AuthState.IsPersonalAccount)
        {
            _favoriteMessage = "Inicia sesión con cuenta personal para usar favoritos.";
            return;
        }

        if (!Id.HasValue || ResolveFavoriteType() is not { } favoriteType)
        {
            return;
        }

        _favoriteMessage = null;
        try
        {
            if (_isFavorite && _favoriteId.HasValue)
            {
                await BuyerApi.DeleteFavoriteAsync(_favoriteId.Value);
                _isFavorite = false;
                _favoriteId = null;
                _favoriteMessage = "Quitado de favoritos.";
                return;
            }

            var created = await BuyerApi.CreateFavoriteAsync(new BuyerModels.BuyerFavoriteCreateRequest(
                favoriteType,
                Id.Value,
                AuthState.TenantId));

            _isFavorite = created is not null;
            _favoriteId = created?.Id;
            _favoriteMessage = created is null ? "No pudimos guardar este favorito." : "Guardado en favoritos.";
        }
        catch
        {
            _favoriteMessage = "No pudimos actualizar favoritos en este momento.";
        }
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
        Navigation.LocationChanged -= OnDetailLocationChanged;
    }

    private sealed record DetailFact(string Label, string Value);
}
