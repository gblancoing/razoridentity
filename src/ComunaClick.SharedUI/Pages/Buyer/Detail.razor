    /// <summary>Vuelve a la categoría desde la que se abrió el comercio (<c>?return=</c>), si vino; si no, a partir del código de categoría del perfil; último recurso <c>/categorias</c>.</summary>
    private string PartnerExploreBackHref => BuildPartnerExploreBackHref();

    private string BuildPartnerExploreBackHref()
    {
        var fromQuery = GetSanitizedPartnerReturnFromQuery();
        if (!string.IsNullOrEmpty(fromQuery))
        {
            return fromQuery;
        }

        if (_partnerProfile?.Partner is { } p && !string.IsNullOrWhiteSpace(p.CategoryCode))
        {
            var code = p.CategoryCode.Trim();
            var slug = CategoryVisualService.ToSlug(code, p.CategoryName);
            return $"/categorias/{slug}?code={Uri.EscapeDataString(code)}#categoria-mapa-cercano";
        }

        return "/categorias";
    }

    private string? GetSanitizedPartnerReturnFromQuery()
    {
        var raw = ReadFirstQueryValue(Navigation.Uri, "return")
            ?? ReadFirstQueryValue(Navigation.Uri, "returnUrl");
        return SanitizePartnerExploreReturnPath(raw);
    }

    private static string? ReadFirstQueryValue(string uriString, string key)
    {
        if (!Uri.TryCreate(uriString, UriKind.Absolute, out var u))
        {
            return null;
        }
        var query = u.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 0)
            {
                continue;
            }
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }
        return null;
    }

    /// <summary>Solo URLs relativas al catálogo (misma app); evita redirecciones abiertas.</summary>
    private static string? SanitizePartnerExploreReturnPath(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }
        var t = raw.Trim();
        if (t.Length > 2048)
        {
            return null;
        }
        if (t.Contains("..", StringComparison.Ordinal)
            || t.Contains("://", StringComparison.Ordinal)
            || t.StartsWith("//", StringComparison.Ordinal))
        {
            return null;
        }
        if (t[0] != '/')
        {
            return null;
        }
        if (t.Equals("/categorias", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias/", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias?", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("/categorias#", StringComparison.OrdinalIgnoreCase))
        {
            return t;
        }
        return null;
    }

