@page "/buyer/detail"
@page "/buyer/detail/{Type}/{Id:guid}"
@layout BuyerLayout
@using BuyerModels = ComunaClick.Shared.Api.Buyer
@using ComunaClick.SharedUI.Services
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@implements IDisposable

<PageTitle>@L.T("buyer.detail.title")</PageTitle>

<div class="space-y-8">
    <section class="rounded-[2rem] bg-gradient-to-br from-[#f5f6f7] via-white to-[#eff1f2] border border-[#dadddf] px-8 py-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-stretch lg:justify-between">
            <div class="space-y-3">
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@_eyebrow</p>
                <h1 class="text-4xl font-black tracking-[-0.04em] text-[#2c2f30]">@_title</h1>
                <p class="max-w-3xl text-sm text-[#595c5d]">@_subtitle</p>
                <div class="flex flex-wrap gap-3 pt-2">
                    @foreach (var badge in _badges)
                    {
                        <span class="inline-flex items-center rounded-full bg-white px-4 py-2 text-xs font-bold text-[#325800] border border-[#dadddf]">@badge</span>
                    }
                </div>
            </div>
            <div class="grid w-full max-w-xl gap-4 md:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)]">
                <div class="relative min-h-[220px] overflow-hidden rounded-[1.75rem] border border-white bg-[#dadddf] shadow-[0_18px_40px_-28px_rgba(0,0,0,0.4)]">
                    <div class="absolute inset-0 bg-cover bg-center" style="@HeroImageStyle"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6">
                        <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-white/80">@_heroLabel</p>
                        <p class="mt-2 text-xl font-black tracking-[-0.04em] text-white">@_heroTitle</p>
                    </div>
                </div>
                <div class="rounded-[1.75rem] bg-white p-6 shadow-[0_18px_40px_-28px_rgba(0,0,0,0.4)]">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">Acción sugerida</p>
                    <h2 class="mt-3 text-xl font-black tracking-[-0.03em] text-[#2c2f30]">@_primaryCtaLabel</h2>
                    <p class="mt-2 text-sm text-[#595c5d]">@_ctaSubtitle</p>
                    <div class="mt-5 space-y-3">
                        <a href="@_primaryCtaHref" class="block w-full rounded-2xl bg-[#3b6700] px-5 py-3 text-center text-sm font-bold text-[#d9ffad]">
                            @_primaryCtaLabel
                        </a>
                        @if (!string.IsNullOrWhiteSpace(_secondaryCtaLabel))
                        {
                            <a href="@_secondaryCtaHref" class="block w-full rounded-2xl border border-[#dadddf] px-5 py-3 text-center text-sm font-bold text-[#2c2f30]">
                                @_secondaryCtaLabel
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (_isLoading)
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos cargando el detalle seleccionado." Compact="true" />
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] text-center space-y-3">
            <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">No pudimos cargar este detalle</p>
            <p class="text-sm text-[#595c5d]">@_errorMessage</p>
            <a href="/buyer" class="inline-flex items-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">Volver al portal</a>
        </section>
    }
    else
    {
        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)] gap-6">
            <section class="space-y-6">
                <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">Resumen</p>
                    <div class="space-y-4">
                        <p class="text-base leading-7 text-[#2c2f30]">@_detailLine1</p>
                        <p class="text-sm leading-7 text-[#595c5d]">@_detailLine2</p>
                    </div>
                    @if (_detailFacts.Count > 0)
                    {
                        <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
                            @foreach (var fact in _detailFacts)
                            {
                                <div class="rounded-3xl bg-[#f5f6f7] px-5 py-4">
                                    <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@fact.Label</p>
                                    <p class="mt-2 text-sm font-black tracking-[-0.03em] text-[#2c2f30]">@fact.Value</p>
                                </div>
                            }
                        </div>
                    }
                </article>

                @if (_partnerProfile is not null)
                {
                    <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                            <div>
                                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-3">Perfil público</p>
                                <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Información del negocio</h2>
                            </div>
                            <div class="grid gap-3 text-sm text-[#595c5d]">
                                @if (!string.IsNullOrWhiteSpace(_partnerProfile.Partner.Address))
                                {
                                    <p><span class="font-bold text-[#2c2f30]">Dirección:</span> @_partnerProfile.Partner.Address</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(_partnerProfile.Partner.Phone))
                                {
                                    <p><span class="font-bold text-[#2c2f30]">Teléfono:</span> @_partnerProfile.Partner.Phone</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(_partnerProfile.Partner.Email))
                                {
                                    <p><span class="font-bold text-[#2c2f30]">Email:</span> @_partnerProfile.Partner.Email</p>
                                }
                            </div>
                        </div>
                    </article>

                    @if (_partnerProfile.Products?.Count > 0)
                    {
                        <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                            <div class="flex items-center justify-between gap-4 mb-6">
                                <div>
                                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-2">Oferta</p>
                                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Productos disponibles</h2>
                                </div>
                                <a href="/products" class="text-sm font-bold text-[#3b6700]">Ver más</a>
                            </div>
                            <div class="grid gap-4">
                                @foreach (var product in _partnerProfile.Products!)
                                {
                                    <article class="rounded-3xl bg-[#f5f6f7] px-5 py-5">
                                        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                                            <div class="space-y-2">
                                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@product.Name</p>
                                                <p class="text-sm text-[#595c5d]">@product.Description</p>
                                                <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#7b8081]">@product.Category</p>
                                            </div>
                                            <div class="text-left lg:text-right">
                                                <p class="text-xl font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(product.Price, product.Currency)</p>
                                                <a href="/buyer/detail/product/@product.Id" class="mt-3 inline-flex rounded-2xl border border-[#dadddf] px-4 py-2 text-sm font-bold text-[#2c2f30]">Ver producto</a>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </article>
                    }

                    @if (_partnerProfile.Services?.Count > 0)
                    {
                        <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                            <div class="flex items-center justify-between gap-4 mb-6">
                                <div>
                                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-2">Oferta</p>
                                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Servicios disponibles</h2>
                                </div>
                                <a href="/services" class="text-sm font-bold text-[#3b6700]">Ver más</a>
                            </div>
                            <div class="grid gap-4">
                                @foreach (var service in _partnerProfile.Services!)
                                {
                                    <article class="rounded-3xl bg-[#f5f6f7] px-5 py-5">
                                        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                                            <div class="space-y-2">
                                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@service.Name</p>
                                                <p class="text-sm text-[#595c5d]">@service.Description</p>
                                                <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#7b8081]">@service.Category · @service.DurationMinutes min</p>
                                            </div>
                                            <div class="text-left lg:text-right">
                                                <p class="text-xl font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(service.Price, service.Currency)</p>
                                                <a href="/buyer/detail/service/@service.Id" class="mt-3 inline-flex rounded-2xl border border-[#dadddf] px-4 py-2 text-sm font-bold text-[#2c2f30]">Ver servicio</a>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </article>
                    }

                    @if (_partnerProfile.Professionals?.Count > 0)
                    {
                        <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                            <div class="flex items-center justify-between gap-4 mb-6">
                                <div>
                                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-2">Equipo</p>
                                    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">Profesionales disponibles</h2>
                                </div>
                                <a href="/professionals" class="text-sm font-bold text-[#3b6700]">Ver más</a>
                            </div>
                            <div class="grid gap-4">
                                @foreach (var professional in _partnerProfile.Professionals!)
                                {
                                    <article class="rounded-3xl bg-[#f5f6f7] px-5 py-5">
                                        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                                            <div class="space-y-2">
                                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@professional.Name</p>
                                                <p class="text-sm font-bold text-[#325800]">@professional.Specialty</p>
                                                <p class="text-sm text-[#595c5d]">@professional.Bio</p>
                                            </div>
                                            <div class="text-left lg:text-right space-y-2 text-sm text-[#595c5d]">
                                                @if (!string.IsNullOrWhiteSpace(professional.Email))
                                                {
                                                    <p>@professional.Email</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(professional.Phone))
                                                {
                                                    <p>@professional.Phone</p>
                                                }
                                                <a href="/buyer/detail/professional/@professional.Id" class="inline-flex rounded-2xl border border-[#dadddf] px-4 py-2 text-sm font-bold text-[#2c2f30]">Ver perfil</a>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </article>
                    }
                }
            </section>

            <aside class="space-y-6">
                <article class="rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-4">Estado actual</p>
                    <div class="space-y-3 text-sm text-[#595c5d]">
                        <p>@_statusMessage</p>
                        @if (_partnerProfile is not null)
                        {
                            <p><span class="font-bold text-[#2c2f30]">Categoría:</span> @(_partnerProfile.Partner.CategoryName ?? "Sin categoría")</p>
                            <p><span class="font-bold text-[#2c2f30]">Subcategoría:</span> @(_partnerProfile.Partner.SubcategoryName ?? "Sin subcategoría")</p>
                            <p><span class="font-bold text-[#2c2f30]">Oferta:</span> @(_partnerProfile.Partner.OfferLabel ?? "Oferta publicada")</p>
                        }
                    </div>
                </article>

                <article class="rounded-[2rem] bg-[#eff1f2] p-8">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081] mb-4">Siguiente paso</p>
                    <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@_ctaSubtitle</p>
                    <p class="mt-3 text-sm text-[#595c5d]">Usa el acceso directo de la ficha para completar compra, reserva o contacto sin perder contexto del negocio.</p>
                </article>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public string? Type { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private bool _isLoading;
    private string? _errorMessage;
    private string _eyebrow = "Detalle";
    private string _title = "Detalle";
    private string _subtitle = string.Empty;
    private string _detailLine1 = string.Empty;
    private string _detailLine2 = string.Empty;
    private string _statusMessage = "Selecciona un elemento para ver detalle.";
    private string _ctaSubtitle = "Revisa esta oferta y continúa la acción que corresponde.";
    private string _primaryCtaLabel = "Ver detalle";
    private string _primaryCtaHref = "/buyer";
    private string? _secondaryCtaLabel;
    private string? _secondaryCtaHref;
    private string _heroImageUrl = "_content/ComunaClick.SharedUI/logo.png";
    private string _heroLabel = "ComunaClic";
    private string _heroTitle = "Explora la oferta publicada";
    private readonly List<string> _badges = new();
    private readonly List<DetailFact> _detailFacts = new();
    private BuyerModels.PartnerProfileResponse? _partnerProfile;

    private string HeroImageStyle => $"background-image: url('{_heroImageUrl}')";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await AuthState.InitializeAsync();
        }
        catch (InvalidOperationException)
        {
            // JS interop may not be available during prerender; fall back to current in-memory state.
        }

        _partnerProfile = null;
        _badges.Clear();
        _detailFacts.Clear();
        _errorMessage = null;

        _title = L.T("buyer.detail.heading");
        _subtitle = L.T("buyer.detail.subtitle");
        _detailLine1 = L.T("buyer.detail.info1");
        _detailLine2 = L.T("buyer.detail.info2");
        _statusMessage = "Selecciona un elemento para ver detalle.";
        _ctaSubtitle = "Revisa esta oferta y continúa la acción que corresponde.";
        _primaryCtaLabel = "Ver detalle";
        _primaryCtaHref = "/buyer";
        _secondaryCtaLabel = null;
        _secondaryCtaHref = null;
        _eyebrow = "Detalle";
        _heroImageUrl = "_content/ComunaClick.SharedUI/logo.png";
        _heroLabel = "ComunaClic";
        _heroTitle = "Explora la oferta publicada";

        if (Id is null || string.IsNullOrWhiteSpace(Type))
        {
            return;
        }

        _isLoading = true;
        try
        {
            switch (Type.Trim().ToLowerInvariant())
            {
                case "product":
                    await LoadProductAsync(Id.Value);
                    break;
                case "service":
                    await LoadServiceAsync(Id.Value);
                    break;
                case "partner":
                    await LoadPartnerAsync(Id.Value);
                    break;
                case "professional":
                    await LoadProfessionalAsync(Id.Value);
                    break;
                default:
                    _errorMessage = "Tipo no soportado.";
                    break;
            }
        }
        catch
        {
            _errorMessage = "Error al cargar el detalle seleccionado.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadProductAsync(Guid id)
    {
        var product = await BuyerApi.GetProductAsync(id);
        if (product is null)
        {
            _errorMessage = "Producto no encontrado.";
            return;
        }

        _eyebrow = "Producto";
        _title = product.Name ?? _title;
        _subtitle = "Producto disponible para compra directa dentro del portal.";
        _detailLine1 = product.Description ?? "Sin descripción disponible.";
        _detailLine2 = string.Join(" · ", new[]
        {
            product.Category,
            FormatMoney(product.Price, product.Currency)
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        _statusMessage = "Oferta lista para compra.";
        _ctaSubtitle = "Continúa al checkout o revisa el negocio que publica este producto.";
        _primaryCtaLabel = AuthState.IsPersonalAccount ? "Comprar ahora" : "Inicia sesión para comprar";
        _primaryCtaHref = RequirePersonalBuyerSession($"/buyer/checkout?productId={id}");
        _secondaryCtaLabel = product.PartnerId != Guid.Empty ? "Ver negocio" : null;
        _secondaryCtaHref = product.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{product.PartnerId}" : null;
        _heroImageUrl = ResolveHeroImage(product.Category, product.Name);
        _heroLabel = "Producto destacado";
        _heroTitle = product.Category ?? "Disponible para compra";
        AddBadge(product.Category);
        AddBadge(FormatMoney(product.Price, product.Currency));
        AddFact("Categoría", product.Category ?? "Sin categoría informada");
        AddFact("Precio", FormatMoney(product.Price, product.Currency));
        AddFact("Estado", product.IsActive ? "Disponible" : "No disponible");
        AddFact("Publicado", product.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy"));
    }

    private async Task LoadServiceAsync(Guid id)
    {
        var service = await BuyerApi.GetServiceAsync(id);
        if (service is null)
        {
            _errorMessage = "Servicio no encontrado.";
            return;
        }

        _eyebrow = "Servicio";
        _title = service.Name ?? _title;
        _subtitle = "Servicio disponible para reservar directamente en el portal.";
        _detailLine1 = service.Description ?? "Sin descripción disponible.";
        _detailLine2 = string.Join(" · ", new[]
        {
            service.Category,
            $"{service.DurationMinutes} min",
            FormatMoney(service.Price, service.Currency)
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        _statusMessage = "Servicio listo para reserva.";
        _ctaSubtitle = "Reserva este servicio o revisa el negocio que publica la agenda.";
        _primaryCtaLabel = AuthState.IsPersonalAccount ? "Reservar" : "Inicia sesión para reservar";
        _primaryCtaHref = RequirePersonalBuyerSession($"/buyer/booking?serviceId={id}");
        _secondaryCtaLabel = service.PartnerId != Guid.Empty ? "Ver negocio" : null;
        _secondaryCtaHref = service.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{service.PartnerId}" : null;
        _heroImageUrl = ResolveHeroImage(service.Category, service.Name);
        _heroLabel = "Servicio agendable";
        _heroTitle = service.Category ?? "Disponible para reserva";
        AddBadge(service.Category);
        AddBadge($"{service.DurationMinutes} min");
        AddFact("Categoría", service.Category ?? "Sin categoría informada");
        AddFact("Duración", $"{service.DurationMinutes} minutos");
        AddFact("Tarifa", FormatMoney(service.Price, service.Currency));
        AddFact("Estado", service.IsActive ? "Agenda disponible" : "Agenda pausada");
    }

    private async Task LoadPartnerAsync(Guid id)
    {
        _partnerProfile = await BuyerApi.GetPartnerProfileAsync(id);
        if (_partnerProfile is null)
        {
            _errorMessage = "Negocio no encontrado o no disponible públicamente.";
            return;
        }

        var partner = _partnerProfile.Partner;
        var featuredService = _partnerProfile.Services?.FirstOrDefault();
        var featuredProfessional = _partnerProfile.Professionals?.FirstOrDefault();
        var featuredProduct = _partnerProfile.Products?.FirstOrDefault();
        _eyebrow = "Negocio";
        _title = partner.Name ?? _title;
        _subtitle = "Perfil público del negocio con su información de contacto y oferta activa.";
        _detailLine1 = string.IsNullOrWhiteSpace(partner.Address)
            ? "Este negocio ya está activo en el portal y preparado para conversión."
            : partner.Address!;
        _detailLine2 = string.Join(" · ", new[]
        {
            partner.CategoryName,
            partner.SubcategoryName,
            partner.OfferLabel
        }.Where(x => !string.IsNullOrWhiteSpace(x)));
        _statusMessage = "Perfil público disponible para consulta y conversión.";
        _ctaSubtitle = partner.Type switch
        {
            "B" => "Explora los servicios activos y reserva la mejor alternativa.",
            "C" => "Revisa el perfil profesional y toma contacto desde el portal.",
            _ => "Explora los productos activos y continúa la compra."
        };
        _primaryCtaLabel = partner.Type switch
        {
            "B" => "Ver servicios",
            "C" => "Ver profesionales",
            _ => "Ver productos"
        };
        _primaryCtaHref = partner.Type switch
        {
            "B" when featuredService is not null => $"/buyer/detail/service/{featuredService.Id}",
            "C" when featuredProfessional is not null => $"/buyer/detail/professional/{featuredProfessional.Id}",
            _ when featuredProduct is not null => $"/buyer/detail/product/{featuredProduct.Id}",
            "B" => "/services",
            "C" => "/professionals",
            _ => "/products"
        };
        _secondaryCtaLabel = "Volver al portal";
        _secondaryCtaHref = "/buyer";
        _heroImageUrl = ResolveHeroImage(partner.CategoryName, partner.SubcategoryName ?? partner.Name);
        _heroLabel = partner.Type switch
        {
            "B" => "Negocio de servicios",
            "C" => "Perfil profesional",
            _ => "Negocio local"
        };
        _heroTitle = partner.SubcategoryName ?? partner.CategoryName ?? partner.OfferLabel ?? "Oferta publicada";
        AddBadge(partner.CategoryName);
        AddBadge(partner.SubcategoryName);
        AddBadge(partner.OfferLabel);
        AddFact("Estado público", "Publicado");
        AddFact("Tipo de oferta", partner.OfferLabel ?? "No informado");
        AddFact("Categoría", partner.CategoryName ?? "Sin categoría informada");
        AddFact("Subcategoría", partner.SubcategoryName ?? "Sin subcategoría informada");
    }

    private async Task LoadProfessionalAsync(Guid id)
    {
        var professional = await BuyerApi.GetProfessionalAsync(id);
        if (professional is null)
        {
            _errorMessage = "Profesional no encontrado.";
            return;
        }

        _eyebrow = "Profesional";
        _title = professional.Name ?? _title;
        _subtitle = "Perfil profesional visible para contacto y generación de leads.";
        _detailLine1 = professional.Specialty ?? "Sin especialidad informada.";
        _detailLine2 = professional.Bio ?? "Sin biografía disponible.";
        _statusMessage = "Profesional listo para contacto.";
        _ctaSubtitle = "Genera un lead o revisa más profesionales similares.";
        _primaryCtaLabel = AuthState.IsPersonalAccount ? "Contactar" : "Inicia sesión para contactar";
        _primaryCtaHref = RequirePersonalBuyerSession($"/buyer/contact?professionalId={id}");
        _secondaryCtaLabel = "Ver más profesionales";
        _secondaryCtaHref = "/professionals";
        _heroImageUrl = ResolveHeroImage(professional.Specialty, professional.Name);
        _heroLabel = professional.IsVerified ? "Profesional verificado" : "Profesional disponible";
        _heroTitle = professional.Specialty ?? "Disponible para contacto";
        AddBadge(professional.Specialty);
        AddBadge(professional.IsVerified ? "Verificado" : null);
        AddFact("Especialidad", professional.Specialty ?? "Sin especialidad informada");
        AddFact("Verificación", professional.IsVerified ? "Perfil verificado" : "Pendiente de verificación");
        AddFact("Estado", professional.IsActive ? "Disponible" : "No disponible");
        if (!string.IsNullOrWhiteSpace(professional.Email))
        {
            AddFact("Email", professional.Email);
        }

        if (!string.IsNullOrWhiteSpace(professional.Phone))
        {
            AddFact("Teléfono", professional.Phone);
        }
    }

    private void AddBadge(string? badge)
    {
        if (!string.IsNullOrWhiteSpace(badge))
        {
            _badges.Add(badge);
        }
    }

    private void AddFact(string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            _detailFacts.Add(new DetailFact(label, value));
        }
    }

    private static string ResolveHeroImage(string? codeOrCategory, string? name)
        => CategoryVisualService.ResolveImage(codeOrCategory, name)
            ?? "_content/ComunaClick.SharedUI/logo.png";

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";

    private string RequirePersonalBuyerSession(string targetPath)
        => AuthState.IsPersonalAccount
            ? targetPath
            : $"/login?returnUrl={Uri.EscapeDataString(targetPath)}";

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private sealed record DetailFact(string Label, string Value);
}
