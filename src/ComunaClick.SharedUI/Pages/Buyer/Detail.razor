                $"{service.DurationMinutes} min",
                FormatMoney(service.Price, service.Currency)
            }.Where(x => !string.IsNullOrWhiteSpace(x)))
            : PublicOfferVisuals.CategoryLabel(service.Category);
        _statusMessage = bookable ? L.T("public.offer.status.book") : L.T("public.offer.status.inquiry");
        _ctaSubtitle = bookable ? L.T("public.offer.ctaSubtitle.book") : L.T("public.offer.ctaSubtitle.inquiry");

        var consultHref = service.PartnerId != Guid.Empty
            ? ContactMessageHref(
                $"/account/messages?partnerId={service.PartnerId}&serviceId={id}&subject={Uri.EscapeDataString($"Consulta: {service.Name}")}")
            : null;

        if (bookable)
        {
            _primaryCtaLabel = L.T("public.offer.cta.bookNow");
            _primaryCtaHref = $"/buyer/booking?serviceId={id}";
            _consultHref = consultHref;
        }
        else
        {
            _primaryCtaLabel = L.T("public.offer.cta.consult");
            _primaryCtaHref = consultHref ?? RequirePersonalBuyerSession("/account/messages");
            _consultHref = null; // Ya es el primario
        }

        _secondaryCtaLabel = service.PartnerId != Guid.Empty ? L.T("public.offer.backStore") : null;
        _secondaryCtaHref = service.PartnerId != Guid.Empty ? $"/buyer/detail/partner/{service.PartnerId}" : null;
        _heroImageUrl = PublicOfferVisuals.ResolveImage(service.ImageUrl, service.Category, service.Name, service.ImageUrls);
        var serviceLocation = PublicOfferVisuals.ResolveServiceLocation(service.ServiceAddress, service.PartnerAddress);
        if (!string.IsNullOrWhiteSpace(serviceLocation))
        {
            AddFact(L.T("public.offer.location"), serviceLocation);
        }
        _heroLabel = bookable ? L.T("public.offer.badge.bookable") : L.T("public.offer.badge.inquiry");
        _heroTitle = service.Category ?? _title;
        AddBadge(service.Category);
        if (bookable)
        {
            AddBadge($"{service.DurationMinutes} min");
        }

        AddFact(L.T("public.offer.fact.category"), PublicOfferVisuals.CategoryLabel(service.Category));
        if (bookable)
        {
            AddFact(L.T("public.offer.fact.duration"), $"{service.DurationMinutes} {L.T("public.offer.minutes")}");
            AddFact(L.T("public.offer.fact.price"), FormatMoney(service.Price, service.Currency));
        }
        else
        {
            AddFact(L.T("public.offer.fact.mode"), L.T("public.offer.fact.modeInquiry"));
        }

        AddFact("Estado", service.IsActive
            ? (bookable ? L.T("public.offer.status.book") : L.T("public.offer.status.inquiry"))
            : "Pausado");
        _serviceDetail = service;
    }

