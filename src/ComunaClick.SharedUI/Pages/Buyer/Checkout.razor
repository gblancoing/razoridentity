    private async Task SubmitPersonalCartOrderAsync(Guid partnerId, Guid tenantId)
    {
        if (!TryValidateDelivery(out var deliveryError))
        {
            _statusMessage = deliveryError;
            _statusLevel = "warning";
            return;
        }

        await AuthState.InitializeAsync();
        if (!AuthState.IsPersonalAccount)
        {
            _statusMessage = L.T("buyer.checkout.personalSessionRequired");
            _statusLevel = "warning";
            return;
        }

        if (!Guid.TryParse(CustomerId, out var customerId))
        {
            await ResolveCustomerIdAsync();
            if (!Guid.TryParse(CustomerId, out customerId))
            {
                _statusMessage = L.T("buyer.checkout.customerMissing");
                _statusLevel = "warning";
                return;
            }
        }

        await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);

        var items = _cartLines
            .Select(x => new OrderItemCreateRequest(x.ProductId, x.Quantity, x.UnitPrice))
            .ToList();

        var order = await BuyerApi.CreateOrderAsync(
            new OrderCreateRequest(partnerId, customerId, 0, "CLP", items,
                DeliveryAddress: BuildDeliveryAddress(),
                DestinationLat: DestinationLatForSubmit,
                DestinationLng: DestinationLngForSubmit),
            tenantId);

        if (order is null)
        {
            _statusMessage = L.T("buyer.status.orderFailed");
            _statusLevel = "error";
            return;
        }

        await OnOrderCreatedAsync(order.Id, order.CustomerId, order.Status, order.TotalAmount, clearCartOnPaidOnly: true);
        _statusMessage = $"{L.T("buyer.status.orderCreated")} #{order.Id}";
        _statusLevel = "success";
    }

    private async Task OnGuestOrderCreatedAsync(GuestOrderCreateResponse response)
    {
        await OnOrderCreatedAsync(response.OrderId, response.CustomerId, response.Status, response.TotalAmount, clearCartOnPaidOnly: true, trackingToken: response.TrackingToken);
        _statusMessage = string.Equals(response.Status, "payment_pending", StringComparison.OrdinalIgnoreCase)
            ? L.T("buyer.checkout.guestSuccessPendingPayment")
            : L.T("buyer.checkout.guestSuccess");
        _statusLevel = "success";
    }

    private async Task OnOrderCreatedAsync(Guid orderId, Guid customerId, string? status, double totalAmount, bool clearCartOnPaidOnly, string? trackingToken = null)
    {
        ApplySuccess(orderId, customerId, status, totalAmount, trackingToken);
        if (clearCartOnPaidOnly && string.Equals(status, "paid", StringComparison.OrdinalIgnoreCase))
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.clearGuestCart");
        }
    }

    private void ApplySuccess(Guid orderId, Guid customerId, string? status, double totalAmount, string? trackingToken = null)
    {
        _successOrderId = orderId;
        _successCustomerId = customerId;
        _successStatus = status;
        _total = $"{totalAmount:N0}";
        _completed = true;
        _ = PersistLastTrackingAsync(orderId, customerId, trackingToken);
        _ = TrackAsync("submit_checkout", "submit", "success");
        _ = TryOfferMercadoPagoAsync(orderId, customerId);
    }

    private async Task PersistLastTrackingAsync(Guid orderId, Guid customerId, string? trackingToken = null)
    {
        try
        {
            var payload = new Dictionary<string, string>
            {
                ["orderId"] = orderId.ToString(),
                ["customerId"] = customerId.ToString()
            };
            if (!string.IsNullOrWhiteSpace(trackingToken))
            {
                payload["token"] = trackingToken;
            }
            await JSRuntime.InvokeVoidAsync("comunaclic.setLastTracking", JsonSerializer.Serialize(payload));
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private async Task TryOfferMercadoPagoAsync(Guid orderId, Guid customerId)
    {
        if (!Guid.TryParse(PartnerId, out var partnerId))
        {
            _mercadoPagoChecked = true;
            return;
        }

        try
        {
            var status = await BuyerApi.GetPartnerPaymentStatusAsync(partnerId);
            _partnerAcceptsOnlinePayment = status?.MercadoPagoReady == true;
            if (!_partnerAcceptsOnlinePayment)
            {
                _statusMessage = L.T("buyer.checkout.guestSuccess");
                return;
            }

            var checkout = await BuyerApi.CreateMercadoPagoCheckoutAsync(
                new PublicMercadoPagoCheckoutRequest(customerId, orderId, null));
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                _mercadoPagoCheckoutUrl = checkout.CheckoutUrl;
                await SavePendingMpPaymentAsync(orderId, customerId, checkout.CheckoutUrl);
            }
        }
        catch
        {
            _partnerAcceptsOnlinePayment = false;
        }
        finally
        {
            _mercadoPagoChecked = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SavePendingMpPaymentAsync(Guid orderId, Guid customerId, string checkoutUrl)
    {
        try
        {
            var payload = JsonSerializer.Serialize(new Dictionary<string, string?>
            {
                ["orderId"] = orderId.ToString(),
                ["customerId"] = customerId.ToString(),
                ["checkoutUrl"] = checkoutUrl,
                ["createdAt"] = DateTimeOffset.UtcNow.ToString("O")
            });
            await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", payload);
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal()
    {
        _total = _isCartMode
            ? $"{_cartLines.Sum(x => x.UnitPrice * x.Quantity):N0}"
            : $"{(Quantity * UnitPrice):N0}";
    }

    private async Task LoadCheckoutAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.Equals(GetQueryParameter(uri.Query, "cart"), "1", StringComparison.OrdinalIgnoreCase))
        {
            await LoadGuestCartCheckoutAsync();
            return;
        }

        var productId = GetQueryParameter(uri.Query, "productId");
        var customerIdFromQuery = GetQueryParameter(uri.Query, "customerId");

        if (!Guid.TryParse(productId, out var parsedProductId))
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            return;
        }

        var product = await BuyerApi.GetProductAsync(parsedProductId);
        if (product is null)
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            return;
        }

        ProductId = product.Id.ToString();
        PartnerId = product.PartnerId.ToString();
        UnitPrice = product.Price;
        _productName = product.Name;
        _productCategory = product.Category;
        _tenantId = product.TenantId;
        _inStock = product.InStock;
        _maxAvailable = product.AvailableQuantity ?? product.StockQuantity ?? 0;
        var suggested = GuestCheckoutDeliveryHelper.DetectSuggestedMode(product.Description);
        if (suggested is not null)
        {
            _deliveryMode = suggested;
            _deliveryHint = L.T("buyer.checkout.delivery.hintFromProduct");
        }
        else
        {
            _deliveryHint = null;
        }
        if (_maxAvailable > 0 && Quantity > _maxAvailable)
        {
            Quantity = _maxAvailable;
        }

        if (_maxAvailable <= 0 || !product.InStock)
        {
            _statusMessage = L.T("buyer.checkout.outOfStock");
            _statusLevel = "warning";
        }

        if (Guid.TryParse(customerIdFromQuery, out var parsedCustomerId) && parsedCustomerId != Guid.Empty)
        {
            CustomerId = parsedCustomerId.ToString();
            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        }

        if (_isPersonal)
        {
            await ResolveCustomerIdAsync();
        }

        UpdateTotal();
        await TrackAsync("start_checkout", "start", "started");
        _startedTracked = true;
    }

    private async Task LoadGuestCartCheckoutAsync()
    {
        _isCartMode = true;
        _cartLines.Clear();

        var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getGuestCart");
        if (string.IsNullOrWhiteSpace(raw))
        {
            _statusMessage = L.T("buyer.cart.emptyTitle");
            _statusLevel = "warning";
            return;
        }

        using var doc = JsonDocument.Parse(raw);
        var root = doc.RootElement;
        PartnerId = root.TryGetProperty("partnerId", out var p) ? p.GetString() ?? string.Empty : string.Empty;
        _productName = root.TryGetProperty("partnerName", out var pn) ? pn.GetString() : L.T("buyer.cart.heading");
        if (root.TryGetProperty("tenantId", out var t) && Guid.TryParse(t.GetString(), out var tenantId))
        {
            _tenantId = tenantId;
        }

        if (!root.TryGetProperty("items", out var items) || items.ValueKind != JsonValueKind.Array)
        {
            _statusMessage = L.T("buyer.cart.emptyTitle");
            _statusLevel = "warning";
            return;
        }

        foreach (var item in items.EnumerateArray())
        {
            if (!item.TryGetProperty("productId", out var pid) || !Guid.TryParse(pid.GetString(), out var productId))
            {
                continue;
            }

            _cartLines.Add(new GuestCartCheckoutLine
            {
                ProductId = productId,
                Name = item.TryGetProperty("name", out var n) ? n.GetString() ?? "Producto" : "Producto",
                Quantity = item.TryGetProperty("quantity", out var q) && q.TryGetInt32(out var qi) ? qi : 1,
                UnitPrice = item.TryGetProperty("unitPrice", out var up) && up.TryGetDouble(out var price) ? price : 0,
                MaxAvailable = item.TryGetProperty("maxAvailable", out var m) && m.TryGetInt32(out var max) ? max : 99
            });
        }

        if (_cartLines.Count == 0)
        {
            _statusMessage = L.T("buyer.cart.emptyTitle");
            _statusLevel = "warning";
            return;
        }

        _inStock = true;
        _maxAvailable = 99;

        if (_isPersonal)
        {
            await ResolveCustomerIdAsync();
        }

        UpdateTotal();
        await TrackAsync("start_checkout", "start", "started");
        _startedTracked = true;
    }

    private async Task ResolveCustomerIdAsync()
    {
        await AuthState.InitializeAsync();

        var tenantCandidates = new List<Guid?>();
        if (_tenantId is Guid tenantFromProduct && tenantFromProduct != Guid.Empty)
        {
            tenantCandidates.Add(tenantFromProduct);
        }

        if (AuthState.TenantId is Guid tenantFromSession && tenantFromSession != Guid.Empty && !tenantCandidates.Contains(tenantFromSession))
        {
            tenantCandidates.Add(tenantFromSession);
        }

        tenantCandidates.Add(null);

        foreach (var tenantCandidate in tenantCandidates)
        {
            if (await TryEnsureCustomerIdAsync(tenantCandidate))
            {
                return;
            }
        }

        if (Guid.TryParse(CustomerId, out var currentId) && currentId != Guid.Empty)
        {
            return;
        }

        await TryUseStoredCustomerIdAsync();
    }

    private async Task<bool> TryEnsureCustomerIdAsync(Guid? tenantId)
    {
        try
        {
            var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantId);
            if (ensured?.Id is Guid customerId && customerId != Guid.Empty)
            {
                CustomerId = customerId.ToString();
                await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                return true;
            }
        }
        catch
        {
            // Continue with next tenant candidate.
        }

        return false;
    }

    private async Task<bool> TryUseStoredCustomerIdAsync()
    {
        var storedCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
        if (Guid.TryParse(storedCustomerId, out var parsedId) && parsedId != Guid.Empty)
        {
            CustomerId = parsedId.ToString();
            return true;
        }

        CustomerId = string.Empty;
        return false;
    }

    private async Task TrackAsync(string eventName, string step, string status)
    {
        var entityId = Guid.TryParse(ProductId, out var productId) ? productId : (Guid?)null;
        var deviceType = await JSRuntime.InvokeAsync<string>("comunaclic.getDeviceType");
        await BuyerApi.TrackFunnelEventAsync(new FunnelEventRequest(
            eventName,
            "commerce",
            "product",
            entityId,
            _tenantId,
            Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery,
            deviceType,
            "buy",
            step,
            status,
            DateTimeOffset.UtcNow,
            new Dictionary<string, string?>
            {
                ["customerId"] = string.IsNullOrWhiteSpace(CustomerId) ? null : CustomerId,
                ["partnerId"] = PartnerId,
                ["quantity"] = Quantity.ToString(),
                ["guest"] = (!_isPersonal).ToString()
            }));
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            }
        }
        return null;
    }

    private static string ShortId(Guid id)
        => id.ToString()[..8];

    public void Dispose()
    {
        if (_startedTracked && !_completed)
        {
            _ = TrackAsync("flow_abandoned", "checkout", "abandoned");
        }
        L.OnChange -= HandleChange;
    }
}
