@page "/buyer/checkout"
@layout BuyerLayout
@using System.Text.Json
@using ComunaClick.Common.Funnel
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ComunaClick.SharedUI.Services.CartState CartBadge
@implements IDisposable

<PageTitle>@L.T("buyer.checkout.title")</PageTitle>

@if (_initializing)
{
    <BrandedLoading Title="@L.T("buyer.checkout.loadingTitle")" Message="@L.T("buyer.checkout.loadingMessage")" />
}
else if (_isPartnerBlocked)
{
    <section class="max-w-3xl mx-auto rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-4">
        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@L.T("buyer.checkout.partnerBlocked.eyebrow")</p>
        <h1 class="text-3xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.checkout.partnerBlocked.title")</h1>
        <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.partnerBlocked.body")</p>
        <a href="/" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("buyer.checkout.partnerBlocked.cta")</a>
    </section>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h1 class="text-2xl font-bold">@L.T("buyer.checkout.heading")</h1>
            <p class="text-sm text-[#61897c]">@(_isPersonal ? L.T("buyer.checkout.subtitle") : L.T("buyer.checkout.guestSubtitle"))</p>

            @if (!_isCartMode && _successOrderId is Guid successId)
            {
                <div class="mt-6 rounded-[1.5rem] border border-[#a7f255] bg-[#f8fff1] p-5 space-y-3">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#396300]">@L.T("buyer.checkout.success.eyebrow")</p>
                    <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.checkout.success.title")</h2>
                    <p class="text-sm text-[#595c5d]">
                        @string.Format(L.T("buyer.checkout.success.body"), ShortId(successId), _successStatus ?? "payment_pending")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_mercadoPagoCheckoutUrl))
                    {
                        <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.mp.hint")</p>
                        <a href="@_mercadoPagoCheckoutUrl" class="inline-flex items-center justify-center rounded-2xl bg-[#009ee3] px-5 py-3 text-sm font-bold text-white">@L.T("buyer.checkout.mp.pay")</a>
                    }
                    else if (_mercadoPagoChecked && !_partnerAcceptsOnlinePayment)
                    {
                        <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.mp.offlineDetail")</p>
                    }
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href="@TrackingHref" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("buyer.checkout.success.track")</a>
                        @if (!_isPersonal && !AuthState.IsAuthenticated)
                        {
                            <a href="@RegisterHref" class="inline-flex items-center justify-center rounded-2xl border border-[#3b6700] px-5 py-3 text-sm font-bold text-[#3b6700]">@L.T("buyer.checkout.success.register")</a>
                        }
                        <a href="/categorias" class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30]">@L.T("buyer.checkout.success.browse")</a>
                    </div>
                </div>
            }

            @if (_isCartMode && _cartGroups.Any(g => g.State == CartGroupState.Created))
            {
                @* Multi-local: un pedido (y un pago Mercado Pago) por cada negocio. *@
                <div class="mt-6 rounded-[1.5rem] border border-[#a7f255] bg-[#f8fff1] p-5 space-y-3">
                    <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#396300]">@L.T("buyer.checkout.success.eyebrow")</p>
                    <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.checkout.multi.successTitle")</h2>
                    <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.multi.payEach")</p>
                    @foreach (var group in _cartGroups.Where(g => g.State == CartGroupState.Created))
                    {
                        <div class="rounded-xl border border-[#cde9a4] bg-white p-4 space-y-2">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <p class="text-sm font-bold text-[#2c2f30]">@group.Cart.PartnerName</p>
                                <span class="text-sm font-semibold text-[#595c5d]">@($"{group.OrderTotal:N0}")</span>
                            </div>
                            @if (group.OrderId is Guid groupOrderId)
                            {
                                <p class="text-xs text-[#595c5d]">@string.Format(L.T("buyer.checkout.multi.orderRow"), ShortId(groupOrderId), group.OrderStatus ?? "payment_pending")</p>
                            }
                            <div class="flex flex-wrap items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(group.MpCheckoutUrl))
                                {
                                    <a href="@group.MpCheckoutUrl" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-2xl bg-[#009ee3] px-4 py-2 text-xs font-bold text-white">@L.T("buyer.checkout.mp.pay")</a>
                                }
                                else if (group.MpChecked && !group.AcceptsOnlinePayment)
                                {
                                    <span class="text-xs text-[#595c5d]">@L.T("buyer.checkout.mp.offlineDetail")</span>
                                }
                                @if (group.OrderId is Guid trackOrderId && group.OrderCustomerId is Guid trackCustomerId)
                                {
                                    <a href="@($"/buyer/orders?orderId={trackOrderId}&customerId={trackCustomerId}")" class="inline-flex items-center justify-center rounded-2xl border border-[#3b6700] px-4 py-2 text-xs font-bold text-[#3b6700]">@L.T("buyer.checkout.success.track")</a>
                                }
                            </div>
                        </div>
                    }
                    <div class="flex flex-col sm:flex-row gap-3">
                        @if (!_isPersonal && !AuthState.IsAuthenticated)
                        {
                            <a href="@RegisterHref" class="inline-flex items-center justify-center rounded-2xl border border-[#3b6700] px-5 py-3 text-sm font-bold text-[#3b6700]">@L.T("buyer.checkout.success.register")</a>
                        }
                        <a href="/categorias" class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30]">@L.T("buyer.checkout.success.browse")</a>
                    </div>
                </div>
            }

            @if (!_isPersonal && !AuthState.IsAuthenticated && !CheckoutCompleted)
            {
                <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#dadddf] bg-[#fafafa] px-4 py-3 text-sm">
                    <span class="text-[#595c5d]">@L.T("buyer.checkout.guestLoginHint")</span>
                    <a href="@LoginHref" class="font-bold text-[#3b6700] hover:underline">@L.T("buyer.checkout.guestLoginCta")</a>
                </div>
            }

            @if (_isCartMode && _cartGroups.Count > 0)
            {
                <div class="mt-4 space-y-3 text-sm">
                    <p class="text-[#61897c]">@string.Format(L.T("buyer.checkout.cartMode"), _cartGroups.Sum(g => g.Cart.ItemCount), _cartGroups.Count)</p>
                    @foreach (var group in _cartGroups)
                    {
                        <div class="rounded-xl border border-primary/20 bg-primary/5 p-4 space-y-2">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <p class="font-bold text-[#2c2f30]">@group.Cart.PartnerName</p>
                                @if (group.State == CartGroupState.Created)
                                {
                                    <span class="inline-flex items-center rounded-full bg-[#e6f9d2] px-3 py-1 text-[11px] font-bold text-[#396300]">@L.T("buyer.checkout.multi.created")</span>
                                }
                                else if (group.State == CartGroupState.Submitting)
                                {
                                    <span class="inline-flex items-center rounded-full bg-[#fef3c7] px-3 py-1 text-[11px] font-bold text-[#92400e]">@L.T("buyer.checkout.submitting")</span>
                                }
                            </div>
                            @foreach (var line in group.Cart.Items)
                            {
                                <div class="flex justify-between gap-3 border-t border-primary/10 pt-2">
                                    <span>@line.Name × @line.Quantity</span>
                                    <span class="font-semibold">@($"{line.UnitPrice * line.Quantity:N0}")</span>
                                </div>
                            }
                            @if (_deliveryMode == GuestCheckoutDeliveryHelper.ModeHome)
                            {
                                <div class="flex justify-between gap-3 border-t border-primary/10 pt-2 text-xs">
                                    <span>@L.T("buyer.checkout.group.fee")</span>
                                    @if (group.QuoteLoading)
                                    {
                                        <span class="font-semibold text-[#61897c]">@L.T("buyer.checkout.deliveryFee.calculating")</span>
                                    }
                                    else if (group.QuoteOutOfRange)
                                    {
                                        <span class="font-semibold text-red-600">@L.T("buyer.checkout.group.outOfRange")</span>
                                    }
                                    else if (group.Quote?.FeeApplies == true)
                                    {
                                        <span class="font-semibold">
                                            @($"{group.QuotedFee:N0}")
                                            @if (!string.IsNullOrWhiteSpace(group.Quote?.DeliveryProviderName))
                                            {
                                                <span class="font-normal text-[#61897c]"> · @group.Quote!.DeliveryProviderName</span>
                                            }
                                        </span>
                                    }
                                    else if (group.Quote is { Available: true, FeeApplies: false })
                                    {
                                        @* Sin transportista en la zona: no hay recargo (≠ cotización pendiente). *@
                                        <span class="font-semibold text-[#61897c]">@L.T("buyer.checkout.group.feeNone")</span>
                                    }
                                    else
                                    {
                                        <span class="font-semibold text-[#61897c]">@L.T("buyer.checkout.group.feePending")</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(group.ErrorMessage))
                            {
                                <p class="text-xs font-semibold text-red-600">@group.ErrorMessage</p>
                            }
                        </div>
                    }
                </div>
            }
            else if (_productName is not null)
            {
                <div class="mt-4 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm">
                    <strong>@L.T("buyer.checkout.productLabel")</strong> @_productName<br />
                    <strong>@L.T("buyer.checkout.categoryLabel")</strong> @_productCategory<br />
                    <strong>@L.T("buyer.checkout.priceLabel")</strong> @($"{UnitPrice:N0}")
                </div>
            }

            @if (!_isPersonal && !CheckoutCompleted)
            {
                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.fullName")</label>
                        <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               @bind="GuestFullName"
                               disabled="@_isSubmitting"
                               autocomplete="name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.email")</label>
                        <input type="email"
                               class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               @bind="GuestEmail"
                               disabled="@_isSubmitting"
                               autocomplete="email" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.phone") *</label>
                        <input type="tel"
                               class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               @bind="GuestPhone"
                               disabled="@_isSubmitting"
                               autocomplete="tel"
                               placeholder="+56 9 1234 5678" />
                    </div>
                </div>
            }

            @if (!CheckoutCompleted)
            {
                <div class="mt-6 md:col-span-2 space-y-3 text-sm">
                    <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#61897c]">@L.T("buyer.checkout.delivery.heading")</p>
                    @if (!string.IsNullOrWhiteSpace(_deliveryHint))
                    {
                        <p class="text-xs text-[#61897c]">@_deliveryHint</p>
                    }
                    <div class="space-y-2">
                        @if (ShowDeliveryMode(GuestCheckoutDeliveryHelper.ModeHome))
                        {
                            var homeEnabled = IsDeliveryModeEnabled(GuestCheckoutDeliveryHelper.ModeHome);
                            <label class="flex items-start gap-2 @(homeEnabled ? "cursor-pointer" : "cursor-not-allowed opacity-50")">
                                <input type="radio" name="deliveryMode" checked="@(_deliveryMode == GuestCheckoutDeliveryHelper.ModeHome)"
                                       disabled="@(_isSubmitting || !homeEnabled)"
                                       @onchange="() => SetDeliveryMode(GuestCheckoutDeliveryHelper.ModeHome)" />
                                <span class="text-sm">
                                    @DeliveryModeHomeLabel
                                    @if (!homeEnabled)
                                    {
                                        <span class="block text-xs text-[#9b4b4b]">No disponible: tu ubicación está fuera del radio de 20 km</span>
                                    }
                                </span>
                            </label>
                        }
                        @if (ShowDeliveryMode(GuestCheckoutDeliveryHelper.ModeFree))
                        {
                            var freeEnabled = IsDeliveryModeEnabled(GuestCheckoutDeliveryHelper.ModeFree);
                            var faltante = freeEnabled ? 0 : (double)(_partnerProfile!.ShippingFreeOverAmount ?? 0) - NumericSubtotal;
                            <label class="flex items-start gap-2 @(freeEnabled ? "cursor-pointer" : "cursor-not-allowed opacity-50")">
                                <input type="radio" name="deliveryMode" checked="@(_deliveryMode == GuestCheckoutDeliveryHelper.ModeFree)"
                                       disabled="@(_isSubmitting || !freeEnabled)"
                                       @onchange="() => SetDeliveryMode(GuestCheckoutDeliveryHelper.ModeFree)" />
                                <span class="text-sm">
                                    @DeliveryModeFreeLabel
                                    @if (!freeEnabled && faltante > 0)
                                    {
                                        <span class="block text-xs text-[#9b4b4b]">Agregá $@($"{faltante:N0}") más para desbloquear el envío gratis</span>
                                    }
                                </span>
                            </label>
                        }
                        @if (ShowDeliveryMode(GuestCheckoutDeliveryHelper.ModePayOnDelivery))
                        {
                            <label class="flex items-start gap-2 cursor-pointer">
                                <input type="radio" name="deliveryMode" checked="@(_deliveryMode == GuestCheckoutDeliveryHelper.ModePayOnDelivery)" disabled="@_isSubmitting"
                                       @onchange="() => SetDeliveryMode(GuestCheckoutDeliveryHelper.ModePayOnDelivery)" />
                                <span class="text-sm">@DeliveryModePayOnDeliveryLabel</span>
                            </label>
                        }
                    </div>
                    @if (_deliveryMode == GuestCheckoutDeliveryHelper.ModeHome)
                    {
                        @* Transparencia de costos: el despacho a domicilio suma un recargo al total. *@
                        <p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-2.5 text-xs font-semibold text-amber-800">
                            <span class="material-symbols-outlined align-middle text-[16px]">local_shipping</span>
                            @if (!_isCartMode && !_quoteLoading && _quote?.FeeApplies == true && !_quoteOutOfRange)
                            {
                                @if (!string.IsNullOrWhiteSpace(_quote?.DeliveryProviderName))
                                {
                                    @string.Format(L.T("buyer.checkout.delivery.feeAmountProvider"), $"{_deliveryFee:N0}", _quote!.DeliveryProviderName)
                                }
                                else
                                {
                                    @string.Format(L.T("buyer.checkout.delivery.feeAmount"), $"{_deliveryFee:N0}")
                                }
                            }
                            else
                            {
                                @L.T("buyer.checkout.delivery.feeNotice")
                            }
                        </p>
                        @if (HasOutOfRangeQuote)
                        {
                            <p class="rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-xs font-semibold text-red-700">
                                @string.Format(L.T("buyer.checkout.delivery.outOfRange"), $"{OutOfRangeMaxKm:0.#}")
                            </p>
                        }
                    }
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@DeliveryAddressLabel</label>
                        <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               @bind="DeliveryAddress"
                               placeholder="@DeliveryAddressPlaceholder"
                               disabled="@_isSubmitting"
                               autocomplete="street-address" />
                    </div>
                    @if (RequiresDeliveryAddress)
                    {
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.delivery.detailsLabel")</label>
                            <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                                   @bind="_addressDetails"
                                   placeholder="@L.T("buyer.checkout.delivery.detailsPlaceholder")"
                                   disabled="@_isSubmitting" />
                        </div>
                        @* Pin de destino para el tracking en vivo del delivery (opcional, no bloquea la compra). *@
                        <DeliveryDestinationPicker @key="_deliveryMode"
                                                   Latitude="_destinationLat"
                                                   LatitudeChanged="OnDestinationLatChanged"
                                                   Longitude="_destinationLng"
                                                   LongitudeChanged="OnDestinationLngChangedAsync"
                                                   AddressResolved="OnDestinationAddressResolved" />
                    }
                </div>
            }

            @if (!_isCartMode)
            {
                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    @if (_isPersonal)
                    {
                        <div class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 py-3 bg-gray-50 dark:bg-gray-800 md:col-span-2">
                            <p class="text-[11px] uppercase tracking-[0.12em] font-bold text-[#61897c]">@L.T("buyer.checkout.authenticated.eyebrow")</p>
                            <p class="text-sm text-[#2c2f30]">@L.T("buyer.checkout.authenticated.body")</p>
                        </div>
                    }
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.quantity")</label>
                        <input type="number"
                               min="1"
                               max="@MaxQuantity"
                               class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               @bind="Quantity"
                               @bind:after="OnQuantityChanged"
                               disabled="@(_isSubmitting || CheckoutCompleted || !CanPurchase)" />
                        @if (_maxAvailable > 0)
                        {
                            <p class="mt-1 text-xs text-[#61897c]">@string.Format(L.T("buyer.checkout.stockAvailable"), _maxAvailable)</p>
                        }
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.unitPrice")</label>
                        <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full bg-gray-50"
                               @bind="UnitPrice"
                               readonly />
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
            }
        </div>

        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h2 class="text-lg font-bold">@L.T("buyer.checkout.summary")</h2>
            <div class="mt-4 space-y-2 text-sm">
                @if (_isCartMode)
                {
                    @foreach (var group in _cartGroups)
                    {
                        <div class="flex justify-between gap-3">
                            <span class="truncate">@group.Cart.PartnerName</span>
                            <span class="font-semibold">@($"{group.Cart.Subtotal:N0}")</span>
                        </div>
                    }
                    @if (_deliveryMode == GuestCheckoutDeliveryHelper.ModeHome)
                    {
                        <div class="flex justify-between gap-3 border-t border-gray-100 dark:border-gray-700 pt-2">
                            <span>@string.Format(L.T("buyer.checkout.multi.shippingRow"), _cartGroups.Count)</span>
                            <span class="font-semibold">
                                @if (_cartGroups.Any(g => g.QuoteLoading))
                                {
                                    @L.T("buyer.checkout.deliveryFee.calculating")
                                }
                                else
                                {
                                    @($"{_cartGroups.Sum(g => g.QuotedFee):N0}")
                                }
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="flex justify-between gap-3">
                        <span>@L.T("buyer.checkout.subtotal")</span>
                        <span class="font-semibold">@_subtotal</span>
                    </div>
                    @if (_deliveryMode == GuestCheckoutDeliveryHelper.ModeHome)
                    {
                        <div class="flex justify-between gap-3">
                            <span>@L.T("buyer.checkout.deliveryFee")</span>
                            <span class="font-semibold">
                                @if (_quoteLoading)
                                {
                                    @L.T("buyer.checkout.deliveryFee.calculating")
                                }
                                else if (_quoteOutOfRange)
                                {
                                    <span class="text-red-600">—</span>
                                }
                                else if (_quote?.FeeApplies == true)
                                {
                                    @($"{_deliveryFee:N0}")
                                    @if (!string.IsNullOrWhiteSpace(_quote?.DeliveryProviderName))
                                    {
                                        <span class="font-normal text-[#61897c]"> · @_quote!.DeliveryProviderName</span>
                                    }
                                }
                                else if (_quote is { Available: true, FeeApplies: false })
                                {
                                    @* Sin transportista en la zona: no hay recargo (≠ cotización pendiente). *@
                                    <span class="text-[#61897c]">@L.T("buyer.checkout.group.feeNone")</span>
                                }
                                else
                                {
                                    <span class="text-[#61897c]">@L.T("buyer.checkout.group.feePending")</span>
                                }
                            </span>
                        </div>
                        @if (!HasPlausibleDestination && !_quoteLoading && _quote?.FeeApplies != true)
                        {
                            <p class="text-xs text-[#61897c]">@L.T("buyer.checkout.deliveryFee.pendingPin")</p>
                        }
                    }
                }
                <div class="flex justify-between gap-3 border-t border-gray-200 dark:border-gray-700 pt-2">
                    <span class="font-bold">@L.T("buyer.checkout.total")</span>
                    <span class="font-bold">@_total</span>
                </div>
                @if (_isCartMode && _cartGroups.Count > 1)
                {
                    <p class="text-xs text-[#61897c]">@string.Format(L.T("buyer.checkout.multi.note"), _cartGroups.Count)</p>
                }
                @if (HasOutOfRangeQuote)
                {
                    <p class="text-xs font-semibold text-red-600">@string.Format(L.T("buyer.checkout.delivery.outOfRange"), $"{OutOfRangeMaxKm:0.#}")</p>
                }
            </div>
            <button class="w-full mt-6 bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold disabled:opacity-60 disabled:cursor-not-allowed"
                    @onclick="HandleCheckout"
                    disabled="@(_isSubmitting || CheckoutCompleted || (!_isCartMode && !CanPurchase) || (_isCartMode && _cartGroups.Count == 0) || HasOutOfRangeQuote)">
                @if (_isSubmitting)
                {
                    <span>@L.T("buyer.checkout.submitting")</span>
                }
                else if (CheckoutCompleted)
                {
                    <span>@L.T("buyer.checkout.completed")</span>
                }
                else if (_isCartMode && _cartGroups.Any(g => g.State == CartGroupState.Failed))
                {
                    <span>@L.T("buyer.checkout.multi.retry")</span>
                }
                else
                {
                    <span>@(_isPersonal ? L.T("buyer.checkout.pay") : L.T("buyer.checkout.guestPay"))</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private string PartnerId = string.Empty;
    private string CustomerId = string.Empty;
    private string ProductId = string.Empty;
    private int Quantity = 1;
    private int _maxAvailable;
    private bool _inStock = true;
    private double UnitPrice;
    private bool CanPurchase => _inStock && _maxAvailable > 0;
    private int MaxQuantity => _maxAvailable > 0 ? _maxAvailable : 1;
    private string _statusMessage = string.Empty;
    private string _statusLevel = "info";
    private string _total = "$0";
    private string? _productName;
    private string? _productCategory;
    private bool _startedTracked;
    private bool _completed;
    private Guid? _tenantId;
    private bool _initializing = true;
    private bool _isPartnerBlocked;
    private bool _isPersonal;
    private bool _checkedAuth;
    private bool _isSubmitting;
    private Guid? _successOrderId;
    private Guid? _successCustomerId;
    private string? _successStatus;
    private string? _mercadoPagoCheckoutUrl;
    private bool _mercadoPagoChecked;
    private bool _partnerAcceptsOnlinePayment;
    private bool _isCartMode;
    private readonly List<CheckoutCartGroup> _cartGroups = new();

    private ComunaClick.Shared.Api.Buyer.PartnerProfileSummary? _partnerProfile;

    // Cotización de despacho (modo producto único). El monto es informativo:
    // el server siempre recalcula el fee al crear la orden.
    private PublicDeliveryQuoteResponse? _quote;
    private bool _quoteLoading;
    private bool _quoteOutOfRange;
    private double _deliveryFee;
    private string _subtotal = "0";
    // Guard contra respuestas de cotización fuera de orden (pin movido rápido).
    private int _quoteSeq;

    private string GuestFullName = string.Empty;

    private enum CartGroupState { Pending, Submitting, Created, Failed }

    // Un grupo del carrito = un negocio = una orden (y un pago MP) propios.
    private sealed class CheckoutCartGroup
    {
        public GuestCartGroupModel Cart { get; init; } = new();
        public PublicDeliveryQuoteResponse? Quote { get; set; }
        public bool QuoteLoading { get; set; }
        public bool QuoteOutOfRange => Quote?.OutOfRange == true;
        public double QuotedFee => Quote is { FeeApplies: true, OutOfRange: false } ? Quote.Fee : 0;
        public CartGroupState State { get; set; } = CartGroupState.Pending;
        public string? ErrorMessage { get; set; }
        public Guid? OrderId { get; set; }
        public Guid? OrderCustomerId { get; set; }
        public string? OrderStatus { get; set; }
        public double OrderTotal { get; set; }
        public string? TrackingToken { get; set; }
        public string? MpCheckoutUrl { get; set; }
        public bool MpChecked { get; set; }
        public bool AcceptsOnlinePayment { get; set; }
    }

    private bool CheckoutCompleted => _isCartMode
        ? _cartGroups.Count > 0 && _cartGroups.All(g => g.State == CartGroupState.Created)
        : _successOrderId is not null;

    private bool HasOutOfRangeQuote => _deliveryMode == GuestCheckoutDeliveryHelper.ModeHome
        && (_isCartMode ? _cartGroups.Any(g => g.QuoteOutOfRange) : _quoteOutOfRange);

    private double OutOfRangeMaxKm => (_isCartMode
        ? _cartGroups.FirstOrDefault(g => g.QuoteOutOfRange)?.Quote?.MaxDistanceKm
        : _quote?.MaxDistanceKm) ?? 0;

    private string GuestEmail = string.Empty;
    private string GuestPhone = string.Empty;
    private string DeliveryAddress = string.Empty;
    private string _deliveryMode = GuestCheckoutDeliveryHelper.ModeHome;
    private string? _deliveryHint;
    // Pin de destino para el tracking en vivo del delivery (opcional).
    private double? _destinationLat;
    private double? _destinationLng;
    // Referencia adicional de la entrega (depto, torre, indicaciones).
    private string _addressDetails = string.Empty;

    private string DeliveryAddressLabel => _deliveryMode switch
    {
        GuestCheckoutDeliveryHelper.ModeFree => L.T("buyer.checkout.delivery.addressOptional"),
        _ => L.T("buyer.checkout.guest.address")
    };

    private string DeliveryAddressPlaceholder => _deliveryMode switch
    {
        GuestCheckoutDeliveryHelper.ModeFree => L.T("buyer.checkout.delivery.placeholderFree"),
        GuestCheckoutDeliveryHelper.ModePayOnDelivery => L.T("buyer.checkout.delivery.placeholderPayOnDelivery"),
        _ => L.T("buyer.checkout.delivery.placeholderHome")
    };

    private string CurrentPathAndQuery => Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery;
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";
    private string RegisterHref
    {
        get
        {
            var href = $"/register?role=natural&returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";
            if (!string.IsNullOrWhiteSpace(GuestEmail))
            {
                href += $"&email={Uri.EscapeDataString(GuestEmail.Trim())}";
            }

            return href;
        }
    }

    private string TrackingHref => _successOrderId is Guid orderId && _successCustomerId is Guid customerId
        ? $"/buyer/orders?orderId={orderId}&customerId={customerId}"
        : "/buyer/orders";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;

        try
        {
            await AuthState.InitializeAsync();
            _isPersonal = AuthState.IsPersonalAccount;
            _isPartnerBlocked = false;
            _initializing = false;

            if (!_isPersonal && AuthState.IsPartnerAccount)
            {
                if (string.IsNullOrEmpty(GuestFullName)) GuestFullName = AuthState.DisplayName ?? string.Empty;
                if (string.IsNullOrEmpty(GuestEmail)) GuestEmail = AuthState.Email ?? string.Empty;
            }

            // Compradores registrados: prefill del pin de entrega con la ubicación
            // guardada en su perfil (pueden ajustarla igual en el mapa).
            if (_isPersonal && (_tenantId ?? AuthState.TenantId) is { } profileTenantId && profileTenantId != Guid.Empty)
            {
                try
                {
                    var profile = await BuyerApi.GetBuyerCustomerAsync(profileTenantId);
                    if (profile?.Latitude is not null && profile.Longitude is not null)
                    {
                        _destinationLat ??= profile.Latitude;
                        _destinationLng ??= profile.Longitude;
                    }
                }
                catch (HttpRequestException)
                {
                }
            }

            await LoadCheckoutAsync();

            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            _checkedAuth = false;
        }
    }

    private async Task HandleCheckout()
    {
        if (_isSubmitting || CheckoutCompleted)
        {
            return;
        }

        _statusMessage = string.Empty;
        _statusLevel = "info";
        UpdateTotal();

        if (_isCartMode)
        {
            if (_cartGroups.Count == 0)
            {
                _statusMessage = L.T("buyer.checkout.missingProduct");
                _statusLevel = "warning";
                return;
            }

            _isSubmitting = true;
            try
            {
                await SubmitCartGroupsAsync();
            }
            finally
            {
                _isSubmitting = false;
            }

            return;
        }

        if (string.IsNullOrWhiteSpace(PartnerId) || string.IsNullOrWhiteSpace(ProductId))
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "missing_product_context");
            return;
        }

        if (!Guid.TryParse(PartnerId, out var partnerId) ||
            !Guid.TryParse(ProductId, out var productId))
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "invalid_product_context");
            return;
        }

        if (!CanPurchase)
        {
            _statusMessage = L.T("buyer.checkout.outOfStock");
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "out_of_stock");
            return;
        }

        if (Quantity < 1 || Quantity > _maxAvailable)
        {
            _statusMessage = string.Format(L.T("buyer.checkout.quantityExceeded"), _maxAvailable);
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "quantity_exceeded");
            return;
        }

        if (_tenantId is not Guid tenantId || tenantId == Guid.Empty)
        {
            _statusMessage = L.T("buyer.checkout.missingTenant");
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "missing_tenant");
            return;
        }

        _isSubmitting = true;
        try
        {
            if (_isPersonal)
            {
                await SubmitPersonalOrderAsync(partnerId, productId, tenantId);
            }
            else
            {
                await SubmitGuestOrderAsync(partnerId, productId, tenantId);
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = ex.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? L.T("buyer.checkout.stockRejected")
                : string.Format(L.T("buyer.checkout.httpError"), (int?)ex.StatusCode ?? 0);
            _statusLevel = "error";
            await TrackAsync("flow_error", "submit", "http_exception");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitPersonalOrderAsync(Guid partnerId, Guid productId, Guid tenantId)
    {
        if (!TryValidateDelivery(out var deliveryError))
        {
            _statusMessage = deliveryError;
            _statusLevel = "warning";
            return;
        }

        await AuthState.InitializeAsync();
        if (!AuthState.IsPersonalAccount)
        {
            _statusMessage = L.T("buyer.checkout.personalSessionRequired");
            _statusLevel = "warning";
            await TrackAsync("flow_error", "identity", "not_logged_personal");
            return;
        }

        if (string.IsNullOrWhiteSpace(CustomerId))
        {
            await ResolveCustomerIdAsync();
        }

        if (string.IsNullOrWhiteSpace(CustomerId) || !Guid.TryParse(CustomerId, out var customerId))
        {
            await ResolveCustomerIdAsync();
            if (!Guid.TryParse(CustomerId, out customerId))
            {
                _statusMessage = L.T("buyer.checkout.customerMissing");
                _statusLevel = "warning";
                await TrackAsync("flow_error", "identity", "missing_customer");
                return;
            }
        }

        await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);

        var request = new OrderCreateRequest(
            partnerId,
            customerId,
            0,
            "CLP",
            new List<OrderItemCreateRequest> { new(productId, Quantity, UnitPrice) },
            DeliveryProviderId: DeliveryProviderIdForSubmit(_quote),
            DeliveryAddress: BuildDeliveryAddress(),
            DestinationLat: DestinationLatForSubmit,
            DestinationLng: DestinationLngForSubmit);

        var order = await BuyerApi.CreateOrderAsync(request, _tenantId ?? AuthState.TenantId);
        _total = order is null ? "$0" : $"{order.TotalAmount:N0}";
        if (order is null)
        {
            _statusMessage = L.T("buyer.status.orderFailed");
            _statusLevel = "error";
            await TrackAsync("flow_error", "submit", "order_failed");
            return;
        }

        ApplySuccess(order.Id, order.CustomerId, order.Status, order.TotalAmount);
        _statusMessage = $"{L.T("buyer.status.orderCreated")} #{order.Id}";
        _statusLevel = "success";
    }

    private bool AnyShippingConfigured => _partnerProfile is not null &&
        (_partnerProfile.ShippingDeliveryZoneEnabled || _partnerProfile.ShippingFreeEnabled ||
         _partnerProfile.ShippingFreeOverAmountEnabled || _partnerProfile.ShippingCourierPaidEnabled);

    private bool ShowDeliveryMode(string mode)
    {
        if (!AnyShippingConfigured) return true;
        if (mode == GuestCheckoutDeliveryHelper.ModeHome) return _partnerProfile!.ShippingDeliveryZoneEnabled;
        if (mode == GuestCheckoutDeliveryHelper.ModeFree) return _partnerProfile!.ShippingFreeEnabled || _partnerProfile!.ShippingFreeOverAmountEnabled;
        if (mode == GuestCheckoutDeliveryHelper.ModePayOnDelivery) return _partnerProfile!.ShippingCourierPaidEnabled;
        return true;
    }

    private string DeliveryModeHomeLabel =>
        AnyShippingConfigured && _partnerProfile!.ShippingDeliveryZoneEnabled
            ? "Delivery a zonas cercanas"
            : L.T("buyer.checkout.delivery.home");

    private string DeliveryModeFreeLabel
    {
        get
        {
            if (!AnyShippingConfigured) return L.T("buyer.checkout.delivery.free");
            var p = _partnerProfile!;
            if (p.ShippingFreeEnabled && !p.ShippingFreeOverAmountEnabled) return "Envío siempre gratis";
            if (p.ShippingFreeOverAmountEnabled && p.ShippingFreeOverAmount is > 0)
                return $"Envío gratis desde ${p.ShippingFreeOverAmount:N0}";
            return "Envío gratis";
        }
    }

    private string DeliveryModePayOnDeliveryLabel =>
        AnyShippingConfigured && _partnerProfile!.ShippingCourierPaidEnabled
            ? "Envío por pagar (courier a elección)"
            : L.T("buyer.checkout.delivery.payOnDelivery");

    private double NumericSubtotal => _isCartMode
        ? _cartGroups.Sum(g => g.Cart.Subtotal)
        : Quantity * UnitPrice;

    private bool IsFreeShippingAmountMet
    {
        get
        {
            if (_partnerProfile is null) return true;
            if (_partnerProfile.ShippingFreeEnabled) return true;
            if (!_partnerProfile.ShippingFreeOverAmountEnabled) return true;
            if (_partnerProfile.ShippingFreeOverAmount is null or <= 0) return true;
            return NumericSubtotal >= (double)_partnerProfile.ShippingFreeOverAmount;
        }
    }

    private bool IsDeliveryZoneOutOfRange =>
        _isCartMode ? _cartGroups.Any(g => g.QuoteOutOfRange) : _quoteOutOfRange;

    private bool IsDeliveryModeEnabled(string mode)
    {
        if (mode == GuestCheckoutDeliveryHelper.ModeFree) return IsFreeShippingAmountMet;
        if (mode == GuestCheckoutDeliveryHelper.ModeHome) return !IsDeliveryZoneOutOfRange;
        return true;
    }

    private void EnsureDeliveryModeValid()
    {
        if (IsDeliveryModeEnabled(_deliveryMode)) return;
        var candidates = _deliveryMode == GuestCheckoutDeliveryHelper.ModeFree
            ? new[] { GuestCheckoutDeliveryHelper.ModeHome, GuestCheckoutDeliveryHelper.ModePayOnDelivery }
            : new[] { GuestCheckoutDeliveryHelper.ModePayOnDelivery, GuestCheckoutDeliveryHelper.ModeFree, GuestCheckoutDeliveryHelper.ModeHome };
        foreach (var m in candidates)
        {
            if (ShowDeliveryMode(m) && IsDeliveryModeEnabled(m))
            {
                _deliveryMode = m;
                return;
            }
        }
    }

    private void SetDeliveryMode(string mode)
    {
        _deliveryMode = mode;
        UpdateTotal();
        _ = RefreshDeliveryQuotesAsync();
    }

    // El proveedor de la cotización se reenvía solo en envío a domicilio; el
    // server revalida zona y recalcula el monto (el cliente no fija precios).
    private Guid? DeliveryProviderIdForSubmit(PublicDeliveryQuoteResponse? quote)
        => _deliveryMode == GuestCheckoutDeliveryHelper.ModeHome ? quote?.DeliveryProviderId : null;

    private bool TryValidateDelivery(out string message)
    {
        message = string.Empty;
        if (!GuestCheckoutDeliveryHelper.Validate(_deliveryMode, DeliveryAddress, out var errorKey))
        {
            message = L.T(errorKey ?? "buyer.checkout.delivery.addressRequired");
            return false;
        }

        if (HasOutOfRangeQuote)
        {
            message = string.Format(L.T("buyer.checkout.delivery.outOfRange"), $"{OutOfRangeMaxKm:0.#}");
            return false;
        }

        return true;
    }

    private string? BuildDeliveryAddress()
    {
        // La referencia adicional (depto, torre, indicaciones) se anexa a la
        // dirección para que vendedor y repartidor la vean junto al destino.
        var address = DeliveryAddress;
        if (!string.IsNullOrWhiteSpace(address) && !string.IsNullOrWhiteSpace(_addressDetails))
        {
            address = $"{address.Trim()} — {_addressDetails.Trim()}";
        }

        return GuestCheckoutDeliveryHelper.FormatDeliveryAddress(_deliveryMode, address);
    }

    // El pin de destino solo aplica a modos con dirección de entrega.
    private bool RequiresDeliveryAddress
        => _deliveryMode is GuestCheckoutDeliveryHelper.ModeHome or GuestCheckoutDeliveryHelper.ModePayOnDelivery;

    // Solo se envía el pin si las coordenadas son plausibles (dentro de Chile):
    // un pin en 0,0 u otro punto basura rompería el mapa de seguimiento.
    private bool HasPlausibleDestination
        => _destinationLat.HasValue && _destinationLng.HasValue
        && GeoLocationValidator.IsWithinChile(_destinationLat.Value, _destinationLng.Value);

    private double? DestinationLatForSubmit => RequiresDeliveryAddress && HasPlausibleDestination ? _destinationLat : null;
    private double? DestinationLngForSubmit => RequiresDeliveryAddress && HasPlausibleDestination ? _destinationLng : null;

    private Task OnDestinationAddressResolved(string resolvedAddress)
    {
        // Prefill solo si el comprador aún no escribió su dirección a mano.
        if (string.IsNullOrWhiteSpace(DeliveryAddress))
        {
            DeliveryAddress = resolvedAddress;
        }

        return InvokeAsync(StateHasChanged);
    }

    private void OnDestinationLatChanged(double? value)
    {
        _destinationLat = value;
    }

    // El picker emite lat y luego lng: la cotización se refresca acá para
    // hacerlo una sola vez con ambas coordenadas ya actualizadas.
    private async Task OnDestinationLngChangedAsync(double? value)
    {
        _destinationLng = value;
        await RefreshDeliveryQuotesAsync();
    }

    private void OnQuantityChanged()
    {
        UpdateTotal();
    }

    /// <summary>
    /// Cotiza el despacho con el endpoint público (por negocio en modo carrito).
    /// Un fallo de cotización nunca bloquea el checkout: el server recalcula
    /// el fee real al crear la orden.
    /// </summary>
    private async Task RefreshDeliveryQuotesAsync()
    {
        var seq = ++_quoteSeq;

        if (_deliveryMode != GuestCheckoutDeliveryHelper.ModeHome)
        {
            _quote = null;
            _quoteOutOfRange = false;
            _deliveryFee = 0;
            _quoteLoading = false;
            foreach (var group in _cartGroups)
            {
                group.Quote = null;
                group.QuoteLoading = false;
            }

            UpdateTotal();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_isCartMode)
        {
            foreach (var group in _cartGroups)
            {
                group.QuoteLoading = true;
            }

            await InvokeAsync(StateHasChanged);
            foreach (var group in _cartGroups)
            {
                try
                {
                    var quote = await BuyerApi.GetDeliveryQuoteAsync(group.Cart.PartnerId, DestinationLatForSubmit, DestinationLngForSubmit);
                    if (seq != _quoteSeq)
                    {
                        return;
                    }

                    group.Quote = quote;
                }
                catch
                {
                    group.Quote = null;
                }
                finally
                {
                    group.QuoteLoading = false;
                }
            }

            UpdateTotal();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!Guid.TryParse(PartnerId, out var partnerId) || partnerId == Guid.Empty)
        {
            return;
        }

        _quoteLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var quote = await BuyerApi.GetDeliveryQuoteAsync(partnerId, DestinationLatForSubmit, DestinationLngForSubmit);
            if (seq != _quoteSeq)
            {
                return;
            }

            _quote = quote;
            _quoteOutOfRange = quote?.OutOfRange == true;
            _deliveryFee = quote is { FeeApplies: true, OutOfRange: false } ? quote.Fee : 0;
        }
        catch
        {
            _quote = null;
            _quoteOutOfRange = false;
            _deliveryFee = 0;
        }
        finally
        {
            if (seq == _quoteSeq)
            {
                _quoteLoading = false;
                UpdateTotal();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SubmitGuestOrderAsync(Guid partnerId, Guid productId, Guid tenantId)
    {
        if (!TryValidateDelivery(out var deliveryError))
        {
            _statusMessage = deliveryError;
            _statusLevel = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(GuestFullName) || GuestFullName.Trim().Length < 2)
        {
            _statusMessage = L.T("buyer.checkout.guest.fullNameRequired");
            _statusLevel = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(GuestEmail) || !GuestEmail.Contains('@'))
        {
            _statusMessage = L.T("buyer.checkout.guest.emailRequired");
            _statusLevel = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(GuestPhone))
        {
            _statusMessage = L.T("buyer.checkout.guest.phoneRequired");
            _statusLevel = "warning";
            return;
        }

        var request = new GuestOrderCreateRequest(
            tenantId,
            partnerId,
            new List<OrderItemCreateRequest> { new(productId, Quantity, UnitPrice) },
            new GuestContactRequest(
                GuestFullName.Trim(),
                GuestEmail.Trim(),
                GuestPhone.Trim()),
            0,
            "CLP",
            BuildDeliveryAddress(),
            DestinationLatForSubmit,
            DestinationLngForSubmit,
            DeliveryProviderIdForSubmit(_quote));

        var response = await BuyerApi.CreateGuestOrderAsync(request);
        if (response is null)
        {
            _statusMessage = L.T("buyer.status.orderFailed");
            _statusLevel = "error";
            await TrackAsync("flow_error", "submit", "guest_order_failed");
            return;
        }

        CustomerId = response.CustomerId.ToString();
        await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        OnGuestOrderCreated(response);
    }

    /// <summary>
    /// Crea una orden por cada negocio del carrito, en secuencia. Los grupos
    /// con error quedan en el carrito y se pueden reintentar sin duplicar los
    /// pedidos ya creados.
    /// </summary>
    private async Task SubmitCartGroupsAsync()
    {
        if (!TryValidateDelivery(out var deliveryError))
        {
            _statusMessage = deliveryError;
            _statusLevel = "warning";
            return;
        }

        Guid customerId = Guid.Empty;
        if (_isPersonal)
        {
            await AuthState.InitializeAsync();
            if (!AuthState.IsPersonalAccount)
            {
                _statusMessage = L.T("buyer.checkout.personalSessionRequired");
                _statusLevel = "warning";
                return;
            }

            if (!Guid.TryParse(CustomerId, out customerId))
            {
                await ResolveCustomerIdAsync();
                if (!Guid.TryParse(CustomerId, out customerId))
                {
                    _statusMessage = L.T("buyer.checkout.customerMissing");
                    _statusLevel = "warning";
                    return;
                }
            }

            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(GuestFullName) || GuestFullName.Trim().Length < 2)
            {
                _statusMessage = L.T("buyer.checkout.guest.fullNameRequired");
                _statusLevel = "warning";
                return;
            }

            if (string.IsNullOrWhiteSpace(GuestEmail) || !GuestEmail.Contains('@'))
            {
                _statusMessage = L.T("buyer.checkout.guest.emailRequired");
                _statusLevel = "warning";
                return;
            }

            if (string.IsNullOrWhiteSpace(GuestPhone))
            {
                _statusMessage = L.T("buyer.checkout.guest.phoneRequired");
                _statusLevel = "warning";
                return;
            }
        }

        foreach (var group in _cartGroups.Where(g => g.State != CartGroupState.Created))
        {
            group.State = CartGroupState.Submitting;
            group.ErrorMessage = null;
            await InvokeAsync(StateHasChanged);

            var items = group.Cart.Items
                .Select(x => new OrderItemCreateRequest(x.ProductId, x.Quantity, x.UnitPrice))
                .ToList();
            var providerId = DeliveryProviderIdForSubmit(group.Quote);

            try
            {
                if (_isPersonal)
                {
                    var order = await BuyerApi.CreateOrderAsync(
                        new OrderCreateRequest(group.Cart.PartnerId, customerId, 0, group.Cart.Currency, items,
                            DeliveryProviderId: providerId,
                            DeliveryAddress: BuildDeliveryAddress(),
                            DestinationLat: DestinationLatForSubmit,
                            DestinationLng: DestinationLngForSubmit),
                        group.Cart.TenantId);

                    if (order is null)
                    {
                        group.State = CartGroupState.Failed;
                        group.ErrorMessage = L.T("buyer.status.orderFailed");
                        continue;
                    }

                    await ApplyGroupSuccessAsync(group, order.Id, order.CustomerId, order.Status, order.TotalAmount, null);
                }
                else
                {
                    var response = await BuyerApi.CreateGuestOrderAsync(new GuestOrderCreateRequest(
                        group.Cart.TenantId,
                        group.Cart.PartnerId,
                        items,
                        new GuestContactRequest(GuestFullName.Trim(), GuestEmail.Trim(), GuestPhone.Trim()),
                        0,
                        group.Cart.Currency,
                        BuildDeliveryAddress(),
                        DestinationLatForSubmit,
                        DestinationLngForSubmit,
                        providerId));

                    if (response is null)
                    {
                        group.State = CartGroupState.Failed;
                        group.ErrorMessage = L.T("buyer.status.orderFailed");
                        continue;
                    }

                    CustomerId = response.CustomerId.ToString();
                    await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                    await ApplyGroupSuccessAsync(group, response.OrderId, response.CustomerId, response.Status, response.TotalAmount, response.TrackingToken);
                }
            }
            catch (HttpRequestException ex)
            {
                group.State = CartGroupState.Failed;
                group.ErrorMessage = ex.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? L.T("buyer.checkout.stockRejected")
                    : string.Format(L.T("buyer.checkout.httpError"), (int?)ex.StatusCode ?? 0);
            }
        }

        var createdCount = _cartGroups.Count(g => g.State == CartGroupState.Created);
        if (createdCount == _cartGroups.Count)
        {
            _completed = true;
            _statusMessage = L.T("buyer.checkout.guestSuccessPendingPayment");
            _statusLevel = "success";
        }
        else
        {
            _statusMessage = string.Format(L.T("buyer.checkout.multi.partial"), createdCount, _cartGroups.Count);
            _statusLevel = "warning";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyGroupSuccessAsync(CheckoutCartGroup group, Guid orderId, Guid customerId, string? status, double totalAmount, string? trackingToken)
    {
        group.State = CartGroupState.Created;
        group.OrderId = orderId;
        group.OrderCustomerId = customerId;
        group.OrderStatus = status;
        group.OrderTotal = totalAmount;
        group.TrackingToken = trackingToken;

        // El grupo sale del carrito apenas su pedido existe: si otro negocio
        // falla, el carrito retiene solo lo pendiente para reintentar.
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.removeGuestCartGroup", group.Cart.PartnerId.ToString());
            await CartBadge.RefreshAsync(JSRuntime);
        }
        catch
        {
            // Ignore storage errors.
        }

        _ = PersistLastTrackingAsync(orderId, customerId, trackingToken);
        _ = TrackAsync("submit_checkout", "submit", "success");
        await TryOfferMercadoPagoForGroupAsync(group);
    }

    private async Task TryOfferMercadoPagoForGroupAsync(CheckoutCartGroup group)
    {
        if (group.OrderId is not Guid orderId || group.OrderCustomerId is not Guid customerId)
        {
            group.MpChecked = true;
            return;
        }

        try
        {
            var status = await BuyerApi.GetPartnerPaymentStatusAsync(group.Cart.PartnerId);
            group.AcceptsOnlinePayment = status?.MercadoPagoReady == true;
            if (!group.AcceptsOnlinePayment)
            {
                return;
            }

            var checkout = await BuyerApi.CreateMercadoPagoCheckoutAsync(
                new PublicMercadoPagoCheckoutRequest(customerId, orderId, null));
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                group.MpCheckoutUrl = checkout.CheckoutUrl;
                await SavePendingMpPaymentAsync(orderId, customerId, checkout.CheckoutUrl, group.Cart.PartnerName);
            }
        }
        catch
        {
            group.AcceptsOnlinePayment = false;
        }
        finally
        {
            group.MpChecked = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnGuestOrderCreated(GuestOrderCreateResponse response)
    {
        ApplySuccess(response.OrderId, response.CustomerId, response.Status, response.TotalAmount, response.TrackingToken);
        _statusMessage = string.Equals(response.Status, "payment_pending", StringComparison.OrdinalIgnoreCase)
            ? L.T("buyer.checkout.guestSuccessPendingPayment")
            : L.T("buyer.checkout.guestSuccess");
        _statusLevel = "success";
    }

    private void ApplySuccess(Guid orderId, Guid customerId, string? status, double totalAmount, string? trackingToken = null)
    {
        _successOrderId = orderId;
        _successCustomerId = customerId;
        _successStatus = status;
        _total = $"{totalAmount:N0}";
        _completed = true;
        _ = PersistLastTrackingAsync(orderId, customerId, trackingToken);
        _ = TrackAsync("submit_checkout", "submit", "success");
        _ = TryOfferMercadoPagoAsync(orderId, customerId);
    }

    private async Task PersistLastTrackingAsync(Guid orderId, Guid customerId, string? trackingToken = null)
    {
        try
        {
            var payload = new Dictionary<string, string>
            {
                ["orderId"] = orderId.ToString(),
                ["customerId"] = customerId.ToString()
            };
            if (!string.IsNullOrWhiteSpace(trackingToken))
            {
                payload["token"] = trackingToken;
            }
            await JSRuntime.InvokeVoidAsync("comunaclic.setLastTracking", JsonSerializer.Serialize(payload));
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private async Task TryOfferMercadoPagoAsync(Guid orderId, Guid customerId)
    {
        if (!Guid.TryParse(PartnerId, out var partnerId))
        {
            _mercadoPagoChecked = true;
            return;
        }

        try
        {
            var status = await BuyerApi.GetPartnerPaymentStatusAsync(partnerId);
            _partnerAcceptsOnlinePayment = status?.MercadoPagoReady == true;
            if (!_partnerAcceptsOnlinePayment)
            {
                _statusMessage = L.T("buyer.checkout.guestSuccess");
                return;
            }

            var checkout = await BuyerApi.CreateMercadoPagoCheckoutAsync(
                new PublicMercadoPagoCheckoutRequest(customerId, orderId, null));
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                _mercadoPagoCheckoutUrl = checkout.CheckoutUrl;
                await SavePendingMpPaymentAsync(orderId, customerId, checkout.CheckoutUrl, null);
            }
        }
        catch
        {
            _partnerAcceptsOnlinePayment = false;
        }
        finally
        {
            _mercadoPagoChecked = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SavePendingMpPaymentAsync(Guid orderId, Guid customerId, string checkoutUrl, string? partnerName)
    {
        try
        {
            var payload = JsonSerializer.Serialize(new Dictionary<string, string?>
            {
                ["orderId"] = orderId.ToString(),
                ["customerId"] = customerId.ToString(),
                ["checkoutUrl"] = checkoutUrl,
                ["createdAt"] = DateTimeOffset.UtcNow.ToString("O"),
                ["partnerName"] = string.IsNullOrWhiteSpace(partnerName) ? null : partnerName
            });
            // addPendingMpPayment acumula varios pagos pendientes (uno por negocio).
            await JSRuntime.InvokeVoidAsync("comunaclic.addPendingMpPayment", payload);
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTotal()
    {
        var subtotal = _isCartMode
            ? _cartGroups.Sum(g => g.Cart.Subtotal)
            : Quantity * UnitPrice;
        _subtotal = $"{subtotal:N0}";

        EnsureDeliveryModeValid();

        var fee = _deliveryMode == GuestCheckoutDeliveryHelper.ModeHome
            ? (_isCartMode ? _cartGroups.Sum(g => g.QuotedFee) : _deliveryFee)
            : 0;
        _total = $"{subtotal + fee:N0}";
    }

    private async Task LoadCheckoutAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.Equals(GetQueryParameter(uri.Query, "cart"), "1", StringComparison.OrdinalIgnoreCase))
        {
            await LoadGuestCartCheckoutAsync();
            return;
        }

        var productId = GetQueryParameter(uri.Query, "productId");
        var customerIdFromQuery = GetQueryParameter(uri.Query, "customerId");

        if (!Guid.TryParse(productId, out var parsedProductId))
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            return;
        }

        var product = await BuyerApi.GetProductAsync(parsedProductId);
        if (product is null)
        {
            _statusMessage = L.T("buyer.checkout.missingProduct");
            _statusLevel = "warning";
            return;
        }

        ProductId = product.Id.ToString();
        PartnerId = product.PartnerId.ToString();
        UnitPrice = product.Price;
        _productName = product.Name;
        _productCategory = product.Category;
        _tenantId = product.TenantId;
        _inStock = product.InStock;
        _maxAvailable = product.AvailableQuantity ?? product.StockQuantity ?? 0;

        try
        {
            var profileResponse = await BuyerApi.GetPartnerProfileAsync(product.PartnerId);
            _partnerProfile = profileResponse?.Partner;
        }
        catch (HttpRequestException) { }

        var suggested = GuestCheckoutDeliveryHelper.DetectSuggestedMode(product.Description);
        if (suggested is not null)
        {
            _deliveryMode = suggested;
            _deliveryHint = L.T("buyer.checkout.delivery.hintFromProduct");
        }
        else
        {
            _deliveryHint = null;
        }

        // Si el modo por defecto no está habilitado según la config del comercio, auto-seleccionar el primero disponible.
        if (!ShowDeliveryMode(_deliveryMode))
        {
            foreach (var m in new[] { GuestCheckoutDeliveryHelper.ModeHome, GuestCheckoutDeliveryHelper.ModeFree, GuestCheckoutDeliveryHelper.ModePayOnDelivery })
            {
                if (ShowDeliveryMode(m)) { _deliveryMode = m; break; }
            }
        }
        if (_maxAvailable > 0 && Quantity > _maxAvailable)
        {
            Quantity = _maxAvailable;
        }

        if (_maxAvailable <= 0 || !product.InStock)
        {
            _statusMessage = L.T("buyer.checkout.outOfStock");
            _statusLevel = "warning";
        }

        if (Guid.TryParse(customerIdFromQuery, out var parsedCustomerId) && parsedCustomerId != Guid.Empty)
        {
            CustomerId = parsedCustomerId.ToString();
            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        }

        if (_isPersonal)
        {
            await ResolveCustomerIdAsync();
        }

        UpdateTotal();
        // Cotización inicial (cubre el pin prellenado desde el perfil del comprador).
        await RefreshDeliveryQuotesAsync();
        await TrackAsync("start_checkout", "start", "started");
        _startedTracked = true;
    }

    private async Task LoadGuestCartCheckoutAsync()
    {
        _isCartMode = true;
        _cartGroups.Clear();

        var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getGuestCart");
        var groups = GuestCartStore.Parse(raw);
        if (groups.Count == 0)
        {
            _statusMessage = L.T("buyer.cart.emptyTitle");
            _statusLevel = "warning";
            return;
        }

        foreach (var group in groups)
        {
            _cartGroups.Add(new CheckoutCartGroup { Cart = group });
        }

        // Hint de tenant para resolver el perfil del comprador logueado; cada
        // orden usa el tenant de su propio grupo al enviarse.
        _tenantId = groups[0].TenantId;
        _inStock = true;
        _maxAvailable = 99;

        if (_isPersonal)
        {
            await ResolveCustomerIdAsync();
        }

        UpdateTotal();
        await RefreshDeliveryQuotesAsync();
        await TrackAsync("start_checkout", "start", "started");
        _startedTracked = true;
    }

    private async Task ResolveCustomerIdAsync()
    {
        await AuthState.InitializeAsync();

        var tenantCandidates = new List<Guid?>();
        if (_tenantId is Guid tenantFromProduct && tenantFromProduct != Guid.Empty)
        {
            tenantCandidates.Add(tenantFromProduct);
        }

        if (AuthState.TenantId is Guid tenantFromSession && tenantFromSession != Guid.Empty && !tenantCandidates.Contains(tenantFromSession))
        {
            tenantCandidates.Add(tenantFromSession);
        }

        tenantCandidates.Add(null);

        foreach (var tenantCandidate in tenantCandidates)
        {
            if (await TryEnsureCustomerIdAsync(tenantCandidate))
            {
                return;
            }
        }

        if (Guid.TryParse(CustomerId, out var currentId) && currentId != Guid.Empty)
        {
            return;
        }

        await TryUseStoredCustomerIdAsync();
    }

    private async Task<bool> TryEnsureCustomerIdAsync(Guid? tenantId)
    {
        try
        {
            var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantId);
            if (ensured?.Id is Guid customerId && customerId != Guid.Empty)
            {
                CustomerId = customerId.ToString();
                await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                return true;
            }
        }
        catch
        {
            // Continue with next tenant candidate.
        }

        return false;
    }

    private async Task<bool> TryUseStoredCustomerIdAsync()
    {
        var storedCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
        if (Guid.TryParse(storedCustomerId, out var parsedId) && parsedId != Guid.Empty)
        {
            CustomerId = parsedId.ToString();
            return true;
        }

        CustomerId = string.Empty;
        return false;
    }

    private async Task TrackAsync(string eventName, string step, string status)
    {
        var entityId = Guid.TryParse(ProductId, out var productId) ? productId : (Guid?)null;
        var deviceType = await JSRuntime.InvokeAsync<string>("comunaclic.getDeviceType");
        await BuyerApi.TrackFunnelEventAsync(new FunnelEventRequest(
            eventName,
            "commerce",
            "product",
            entityId,
            _tenantId,
            Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery,
            deviceType,
            "buy",
            step,
            status,
            DateTimeOffset.UtcNow,
            new Dictionary<string, string?>
            {
                ["customerId"] = string.IsNullOrWhiteSpace(CustomerId) ? null : CustomerId,
                ["partnerId"] = PartnerId,
                ["quantity"] = Quantity.ToString(),
                ["guest"] = (!_isPersonal).ToString()
            }));
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            }
        }
        return null;
    }

    private static string ShortId(Guid id)
        => id.ToString()[..8];

    public void Dispose()
    {
        if (_startedTracked && !_completed)
        {
            _ = TrackAsync("flow_abandoned", "checkout", "abandoned");
        }
        L.OnChange -= HandleChange;
    }
}
