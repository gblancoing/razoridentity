@page "/buyer/cart"
@layout BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@L.T("buyer.cart.title")</PageTitle>

@if (_loading)
{
    <BrandedLoading Title="@L.T("buyer.cart.title")" Message="@L.T("buyer.cart.loading")" />
}
else if (_groups.Count == 0)
{
    <section class="rounded-2xl bg-white p-8 text-center space-y-4">
        <h1 class="text-2xl font-bold">@L.T("buyer.cart.emptyTitle")</h1>
        <p class="text-sm text-[#595c5d]">@L.T("buyer.cart.emptyBody")</p>
        <a href="/categorias" class="inline-flex rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("buyer.cart.browse")</a>
    </section>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h1 class="text-2xl font-bold">@L.T("buyer.cart.heading")</h1>
                @if (_groups.Count > 1)
                {
                    <p class="mt-1 text-sm text-[#61897c]">@L.T("buyer.cart.multiStoreNote")</p>
                }
            </div>
            @foreach (var group in _groups)
            {
                <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <p class="font-bold text-[#2c2f30]">@group.PartnerName</p>
                        <button type="button" class="text-sm font-bold text-red-600" @onclick="() => RemoveGroup(group)">@L.T("buyer.cart.removeGroup")</button>
                    </div>
                    @foreach (var line in group.Items)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#dadddf] p-4">
                            <div>
                                <p class="font-bold text-[#2c2f30]">@line.Name</p>
                                <p class="text-sm text-[#61897c]">@($"{line.UnitPrice:N0} x {line.Quantity}")</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="h-10 w-10 rounded-lg border" @onclick="() => ChangeQty(group, line, -1)">−</button>
                                <span class="w-8 text-center font-bold">@line.Quantity</span>
                                <button type="button" class="h-10 w-10 rounded-lg border" @onclick="() => ChangeQty(group, line, 1)">+</button>
                                <button type="button" class="text-sm text-red-600 font-bold ml-2" @onclick="() => RemoveLine(group, line)">@L.T("buyer.cart.remove")</button>
                            </div>
                        </div>
                    }
                    <div class="flex items-center justify-between border-t border-gray-100 pt-3 text-sm">
                        <span class="text-[#61897c]">@L.T("buyer.cart.groupSubtotal")</span>
                        <span class="font-bold">@($"{group.Subtotal:N0}")</span>
                    </div>
                </div>
            }
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class="text-lg font-bold">@L.T("buyer.checkout.summary")</h2>
            <div class="mt-4 space-y-2 text-sm">
                @foreach (var group in _groups)
                {
                    <div class="flex justify-between gap-3">
                        <span class="truncate">@group.PartnerName</span>
                        <span class="font-semibold">@($"{group.Subtotal:N0}")</span>
                    </div>
                }
                <div class="flex justify-between gap-3 border-t border-gray-200 pt-2">
                    <span class="font-bold">@L.T("buyer.cart.grandTotal")</span>
                    <span class="font-bold">@($"{GrandTotal:N0}")</span>
                </div>
            </div>
            <p class="mt-3 text-xs text-[#61897c]">@L.T("buyer.cart.multiStoreNote")</p>
            <a href="/buyer/checkout?cart=1" class="mt-4 block w-full rounded-2xl bg-[#3b6700] px-5 py-3 text-center text-sm font-bold text-[#d9ffad]">@L.T("buyer.cart.checkout")</a>
            <button type="button" class="mt-3 w-full text-sm text-[#595c5d]" @onclick="ClearCartAsync">@L.T("buyer.cart.clear")</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<GuestCartGroupModel> _groups = new();

    private double GrandTotal => _groups.Sum(g => g.Subtotal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadCartAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadCartAsync()
    {
        var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getGuestCart");
        _groups = GuestCartStore.Parse(raw);
    }

    private async Task SaveCartAsync()
    {
        // Grupos sin líneas se descartan; sin grupos, el carrito se vacía.
        _groups.RemoveAll(g => g.Items.Count == 0);
        if (_groups.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.clearGuestCart");
            return;
        }

        await JSRuntime.InvokeVoidAsync("comunaclic.setGuestCart", GuestCartStore.Serialize(_groups));
    }

    private async Task ChangeQty(GuestCartGroupModel group, GuestCartItemModel line, int delta)
    {
        line.Quantity = Math.Clamp(line.Quantity + delta, 1, line.MaxAvailable > 0 ? line.MaxAvailable : 99);
        await SaveCartAsync();
    }

    private async Task RemoveLine(GuestCartGroupModel group, GuestCartItemModel line)
    {
        group.Items.Remove(line);
        await SaveCartAsync();
    }

    private async Task RemoveGroup(GuestCartGroupModel group)
    {
        _groups.Remove(group);
        await SaveCartAsync();
    }

    private async Task ClearCartAsync()
    {
        _groups.Clear();
        await JSRuntime.InvokeVoidAsync("comunaclic.clearGuestCart");
    }
}
