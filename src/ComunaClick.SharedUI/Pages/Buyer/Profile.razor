@page "/buyer/profile"
@layout BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject Microsoft.Extensions.Options.IOptions<ComunaClick.Shared.Http.ApiOptions> ApiOptions
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using System.Net
@using System.Text.Json.Serialization

<PageTitle>@L.T("buyer.profile.title")</PageTitle>

<div class="space-y-6">
    <section class="rounded-[2rem] bg-gradient-to-br from-[#3b6700] to-[#76BC21] p-8 text-[#f8ffef] shadow-[0_24px_48px_-24px_rgba(59,103,0,0.65)]">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="flex items-center gap-5">
                <div class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-[3px] border-white/50 bg-white/20 text-3xl font-black shadow-[0_8px_24px_rgba(0,0,0,0.15)] ring-2 ring-white/25">
                    @if (ShowAvatarImage)
                    {
                        <img src="@AvatarImageSrc" alt="" class="h-full w-full object-cover" @onerror="HandleAvatarError" />
                    }
                    else
                    {
                        <span>@UserInitial</span>
                    }
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-[0.24em] text-white/80 font-bold">@L.T("buyer.profile.hubTitle")</p>
                    <h1 class="mt-2 text-4xl font-black tracking-[-0.05em]">@(string.IsNullOrWhiteSpace(FullName) ? L.T("buyer.profile.heading") : FullName)</h1>
                    <p class="mt-2 max-w-xl text-sm text-white/85">@L.T("buyer.profile.hubSubtitle")</p>
                </div>
            </div>
            <div class="rounded-3xl bg-white/12 px-5 py-4 min-w-[200px]">
                <p class="text-[10px] uppercase tracking-[0.18em] text-white/70 font-bold">@L.T("buyer.profile.accountId")</p>
                <p class="mt-2 text-sm font-semibold break-all">@MaskedCustomerId</p>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <button type="button" @onclick="() => SelectTab(ProfileTab.Account)"
                class="@RoleCardClass(ProfileTab.Account, true)">
            <span class="material-symbols-outlined text-[22px]">person</span>
            <div class="text-left">
                <p class="text-sm font-black">@L.T("buyer.profile.tab.account")</p>
                <p class="text-[11px] opacity-80">@L.T("buyer.profile.subtitle")</p>
            </div>
        </button>
        <button type="button" @onclick="() => SelectTab(ProfileTab.Buyer)"
                class="@RoleCardClass(ProfileTab.Buyer, _hasBuyerRole)">
            <span class="material-symbols-outlined text-[22px]">shopping_bag</span>
            <div class="text-left">
                <p class="text-sm font-black">@L.T("buyer.profile.role.buyer")</p>
                <p class="text-[11px] opacity-80">@L.T("buyer.profile.role.buyer.desc")</p>
            </div>
        </button>
        <button type="button" @onclick="() => SelectTab(ProfileTab.Professional)"
                class="@RoleCardClass(ProfileTab.Professional, _hasProfessionalRole || _professionalActivate)">
            <span class="material-symbols-outlined text-[22px]">work</span>
            <div class="text-left">
                <p class="text-sm font-black">@L.T("buyer.profile.role.professional")</p>
                <p class="text-[11px] opacity-80">@L.T("buyer.profile.role.professional.desc")</p>
            </div>
        </button>
    </section>

    @if (AuthState.IsPartnerAccount)
    {
        <div class="rounded-2xl border border-[#dbe6e2] bg-[#f0fdf4] px-5 py-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-[#3b6700]">storefront</span>
                <div>
                    <p class="text-sm font-bold text-[#2c2f30]">@L.T("buyer.profile.role.partner")</p>
                    <p class="text-xs text-[#61897c]">@L.T("buyer.profile.role.partner.desc")</p>
                </div>
            </div>
            <a href="/partner/dashboard" class="inline-flex items-center gap-2 rounded-xl bg-[#3b6700] px-4 py-2 text-sm font-bold text-white">
                @L.T("buyer.profile.partner.panel")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <StatusBanner Message="@_bannerMessage" Level="@_bannerLevel" />
    }

    @if (_activeTab == ProfileTab.Account)
    {
        <section class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-[2rem] p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30] dark:text-white">@L.T("buyer.profile.heading")</h2>
            <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.subtitle")</p>

            <div class="mt-8 rounded-2xl border border-[#e8e5dc] bg-[#faf4ea] p-5">
                <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#7b8081]">@L.T("buyer.profile.roles.title")</p>
                <p class="mt-1 text-sm text-[#61897c]">@L.T("buyer.profile.roles.subtitle")</p>
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button type="button" @onclick="() => SelectTab(ProfileTab.Buyer)" class="rounded-2xl border border-[#dbe6e2] bg-white p-4 text-left hover:border-primary/40 transition-colors">
                        <div class="flex items-center justify-between gap-2">
                            <span class="material-symbols-outlined text-[#3b6700]">shopping_bag</span>
                            <span class="text-[10px] font-bold uppercase @(_hasBuyerRole ? "text-[#14532d]" : "text-[#9ca3af]")">@(_hasBuyerRole ? L.T("buyer.profile.role.buyer.active") : L.T("buyer.profile.role.buyer.inactive"))</span>
                        </div>
                        <p class="mt-2 text-sm font-bold text-[#2c2f30]">@L.T("buyer.profile.role.buyer")</p>
                        <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.role.buyer.desc")</p>
                    </button>
                    <button type="button" @onclick="() => SelectTab(ProfileTab.Professional)" class="rounded-2xl border border-[#dbe6e2] bg-white p-4 text-left hover:border-primary/40 transition-colors">
                        <div class="flex items-center justify-between gap-2">
                            <span class="material-symbols-outlined text-[#3b6700]">work</span>
                            <span class="text-[10px] font-bold uppercase @ProfessionalStatusClass">@ProfessionalStatusLabel</span>
                        </div>
                        <p class="mt-2 text-sm font-bold text-[#2c2f30]">@L.T("buyer.profile.role.professional")</p>
                        <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.role.professional.desc")</p>
                    </button>
                </div>
            </div>

            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="md:col-span-2">
                    <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.name")</label>
                    <input class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 h-14 text-[#111816] focus:ring-2 focus:ring-primary" @bind="FullName" />
                </div>
                <div>
                    <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.email")</label>
                    <input class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-[#eef1f2] px-5 h-14 text-[#595c5d]" @bind="Email" type="email" readonly />
                </div>
                <div>
                    <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.phone")</label>
                    <input class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 h-14 text-[#111816] focus:ring-2 focus:ring-primary" @bind="Phone" type="tel" autocomplete="tel" />
                </div>
                <div class="md:col-span-2">
                    <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.avatarPhoto")</label>
                    <div class="mt-3 flex flex-col sm:flex-row sm:items-center gap-4">
                        <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4]">
                            @if (ShowAvatarImage)
                            {
                                <img src="@AvatarImageSrc" alt="" class="h-full w-full object-cover" @onerror="HandleAvatarError" />
                            }
                            else
                            {
                                <span class="text-2xl font-black text-[#3b6700]">@UserInitial</span>
                            }
                        </div>
                        <div class="flex-1 space-y-2">
                            <label class="relative inline-flex cursor-pointer items-center gap-2 rounded-2xl border border-[#3b6700] bg-white px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                                <span class="material-symbols-outlined text-[20px]">photo_library</span>
                                @(_isUploadingAvatar ? L.T("ui.loading") : L.T("buyer.profile.avatarChoose"))
                                <InputFile OnChange="OnAvatarFileSelected" accept="image/jpeg,image/png,image/webp,image/gif" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                            </label>
                            <p class="text-xs text-[#61897c]">@L.T("buyer.profile.avatarHint")</p>
                            @if (!string.IsNullOrWhiteSpace(_avatarUploadMessage))
                            {
                                <p class="text-xs font-semibold @(_avatarUploadOk ? "text-[#14532d]" : "text-[#b91c1c]")">@_avatarUploadMessage</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-[#e8e5dc] bg-[#faf4ea] p-5">
                <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#7b8081]">@L.T("buyer.profile.address.title")</p>
                <p class="mt-1 text-sm text-[#61897c]">@L.T("buyer.profile.address.subtitle")</p>
                <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.country")</label>
                        <select class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-white px-4 h-14" value="@CountrySelectValue" @onchange="OnCountryChanged">
                            <option value="">@L.T("buyer.profile.country.placeholder")</option>
                            @foreach (var country in _countries) { <option value="@country.Id">@country.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.region")</label>
                        <select class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-white px-4 h-14 disabled:opacity-50" value="@RegionSelectValue" @onchange="OnRegionChanged" disabled="@(!_countryId.HasValue)">
                            <option value="">@L.T("buyer.profile.region.placeholder")</option>
                            @foreach (var region in _regions) { <option value="@region.Id">@region.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.comuna")</label>
                        <select class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-white px-4 h-14 disabled:opacity-50" value="@ComunaSelectValue" @onchange="OnComunaChanged" disabled="@(!_regionId.HasValue)">
                            <option value="">@L.T("buyer.profile.comuna.placeholder")</option>
                            @foreach (var comuna in _comunas) { <option value="@comuna.Id">@comuna.Name</option> }
                        </select>
                    </div>
                </div>
                <div class="mt-4">
                    <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.address.line")</label>
                    <textarea class="mt-2 w-full min-h-[88px] rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 py-4" @bind="AddressLine" placeholder="@L.T("buyer.profile.address.line.placeholder")"></textarea>
                </div>
                <div class="mt-5">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.address.map")</label>
                        <button type="button" @onclick="UseMyLocationAsync" disabled="@_isLocating"
                                class="inline-flex items-center gap-1.5 rounded-xl border border-[#3b6700] bg-white px-3 py-2 text-xs font-bold text-[#3b6700] hover:bg-[#f0fdf4] disabled:opacity-60">
                            <span class="material-symbols-outlined text-[18px]">my_location</span>
                            @(_isLocating ? L.T("ui.loading") : L.T("buyer.profile.address.useMyLocation"))
                        </button>
                    </div>
                    <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.address.mapHint")</p>
                    @if (!string.IsNullOrWhiteSpace(_geoStatusMessage))
                    {
                        <p class="mt-2 text-xs font-semibold @(_geoStatusOk ? "text-[#14532d]" : "text-[#b91c1c]")">@_geoStatusMessage</p>
                    }
                    <div id="profile-address-map" class="mt-3 h-[280px] w-full rounded-2xl border border-[#dbe6e2] overflow-hidden z-0"></div>
                </div>
            </div>

            <button class="mt-8 inline-flex items-center gap-2 bg-primary text-[#111816] px-6 py-3 rounded-2xl font-bold disabled:opacity-60"
                    type="button" @onclick="HandleSaveAccount" disabled="@_isSavingAccount">
                <span class="material-symbols-outlined text-[20px]">save</span>
                @(_isSavingAccount ? L.T("ui.loading") : L.T("buyer.profile.save"))
            </button>
            @AccountStatusBanner()
        </section>
    }
    else if (_activeTab == ProfileTab.Buyer)
    {
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <a href="/buyer/orders" class="group rounded-[2rem] border border-[#dbe6e2] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-primary/40 transition-colors">
                <span class="material-symbols-outlined text-[#3b6700] text-[28px]">receipt_long</span>
                <h3 class="mt-4 text-xl font-black text-[#2c2f30]">@L.T("buyer.profile.buyer.orders")</h3>
                <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.buyer.orders.desc")</p>
            </a>
            <a href="/buyer/favorites" class="group rounded-[2rem] border border-[#dbe6e2] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] hover:border-primary/40 transition-colors">
                <span class="material-symbols-outlined text-[#3b6700] text-[28px]">favorite</span>
                <h3 class="mt-4 text-xl font-black text-[#2c2f30]">@L.T("buyer.profile.buyer.favorites")</h3>
                <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.buyer.favorites.desc")</p>
            </a>
            <a href="/categorias" class="group rounded-[2rem] border border-[#dbe6e2] bg-[#f6f1e8] p-6 lg:col-span-2 hover:border-primary/40 transition-colors">
                <span class="material-symbols-outlined text-[#3b6700] text-[28px]">explore</span>
                <h3 class="mt-4 text-xl font-black text-[#2c2f30]">@L.T("buyer.profile.buyer.discover")</h3>
                <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.buyer.orders.desc")</p>
            </a>
        </section>
    }
    else
    {
        <section class="bg-white border border-gray-200 rounded-[2rem] p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)]">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.profile.pro.title")</h2>
                    <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.pro.subtitle")</p>
                </div>
                @if (_hasProfessionalRole)
                {
                    <span class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold @(_professionalVerified ? "bg-[#dcfce7] text-[#14532d]" : "bg-[#fef9c3] text-[#854d0e]")">
                        <span class="material-symbols-outlined text-[16px]">@(_professionalVerified ? "verified" : "schedule")</span>
                        @(_professionalVerified ? L.T("buyer.profile.pro.verified") : L.T("buyer.profile.pro.pending"))
                    </span>
                }
            </div>

            @if (!AuthState.IsAuthenticated)
            {
                <p class="mt-6 text-sm text-[#61897c]">@L.T("buyer.profile.loginRequired")</p>
            }
            else
            {
                <label class="mt-6 flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" class="h-5 w-5 rounded border-[#dbe6e2] text-primary focus:ring-primary" @bind="_professionalActivate" />
                    <span class="text-sm font-semibold text-[#2c2f30]">@L.T("buyer.profile.pro.activate")</span>
                </label>

                @if (_professionalActivate || _hasProfessionalRole)
                {
                    <div class="mt-8 space-y-5">
                        <div>
                            <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.pro.specialty")</label>
                            <input class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 h-14" @bind="ProSpecialty" />
                        </div>
                        <div>
                            <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.pro.bio")</label>
                            <textarea class="mt-2 w-full min-h-[120px] rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 py-4 text-[#111816] focus:ring-2 focus:ring-primary" @bind="ProBio"></textarea>
                        </div>
                        <div>
                            <label class="text-xs uppercase tracking-[0.16em] font-bold text-[#61897c]">@L.T("buyer.profile.phone")</label>
                            <input class="mt-2 w-full rounded-2xl border border-[#dbe6e2] bg-[#F0FDF4] px-5 h-14" @bind="ProPhone" type="tel" />
                        </div>
                    </div>

                    <button type="button" @onclick="HandleSaveProfessional" disabled="@_isSavingProfessional"
                            class="mt-8 inline-flex items-center gap-2 bg-[#3b6700] text-white px-6 py-3 rounded-2xl font-bold disabled:opacity-60">
                        <span class="material-symbols-outlined text-[20px]">badge</span>
                        @(_isSavingProfessional ? L.T("ui.loading") : L.T("buyer.profile.pro.save"))
                    </button>
                    @ProfessionalStatusBanner()
                }
                else
                {
                    <p class="mt-6 text-sm text-[#61897c]">@L.T("buyer.profile.pro.empty")</p>
                    <a href="/register?role=professional" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#3b6700] hover:underline">
                        @L.T("buyer.profile.pro.register")
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                }
            }
        </section>
    }
</div>

@code {
    private enum ProfileTab { Account, Buyer, Professional }

    private ProfileTab _activeTab = ProfileTab.Account;
    private string CustomerId = string.Empty;
    private string FullName = string.Empty;
    private string Email = string.Empty;
    private string Phone = string.Empty;
    private string AvatarUrl = string.Empty;
    private string AddressLine = string.Empty;
    private Guid? _countryId;
    private Guid? _regionId;
    private Guid? _comunaId;
    private double? Latitude;
    private double? Longitude;
    private IReadOnlyList<PublicCountryItem> _countries = Array.Empty<PublicCountryItem>();
    private IReadOnlyList<PublicRegionItem> _regions = Array.Empty<PublicRegionItem>();
    private IReadOnlyList<PublicComunaItem> _comunas = Array.Empty<PublicComunaItem>();
    private bool _mapInitialized;
    private bool _isLocating;
    private bool _geoStatusOk;
    private string _geoStatusMessage = string.Empty;
    private DotNetObjectReference<Profile>? _mapRef;
    private const string AddressMapElementId = "profile-address-map";

    private string ProSpecialty = string.Empty;
    private string ProBio = string.Empty;
    private string ProPhone = string.Empty;
    private bool _professionalActivate;
    private bool _hasProfessionalRole;
    private bool _professionalVerified;

    private string _accountStatus = string.Empty;
    private string _accountStatusLevel = "info";
    private string _proStatus = string.Empty;
    private string _proStatusLevel = "info";
    private string _bannerMessage = string.Empty;
    private string _bannerLevel = "warning";

    private bool _isSavingAccount;
    private bool _isSavingProfessional;
    private bool _isUploadingAvatar;
    private bool _profileInitialized;
    private bool _avatarFailed;
    private bool _avatarUploadOk;
    private bool _hasBuyerRole = true;
    private string? _avatarPreviewDataUrl;
    private string _avatarUploadMessage = string.Empty;
    private const long MaxAvatarBytes = 4 * 1024 * 1024;

    private Guid? ResolveTenantId()
    {
        var tid = AuthState.TenantId ?? ApiOptions.Value.DefaultTenantId;
        return tid is { } g && g != Guid.Empty ? g : null;
    }

    private string AvatarImageSrc
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_avatarPreviewDataUrl))
                return _avatarPreviewDataUrl;
            return ResolveAvatarUrl(AvatarUrl);
        }
    }

    private bool ShowAvatarImage => !_avatarFailed && !string.IsNullOrWhiteSpace(AvatarImageSrc);

    private string ResolveAvatarUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var trimmed = url.Trim();
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        if (trimmed.StartsWith('/'))
        {
            return $"{ApiOptions.Value.ApiBaseUrl.TrimEnd('/')}{trimmed}";
        }

        return trimmed;
    }

    private string UserInitial => string.IsNullOrWhiteSpace(FullName)
        ? (string.IsNullOrWhiteSpace(AuthState.DisplayName) ? "C" : AuthState.DisplayName.Trim()[0].ToString().ToUpperInvariant())
        : FullName.Trim()[0].ToString().ToUpperInvariant();

    private string MaskedCustomerId => Guid.TryParse(CustomerId, out var customerId)
        ? $"{customerId.ToString()[..8]}...{customerId.ToString()[^4..]}"
        : L.T("buyer.profile.accountId.pending");

    private string ProfessionalStatusLabel => !_hasProfessionalRole && !_professionalActivate
        ? L.T("buyer.profile.role.pro.inactive")
        : _professionalActivate && _professionalVerified
            ? L.T("buyer.profile.pro.verified")
            : _hasProfessionalRole
                ? L.T("buyer.profile.role.pro.configured")
                : L.T("buyer.profile.role.pro.active");

    private string ProfessionalStatusClass => !_hasProfessionalRole && !_professionalActivate
        ? "text-[#9ca3af]"
        : _professionalVerified
            ? "text-[#14532d]"
            : "text-[#854d0e]";

    protected override void OnInitialized() => L.OnChange += HandleChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_profileInitialized)
        {
            if (!string.IsNullOrWhiteSpace(AuthState.DisplayName)) FullName = AuthState.DisplayName!;
            if (!string.IsNullOrWhiteSpace(AuthState.Email)) Email = AuthState.Email!;

            try
            {
                await LoadCountriesAsync();
                var storedCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
                if (!string.IsNullOrWhiteSpace(storedCustomerId)) CustomerId = storedCustomerId;

                if (AuthState.IsAuthenticated)
                {
                    var tenantId = ResolveTenantId();
                    if (!tenantId.HasValue)
                    {
                        _bannerMessage = L.T("buyer.profile.tenantRequired");
                        _bannerLevel = "warning";
                    }
                    else
                    {
                        try
                        {
                            var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantId);
                            if (ensured is not null) ApplyCustomer(ensured);
                            var fresh = await BuyerApi.GetBuyerCustomerAsync(tenantId);
                            if (fresh is not null) ApplyCustomer(fresh);
                            await LoadGeoListsForCustomerAsync();

                            try
                            {
                                var pro = await BuyerApi.GetBuyerProfessionalProfileAsync(tenantId);
                                if (pro is not null) ApplyProfessional(pro);
                            }
                            catch (HttpRequestException)
                            {
                                // API antigua sin professional-profile: no bloquear cuenta comprador
                            }
                        }
                        catch (HttpRequestException ex)
                        {
                            _bannerMessage = ex.StatusCode == HttpStatusCode.Forbidden
                                ? L.T("buyer.profile.forbidden")
                                : ex.StatusCode == HttpStatusCode.Unauthorized
                                    ? L.T("buyer.profile.loginRequired")
                                    : L.T("buyer.status.profileFailed");
                            _bannerLevel = "error";
                        }
                    }
                }
                else
                {
                    _bannerMessage = L.T("buyer.profile.loginRequired");
                    _bannerLevel = "info";
                }

                _profileInitialized = true;
                StateHasChanged();
            }
            catch (InvalidOperationException) { }

            return;
        }

        if (_activeTab == ProfileTab.Account)
        {
            await TryInitAddressMapAsync();
        }
    }

    private string CountrySelectValue => _countryId?.ToString() ?? string.Empty;
    private string RegionSelectValue => _regionId?.ToString() ?? string.Empty;
    private string ComunaSelectValue => _comunaId?.ToString() ?? string.Empty;

    private void SelectTab(ProfileTab tab)
    {
        if (_activeTab == ProfileTab.Account && tab != ProfileTab.Account)
        {
            _ = DestroyAddressMapAsync();
        }

        _activeTab = tab;
        if (tab == ProfileTab.Account)
        {
            _mapInitialized = false;
            _ = TryInitAddressMapAsync();
        }
    }

    private string RoleCardClass(ProfileTab tab, bool active)
    {
        var selected = _activeTab == tab;
