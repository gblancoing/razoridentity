@page "/buyer/profile"
@layout global::ComunaClick.SharedUI.Layouts.BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@L.T("buyer.profile.title")</PageTitle>

<div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
    <h1 class="text-2xl font-bold">@L.T("buyer.profile.heading")</h1>
    <p class="text-sm text-[#61897c]">@L.T("buyer.profile.subtitle")</p>
    <div class="mt-6 space-y-4">
        <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" placeholder="CustomerId" @bind="CustomerId" />
        <div>
            <label class="text-xs text-[#61897c]">@L.T("buyer.profile.name")</label>
            <input class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" @bind="FullName" />
        </div>
        <div>
            <label class="text-xs text-[#61897c]">@L.T("buyer.profile.email")</label>
            <input class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" @bind="Email" />
        </div>
        <button class="bg-primary text-[#111816] px-6 py-2 rounded-lg font-bold" @onclick="HandleSave">@L.T("buyer.profile.save")</button>
        <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
    </div>
</div>

@code {
    private string CustomerId = string.Empty;
    private string FullName = string.Empty;
    private string Email = string.Empty;
    private string _statusMessage = string.Empty;
    private string _statusLevel = "info";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        var storedCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
        if (!string.IsNullOrWhiteSpace(storedCustomerId))
        {
            CustomerId = storedCustomerId;
        }
    }

    private async Task HandleSave()
    {
        _statusMessage = string.Empty;
        _statusLevel = "info";
        if (!Guid.TryParse(CustomerId, out var customerId))
        {
            _statusMessage = L.T("buyer.status.invalidCustomer");
            _statusLevel = "error";
            return;
        }

        var updated = await BuyerApi.UpdateCustomerAsync(customerId, new CustomerUpdateRequest(Email, null, FullName));
        if (updated is null)
        {
            _statusMessage = L.T("buyer.status.profileFailed");
            _statusLevel = "error";
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
            _statusMessage = L.T("buyer.status.profileUpdated");
            _statusLevel = "success";
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
