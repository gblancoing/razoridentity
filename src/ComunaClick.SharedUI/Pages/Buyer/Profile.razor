    [JSInvokable]
    public async Task OnMapLocationPicked(
        double latitude,
        double longitude,
        string? displayName,
        string? country,
        string? state,
        string? city,
        string? municipality,
        string? suburb,
        string? road,
        string? houseNumber)
    {
        Latitude = latitude;
        Longitude = longitude;
        await ApplyGeoFromReverseAsync(displayName, country, state, city, municipality, suburb, road, houseNumber);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyGeoFromReverseAsync(
        string? displayName,
        string? country,
        string? state,
        string? city,
        string? municipality,
        string? suburb,
        string? road,
        string? houseNumber)
    {
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            AddressLine = displayName.Trim();
        }
        else
        {
            var streetLine = BuildStreetLine(houseNumber, road, suburb);
            if (!string.IsNullOrWhiteSpace(streetLine))
            {
                AddressLine = streetLine;
            }
        }

        if (_countries.Count == 0)
        {
            await LoadCountriesAsync();
        }

        var countryItem = _countries.FirstOrDefault(c =>
            GeoNamesMatch(c.Name, country) || GeoNamesMatch(c.Code, country));
        if (countryItem is null)
        {
            return;
        }

        _countryId = countryItem.Id;
        _regions = await BuyerApi.GetRegionsAsync(countryItem.Id) ?? Array.Empty<PublicRegionItem>();
        _regionId = null;
        _comunaId = null;
        _comunas = Array.Empty<PublicComunaItem>();

        if (string.IsNullOrWhiteSpace(state))
        {
            return;
        }

        var regionItem = _regions.FirstOrDefault(r => GeoNamesMatch(r.Name, state))
            ?? _regions.FirstOrDefault(r => GeoNamesContain(r.Name, state));
        if (regionItem is null)
        {
            return;
        }

        _regionId = regionItem.Id;
        _comunas = await BuyerApi.GetComunasAsync(regionItem.Id) ?? Array.Empty<PublicComunaItem>();

        var comunaCandidates = new[] { city, municipality, suburb, ExtractComunaFromDisplayName(displayName) }
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var candidate in comunaCandidates)
        {
            var comunaItem = _comunas.FirstOrDefault(c => GeoNamesMatch(c.Name, candidate))
                ?? _comunas.FirstOrDefault(c => GeoNamesContain(c.Name, candidate));
            if (comunaItem is not null)
            {
                _comunaId = comunaItem.Id;
                break;
            }
        }
    }

    private static string BuildStreetLine(string? houseNumber, string? road, string? suburb)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(road))
        {
            var street = string.IsNullOrWhiteSpace(houseNumber)
                ? road.Trim()
                : $"{houseNumber.Trim()} {road.Trim()}";
            parts.Add(street);
        }

        if (!string.IsNullOrWhiteSpace(suburb))
        {
            parts.Add(suburb.Trim());
        }

        return parts.Count == 0 ? string.Empty : string.Join(", ", parts);
    }

    private static string? ExtractComunaFromDisplayName(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return null;
        }

        var segments = displayName.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 4 ? segments[3] : null;
    }

    private static bool GeoNamesMatch(string? left, string? right)
    {
        var a = NormalizeGeoName(left);
        var b = NormalizeGeoName(right);
        return a.Length > 0 && b.Length > 0 && string.Equals(a, b, StringComparison.Ordinal);
    }

    private static bool GeoNamesContain(string? haystack, string? needle)
    {
        var h = NormalizeGeoName(haystack);
        var n = NormalizeGeoName(needle);
        return h.Length > 0 && n.Length > 0 && (h.Contains(n, StringComparison.Ordinal) || n.Contains(h, StringComparison.Ordinal));
    }

    private static string NormalizeGeoName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Trim().ToLowerInvariant();
        normalized = normalized.Replace("región ", "", StringComparison.Ordinal)
            .Replace("region ", "", StringComparison.Ordinal);
        return string.Concat(normalized.Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());
    }

    private async Task TryInitAddressMapAsync()
    {
        if (_mapInitialized || _activeTab != ProfileTab.Account || !_profileInitialized)
        {
            return;
        }

        try
        {
            _mapRef ??= DotNetObjectReference.Create(this);
            var hasSavedCoords = Latitude.HasValue && Longitude.HasValue;
            await JSRuntime.InvokeVoidAsync(
                "comunaclic.initProfileAddressPicker",
                AddressMapElementId,
                _mapRef,
                Latitude,
                Longitude,
                !hasSavedCoords);
            _mapInitialized = true;
            _geoStatusMessage = string.Empty;
        }
        catch (JSException ex)
        {
            _mapInitialized = false;
            _geoStatusOk = false;
            _geoStatusMessage = ex.Message.Contains("profileAddress", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("initProfileAddressPicker", StringComparison.OrdinalIgnoreCase)
                ? L.T("buyer.profile.address.mapScriptStale")
                : ex.Message;
        }
    }

    private async Task UseMyLocationAsync()
    {
        if (!_mapInitialized)
        {
            await TryInitAddressMapAsync();
        }

        _geoStatusMessage = string.Empty;
        _isLocating = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.profileAddressUseCurrentLocation", AddressMapElementId);
        }
        catch (JSException ex)
        {
            _geoStatusOk = false;
            _geoStatusMessage = ex.Message;
            _isLocating = false;
        }
    }

    [JSInvokable]
    public Task OnGeolocationStarted()
    {
        _isLocating = true;
        _geoStatusMessage = L.T("buyer.profile.address.locating");
        _geoStatusOk = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnGeolocationFinished(bool success, string? message)
    {
        _isLocating = false;
        if (success)
        {
            _geoStatusOk = true;
            _geoStatusMessage = L.T("buyer.profile.address.located");
        }
        else
        {
            _geoStatusOk = false;
            _geoStatusMessage = string.IsNullOrWhiteSpace(message)
                ? L.T("buyer.profile.address.locationFailed")
                : message;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task DestroyAddressMapAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.destroyProfileAddressPicker", AddressMapElementId);
        }
        catch (JSException)
        {
        }

