@page "/buyer/profile"
@layout BuyerLayout
@using ComunaClick.SharedUI.Services
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Mi cuenta</PageTitle>

<div class="flex min-h-[40vh] items-center justify-center">
    <p class="text-sm text-[#61897c]">Redirigiendo a tu centro de cuenta…</p>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthState.InitializeAsync();
        }
        catch (InvalidOperationException)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        var target = AccountRoutes.ResolveLegacyBuyerProfilePath(
            Navigation.ToAbsoluteUri(Navigation.Uri),
            AuthState.IsPartnerAccount);
        Navigation.NavigateTo(target, replace: true);
    }
}
