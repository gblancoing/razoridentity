    private async Task HandleSaveAccount()
    {
        _isSavingAccount = true;
        _accountStatus = string.Empty;
        if (!AuthState.IsAuthenticated) { _accountStatus = L.T("buyer.profile.loginRequired"); _accountStatusLevel = "warning"; _isSavingAccount = false; return; }
        var tenantId = ResolveTenantId();
        if (!tenantId.HasValue) { _accountStatus = L.T("buyer.profile.tenantRequired"); _accountStatusLevel = "error"; _isSavingAccount = false; return; }

        try
        {
            if (!Guid.TryParse(CustomerId, out _))
            {
                var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantId);
                if (ensured is null) { _accountStatus = L.T("buyer.status.profileFailed"); _accountStatusLevel = "error"; _isSavingAccount = false; return; }
                ApplyCustomer(ensured);
            }

            var updated = await BuyerApi.UpdateBuyerCustomerAsync(
                new CustomerUpdateRequest(
                    Email.Trim(),
                    string.IsNullOrWhiteSpace(Phone) ? string.Empty : Phone.Trim(),
                    string.IsNullOrWhiteSpace(FullName) ? string.Empty : FullName.Trim(),
                    CountryId: _countryId,
                    RegionId: _regionId,
                    ComunaId: _comunaId,
                    Address: string.IsNullOrWhiteSpace(AddressLine) ? null : AddressLine.Trim(),
                    Latitude: Latitude,
                    Longitude: Longitude,
                    UpdateDeliveryAddress: true),
                tenantId);

            if (updated is null) { _accountStatus = L.T("buyer.status.profileFailed"); _accountStatusLevel = "error"; }
            else
            {
                ApplyCustomer(updated);
                await LoadGeoListsForCustomerAsync();
                await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                _accountStatus = L.T("buyer.status.profileUpdated");
                _accountStatusLevel = "success";
            }
        }
        catch (HttpRequestException ex)
        {
            _accountStatus = ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => L.T("buyer.profile.address.invalidGeo"),
                HttpStatusCode.Unauthorized => L.T("buyer.profile.loginRequired"),
                HttpStatusCode.Forbidden => L.T("buyer.profile.forbidden"),
                HttpStatusCode.NotFound => L.T("buyer.profile.accountNotFound"),
                _ => L.T("buyer.status.profileFailed")
            };
            _accountStatusLevel = "error";
        }
        finally { _isSavingAccount = false; }
    }

    private async Task HandleSaveProfessional()
    {
        _isSavingProfessional = true;
        _proStatus = string.Empty;
        if (!AuthState.IsAuthenticated) { _proStatus = L.T("buyer.profile.loginRequired"); _proStatusLevel = "warning"; _isSavingProfessional = false; return; }
        var tenantId = ResolveTenantId();
        if (!tenantId.HasValue) { _proStatus = L.T("buyer.profile.tenantRequired"); _proStatusLevel = "error"; _isSavingProfessional = false; return; }

        try
        {
            var result = await BuyerApi.UpsertBuyerProfessionalProfileAsync(
                new BuyerProfessionalProfileUpsertRequest(
                    tenantId,
                    string.IsNullOrWhiteSpace(FullName) ? null : FullName.Trim(),
                    string.IsNullOrWhiteSpace(ProPhone) ? Phone.Trim() : ProPhone.Trim(),
                    string.IsNullOrWhiteSpace(ProSpecialty) ? null : ProSpecialty.Trim(),
                    string.IsNullOrWhiteSpace(ProBio) ? null : ProBio.Trim(),
                    _professionalActivate),
                CancellationToken.None);

            if (result is null) { _proStatus = L.T("buyer.profile.pro.failed"); _proStatusLevel = "error"; }
            else
            {
                ApplyProfessional(result);
                _proStatus = L.T("buyer.profile.pro.saved");
                _proStatusLevel = "success";
            }
        }
        catch (HttpRequestException) { _proStatus = L.T("buyer.profile.pro.failed"); _proStatusLevel = "error"; }
        finally { _isSavingProfessional = false; }
    }

    private async Task OnAvatarFileSelected(InputFileChangeEventArgs e)
    {
        _avatarUploadMessage = string.Empty;
        _avatarUploadOk = false;
        var file = e.File;
        if (file.Size > MaxAvatarBytes)
        {
            _avatarUploadMessage = L.T("buyer.profile.avatarTooLarge");
            return;
        }

        if (!AuthState.IsAuthenticated)
        {
            _avatarUploadMessage = L.T("buyer.profile.loginRequired");
            return;
        }

        var tenantId = ResolveTenantId();
        if (!tenantId.HasValue)
        {
            _avatarUploadMessage = L.T("buyer.profile.tenantRequired");
            return;
        }

        _isUploadingAvatar = true;
        try
        {
            await using var readStream = file.OpenReadStream(MaxAvatarBytes);
            using var buffer = new MemoryStream();
            await readStream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            _avatarPreviewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            _avatarFailed = false;
            StateHasChanged();

            await using var uploadStream = new MemoryStream(bytes);
            var updated = await BuyerApi.UploadBuyerCustomerAvatarAsync(
                uploadStream,
                file.Name,
                file.ContentType,
                tenantId);

            if (updated is null)
            {
                _avatarUploadMessage = L.T("buyer.profile.avatarFailed");
                return;
            }

            ApplyCustomer(updated);
            _avatarPreviewDataUrl = null;
            _avatarUploadMessage = L.T("buyer.profile.avatarUploaded");
            _avatarUploadOk = true;
        }
        catch (HttpRequestException)
        {
            _avatarUploadMessage = L.T("buyer.profile.avatarFailed");
        }
        finally
        {
            _isUploadingAvatar = false;
        }
    }

    private void HandleAvatarError() => _avatarFailed = true;
    private void HandleChange() => InvokeAsync(StateHasChanged);
    public async ValueTask DisposeAsync()
    {
        await DestroyAddressMapAsync();
        _mapRef?.Dispose();
        L.OnChange -= HandleChange;
    }

