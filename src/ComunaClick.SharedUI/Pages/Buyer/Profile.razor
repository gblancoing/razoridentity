        FullName = c.FullName ?? string.Empty;
        Email = c.Email ?? Email;
        Phone = c.Phone ?? string.Empty;
        AvatarUrl = c.AvatarUrl ?? string.Empty;
        _avatarFailed = false;
        if (string.IsNullOrWhiteSpace(ProPhone)) ProPhone = Phone;
