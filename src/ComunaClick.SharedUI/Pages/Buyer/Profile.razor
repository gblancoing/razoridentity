        if (!active) return baseCls + "border-[#e5e7eb] bg-[#f9fafb] opacity-60";
        return selected
            ? baseCls + "border-[#3b6700] bg-[#f0fdf4] ring-2 ring-[#86efac]/50 text-[#14532d]"
            : baseCls + "border-[#dbe6e2] bg-white hover:border-primary/30 text-[#2c2f30]";
    }

    private void ApplyCustomer(Customer c)
    {
