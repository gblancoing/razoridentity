@page "/buyer"
@layout BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L.T("buyer.home.title")</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-bold">@L.T("buyer.home.heading")</h1>
        <p class="text-sm text-[#61897c]">@L.T("buyer.home.subtitle")</p>
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        <div class="flex flex-col md:flex-row gap-3">
            <input class="flex-1 rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" placeholder="@L.T("buyer.search.placeholder")" @bind="_query" />
            <select class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" @bind="_type">
                <option value="">@L.T("buyer.search.categoryAll")</option>
                <option value="products">Productos</option>
                <option value="services">Servicios</option>
                <option value="professionals">Profesionales</option>
            </select>
            <button class="bg-primary text-[#111816] px-6 h-12 rounded-lg font-bold" @onclick="SearchAsync">@L.T("buyer.search.action")</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
            <p class="text-xs text-[#61897c]">@L.T("buyer.home.card1.label")</p>
            <p class="text-lg font-bold">@L.T("buyer.home.card1.title")</p>
            <p class="text-sm text-[#61897c]">@L.T("buyer.home.card1.desc")</p>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
            <p class="text-xs text-[#61897c]">@L.T("buyer.home.card2.label")</p>
            <p class="text-lg font-bold">@L.T("buyer.home.card2.title")</p>
            <p class="text-sm text-[#61897c]">@L.T("buyer.home.card2.desc")</p>
        </div>
        <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
            <p class="text-xs text-[#61897c]">@L.T("buyer.home.card3.label")</p>
            <p class="text-lg font-bold">@L.T("buyer.home.card3.title")</p>
            <p class="text-sm text-[#61897c]">@L.T("buyer.home.card3.desc")</p>
        </div>
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        <h2 class="font-semibold mb-3">@L.T("buyer.search.action")</h2>
        @if (_isLoading)
        {
            <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos buscando los mejores resultados para tu comuna." Compact="true" />
        }
        else if (_results.Count == 0)
        {
            <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
        }
        else
        {
            <div class="space-y-3 text-sm">
                @foreach (var item in _results)
                {
                    <div class="flex items-center justify-between gap-4 border-b border-gray-100 dark:border-gray-800 pb-3 last:border-b-0">
                        <div>
                            <p class="font-semibold">@item.Name</p>
                            <p class="text-xs text-[#61897c]">@item.Category</p>
                        </div>
                        <div class="flex items-center gap-3">
                            @if (item.Price.HasValue)
                            {
                                <span class="font-semibold">@($"{item.Price.Value:N0}")</span>
                            }
                            <a href="@(item.CtaHref ?? $"/buyer/detail/{item.Type}/{item.Id}")" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-xs">
                                @(item.CtaLabel ?? "Ver detalle")
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly List<SearchResultItem> _results = new();
    private string _statusMessage = "—";
    private string _statusLevel = "info";
    private bool _isLoading;
    private string? _query;
    private string? _type;
    private ComunaClick.Shared.Api.Buyer.GeoFilter? _geo;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _geo = ReadGeoFromQuery();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _isLoading = true;
        _results.Clear();
        var results = await BuyerApi.SearchAsync(_query, _type, 10, _geo);
        if (results is not null)
        {
            _results.AddRange(results);
        }
        if (_results.Count == 0)
        {
            _statusMessage = L.T("buyer.status.noResults");
            _statusLevel = "warning";
        }
        else
        {
            _statusMessage = string.Empty;
            _statusLevel = "info";
        }
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private ComunaClick.Shared.Api.Buyer.GeoFilter? ReadGeoFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        Guid? Read(string key)
        {
            foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = pair.Split('=', 2);
                if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase)) continue;
                return parts.Length > 1 && Guid.TryParse(Uri.UnescapeDataString(parts[1]), out var parsed) ? parsed : null;
            }
            return null;
        }

        var countryId = Read("countryId");
        var regionId = Read("regionId");
        var comunaId = Read("comunaId");
        return countryId.HasValue || regionId.HasValue || comunaId.HasValue
            ? new ComunaClick.Shared.Api.Buyer.GeoFilter(countryId, regionId, comunaId)
            : null;
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
