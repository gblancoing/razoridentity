@page "/buyer"
@layout BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject NavigationManager Navigation
@using ComunaClick.SharedUI.Services
@implements IDisposable

<PageTitle>@L.T("buyer.home.title")</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-bold">@L.T("buyer.home.heading")</h1>
        <p class="text-sm text-[#61897c]">@L.T("buyer.home.subtitle")</p>
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        <div class="flex flex-col md:flex-row gap-3">
            <input class="flex-1 rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" placeholder="@L.T("buyer.search.placeholder")" @bind="_query" />
            <select class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12" @bind="_type">
                <option value="">@L.T("buyer.search.categoryAll")</option>
                <option value="products">Productos</option>
                <option value="services">Servicios</option>
                <option value="professionals">Profesionales</option>
            </select>
            <button class="bg-primary text-[#111816] px-6 h-12 rounded-lg font-bold" @onclick="SearchAsync">@L.T("buyer.search.action")</button>
        </div>
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-xs text-[#61897c] uppercase tracking-[0.16em] font-bold">Categorías</p>
                <p class="text-lg font-bold">Explora las categorías existentes</p>
            </div>
            <a href="/categorias" class="text-sm font-bold text-primary">Ver todas</a>
        </div>

        @if (_categoriesLoading)
        {
            <BrandedLoading Title="Cargando categorías" Message="Estamos preparando las categorías disponibles para tu búsqueda." Compact="true" />
        }
        else if (_categories.Count == 0)
        {
            <StatusBanner Message="@_categoriesStatusMessage" Level="warning" />
        }
        else
        {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var category in _categories)
                {
                    var image = CategoryVisualService.ResolveImage(category.Code, category.Name);
                    <a href="@GetCategoryHref(category)"
                       class="group min-h-[180px] rounded-xl overflow-hidden bg-cover bg-center flex items-end p-4 transition-transform hover:scale-[1.02]"
                       style="@BuildCategoryStyle(image)">
                        <div>
                            <p class="text-xs uppercase tracking-[0.16em] font-bold text-white/80">@category.Code</p>
                            <p class="text-base font-bold text-white">@category.Name</p>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-4">
        <h2 class="font-semibold mb-3">@L.T("buyer.search.action")</h2>
        @if (_isLoading)
        {
            <BrandedLoading Title="@(L.T("ui.loading"))" Message="Estamos buscando los mejores resultados para tu comuna." Compact="true" />
        }
        else if (_results.Count == 0)
        {
            <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
        }
        else
        {
            <div class="space-y-3 text-sm">
                @foreach (var item in _results)
                {
                    <div class="flex items-center justify-between gap-4 border-b border-gray-100 dark:border-gray-800 pb-3 last:border-b-0">
                        <div>
                            <p class="font-semibold">@item.Name</p>
                            <p class="text-xs text-[#61897c]">@item.Category</p>
                        </div>
                        <div class="flex items-center gap-3">
                            @if (item.Price.HasValue)
                            {
                                <span class="font-semibold">@($"{item.Price.Value:N0}")</span>
                            }
                            <a href="@(item.CtaHref ?? $"/buyer/detail/{item.Type}/{item.Id}")" class="bg-primary text-[#111816] px-4 py-2 rounded-lg font-bold text-xs">
                                @(item.CtaLabel ?? "Ver detalle")
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly List<SearchResultItem> _results = new();
    private readonly List<ComunaClick.Shared.Api.Buyer.PublicCategoryItem> _categories = new();
    private string _statusMessage = "—";
    private string _statusLevel = "info";
    private bool _isLoading;
    private bool _categoriesLoading = true;
    private string? _query;
    private string? _type;
    private ComunaClick.Shared.Api.Buyer.GeoFilter? _geo;
    private string _categoriesStatusMessage = "No encontramos categorías activas.";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        _geo = ReadGeoFromQuery();
        await LoadCategoriesAsync();
        await SearchAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var items = await BuyerApi.GetProductCategoriesAsync();
            if (items is not null)
            {
                _categories.AddRange(items
                    .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                    .GroupBy(x => NormalizeCategoryName(x.Name))
                    .Select(g => g
                        .OrderByDescending(x => !string.IsNullOrWhiteSpace(CategoryVisualService.ResolveImage(x.Code, x.Name)))
                        .ThenBy(x => x.Name)
                        .First()));
            }
        }
        catch (HttpRequestException ex)
        {
            _categoriesStatusMessage = $"No se pudieron cargar las categorías ({(int?)ex.StatusCode ?? 0}).";
        }
        finally
        {
            _categoriesLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        _isLoading = true;
        _results.Clear();
        var results = await BuyerApi.SearchAsync(_query, _type, 10, _geo);
        if (results is not null)
        {
            _results.AddRange(results);
        }
        if (_results.Count == 0)
        {
            _statusMessage = L.T("buyer.status.noResults");
            _statusLevel = "warning";
        }
        else
        {
            _statusMessage = string.Empty;
            _statusLevel = "info";
        }
        _isLoading = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetCategoryHref(ComunaClick.Shared.Api.Buyer.PublicCategoryItem category)
        => $"/categorias/{CategoryVisualService.ToSlug(category.Code, category.Name)}?code={Uri.EscapeDataString(category.Code)}";

    private static string BuildCategoryStyle(string? image)
    {
        return !string.IsNullOrWhiteSpace(image)
            ? $"background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%), url('{image}');"
            : "background-image: linear-gradient(135deg, rgba(59,103,0,0.95) 0%, rgba(118,188,33,0.8) 55%, rgba(167,242,85,0.55) 100%);";
    }

    private static string NormalizeCategoryName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim()
            .ToLowerInvariant()
            .Replace("á", "a", StringComparison.Ordinal)
            .Replace("é", "e", StringComparison.Ordinal)
            .Replace("í", "i", StringComparison.Ordinal)
            .Replace("ó", "o", StringComparison.Ordinal)
            .Replace("ú", "u", StringComparison.Ordinal)
            .Replace("ñ", "n", StringComparison.Ordinal);
    }

    private ComunaClick.Shared.Api.Buyer.GeoFilter? ReadGeoFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        Guid? Read(string key)
        {
            foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = pair.Split('=', 2);
                if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase)) continue;
                return parts.Length > 1 && Guid.TryParse(Uri.UnescapeDataString(parts[1]), out var parsed) ? parsed : null;
            }
            return null;
        }

        var countryId = Read("countryId");
        var regionId = Read("regionId");
        var comunaId = Read("comunaId");
        return countryId.HasValue || regionId.HasValue || comunaId.HasValue
            ? new ComunaClick.Shared.Api.Buyer.GeoFilter(countryId, regionId, comunaId)
            : null;
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
