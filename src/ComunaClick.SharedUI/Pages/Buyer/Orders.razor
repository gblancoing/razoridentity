@page "/buyer/orders"
@layout BuyerLayout
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable
@using System.Text.Json
@using BuyerOrder = ComunaClick.Shared.Api.Buyer.OrderTracking
@using BuyerBooking = ComunaClick.Shared.Api.Buyer.BookingTracking

<PageTitle>@L.T("buyer.orders.title")</PageTitle>

<div class="space-y-8">
    <section class="rounded-[2rem] bg-gradient-to-br from-[#f5f6f7] via-white to-[#eff1f2] border border-[#dadddf] px-6 py-8 sm:px-8 sm:py-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-3xl space-y-3">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">@L.T("buyer.orders.eyebrow")</p>
                <h1 class="text-3xl font-black tracking-[-0.04em] text-[#2c2f30] sm:text-4xl">@L.T("buyer.orders.heading")</h1>
                <p class="text-sm leading-relaxed text-[#595c5d]">@L.T("buyer.orders.subtitle")</p>
                <a href="/categorias" class="mt-1 inline-flex text-sm font-semibold text-[#3b6700] hover:underline">@L.T("buyer.orders.tipCta")</a>
            </div>
            <div class="w-full max-w-sm rounded-[1.75rem] border border-white/60 bg-white/90 p-5 shadow-[0_18px_40px_-28px_rgba(0,0,0,0.4)] sm:p-6">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#7b8081]">@L.T("buyer.orders.tipTitle")</p>
                <p class="mt-2 text-sm leading-relaxed text-[#595c5d]">@L.T("buyer.orders.tipBody")</p>
            </div>
        </div>
    </section>

    <section class="rounded-[2rem] border border-[#dadddf] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] md:p-8">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
            <div>
                <label for="cc-order-id" class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#7b8081]">@L.T("buyer.orders.labelOrder")</label>
                <input id="cc-order-id"
                       class="mt-1.5 h-12 w-full rounded-2xl border border-[#dadddf] px-4 text-sm text-[#2c2f30] placeholder:text-[#9aa0a1]"
                       placeholder="@L.T("buyer.orders.placeholderOrder")"
                       autocomplete="off"
                       @bind="OrderId" />
            </div>
            <div>
                <label for="cc-booking-id" class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#7b8081]">@L.T("buyer.orders.labelBooking")</label>
                <input id="cc-booking-id"
                       class="mt-1.5 h-12 w-full rounded-2xl border border-[#dadddf] px-4 text-sm text-[#2c2f30] placeholder:text-[#9aa0a1]"
                       placeholder="@L.T("buyer.orders.placeholderBooking")"
                       autocomplete="off"
                       @bind="BookingId" />
            </div>
        </div>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <button type="button"
                    class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-6 py-3 text-sm font-bold text-[#d9ffad] sm:min-w-[200px]"
                    @onclick="HandleLookup">
                @L.T("buyer.orders.consultCta")
            </button>
            <a href="/account/profile" class="text-center text-sm font-semibold text-[#3b6700] hover:underline sm:ml-2 sm:text-left">@L.T("buyer.orders.profileLink")</a>
        </div>

        @if (_hasRecentIds)
        {
            <div class="mt-6 border-t border-[#e8ebed] pt-5">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">@L.T("buyer.orders.recentLabel")</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                    @if (HasRecentOrder)
                    {
                        <div class="inline-flex items-center gap-1 rounded-2xl border border-[#dadddf] bg-[#f8faf8] pl-3 pr-1 py-1 text-sm text-[#2c2f30]">
                            <span class="text-xs text-[#595c5d]">@L.T("buyer.orders.recentOrder")</span>
                            <span class="font-mono text-xs">@ShortIdDisplay(_recentOrderId!)</span>
                            <button type="button" class="rounded-xl px-2 py-1 text-xs font-bold text-[#3b6700] hover:bg-[#e8f5d9]" @onclick="UseRecentOrderAsync">@L.T("buyer.orders.recentUse")</button>
                        </div>
                    }
                    @if (HasRecentBooking)
                    {
                        <div class="inline-flex items-center gap-1 rounded-2xl border border-[#dadddf] bg-[#f8faf8] pl-3 pr-1 py-1 text-sm text-[#2c2f30]">
                            <span class="text-xs text-[#595c5d]">@L.T("buyer.orders.recentBooking")</span>
                            <span class="font-mono text-xs">@ShortIdDisplay(_recentBookingId!)</span>
                            <button type="button" class="rounded-xl px-2 py-1 text-xs font-bold text-[#3b6700] hover:bg-[#e8f5d9]" @onclick="UseRecentBookingAsync">@L.T("buyer.orders.recentUse")</button>
                        </div>
                    }
                    <button type="button" class="ml-0 text-xs font-semibold text-[#8a8f90] hover:text-[#2c2f30] sm:ml-2" @onclick="ClearRecentAsync">@L.T("buyer.orders.clearRecent")</button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="mt-5">
                <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
            </div>
        }
    </section>

    @if (!_browserCustomerReady || _isLoading)
    {
        <section class="rounded-[1.5rem] border border-[#dadddf] bg-white p-6">
            <BrandedLoading Title="@L.T("buyer.orders.loadingTitle")" Message="@L.T("buyer.orders.loadingMessage")" Compact="true" />
        </section>
    }
    else if (_order is null && _booking is null)
    {
        <section class="rounded-[1.5rem] border border-dashed border-[#c9ced1] bg-[#fafbfb] p-6 text-center sm:p-8">
            <p class="text-lg font-black tracking-[-0.02em] text-[#2c2f30]">@L.T("buyer.orders.emptyStripTitle")</p>
            <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-[#595c5d]">@L.T("buyer.orders.emptyStripBody")</p>
            <a href="/categorias" class="mt-4 inline-flex items-center justify-center rounded-2xl border border-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#3b6700] hover:bg-[#f4f9ef]">@L.T("buyer.orders.emptyBrowse")</a>
        </section>
    }
    else
    {
        <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <article class="rounded-2xl border border-[#e8ebed] bg-white p-5 shadow-sm">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081]">@L.T("buyer.orders.cardOrder")</p>
                <h2 class="mt-1 text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@(_order is null ? "—" : ShortId(_order.Id))</h2>
                <p class="mt-1 text-xs text-[#595c5d]">@L.T("buyer.orders.stateLabel"): @(_order is null ? L.T("buyer.orders.stateNoQuery") : LocalizedOrderStatus(_order.Status))</p>
            </article>
            <article class="rounded-2xl border border-[#e8ebed] bg-white p-5 shadow-sm">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081]">@L.T("buyer.orders.cardBooking")</p>
                <h2 class="mt-1 text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@(_booking is null ? "—" : ShortId(_booking.Id))</h2>
                <p class="mt-1 text-xs text-[#595c5d]">@L.T("buyer.orders.stateLabel"): @(_booking is null ? L.T("buyer.orders.stateNoQuery") : LocalizedBookingStatus(_booking.Status))</p>
            </article>
            <article class="rounded-2xl border border-[#e8ebed] bg-white p-5 shadow-sm md:col-span-1">
                <p class="text-[10px] font-bold tracking-[0.15em] text-[#7b8081]">@L.T("buyer.orders.cardMovement")</p>
                <h2 class="mt-1 text-xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("buyer.orders.stateUpdated")</h2>
                <p class="mt-1 text-xs text-[#595c5d]">@L.T("buyer.orders.stateUpdatedBody")</p>
            </article>
        </section>
    }

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
        <section class="rounded-[2rem] border border-[#dadddf] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] md:p-8">
            <div class="mb-5">
                <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#7b8081]">@L.T("buyer.orders.sectionOrderLabel")</p>
                <h2 class="text-xl font-black tracking-[-0.03em] text-[#2c2f30] sm:text-2xl">@L.T("buyer.orders.sectionOrderTitle")</h2>
            </div>

            @if (!_browserCustomerReady || _isLoading)
            {
                <BrandedLoading Title="@L.T("buyer.orders.loadingTitle")" Message="@L.T("buyer.orders.loadingMessage")" Compact="true" />
            }
            else if (_order is null)
            {
                <StatusBanner Message="@L.T("buyer.orders.emptyOrderDetail")" Level="info" />
            }
            else
            {
                <div class="space-y-5">
                    <article class="rounded-3xl bg-[#f5f6f7] p-5">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@(_order.Partner?.Name ?? "Negocio asociado")</p>
                                <p class="mt-2 text-sm text-[#595c5d]">@FormatOrderStatus(_order.Status)</p>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">Total</p>
                                <p class="text-2xl font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(_order.TotalAmount, _order.Currency)</p>
                            </div>
                        </div>
                        <div class="mt-4 grid grid-cols-1 gap-3 text-sm text-[#595c5d] sm:grid-cols-2 sm:gap-4">
                            <p><span class="font-bold text-[#2c2f30]">Creada:</span> @_order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                            <p><span class="font-bold text-[#2c2f30]">Actualizada:</span> @_order.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                            @if (!string.IsNullOrWhiteSpace(_order.Partner?.Address))
                            {
                                <p class="sm:col-span-2"><span class="font-bold text-[#2c2f30]">Dirección:</span> @_order.Partner.Address</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_order.Partner?.Phone))
                            {
                                <p class="sm:col-span-2"><span class="font-bold text-[#2c2f30]">Contacto:</span> @_order.Partner.Phone</p>
                            }
                        </div>
                    </article>

                    @if (_order.Partner?.Id is Guid partnerId && _customerId is Guid customerId)
                    {
                        <PendingOrderPaymentPanel OrderId="_order.Id"
                                                  CustomerId="customerId"
                                                  PartnerId="partnerId"
                                                  Status="_order.Status" />
                    }

                    @if (!string.IsNullOrWhiteSpace(_order.DeliveryAddress))
                    {
                        <p class="text-sm text-[#595c5d]"><span class="font-bold text-[#2c2f30]">@L.T("buyer.checkout.guest.address"):</span> @_order.DeliveryAddress</p>
                    }

                    <div class="space-y-3">
                        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">Productos</p>
                        @foreach (var item in _order.Items ?? Array.Empty<ComunaClick.Shared.Api.Buyer.OrderTrackingItem>())
                        {
                            <article class="rounded-3xl border border-[#dadddf] p-5">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-base font-black tracking-[-0.02em] text-[#2c2f30]">@item.ProductName</p>
                                        <p class="mt-1 text-sm text-[#595c5d]">Cantidad: @item.Quantity · Unitario: @FormatMoney(item.UnitPrice, _order.Currency)</p>
                                    </div>
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(item.TotalPrice, _order.Currency)</p>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="rounded-[2rem] border border-[#dadddf] bg-white p-6 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] md:p-8">
            <div class="mb-5">
                <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#7b8081]">@L.T("buyer.orders.sectionBookingLabel")</p>
                <h2 class="text-xl font-black tracking-[-0.03em] text-[#2c2f30] sm:text-2xl">@L.T("buyer.orders.sectionBookingTitle")</h2>
            </div>

            @if (!_browserCustomerReady || _isLoading)
            {
                <BrandedLoading Title="@L.T("buyer.orders.loadingTitle")" Message="@L.T("buyer.orders.loadingMessage")" Compact="true" />
            }
            else if (_booking is null)
            {
                @if (_isLoadingRecentBookings)
                {
                    <BrandedLoading Title="Cargando reservas" Message="Estamos buscando tus reservas recientes." Compact="true" />
                }
                else if (_recentBookings.Count > 0)
                {
                    <div class="space-y-3">
                        <p class="text-xs text-[#595c5d]">Mostrando tus reservas recientes. Selecciona una para ver el detalle completo.</p>
                        @foreach (var booking in _recentBookings)
                        {
                            <button type="button"
                                    class="block w-full rounded-3xl border border-[#dadddf] p-5 text-left hover:bg-[#f8faf8] transition-colors"
                                    @onclick="() => SelectRecentBookingAsync(booking)">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-base font-black tracking-[-0.02em] text-[#2c2f30]">@(booking.Service?.Name ?? "Servicio reservado")</p>
                                        <p class="text-sm text-[#595c5d] mt-1">@(booking.Partner?.Name ?? "Negocio") · @booking.StartAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                                        <p class="text-sm text-[#595c5d] mt-1">@FormatBookingStatus(booking.Status)</p>
                                    </div>
                                    <p class="text-lg font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(booking.Amount, booking.Currency)</p>
                                </div>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <StatusBanner Message="Ingresa un `BookingId` válido para ver el seguimiento detallado de la reserva." Level="warning" />
                }
            }
            else
            {
                <div class="space-y-5">
                    <article class="rounded-3xl bg-[#f5f6f7] p-5">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-lg font-black tracking-[-0.03em] text-[#2c2f30]">@(_booking.Service?.Name ?? "Servicio reservado")</p>
                                <p class="mt-2 text-sm text-[#595c5d]">@FormatBookingStatus(_booking.Status)</p>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">Monto</p>
                                <p class="text-2xl font-black tracking-[-0.03em] text-[#3b6700]">@FormatMoney(_booking.Amount, _booking.Currency)</p>
                            </div>
                        </div>
                        <div class="mt-4 grid grid-cols-1 gap-3 text-sm text-[#595c5d]">
                            <p><span class="font-bold text-[#2c2f30]">Negocio:</span> @(_booking.Partner?.Name ?? "Sin negocio")</p>
                            @if (!string.IsNullOrWhiteSpace(_booking.Professional?.Name))
                            {
                                <p><span class="font-bold text-[#2c2f30]">Profesional:</span> @_booking.Professional.Name</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_booking.Professional?.Specialty))
                            {
                                <p><span class="font-bold text-[#2c2f30]">Especialidad:</span> @_booking.Professional.Specialty</p>
                            }
                            <p><span class="font-bold text-[#2c2f30]">Inicio:</span> @_booking.StartAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                            <p><span class="font-bold text-[#2c2f30]">Fin:</span> @_booking.EndAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                            @if (!string.IsNullOrWhiteSpace(_booking.Service?.Category))
                            {
                                <p><span class="font-bold text-[#2c2f30]">Categoría:</span> @_booking.Service.Category</p>
                            }
                            @if (_booking.Service is not null)
                            {
                                <p><span class="font-bold text-[#2c2f30]">Duración:</span> @_booking.Service.DurationMinutes min</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_booking.CancellationPolicy))
                            {
                                <p><span class="font-bold text-[#2c2f30]">Política:</span> @FormatCancellationPolicy(_booking.CancellationPolicy)</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_booking.Professional?.Phone))
                            {
                                <p><span class="font-bold text-[#2c2f30]">Teléfono profesional:</span> @_booking.Professional.Phone</p>
                            }
                        </div>
                    </article>

                    @if (_booking.Partner?.Id is Guid bookingPartnerId && _customerId is Guid bookingCustomerId)
                    {
                        <PendingOrderPaymentPanel OrderId="@(_booking.Id)"
                                                  CustomerId="bookingCustomerId"
                                                  PartnerId="bookingPartnerId"
                                                  Status="_booking.Status"
                                                  IsBooking="true" />
                    }

                    @if (!string.IsNullOrWhiteSpace(_booking.Service?.Description))
                    {
                        <article class="rounded-3xl border border-[#dadddf] p-5">
                            <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]">Detalle del servicio</p>
                            <p class="text-sm leading-7 text-[#595c5d]">@_booking.Service.Description</p>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private string _statusMessage = string.Empty;
    private string _statusLevel = "info";
    private string OrderId = string.Empty;
    private string BookingId = string.Empty;
    private BuyerOrder? _order;
    private BuyerBooking? _booking;
    private readonly List<BuyerBooking> _recentBookings = new();
    private bool _isLoading;
    private bool _isLoadingRecentBookings;
    private Guid? _customerId;
    private bool _browserCustomerReady;
    private string? _recentOrderId;
    private string? _recentBookingId;

    private bool HasRecentOrder => !string.IsNullOrWhiteSpace(_recentOrderId) && Guid.TryParse(_recentOrderId, out _);
    private bool HasRecentBooking => !string.IsNullOrWhiteSpace(_recentBookingId) && Guid.TryParse(_recentBookingId, out _);
    private bool _hasRecentIds;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        OrderId = GetQueryParameter(uri.Query, "orderId") ?? string.Empty;
        BookingId = GetQueryParameter(uri.Query, "bookingId") ?? string.Empty;
        var customerFromQuery = GetQueryParameter(uri.Query, "customerId");
        if (Guid.TryParse(customerFromQuery, out var parsedCustomer) && parsedCustomer != Guid.Empty)
        {
            _customerId = parsedCustomer;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_browserCustomerReady)
        {
            return;
        }

        try
        {
            if (_customerId is Guid presetCustomer && presetCustomer != Guid.Empty)
            {
                await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", presetCustomer.ToString());
            }

            var rawCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
            if (Guid.TryParse(rawCustomerId, out var customerId) && customerId != Guid.Empty)
            {
                _customerId = customerId;
            }

            await LoadRecentTrackingFromStorageAsync();

            _browserCustomerReady = true;

            if (!string.IsNullOrWhiteSpace(OrderId) || !string.IsNullOrWhiteSpace(BookingId))
            {
                await HandleLookup();
            }
            else
            {
                await LoadRecentBookingsAsync();
            }

            await TryHandleMercadoPagoReturnAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            _browserCustomerReady = false;
        }
    }

    private async Task LoadRecentTrackingFromStorageAsync()
    {
        try
        {
            var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getLastTracking");
            if (string.IsNullOrWhiteSpace(raw))
            {
                return;
            }

            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("orderId", out var o) && o.ValueKind == JsonValueKind.String)
            {
                var s = o.GetString();
                if (!string.IsNullOrWhiteSpace(s) && Guid.TryParse(s, out _))
                {
                    _recentOrderId = s;
                }
            }
            if (doc.RootElement.TryGetProperty("bookingId", out var b) && b.ValueKind == JsonValueKind.String)
            {
                var s = b.GetString();
                if (!string.IsNullOrWhiteSpace(s) && Guid.TryParse(s, out _))
                {
                    _recentBookingId = s;
                }
            }

            _hasRecentIds = HasRecentOrder || HasRecentBooking;
        }
        catch (JsonException)
        {
        }
    }

    private async Task UseRecentOrderAsync()
    {
        if (!HasRecentOrder)
        {
            return;
        }
        OrderId = _recentOrderId!;
        BookingId = string.Empty;
        await HandleLookup();
    }

    private async Task UseRecentBookingAsync()
    {
        if (!HasRecentBooking)
        {
            return;
        }
        OrderId = string.Empty;
        BookingId = _recentBookingId!;
        await HandleLookup();
    }

    private async Task ClearRecentAsync()
    {
        _recentOrderId = null;
        _recentBookingId = null;
        _hasRecentIds = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.setLastTracking");
        }
        catch
        {
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLookup()
    {
        _statusMessage = string.Empty;
        _statusLevel = "info";
        _order = null;
        _booking = null;
        _recentBookings.Clear();
        _isLoading = true;

        try
        {
            if (_customerId is null || _customerId == Guid.Empty)
            {
                _statusMessage = L.T("buyer.orders.customerMissing");
                _statusLevel = "warning";
                return;
            }

            if (Guid.TryParse(OrderId, out var orderId))
            {
                _order = await BuyerApi.GetOrderAsync(orderId, _customerId.Value);
            }

            if (Guid.TryParse(BookingId, out var bookingId))
            {
                _booking = await BuyerApi.GetBookingAsync(bookingId, _customerId.Value);
            }

            if (_booking is null && string.IsNullOrWhiteSpace(BookingId))
            {
                await LoadRecentBookingsAsync();
            }

            if (_order is null && _booking is null)
            {
                _statusMessage = L.T("buyer.status.lookupInvalid");
                _statusLevel = "warning";
            }
            else
            {
                _statusMessage = L.T("buyer.status.lookupOk");
                _statusLevel = "success";
                await PersistLastTrackingFromInputsAsync();
                if (_order is not null && string.Equals(_order.Status, "paid", StringComparison.OrdinalIgnoreCase))
                {
                    await JSRuntime.InvokeVoidAsync("comunaclic.clearGuestCart");
                    await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", null);
                }
            }
        }
        catch (HttpRequestException)
        {
            _statusMessage = L.T("buyer.orders.trackingError");
            _statusLevel = "error";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadRecentBookingsAsync()
    {
        _isLoadingRecentBookings = true;
        try
        {
            var recent = await BuyerApi.GetRecentBookingsAsync(8);
            _recentBookings.Clear();
            if (recent is not null)
            {
                _recentBookings.AddRange(recent);
            }
        }
        catch
        {
            _recentBookings.Clear();
        }
        finally
        {
            _isLoadingRecentBookings = false;
        }
    }

    private async Task SelectRecentBookingAsync(BuyerBooking booking)
    {
        BookingId = booking.Id.ToString();
        OrderId = string.Empty;
        Navigation.NavigateTo($"/buyer/orders?bookingId={booking.Id}", replace: true);
        await HandleLookup();
    }

    private async Task TryHandleMercadoPagoReturnAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var status = GetQueryParameter(uri.Query, "collection_status")
            ?? GetQueryParameter(uri.Query, "status");
        if (string.IsNullOrWhiteSpace(status))
        {
            return;
        }

        if (string.Equals(status, "approved", StringComparison.OrdinalIgnoreCase))
        {
            _statusMessage = L.T("buyer.checkout.mp.returnApproved");
            _statusLevel = "success";
            await JSRuntime.InvokeVoidAsync("comunaclic.clearGuestCart");
            await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", null);
        }
        else if (string.Equals(status, "pending", StringComparison.OrdinalIgnoreCase))
        {
            _statusMessage = L.T("buyer.checkout.mp.returnPending");
            _statusLevel = "info";
        }
        else
        {
            _statusMessage = L.T("buyer.checkout.mp.returnRejected");
            _statusLevel = "warning";
        }
    }

    private async Task PersistLastTrackingFromInputsAsync()
    {
        try
        {
            string? o = _recentOrderId;
            string? b = _recentBookingId;
            var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getLastTracking");
            if (!string.IsNullOrWhiteSpace(raw))
            {
                using var prior = JsonDocument.Parse(raw);
                if (prior.RootElement.TryGetProperty("orderId", out var po) && po.ValueKind == JsonValueKind.String)
                {
                    var t = po.GetString();
                    if (!string.IsNullOrWhiteSpace(t) && Guid.TryParse(t, out _)) o = t;
                }
                if (prior.RootElement.TryGetProperty("bookingId", out var pb) && pb.ValueKind == JsonValueKind.String)
                {
                    var t = pb.GetString();
                    if (!string.IsNullOrWhiteSpace(t) && Guid.TryParse(t, out _)) b = t;
                }
            }

            if (Guid.TryParse(OrderId, out _)) o = OrderId;
            if (Guid.TryParse(BookingId, out _)) b = BookingId;

            var map = new Dictionary<string, string>();
            if (!string.IsNullOrWhiteSpace(o) && Guid.TryParse(o, out _)) map["orderId"] = o;
            if (!string.IsNullOrWhiteSpace(b) && Guid.TryParse(b, out _)) map["bookingId"] = b;

            if (map.Count == 0)
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("comunaclic.setLastTracking", JsonSerializer.Serialize(map));
            _recentOrderId = map.GetValueOrDefault("orderId");
            _recentBookingId = map.GetValueOrDefault("bookingId");
            _hasRecentIds = HasRecentOrder || HasRecentBooking;
        }
        catch
        {
        }
    }
    private void HandleChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string ShortId(Guid id)
        => id.ToString()[..8];

    private static string? ShortIdDisplay(string id)
    {
        if (Guid.TryParse(id, out var g)) return g.ToString()[..8] + "…";
        if (id.Length > 8) return id[..8] + "…";
        return id;
    }

    private string LocalizedOrderStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "—";
        var key = "buyer.track.order." + status;
        var t = L.T(key);
        return t == key ? status : t;
    }

    private string LocalizedBookingStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "—";
        var key = "buyer.track.booking." + status;
        var t = L.T(key);
        return t == key ? status : t;
    }

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";

    private static string FormatOrderStatus(string? status)
        => status switch
        {
            "paid" => "Pago confirmado y registrado.",
            "payment_pending" => "Pago pendiente de confirmación.",
            "cancelled" => "Pedido cancelado.",
            _ when !string.IsNullOrWhiteSpace(status) => $"Estado actual: {status}",
            _ => "Estado no informado."
        };

    private static string FormatBookingStatus(string? status)
        => status switch
        {
            "confirmed" => "Reserva confirmada.",
            "payment_pending" => "Reserva pendiente de pago.",
            "cancelled" => "Reserva cancelada.",
            _ when !string.IsNullOrWhiteSpace(status) => $"Estado actual: {status}",
            _ => "Estado no informado."
        };

    private static string FormatCancellationPolicy(string policy)
    {
        if (string.IsNullOrWhiteSpace(policy))
        {
            return "Política no informada.";
        }

        if (!policy.TrimStart().StartsWith("{", StringComparison.Ordinal))
        {
            return policy;
        }

        try
        {
            using var doc = JsonDocument.Parse(policy);
            if (doc.RootElement.TryGetProperty("label", out var labelElement))
            {
                var label = labelElement.GetString();
                if (!string.IsNullOrWhiteSpace(label))
                {
                    return label;
                }
            }
        }
        catch (JsonException)
        {
        }

        return policy;
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            }
        }

        return null;
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
