@page "/buyer/booking"
@layout BuyerLayout
@using System.Text.Json
@using ComunaClick.Common.Funnel
@using System.Globalization
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@L.T("buyer.booking.title")</PageTitle>

@if (_initializing)
{
    <BrandedLoading Title="@L.T("buyer.booking.loadingTitle")" Message="@L.T("buyer.booking.loadingMessage")" />
}
else if (_isPartnerBlocked)
{
    <section class="max-w-3xl mx-auto rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-4">
        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@L.T("buyer.booking.partnerBlocked.eyebrow")</p>
        <h1 class="text-3xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.booking.partnerBlocked.title")</h1>
        <p class="text-sm text-[#595c5d]">@L.T("buyer.booking.partnerBlocked.body")</p>
        <a href="/" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("buyer.booking.partnerBlocked.cta")</a>
    </section>
}
else
{
    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
        <h1 class="text-2xl font-bold">@L.T("buyer.booking.heading")</h1>
        <p class="text-sm text-[#61897c]">@(_isPersonal ? L.T("buyer.booking.subtitle") : L.T("buyer.booking.guestSubtitle"))</p>

        @if (_successBookingId is Guid successId)
        {
            <div class="mt-6 rounded-[1.5rem] border border-[#a7f255] bg-[#f8fff1] p-5 space-y-3">
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#396300]">@L.T("buyer.booking.success.eyebrow")</p>
                <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@L.T("buyer.booking.success.title")</h2>
                <p class="text-sm text-[#595c5d]">
                    @string.Format(L.T("buyer.booking.success.body"), ShortId(successId), _successStatus ?? "payment_pending")
                </p>
                @if (!string.IsNullOrWhiteSpace(_mercadoPagoCheckoutUrl))
                {
                    <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.mp.hint")</p>
                    <a href="@_mercadoPagoCheckoutUrl" class="inline-flex items-center justify-center rounded-2xl bg-[#009ee3] px-5 py-3 text-sm font-bold text-white">@L.T("buyer.checkout.mp.pay")</a>
                }
                else if (_mercadoPagoChecked && !_partnerAcceptsOnlinePayment)
                {
                    <p class="text-sm text-[#595c5d]">@L.T("buyer.checkout.mp.offlineDetail")</p>
                }
                <div class="flex flex-col sm:flex-row gap-3">
                    <a href="@TrackingHref" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">@L.T("buyer.booking.success.track")</a>
                    @if (!_isPersonal)
                    {
                        <a href="@RegisterHref" class="inline-flex items-center justify-center rounded-2xl border border-[#3b6700] px-5 py-3 text-sm font-bold text-[#3b6700]">@L.T("buyer.booking.success.register")</a>
                    }
                    <a href="/categorias" class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30]">@L.T("buyer.booking.success.browse")</a>
                </div>
            </div>
        }

        @if (!_isPersonal && !AuthState.IsAuthenticated && _successBookingId is null)
        {
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#dadddf] bg-[#fafafa] px-4 py-3 text-sm">
                <span class="text-[#595c5d]">@L.T("buyer.booking.guestLoginHint")</span>
                <a href="@LoginHref" class="font-bold text-[#3b6700] hover:underline">@L.T("buyer.booking.guestLoginCta")</a>
            </div>
        }

        @if (_serviceName is not null && _successBookingId is null)
        {
            <div class="mt-4 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm">
                <strong>@L.T("buyer.booking.serviceLabel")</strong> @_serviceName<br />
                <strong>@L.T("buyer.booking.categoryLabel")</strong> @_serviceCategory<br />
                <strong>@L.T("buyer.booking.amountLabel")</strong> @($"{Amount:N0}")
            </div>
        }

        @if (!_isPersonal && _successBookingId is null)
        {
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.fullName")</label>
                    <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                           @bind="GuestFullName"
                           disabled="@_isSubmitting"
                           autocomplete="name" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.email")</label>
                    <input type="email" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                           @bind="GuestEmail" disabled="@_isSubmitting" autocomplete="email" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#61897c] mb-1">@L.T("buyer.checkout.guest.phone")</label>
                    <input type="tel" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                           @bind="GuestPhone" disabled="@_isSubmitting" autocomplete="tel" />
                </div>
            </div>
        }

        @if (_successBookingId is null)
        {
            @if (_availableSlots.Count > 0 && !_useManualSchedule)
            {
                <div class="mt-6 space-y-3">
                    <p class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">@L.T("buyer.booking.slotsLabel")</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        @foreach (var slot in _availableSlots)
                        {
                            var selected = _selectedSlotId == slot.Id;
                            <button type="button"
                                    class="@($"rounded-xl border px-4 py-3 text-left text-sm transition {(selected ? "border-[#3b6700] bg-[#f8fff1] font-bold" : "border-[#dadddf]")}")"
                                    disabled="@_isSubmitting"
                                    @onclick="() => SelectSlot(slot)">
                                @slot.StartAt.ToLocalTime().ToString("ddd dd/MM · HH:mm", CultureInfo.CurrentCulture)
                                <span class="block text-xs text-[#61897c]">@slot.EndAt.ToLocalTime().ToString("HH:mm")</span>
                            </button>
                        }
                    </div>
                    <button type="button" class="text-sm font-bold text-[#3b6700] hover:underline" @onclick="EnableManualSchedule">
                        @L.T("buyer.booking.manualSchedule")
                    </button>
                </div>
            }
            else
            {
                @if (_availableSlots.Count == 0 && _slotsLoaded)
                {
                    <p class="mt-4 text-sm text-[#61897c]">@L.T("buyer.booking.slotsEmpty")</p>
                }
                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">@L.T("buyer.booking.dateLabel")</label>
                        <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               placeholder="dd/MM/yyyy" @bind="BookingDate" disabled="@_isSubmitting" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">@L.T("buyer.booking.startLabel")</label>
                        <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               placeholder="HH:mm" @bind="StartTime" disabled="@_isSubmitting" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">@L.T("buyer.booking.endLabel")</label>
                        <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full"
                               placeholder="HH:mm" @bind="EndTime" disabled="@_isSubmitting" />
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
        }

        @if (_successBookingId is null)
        {
            <button class="mt-6 bg-primary text-[#111816] px-6 py-2 rounded-lg font-bold disabled:opacity-60 disabled:cursor-not-allowed"
                    @onclick="HandleBooking"
                    disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span>@L.T("buyer.booking.submitting")</span>
                }
                else
                {
                    <span>@L.T("buyer.booking.confirm")</span>
                }
            </button>
        }
    </div>
}

@code {
    private string PartnerId = string.Empty;
    private string ServiceId = string.Empty;
    private string CustomerId = string.Empty;
    private string BookingDate = string.Empty;
    private string StartTime = string.Empty;
    private string EndTime = string.Empty;
    private double Amount;
    private string _statusMessage = string.Empty;
    private string _statusLevel = "info";
    private string? _serviceName;
    private string? _serviceCategory;
    private bool _startedTracked;
    private bool _completed;
    private Guid? _tenantId;
    private bool _initializing = true;
    private bool _isPartnerBlocked;
    private bool _isPersonal;
    private bool _checkedAuth;
    private bool _isSubmitting;
    private Guid? _successBookingId;
    private Guid? _successCustomerId;
    private string? _successStatus;
    private string? _mercadoPagoCheckoutUrl;
    private bool _mercadoPagoChecked;
    private bool _partnerAcceptsOnlinePayment;
    private readonly List<PublicServiceSlot> _availableSlots = new();
    private Guid? _selectedSlotId;
    private bool _useManualSchedule;
    private bool _slotsLoaded;

    private string GuestFullName = string.Empty;
    private string GuestEmail = string.Empty;
    private string GuestPhone = string.Empty;

    private string CurrentPathAndQuery => Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery;
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";
    private string RegisterHref
    {
        get
        {
            var href = $"/register?role=natural&returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";
            if (!string.IsNullOrWhiteSpace(GuestEmail))
            {
                href += $"&email={Uri.EscapeDataString(GuestEmail.Trim())}";
            }

            return href;
        }
    }

    private string TrackingHref => _successBookingId is Guid bookingId && _successCustomerId is Guid customerId
        ? $"/buyer/orders?bookingId={bookingId}&customerId={customerId}"
        : "/buyer/orders";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;

        try
        {
            await AuthState.InitializeAsync();
            _isPersonal = AuthState.IsPersonalAccount;
            _isPartnerBlocked = false;
            _initializing = false;

            if (!_isPersonal && AuthState.IsPartnerAccount)
            {
                if (string.IsNullOrEmpty(GuestFullName)) GuestFullName = AuthState.DisplayName ?? string.Empty;
                if (string.IsNullOrEmpty(GuestEmail)) GuestEmail = AuthState.Email ?? string.Empty;
            }

            await LoadBookingAsync();

            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            _checkedAuth = false;
        }
    }

    private async Task HandleBooking()
    {
        if (_isSubmitting || _successBookingId is not null)
        {
            return;
        }

        _statusMessage = string.Empty;
        _statusLevel = "info";

        if (string.IsNullOrWhiteSpace(PartnerId) || string.IsNullOrWhiteSpace(ServiceId) ||
            !Guid.TryParse(PartnerId, out var partnerId) ||
            !Guid.TryParse(ServiceId, out var serviceId))
        {
            _statusMessage = L.T("buyer.booking.missingService");
            _statusLevel = "warning";
            return;
        }

        DateTimeOffset startAt;
        DateTimeOffset endAt;
        Guid? slotId = null;

        if (_availableSlots.Count > 0 && !_useManualSchedule)
        {
            var slot = _availableSlots.FirstOrDefault(x => x.Id == _selectedSlotId);
            if (slot is null)
            {
                _statusMessage = L.T("buyer.booking.slotRequired");
                _statusLevel = "warning";
                return;
            }

            slotId = slot.Id;
            startAt = slot.StartAt;
            endAt = slot.EndAt;
        }
        else if (!TryParseDateAndTime(BookingDate, StartTime, out startAt) ||
                 !TryParseDateAndTime(BookingDate, EndTime, out endAt) ||
                 endAt <= startAt)
        {
            _statusMessage = L.T("buyer.booking.invalidSchedule");
            _statusLevel = "warning";
            return;
        }

        if (_tenantId is not Guid tenantId || tenantId == Guid.Empty)
        {
            _statusMessage = L.T("buyer.checkout.missingTenant");
            _statusLevel = "warning";
            return;
        }

        _isSubmitting = true;
        try
        {
            if (_isPersonal)
            {
                await SubmitPersonalBookingAsync(partnerId, serviceId, startAt, endAt, tenantId, slotId);
            }
            else
            {
                await SubmitGuestBookingAsync(serviceId, startAt, endAt, tenantId, slotId);
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = string.Format(L.T("buyer.booking.httpError"), (int?)ex.StatusCode ?? 0);
            _statusLevel = "error";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitPersonalBookingAsync(Guid partnerId, Guid serviceId, DateTimeOffset startAt, DateTimeOffset endAt, Guid tenantId, Guid? slotId)
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsPersonalAccount)
        {
            _statusMessage = L.T("buyer.checkout.personalSessionRequired");
            _statusLevel = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(CustomerId))
        {
            await ResolveCustomerIdAsync();
        }

        if (!Guid.TryParse(CustomerId, out var customerId))
        {
            _statusMessage = L.T("buyer.checkout.customerMissing");
            _statusLevel = "warning";
            return;
        }

        await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);

        var booking = await BuyerApi.CreateBookingAsync(
            new BookingCreateRequest(partnerId, serviceId, slotId, customerId, startAt, endAt, Amount, "CLP", null),
            tenantId);

        if (booking is null)
        {
            _statusMessage = L.T("buyer.status.bookingFailed");
            _statusLevel = "error";
            return;
        }

        ApplySuccess(booking.Id, booking.CustomerId, booking.Status);
        _statusMessage = $"{L.T("buyer.status.bookingCreated")} #{booking.Id}";
        _statusLevel = "success";
    }

    private async Task SubmitGuestBookingAsync(Guid serviceId, DateTimeOffset startAt, DateTimeOffset endAt, Guid tenantId, Guid? slotId)
    {
        if (string.IsNullOrWhiteSpace(GuestFullName) || GuestFullName.Trim().Length < 2)
        {
            _statusMessage = L.T("buyer.checkout.guest.fullNameRequired");
            _statusLevel = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(GuestEmail) || !GuestEmail.Contains('@'))
        {
            _statusMessage = L.T("buyer.checkout.guest.emailRequired");
            _statusLevel = "warning";
            return;
        }

        var response = await BuyerApi.CreateGuestBookingAsync(
            new GuestBookingCreateRequest(
                tenantId,
                serviceId,
                slotId,
                new GuestContactRequest(GuestFullName.Trim(), GuestEmail.Trim(), string.IsNullOrWhiteSpace(GuestPhone) ? null : GuestPhone.Trim()),
                startAt,
                endAt,
                "CLP"));

        if (response is null)
        {
            _statusMessage = L.T("buyer.status.bookingFailed");
            _statusLevel = "error";
            return;
        }

        CustomerId = response.CustomerId.ToString();
        await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        ApplySuccess(response.BookingId, response.CustomerId, response.Status);
        _statusMessage = L.T("buyer.booking.guestSuccess");
        _statusLevel = "success";
    }

    private void ApplySuccess(Guid bookingId, Guid customerId, string? status)
    {
        _successBookingId = bookingId;
        _successCustomerId = customerId;
        _successStatus = status;
        _completed = true;
        _ = PersistLastTrackingAsync(bookingId, customerId);
        _ = TrackAsync("submit_booking", "submit", "success");
        _ = TryOfferMercadoPagoAsync(bookingId, customerId);
    }

    private async Task PersistLastTrackingAsync(Guid bookingId, Guid customerId)
    {
        try
        {
            var payload = JsonSerializer.Serialize(new Dictionary<string, string>
            {
                ["bookingId"] = bookingId.ToString(),
                ["customerId"] = customerId.ToString()
            });
            await JSRuntime.InvokeVoidAsync("comunaclic.setLastTracking", payload);
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private async Task TryOfferMercadoPagoAsync(Guid bookingId, Guid customerId)
    {
        if (!Guid.TryParse(PartnerId, out var partnerId))
        {
            _mercadoPagoChecked = true;
            return;
        }

        try
        {
            var status = await BuyerApi.GetPartnerPaymentStatusAsync(partnerId);
            _partnerAcceptsOnlinePayment = status?.MercadoPagoReady == true;
            if (!_partnerAcceptsOnlinePayment)
            {
                return;
            }

            var checkout = await BuyerApi.CreateMercadoPagoCheckoutAsync(
                new PublicMercadoPagoCheckoutRequest(customerId, null, bookingId));
            if (!string.IsNullOrWhiteSpace(checkout?.CheckoutUrl))
            {
                _mercadoPagoCheckoutUrl = checkout.CheckoutUrl;
                await SavePendingMpPaymentAsync(bookingId, customerId, checkout.CheckoutUrl);
            }
        }
        catch
        {
            _partnerAcceptsOnlinePayment = false;
        }
        finally
        {
            _mercadoPagoChecked = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SavePendingMpPaymentAsync(Guid bookingId, Guid customerId, string checkoutUrl)
    {
        try
        {
            var payload = JsonSerializer.Serialize(new Dictionary<string, string?>
            {
                ["bookingId"] = bookingId.ToString(),
                ["customerId"] = customerId.ToString(),
                ["checkoutUrl"] = checkoutUrl,
                ["createdAt"] = DateTimeOffset.UtcNow.ToString("O")
            });
            // Acumula sin pisar otros pagos pendientes (carrito multi-negocio).
            await JSRuntime.InvokeVoidAsync("comunaclic.addPendingMpPayment", payload);
        }
        catch
        {
            // Ignore storage errors.
        }
    }

    private void SelectSlot(PublicServiceSlot slot)
    {
        _selectedSlotId = slot.Id;
        BookingDate = slot.StartAt.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
        StartTime = slot.StartAt.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);
        EndTime = slot.EndAt.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    private void EnableManualSchedule()
    {
        _useManualSchedule = true;
        _selectedSlotId = null;
    }

    private async Task LoadBookingAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var serviceIdRaw = GetQueryParameter(uri.Query, "serviceId");
        if (!Guid.TryParse(serviceIdRaw, out var parsedServiceId))
        {
            _statusMessage = L.T("buyer.booking.missingService");
            _statusLevel = "warning";
            return;
        }

        var service = await BuyerApi.GetServiceAsync(parsedServiceId);
        if (service is null)
        {
            _statusMessage = L.T("buyer.booking.missingService");
            _statusLevel = "warning";
            return;
        }

        ServiceId = service.Id.ToString();
        PartnerId = service.PartnerId.ToString();
        Amount = service.Price;
        _serviceName = service.Name;
        _serviceCategory = service.Category;
        _tenantId = service.TenantId;

        var slots = await BuyerApi.GetPublicServiceSlotsAsync(parsedServiceId);
        _availableSlots.Clear();
        if (slots is { Count: > 0 })
        {
            _availableSlots.AddRange(slots);
            _useManualSchedule = false;
            SelectSlot(_availableSlots[0]);
        }
        else
        {
            _useManualSchedule = true;
            var suggestedStart = DateTimeOffset.Now.Date.AddDays(1).AddHours(10);
            var suggestedEnd = suggestedStart.AddMinutes(Math.Max(service.DurationMinutes, 30));
            BookingDate = suggestedStart.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
            StartTime = suggestedStart.ToString("HH:mm", CultureInfo.InvariantCulture);
            EndTime = suggestedEnd.ToString("HH:mm", CultureInfo.InvariantCulture);
        }

        _slotsLoaded = true;

        if (_isPersonal)
        {
            await ResolveCustomerIdAsync();
        }

        await TrackAsync("start_booking", "start", "started");
        _startedTracked = true;
    }

    private async Task ResolveCustomerIdAsync()
    {
        await AuthState.InitializeAsync();
        var tenantCandidates = new List<Guid?>();
        if (_tenantId is Guid tenantFromService && tenantFromService != Guid.Empty)
        {
            tenantCandidates.Add(tenantFromService);
        }

        if (AuthState.TenantId is Guid tenantFromSession && tenantFromSession != Guid.Empty && !tenantCandidates.Contains(tenantFromSession))
        {
            tenantCandidates.Add(tenantFromSession);
        }

        tenantCandidates.Add(null);
        foreach (var tenantCandidate in tenantCandidates)
        {
            try
            {
                var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantCandidate);
                if (ensured?.Id is Guid customerId && customerId != Guid.Empty)
                {
                    CustomerId = customerId.ToString();
                    await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                    return;
                }
            }
            catch
            {
                // try next tenant
            }
        }
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private async Task TrackAsync(string eventName, string step, string status)
    {
        var entityId = Guid.TryParse(ServiceId, out var serviceId) ? serviceId : (Guid?)null;
        var deviceType = await JSRuntime.InvokeAsync<string>("comunaclic.getDeviceType");
        await BuyerApi.TrackFunnelEventAsync(new FunnelEventRequest(
            eventName, "services", "service", entityId, _tenantId,
            Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery, deviceType, "book", step, status,
            DateTimeOffset.UtcNow,
            new Dictionary<string, string?>
            {
                ["customerId"] = string.IsNullOrWhiteSpace(CustomerId) ? null : CustomerId,
                ["partnerId"] = PartnerId,
                ["guest"] = (!_isPersonal).ToString()
            }));
    }

    private static bool TryParseDateAndTime(string? dateRaw, string? timeRaw, out DateTimeOffset result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(dateRaw) || string.IsNullOrWhiteSpace(timeRaw))
        {
            return false;
        }

        if (!DateOnly.TryParseExact(dateRaw, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return false;
        }

        if (!TimeOnly.TryParseExact(timeRaw, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
        {
            return false;
        }

        result = new DateTimeOffset(date.ToDateTime(time, DateTimeKind.Local));
        return true;
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            }
        }
        return null;
    }

    private static string ShortId(Guid id) => id.ToString()[..8];

    public void Dispose()
    {
        if (_startedTracked && !_completed)
        {
            _ = TrackAsync("flow_abandoned", "booking", "abandoned");
        }
        L.OnChange -= HandleChange;
    }
}
