@page "/buyer/booking"
@layout BuyerLayout
@using ComunaClick.Common.Funnel
@using System.Globalization
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@L.T("buyer.booking.title")</PageTitle>

@if (_loadingSession)
{
    <BrandedLoading Title="Validando acceso" Message="Estamos comprobando que tu sesión corresponda a una cuenta personal." />
}
else if (!_canUsePersonalFlow)
{
    <section class="max-w-3xl mx-auto rounded-[2rem] bg-white p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-4">
        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">Acceso requerido</p>
        <h1 class="text-3xl font-black tracking-[-0.04em] text-[#2c2f30]">Ingresa con tu cuenta personal para reservar</h1>
        <p class="text-sm text-[#595c5d]">Las reservas buyer solo están disponibles para usuarios con cuenta personal. Si estás con una sesión partner, cambia de cuenta antes de continuar.</p>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="@LoginHref" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">Iniciar sesión personal</a>
            <a href="@RegisterHref" class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30]">Crear cuenta personal</a>
        </div>
    </section>
}
else
{
    <div class="bg-white dark:bg-[#1a2e28] border border-gray-200 dark:border-gray-800 rounded-xl p-6">
        <h1 class="text-2xl font-bold">@L.T("buyer.booking.heading")</h1>
        <p class="text-sm text-[#61897c]">@L.T("buyer.booking.subtitle")</p>
        @if (_serviceName is not null)
        {
            <div class="mt-4 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm">
                <strong>Servicio:</strong> @_serviceName<br />
                <strong>Categoría:</strong> @_serviceCategory<br />
                <strong>Monto sugerido:</strong> @($"{Amount:N0}")
            </div>
        }
        @if (_createdBooking is not null)
        {
            <div class="mt-6 rounded-[1.5rem] border border-[#a7f255] bg-[#f8fff1] p-5 space-y-3">
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#396300]">Reserva registrada</p>
                <h2 class="text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">Tu reserva quedó creada correctamente</h2>
                <p class="text-sm text-[#595c5d]">
                    Reserva <strong>#@ShortId(_createdBooking.Id)</strong> con estado <strong>@(_createdBooking.Status ?? "registrado")</strong>.
                    Revisa su seguimiento para confirmar horario, negocio y política de cancelación.
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a href="@($"/buyer/orders?bookingId={_createdBooking.Id}")" class="inline-flex items-center justify-center rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad]">Ver seguimiento</a>
                    <a href="/buyer" class="inline-flex items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30]">Volver al portal</a>
                </div>
            </div>
        }
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="space-y-2 md:col-span-2">
                <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">Fecha (día/mes/año)</label>
                <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full" placeholder="dd/MM/yyyy" @bind="BookingDate" />
                @if (TryParseDateAndTime(BookingDate, StartTime, out var parsedDateTime))
                {
                    <p class="text-xs text-[#61897c]">Fecha seleccionada: @parsedDateTime.ToString("dd/MM/yyyy")</p>
                }
            </div>
            <div class="space-y-2">
                <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">Hora inicio</label>
                <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full" placeholder="HH:mm" @bind="StartTime" />
            </div>
            <div class="space-y-2">
                <label class="text-xs uppercase tracking-[0.14em] font-bold text-[#595c5d]">Hora término</label>
                <input type="text" class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 w-full" placeholder="HH:mm" @bind="EndTime" />
            </div>
            <input class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 h-12 bg-gray-50 dark:bg-gray-800" placeholder="Monto" @bind="Amount" readonly />
        </div>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusBanner Message="@_statusMessage" Level="@_statusLevel" />
        }
        <button class="mt-6 bg-primary text-[#111816] px-6 py-2 rounded-lg font-bold disabled:opacity-60 disabled:cursor-not-allowed"
                @onclick="HandleBooking"
                disabled="@(_isSubmitting || _createdBooking is not null)">
            @if (_isSubmitting)
            {
                <span>Creando reserva...</span>
            }
            else if (_createdBooking is not null)
            {
                <span>Reserva completada</span>
            }
            else
            {
                <span>@L.T("buyer.booking.confirm")</span>
            }
        </button>
    </div>
}

@code {
    private string PartnerId = string.Empty;
    private string ServiceId = string.Empty;
    private string CustomerId = string.Empty;
    private string BookingDate = string.Empty;
    private string StartTime = string.Empty;
    private string EndTime = string.Empty;
    private double Amount = 0;
    private string _statusMessage = string.Empty;
    private string _statusLevel = "info";
    private string? _serviceName;
    private string? _serviceCategory;
    private bool _startedTracked;
    private bool _completed;
    private Guid? _tenantId;
    private bool _loadingSession = true;
    private bool _canUsePersonalFlow;
    private bool _checkedAuth;
    private bool _isSubmitting;
    private ComunaClick.Shared.Api.Buyer.Booking? _createdBooking;
    private string CurrentPathAndQuery => Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery;
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";
    private string RegisterHref => $"/register?intent=buyer&returnUrl={Uri.EscapeDataString(CurrentPathAndQuery)}";

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checkedAuth)
        {
            return;
        }

        _checkedAuth = true;

        try
        {
            await AuthState.InitializeAsync();
            _canUsePersonalFlow = AuthState.IsPersonalAccount;
            _loadingSession = false;

            if (_canUsePersonalFlow)
            {
                await LoadBookingAsync();
            }

            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            _checkedAuth = false;
        }
    }

    private async Task HandleBooking()
    {
        if (_isSubmitting || _createdBooking is not null)
        {
            return;
        }

        await AuthState.InitializeAsync();
        if (!AuthState.IsPersonalAccount)
        {
            _statusMessage = "Tu sesión de cuenta personal no está activa. Inicia sesión para continuar con la reserva.";
            _statusLevel = "warning";
            await TrackAsync("flow_error", "identity", "not_logged_personal");
            return;
        }

        _statusMessage = string.Empty;
        _statusLevel = "info";
        if (string.IsNullOrWhiteSpace(PartnerId) || string.IsNullOrWhiteSpace(ServiceId))
        {
            _statusMessage = "No encontramos el servicio seleccionado para reservar. Vuelve al detalle del servicio e inténtalo otra vez.";
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "missing_service_context");
            return;
        }

        if (!Guid.TryParse(PartnerId, out var partnerId) ||
            !Guid.TryParse(ServiceId, out var serviceId))
        {
            _statusMessage = "No encontramos el servicio seleccionado para reservar. Vuelve al detalle del servicio e inténtalo otra vez.";
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "invalid_service_context");
            return;
        }

        if (string.IsNullOrWhiteSpace(CustomerId))
        {
            await ResolveCustomerIdAsync();
        }

        Guid customerId = Guid.Empty;
        if (Guid.TryParse(CustomerId, out var parsedCustomerId))
        {
            customerId = parsedCustomerId;
            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        }

        if (!TryParseDateAndTime(BookingDate, StartTime, out var startAt) ||
            !TryParseDateAndTime(BookingDate, EndTime, out var endAt))
        {
            _statusMessage = "Debes ingresar una fecha válida (día/mes/año) y horas válidas para la reserva.";
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "invalid_booking_datetime");
            return;
        }

        if (endAt <= startAt)
        {
            _statusMessage = "La hora de término debe ser posterior a la hora de inicio.";
            _statusLevel = "warning";
            await TrackAsync("flow_error", "validation", "invalid_booking_range");
            return;
        }

        _isSubmitting = true;
        try
        {
            var request = new BookingCreateRequest(
                partnerId,
                serviceId,
                null,
                customerId,
                startAt,
                endAt,
                Amount,
                "CLP",
                null);

            var booking = await BuyerApi.CreateBookingAsync(request);
            if (booking is null)
            {
                _statusMessage = L.T("buyer.status.bookingFailed");
                _statusLevel = "error";
                await TrackAsync("flow_error", "submit", "booking_failed");
            }
            else
            {
                _createdBooking = booking;
                _statusMessage = $"{L.T("buyer.status.bookingCreated")} #{booking.Id}";
                _statusLevel = "success";
                _completed = true;
                if (booking.CustomerId != Guid.Empty)
                {
                    CustomerId = booking.CustomerId.ToString();
                    await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                }
                await TrackAsync("submit_booking", "submit", "success");
            }
        }
        catch (HttpRequestException ex)
        {
            _statusMessage = $"No se pudo crear la reserva ({(int?)ex.StatusCode ?? 0}). Revisa los datos del horario e inténtalo otra vez.";
            _statusLevel = "error";
            await TrackAsync("flow_error", "submit", "http_exception");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task TrackAsync(string eventName, string step, string status)
    {
        var entityId = Guid.TryParse(ServiceId, out var serviceId) ? serviceId : (Guid?)null;
        var deviceType = await JSRuntime.InvokeAsync<string>("comunaclic.getDeviceType");
        await BuyerApi.TrackFunnelEventAsync(new FunnelEventRequest(
            eventName,
            "services",
            "service",
            entityId,
            _tenantId,
            Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery,
            deviceType,
            "book",
            step,
            status,
            DateTimeOffset.UtcNow,
            new Dictionary<string, string?>
            {
                ["customerId"] = string.IsNullOrWhiteSpace(CustomerId) ? null : CustomerId,
                ["partnerId"] = PartnerId,
                ["bookingDate"] = BookingDate,
                ["startTime"] = StartTime,
                ["endTime"] = EndTime
            }));
    }

    private async Task LoadBookingAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var serviceId = GetQueryParameter(uri.Query, "serviceId");
        var customerIdFromQuery = GetQueryParameter(uri.Query, "customerId");

        if (!Guid.TryParse(serviceId, out var parsedServiceId))
        {
            return;
        }

        var service = await BuyerApi.GetServiceAsync(parsedServiceId);
        if (service is null)
        {
            return;
        }

        ServiceId = service.Id.ToString();
        PartnerId = service.PartnerId.ToString();
        Amount = service.Price;
        _serviceName = service.Name;
        _serviceCategory = service.Category;
        _tenantId = service.TenantId;

        if (Guid.TryParse(customerIdFromQuery, out var parsedCustomerId) && parsedCustomerId != Guid.Empty)
        {
            CustomerId = parsedCustomerId.ToString();
            await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
        }

        await ResolveCustomerIdAsync();

        var suggestedStart = DateTimeOffset.Now.Date.AddDays(1).AddHours(10);
        var suggestedEnd = suggestedStart.AddMinutes(Math.Max(service.DurationMinutes, 30));
        BookingDate = suggestedStart.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
        StartTime = suggestedStart.ToString("HH:mm", CultureInfo.InvariantCulture);
        EndTime = suggestedEnd.ToString("HH:mm", CultureInfo.InvariantCulture);
        await TrackAsync("start_booking", "start", "started");
        _startedTracked = true;
    }

    private async Task ResolveCustomerIdAsync()
    {
        await AuthState.InitializeAsync();

        var tenantCandidates = new List<Guid?>();
        if (_tenantId is Guid tenantFromService && tenantFromService != Guid.Empty)
        {
            tenantCandidates.Add(tenantFromService);
        }

        if (AuthState.TenantId is Guid tenantFromSession && tenantFromSession != Guid.Empty && !tenantCandidates.Contains(tenantFromSession))
        {
            tenantCandidates.Add(tenantFromSession);
        }

        tenantCandidates.Add(null);

        foreach (var tenantCandidate in tenantCandidates)
        {
            if (await TryEnsureCustomerIdAsync(tenantCandidate))
            {
                return;
            }
        }

        if (Guid.TryParse(CustomerId, out var currentId) && currentId != Guid.Empty)
        {
            return;
        }

        await TryUseStoredCustomerIdAsync();
    }

    private async Task<bool> TryEnsureCustomerIdAsync(Guid? tenantId)
    {
        try
        {
            var ensured = await BuyerApi.EnsureBuyerCustomerAsync(tenantId);
            if (ensured?.Id is Guid customerId && customerId != Guid.Empty)
            {
                CustomerId = customerId.ToString();
                await JSRuntime.InvokeVoidAsync("comunaclic.setCustomerId", CustomerId);
                return true;
            }
        }
        catch
        {
            // Continue with next tenant candidate.
        }

        return false;
    }

    private async Task<bool> TryUseStoredCustomerIdAsync()
    {
        var storedCustomerId = await JSRuntime.InvokeAsync<string>("comunaclic.getCustomerId");
        if (Guid.TryParse(storedCustomerId, out var parsedId) && parsedId != Guid.Empty)
        {
            CustomerId = parsedId.ToString();
            return true;
        }

        CustomerId = string.Empty;
        return false;
    }

    private static bool TryParseDateAndTime(string? dateRaw, string? timeRaw, out DateTimeOffset result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(dateRaw) || string.IsNullOrWhiteSpace(timeRaw))
        {
            return false;
        }

        if (!DateOnly.TryParseExact(dateRaw, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return false;
        }

        if (!TimeOnly.TryParseExact(timeRaw, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
        {
            return false;
        }

        var localDateTime = date.ToDateTime(time, DateTimeKind.Local);
        result = new DateTimeOffset(localDateTime);
        return true;
    }

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            }
        }
        return null;
    }

    private static string ShortId(Guid id)
        => id.ToString()[..8];

    public void Dispose()
    {
        if (_startedTracked && !_completed)
        {
            _ = TrackAsync("flow_abandoned", "booking", "abandoned");
        }
        L.OnChange -= HandleChange;
    }
}
