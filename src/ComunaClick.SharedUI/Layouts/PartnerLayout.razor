@inherits LayoutComponentBase
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.SharedUI.Services.Partner.PartnerNotificationsBadgeService NotificationsBadge
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<style>
    @@keyframes cc-bell-ring {
        0%, 60%, 100% { transform: rotate(0); }
        10% { transform: rotate(14deg); }
        20% { transform: rotate(-12deg); }
        30% { transform: rotate(10deg); }
        40% { transform: rotate(-8deg); }
        50% { transform: rotate(4deg); }
    }

    .cc-bell-ring {
        animation: cc-bell-ring 2.2s ease-in-out infinite;
        transform-origin: top center;
        display: inline-block;
    }
</style>

<div class="min-h-screen bg-[#f5f6f7] text-[#2c2f30] lg:flex">
    <aside class="@($"fixed left-0 top-0 hidden lg:flex shrink-0 z-30 h-screen flex-col border-r border-[#e3e6e8] bg-white transition-[width] duration-300 ease-in-out {SidebarWidthClass}")">
        <div class="@($"flex-1 overflow-y-auto overflow-x-hidden {(_sidebarCollapsed ? "px-3 py-6" : "p-8 pb-6")}")">
            <div class="@($"flex items-center mb-8 {(_sidebarCollapsed ? "justify-center" : "gap-4")}")">
                <div class="w-11 h-11 shrink-0 rounded-xl bg-[#a7f255] flex items-center justify-center shadow-[0_10px_30px_-18px_rgba(59,103,0,0.5)]">
                    <img src="_content/ComunaClick.SharedUI/loading.png" alt="ComunaClic" class="w-7 h-7 object-contain" />
                </div>
                @if (!_sidebarCollapsed)
                {
                    <div class="min-w-0">
                        <h1 class="text-[1.75rem] font-black tracking-[-0.04em] text-[#111816] truncate">ComunaClic</h1>
                        <p class="text-[10px] uppercase tracking-[0.25em] text-[#8a8f90] font-bold">@L.T("partner.layout.badge")</p>
                    </div>
                }
            </div>

            <nav class="space-y-1 text-sm font-semibold">
                @if (!_sidebarCollapsed)
                {
                    <p class="px-4 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.operations")</p>
                }
                else
                {
                    <div class="my-2 border-t border-[#e3e6e8]" aria-hidden="true"></div>
                }
                <a class="@GetNavLinkClass("/")" href="/" title="@L.T("nav.home")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">home</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>@L.T("nav.home")</span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner")" href="/partner" title="@L.T("partner.nav.dashboard")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">dashboard</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.dashboard")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.dashboard.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/catalog")" href="/partner/catalog" title="@L.T("partner.nav.catalog")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">inventory_2</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.catalog")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.catalog.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/storefront")" href="/partner/storefront" title="@L.T("partner.nav.storefront")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">storefront</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.storefront")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.storefront.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/agenda")" href="/partner/agenda" title="@L.T("partner.nav.agenda")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">calendar_today</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.agenda")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.agenda.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/orders")" href="/partner/orders" title="@L.T("partner.nav.orders")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">shopping_bag</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.orders")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.orders.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/leads")" href="/partner/leads" title="@L.T("partner.nav.leads")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">group_add</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>@L.T("partner.nav.leads")</span>
                    }
                </a>

                @if (!_sidebarCollapsed)
                {
                    <p class="px-4 pt-5 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.finance")</p>
                }
                else
                {
                    <div class="my-3 border-t border-[#e3e6e8]" aria-hidden="true"></div>
                }
                <a class="@GetNavLinkClass("/partner/payouts")" href="/partner/payouts" title="@L.T("partner.nav.payouts")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">payments</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>@L.T("partner.nav.payouts")</span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/mercadopago")" href="/partner/mercadopago" title="@L.T("partner.nav.mercadopago")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">point_of_sale</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>@L.T("partner.nav.mercadopago")</span>
                    }
                </a>

                @if (!_sidebarCollapsed)
                {
                    <p class="px-4 pt-5 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.system")</p>
                }
                else
                {
                    <div class="my-3 border-t border-[#e3e6e8]" aria-hidden="true"></div>
                }
                <a class="@GetNavLinkClass("/partner/notifications")" href="/partner/notifications" title="@L.T("partner.nav.notifications")">
                    <span class="relative shrink-0">
                        <span class="material-symbols-outlined text-[22px]">notifications</span>
                        @if (_sidebarCollapsed && HasUnreadNotifications)
                        {
                            <span class="absolute -top-1 -right-1 h-2.5 w-2.5 rounded-full bg-[#dc2626] animate-pulse" aria-hidden="true"></span>
                        }
                    </span>
                    @if (!_sidebarCollapsed)
                    {
                        <span class="flex items-center gap-2">
                            @L.T("partner.nav.notifications")
                            @if (HasUnreadNotifications)
                            {
                                <span class="inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-[#dc2626] px-1.5 text-[10px] font-black text-white">@UnreadNotificationsLabel</span>
                            }
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/messages")" href="/partner/messages" title="@L.T("partner.nav.messages")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">mail</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.messages")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.messages.hint")</span>
                        </span>
                    }
                </a>
                <a class="@GetNavLinkClass("/partner/settings")" href="/partner/settings" title="@L.T("partner.nav.settings")">
                    <span class="material-symbols-outlined text-[22px] shrink-0">apartment</span>
                    @if (!_sidebarCollapsed)
                    {
                        <span>
                            @L.T("partner.nav.settings")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("partner.nav.settings.hint")</span>
                        </span>
                    }
                </a>
            </nav>
        </div>

        <div class="@($"border-t border-[#e3e6e8] bg-white {(_sidebarCollapsed ? "p-3" : "p-8")}")">
            <a href="/partner/quickstart"
               title="@L.T("partner.layout.createOffer")"
               class="@($"flex items-center justify-center gap-2 w-full rounded-2xl bg-[#3b6700] text-[#d9ffad] font-bold shadow-[0_18px_32px_-20px_rgba(59,103,0,0.8)] hover:bg-[#335900] transition-colors {(_sidebarCollapsed ? "p-3" : "py-4 px-4")}")">
                <span class="material-symbols-outlined text-[22px]">add_circle</span>
                @if (!_sidebarCollapsed)
                {
                    @L.T("partner.layout.createOffer")
                }
            </a>
        </div>

        <button type="button"
                class="absolute -right-3 top-[4.5rem] z-10 flex h-7 w-7 items-center justify-center rounded-full border border-[#dadddf] bg-white text-[#3b6700] shadow-md hover:bg-[#f5f6f7] transition-colors"
                aria-expanded="@(!_sidebarCollapsed)"
                aria-label="@SidebarToggleLabel"
                @onclick="ToggleSidebarAsync">
            <span class="material-symbols-outlined text-[18px]">@(_sidebarCollapsed ? "chevron_right" : "chevron_left")</span>
        </button>
    </aside>

    <div class="@($"flex min-h-screen min-w-0 flex-1 flex-col {SidebarOffsetClass}")">
        <header class="sticky top-0 z-40 flex h-16 shrink-0 items-center justify-between border-b border-[#e3e6e8] bg-white/90 px-4 shadow-[0_8px_24px_-20px_rgba(12,15,16,0.4)] backdrop-blur-xl sm:px-6 lg:px-8">
            <div class="flex items-center gap-3 flex-1 max-w-xl min-w-0">
                <PartnerMobileNav />
                <span class="material-symbols-outlined text-[#7b8081] hidden sm:inline">search</span>
                <div class="flex-1 h-11 rounded-full bg-[#f0f2f3] px-4 flex items-center text-sm text-[#7b8081] truncate">
                    @L.T("partner.layout.searchPlaceholder")
                </div>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
                <LanguageToggle />
                <a href="/partner/notifications"
                   class="relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#eff1f2] text-[#2c2f30] hover:bg-[#e6e8ea] transition-colors"
                   aria-label="@L.T("partner.nav.notifications")"
                   title="@L.T("partner.nav.notifications")">
                    <span class="material-symbols-outlined text-[22px] @(HasUnreadNotifications ? "cc-bell-ring text-[#3b6700]" : "")">notifications</span>
                    @if (HasUnreadNotifications)
                    {
                        <span class="absolute -top-0.5 -right-0.5 inline-flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-[#dc2626] px-1 text-[10px] font-black text-white">@UnreadNotificationsLabel</span>
                    }
                </a>
                <AccountUserMenu IsPartnerContext="true" />
                <button class="inline-flex items-center gap-2 rounded-full bg-[#eff1f2] px-4 py-2 text-sm font-semibold text-[#3b6700] hover:bg-[#e6e8ea] transition-colors" type="button" @onclick="HandleLogout">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                    <span class="hidden md:inline">@L.T("nav.logout")</span>
                </button>
            </div>
        </header>

        <main class="flex-1 px-4 pb-16 pt-6 sm:px-6 sm:pt-8 lg:px-10">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _sidebarPreferenceLoaded;

    private string SidebarWidthClass => _sidebarCollapsed ? "w-[4.5rem]" : "w-72";
    private string SidebarOffsetClass => _sidebarCollapsed ? "lg:ml-[4.5rem]" : "lg:ml-72";

    private string SidebarToggleLabel => _sidebarCollapsed
        ? L.T("partner.sidebar.expand")
        : L.T("partner.sidebar.collapse");

    private bool HasUnreadNotifications => NotificationsBadge.UnreadCount > 0;

    private string UnreadNotificationsLabel => NotificationsBadge.UnreadCount > 99
        ? "99+"
        : NotificationsBadge.UnreadCount.ToString();

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
        NotificationsBadge.OnChange += HandleChange;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sidebarPreferenceLoaded)
        {
            try
            {
                _sidebarCollapsed = await JS.InvokeAsync<bool>("comunaclic.getPartnerSidebarCollapsed");
                _sidebarPreferenceLoaded = true;
                StateHasChanged();
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSException)
            {
            }
        }

        try
        {
            await AuthState.InitializeAsync();
        }
        catch (InvalidOperationException)
        {
            return;
        }

        if (AuthState.IsAuthenticated && (!AuthState.PartnerId.HasValue || AuthState.PartnerId == Guid.Empty))
        {
            var currentPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
            if (!string.Equals(currentPath, "/my-businesses", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(currentPath, "/register/business", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/my-businesses", true);
            }
        }

        if (AuthState.IsAuthenticated && AuthState.PartnerId is { } partnerId && partnerId != Guid.Empty)
        {
            await NotificationsBadge.RefreshAsync(partnerId);
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (AuthState.PartnerId is { } partnerId && partnerId != Guid.Empty)
        {
            // El servicio aplica throttle interno; navegar refresca el contador sin spamear la API.
            _ = NotificationsBadge.RefreshAsync(partnerId);
        }
    }

    private async Task ToggleSidebarAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            await JS.InvokeVoidAsync("comunaclic.setPartnerSidebarCollapsed", _sidebarCollapsed);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
        NotificationsBadge.OnChange -= HandleChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private async Task HandleLogout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }

    private string GetNavLinkClass(string href)
    {
        var currentPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
        var isActive = string.Equals(currentPath, href, StringComparison.OrdinalIgnoreCase);
        if (!isActive && !string.Equals(href, "/partner", StringComparison.OrdinalIgnoreCase))
        {
            isActive = currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase)
                && (currentPath.Length == href.Length || currentPath[href.Length] == '/');
        }

        if (_sidebarCollapsed)
        {
            return isActive
                ? "flex items-center justify-center rounded-xl p-3 text-[#76BC21] bg-[#a7f255]/15 ring-2 ring-[#76BC21]/30"
                : "flex items-center justify-center rounded-xl p-3 text-[#5c5b5b] hover:bg-[#f5f6f7] transition-colors";
        }

        return isActive
            ? "flex items-center gap-3 px-4 py-3 text-[#76BC21] border-l-4 border-[#76BC21] bg-[#a7f255]/10 font-semibold tracking-tight"
            : "flex items-center gap-3 px-4 py-3 text-[#5c5b5b] hover:bg-[#f5f6f7] transition-colors tracking-tight";
    }
}
