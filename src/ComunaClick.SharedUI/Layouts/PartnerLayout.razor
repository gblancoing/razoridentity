@inherits LayoutComponentBase
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="min-h-screen bg-background-light dark:bg-background-dark text-[#111816] dark:text-white">
    <div class="flex min-h-screen">
        <aside class="hidden lg:flex lg:w-72 flex-col border-r border-gray-200 dark:border-gray-800 bg-white dark:bg-[#122620]">
            <div class="flex items-center gap-2 px-6 py-5 border-b border-gray-100 dark:border-gray-800">
                <img src="_content/ComunaClick.SharedUI/logo-largo.png" alt="ComunaClic" class="h-14 w-auto" />
            </div>
            <nav class="flex-1 px-4 py-6 space-y-2 text-sm">
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner">@L.T("partner.nav.dashboard")</a>
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner/catalog">@L.T("partner.nav.catalog")</a>
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner/agenda">@L.T("partner.nav.agenda")</a>
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner/leads">@L.T("partner.nav.leads")</a>
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner/payouts">@L.T("partner.nav.payouts")</a>
                <a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-primary/10" href="/partner/notifications">@L.T("partner.nav.notifications")</a>
            </nav>
            <div class="px-4 py-6 border-t border-gray-100 dark:border-gray-800">
                <div class="flex flex-col items-center gap-2">
                    <img src="_content/ComunaClick.SharedUI/logo-largo.png" alt="ComunaClic" class="h-16 w-auto" />
                    <span class="text-xs text-[#61897c]">@L.T("partner.footer")</span>
                </div>
            </div>
        </aside>

        <div class="flex-1 flex flex-col">
            <header class="sticky top-0 z-40 bg-white/95 dark:bg-background-dark/95 backdrop-blur border-b border-gray-200 dark:border-gray-800">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">dashboard</span>
                        <span class="text-sm font-semibold">@L.T("partner.header")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <LanguageToggle />
                        <a class="text-sm font-semibold text-primary" href="/my-businesses">Mis negocios</a>
                        <a class="text-sm font-semibold text-primary" href="/">@L.T("partner.backHome")</a>
                        <button class="text-sm font-semibold text-[#61897c] hover:text-primary" type="button" @onclick="HandleLogout">
                            @L.T("nav.logout")
                        </button>
                    </div>
                </div>
            </header>

            <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
                @Body
            </main>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (AuthState.IsAuthenticated && (!AuthState.PartnerId.HasValue || AuthState.PartnerId == Guid.Empty))
        {
            var currentPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
            if (!string.Equals(currentPath, "/my-businesses", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(currentPath, "/register/business", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/my-businesses", true);
            }
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }

    private async Task HandleLogout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }
}
