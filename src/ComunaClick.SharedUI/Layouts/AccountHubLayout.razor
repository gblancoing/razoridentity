@inherits LayoutComponentBase
@inject LocaleService L
@inject AuthStateService AuthState
@inject ApiSessionService ApiSession
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="min-h-screen bg-[#f5f6f7] text-[#2c2f30]">
    <aside class="hidden lg:flex fixed left-0 top-0 h-full w-72 flex-col bg-white border-r border-[#e3e6e8] z-50">
        <div class="p-8 pb-6">
            <a href="/" class="flex items-center gap-4 mb-8 hover:opacity-90 transition-opacity">
                <div class="w-11 h-11 rounded-xl bg-[#a7f255] flex items-center justify-center">
                    <img src="_content/ComunaClick.SharedUI/loading.png" alt="ComunaClic" class="w-7 h-7 object-contain" />
                </div>
                <div>
                    <h1 class="text-xl font-black tracking-[-0.04em] text-[#111816]">ComunaClic</h1>
                    <p class="text-[10px] uppercase tracking-[0.22em] text-[#8a8f90] font-bold">@L.T("account.hub.badge")</p>
                </div>
            </a>

            <nav class="space-y-2 text-sm font-semibold">
                <p class="px-4 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("account.nav.section.activity")</p>
                <a class="@NavClass(AccountRoutes.Buyer)" href="@AccountRoutes.Buyer">
                    <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                    <span>
                        @L.T("account.nav.buyer")
                        <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("account.nav.buyer.hint")</span>
                    </span>
                </a>
                <a class="@NavClass(AccountRoutes.Messages)" href="@AccountRoutes.Messages">
                    <span class="material-symbols-outlined text-[20px]">mail</span>
                    <span>
                        @L.T("account.nav.messages")
                        <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("account.nav.messages.hint")</span>
                    </span>
                </a>
                @if (_hasPartnerPanel)
                {
                    <p class="px-4 pt-5 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("account.nav.partnerSection")</p>
                    <a class="@NavClass("/partner")" href="/partner">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span>
                        <span>
                            @L.T("account.nav.partnerPanel")
                            <span class="block text-[10px] font-normal text-[#8a8f90] mt-0.5">@L.T("account.nav.partnerPanel.hint")</span>
                        </span>
                    </a>
                }
            </nav>
        </div>

        <div class="mt-auto p-8 space-y-2">
            <a href="/"
               class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-2xl border border-[#dbe6e2] bg-white text-sm font-bold text-[#3b6700] hover:bg-[#f0fdf4]">
                <span class="material-symbols-outlined text-[18px]">home</span>
                @L.T("account.nav.backHome")
            </a>
        </div>
    </aside>

    <div class="lg:ml-72 min-h-screen">
        <header class="sticky top-0 z-40 h-16 flex justify-between items-center px-4 sm:px-6 lg:px-8 bg-white/90 backdrop-blur-xl border-b border-[#e3e6e8]">
            <p class="text-sm font-bold text-[#111816] lg:hidden">@L.T("account.hub.badge")</p>
            <div class="flex items-center gap-3 sm:gap-4 ml-auto">
                <LanguageToggle />
                <AccountUserMenu HasPartnerPanel="_hasPartnerPanel"
                                 ShowCompanyNav="_showCompanyNav"
                                 ShowProfessionalNav="_showProfessionalNav" />
                <button type="button" class="inline-flex items-center gap-2 rounded-full bg-[#eff1f2] px-4 py-2 text-sm font-semibold text-[#3b6700]" @onclick="HandleLogout">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                    @L.T("nav.logout")
                </button>
            </div>
        </header>

        <main class="px-4 sm:px-6 lg:px-10 pt-8 pb-16 max-w-5xl">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _showProfessionalNav = true;
    private bool _showCompanyNav;
    private bool _hasPartnerPanel;

    protected override void OnInitialized() => L.OnChange += HandleLocaleChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthState.InitializeAsync();
            _hasPartnerPanel = AuthState.IsPartnerAccount;

            var role = RegistrationFlow.RoleNatural;
            try
            {
                var stored = await JSRuntime.InvokeAsync<string>("comunaclic.getAccountRole");
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    role = RegistrationFlow.NormalizeRole(stored);
                }
            }
            catch (InvalidOperationException)
            {
            }

            _showCompanyNav = string.Equals(role, RegistrationFlow.RoleCommerce, StringComparison.OrdinalIgnoreCase);
            _showProfessionalNav = string.Equals(role, RegistrationFlow.RoleProfessional, StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, RegistrationFlow.RoleNatural, StringComparison.OrdinalIgnoreCase);

            if (_hasPartnerPanel && await ApiSession.EnsureReadyAsync())
            {
                try
                {
                    var mine = await PartnerApi.ListMyPartnersAsync();
                    if (mine is { Count: > 0 })
                    {
                        _showCompanyNav = true;
                    }
                }
                catch
                {
                }
            }

            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
        }
    }

    private string NavClass(string href)
    {
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
        var active = string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
            || (href != "/partner" && path.StartsWith(href, StringComparison.OrdinalIgnoreCase)
                && (path.Length == href.Length || path[href.Length] == '/'));
        return active
            ? "flex items-center gap-3 px-4 py-3 text-[#76BC21] border-l-4 border-[#76BC21] bg-[#a7f255]/10 font-semibold"
            : "flex items-center gap-3 px-4 py-3 text-[#5c5b5b] hover:bg-[#f5f6f7] transition-colors";
    }

    private async Task HandleLogout()
    {
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }

    private void HandleLocaleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLocaleChange;
}
