@using ComunaClick.SharedUI.Services
@inject LocaleService L

@if (HasAnyContact)
{
    <section class="rounded-2xl border border-[#e5e0d8] bg-white px-4 py-4 shadow-[0_8px_24px_-16px_rgba(0,0,0,0.12)] sm:px-5 sm:py-5">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#7b8081]">@L.T("public.store.contact.title")</p>
        <div class="mt-3 grid gap-3 @GridClass">
            @if (!string.IsNullOrWhiteSpace(Address))
            {
                var addressLines = PublicAddressFormatter.SplitForDisplay(Address);
                <div class="flex min-w-0 items-start gap-3 rounded-2xl border border-[#eceae6] bg-[#fafaf8] p-3.5 sm:p-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#e8f3dc] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                    </span>
                    <div class="min-w-0" title="@Address">
                        <p class="text-[10px] font-bold uppercase tracking-wide text-[#7b8081]">@L.T("public.store.contact.address")</p>
                        <p class="mt-1 text-sm font-semibold leading-snug text-[#2c2f30]">@addressLines.Primary</p>
                        @if (!string.IsNullOrWhiteSpace(addressLines.Secondary))
                        {
                            <p class="mt-0.5 text-xs leading-snug text-[#595c5d]">@addressLines.Secondary</p>
                        }
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Phone))
            {
                <a href="@($"tel:{Phone}")"
                   class="flex min-w-0 items-start gap-3 rounded-2xl border border-[#eceae6] bg-[#fafaf8] p-3.5 transition hover:border-[#3b6700]/35 hover:bg-[#f3f9eb] sm:p-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#e8f3dc] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[20px]">call</span>
                    </span>
                    <div class="min-w-0">
                        <p class="text-[10px] font-bold uppercase tracking-wide text-[#7b8081]">@L.T("public.store.contact.phone")</p>
                        <p class="mt-1 text-sm font-bold text-[#3b6700]">@Phone</p>
                    </div>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Email))
            {
                <a href="@($"mailto:{Email}")"
                   class="flex min-w-0 items-start gap-3 rounded-2xl border border-[#eceae6] bg-[#fafaf8] p-3.5 transition hover:border-[#3b6700]/35 hover:bg-[#f3f9eb] sm:p-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#e8f3dc] text-[#3b6700]">
                        <span class="material-symbols-outlined text-[20px]">mail</span>
                    </span>
                    <div class="min-w-0">
                        <p class="text-[10px] font-bold uppercase tracking-wide text-[#7b8081]">@L.T("public.store.contact.email")</p>
                        <p class="mt-1 truncate text-sm font-bold text-[#3b6700]">@Email</p>
                    </div>
                </a>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string? Address { get; set; }
    [Parameter] public string? Phone { get; set; }
    [Parameter] public string? Email { get; set; }

    private bool HasAnyContact =>
        !string.IsNullOrWhiteSpace(Address)
        || !string.IsNullOrWhiteSpace(Phone)
        || !string.IsNullOrWhiteSpace(Email);

    private string GridClass
    {
        get
        {
            var count = new[] { Address, Phone, Email }.Count(x => !string.IsNullOrWhiteSpace(x));
            return count switch
            {
                1 => "grid-cols-1",
                2 => "sm:grid-cols-2",
                _ => "sm:grid-cols-2 lg:grid-cols-3"
            };
        }
    }
}
