@using ComunaClick.Common
@inject LocaleService L

@if (ProfileWebLinksHelper.HasAny(Links))
{
    <div class="@RootClass">
        <p class="@LabelClass">@(string.IsNullOrWhiteSpace(Title) ? L.T("public.links.title") : Title)</p>
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var entry in ProfileWebLinksHelper.GetEntries(Links!))
            {
                <a href="@entry.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="@LinkClass"
                   title="@ResolveLabel(entry)">
                    <span class="material-symbols-outlined text-[18px]">@entry.Icon</span>
                    <span>@ResolveLabel(entry)</span>
                </a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ProfileWebLinks? Links { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string RootClass { get; set; } = "rounded-2xl border border-[#e8e6e1] bg-white p-4";
    [Parameter] public string LabelClass { get; set; } = "text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081]";
    [Parameter] public string LinkClass { get; set; } = "inline-flex items-center gap-2 rounded-xl border border-[#dadddf] bg-[#fafaf8] px-3 py-2 text-xs font-bold text-[#3b6700] transition hover:border-[#3b6700]/30 hover:bg-[#eff8e0]";

    private string ResolveLabel(ProfileWebLinkEntry entry)
        => entry.Key switch
        {
            "website" => L.T("public.links.website"),
            "instagram" => "Instagram",
            "facebook" => "Facebook",
            "linkedin" => "LinkedIn",
            "x" => "X",
            "tiktok" => "TikTok",
            "youtube" => "YouTube",
            _ => entry.LabelKey
        };
}
