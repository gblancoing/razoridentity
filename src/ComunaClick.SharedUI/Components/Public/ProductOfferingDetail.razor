@using BuyerModels = ComunaClick.Shared.Api.Buyer
@using ComunaClick.SharedUI.Services
@inject LocaleService L
@inject ApiMediaUrl MediaUrl

<div class="overflow-hidden rounded-[2rem] border border-[#e3e6e8] bg-white shadow-[0_24px_80px_-40px_rgba(0,0,0,0.18)]">
    <section class="relative min-h-[320px] lg:min-h-[380px]">
        <button type="button"
                class="absolute inset-0 z-[1] cursor-zoom-in border-0 bg-cover bg-center p-0"
                style="@HeroStyle"
                aria-label="@L.T("public.product.gallery.expand")"
                @onclick="() => OpenLightbox(_galleryIndex)">
        </button>
        <div class="absolute inset-0 bg-gradient-to-br from-[#0a0c0a]/30 via-[#0a0c0a]/15 to-[#1a2e0b]/5 pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0c0a]/35 via-transparent to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex min-h-[320px] flex-col justify-end p-6 sm:p-10 lg:min-h-[380px]">
            @if (!string.IsNullOrWhiteSpace(PartnerLogoUrl) || !string.IsNullOrWhiteSpace(PartnerName))
            {
                <div class="mb-4 flex items-center gap-3">
                    <PartnerBrandMark LogoUrl="@PartnerLogoUrl" PartnerName="@PartnerName" Size="md" />
                    @if (!string.IsNullOrWhiteSpace(PartnerName))
                    {
                        <span class="text-sm font-bold text-white/90">@PartnerName</span>
                    }
                </div>
            }
            <p class="text-[11px] font-bold uppercase tracking-[0.28em] text-[#d9ffad]/90">@L.T("public.product.eyebrow")</p>
            <h1 class="mt-3 text-4xl font-black leading-[1.05] tracking-[-0.04em] text-white sm:text-5xl">@Product.Name</h1>
            <p class="mt-4 text-3xl font-black tracking-[-0.03em] text-[#a7f255]">@PublicOfferVisuals.FormatMoney(Product.Price, Product.Currency)</p>
            <div class="mt-4 flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(Product.Category))
                {
                    <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">@Product.Category</span>
                }
                <span class="rounded-full px-3 py-1 text-xs font-bold @(InStock ? "bg-[#a7f255] text-[#1a2e0b]" : "bg-white/90 text-[#595c5d]")">
                    @(InStock ? L.T("public.product.inStock") : L.T("public.product.outOfStock"))
                </span>
            </div>
        </div>

        @if (Gallery.Count > 0)
        {
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 bg-black/25 px-6 py-4 backdrop-blur sm:px-10">
                @if (Gallery.Count > 1)
                {
                    <div class="flex min-w-0 flex-1 gap-2 overflow-x-auto pb-1">
                        @for (var i = 0; i < Gallery.Count; i++)
                        {
                            var index = i;
                            <button type="button"
                                    class="@(index == _galleryIndex ? "ring-2 ring-[#a7f255] " : "opacity-80 hover:opacity-100 ")relative h-16 w-24 shrink-0 overflow-hidden rounded-xl border border-white/20"
                                    @onclick="() => OpenLightbox(index)">
                                <img src="@Gallery[index]" alt="" class="h-full w-full object-cover" />
                                <span class="absolute inset-0 bg-black/35 transition hover:bg-black/20" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                }
                <button type="button"
                        class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-white/25 bg-white/10 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/20"
                        @onclick="() => OpenLightbox(_galleryIndex)">
                    <span class="material-symbols-outlined text-[18px]">zoom_in</span>
                    @L.T("public.product.gallery.expand")
                </button>
            </div>
        }
    </section>

    <div class="grid gap-0 lg:grid-cols-[minmax(0,1.45fr)_minmax(300px,1fr)]">
        <article class="border-b border-[#eceae6] p-6 sm:p-10 lg:border-b-0 lg:border-r">
            <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#7b8081]">@L.T("public.product.about")</p>
            @if (DescriptionBlocks.Count > 0)
            {
                <div class="mt-5 space-y-4 text-base leading-7 text-[#2c2f30]">
                    @foreach (var block in DescriptionBlocks)
                    {
                        <p class="whitespace-pre-line">@block</p>
                    }
                </div>
            }
            else
            {
                <p class="mt-5 rounded-2xl border border-dashed border-[#dadddf] bg-[#fafaf8] px-5 py-4 text-sm text-[#595c5d]">
                    @L.T("public.product.noDescription")
                </p>
            }
        </article>
        <aside class="space-y-6 bg-[#fafaf8] p-6 sm:p-8">
            @if (!string.IsNullOrWhiteSpace(ConsultHref))
            {
                <article class="rounded-2xl border border-[#dbe6e2] bg-gradient-to-br from-[#eff8e0] to-white p-5">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-[24px] text-[#3b6700] shrink-0">forum</span>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#7b8081]">@L.T("public.offer.sidebar.consult.badge")</p>
                            <p class="mt-1 text-base font-black text-[#2c2f30]">@L.T("public.offer.sidebar.consult.title")</p>
                            <p class="mt-1 text-sm text-[#595c5d]">@L.T("public.offer.sidebar.consult.hint")</p>
                        </div>
                    </div>
                    <a href="@ConsultHref"
                       class="mt-4 flex w-full items-center justify-center gap-2 rounded-2xl bg-[#3b6700] px-5 py-3 text-sm font-bold text-[#d9ffad] hover:bg-[#335900]">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        @L.T("public.offer.cta.consult")
                    </a>
                </article>
            }
            <article class="rounded-2xl border border-[#e8e6e1] bg-white p-5">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#7b8081]">@L.T("public.product.sidebar.buy")</p>
                <a href="@PrimaryCtaHref"
                   class="mt-4 flex w-full items-center justify-center gap-2 rounded-2xl bg-[#3b6700] px-5 py-3.5 text-sm font-bold text-[#d9ffad] hover:bg-[#335900] @(InStock ? "" : "pointer-events-none opacity-50")">
                    @PrimaryCtaLabel
                </a>
                @if (ShowAddToCart)
                {
                    @* Carrito multi-negocio: permite juntar productos de varios locales antes de pagar. *@
                    <button type="button"
                            class="mt-3 flex w-full items-center justify-center gap-2 rounded-2xl bg-[#d9ffad] px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#cdf593] disabled:opacity-60"
                            disabled="@AddToCartBusy"
                            @onclick="OnAddToCart">
                        <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                        @(AddToCartBusy ? "..." : L.T("buyer.cart.add"))
                    </button>
                    @if (!string.IsNullOrWhiteSpace(CartStatusMessage))
                    {
                        <p class="mt-2 text-xs text-[#61897c]">@CartStatusMessage</p>
                    }
                    @if (CartAdded)
                    {
                        <a href="/buyer/cart" class="mt-3 flex w-full items-center justify-center rounded-2xl border border-[#3b6700] px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#eff8e0]">
                            @(CartItemCount > 0 ? string.Format(L.T("buyer.cart.viewWithCount"), CartItemCount) : L.T("buyer.cart.view"))
                        </a>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(SecondaryCtaHref) && !string.IsNullOrWhiteSpace(SecondaryCtaLabel))
                {
                    <a href="@SecondaryCtaHref" class="mt-3 flex w-full items-center justify-center rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#2c2f30] hover:border-[#3b6700]/40">
                        @SecondaryCtaLabel
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(ShareRelativePath))
                {
                    <div class="mt-4 flex justify-center">
                        <SharePublicLink RelativePath="@ShareRelativePath"
                                         Title="@(ShareTitle ?? Product.Name)"
                                         ButtonClass="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-[#dadddf] px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#eff8e0]" />
                    </div>
                }
            </article>
            <article class="rounded-2xl border border-[#e8e6e1] bg-white p-5">
                <dl class="space-y-3">
                    @foreach (var fact in Facts)
                    {
                        <div class="flex items-baseline justify-between gap-3 border-b border-[#f0f1f2] py-2 last:border-0">
                            <dt class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">@fact.Label</dt>
                            <dd class="text-right text-sm font-semibold text-[#2c2f30]">@fact.Value</dd>
                        </div>
                    }
                </dl>
            </article>
        </aside>
    </div>
</div>

<OfferGalleryLightbox IsOpen="_lightboxOpen"
                      Gallery="Gallery"
                      Index="_lightboxIndex"
                      IndexChanged="OnLightboxIndexChanged"
                      Title="@Product.Name"
                      CounterLocaleKey="public.product.gallery.counter"
                      OnClose="CloseLightbox" />

@code {
    [Parameter, EditorRequired] public BuyerModels.Product Product { get; set; } = default!;
    [Parameter] public string? PartnerLogoUrl { get; set; }
    [Parameter] public string? PartnerName { get; set; }
    [Parameter, EditorRequired] public string PrimaryCtaHref { get; set; } = default!;
    [Parameter, EditorRequired] public string PrimaryCtaLabel { get; set; } = default!;
    [Parameter] public string? ConsultHref { get; set; }
    [Parameter] public string? SecondaryCtaHref { get; set; }
    [Parameter] public string? SecondaryCtaLabel { get; set; }
    [Parameter] public string? PartnerHref { get; set; }
    [Parameter] public string? ShareRelativePath { get; set; }
    [Parameter] public string? ShareTitle { get; set; }
    [Parameter] public IReadOnlyList<(string Label, string Value)> Facts { get; set; } = Array.Empty<(string, string)>();
    // Agregar al carrito (la lógica vive en la página que hospeda el componente).
    [Parameter] public bool ShowAddToCart { get; set; }
    [Parameter] public bool AddToCartBusy { get; set; }
    [Parameter] public string? CartStatusMessage { get; set; }
    [Parameter] public bool CartAdded { get; set; }
    [Parameter] public int CartItemCount { get; set; }
    [Parameter] public EventCallback OnAddToCart { get; set; }

    private int _galleryIndex;
    private int _lightboxIndex;
    private bool _lightboxOpen;

    private bool InStock => Product.InStock;

    private IReadOnlyList<string> Gallery
        => MediaUrl.ResolveMany(PublicOfferVisuals.ResolveGallery(Product.ImageUrl, Product.ImageUrls, Product.Category, Product.Name));

    private string HeroStyle
        => PublicOfferVisuals.BackgroundStyle(
            Gallery.Count > 0 ? Gallery[Math.Clamp(_galleryIndex, 0, Gallery.Count - 1)] : MediaUrl.Resolve("_content/ComunaClick.SharedUI/logo.png"));

    private IReadOnlyList<string> DescriptionBlocks => SplitDescription(Product.Description);

    private void OpenLightbox(int index)
    {
        _galleryIndex = Math.Clamp(index, 0, Gallery.Count - 1);
        _lightboxIndex = _galleryIndex;
        _lightboxOpen = true;
    }

    private void CloseLightbox() => _lightboxOpen = false;

    private void OnLightboxIndexChanged(int index)
    {
        _lightboxIndex = index;
        _galleryIndex = index;
    }

    private static IReadOnlyList<string> SplitDescription(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return Array.Empty<string>();
        }

        return text.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToList();
    }
}
