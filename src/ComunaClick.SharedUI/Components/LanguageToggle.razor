@inject ComunaClick.SharedUI.Services.LocaleService LocaleService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="flex items-center gap-2 text-xs font-semibold" aria-label='@LocaleService.T("nav.language")'>
    <button class='@ButtonClass("es")' @onclick='() => SetLanguageAsync("es")'>ES</button>
    <button class='@ButtonClass("en")' @onclick='() => SetLanguageAsync("en")'>EN</button>
</div>

@code {
    /// <summary>Estilo para pie de página oscuro (PublicFooter).</summary>
    [Parameter]
    public bool OnDarkFooter { get; set; }

    /// <summary>Estilo para usar sobre la barra verde (primary) del sitio público.</summary>
    [Parameter]
    public bool OnBrandBar { get; set; }

    protected override void OnInitialized()
    {
        LocaleService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private string ButtonClass(string language)
    {
        var isActive = string.Equals(LocaleService.Language, language, StringComparison.OrdinalIgnoreCase);
        if (OnDarkFooter)
        {
            return isActive
                ? "px-2 py-1 rounded-md bg-emerald-500 text-white font-bold shadow-sm"
                : "px-2 py-1 rounded-md border border-white/40 text-slate-100 hover:border-white/70 hover:text-white";
        }

        if (OnBrandBar)
        {
            return isActive
                ? "px-2 py-1 rounded-md bg-white text-primary font-bold shadow-sm"
                : "px-2 py-1 rounded-md border border-white/60 text-white hover:bg-white/15";
        }

        return isActive
            ? "px-2 py-1 rounded-md bg-primary text-[#111816]"
            : "px-2 py-1 rounded-md border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:text-primary";
    }

    private async Task SetLanguageAsync(string language)
    {
        await LocaleService.SetLanguageAsync(language, JSRuntime);
    }

    public void Dispose()
    {
        LocaleService.OnChange -= HandleChange;
    }
}
