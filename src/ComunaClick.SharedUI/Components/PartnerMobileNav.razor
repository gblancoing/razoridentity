@inject LocaleService L
@inject NavigationManager Navigation

<div class="lg:hidden">
    @if (_open)
    {
        <button type="button"
                class="fixed inset-0 z-40 bg-black/30"
                aria-label="@L.T("partner.mobileNav.close")"
                @onclick="Close"></button>
        <nav class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] bg-white border-r border-[#e3e6e8] shadow-xl flex flex-col overflow-y-auto"
             aria-label="@L.T("partner.mobileNav.open")">
            <div class="p-6 border-b border-[#e3e6e8] flex items-center justify-between">
                <p class="text-sm font-black text-[#111816]">ComunaClic</p>
                <button type="button" class="p-2 rounded-full hover:bg-[#f5f6f7]" @onclick="Close" aria-label="@L.T("partner.mobileNav.close")">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-4 space-y-1 text-sm font-semibold">
                <p class="px-3 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.operations")</p>
                <a href="/partner" class="@LinkClass("/partner")" @onclick="Close">@L.T("partner.nav.dashboard")</a>
                <a href="/partner/catalog" class="@LinkClass("/partner/catalog")" @onclick="Close">@L.T("partner.nav.catalog")</a>
                <a href="/partner/storefront" class="@LinkClass("/partner/storefront")" @onclick="Close">@L.T("partner.nav.storefront")</a>
                <a href="/partner/agenda" class="@LinkClass("/partner/agenda")" @onclick="Close">@L.T("partner.nav.agenda")</a>
                <a href="/partner/leads" class="@LinkClass("/partner/leads")" @onclick="Close">@L.T("partner.nav.leads")</a>
                <p class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.finance")</p>
                <a href="/partner/payouts" class="@LinkClass("/partner/payouts")" @onclick="Close">@L.T("partner.nav.payouts")</a>
                <a href="/partner/mercadopago" class="@LinkClass("/partner/mercadopago")" @onclick="Close">@L.T("partner.nav.mercadopago")</a>
                <p class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] font-bold text-[#8a8f90]">@L.T("partner.nav.section.system")</p>
                <a href="/partner/notifications" class="@LinkClass("/partner/notifications")" @onclick="Close">@L.T("partner.nav.notifications")</a>
                <a href="/partner/messages" class="@LinkClass("/partner/messages")" @onclick="Close">@L.T("partner.nav.messages")</a>
                <a href="/partner/settings" class="@LinkClass("/partner/settings")" @onclick="Close">@L.T("partner.nav.settings")</a>
            </div>
            <div class="mt-auto p-4 border-t border-[#e3e6e8]">
                <a href="/partner/quickstart"
                   class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl bg-[#3b6700] text-[#d9ffad] font-bold"
                   @onclick="Close">
                    <span class="material-symbols-outlined text-[20px]">add_circle</span>
                    @L.T("partner.layout.createOffer")
                </a>
            </div>
        </nav>
    }

    <button type="button"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-[#dadddf] bg-[#f5f6f7] text-[#3b6700]"
            aria-expanded="@_open"
            aria-label="@L.T("partner.mobileNav.open")"
            @onclick="Toggle">
        <span class="material-symbols-outlined">menu</span>
    </button>
</div>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private string LinkClass(string href)
    {
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
        var active = string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
            || (href != "/partner" && path.StartsWith(href, StringComparison.OrdinalIgnoreCase)
                && (path.Length == href.Length || path[href.Length] == '/'));
        return active
            ? "block px-3 py-2.5 rounded-xl text-[#3b6700] bg-[#a7f255]/15 font-bold"
            : "block px-3 py-2.5 rounded-xl text-[#2c2f30] hover:bg-[#f5f6f7]";
    }
}
