@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi

<section class="bg-white border border-gray-200 rounded-[2rem] p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.badge")</p>
            <h2 class="mt-2 text-2xl font-black tracking-[-0.04em] text-[#2c2f30]">@(Partner?.Name ?? L.T("buyer.profile.company.title"))</h2>
            <p class="mt-2 text-sm text-[#61897c]">@CompanySubtitle</p>
            @if (Partner is not null)
            {
                <p class="mt-2 text-xs font-semibold text-[#3b6700]">
                    @L.T("buyer.profile.company.managing"): @Partner.Name
                </p>
            }
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#f0fdf4] px-4 py-2 text-xs font-bold text-[#14532d]">
            <span class="material-symbols-outlined text-[18px]">@CompanyTypeIcon</span>
            @CompanyTypeLabel
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="text-sm font-semibold @(_statusOk ? "text-[#14532d]" : "text-[#854d0e]")">@_statusMessage</p>
    }

    @if (Partner is null)
    {
        <p class="text-sm text-[#61897c]">@L.T("buyer.profile.company.subtitle.generic")</p>
        <ul class="mt-4 space-y-2 text-sm text-[#61897c] list-disc pl-5">
            <li>@L.T("buyer.profile.company.onboarding.step1")</li>
            <li>@L.T("buyer.profile.company.onboarding.step2")</li>
            <li>@L.T("buyer.profile.company.onboarding.step3")</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="@CreateBusinessHref"
               class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] px-6 py-3.5 text-sm font-bold text-white shadow-[0_12px_28px_-14px_rgba(59,103,0,0.75)] hover:bg-[#335900]">
                <span class="material-symbols-outlined text-[22px]">storefront</span>
                @L.T("buyer.profile.company.onboarding.create")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
            @if (SessionPartnerId is Guid sessionPartnerId && sessionPartnerId != Guid.Empty && SessionTenantId is Guid sessionTenantId)
            {
                <PartnerScopedLink PartnerId="sessionPartnerId" TenantId="sessionTenantId" Href="/partner"
                                   CssClass="inline-flex items-center gap-2 rounded-2xl border border-[#3b6700] bg-white px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#f0fdf4]">
                    <span class="material-symbols-outlined text-[20px]">open_in_new</span>
                    @L.T("buyer.profile.company.panel.openDirect")
                </PartnerScopedLink>
            }
        </div>
        <div class="mt-4 rounded-2xl border border-[#fecaca] bg-[#fef2f2] px-4 py-3 text-sm text-[#991b1b]">
            @L.T("buyer.profile.company.partnerMissing")
        </div>
    }
    else
    {
        <div class="flex flex-wrap gap-3">
            <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner"
                               CssClass="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] px-6 py-3.5 text-sm font-bold text-white shadow-[0_12px_28px_-14px_rgba(59,103,0,0.75)] hover:bg-[#335900]">
                <span class="material-symbols-outlined text-[22px]">dashboard</span>
                @L.T("buyer.profile.company.panel.openFull")
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </PartnerScopedLink>
            <a href="@($"/buyer/detail/partner/{Partner.Id}")"
               class="inline-flex items-center gap-2 rounded-2xl border border-[#dbe6e2] bg-white px-5 py-3 text-sm font-bold text-[#3b6700] hover:bg-[#f0fdf4]">
                <span class="material-symbols-outlined text-[20px]">visibility</span>
                @(Partner.IsVisible ? L.T("buyer.profile.company.panel.viewPublic") : L.T("buyer.profile.company.panel.previewDraft"))
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.catalog")</p>
                <p class="mt-2 text-3xl font-black text-[#2c2f30]">@_catalogCount</p>
            </article>
            <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.visibility")</p>
                <p class="mt-2 text-lg font-black text-[#2c2f30]">@(Partner.IsVisible ? L.T("buyer.profile.company.visible") : L.T("buyer.profile.company.hidden"))</p>
            </article>
            <article class="rounded-2xl border border-[#dbe6e2] bg-[#fafafa] p-5">
                <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.metric.category")</p>
                <p class="mt-2 text-sm font-bold text-[#2c2f30]">@(Partner.SubcategoryName ?? Partner.CategoryName ?? "—")</p>
            </article>
        </div>

        <section class="rounded-3xl border border-[#e3e6e8] bg-[#f8faf9] p-6 md:p-8 space-y-6">
            <div>
                <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.title")</p>
                <h3 class="mt-2 text-xl font-black text-[#2c2f30]">@PanelOperationsTitle</h3>
                <p class="mt-1 text-sm text-[#61897c]">@L.T("buyer.profile.company.panel.desc")</p>
            </div>

            @if (_activation is not null)
            {
                <div class="rounded-2xl border border-[#dbe6e2] bg-white p-5 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.activation")</p>
                            <p class="mt-1 text-lg font-black text-[#2c2f30]">@(_activation.StatusLabel ?? "—")</p>
                            @if (!string.IsNullOrWhiteSpace(_activation.NextStep))
                            {
                                <p class="mt-1 text-sm text-[#61897c]">@_activation.NextStep</p>
                            }
                        </div>
                        <div class="text-right">
                            <p class="text-3xl font-black text-[#3b6700]">@_activation.CompletionPercent%</p>
                            <p class="text-xs text-[#7b8081]">@L.T("buyer.profile.company.panel.completed")</p>
                        </div>
                    </div>
                    <div class="h-2 rounded-full bg-[#e6e8ea] overflow-hidden">
                        <div class="h-full rounded-full bg-[#3b6700]" style="width:@($"{_activation.CompletionPercent}%")"></div>
                    </div>
                    @if (_activation.Checklist is { Count: > 0 })
                    {
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            @foreach (var item in _activation.Checklist)
                            {
                                <li class="flex items-start gap-2 rounded-xl bg-[#fafafa] px-3 py-2 text-sm">
                                    <span class="material-symbols-outlined text-[18px] @(item.IsComplete ? "text-[#3b6700]" : "text-[#b58c00]")">
                                        @(item.IsComplete ? "check_circle" : "pending")
                                    </span>
                                    <span class="font-semibold text-[#2c2f30]">@item.Label</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="flex flex-wrap gap-2 pt-1">
                        @if (Partner.IsVisible)
                        {
                            <button type="button" @onclick="() => ToggleVisibilityAsync(false)" disabled="@_isUpdatingVisibility"
                                    class="inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-xs font-bold text-red-700 disabled:opacity-50">
                                <span class="material-symbols-outlined text-[16px]">visibility_off</span>
                                @L.T("buyer.profile.company.panel.unpublish")
                            </button>
                        }
                        else if (_activation.CanPublish)
                        {
                            <button type="button" @onclick="() => ToggleVisibilityAsync(true)" disabled="@_isUpdatingVisibility"
                                    class="inline-flex items-center gap-1.5 rounded-xl bg-[#3b6700] px-4 py-2 text-xs font-bold text-white disabled:opacity-50">
                                <span class="material-symbols-outlined text-[16px]">publish</span>
                                @L.T("buyer.profile.company.panel.publish")
                            </button>
                        }
                        else
                        {
                            <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/quickstart"
                                               CssClass="inline-flex items-center gap-1.5 rounded-xl border border-[#3b6700] px-4 py-2 text-xs font-bold text-[#3b6700]">
                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                @L.T("myBusinesses.complete")
                            </PartnerScopedLink>
                        }
                    </div>
                </div>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @if (IsCommerce)
                {
                    <article class="rounded-2xl border border-[#dbe6e2] bg-white p-4">
                        <p class="text-[10px] uppercase font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.orders")</p>
                        <p class="mt-2 text-2xl font-black">@_ordersCount</p>
                    </article>
                    <article class="rounded-2xl border border-[#dbe6e2] bg-white p-4">
                        <p class="text-[10px] uppercase font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.salesTotal")</p>
                        <p class="mt-2 text-2xl font-black text-[#3b6700]">@_ordersTotal</p>
                    </article>
                }
                @if (IsService)
                {
                    <article class="rounded-2xl border border-[#dbe6e2] bg-white p-4">
                        <p class="text-[10px] uppercase font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.bookings")</p>
                        <p class="mt-2 text-2xl font-black">@_bookingsCount</p>
                    </article>
                    <article class="rounded-2xl border border-[#dbe6e2] bg-white p-4">
                        <p class="text-[10px] uppercase font-bold text-[#7b8081]">@L.T("buyer.profile.company.panel.leads")</p>
                        <p class="mt-2 text-2xl font-black">@_leadsCount</p>
                    </article>
                }
            </div>
        </section>

        @if (IsCommerce)
        {
            <div>
                <h3 class="text-lg font-black text-[#2c2f30]">@L.T("buyer.profile.company.commerce.heading")</h3>
                <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.company.commerce.desc")</p>
                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/catalog"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">inventory_2</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.commerce.catalog")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.commerce.catalogDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/quickstart"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">add_box</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.commerce.create")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.commerce.createDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">shopping_cart</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.commerce.orders")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.commerce.ordersDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/payouts"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">payments</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.commerce.payouts")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.commerce.payoutsDesc")</p>
                        </div>
                    </PartnerScopedLink>
                </div>
                @if (_products.Count > 0)
                {
                    <div class="mt-6">
                        <h4 class="text-sm font-black uppercase tracking-[0.12em] text-[#61897c]">@L.T("buyer.profile.company.products.list") — @Partner.Name</h4>
                        <ul class="mt-4 space-y-3">
                            @foreach (var product in _products.Take(6))
                            {
                                <li class="flex items-center justify-between gap-3 rounded-xl border border-[#dbe6e2] px-4 py-3">
                                    <div>
                                        <p class="font-bold text-[#2c2f30]">@product.Name</p>
                                        @if (product.Price > 0)
                                        {
                                            <p class="text-xs text-[#61897c]">$@product.Price.ToString("N0")</p>
                                        }
                                    </div>
                                    <span class="text-xs font-bold @(product.IsActive ? "text-[#14532d]" : "text-[#854d0e]")">
                                        @(product.IsActive ? L.T("buyer.profile.company.active") : L.T("buyer.profile.company.inactive"))
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        else if (IsService)
        {
            <div>
                <h3 class="text-lg font-black text-[#2c2f30]">@L.T("buyer.profile.company.service.heading")</h3>
                <p class="mt-2 text-sm text-[#61897c]">@L.T("buyer.profile.company.service.desc")</p>
                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/catalog"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">home_repair_service</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.service.catalog")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.service.catalogDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/quickstart"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">add_circle</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.service.create")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.service.createDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/agenda"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">calendar_month</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.service.agenda")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.service.agendaDesc")</p>
                        </div>
                    </PartnerScopedLink>
                    <PartnerScopedLink PartnerId="Partner.Id" TenantId="Partner.TenantId" Href="/partner/leads"
                                       CssClass="group flex items-start gap-4 rounded-2xl border border-[#dbe6e2] p-5 hover:border-[#3b6700] hover:bg-[#f0fdf4] transition-colors">
                        <span class="material-symbols-outlined text-[32px] text-[#3b6700]">forum</span>
                        <div>
                            <p class="font-bold text-[#2c2f30] group-hover:text-[#3b6700]">@L.T("buyer.profile.company.service.leads")</p>
                            <p class="mt-1 text-xs text-[#61897c]">@L.T("buyer.profile.company.service.leadsDesc")</p>
                        </div>
                    </PartnerScopedLink>
                </div>
                @if (_services.Count > 0)
                {
                    <div class="mt-6">
                        <h4 class="text-sm font-black uppercase tracking-[0.12em] text-[#61897c]">@L.T("buyer.profile.company.service.list") — @Partner.Name</h4>
                        <ul class="mt-4 space-y-3">
                            @foreach (var service in _services.Take(6))
                            {
                                <li class="flex items-center justify-between gap-3 rounded-xl border border-[#dbe6e2] px-4 py-3">
                                    <div>
                                        <p class="font-bold text-[#2c2f30]">@service.Name</p>
                                        @if (service.Price > 0)
                                        {
                                            <p class="text-xs text-[#61897c]">$@service.Price.ToString("N0")</p>
                                        }
                                    </div>
                                    <span class="text-xs font-bold @(service.IsActive ? "text-[#14532d]" : "text-[#854d0e]")">
                                        @(service.IsActive ? L.T("buyer.profile.company.active") : L.T("buyer.profile.company.inactive"))
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public ComunaClick.Shared.Api.Partner.PartnerDto? Partner { get; set; }
    [Parameter] public Guid? SessionPartnerId { get; set; }
    [Parameter] public Guid? SessionTenantId { get; set; }
    [Parameter] public EventCallback<ComunaClick.Shared.Api.Partner.PartnerDto> PartnerChanged { get; set; }

    private string CreateBusinessHref => "/register/business?defaultType=B&wizard=1";

    private int _catalogCount;
    private int _ordersCount;
    private int _bookingsCount;
    private int _leadsCount;
    private string _ordersTotal = "$0";
    private IReadOnlyList<ComunaClick.Shared.Api.Partner.Service> _services = Array.Empty<ComunaClick.Shared.Api.Partner.Service>();
    private IReadOnlyList<ComunaClick.Shared.Api.Partner.Product> _products = Array.Empty<ComunaClick.Shared.Api.Partner.Product>();
    private ComunaClick.Shared.Api.Partner.PartnerActivationStatus? _activation;
    private bool _isUpdatingVisibility;
    private string? _statusMessage;
    private bool _statusOk = true;

    private bool IsCommerce => string.Equals(Partner?.Type, "A", StringComparison.OrdinalIgnoreCase);
    private bool IsService => string.Equals(Partner?.Type, "B", StringComparison.OrdinalIgnoreCase);

    private string CompanyTypeIcon => IsCommerce ? "storefront" : IsService ? "home_repair_service" : "store";

    private string CompanyTypeLabel => IsCommerce
        ? L.T("buyer.profile.company.type.commerce")
        : IsService
            ? L.T("buyer.profile.company.type.service")
            : L.T("buyer.profile.company.type.generic");

    private string CompanySubtitle => IsCommerce
        ? L.T("buyer.profile.company.subtitle.commerce")
        : IsService
            ? L.T("buyer.profile.company.subtitle.service")
            : L.T("buyer.profile.company.subtitle.generic");

    private string PanelOperationsTitle => IsCommerce
        ? L.T("buyer.profile.company.commerce.heading")
        : IsService
            ? L.T("buyer.profile.company.service.heading")
            : L.T("buyer.profile.company.panel.title");

    protected override async Task OnParametersSetAsync() => await LoadPanelDataAsync();

    private async Task LoadPanelDataAsync()
    {
        _statusMessage = null;
        if (Partner is null || Partner.Id == Guid.Empty)
        {
            ResetCounts();
            return;
        }

        try
        {
            _activation = await PartnerApi.GetActivationStatusAsync(Partner.Id);

            if (IsCommerce)
            {
                var products = await PartnerApi.GetPartnerProductsAsync(Partner.Id);
                _products = products ?? Array.Empty<ComunaClick.Shared.Api.Partner.Product>();
                _catalogCount = _products.Count;
                _services = Array.Empty<ComunaClick.Shared.Api.Partner.Service>();

                var orders = await PartnerApi.GetPartnerOrdersAsync(Partner.Id);
                _ordersCount = orders?.Count ?? 0;
                _ordersTotal = orders is null || orders.Count == 0
                    ? "$0"
                    : $"${orders.Sum(x => x.TotalAmount):N0}";
                _bookingsCount = 0;
                _leadsCount = 0;
            }
            else if (IsService)
            {
                var services = await PartnerApi.GetPartnerServicesAsync(Partner.Id);
                _services = services ?? Array.Empty<ComunaClick.Shared.Api.Partner.Service>();
                _catalogCount = _services.Count;
                _products = Array.Empty<ComunaClick.Shared.Api.Partner.Product>();

                var bookings = await PartnerApi.GetPartnerBookingsAsync(Partner.Id);
                _bookingsCount = bookings?.Count ?? 0;
                _ordersCount = 0;
                _ordersTotal = "$0";

                try
                {
                    var leads = await PartnerApi.GetPartnerLeadsAsync(Partner.Id);
                    _leadsCount = leads?.Count ?? 0;
                }
                catch
                {
                    _leadsCount = 0;
                }
            }
            else
            {
                ResetCounts();
            }
        }
        catch
        {
            ResetCounts();
        }
    }

    private void ResetCounts()
    {
        _catalogCount = 0;
        _ordersCount = 0;
        _bookingsCount = 0;
        _leadsCount = 0;
        _ordersTotal = "$0";
        _services = Array.Empty<ComunaClick.Shared.Api.Partner.Service>();
        _products = Array.Empty<ComunaClick.Shared.Api.Partner.Product>();
        _activation = null;
    }

    private async Task ToggleVisibilityAsync(bool isVisible)
    {
        if (Partner is null)
        {
            return;
        }

        _isUpdatingVisibility = true;
        _statusMessage = isVisible ? L.T("buyer.profile.company.panel.publish") + "…" : L.T("buyer.profile.company.panel.unpublish") + "…";
        _statusOk = true;

        try
        {
            var updated = await PartnerApi.UpdateVisibilityAsync(Partner.Id, isVisible);
            if (updated is not null)
            {
                Partner = updated;
                await PartnerChanged.InvokeAsync(updated);
            }

            _statusOk = true;
            _statusMessage = updated?.IsVisible == true
                ? L.T("buyer.profile.company.visible")
                : L.T("buyer.profile.company.hidden");
            await LoadPanelDataAsync();
        }
        catch
        {
            _statusOk = false;
            _statusMessage = L.T("ui.error");
        }
        finally
        {
            _isUpdatingVisibility = false;
        }
    }
}
