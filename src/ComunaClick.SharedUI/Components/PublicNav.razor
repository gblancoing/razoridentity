@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<nav class="sticky top-0 z-50 bg-white dark:bg-background-dark border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a class="flex items-center gap-3" href="/" @onclick="CloseMenu">
                <img src="_content/ComunaClick.SharedUI/logo.png" alt="ComunaClic" class="h-14 w-auto" />
            </a>
            <div class="hidden md:flex items-center gap-4">
                <a class="text-sm font-medium hover:text-primary transition-colors" href="/" @onclick="CloseMenu">@L.T("nav.home")</a>
                <a class="text-sm font-medium hover:text-primary transition-colors" href="/ofertas" @onclick="CloseMenu">@L.T("nav.offers")</a>
                <LanguageToggle />
                <a class="text-sm font-medium hover:text-primary transition-colors" href="/help">@L.T("nav.help")</a>
                @if (AuthState.IsAuthenticated)
                {
                    <button type="button"
                            class="rounded-full border-2 border-primary px-4 py-2 text-sm font-bold text-primary bg-white hover:bg-primary/10 transition-colors"
                            @onclick="HandleLogout"> <span class="material-symbols-outlined text-[18px]">logout</span>
                        @L.T("nav.logout")
                    </button>
                }
                else
                {
                    <a class="rounded-full border-2 border-primary px-4 py-2 text-sm font-bold text-primary bg-white hover:bg-primary/10 transition-colors" href="/register?intent=partner">@L.T("nav.register")</a>
                    <a class="rounded-full bg-primary text-white px-5 py-2 font-bold text-sm shadow-[0_8px_22px_-12px_rgba(34,197,94,0.9)]" href="/login">@L.T("nav.login")</a>
                }
            </div>
            <div class="md:hidden flex items-center gap-2">
                <LanguageToggle />
                <button type="button"
                        class="inline-flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 p-2 text-[#111816] dark:text-white"
                        aria-label="Abrir menú"
                        aria-expanded="@_mobileMenuOpen"
                        @onclick="ToggleMenu">
                    <span class="material-symbols-outlined">@(_mobileMenuOpen ? "close" : "menu")</span>
                </button>
            </div>
        </div>

        @if (_mobileMenuOpen)
        {
            <div class="md:hidden border-t border-gray-200 dark:border-gray-800 py-3 space-y-2">
                <a class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-primary/10" href="/" @onclick="CloseMenu">@L.T("nav.home")</a>
                <a class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-primary/10" href="/ofertas" @onclick="CloseMenu">@L.T("nav.offers")</a>
                <a class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-primary/10" href="/help" @onclick="CloseMenu">@L.T("nav.help")</a>
                @if (AuthState.IsAuthenticated)
                {
                    <button type="button"
                            class="block w-full text-left rounded-lg border-2 border-primary px-3 py-2 text-sm font-bold text-primary bg-white hover:bg-primary/10"
                            @onclick="HandleLogout"> <span class="material-symbols-outlined text-[18px]">logout</span>
                        @L.T("nav.logout")
                    </button>
                }
                else
                {
                    <a class="block rounded-lg border-2 border-primary px-3 py-2 text-sm font-bold text-primary bg-white hover:bg-primary/10" href="/register?intent=partner" @onclick="CloseMenu">@L.T("nav.register")</a>
                    <a class="block rounded-lg bg-primary text-white px-3 py-2 text-sm font-bold" href="/login" @onclick="CloseMenu">@L.T("nav.login")</a>
                }
            </div>
        }
    </div>
</nav>

@code {
    private bool _mobileMenuOpen;
    private bool _authInitialized;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_authInitialized)
        {
            return;
        }

        try
        {
            await AuthState.InitializeAsync();
            _authInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // JS interop unavailable during prerender.
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMenu()
    {
        _mobileMenuOpen = false;
    }

    private async Task HandleLogout()
    {
        CloseMenu();
        await AuthState.ClearAsync();
        Navigation.NavigateTo("/", true);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
