<div class="space-y-1">
    <div class="flex items-center gap-1.5">
        <label class="text-sm font-semibold text-[#2c2f30]">@Label</label>
        @if (!string.IsNullOrWhiteSpace(Tooltip))
        {
            <span class="material-symbols-outlined text-[18px] text-[#61897c] cursor-help select-none"
                  title="@Tooltip"
                  aria-label="@Tooltip"
                  tabindex="0">info</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Help))
    {
        <p class="text-xs text-[#61897c] leading-relaxed">@Help</p>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
