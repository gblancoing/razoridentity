@inject LocaleService L

@if (Layout == SearchResultCardLayout.Grid)
{
    <a href="@SearchDisplayHelper.GetResultHref(Item)"
       class="group flex h-full flex-col rounded-2xl border border-emerald-100/90 bg-white p-4 shadow-sm transition hover:border-primary/40 hover:shadow-md">
        <div class="flex items-start justify-between gap-2">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-primary">
                <span class="material-symbols-outlined text-[24px]">@SearchDisplayHelper.GetTypeIcon(Item.Type)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_priceLine))
            {
                <p class="shrink-0 text-sm font-extrabold text-primary">@_priceLine</p>
            }
        </div>
        <div class="mt-3 min-w-0 flex-1">
            <p class="line-clamp-2 text-sm font-extrabold leading-snug text-[#111816]">@Item.Name</p>
            @{
                var subtitle = SearchDisplayHelper.FormatCategorySubtitle(L, Item);
            }
            @if (!string.IsNullOrWhiteSpace(subtitle))
            {
                <p class="mt-1 line-clamp-2 text-xs font-medium text-[#61897c]">@subtitle</p>
            }
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-[11px] font-semibold text-[#61897c]">
            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#2d9e4f]">
                @SearchDisplayHelper.GetTypeLabel(L, Item.Type)
            </span>
            @if (!string.IsNullOrWhiteSpace(_distanceLine))
            {
                <span class="inline-flex items-center gap-0.5">
                    <span class="material-symbols-outlined text-[14px] text-primary">near_me</span>
                    @_distanceLine
                </span>
            }
        </div>
        <span class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-primary/10 py-2 text-xs font-bold text-primary group-hover:bg-primary group-hover:text-white transition-colors">
            @SearchDisplayHelper.GetCtaLabel(L, Item)
        </span>
    </a>
}
else
{
    <a href="@SearchDisplayHelper.GetResultHref(Item)"
       class="group flex items-stretch gap-3 rounded-xl border border-emerald-100/90 bg-white p-3 shadow-sm transition hover:border-primary/40 hover:shadow-md sm:p-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-primary sm:h-14 sm:w-14">
            <span class="material-symbols-outlined text-[26px]">@SearchDisplayHelper.GetTypeIcon(Item.Type)</span>
        </div>
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="min-w-0">
                    <p class="truncate text-sm font-extrabold text-[#111816] sm:text-base">@Item.Name</p>
                    @{
                        var subtitleList = SearchDisplayHelper.FormatCategorySubtitle(L, Item);
                    }
                    @if (!string.IsNullOrWhiteSpace(subtitleList))
                    {
                        <p class="mt-0.5 truncate text-xs font-medium text-[#61897c]">@subtitleList</p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_priceLine))
                {
                    <p class="shrink-0 text-sm font-extrabold text-primary">@_priceLine</p>
                }
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold text-[#61897c]">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#2d9e4f]">
                    @SearchDisplayHelper.GetTypeLabel(L, Item.Type)
                </span>
                @if (!string.IsNullOrWhiteSpace(_distanceLine))
                {
                    <span class="inline-flex items-center gap-0.5">
                        <span class="material-symbols-outlined text-[14px] text-primary">near_me</span>
                        @_distanceLine
                    </span>
                }
            </div>
        </div>
        <div class="hidden shrink-0 flex-col items-end justify-center gap-1 sm:flex">
            <span class="rounded-lg bg-primary/10 px-2.5 py-1 text-[11px] font-bold text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                @SearchDisplayHelper.GetCtaLabel(L, Item)
            </span>
            <span class="material-symbols-outlined text-[20px] text-[#61897c] group-hover:text-primary transition-colors">chevron_right</span>
        </div>
    </a>
}

@code {
    [Parameter, EditorRequired]
    public SearchResultItem Item { get; set; } = default!;

    [Parameter]
    public SearchResultCardLayout Layout { get; set; } = SearchResultCardLayout.List;

    private string? _priceLine;
    private string? _distanceLine;

    protected override void OnParametersSet()
    {
        _priceLine = SearchDisplayHelper.FormatPrice(Item);
        _distanceLine = SearchDisplayHelper.FormatDistance(L, Item);
    }
}
