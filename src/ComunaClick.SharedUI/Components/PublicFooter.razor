@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@implements IDisposable

<footer class="relative overflow-hidden text-slate-100">
    <div class="absolute inset-0 pointer-events-none bg-[#031b13]" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center pointer-events-none" style="@FooterHeroImageStyle" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#043d2a]/95 via-[#065f46]/75 to-[#0f766e]/20 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-transparent to-black/50 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none opacity-[0.06]" aria-hidden="true"
         style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.9) 1px, transparent 0); background-size: 28px 28px;"></div>

    <div class="relative z-10">
        <div class="border-b border-white/10">
            <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 py-10 sm:flex-row sm:px-6">
                <div>
                    <p class="mb-1 text-xs font-black uppercase tracking-[0.14em] text-emerald-200">Comercio Local</p>
                    <h2 class="text-xl font-extrabold leading-tight text-white font-headline sm:text-2xl">
                        Conecta tu negocio con el barrio
                    </h2>
                    <p class="mt-1 text-sm text-white/92">Publica gratis y llega a miles de vecinos en tu comuna.</p>
                </div>
                <a href="/register?intent=partner"
                   class="shrink-0 whitespace-nowrap rounded-2xl bg-emerald-500 px-7 py-3 text-sm font-extrabold text-white shadow-lg shadow-emerald-900/40 transition-all duration-200 hover:scale-105 hover:bg-emerald-400 active:scale-[0.99]">
                    Publicar mi negocio
                </a>
            </div>
        </div>

        <div class="mx-auto max-w-7xl px-4 pb-10 pt-12 sm:px-6">
            <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:gap-12">
                <div class="col-span-2 flex flex-col gap-5 md:col-span-1">
                    <div>
                        <img src="_content/ComunaClick.SharedUI/logo.png" alt="ComunaClic" class="h-10 w-auto sm:h-11" />
                    </div>
                    <p class="max-w-[220px] text-sm leading-relaxed text-slate-50/95">
                        El mercado digital de tu barrio. Negocios, servicios y profesionales verificados en un solo lugar.
                    </p>
                    <div class="mt-1 flex gap-2">
                        <a href="@(_siteContent?.Footer.InstagramUrl ?? "https://www.instagram.com")"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram"
                           class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/90 transition hover:bg-white/20">
                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                                <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4A5.8 5.8 0 0 1 16.2 22H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.95 1.6a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3ZM12 7.2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Zm0 2A2.8 2.8 0 1 0 12 14.8 2.8 2.8 0 0 0 12 9.2Z" />
                            </svg>
                        </a>
                        <a href="@(_siteContent?.Footer.FacebookUrl ?? "https://www.facebook.com")"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Facebook"
                           class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/90 transition hover:bg-white/20">
                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                                <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.25-1.5 1.55-1.5h1.65V5A22 22 0 0 0 14.3 4.9c-2.4 0-4 1.45-4 4.1V11H7.6v3h2.7v8h3.2Z" />
                            </svg>
                        </a>
                        <a href="@(_siteContent?.Footer.LinkedInUrl ?? "https://www.linkedin.com")"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn"
                           class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/90 transition hover:bg-white/20">
                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                                <path d="M6.5 8.8H3.3V21h3.2V8.8ZM4.9 3A1.85 1.85 0 1 0 5 6.7 1.85 1.85 0 0 0 4.9 3Zm16 10.9c0-3.25-1.75-5.35-4.5-5.35a3.8 3.8 0 0 0-3.3 1.8V8.8H10V21h3.2v-6.2c0-1.9 1-3.05 2.55-3.05 1.45 0 2.2 1 2.2 3.05V21H21v-7.1Z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-sm font-bold text-white">@L.T("home.footer.discover")</p>
                    <ul class="mt-4 flex flex-col gap-2.5 text-sm text-slate-200/90">
                        <li><a class="transition hover:text-emerald-200" href="/ofertas">@L.T("nav.offers")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/buyer/favorites">@L.T("home.footer.favorites")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/services-near">@L.T("home.footer.servicesNear")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/top-rated">@L.T("home.footer.topRated")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/new-businesses">@L.T("home.footer.newBusinesses")</a></li>
                    </ul>
                </div>

                <div>
                    <p class="text-sm font-bold text-white">@L.T("home.footer.forBusinesses")</p>
                    <ul class="mt-4 flex flex-col gap-2.5 text-sm text-slate-200/90">
                        <li><a class="transition hover:text-emerald-200" href="/register?intent=partner">@L.T("home.footer.addBusiness")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/advertising">@L.T("home.footer.ads")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/business-tools">@L.T("home.footer.tools")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/login">Panel de negocio</a></li>
                    </ul>
                </div>

                <div>
                    <p class="text-sm font-bold text-white">@L.T("home.footer.support")</p>
                    <ul class="mt-4 flex flex-col gap-2.5 text-sm text-slate-200/90">
                        <li><a class="transition hover:text-emerald-200" href="/help">@L.T("home.footer.help")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/privacy">@L.T("home.footer.privacy")</a></li>
                        <li><a class="transition hover:text-emerald-200" href="/terms">@L.T("home.footer.terms")</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="border-t border-white/10">
            <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-5 sm:flex-row sm:px-6">
                <p class="order-2 text-center text-xs text-slate-100/95 sm:order-1 sm:text-left">
                    @(_siteContent?.Footer.CopyrightText ?? L.T("home.footer.copy"))
                </p>
                <div class="order-1 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:order-2 sm:justify-end">
                    <div class="flex items-center gap-3">
                        <LanguageToggle />
                        <a class="text-xs font-semibold text-white/95 transition hover:text-emerald-200 sm:text-sm" href="/help">@L.T("nav.help")</a>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-slate-100/95">Plataforma activa</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

@code {
    private const string FooterHeroImageUrl =
        "https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1920&q=82";

    private string FooterHeroImageStyle => $"background-image: url('{FooterHeroImageUrl}');";

    private ComunaClick.Shared.Api.Buyer.PublicSiteContentResponse? _siteContent;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _siteContent = await BuyerApi.GetSiteContentAsync();
        }
        catch
        {
            _siteContent = null;
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
