@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@implements IDisposable

<footer class="bg-white dark:bg-background-dark border-t border-gray-200 dark:border-gray-800 pt-12 pb-8">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
            <div>
                <a class="font-bold mb-4 inline-block hover:text-primary" href="/discover">@L.T("home.footer.discover")</a>
                <ul class="flex flex-col gap-2 text-sm text-gray-500">
                    <li><a class="hover:text-primary" href="/services-near">@L.T("home.footer.servicesNear")</a></li>
                    <li><a class="hover:text-primary" href="/top-rated">@L.T("home.footer.topRated")</a></li>
                    <li><a class="hover:text-primary" href="/new-businesses">@L.T("home.footer.newBusinesses")</a></li>
                </ul>
            </div>
            <div>
                <a class="font-bold mb-4 inline-block hover:text-primary" href="/for-businesses">@L.T("home.footer.forBusinesses")</a>
                <ul class="flex flex-col gap-2 text-sm text-gray-500">
                    <li><a class="hover:text-primary" href="/add-business">@L.T("home.footer.addBusiness")</a></li>
                    <li><a class="hover:text-primary" href="/advertising">@L.T("home.footer.ads")</a></li>
                    <li><a class="hover:text-primary" href="/business-tools">@L.T("home.footer.tools")</a></li>
                </ul>
            </div>
            <div>
                <a class="font-bold mb-4 inline-block hover:text-primary" href="/support">@L.T("home.footer.support")</a>
                <ul class="flex flex-col gap-2 text-sm text-gray-500">
                    <li><a class="hover:text-primary" href="/help">@L.T("home.footer.help")</a></li>
                    <li><a class="hover:text-primary" href="/privacy">@L.T("home.footer.privacy")</a></li>
                    <li><a class="hover:text-primary" href="/terms">@L.T("home.footer.terms")</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-4">@L.T("home.footer.follow")</h4>
                <div class="flex gap-3">
                    <a href="@(_siteContent?.Footer.InstagramUrl ?? "https://www.instagram.com")" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                       class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#fff1f2] text-[#e1306c] hover:bg-[#ffe4e6] transition-colors">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                            <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4A5.8 5.8 0 0 1 16.2 22H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.95 1.6a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3ZM12 7.2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Zm0 2A2.8 2.8 0 1 0 12 14.8 2.8 2.8 0 0 0 12 9.2Z" />
                        </svg>
                    </a>
                    <a href="@(_siteContent?.Footer.FacebookUrl ?? "https://www.facebook.com")" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
                       class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#eff6ff] text-[#1877f2] hover:bg-[#dbeafe] transition-colors">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                            <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.25-1.5 1.55-1.5h1.65V5A22 22 0 0 0 14.3 4.9c-2.4 0-4 1.45-4 4.1V11H7.6v3h2.7v8h3.2Z" />
                        </svg>
                    </a>
                    <a href="@(_siteContent?.Footer.LinkedInUrl ?? "https://www.linkedin.com")" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                       class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#f0f9ff] text-[#0a66c2] hover:bg-[#dbeafe] transition-colors">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                            <path d="M6.5 8.8H3.3V21h3.2V8.8ZM4.9 3A1.85 1.85 0 1 0 5 6.7 1.85 1.85 0 0 0 4.9 3Zm16 10.9c0-3.25-1.75-5.35-4.5-5.35a3.8 3.8 0 0 0-3.3 1.8V8.8H10V21h3.2v-6.2c0-1.9 1-3.05 2.55-3.05 1.45 0 2.2 1 2.2 3.05V21H21v-7.1Z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="border-t border-gray-100 dark:border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2">
                <img src="_content/ComunaClick.SharedUI/logo.png" alt="ComunaClic" class="h-16 w-auto" />
            </div>
            <p class="text-sm text-gray-500">@(_siteContent?.Footer.CopyrightText ?? L.T("home.footer.copy"))</p>
        </div>
    </div>
</footer>

@code {
    private ComunaClick.Shared.Api.Buyer.PublicSiteContentResponse? _siteContent;

    protected override void OnInitialized()
    {
        L.OnChange += HandleChange;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _siteContent = await BuyerApi.GetSiteContentAsync();
        }
        catch
        {
            _siteContent = null;
        }
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleChange;
    }
}
