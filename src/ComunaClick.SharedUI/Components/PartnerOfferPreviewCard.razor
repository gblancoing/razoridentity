@inject ComunaClick.SharedUI.Services.LocaleService L
@inject ComunaClick.SharedUI.Services.ApiMediaUrl MediaUrl

<section class="rounded-3xl border border-[#dbe6e2] bg-[#f8faf9] p-5 space-y-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("partner.preview.title")</p>
            <p class="mt-1 text-sm text-[#61897c]">@L.T("partner.preview.subtitle")</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(PublicHref))
        {
            <PartnerPublicPreviewLink Href="@PublicHref" Label="@L.T("partner.preview.openPublic")" />
        }
    </div>

    <article class="overflow-hidden rounded-3xl border border-[#e3e0d8] bg-white shadow-[0_6px_32px_-18px_rgba(0,0,0,0.12)]">
        @if (!string.IsNullOrWhiteSpace(ResolvedImageUrl))
        {
            <div class="aspect-[16/10] bg-[#eff1f2]">
                <img src="@ResolvedImageUrl" alt="" class="h-full w-full object-cover" />
            </div>
        }
        else
        {
            <div class="aspect-[16/10] bg-gradient-to-br from-[#eff1f2] to-[#e8f5d6] flex items-center justify-center">
                <span class="material-symbols-outlined text-[48px] text-[#3b6700]/40">@(IsProduct ? "inventory_2" : "home_repair_service")</span>
            </div>
        }
        <div class="p-5 space-y-2">
            @if (!string.IsNullOrWhiteSpace(Category))
            {
                <span class="inline-flex rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#325800] ring-1 ring-[#dbe6e2]">
                    @Category
                </span>
            }
            <h3 class="text-lg font-black text-[#2c2f30]">@(string.IsNullOrWhiteSpace(Name) ? L.T("partner.preview.namePlaceholder") : Name)</h3>
            <p class="text-sm text-[#61897c] line-clamp-3">
                @(string.IsNullOrWhiteSpace(Description) ? L.T("partner.preview.descPlaceholder") : Description)
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
                <p class="text-xl font-black text-[#3b6700]">@PriceLabel</p>
                @if (!IsProduct && DurationMinutes > 0)
                {
                    <p class="text-xs font-semibold text-[#7b8081]">@DurationMinutes min</p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(CompanyName))
            {
                <p class="text-xs text-[#7b8081] pt-1">
                    <span class="material-symbols-outlined text-[14px] align-middle">storefront</span>
                    @string.Format(L.T("partner.preview.underCompany"), CompanyName)
                </p>
            }
        </div>
    </article>
</section>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Category { get; set; }
    [Parameter] public double Price { get; set; }
    [Parameter] public int DurationMinutes { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public bool IsProduct { get; set; }
    [Parameter] public string? CompanyName { get; set; }
    [Parameter] public string? PublicHref { get; set; }

    private string PriceLabel => Price > 0 ? $"${Price:N0}" : L.T("partner.preview.priceOnRequest");

    private string? ResolvedImageUrl
        => string.IsNullOrWhiteSpace(ImageUrl) ? null : MediaUrl.Resolve(ImageUrl);
}
