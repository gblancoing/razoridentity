@using PartnerBooking = ComunaClick.Shared.Api.Partner.Booking
@inject LocaleService L

<section class="space-y-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-[10px] uppercase tracking-[0.16em] font-bold text-[#7b8081]">@L.T("partner.agenda.kanban.badge")</p>
            <h2 class="text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.agenda.kanban.title")</h2>
            @if (SelectedDayLabel is not null)
            {
                <p class="mt-1 text-sm text-[#595c5d]">@SelectedDayLabel</p>
            }
        </div>
        <p class="text-xs font-semibold text-[#7b8081]">@TotalCount @L.T("partner.agenda.kanban.total")</p>
    </div>

    @if (IsLoading)
    {
        <BrandedLoading Title="@L.T("ui.loading")" Message="@L.T("partner.agenda.loading")" Compact="true" />
    }
    else if (TotalCount == 0)
    {
        <div class="rounded-3xl border border-dashed border-[#dadddf] bg-white px-6 py-12 text-center">
            <span class="material-symbols-outlined text-4xl text-[#c5c9cb]">event_busy</span>
            <p class="mt-3 text-sm text-[#595c5d]">@EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-start">
            @KanbanColumn(L.T("partner.agenda.kanban.pending"), "border-[#76BC21]/40 bg-[#f5fbf0]", PendingBookings, "text-[#325800]", "bg-[#76BC21]")
            @KanbanColumn(L.T("partner.agenda.kanban.completed"), "border-[#3b82f6]/35 bg-[#f0f6ff]", CompletedBookings, "text-[#1e4a8a]", "bg-[#3b82f6]")
            @KanbanColumn(L.T("partner.agenda.kanban.missed"), "border-[#ef4444]/35 bg-[#fff5f5]", MissedBookings, "text-[#8f2200]", "bg-[#ef4444]")
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<PartnerBooking> PendingBookings { get; set; } = Array.Empty<PartnerBooking>();
    [Parameter] public IReadOnlyList<PartnerBooking> CompletedBookings { get; set; } = Array.Empty<PartnerBooking>();
    [Parameter] public IReadOnlyList<PartnerBooking> MissedBookings { get; set; } = Array.Empty<PartnerBooking>();
    [Parameter] public IReadOnlyDictionary<Guid, string> ServiceNames { get; set; } = new Dictionary<Guid, string>();
    [Parameter] public string? SelectedDayLabel { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = string.Empty;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Guid? UpdatingBookingId { get; set; }
    [Parameter] public Guid? SelectedBookingId { get; set; }
    [Parameter] public EventCallback<PartnerBooking> OnSelectBooking { get; set; }

    private int TotalCount => PendingBookings.Count + CompletedBookings.Count + MissedBookings.Count;

    private RenderFragment KanbanColumn(string title, string columnClass, IReadOnlyList<PartnerBooking> items, string countTextClass, string countBgClass) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"rounded-2xl border-2 {columnClass} p-3 min-h-[200px] flex flex-col");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-center justify-between gap-2 mb-3 px-1");
        builder.OpenElement(seq++, "h3");
        builder.AddAttribute(seq++, "class", "text-sm font-black text-[#2c2f30]");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"inline-flex min-w-[1.5rem] items-center justify-center rounded-full {countBgClass} px-2 py-0.5 text-[10px] font-black text-white");
        builder.AddContent(seq++, items.Count);
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex flex-col gap-2 flex-1");
        if (items.Count == 0)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "text-xs text-[#7b8081] px-2 py-4 text-center");
            builder.AddContent(seq++, L.T("partner.agenda.kanban.empty"));
            builder.CloseElement();
        }
        else
        {
            foreach (var booking in items)
            {
                builder.AddContent(seq++, RenderBookingCard(booking));
            }
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderBookingCard(PartnerBooking booking) => builder =>
    {
        var seq = 0;
        var selected = SelectedBookingId == booking.Id;
        builder.OpenElement(seq++, "article");
        builder.AddAttribute(seq++, "class", $"rounded-xl border bg-white p-3 shadow-sm cursor-pointer transition-all {(selected ? "border-[#3b6700] ring-2 ring-[#3b6700]/25" : "border-[#e8eaec] hover:border-[#3b6700]/30")}");
        builder.AddAttribute(seq++, "role", "button");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnSelectBooking.InvokeAsync(booking)));

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-start justify-between gap-2");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "min-w-0");
        builder.OpenElement(seq++, "p");
        builder.AddAttribute(seq++, "class", "text-sm font-bold text-[#2c2f30] truncate");
        builder.AddContent(seq++, GetServiceName(booking.ServiceId));
        builder.CloseElement();
        builder.OpenElement(seq++, "p");
        builder.AddAttribute(seq++, "class", "mt-0.5 text-xs text-[#595c5d]");
        builder.AddContent(seq++, booking.StartAt.ToLocalTime().ToString("HH:mm") + " – " + booking.EndAt.ToLocalTime().ToString("HH:mm"));
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "shrink-0 text-xs font-bold text-[#3b6700]");
        builder.AddContent(seq++, FormatMoney(booking.Amount, booking.Currency));
        builder.CloseElement();
        builder.CloseElement();

        if (UpdatingBookingId == booking.Id)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "mt-2 text-[10px] font-bold text-[#7b8081]");
            builder.AddContent(seq++, L.T("partner.agenda.updating"));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private string GetServiceName(Guid serviceId)
        => ServiceNames.TryGetValue(serviceId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : L.T("partner.agenda.service.unknown");

    private static string FormatMoney(double amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? $"${amount:N0}" : $"{currency} {amount:N0}";
}
