@using System.Net
@inject ComunaClick.Shared.Api.Partner.PartnerApiClient PartnerApi
@inject AuthStateService AuthState
@inject LocaleService L
<section id="organizacion" class="scroll-mt-8 rounded-[2rem] border border-[#e3e6e8] bg-white p-6 md:p-8 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.04)] space-y-6">
    <div>
        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#7b8081]">@L.T("partner.settings.org.badge")</p>
        <h2 class="mt-2 text-2xl font-black tracking-[-0.03em] text-[#2c2f30]">@L.T("partner.settings.org.title")</h2>
        <p class="mt-2 text-sm text-[#595c5d]">@L.T("partner.settings.org.subtitle")</p>
    </div>

    @if (_partner is null && !_isLoading)
    {
        <p class="text-sm text-[#595c5d]">@L.T("partner.settings.org.missing")</p>
    }
    else if (_isLoading)
    {
        <BrandedLoading Compact="true" Title="@L.T("ui.loading")" Message="@L.T("partner.settings.org.loading")" />
    }
    else
    {
        <div class="rounded-2xl border border-[#e8e6e1] bg-[#fafaf8] p-5">
            <label class="text-xs font-bold uppercase tracking-[0.16em] text-[#7b8081]">@L.T("partner.storefront.section.logo")</label>
            <p class="mt-1 text-sm text-[#595c5d]">@L.T("partner.storefront.section.logo.help")</p>
            @if (AuthState.PartnerId is Guid partnerId)
            {
                <div class="mt-4">
                    <StorefrontLogoUpload PartnerId="@partnerId"
                                          PartnerName="@_partner?.Name"
                                          LogoUrl="@_logoUrl"
                                          LogoUrlChanged="OnLogoChanged" />
                </div>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-xs font-bold text-[#2c2f30]">@L.T("partner.dashboard.profile.field.name")</label>
                <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm" @bind="_editor.Name" />
            </div>
            <div>
                <label class="text-xs font-bold text-[#2c2f30]">@L.T("partner.dashboard.profile.field.address")</label>
                <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm" @bind="_editor.Address" />
            </div>
            <div>
                <label class="text-xs font-bold text-[#2c2f30]">@L.T("partner.dashboard.profile.field.phone")</label>
                <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm" @bind="_editor.Phone" />
            </div>
            <div>
                <label class="text-xs font-bold text-[#2c2f30]">@L.T("partner.dashboard.profile.field.email")</label>
                <input class="mt-2 w-full h-11 rounded-2xl border border-[#dadddf] px-3 text-sm" @bind="_editor.Email" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_partner?.CategoryName) || !string.IsNullOrWhiteSpace(_partner?.SubcategoryName))
            {
                <div class="md:col-span-2 rounded-2xl bg-[#f5f6f7] px-4 py-3 text-sm text-[#595c5d]">
                    <span class="font-bold text-[#2c2f30]">@L.T("partner.settings.org.category"):</span>
                    @(_partner?.SubcategoryName ?? _partner?.CategoryName)
                </div>
            }
        </div>

        <div class="rounded-2xl border border-[#e8e6e1] bg-[#fafaf8] p-5">
            <ProfileWebLinksEditor Model="@_linksEditor" />
        </div>

        <div class="flex flex-wrap gap-3">
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-2xl bg-[#3b6700] text-[#d9ffad] px-5 py-3 font-bold text-sm disabled:opacity-60"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                <span class="material-symbols-outlined text-[18px]">save</span>
                @(_saving ? L.T("partner.dashboard.profile.saving") : L.T("partner.dashboard.profile.save"))
            </button>
            <a href="/partner/storefront" class="inline-flex items-center gap-2 rounded-2xl border border-[#dadddf] bg-white px-5 py-3 text-sm font-bold text-[#3b6700]">
                <span class="material-symbols-outlined text-[18px]">storefront</span>
                @L.T("partner.nav.storefront")
            </a>
        </div>
        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <p class="text-sm font-semibold @(_statusOk ? "text-[#3b6700]" : "text-red-600")">@_status</p>
        }
    }
</section>

@code {
    private ComunaClick.Shared.Api.Partner.PartnerDto? _partner;
    private string? _logoUrl;
    private readonly ProfileEditor _editor = new();
    private readonly ProfileWebLinksEditorModel _linksEditor = new();
    private bool _isLoading = true;
    private bool _saving;
    private string? _status;
    private bool _statusOk;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            await AuthState.InitializeAsync();
            if (AuthState.PartnerId is Guid id && id != Guid.Empty)
            {
                _partner = await PartnerApi.GetPartnerAsync(id);
                var storefront = await PartnerApi.GetPartnerStorefrontAsync(id);
                _logoUrl = storefront?.LogoUrl;
                if (_partner is not null)
                {
                    _editor.Name = _partner.Name ?? string.Empty;
                    _editor.Address = _partner.Address ?? string.Empty;
                    _editor.Phone = _partner.Phone ?? string.Empty;
                    _editor.Email = _partner.Email ?? string.Empty;
                    ProfileWebLinksHelper.Apply(_linksEditor, ProfileWebLinksHelper.FromPartner(_partner));
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnLogoChanged(string? url)
    {
        _logoUrl = url;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_partner is null)
        {
            return;
        }

        var name = (_editor.Name ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _status = L.T("partner.dashboard.status.nameRequired");
            _statusOk = false;
            return;
        }

        _saving = true;
        try
        {
            var updated = await PartnerApi.UpdatePartnerAsync(_partner.Id, new ComunaClick.Shared.Api.Partner.PartnerUpdateRequest(
                _partner.Type,
                name,
                _partner.Rut,
                Null(_editor.Address),
                Null(_editor.Phone),
                Null(_editor.Email),
                _partner.SubcategoryId,
                _partner.Latitude,
                _partner.Longitude,
                _partner.IsVisible,
                null));
            if (updated is not null)
            {
                _partner = updated;
                var linksUpdated = await PartnerApi.UpdatePartnerWebLinksAsync(
                    _partner.Id,
                    ProfileWebLinksHelper.ToUpdateRequest(_linksEditor));
                if (linksUpdated is not null)
                {
                    _partner = linksUpdated;
                }

                _status = L.T("partner.dashboard.status.businessSaved");
                _statusOk = true;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            _status = L.T("partner.dashboard.status.businessConflict");
            _statusOk = false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _status = L.T("partner.settings.links.saveFailed");
            _statusOk = false;
        }
        catch (HttpRequestException)
        {
            _status = L.T("partner.settings.org.saveFailed");
            _statusOk = false;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Null(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private sealed class ProfileEditor
    {
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
    }
}
