@using System.Text.Json
@inject ComunaClick.Shared.Api.Buyer.BuyerApiClient BuyerApi
@inject ComunaClick.SharedUI.Services.LocaleService L
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (_visible)
{
    <div class="mb-6 rounded-2xl border border-[#009ee3]/30 bg-[#e8f7ff] px-4 py-4 sm:px-5">
        <p class="text-[10px] uppercase tracking-[0.18em] font-bold text-[#0066a1]">@L.T("buyer.pendingMp.eyebrow")</p>
        <p class="mt-1 text-sm font-semibold text-[#2c2f30]">
            @(_payments.Count > 1 ? string.Format(L.T("buyer.pendingMp.multiTitle"), _payments.Count) : L.T("buyer.pendingMp.title"))
        </p>
        <p class="mt-1 text-sm text-[#595c5d]">@L.T("buyer.pendingMp.body")</p>
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var payment in _payments.Where(p => !string.IsNullOrWhiteSpace(p.CheckoutUrl)))
            {
                <a href="@payment.CheckoutUrl" target="_blank" rel="noopener" class="inline-flex items-center rounded-xl bg-[#009ee3] px-4 py-2 text-sm font-bold text-white">
                    @L.T("buyer.checkout.mp.pay")@(_payments.Count > 1 && !string.IsNullOrWhiteSpace(payment.PartnerName) ? $" · {payment.PartnerName}" : string.Empty)
                </a>
            }
            <button type="button" class="inline-flex items-center rounded-xl border border-[#009ee3] px-4 py-2 text-sm font-bold text-[#0066a1] disabled:opacity-60"
                    disabled="@_busy"
                    @onclick="() => RefreshCheckoutsAsync(silent: false)">
                @L.T("buyer.pendingMp.refresh")
            </button>
            <button type="button" class="inline-flex items-center rounded-xl px-4 py-2 text-sm font-bold text-[#595c5d]"
                    @onclick="DismissAsync">
                @L.T("buyer.pendingMp.dismiss")
            </button>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _busy;
    private readonly List<PendingPayment> _payments = new();

    private sealed class PendingPayment
    {
        public Guid? OrderId { get; set; }
        public Guid? BookingId { get; set; }
        public Guid? CustomerId { get; set; }
        public string? CheckoutUrl { get; set; }
        public string? PartnerName { get; set; }
        public DateTimeOffset CreatedAt { get; set; } = DateTimeOffset.UtcNow;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadPendingAsync();
        StateHasChanged();
    }

    private async Task LoadPendingAsync()
    {
        try
        {
            var raw = await JSRuntime.InvokeAsync<string>("comunaclic.getPendingMpPayment");
            if (string.IsNullOrWhiteSpace(raw))
            {
                return;
            }

            var parsed = ParsePayments(raw);
            var cutoff = DateTimeOffset.UtcNow.AddHours(-48);
            var expired = parsed.Count(p => p.CreatedAt < cutoff);
            _payments.Clear();
            _payments.AddRange(parsed.Where(p => p.CreatedAt >= cutoff));

            if (expired > 0)
            {
                await SavePendingAsync();
            }

            if (_payments.Count == 0)
            {
                return;
            }

            if (_payments.Any(p => string.IsNullOrWhiteSpace(p.CheckoutUrl)))
            {
                await RefreshCheckoutsAsync(silent: true);
            }

            _visible = _payments.Count > 0;
        }
        catch
        {
            // ignore
        }
    }

    /// <summary>Soporta el shape v1 (objeto único en la raíz) y v2 (lista en "payments").</summary>
    private static List<PendingPayment> ParsePayments(string raw)
    {
        var payments = new List<PendingPayment>();
        try
        {
            using var doc = JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.ValueKind != JsonValueKind.Object)
            {
                return payments;
            }

            if (root.TryGetProperty("payments", out var list) && list.ValueKind == JsonValueKind.Array)
            {
                foreach (var element in list.EnumerateArray())
                {
                    if (TryParsePayment(element, out var payment))
                    {
                        payments.Add(payment);
                    }
                }
            }
            else if (TryParsePayment(root, out var single))
            {
                payments.Add(single);
            }
        }
        catch (JsonException)
        {
            // entrada corrupta: se trata como sin pagos pendientes
        }

        return payments;
    }

    private static bool TryParsePayment(JsonElement element, out PendingPayment payment)
    {
        payment = new PendingPayment
        {
            OrderId = ReadGuid(element, "orderId"),
            BookingId = ReadGuid(element, "bookingId"),
            CustomerId = ReadGuid(element, "customerId"),
            CheckoutUrl = element.TryGetProperty("checkoutUrl", out var url) ? url.GetString() : null,
            PartnerName = element.TryGetProperty("partnerName", out var pn) ? pn.GetString() : null
        };

        if (element.TryGetProperty("createdAt", out var createdProp) && createdProp.TryGetDateTimeOffset(out var created))
        {
            payment.CreatedAt = created;
        }

        return payment.CustomerId is not null && (payment.OrderId is not null || payment.BookingId is not null);
    }

    private async Task RefreshCheckoutsAsync(bool silent = false)
    {
        _busy = true;
        try
        {
            foreach (var payment in _payments.Where(p => p.CustomerId is not null))
            {
                if (!silent || string.IsNullOrWhiteSpace(payment.CheckoutUrl))
                {
                    try
                    {
                        var response = await BuyerApi.ResumeMercadoPagoCheckoutAsync(
                            new PublicMercadoPagoCheckoutRequest(payment.CustomerId!.Value, payment.OrderId, payment.BookingId));
                        if (!string.IsNullOrWhiteSpace(response?.CheckoutUrl))
                        {
                            payment.CheckoutUrl = response.CheckoutUrl;
                            if (!silent)
                            {
                                await BuyerApi.SendPaymentReminderAsync(
                                    new PublicPaymentReminderRequest(payment.CustomerId.Value, payment.OrderId, payment.BookingId));
                            }
                        }
                    }
                    catch (HttpRequestException)
                    {
                        // El resto de los pagos pendientes se intenta igual.
                    }
                }
            }

            await SavePendingAsync();
        }
        finally
        {
            _busy = false;
            _visible = _payments.Count > 0;
        }
    }

    private async Task SavePendingAsync()
    {
        if (_payments.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", null);
            return;
        }

        var payload = JsonSerializer.Serialize(new
        {
            version = 2,
            payments = _payments.Select(p => new Dictionary<string, string?>
            {
                ["orderId"] = p.OrderId?.ToString(),
                ["bookingId"] = p.BookingId?.ToString(),
                ["customerId"] = p.CustomerId?.ToString(),
                ["checkoutUrl"] = p.CheckoutUrl,
                ["createdAt"] = p.CreatedAt.ToString("O"),
                ["partnerName"] = p.PartnerName
            })
        });
        await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", payload);
    }

    private async Task DismissAsync()
    {
        await JSRuntime.InvokeVoidAsync("comunaclic.setPendingMpPayment", null);
        _payments.Clear();
        _visible = false;
    }

    private static Guid? ReadGuid(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var prop) || prop.ValueKind != JsonValueKind.String)
        {
            return null;
        }

        return Guid.TryParse(prop.GetString(), out var id) && id != Guid.Empty ? id : null;
    }

    public void Dispose()
    {
    }
}
