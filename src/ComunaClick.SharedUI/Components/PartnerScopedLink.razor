@inject ComunaClick.SharedUI.Services.AuthStateService AuthState
@inject ComunaClick.Shared.Auth.Interfaces.IAuthClient AuthClient
@inject NavigationManager Navigation

<a href="@Href"
   class="@CssClass"
   @onclick="NavigateAsync"
   @onclick:preventDefault="true"
   @onclick:stopPropagation="true">
    @ChildContent
</a>

@code {
    [Parameter, EditorRequired] public Guid PartnerId { get; set; }
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public string Href { get; set; } = "/partner";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task NavigateAsync()
    {
        if (Disabled || PartnerId == Guid.Empty)
        {
            return;
        }

        await TrySetPartnerSessionAsync();
        Navigation.NavigateTo(Href, forceLoad: true);
    }

    private async Task TrySetPartnerSessionAsync()
    {
        if (AuthState.PartnerId == PartnerId)
        {
            return;
        }

        if (AuthState.Tokens is null)
        {
            return;
        }

        try
        {
            // Re-scopea a este partner vía cookie (web) / refresh token (mobile). Si falla, igual
            // navegamos: el panel puede pedir re-login.
            await AuthState.SwitchScopeAsync(TenantId, PartnerId);
        }
        catch
        {
            // Silencioso: la navegación continúa.
        }
    }
}
