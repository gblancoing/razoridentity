@using ComunaClick.Common.Contact
@using ComunaClick.Shared.Api.Buyer
@inject LocaleService L
@inject BuyerApiClient BuyerApi
@inject PartnerApiClient PartnerApi
@inject AuthStateService AuthState
@inject ApiSessionService ApiSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-[#dadddf] bg-white shadow-[0_12px_40px_-24px_rgba(0,0,0,0.25)]">
    <header class="flex shrink-0 items-center justify-between gap-4 border-b border-[#e3e6e8] bg-[#fafbfc] px-4 py-3 sm:px-6">
        <div>
            <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#7b8081]">@L.T("inbox.badge")</p>
            <h1 class="text-lg font-black tracking-[-0.03em] text-[#2c2f30] sm:text-xl">@L.T("inbox.title")</h1>
            @if (!IsCustomerMode)
            {
                <p class="mt-1 max-w-xl text-sm text-[#595c5d]">@L.T("inbox.partnerSubtitle")</p>
            }
        </div>
        @if (IsCustomerMode && !_composeOpen)
        {
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-xl bg-[#3b6700] px-4 py-2 text-sm font-bold text-[#d9ffad]"
                    @onclick="OpenComposePanel">
                <span class="material-symbols-outlined text-[18px]">edit_square</span>
                @L.T("inbox.newMessage")
            </button>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div class="shrink-0 border-b border-[#e3e6e8] bg-[#fff8e6] px-4 py-2 text-sm text-[#5c4a00] sm:px-6">@_bannerMessage</div>
    }

    <div class="flex min-h-0 flex-1 flex-col overflow-hidden lg:flex-row">
        <aside class="flex w-full shrink-0 flex-row gap-2 border-b border-[#e3e6e8] bg-[#f5f6f7] p-2 lg:w-52 lg:flex-col lg:gap-0 lg:border-b-0 lg:border-r lg:p-3">
            <div class="min-w-0 flex-1 lg:flex-none">
                <p class="hidden px-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7b8081] lg:block">@L.T("inbox.folders")</p>
                <nav class="flex gap-1 lg:mt-2 lg:block lg:space-y-1">
                    <button type="button" class="@FolderClass("inbox")" @onclick='() => SelectFolderAsync("inbox")'>
                        <span class="material-symbols-outlined text-[18px]">inbox</span>
                        @L.T("inbox.folder.inbox")
                        @if (_folder == "inbox" && UnreadCount > 0)
                        {
                            <span class="ml-auto rounded-full bg-[#3b6700] px-2 py-0.5 text-[10px] font-bold text-white">@UnreadCount</span>
                        }
                    </button>
                    <button type="button" class="@FolderClass("archived")" @onclick='() => SelectFolderAsync("archived")'>
                        <span class="material-symbols-outlined text-[18px]">archive</span>
                        @L.T("inbox.folder.archived")
                    </button>
                </nav>
            </div>
        </aside>

        <section class="@($"{ListPaneClass} min-h-0 min-w-0 flex-1 flex-col border-[#e3e6e8] lg:w-80 lg:shrink-0 lg:border-r")">
            <div class="shrink-0 border-b border-[#e3e6e8] px-3 py-2 sm:px-4 sm:py-3">
                <input type="search"
                       class="w-full rounded-xl border border-[#dadddf] bg-white px-3 py-2.5 text-base outline-none focus:border-[#3b6700] sm:text-sm"
                       placeholder="@L.T("inbox.searchPlaceholder")"
                       @bind="_search"
                       @bind:event="oninput" />
            </div>
            <div class="min-h-0 flex-1 overflow-y-auto overscroll-y-contain [-webkit-overflow-scrolling:touch]">
                @if (_loadingList)
                {
                    <div class="p-6">
                        <BrandedLoading Title="@L.T("ui.loading")" Message="@L.T("inbox.loadingThreads")" Compact="true" />
                    </div>
                }
                else if (!FilteredThreads.Any())
                {
                    <div class="p-8 text-center text-sm text-[#595c5d]">
                        @(IsCustomerMode ? L.T("inbox.emptyList") : L.T("inbox.emptyList.partner"))
                    </div>
                }
                else
                {
                    @foreach (var thread in FilteredThreads)
                    {
                        <button type="button"
                                class="@ThreadRowClass(thread)"
                                @onclick="() => SelectThreadAsync(thread.Id)">
                            <div class="flex items-start justify-between gap-2">
                                <p class="@(thread.Unread ? "font-black" : "font-semibold") text-sm text-[#2c2f30] truncate">
                                    @(thread.CounterpartyName ?? L.T("inbox.unknownCounterparty"))
                                </p>
                                <span class="shrink-0 text-[10px] font-semibold text-[#7b8081]">@FormatListDate(thread.LastMessageAt)</span>
                            </div>
                            <p class="mt-1 text-xs font-semibold text-[#3b6700] truncate">@(thread.Subject ?? L.T("inbox.noSubject"))</p>
                            @if (!string.IsNullOrWhiteSpace(thread.Preview))
                            {
                                <p class="mt-1 text-xs text-[#595c5d] line-clamp-2">@thread.Preview</p>
                            }
                        </button>
                    }
                }
            </div>
        </section>

        <section class="@($"{DetailPaneClass} min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-[#fafbfc]")">
            @if (_composeOpen)
            {
                <div class="flex min-h-0 flex-1 flex-col overflow-hidden">
                    <div class="min-h-0 flex-1 overflow-y-auto overscroll-y-contain [-webkit-overflow-scrolling:touch] p-3 sm:p-6">
                        <button type="button"
                                class="mb-3 inline-flex items-center gap-1.5 text-sm font-bold text-[#3b6700] lg:hidden"
                                @onclick="BackToMobileList">
                            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                            @L.T("inbox.backToList")
                        </button>
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <h2 class="text-lg font-black text-[#2c2f30]">@L.T("inbox.composeTitle")</h2>
                                <p class="mt-1 text-sm text-[#595c5d]">@L.T("inbox.composeSubtitle")</p>
                                @if (!string.IsNullOrWhiteSpace(_composeCounterpartyName))
                                {
                                    <p class="mt-2 text-sm font-semibold text-[#2c2f30]">
                                        @L.T("inbox.compose.toLabel"): @_composeCounterpartyName
                                    </p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_composeWhatsAppUrl))
                            {
                                <a href="@_composeWhatsAppUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="inline-flex items-center gap-1.5 rounded-lg bg-[#25D366] px-3 py-2 text-xs font-bold text-white hover:bg-[#1ebe57]">
                                    <span class="material-symbols-outlined text-[16px]">chat</span>
                                    @L.T("inbox.whatsapp.continue")
                                </a>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_composeWhatsAppUrl))
                        {
                            <p class="mt-2 text-xs text-[#7b8081]">@L.T("inbox.whatsapp.hint.ready")</p>
                        }
                        <div class="mt-4 space-y-3">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">@L.T("inbox.field.subject")</label>
                                <input class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2.5 text-base sm:text-sm" @bind="_composeSubject" />
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">@L.T("inbox.field.message")</label>
                                <textarea class="mt-1 w-full rounded-xl border border-[#dadddf] px-3 py-2.5 text-base sm:text-sm" rows="6" @bind="_composeBody"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="shrink-0 border-t border-[#e3e6e8] bg-white p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:p-4 sm:pb-6">
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="min-h-11 rounded-xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad] disabled:opacity-60" disabled="@_sending" @onclick="SendComposeAsync">
                                @L.T("inbox.send")
                            </button>
                            <button type="button" class="min-h-11 rounded-xl border border-[#dadddf] px-5 py-2.5 text-sm font-bold text-[#2c2f30]" @onclick="CloseCompose">
                                @L.T("inbox.cancel")
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (_loadingDetail)
            {
                <div class="flex flex-1 items-center justify-center p-8">
                    <BrandedLoading Title="@L.T("ui.loading")" Message="@L.T("inbox.loadingThread")" Compact="true" />
                </div>
            }
            else if (_selectedThread is null)
            {
                <div class="flex flex-1 flex-col items-center justify-center p-8 text-center text-[#595c5d]">
                    <span class="material-symbols-outlined text-5xl text-[#c5c9cb]">mail</span>
                    <p class="mt-4 text-sm font-semibold">@L.T("inbox.selectThread")</p>
                </div>
            }
            else
            {
                <div class="flex min-h-0 flex-1 flex-col overflow-hidden">
                <div class="shrink-0 border-b border-[#e3e6e8] bg-white px-3 py-3 sm:px-6 sm:py-4">
                    <button type="button"
                            class="mb-2 inline-flex items-center gap-1.5 text-sm font-bold text-[#3b6700] lg:hidden"
                            @onclick="BackToMobileList">
                        <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                        @L.T("inbox.backToList")
                    </button>
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h2 class="text-lg font-black tracking-[-0.03em] text-[#2c2f30] truncate sm:text-xl">
                                @(_selectedThread.Subject ?? L.T("inbox.noSubject"))
                            </h2>
                            <p class="mt-1 text-sm text-[#595c5d]">
                                @if (IsCustomerMode)
                                {
                                    <span>@(_selectedThread.CounterpartyName ?? "")</span>
                                    @if (!string.IsNullOrWhiteSpace(_selectedThread.CounterpartySubtitle))
                                    {
                                        <span> · @_selectedThread.CounterpartySubtitle</span>
                                    }
                                }
                                else
                                {
                                    <span>@(_selectedThread.CustomerName ?? L.T("inbox.customer"))</span>
                                }
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            @{
                                var whatsAppUrl = BuildWhatsAppHandoffUrl();
                                var canWhatsApp = !string.IsNullOrWhiteSpace(whatsAppUrl);
                            }
                            @if (canWhatsApp)
                            {
                                <a href="@whatsAppUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="inline-flex items-center gap-1.5 rounded-lg bg-[#25D366] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#1ebe57]">
                                    <span class="material-symbols-outlined text-[16px]">chat</span>
                                    @L.T("inbox.whatsapp.continue")
                                </a>
                            }
                            @if (_selectedThread.Status != "archived")
                            {
                                <button type="button" class="rounded-lg border border-[#dadddf] px-3 py-1.5 text-xs font-bold text-[#595c5d]" @onclick='() => UpdateStatusAsync("archived")'>
                                    @L.T("inbox.archive")
                                </button>
                            }
                            else
                            {
                                <button type="button" class="rounded-lg border border-[#dadddf] px-3 py-1.5 text-xs font-bold text-[#595c5d]" @onclick='() => UpdateStatusAsync("open")'>
                                    @L.T("inbox.restore")
                                </button>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(GetWhatsAppHint()))
                    {
                        <p class="mt-3 text-xs text-[#7b8081]">@GetWhatsAppHint()</p>
                    }
                </div>

                <div class="min-h-0 flex-1 overflow-y-auto overscroll-y-contain [-webkit-overflow-scrolling:touch] px-3 py-3 sm:px-6 sm:py-4">
                    @if (_messages.Count == 0)
                    {
                        <p class="text-sm text-[#595c5d]">@L.T("inbox.noMessages")</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var msg in _messages)
                            {
                                var isMine = IsMyMessage(msg.SenderRole);
                                <article class="@MessageBubbleClass(isMine)">
                                    <div class="flex items-center justify-between gap-2 mb-1">
                                        <span class="text-[10px] font-bold uppercase tracking-wide @(isMine ? "text-[#d9ffad]/90" : "text-[#7b8081]")">
                                            @(isMine ? L.T("inbox.you") : SenderLabel(msg.SenderRole))
                                        </span>
                                        <time class="text-[10px] @(isMine ? "text-[#d9ffad]/80" : "text-[#7b8081]")">@FormatDetailDate(msg.CreatedAt)</time>
                                    </div>
                                    <p class="text-sm whitespace-pre-wrap leading-relaxed">@msg.Body</p>
                                </article>
                            }
                        </div>
                    }
                </div>

                @if (_selectedThread.Status != "archived")
                {
                    <div class="shrink-0 border-t border-[#e3e6e8] bg-white p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:p-6 sm:pb-6">
                        <label class="text-xs font-bold uppercase tracking-wide text-[#7b8081]">@L.T("inbox.replyLabel")</label>
                        <textarea class="mt-2 w-full rounded-xl border border-[#dadddf] px-3 py-2.5 text-base sm:text-sm"
                                  rows="3"
                                  @bind="_replyBody"
                                  @bind:event="oninput"></textarea>
                        <button type="button"
                                class="mt-3 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-[#3b6700] px-5 py-2.5 text-sm font-bold text-[#d9ffad] disabled:opacity-60 sm:w-auto"
                                disabled="@(_sending || string.IsNullOrWhiteSpace(_replyBody))"
                                @onclick="SendReplyAsync">
                            <span class="material-symbols-outlined text-[18px]">send</span>
                            @L.T("inbox.sendReply")
                        </button>
                    </div>
                }
                </div>
            }
        </section>
    </div>
</div>

@code {
    [Parameter] public string Mode { get; set; } = "customer";

    private bool IsCustomerMode => string.Equals(Mode, "customer", StringComparison.OrdinalIgnoreCase);

    /// <summary>On small screens: true = thread list, false = conversation or compose.</summary>
    private bool _mobileListMode = true;

    private string ListPaneClass => _mobileListMode ? "flex" : "hidden lg:flex";

    private string DetailPaneClass => _mobileListMode ? "hidden lg:flex" : "flex";

    private string _folder = "inbox";
    private string _search = string.Empty;
    private bool _loadingList = true;
    private bool _loadingDetail;
    private bool _sending;
    private bool _composeOpen;
    private string? _bannerMessage;
    private Guid? _partnerId;
    private string? _partnerPhone;
    private Guid? _composePartnerId;
    private Guid? _composeProfessionalId;
    private Guid? _composeProductId;
    private Guid? _composeServiceId;
    private string? _composeCounterpartyName;
    private string? _composeCounterpartyPhone;
    private string? _composeWhatsAppUrl;
    private string _composeSubject = string.Empty;
    private string _composeBody = string.Empty;
    private string _replyBody = string.Empty;
    private List<InboxThreadListItem> _threads = new();
    private InboxThreadDetail? _selectedThread;
    private List<InboxMessageItem> _messages = new();
    private Guid? _selectedThreadId;
    private bool _initialized;
    private bool _disposed;
    private string? _lastAppliedQuery;

    private int UnreadCount => _threads.Count(x => x.Unread);

    private IEnumerable<InboxThreadListItem> FilteredThreads
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
            {
                return _threads;
            }

            var q = _search.Trim();
            return _threads.Where(x =>
                (x.CounterpartyName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Subject?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Preview?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override void OnInitialized()
    {
        L.OnChange += HandleLocaleChange;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureInitializedAsync();
    }

    private async Task EnsureInitializedAsync()
    {
        if (_initialized)
        {
            return;
        }

        try
        {
            await AuthState.InitializeAsync();
            if (!IsCustomerMode)
            {
                if (!await ApiSession.EnsureReadyAsync())
                {
                    _bannerMessage = L.T("inbox.sessionRequired");
                    _loadingList = false;
                    return;
                }

                _partnerId = AuthState.PartnerId;
                if (!_partnerId.HasValue || _partnerId == Guid.Empty)
                {
                    _bannerMessage = L.T("inbox.partnerRequired");
                    _loadingList = false;
                    return;
                }

                var partner = await PartnerApi.GetPartnerAsync(_partnerId.Value);
                _partnerPhone = partner?.Phone;
            }

            await ApplyDeepLinkFromQueryAsync();
            _initialized = true;
        }
        catch (InvalidOperationException)
        {
            _loadingList = false;
            _loadingDetail = false;
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
            _loadingList = false;
            _loadingDetail = false;
            _initialized = true;
        }
    }

    private void ParseQueryCompose()
    {
        _selectedThreadId = null;
        _composePartnerId = null;
        _composeProfessionalId = null;
        _composeProductId = null;
        _composeServiceId = null;
        _composeSubject = string.Empty;
        _composeBody = string.Empty;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(q))
        {
            _composeSubject = L.T("inbox.defaultSubject");
            _composeBody = L.T("inbox.defaultBody");
            return;
        }

        foreach (var pair in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0]);
            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
            switch (key.ToLowerInvariant())
            {
                case "threadid" when Guid.TryParse(value, out var tid):
                    _selectedThreadId = tid;
                    break;
                case "partnerid" when Guid.TryParse(value, out var pid):
                    _composePartnerId = pid;
                    break;
                case "professionalid" when Guid.TryParse(value, out var profId):
                    _composeProfessionalId = profId;
                    break;
                case "productid" when Guid.TryParse(value, out var productId):
                    _composeProductId = productId;
                    break;
                case "serviceid" when Guid.TryParse(value, out var serviceId):
                    _composeServiceId = serviceId;
                    break;
                case "subject":
                    _composeSubject = value;
                    break;
                case "body":
                    _composeBody = value;
                    break;
            }
        }

        if (string.IsNullOrWhiteSpace(_composeSubject))
        {
            _composeSubject = L.T("inbox.defaultSubject");
        }

        if (string.IsNullOrWhiteSpace(_composeBody))
        {
            _composeBody = L.T("inbox.defaultBody");
        }
    }

    private async Task ApplyDeepLinkFromQueryAsync()
    {
        if (_disposed)
        {
            return;
        }

        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (string.Equals(_lastAppliedQuery, query, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedQuery = query;
        ParseQueryCompose();
        _composeOpen = false;
        _selectedThread = null;
        _messages.Clear();
        _composeWhatsAppUrl = null;

        try
        {
            _bannerMessage = null;

            if (_selectedThreadId is Guid threadId)
            {
                await LoadThreadsAsync();
                if (!_disposed)
                {
                    await SelectThreadAsync(threadId);
                }

                return;
            }

            if (IsCustomerMode && (_composePartnerId.HasValue || _composeProfessionalId.HasValue))
            {
                await LoadComposeCounterpartyAsync();
                await EnrichComposeBodyFromOfferAsync();
                RefreshComposeWhatsAppUrl();
                await LoadThreadsAsync();

                if (_disposed)
                {
                    return;
                }

                var existing = _threads.FirstOrDefault(MatchesComposeRecipient);
                if (existing is not null)
                {
                    await SelectThreadAsync(existing.Id);
                    return;
                }

                _composeOpen = true;
                _mobileListMode = false;
                return;
            }

            await LoadThreadsAsync();
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
            _loadingList = false;
            _loadingDetail = false;
        }
    }

    private bool MatchesComposeRecipient(InboxThreadListItem thread)
    {
        if (_composePartnerId is Guid partnerId && thread.PartnerId == partnerId)
        {
            return true;
        }

        if (_composeProfessionalId is Guid professionalId && thread.ProfessionalId == professionalId)
        {
            return true;
        }

        return false;
    }

    private async Task LoadComposeCounterpartyAsync()
    {
        _composeCounterpartyName = null;
        _composeCounterpartyPhone = null;

        try
        {
            if (_composePartnerId is Guid partnerId)
            {
                var profile = await BuyerApi.GetPartnerProfileAsync(partnerId);
                if (profile?.Partner is not null)
                {
                    _composeCounterpartyName = profile.Partner.Name;
                    _composeCounterpartyPhone = profile.Partner.Phone;
                }

                return;
            }

            if (_composeProfessionalId is Guid professionalId)
            {
                var professional = await BuyerApi.GetProfessionalAsync(professionalId);
                if (professional is not null)
                {
                    _composeCounterpartyName = professional.Name;
                    _composeCounterpartyPhone = professional.Phone;
                }
            }
        }
        catch
        {
            // Optional enrichment for compose/WhatsApp; inbox still loads without it.
        }
    }

    private async Task EnrichComposeBodyFromOfferAsync()
    {
        if (_composeBody != L.T("inbox.defaultBody"))
        {
            return;
        }

        try
        {
            if (_composeProductId is Guid productId)
            {
                var product = await BuyerApi.GetProductAsync(productId);
                if (!string.IsNullOrWhiteSpace(product?.Name))
                {
                    _composeBody = string.Format(L.T("inbox.compose.productContext"), product.Name);
                }

                return;
            }

            if (_composeServiceId is Guid serviceId)
            {
                var service = await BuyerApi.GetServiceAsync(serviceId);
                if (!string.IsNullOrWhiteSpace(service?.Name))
                {
                    _composeBody = string.Format(L.T("inbox.compose.serviceContext"), service.Name);
                }
            }
        }
        catch
        {
        }
    }

    private void RefreshComposeWhatsAppUrl()
    {
        if (!WhatsAppLinks.IsValidMobile(_composeCounterpartyPhone))
        {
            _composeWhatsAppUrl = null;
            return;
        }

        var message = WhatsAppLinks.BuildThreadHandoffMessage(
            _composeSubject,
            _composeCounterpartyName,
            string.IsNullOrWhiteSpace(_composeBody) ? null : new[] { _composeBody });

        _composeWhatsAppUrl = WhatsAppLinks.TryBuildChatUrl(_composeCounterpartyPhone, message);
    }

    private async Task LoadThreadsAsync(bool suppressErrorBanner = false)
    {
        _loadingList = true;
        try
        {
            if (IsCustomerMode)
            {
                var list = await BuyerApi.GetMyInboxThreadsAsync(_folder);
                _threads = list?.ToList() ?? new List<InboxThreadListItem>();
            }
            else if (_partnerId.HasValue)
            {
                var list = await PartnerApi.GetPartnerInboxThreadsAsync(_partnerId.Value, _folder);
                _threads = list?.ToList() ?? new List<InboxThreadListItem>();
            }

            if (!suppressErrorBanner)
            {
                _bannerMessage = null;
            }
        }
        catch (Exception ex)
        {
            if (!suppressErrorBanner)
            {
                _bannerMessage = FormatInboxError(ex);
                _threads = new List<InboxThreadListItem>();
            }
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task SelectFolderAsync(string folder)
    {
        if (string.Equals(_folder, folder, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _folder = folder;
        _selectedThread = null;
        _messages.Clear();
        _selectedThreadId = null;
        _mobileListMode = true;
        await LoadThreadsAsync();
    }

    private async Task SelectThreadAsync(Guid threadId)
    {
        _mobileListMode = false;
        _selectedThreadId = threadId;
        _composeOpen = false;
        _loadingDetail = true;
        try
        {
            InboxThreadDetailResponse? detail;
            if (IsCustomerMode)
            {
                detail = await BuyerApi.GetInboxThreadAsync(threadId);
            }
            else
            {
                detail = await PartnerApi.GetInboxThreadAsync(threadId);
            }

            _selectedThread = detail?.Thread;
            _messages = detail?.Messages?.ToList() ?? new List<InboxMessageItem>();
            _bannerMessage = null;
            await TryMarkThreadReadAsync(threadId);
            await LoadThreadsAsync(suppressErrorBanner: true);
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
            _selectedThread = null;
            _messages.Clear();
        }
        finally
        {
            _loadingDetail = false;
        }
    }

    private async Task TryMarkThreadReadAsync(Guid threadId)
    {
        try
        {
            if (IsCustomerMode)
            {
                await BuyerApi.MarkInboxThreadReadAsync(threadId);
            }
            else
            {
                await PartnerApi.MarkInboxThreadReadAsync(threadId);
            }
        }
        catch
        {
            // Non-critical: thread detail is already visible.
        }
    }

    private async Task SendReplyAsync()
    {
        if (_selectedThreadId is null || string.IsNullOrWhiteSpace(_replyBody))
        {
            return;
        }

        _sending = true;
        try
        {
            if (IsCustomerMode)
            {
                await BuyerApi.ReplyInboxThreadAsync(_selectedThreadId.Value, _replyBody.Trim());
            }
            else
            {
                await PartnerApi.ReplyInboxThreadAsync(_selectedThreadId.Value, _replyBody.Trim());
            }

            _replyBody = string.Empty;
            await SelectThreadAsync(_selectedThreadId.Value);
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task SendComposeAsync()
    {
        if (string.IsNullOrWhiteSpace(_composeBody))
        {
            _bannerMessage = L.T("inbox.bodyRequired");
            return;
        }

        if (!_composePartnerId.HasValue && !_composeProfessionalId.HasValue)
        {
            _bannerMessage = L.T("inbox.recipientRequired");
            return;
        }

        _sending = true;
        try
        {
            var tenantId = AuthState.TenantId;
            var result = await BuyerApi.CreateInboxThreadAsync(new InboxThreadCreateRequest(
                tenantId,
                _composePartnerId,
                _composeProfessionalId,
                _composeSubject,
                _composeBody.Trim()));

            if (result is null)
            {
                _bannerMessage = L.T("inbox.sendFailed");
                return;
            }

            _composeOpen = false;
            _composePartnerId = null;
            _composeProfessionalId = null;
            Navigation.NavigateTo(IsCustomerMode ? "/account/messages" : "/partner/messages", replace: true);
            await LoadThreadsAsync();
            await SelectThreadAsync(result.ThreadId);
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task UpdateStatusAsync(string status)
    {
        if (_selectedThreadId is null)
        {
            return;
        }

        try
        {
            if (IsCustomerMode)
            {
                await BuyerApi.UpdateInboxThreadStatusAsync(_selectedThreadId.Value, status);
            }
            else
            {
                await PartnerApi.UpdateInboxThreadStatusAsync(_selectedThreadId.Value, status);
            }

            await LoadThreadsAsync();
            await SelectThreadAsync(_selectedThreadId.Value);
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
        }
    }

    private string FormatInboxError(Exception ex)
    {
        var text = ex.ToString();
        if (text.Contains("inbox_threads", StringComparison.OrdinalIgnoreCase)
            || text.Contains("42P01", StringComparison.OrdinalIgnoreCase))
        {
            return L.T("inbox.schemaMissing");
        }

        return L.T("inbox.loadError");
    }

    private void OpenComposePanel()
    {
        _composeOpen = true;
        _mobileListMode = false;
        _selectedThread = null;
        _messages.Clear();
        _selectedThreadId = null;
    }

    private void BackToMobileList()
    {
        _mobileListMode = true;
    }

    private void CloseCompose()
    {
        _composeOpen = false;
        _mobileListMode = _selectedThread is null;
        _composePartnerId = null;
        _composeProfessionalId = null;
        _composeProductId = null;
        _composeServiceId = null;
        _composeCounterpartyName = null;
        _composeCounterpartyPhone = null;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed || !_initialized)
        {
            return;
        }

        try
        {
            await ApplyDeepLinkFromQueryAsync();
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _bannerMessage = FormatInboxError(ex);
            _loadingList = false;
            _loadingDetail = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleLocaleChange() => InvokeAsync(StateHasChanged);

    private bool IsMyMessage(string? senderRole)
        => IsCustomerMode
            ? string.Equals(senderRole, "customer", StringComparison.OrdinalIgnoreCase)
            : string.Equals(senderRole, "business", StringComparison.OrdinalIgnoreCase);

    private string SenderLabel(string? role)
        => string.Equals(role, "customer", StringComparison.OrdinalIgnoreCase)
            ? L.T("inbox.sender.customer")
            : L.T("inbox.sender.business");

    private string FolderClass(string folder)
    {
        var active = string.Equals(_folder, folder, StringComparison.OrdinalIgnoreCase);
        return active
            ? "flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-white px-2 py-2 text-xs font-bold text-[#3b6700] shadow-sm lg:w-full lg:justify-start lg:gap-2 lg:px-3 lg:py-2.5 lg:text-sm"
            : "flex flex-1 items-center justify-center gap-1.5 rounded-xl px-2 py-2 text-xs font-semibold text-[#5c5b5b] hover:bg-white/70 lg:w-full lg:justify-start lg:gap-2 lg:px-3 lg:py-2.5 lg:text-sm";
    }

    private string ThreadRowClass(InboxThreadListItem thread)
    {
        var selected = _selectedThreadId == thread.Id;
        var unread = thread.Unread;
        return selected
            ? "block w-full border-l-4 border-[#3b6700] bg-[#eef8e0] px-4 py-3 text-left"
            : unread
                ? "block w-full border-l-4 border-transparent bg-white px-4 py-3 text-left hover:bg-[#f5f6f7]"
                : "block w-full border-l-4 border-transparent px-4 py-3 text-left hover:bg-[#f5f6f7]";
    }

    private static string MessageBubbleClass(bool isMine)
        => isMine
            ? "max-w-[85%] ml-auto rounded-2xl rounded-br-md bg-[#3b6700] px-4 py-3 text-[#f8fff1]"
            : "max-w-[85%] rounded-2xl rounded-bl-md border border-[#e3e6e8] bg-white px-4 py-3 text-[#2c2f30]";

    private static string FormatListDate(DateTimeOffset dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Today)
        {
            return local.ToString("HH:mm");
        }

        return local.ToString("dd/MM");
    }

    private static string FormatDetailDate(DateTimeOffset dt)
        => dt.ToLocalTime().ToString("g");

    private string? BuildWhatsAppHandoffUrl()
    {
        if (_selectedThread is null)
        {
            return null;
        }

        var counterpartyPhone = ResolveCounterpartyPhone(_selectedThread);
        if (!WhatsAppLinks.IsValidMobile(counterpartyPhone))
        {
            return null;
        }

        var counterpartyName = IsCustomerMode
            ? _selectedThread.CounterpartyName
            : _selectedThread.CustomerName;
        var recentBodies = _messages
            .OrderBy(m => m.CreatedAt)
            .Select(m => m.Body)
            .Where(b => !string.IsNullOrWhiteSpace(b))
            .Select(b => b!)
            .ToList();
        var message = WhatsAppLinks.BuildThreadHandoffMessage(
            _selectedThread.Subject,
            counterpartyName,
            recentBodies);

        return WhatsAppLinks.TryBuildChatUrl(counterpartyPhone, message);
    }

    private string? GetWhatsAppHint()
    {
        if (_selectedThread is null)
        {
            return null;
        }

        var ownPhone = ResolveOwnPhone(_selectedThread);
        var counterpartyPhone = ResolveCounterpartyPhone(_selectedThread);
        var ownOk = WhatsAppLinks.IsValidMobile(ownPhone);
        var otherOk = WhatsAppLinks.IsValidMobile(counterpartyPhone);

        if (otherOk && !ownOk)
        {
            return IsCustomerMode
                ? L.T("inbox.whatsapp.hint.missingOwn.customer")
                : L.T("inbox.whatsapp.hint.missingOwn.partner");
        }

        if (ownOk && otherOk)
        {
            return L.T("inbox.whatsapp.hint.ready");
        }

        if (!ownOk && !otherOk)
        {
            return IsCustomerMode
                ? L.T("inbox.whatsapp.hint.missingBoth.customer")
                : L.T("inbox.whatsapp.hint.missingBoth.partner");
        }

        if (!ownOk)
        {
            return IsCustomerMode
                ? L.T("inbox.whatsapp.hint.missingOwn.customer")
                : L.T("inbox.whatsapp.hint.missingOwn.partner");
        }

        return IsCustomerMode
            ? L.T("inbox.whatsapp.hint.missingOther.customer")
            : L.T("inbox.whatsapp.hint.missingOther.partner");
    }

    private string? ResolveOwnPhone(InboxThreadDetail thread)
        => IsCustomerMode
            ? thread.CustomerPhone
            : _partnerPhone ?? thread.PartnerPhone ?? thread.ProfessionalPhone;

    private string? ResolveCounterpartyPhone(InboxThreadDetail thread)
        => IsCustomerMode
            ? thread.PartnerPhone ?? thread.ProfessionalPhone
            : thread.CustomerPhone;

    public void Dispose()
    {
        _disposed = true;
        L.OnChange -= HandleLocaleChange;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
