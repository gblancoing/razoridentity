@inject IConfiguration Configuration
@using ComunaClick.SharedUI

<!DOCTYPE html>
<html class="light" lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ComunaClic</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="_content/ComunaClick.SharedUI/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="_content/ComunaClick.SharedUI/lib/leaflet/MarkerCluster.css" />
    <link rel="stylesheet" href="_content/ComunaClick.SharedUI/lib/leaflet/MarkerCluster.Default.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary-fixed": "#4d4a00",
                        "error": "#b02500",
                        "surface": "#fffdf7",
                        "on-surface": "#2c2f30",
                        "tertiary-dim": "#555200",
                        "on-primary-fixed": "#14532d",
                        "error-dim": "#b92902",
                        "on-background": "#2c2f30",
                        "on-surface-variant": "#595c5d",
                        "on-secondary-fixed-variant": "#5c5b5b",
                        "surface-variant": "#e8e5dc",
                        "on-tertiary": "#fef863",
                        "on-error": "#ffefec",
                        "on-error-container": "#520c00",
                        "tertiary-fixed-dim": "#eee855",
                        "primary-dim": "#1f7a3b",
                        "surface-container": "#f6f1e8",
                        "primary-container": "#dcfce7",
                        "primary-fixed": "#bbf7d0",
                        "outline": "#757778",
                        "surface-container-lowest": "#ffffff",
                        "inverse-primary": "#86efac",
                        "tertiary-fixed": "#fcf661",
                        "background": "#fffdf7",
                        "secondary-fixed": "#ebe7df",
                        "on-primary-fixed-variant": "#166534",
                        "on-secondary": "#f4f2f2",
                        "outline-variant": "#c9c4ba",
                        "on-primary-container": "#14532d",
                        "surface-container-highest": "#ece7de",
                        "secondary-fixed-dim": "#dfd8cd",
                        "error-container": "#f95630",
                        "primary": "#2d9e4f",
                        "on-tertiary-fixed-variant": "#6a6700",
                        "inverse-surface": "#0c0f10",
                        "surface-container-low": "#faf4ea",
                        "on-secondary-container": "#525252",
                        "on-primary": "#ecfdf5",
                        "inverse-on-surface": "#9b9d9e",
                        "surface-bright": "#fffdf7",
                        "secondary-dim": "#504f4f",
                        "on-tertiary-container": "#605d00",
                        "primary-fixed-dim": "#86efac",
                        "tertiary": "#615e00",
                        "tertiary-container": "#fcf661",
                        "secondary-container": "#ebe7df",
                        "surface-tint": "#2d9e4f",
                        "on-secondary-fixed": "#3f3f3f",
                        "secondary": "#5c5b5b",
                        "surface-dim": "#e7e1d6",
                        "surface-container-high": "#f0ebe2",
                        "brand-accent": "#22c55e",
                        "background-light": "#fffdf7",
                        "background-dark": "#0c0f10"
                    },
                    fontFamily: {
                        "sans": ["Inter", "sans-serif"],
                        "headline": ["Manrope"],
                        "body": ["Inter", "sans-serif"],
                        "label": ["Inter", "sans-serif"],
                        "display": ["Manrope"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "sm": "0.375rem", "md": "0.5rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "3xl": "1.5rem", "full": "9999px" }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }

        html {
            max-width: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: max(884px, 100dvh);
            max-width: 100%;
            background-color: #fffdf7;
            color: #2c2f30;
            overflow-x: hidden;
        }

        .editorial-shadow {
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
        }

        .liquid-glass {
            background: rgba(0, 0, 0, 0.4);
            background-blend-mode: luminosity;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            border: none;
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .liquid-glass::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1.4px;
            background: linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.3) 0%,
                rgba(255, 255, 255, 0.1) 20%,
                rgba(255, 255, 255, 0) 40%,
                rgba(255, 255, 255, 0) 60%,
                rgba(255, 255, 255, 0.1) 80%,
                rgba(255, 255, 255, 0.3) 100%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .marker-cluster-small,
        .marker-cluster-medium,
        .marker-cluster-large {
            background-color: rgba(34, 197, 94, 0.18);
        }

        .marker-cluster-small div,
        .marker-cluster-medium div,
        .marker-cluster-large div {
            background-color: rgba(45, 158, 79, 0.95);
            color: #ecfdf5;
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
        }
    </style>
    <script>
        window.comunaclicRecaptchaEnabled = @RecaptchaEnabled.ToString().ToLowerInvariant();
        window.comunaclicRecaptchaSiteKey = "@RecaptchaSiteKey";
        window.comunaclicGoogleClientId = "@GoogleClientId";
    </script>
    @if (RecaptchaEnabled && !string.IsNullOrWhiteSpace(RecaptchaSiteKey))
    {
        <script src="@($"https://www.google.com/recaptcha/api.js?render={Uri.EscapeDataString(RecaptchaSiteKey)}")"></script>
    }
    <script src="_content/ComunaClick.SharedUI/lib/leaflet/leaflet.js"></script>
    <script src="_content/ComunaClick.SharedUI/lib/leaflet/leaflet.markercluster.js"></script>
    <script src="@($"_content/ComunaClick.SharedUI/app.js?v={AssetVersions.AppJs}")"></script>
    <link rel="stylesheet" href="css/tokens.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ComunaClick.App.styles.css" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/ComunaClick.SharedUI/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="_content/ComunaClick.SharedUI/apple-touch-icon.png" />
    <HeadOutlet />
</head>

<body class="bg-background text-on-surface font-body selection:bg-brand-accent/20 min-h-screen">
    <ComunaClick.SharedUI.Components.LanguageInitializer />
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private bool RecaptchaEnabled => Configuration.GetValue("Recaptcha:Enabled", false);
    private string RecaptchaSiteKey => Configuration["Recaptcha:SiteKey"] ?? string.Empty;
    private string GoogleClientId => Configuration["Auth:Google:ClientId"] ?? Configuration["Auth:Google:ClientIds:0"] ?? string.Empty;
}
