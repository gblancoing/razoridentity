@inject IConfiguration Configuration

<!DOCTYPE html>
<html class="light" lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ComunaClic - Editorial Dashboard</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary-fixed": "#4d4a00",
                        "error": "#b02500",
                        "surface": "#f5f6f7",
                        "on-surface": "#2c2f30",
                        "tertiary-dim": "#555200",
                        "on-primary-fixed": "#254300",
                        "error-dim": "#b92902",
                        "on-background": "#2c2f30",
                        "on-surface-variant": "#595c5d",
                        "on-secondary-fixed-variant": "#5c5b5b",
                        "surface-variant": "#dadddf",
                        "on-tertiary": "#fef863",
                        "on-error": "#ffefec",
                        "on-error-container": "#520c00",
                        "tertiary-fixed-dim": "#eee855",
                        "primary-dim": "#335900",
                        "surface-container": "#e6e8ea",
                        "primary-container": "#a7f255",
                        "primary-fixed": "#a7f255",
                        "outline": "#757778",
                        "surface-container-lowest": "#ffffff",
                        "inverse-primary": "#a7f255",
                        "tertiary-fixed": "#fcf661",
                        "background": "#f5f6f7",
                        "secondary-fixed": "#e4e2e2",
                        "on-primary-fixed-variant": "#396300",
                        "on-secondary": "#f4f2f2",
                        "outline-variant": "#abadae",
                        "on-primary-container": "#325800",
                        "surface-container-highest": "#dadddf",
                        "secondary-fixed-dim": "#d6d4d4",
                        "error-container": "#f95630",
                        "primary": "#3b6700",
                        "on-tertiary-fixed-variant": "#6a6700",
                        "inverse-surface": "#0c0f10",
                        "surface-container-low": "#eff1f2",
                        "on-secondary-container": "#525252",
                        "on-primary": "#d9ffad",
                        "inverse-on-surface": "#9b9d9e",
                        "surface-bright": "#f5f6f7",
                        "secondary-dim": "#504f4f",
                        "on-tertiary-container": "#605d00",
                        "primary-fixed-dim": "#99e348",
                        "tertiary": "#615e00",
                        "tertiary-container": "#fcf661",
                        "secondary-container": "#e4e2e2",
                        "surface-tint": "#3b6700",
                        "on-secondary-fixed": "#3f3f3f",
                        "secondary": "#5c5b5b",
                        "surface-dim": "#d1d5d7",
                        "surface-container-high": "#e0e3e4",
                        "brand-accent": "#76BC21",
                        "background-light": "#f5f6f7",
                        "background-dark": "#0c0f10"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"],
                        "display": ["Manrope"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: max(884px, 100dvh);
            background-color: #f5f6f7;
            color: #2c2f30;
        }

        .editorial-shadow {
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
        }

        .marker-cluster-small,
        .marker-cluster-medium,
        .marker-cluster-large {
            background-color: rgba(167, 242, 85, 0.35);
        }

        .marker-cluster-small div,
        .marker-cluster-medium div,
        .marker-cluster-large div {
            background-color: rgba(59, 103, 0, 0.9);
            color: #d9ffad;
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
        }
    </style>
    <script>
        window.comunaclicRecaptchaEnabled = @RecaptchaEnabled.ToString().ToLowerInvariant();
        window.comunaclicRecaptchaSiteKey = "@RecaptchaSiteKey";
    </script>
    @if (RecaptchaEnabled && !string.IsNullOrWhiteSpace(RecaptchaSiteKey))
    {
        <script src="@($"https://www.google.com/recaptcha/api.js?render={Uri.EscapeDataString(RecaptchaSiteKey)}")"></script>
    }
    <script src="_content/ComunaClick.SharedUI/app.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ComunaClick.App.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-background text-on-surface font-body selection:bg-brand-accent/20 min-h-screen">
    <ComunaClick.SharedUI.Components.LanguageInitializer />
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private bool RecaptchaEnabled => Configuration.GetValue("Recaptcha:Enabled", false);
    private string RecaptchaSiteKey => Configuration["Recaptcha:SiteKey"] ?? string.Empty;
}
